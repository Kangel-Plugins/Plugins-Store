    def _show_stream_alert(self, value):
        if value:
            title = localise("stream_alert_title")
            message = localise("stream_alert_message")
            fragment = get_last_fragment()
            ctx = fragment.getContext() if fragment else ApplicationLoader.applicationContext
            dialog = AlertDialog(ctx, 3)
            dialog.setTitle(title)
            dialog.setMessage(message)
            dialog.setButton("OK", None)
            dialog.show()

    def get_game(self, steam_id, api_key):
        if not api_key:
            BulletinHelper.show_error(localise("error_api_key_not_set"))
            return localise("error_api_key_missing"), None, None, None, None

        if not steam_id or not steam_id.strip():
            BulletinHelper.show_error(localise("error_steam_id_not_set"))
            return localise("error_invalid_steam_id"), None, None, None, None

        steam_id = resolve_steam_id(steam_id, api_key) or steam_id

        if not steam_id.isdigit():
            BulletinHelper.show_error(localise("error_invalid_steam_id"))
            return localise("error_invalid_steam_id"), None, None, None, None

        try:
            # Инициализируем SteamAPI
            steam_api = SteamAPI(api_key, steam_id)
            
            # Получаем информацию о профиле
            log("[SteamPlugin] Получение информации о профиле...")
            profile = steam_api.get_player_summary()
            
            if not profile or 'response' not in profile or not profile['response'].get('players'):
                log("[SteamPlugin] Профиль не найден или скрыт")
                return localise("error_steam_id_not_found"), None, None, None, None
            
            player = profile['response']['players'][0]
            nickname = player.get('personaname', 'Unknown')
            
            if 'gameextrainfo' not in player:
                log("[SteamPlugin] Пользователь не в игре")
                return self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT), None, None, None, nickname
            
            game_name = player['gameextrainfo']
            game_id = player.get('gameid')
            
            if not game_id:
                log("[SteamPlugin] ID игры не найден")
                return game_name, None, None, None, nickname
            
            game_store_url = f"https://store.steampowered.com/app/{game_id}/"
            
            playtime = 0
            try:
                log("[SteamPlugin] Получение информации о библиотеке игр...")
                owned_games = steam_api.get_owned_games()
                if owned_games and 'response' in owned_games and 'games' in owned_games['response']:
                    for game in owned_games['response']['games']:
                        if str(game.get('appid')) == str(game_id):
                            playtime = game.get('playtime_forever', 0)
                            log(f"[SteamPlugin] Найдено время игры: {playtime} минут")
                            break
            except Exception as e:
                log(f"[SteamPlugin] Ошибка при получении времени игры: {e}")
            
            game_details = steam_api.get_game_details(game_id)

            reviews_percent = None
            reviews_total = 0
            try:
                reviews = steam_api.get_reviews(game_id)
                reviews_total = reviews.get('total_reviews', 0) or 0
                total_positive = reviews.get('total_positive', 0) or 0
                if reviews_total > 0:
                    reviews_percent = round((total_positive / reviews_total) * 100)
            except Exception as e:
                log(f"[SteamPlugin] Ошибка при получении отзывов: {e}")

            if game_details:
                log(f"[SteamPlugin] Получена информация об игре: {game_details}")

                image_url = None
                if 'header_image' in game_details:
                    image_url = game_details['header_image']
                elif 'background' in game_details:
                    image_url = game_details['background']
                elif 'screenshots' in game_details and game_details['screenshots']:
                    image_url = game_details['screenshots'][0].get('path_full')

                metacritic_score = 'N/A'
                if 'metacritic' in game_details and isinstance(game_details['metacritic'], dict):
                    metacritic_score = game_details['metacritic'].get('score', 'N/A')
                
                game_info = {
                    'name': game_name,
                    'developers': game_details.get('developers', []),
                    'publishers': game_details.get('publishers', []),
                    'metacritic': metacritic_score,
                    'reviews_percent': reviews_percent,
                    'reviews_total': reviews_total,
                    'genres': [g['description'] for g in game_details.get('genres', [])],
                    'categories': [c['description'] for c in game_details.get('categories', [])],
                    'release_date': game_details.get('release_date', {}).get('date', 'N/A'),
                    'short_description': game_details.get('short_description', ''),
                    'playtime': playtime,
                    'store_url': game_store_url,
                    'avatar_url': player.get('avatarfull') or player.get('avatarmedium') or player.get('avatar', '')
                }
                
                log(f"[SteamPlugin] Сформированы детали игры: {game_info}")
                return game_info, image_url, playtime, game_store_url, nickname

            log("[SteamPlugin] Не удалось получить детали игры")
            return game_name, None, playtime, game_store_url, nickname
            
        except requests.exceptions.RequestException as e:
            log(f"[SteamPlugin] Ошибка сети: {e}")
            return localise("error_network"), None, None, None, None
        except json.JSONDecodeError as e:
            log(f"[SteamPlugin] Ошибка JSON: {e}")
            return localise("error_api"), None, None, None, None
        except Exception as e:
            log(f"[SteamPlugin] Неизвестная ошибка: {e}")
            return localise("error_unknown", e=str(e)), None, None, None, None

    def get_steam_library(self, steam_id, api_key):
        steam_id = resolve_steam_id(steam_id, api_key) or steam_id
        log(f"[SteamPlugin] Получение библиотеки игр для Steam ID: {steam_id}")

        if not steam_id or not steam_id.strip() or not steam_id.isdigit():
            error_msg = localise("error_invalid_steam_id")
            log(f"[SteamPlugin] {error_msg}")
            return None, error_msg

        if not api_key or not api_key.strip():
            error_msg = localise("error_api_key_missing")
            log(f"[SteamPlugin] {error_msg}")
            return None, error_msg

        url = 'https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/'
        params = {
            'key': api_key,
            'steamid': steam_id,
            'include_appinfo': 1,
            'include_played_free_games': 1,
            'format': 'json'
        }

        max_retries = 3
        retry_delay = 2

        try:
            response = None
            for attempt in range(max_retries):
                log(f"[SteamPlugin] Отправка запроса к Steam API (попытка {attempt + 1}/{max_retries}): {url}")
                response = requests.get(url, params=params, timeout=20)
                log(f"[SteamPlugin] Получен ответ. Статус: {response.status_code}")

                if response.status_code == 200:
                    break

                if attempt < max_retries - 1:
                    time.sleep(retry_delay)
                    continue

            if response.status_code != 200:
                error_msg = f"{localise('error_api_code', code=response.status_code)} - {response.text}"
                log(f"[SteamPlugin] {error_msg}")
                return None, error_msg

            data = response.json()
            log(f"[SteamPlugin] Ответ API: {json.dumps(data, ensure_ascii=False)[:500]}...")

            if 'response' not in data:
                error_msg = localise("error_invalid_response")
                log(f"[SteamPlugin] {error_msg}")
                return None, error_msg

            if 'games' not in data['response']:
                error_msg = localise("error_private_profile")
                log(f"[SteamPlugin] {error_msg}")
                return None, error_msg

            games = data['response'].get('games', [])
            log(f"[SteamPlugin] Найдено игр: {len(games)}")

            if not games:
                log("[SteamPlugin] Библиотека игр пуста")
                return [], localise("library_empty")

            sorted_games = sorted(games, key=lambda x: x.get('playtime_forever', 0), reverse=True)
            log(f"[SteamPlugin] Успешно получено и отсортировано {len(sorted_games)} игр")
            return sorted_games, None

        except requests.exceptions.RequestException as e:
            error_msg = localise("error_network_generic", e=str(e))
            log(f"[SteamPlugin] {error_msg}")
            return None, error_msg
        except json.JSONDecodeError as e:
            error_msg = localise("error_json_parse", e=str(e))
            log(f"[SteamPlugin] {error_msg}")
            return None, error_msg
        except Exception as e:
            import traceback
            error_msg = localise("error_unknown_generic", e=str(e)) + f"\n{traceback.format_exc()}"
            log(f"[SteamPlugin] {error_msg}")
            return None, error_msg

    def on_callback_query_hook(self, account, params):
        """Обработчик нажатий на inline-кнопки"""
        try:
            if not hasattr(params, 'data'):
                return HookResult()

            data = params.data
            log(f"[SteamPlugin] Получен callback: {data}")

            if data.startswith('sort_'):
                sort_type, steam_id = data.split('_', 1)[1].split('_', 1)

                api_key = self.get_setting("api_key", "").strip()

                try:
                    get_messages_controller().callCallbackQuery(params.query_id, "")
                except:
                    pass

                self.send_sorted_library(params.peer, steam_id, api_key, sort_type)

                try:
                    get_messages_controller().editMessageReplyMarkup(params.peer, params.msg_id, None)
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка при удалении кнопок: {str(e)}")

                return HookResult(strategy=HookStrategy.CANCEL)

            if data.startswith('inv_'):
                parts = data.split('_')
                if len(parts) >= 3:
                    clicked_app_id = int(parts[1])
                    steam_id = parts[2]
                    api_key = self.get_setting("api_key", "").strip()

                    try:
                        get_messages_controller().callCallbackQuery(params.query_id, "")
                    except:
                        pass

                    self.send_game_inventory(params.peer, steam_id, api_key, app_id=clicked_app_id)

                    try:
                        get_messages_controller().editMessageReplyMarkup(params.peer, params.msg_id, None)
                    except Exception as e:
                        log(f"[SteamPlugin] Ошибка при удалении кнопок инвентаря: {str(e)}")

                    return HookResult(strategy=HookStrategy.CANCEL)

        except Exception as e:
            log(f"[SteamPlugin] Ошибка в on_callback_query_hook: {str(e)}")
            import traceback
            log(f"[SteamPlugin] Трассировка: {traceback.format_exc()}")

        return HookResult()

    def _run_on_ui_thread(self, action):
        try:
            from android_utils import run_on_ui_thread
            run_on_ui_thread(action)
        except Exception:
            try:
                from org.telegram.messenger import AndroidUtilities
                from java import dynamic_proxy
                from java.lang import Runnable
                class _Runnable:
                    def run(self):
                        try:
                            action()
                        except Exception as e:
                            log(f"[SteamPlugin] run_on_ui_thread error: {e}")
                AndroidUtilities.runOnUIThread(dynamic_proxy(Runnable)(_Runnable()))
            except Exception as e:
                log(f"[SteamPlugin] run_on_ui_thread fallback error: {e}")
                try:
                    action()
                except Exception:
                    pass

    def _run_on_worker_queue(self, func):
        try:
            from client_utils import run_on_queue
            run_on_queue(func)
        except Exception:
            import threading
            threading.Thread(target=func, daemon=True).start()

    def _handle_steam_deeplink(self, url: str):
        try:
            log(f"[SteamPlugin] Обработка steam deeplink: {url}")
            game = "cs2"
            sid = None
            mid = None
            peer = None

            try:
                from android.net import Uri
                uri = Uri.parse(url)
                game = uri.getQueryParameter("game") or "cs2"
                sid = uri.getQueryParameter("sid")
                mid = uri.getQueryParameter("mid")
                peer_str = uri.getQueryParameter("peer")
                if peer_str:
                    peer = int(peer_str)
            except Exception:
                pass

            clean = url.replace("tg://steamplugin", "").lstrip("/").lstrip("?")
            if "game=" in clean or "peer=" in clean:
                try:
                    import urllib.parse
                    parsed_qs = urllib.parse.parse_qs(clean)
                    game = parsed_qs.get("game", [game])[0]
                    if not sid:
                        sid = parsed_qs.get("sid", [None])[0]
                    if not mid:
                        mid = parsed_qs.get("mid", [None])[0]
                    if not peer:
                        p_str = parsed_qs.get("peer", [None])[0]
                        if p_str:
                            peer = int(p_str)
                except Exception:
                    pass
            elif clean:
                parts = clean.split("/")
                game = parts[0]
                if len(parts) > 1 and not sid:
                    sid = parts[1]
                if len(parts) > 2 and not mid:
                    mid = parts[2]

            if not mid and "mid=" in clean:
                try:
                    import urllib.parse
                    parsed_qs = urllib.parse.parse_qs(clean)
                    mid = parsed_qs.get("mid", [None])[0]
                except Exception:
                    pass

            app_id = 730
            if game in ("tf2", "tf", "440"):
                app_id = 440
            elif game in ("dota", "dota2", "570"):
                app_id = 570
            elif game in ("cs", "cs2", "csgo", "730"):
                app_id = 730

            # Запоминаем выбор игры для следующих запусков .sinv!
            APPID_TO_INDEX = {730: 0, 440: 1, 570: 2}
            self.set_setting("last_inv_game", APPID_TO_INDEX.get(app_id, 0))

            default_steam_id = self.get_setting("steam_id", "").strip()
            target_sid = sid or default_steam_id
            api_key = self.get_setting("api_key", "").strip()

            if not peer:
                try:
                    fragment = get_last_fragment()
                    if fragment and hasattr(fragment, 'getDialogId'):
                        peer = fragment.getDialogId()
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка получения dialog_id: {e}")

            if not mid and peer:
                try:
                    from java import jlong
                    mc = get_messages_controller()
                    if hasattr(mc, "dialogMessage"):
                        try:
                            last = mc.dialogMessage.get(jlong(peer))
                        except Exception:
                            last = mc.dialogMessage.get(peer)
                        if last:
                            mid = last.getId() if hasattr(last, "getId") else getattr(getattr(last, "messageOwner", None), "id", None)
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка поиска последнего ID сообщения: {e}")

            if peer and target_sid:
                game_name = SUPPORTED_INVENTORY_GAMES.get(app_id, {}).get("full_name", "Steam")
                try:
                    BulletinHelper.show_info(localise("loading_inventory_for_game", game=game_name))
                except Exception:
                    pass
                self.send_game_inventory(peer, target_sid, api_key, app_id=app_id, edit_msg_id=mid)
            else:
                log(f"[SteamPlugin] Не удалось определить peer ({peer}) или target_sid ({target_sid})")

        except Exception as e:
            log(f"[SteamPlugin] Ошибка в _handle_steam_deeplink: {e}")

    def _edit_telegram_message(self, peer, mid, text, entities):
        try:
            from client_utils import get_send_messages_helper, get_last_fragment, get_messages_controller
            from java.util import ArrayList
            from java.lang import Boolean
            from java import jlong

            mid_int = int(mid) if mid and str(mid).isdigit() else None
            fragment = get_last_fragment()
            msg_obj = None

            # 1. Поиск MessageObject через ChatActivity.findMessageObject
            if fragment and hasattr(fragment, "findMessageObject"):
                try:
                    msg_obj = fragment.findMessageObject(mid_int)
                except Exception as e:
                    log(f"[SteamPlugin] findMessageObject error: {e}")

            # 2. Поиск через MessagesController.dialogMessage
            if not msg_obj:
                try:
                    mc = get_messages_controller()
                    if hasattr(mc, "dialogMessage"):
                        try:
                            last = mc.dialogMessage.get(jlong(peer))
                        except Exception:
                            last = mc.dialogMessage.get(peer)
                        if last:
                            last_id = last.getId() if hasattr(last, "getId") else getattr(getattr(last, "messageOwner", None), "id", 0)
                            if int(last_id) == mid_int or not mid:
                                msg_obj = last
                except Exception as e:
                    log(f"[SteamPlugin] dialogMessage error: {e}")

            if msg_obj:
                helper = get_send_messages_helper()
                j_entities = ArrayList()
                if entities:
                    for ent in entities:
                        j_entities.add(ent)

                def _ui_edit():
                    try:
                        methods = list(helper.getClass().getMethods()) + list(helper.getClass().getDeclaredMethods())
                        for m in methods:
                            if m.getName() == "editMessage":
                                p_types = m.getParameterTypes()
                                if len(p_types) >= 5 and "MessageObject" in p_types[0].getName():
                                    args = []
                                    for pt in p_types:
                                        pt_name = pt.getName()
                                        if "MessageObject" in pt_name:
                                            args.append(msg_obj)
                                        elif "String" in pt_name:
                                            args.append(text)
                                        elif pt_name in ("boolean", "java.lang.Boolean"):
                                            args.append(Boolean.FALSE)
                                        elif "BaseFragment" in pt_name or "ChatActivity" in pt_name:
                                            args.append(fragment)
                                        elif "ArrayList" in pt_name or "List" in pt_name:
                                            args.append(j_entities)
                                        else:
                                            args.append(None)
                                    m.setAccessible(True)
                                    m.invoke(helper, *args)
                                    log(f"[SteamPlugin] helper.editMessage({len(p_types)}) успешно вызван для ID={mid_int}")
                                    return
                        log("[SteamPlugin] Подходящий метод editMessage на helper не найден")
                    except Exception as e:
                        log(f"[SteamPlugin] Ошибка helper.editMessage на UI: {e}")

                self._run_on_ui_thread(_ui_edit)
                return True
            else:
                log(f"[SteamPlugin] MessageObject для ID={mid_int} не найден в памяти")

        except Exception as e:
            log(f"[SteamPlugin] Ошибка в _edit_telegram_message: {e}")

        return False

    def _send_or_edit_inventory_message(self, peer, text, entities, edit_msg_id=None):
        if edit_msg_id:
            log(f"[SteamPlugin] Попытка редактирования сообщения ID={edit_msg_id}")
            if self._edit_telegram_message(peer, edit_msg_id, text, entities):
                return
            log("[SteamPlugin] Редактирование через helper.editMessage не удалось, отправка нового сообщения")

        log("[SteamPlugin] Отправка нового сообщения инвентаря")
        send_message({
            "peer": peer,
            "message": text,
            "entities": entities
        })

    def install_deeplink_hook(self):
        try:
            import weakref
            _pl_ref = weakref.ref(self)

            class DeeplinkHook:
                def before_hooked_method(self, param):
                    try:
                        _pl = _pl_ref()
                        if not _pl:
                            return
                        if not param.args or len(param.args) < 1:
                            return
                        intent = param.args[0]
                        if not intent:
                            return
                        action = getattr(intent, "getAction", None)
                        action_val = action() if callable(action) else action
                        if str(action_val) != "android.intent.action.VIEW":
                            return
                        data = getattr(intent, "getData", None)
                        if not data:
                            return
                        data_val = data() if callable(data) else data
                        if not data_val:
                            return
                        url = str(data_val)
                        if url.startswith("tg://steamplugin"):
                            log(f"[SteamPlugin] Deeplink перехвачен: {url}")
                            _pl._run_on_worker_queue(lambda: _pl._handle_steam_deeplink(url))
                            param.setResult(None)
                    except Exception as e:
                        log(f"[SteamPlugin] Ошибка в DeeplinkHook: {e}")

            class BrowserOpenUrlHook:
                def before_hooked_method(self, param):
                    try:
                        if not param.args or len(param.args) < 2:
                            return
                        arg1 = param.args[1]
                        if arg1 is None:
                            return
                        url_str = str(arg1)
                        if url_str.startswith("tg://steamplugin"):
                            log(f"[SteamPlugin] Browser.openUrl перехвачен: {url_str}")
                            _pl = _pl_ref()
                            if _pl:
                                _pl._run_on_worker_queue(lambda: _pl._handle_steam_deeplink(url_str))
                            param.setResult(None)
                    except Exception as e:
                        log(f"[SteamPlugin] Ошибка в BrowserOpenUrlHook: {e}")

            if not hasattr(self, "_tracked_hooks"):
                self._tracked_hooks = []

            # 1. Hook LaunchActivity.handleIntent for OS / intent opens
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            if LaunchActivity:
                cls_la = LaunchActivity if hasattr(LaunchActivity, "getDeclaredMethods") else LaunchActivity.getClass()
                for m in cls_la.getDeclaredMethods():
                    if m.getName() == "handleIntent":
                        p_types = m.getParameterTypes()
                        if len(p_types) >= 1 and "Intent" in p_types[0].getName():
                            try:
                                m.setAccessible(True)
                                hook = self.hook_method(m, DeeplinkHook())
                                self._tracked_hooks.append(hook)
                                log(f"[SteamPlugin] Deeplink hook установлен на LaunchActivity.handleIntent ({len(p_types)} args)")
                                break
                            except Exception as e:
                                log(f"[SteamPlugin] Ошибка при хуке handleIntent: {e}")

            # 2. Hook Browser.openUrl for in-app chat clicks
            Browser = find_class("org.telegram.messenger.browser.Browser")
            if Browser:
                cls_b = Browser if hasattr(Browser, "getDeclaredMethods") else Browser.getClass()
                for m in cls_b.getDeclaredMethods():
                    if m.getName() == "openUrl":
                        try:
                            m.setAccessible(True)
                            hook = self.hook_method(m, BrowserOpenUrlHook())
                            self._tracked_hooks.append(hook)
                            log(f"[SteamPlugin] Browser.openUrl hook установлен для {m.getName()} ({len(m.getParameterTypes())} args)")
                        except Exception as e:
                            log(f"[SteamPlugin] Ошибка при хуке Browser.openUrl: {e}")

        except Exception as e:
            log(f"[SteamPlugin] Ошибка при установке deeplink hook: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "alert_manager") and self.alert_manager:
                self.alert_manager.dismiss_dialog()
            if hasattr(self, "_tracked_hooks"):
                for h in list(self._tracked_hooks):
                    try:
                        self.unhook_method(h)
                    except Exception:
                        pass
                self._tracked_hooks.clear()
            log("[SteamPlugin] Успешно выгружен")
        except Exception as e:
            log(f"[SteamPlugin] Ошибка при выгрузке: {e}")

    def on_url_hook(self, account, params):
        try:
            url = getattr(params, 'url', None) or getattr(params, 'link', None) or getattr(params, 'uri', None) or ""
            if not url or not isinstance(url, str):
                return HookResult()

            if url.startswith("tg://steamplugin"):
                self._handle_steam_deeplink(url)
                return HookResult(strategy=HookStrategy.CANCEL)

        except Exception as e:
            log(f"[SteamPlugin] Ошибка в on_url_hook: {e}")

        return HookResult()

    on_open_url_hook = on_url_hook
    on_link_click_hook = on_url_hook

    def send_sorted_library(self, peer, steam_id, api_key, sort_type='hours', full_list=False):

        def _send():
            try:
                log(f"[SteamPlugin] Загрузка библиотеки с сортировкой: {sort_type}, full_list={full_list}")
                games, error = self.get_steam_library(steam_id, api_key)

                if error:
                    log(f"[SteamPlugin] Ошибка при получении библиотеки: {error}")
                    send_message({"peer": peer, "message": error})
                    return

                if not games:
                    log("[SteamPlugin] Библиотека игр пуста")
                    send_message({"peer": peer, "message": localise("library_empty")})
                    return

                if sort_type == 'hours':
                    games_sorted = sorted(games, key=lambda x: x.get('playtime_forever', 0), reverse=True)
                    sort_text = localise("sort_by_hours_text")
                else:
                    games_sorted = sorted(games,
                        key=lambda x: x.get('rtime_last_played', x.get('last_played', 0)),
                        reverse=True)
                    sort_text = localise("sort_by_last_played_text")

                games_list = []
                total_games = len(games_sorted)
                total_playtime = sum(game.get('playtime_forever', 0) for game in games_sorted) // 60

                max_games = 30
                games_to_show = games_sorted[:max_games]

                for i, game in enumerate(games_to_show, 1):
                    try:
                        name = escape_markdown(game.get('name', 'Unknown game'))
                        g_appid = game.get('appid')
                        g_name_l = (game.get('name') or '').lower()
                        if g_appid == 730 or "counter-strike" in g_name_l or "cs2" in g_name_l:
                            g_ico = "[🔫](5307872926886808571) "
                        elif g_appid == 440 or "team fortress" in g_name_l or "tf2" in g_name_l:
                            g_ico = "[🎩](5465519392248838285) "
                        elif g_appid == 570 or "dota" in g_name_l:
                            g_ico = "[⚔️](5418011199914662526) "
                        else:
                            g_ico = ""
                        playtime = game.get('playtime_forever', 0)
                        hours = playtime // 60
                        minutes = playtime % 60

                        last_played = ""
                        if sort_type == 'last_played' and 'rtime_last_played' in game:
                            from datetime import datetime
                            last_played_ts = game['rtime_last_played']
                            if last_played_ts > 0:
                                last_played_date = datetime.fromtimestamp(last_played_ts).strftime('%d.%m.%Y')
                                last_played = localise("last_played_suffix", date=last_played_date)

                        if hours > 0:
                            playtime_str = localise("duration_compact_hm", hours=hours, minutes=minutes) + last_played
                        else:
                            playtime_str = localise("duration_compact_m", minutes=minutes) + last_played

                        games_list.append(f"{i}. {g_ico}{name} - {playtime_str}")
                    except Exception as game_err:
                        log(f"[SteamPlugin] Ошибка при обработке игры {i}: {str(game_err)}")

                if total_games > max_games:
                    games_list.append("\n" + localise("and_more_games", count=total_games - max_games))

                if full_list:
                    message = f"🎮 *{localise('full_library_header')}*\n" + localise('total_games_and_time', count=total_games, hours=total_playtime) + "\n\n"

                    games_by_letter = {}
                    for game in games_sorted:
                        raw_name = game.get('name', 'Unknown game')
                        first_letter = raw_name[0].upper() if raw_name and raw_name[0].isalpha() else '#'
                        if first_letter not in games_by_letter:
                            games_by_letter[first_letter] = []
                        games_by_letter[first_letter].append(escape_markdown(raw_name))

                    sorted_letters = sorted(games_by_letter.keys())

                    for letter in sorted_letters:
                        games_str = ', '.join(games_by_letter[letter])
                        message += f"\n*{escape_markdown(letter)}*: {games_str}\n"

                    message += f"\n📊 *{localise('sorting_label')}* {sort_text}"
                else:
                    sort_buttons = [
                        [{"text": localise("btn_sort_by_hours"), "callback_data": f"sort_hours_{steam_id}"}],
                        [{"text": localise("btn_sort_by_last_played"), "callback_data": f"sort_last_played_{steam_id}"}]
                    ]

                    message = f"🎮 *{localise('library_header')}*\n" + localise('total_games_and_time', count=total_games, hours=total_playtime) + "\n\n"
                    message += "\n".join(games_list)
                    message += f"\n\n📊 *{localise('sorting_label')}* {sort_text}"

                log(f"[SteamPlugin] Отправляем {'полный' if full_list else 'отсортированный'} список игр")
                parsed = parse_markdown(message)

                entities = [entity.to_tlrpc_object() for entity in parsed.entities]
                try:
                    blockquote_entity = TLRPC.TL_messageEntityBlockquote()
                    blockquote_entity.collapsed = True
                    blockquote_entity.offset = 0
                    try:
                        blockquote_entity.length = len(parsed.text.encode('utf-16le')) // 2
                    except Exception:
                        blockquote_entity.length = len(parsed.text)
                    entities.append(blockquote_entity)
                except Exception as e:
                    log(f"[SteamPlugin] Не удалось добавить свёрнутую цитату: {e}")

                message_data = {
                    "peer": peer,
                    "message": parsed.text,
                    "entities": entities
                }

                if not full_list and 'sort_buttons' in locals():
                    message_data["reply_markup"] = {"inline_keyboard": sort_buttons}

                send_message(message_data)

            except Exception as e:
                log(f"[SteamPlugin] Ошибка при отправке отсортированной библиотеки: {str(e)}")
                import traceback
                log(f"[SteamPlugin] Трассировка: {traceback.format_exc()}")
                try:
                    send_message({
                        "peer": peer,
                        "message": localise("failed_to_load_library")
                    })
                except:
                    pass

        threading.Thread(target=_send, daemon=True).start()

    def send_game_inventory(self, peer, steam_id, api_key, app_id=730, edit_msg_id=None):
        def _send():
            try:
                resolved_id = resolve_steam_id(steam_id, api_key) or steam_id
                game_config = SUPPORTED_INVENTORY_GAMES.get(app_id, SUPPORTED_INVENTORY_GAMES[730])
                context_id = game_config["context_id"]
                game_name = game_config["full_name"]
                game_icon = game_config["icon"]
                rarity_order = game_config["order"] if is_ru() else game_config["order_en"]

                steam_api = SteamAPI(api_key, resolved_id)
                data, error = steam_api.get_inventory(resolved_id, app_id=app_id, context_id=context_id)

                if error == 'private':
                    self._send_or_edit_inventory_message(peer, localise("error_inventory_private"), [], edit_msg_id=edit_msg_id)
                    return
                if error == 'rate_limit':
                    self._send_or_edit_inventory_message(peer, localise("error_inventory_rate_limit"), [], edit_msg_id=edit_msg_id)
                    return
                if error == 'error' or data is None:
                    self._send_or_edit_inventory_message(peer, localise("error_inventory_generic"), [], edit_msg_id=edit_msg_id)
                    return

                assets = data.get('assets', [])
                descriptions = data.get('descriptions', [])

                desc_map = {}
                for d in descriptions:
                    desc_map[(str(d.get('classid')), str(d.get('instanceid')))] = d

                grouped_items = {}
                total_items = 0
                for asset in assets:
                    key = (str(asset.get('classid')), str(asset.get('instanceid')))
                    desc = desc_map.get(key)
                    if not desc:
                        continue
                    amount = int(asset.get('amount', 1) or 1)
                    total_items += amount

                    if key not in grouped_items:
                        display_name = desc.get('market_hash_name') or desc.get('name') or 'Unknown item'
                        wear = cs2_extract_wear_letters(display_name) if app_id == 730 else None
                        if wear:
                            display_name = cs2_strip_wear(display_name)
                        rarity_group = get_inventory_item_rarity(app_id, desc.get('tags'))
                        grouped_items[key] = {
                            'name': display_name,
                            'wear': wear,
                            'group': rarity_group,
                            'qty': 0
                        }
                    grouped_items[key]['qty'] += amount

                # Text buttons for game selection
                def _btn(code, icon, name, gid):
                    if gid == app_id:
                        return f"▶️ {icon} *{name}* ◀️"
                    link = f"tg://steamplugin?game={code}&sid={resolved_id}&peer={peer}"
                    if edit_msg_id:
                        link += f"&mid={edit_msg_id}"
                    return f"{icon} [{name}]({link})"

                b_cs = _btn("cs2", "[🔫](5307872926886808571)", "CS2", 730)
                b_tf = _btn("tf2", "[🎩](5465519392248838285)", "TF2", 440)
                b_dota = _btn("dota", "[⚔️](5418011199914662526)", "Dota 2", 570)

                sel_title = "Выбор игры:" if is_ru() else "Select game:"
                buttons_text = (
                    f"\n\n🎮 *{sel_title}*\n"
                    f"{b_cs}  •  {b_tf}  •  {b_dota}"
                )

                if not grouped_items:
                    empty_text = f"❌ В инвентаре {game_name} предметов не найдено.{buttons_text}" if is_ru() else f"❌ No items found in {game_name} inventory.{buttons_text}"
                    parsed = parse_markdown(empty_text)
                    entities = [entity.to_tlrpc_object() for entity in parsed.entities]
                    self._send_or_edit_inventory_message(peer, parsed.text, entities, edit_msg_id=edit_msg_id)
                    return

                by_group = {}
                for item in grouped_items.values():
                    by_group.setdefault(item['group'], []).append(item)

                ordered_groups = [g for g in rarity_order if g in by_group]
                extra_groups = sorted(g for g in by_group.keys() if g not in rarity_order)
                ordered_groups.extend(extra_groups)

                unique_count = len(grouped_items)
                header_title = f"{game_icon} *Инвентарь {game_name}*\n" if is_ru() else f"{game_icon} *{game_name} Inventory*\n"
                header = header_title + localise('inventory_total', total=total_items, unique=unique_count) + "\n\n"

                items_text = ""
                for group_name in ordered_groups:
                    items = sorted(by_group[group_name], key=lambda x: x['name'])
                    items_text += f"*{escape_markdown(group_name)}*:\n"
                    for item in items:
                        line = f"• {escape_markdown(item['name'])}"
                        if item.get('wear'):
                            line += f" ({item['wear']})"
                        if item['qty'] > 1:
                            line += f" x{item['qty']}"
                        items_text += line + "\n"
                    items_text += "\n"

                items_text = items_text.strip()

                max_items_len = 4000 - len(header) - len(buttons_text) - 50
                if len(items_text) > max_items_len:
                    lines = items_text.splitlines(True)
                    truncated_items = ""
                    for l in lines:
                        if len(truncated_items) + len(l) + 70 > max_items_len:
                            trunc_note = "\n• ...и другие предметы (список обрезан по лимиту Telegram)\n" if is_ru() else "\n• ...and more items (truncated due to Telegram limit)\n"
                            truncated_items += trunc_note
                            break
                        truncated_items += l
                    items_text = truncated_items.strip()

                full_message = header + items_text + buttons_text

                parsed = parse_markdown(full_message)
                entities = [entity.to_tlrpc_object() for entity in parsed.entities]
                try:
                    total_line = localise('inventory_total', total=total_items, unique=unique_count)
                    pos_total = parsed.text.find(total_line)
                    if pos_total != -1:
                        start_char_idx = pos_total + len(total_line)
                        while start_char_idx < len(parsed.text) and parsed.text[start_char_idx] == '\n':
                            start_char_idx += 1
                    else:
                        start_char_idx = parsed.text.find("\n\n")
                        if start_char_idx != -1:
                            while start_char_idx < len(parsed.text) and parsed.text[start_char_idx] == '\n':
                                start_char_idx += 1
                        else:
                            start_char_idx = 0

                    end_char_idx = parsed.text.rfind("🎮")
                    if end_char_idx != -1:
                        while end_char_idx > start_char_idx and parsed.text[end_char_idx - 1] == '\n':
                            end_char_idx -= 1
                    else:
                        end_char_idx = len(parsed.text)

                    if 0 <= start_char_idx < end_char_idx <= len(parsed.text):
                        prefix = parsed.text[:start_char_idx]
                        body = parsed.text[start_char_idx:end_char_idx]

                        offset = len(prefix.encode('utf-16le')) // 2
                        length = len(body.encode('utf-16le')) // 2

                        blockquote_entity = TLRPC.TL_messageEntityBlockquote()
                        blockquote_entity.collapsed = True
                        blockquote_entity.flags = 1
                        blockquote_entity.offset = offset
                        blockquote_entity.length = length
                        entities.append(blockquote_entity)
                except Exception as e:
                    log(f"[SteamPlugin] Не удалось добавить свёрнутую цитату: {e}")

                self._send_or_edit_inventory_message(peer, parsed.text, entities, edit_msg_id=edit_msg_id)

            except Exception as e:
                log(f"[SteamPlugin] Ошибка при отправке инвентаря {app_id}: {str(e)}")
                import traceback
                log(f"[SteamPlugin] Трассировка: {traceback.format_exc()}")
                try:
                    self._send_or_edit_inventory_message(peer, localise("error_inventory_generic"), [], edit_msg_id=edit_msg_id)
                except:
                    pass

        threading.Thread(target=_send, daemon=True).start()

    def _get_card_font(self, size=30):
        font_index = self.get_setting("card_font_family", 0)
        if font_index == 3:
            custom_font_url = self.get_setting("custom_font_path", "").strip()
            if custom_font_url and custom_font_url.startswith(('http://', 'https://')):
                try:
                    custom_font_file = File(self._temp_dir, "custom_font.ttf").getAbsolutePath()
                    if os.path.exists(custom_font_file):
                        f = ImageFont.truetype(custom_font_file, size)
                        setattr(f, "_path", custom_font_file)
                        return f
                except Exception:
                    font_index = 0
        if font_index >= len(FONTS):
            font_index = 0
        font_key = list(FONTS.keys())[font_index]
        font_file_name = f"{font_key}-Regular.ttf"
        try:
            font_path = File(self._temp_dir, font_file_name).getAbsolutePath()
            if os.path.exists(font_path):
                f = ImageFont.truetype(font_path, size)
                setattr(f, "_path", font_path)
                return f
        except Exception:
            pass
        return ImageFont.load_default()

    def _calc_text_width(self, draw, text, font):
        try:
            bbox = draw.textbbox((0, 0), text, font=font)
            return bbox[2] - bbox[0]
        except Exception:
            try:
                return draw.textsize(text, font=font)[0]
            except Exception:
                return len(text) * 10

    def _truncate_text_width(self, draw, text, font, max_width):
        if not text:
            return ""
        if self._calc_text_width(draw, text, font) <= max_width:
            return text
        while len(text) > 1 and self._calc_text_width(draw, text + "...", font) > max_width:
            text = text[:-1]
        return text + "..."

    def get_profile_card_data(self, raw_steam_id: str, api_key: str):
        try:
            resolved_id = resolve_steam_id(raw_steam_id, api_key) or raw_steam_id
            api = SteamAPI(api_key, resolved_id)
            summary_res = api.get_player_summary()
            if not summary_res or 'response' not in summary_res or not summary_res['response'].get('players'):
                return None, ("❌ Профиль не найден или скрыт" if is_ru() else "❌ Profile not found or private")

            player = summary_res['response']['players'][0]
            nick = player.get('personaname', 'Steam User')
            real_name = player.get('realname', '')
            country = player.get('loccountrycode', '')
            avatar_url = player.get('avatarfull') or player.get('avatarmedium') or player.get('avatar', '')
            profile_url = player.get('profileurl', f"https://steamcommunity.com/profiles/{resolved_id}")

            in_game = 'gameextrainfo' in player
            game_extrainfo = player.get('gameextrainfo', '')
            personastate = player.get('personastate', 0)

            if in_game:
                status_text = f"В игре: {game_extrainfo}" if is_ru() else f"In-Game: {game_extrainfo}"
                status_color = (144, 186, 60)
            elif personastate > 0:
                status_text = "В сети" if is_ru() else "Online"
                status_color = (102, 192, 244)
            else:
                status_text = "Не в сети" if is_ru() else "Offline"
                status_color = (143, 152, 160)

            level = api.get_steam_level(resolved_id)

            recent_games = []
            try:
                rec_res = api.get_recent_games(count=3)
                games_list = rec_res.get('response', {}).get('games', [])
                for g in games_list[:3]:
                    appid = g.get('appid')
                    name = g.get('name', f"App {appid}")
                    playtime_forever = g.get('playtime_forever', 0)
                    playtime_2weeks = g.get('playtime_2weeks', 0)
                    forever_hours = round(playtime_forever / 60, 1)
                    two_weeks_hours = round(playtime_2weeks / 60, 1)
                    header_url = f"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/{appid}/header.jpg"
                    recent_games.append({
                        "appid": appid,
                        "name": name,
                        "forever_hours": forever_hours,
                        "two_weeks_hours": two_weeks_hours,
                        "header_url": header_url
                    })
            except Exception as e:
                log(f"[SteamPlugin] Error fetching recent games: {e}")

            return {
                "steam_id": resolved_id,
                "nickname": nick,
                "real_name": real_name,
                "country": country,
                "avatar_url": avatar_url,
                "profile_url": profile_url,
                "status_text": status_text,
                "status_color": status_color,
                "in_game": in_game,
                "game_extrainfo": game_extrainfo,
                "level": level,
                "recent_games": recent_games
            }, None
        except Exception as e:
            log(f"[SteamPlugin] get_profile_card_data error: {e}")
            return None, str(e)

    def generate_profile_card(self, data: dict):
        try:
            width = 1080
            height = 1120
            card = Image.new("RGBA", (width, height), (16, 24, 34, 255))

            avatar_img = None
            if data.get("avatar_url"):
                try:
                    resp = requests.get(
                        data["avatar_url"],
                        timeout=8,
                        headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
                    )
                    if resp.status_code == 200:
                        avatar_img = Image.open(io.BytesIO(resp.content)).convert("RGBA")
                except Exception as e:
                    log(f"[SteamPlugin] Failed to download avatar: {e}")

            if avatar_img:
                try:
                    ambient = avatar_img.resize((width, height))
                    ambient = ambient.filter(ImageFilter.GaussianBlur(65))
                    dark_overlay = Image.new("RGBA", (width, height), (14, 20, 27, 215))
                    card = Image.alpha_composite(ambient, dark_overlay)
                except Exception as e:
                    log(f"[SteamPlugin] Failed ambient backdrop: {e}")

            draw = ImageDraw.Draw(card)

            font_title = self._get_card_font(34)
            font_subtitle = self._get_card_font(20)
            font_badge = self._get_card_font(18)
            font_section = self._get_card_font(24)
            font_game_name = self._get_card_font(24)
            font_game_stats = self._get_card_font(20)
            font_footer = self._get_card_font(17)

            def _round_corners(img, radius):
                mask = Image.new('L', img.size, 0)
                mask_draw = ImageDraw.Draw(mask)
                try:
                    mask_draw.rounded_rectangle([0, 0, img.size[0], img.size[1]], radius=radius, fill=255)
                except Exception:
                    mask_draw.rectangle([0, 0, img.size[0], img.size[1]], fill=255)
                out = Image.new('RGBA', img.size, (0, 0, 0, 0))
                out.paste(img, (0, 0), mask)
                return out

            av_x, av_y, av_size = 60, 85, 140
            status_color = data.get("status_color", (102, 192, 244))
            try:
                draw.rounded_rectangle([av_x - 3, av_y - 3, av_x + av_size + 3, av_y + av_size + 3], radius=18, outline=status_color, width=4)
            except Exception:
                draw.rectangle([av_x - 3, av_y - 3, av_x + av_size + 3, av_y + av_size + 3], outline=status_color, width=4)

            if avatar_img:
                av_thumb = avatar_img.resize((av_size, av_size), RESAMPLE_LANCZOS)
                av_rounded = _round_corners(av_thumb, 14)
                card.paste(av_rounded, (av_x, av_y), av_rounded)
            else:
                try:
                    draw.rounded_rectangle([av_x, av_y, av_x + av_size, av_y + av_size], radius=14, fill=(27, 40, 56))
                except Exception:
                    draw.rectangle([av_x, av_y, av_x + av_size, av_y + av_size], fill=(27, 40, 56))

            info_x = 225
            nick = data.get("nickname", "Steam User")
            nick_truncated = self._truncate_text_width(draw, nick, font_title, 570)
            draw.text((info_x, 86), nick_truncated, font=font_title, fill=(255, 255, 255))

            lvl = data.get("level", 0)
            lvl_text = f"LVL {lvl}"
            lvl_w = self._calc_text_width(draw, lvl_text, font_badge) + 24
            lvl_x = 1020 - lvl_w
            try:
                draw.rounded_rectangle([lvl_x, 88, lvl_x + lvl_w, 122], radius=10, fill=(33, 56, 77), outline=(102, 192, 244), width=2)
            except Exception:
                draw.rectangle([lvl_x, 88, lvl_x + lvl_w, 122], fill=(33, 56, 77), outline=(102, 192, 244))
            draw.text((lvl_x + 12, 94), lvl_text, font=font_badge, fill=(255, 255, 255))

            status_text = data.get("status_text", "В сети" if is_ru() else "Online")
            status_trunc = self._truncate_text_width(draw, status_text, font_subtitle, 740)
            draw.text((info_x, 136), status_trunc, font=font_subtitle, fill=status_color)

            sub_parts = []
            if data.get("real_name"):
                sub_parts.append(data["real_name"])
            if data.get("country"):
                sub_parts.append(data["country"])
            sub_parts.append(f"ID: {data.get('steam_id', '')}")
            sub_line = " • ".join(sub_parts)
            sub_trunc = self._truncate_text_width(draw, sub_line, font_subtitle, 740)
            draw.text((info_x, 180), sub_trunc, font=font_subtitle, fill=(143, 152, 160))

            draw.line([(60, 250), (1020, 250)], fill=(38, 59, 80), width=2)
            draw.text((60, 268), ("Последние сыгранные игры" if is_ru() else "Recent Played Games"), font=font_section, fill=(102, 192, 244))

            recent_games = data.get("recent_games", [])
            slot_start_y = 315
            slot_h = 210
            slot_gap = 18

            if recent_games:
                for idx, g in enumerate(recent_games[:3]):
                    slot_y = slot_start_y + idx * (slot_h + slot_gap)
                    try:
                        draw.rounded_rectangle([60, slot_y, 1020, slot_y + slot_h], radius=14, fill=(22, 32, 45, 240), outline=(38, 59, 80), width=1)
                    except Exception:
                        draw.rectangle([60, slot_y, 1020, slot_y + slot_h], fill=(22, 32, 45, 240), outline=(38, 59, 80))

                    header_img = None
                    if g.get("header_url"):
                        try:
                            h_resp = requests.get(
                                g["header_url"],
                                timeout=5,
                                headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
                            )
                            if h_resp.status_code == 200:
                                header_img = Image.open(io.BytesIO(h_resp.content)).convert("RGBA")
                        except Exception:
                            pass

                    img_w, img_h = 360, 172
                    img_x, img_y = 78, slot_y + 19
                    if header_img:
                        h_thumb = header_img.resize((img_w, img_h), RESAMPLE_LANCZOS)
                        h_round = _round_corners(h_thumb, 10)
                        card.paste(h_round, (img_x, img_y), h_round)
                    else:
                        try:
                            draw.rounded_rectangle([img_x, img_y, img_x + img_w, img_y + img_h], radius=10, fill=(30, 44, 60))
                        except Exception:
                            draw.rectangle([img_x, img_y, img_x + img_w, img_y + img_h], fill=(30, 44, 60))
                        draw.text((img_x + 100, img_y + 70), "NO ART", font=font_badge, fill=(143, 152, 160))

                    detail_x = 465
                    g_name = self._truncate_text_width(draw, g.get("name", "Unknown Game"), font_game_name, 510)
                    draw.text((detail_x, slot_y + 32), g_name, font=font_game_name, fill=(255, 255, 255))

                    label_total = "Всего в игре:" if is_ru() else "Total Playtime:"
                    label_2w = "За 2 недели:" if is_ru() else "Past 2 Weeks:"
                    w_total = self._calc_text_width(draw, label_total, font_game_stats)
                    w_2w = self._calc_text_width(draw, label_2w, font_game_stats)
                    val_offset = max(w_total, w_2w) + 16

                    draw.text((detail_x, slot_y + 86), label_total, font=font_game_stats, fill=(143, 152, 160))
                    hrs_suffix = "ч." if is_ru() else "hrs"
                    hours_total_str = f"{g.get('forever_hours', 0)} {hrs_suffix}"
                    draw.text((detail_x + val_offset, slot_y + 86), hours_total_str, font=font_game_stats, fill=(102, 192, 244))

                    draw.text((detail_x, slot_y + 130), label_2w, font=font_game_stats, fill=(143, 152, 160))
                    hours_2w_str = f"{g.get('two_weeks_hours', 0)} {hrs_suffix}"
                    draw.text((detail_x + val_offset, slot_y + 130), hours_2w_str, font=font_game_stats, fill=(255, 255, 255))
            else:
                try:
                    draw.rounded_rectangle([60, 315, 1020, 500], radius=14, fill=(22, 32, 45, 240), outline=(38, 59, 80), width=1)
                except Exception:
                    draw.rectangle([60, 315, 1020, 500], fill=(22, 32, 45, 240), outline=(38, 59, 80))
                empty_act_text = "Недавняя активность скрыта настройками приватности или пуста" if is_ru() else "Recent activity is hidden by privacy settings or empty"
                draw.text((130, 395), empty_act_text, font=font_subtitle, fill=(143, 152, 160))

            draw.line([(60, 1025), (1020, 1025)], fill=(38, 59, 80), width=1)
            draw.text((60, 1045), "Steam Plugin", font=font_footer, fill=(102, 192, 244))
            draw.text((740, 1045), "by @KangelPlugins & @MGEPlugins", font=font_footer, fill=(143, 152, 160))

            card_rgb = card.convert("RGB")
            if not self._temp_dir:
                self._temp_dir = self._get_temp_dir()
            if not self._temp_dir:
                import tempfile
                temp_card_path = os.path.join(tempfile.gettempdir(), f"temp_profile_{uuid.uuid4().hex[:8]}.jpg")
            else:
                temp_card_path = File(self._temp_dir, f"temp_profile_{uuid.uuid4().hex[:8]}.jpg").getAbsolutePath()
            card_rgb.save(temp_card_path, "JPEG", quality=92)
            log(f"[SteamPlugin] Profile card generated successfully: {temp_card_path}")
            return temp_card_path
        except Exception as e:
            import traceback
            log(f"[SteamPlugin] Error generating profile card: {e}\n{traceback.format_exc()}")
            return None

    def send_profile_card(self, peer, steam_id, api_key, account):
        def _worker():
            try:
                data, err = self.get_profile_card_data(steam_id, api_key)
                if err or not data:
                    self._run_on_ui_thread(lambda: BulletinHelper.show_error(err or ("❌ Ошибка загрузки профиля" if is_ru() else "❌ Failed to load profile")))
                    return

                user_ico = self._get_icon("user") or "👤"
                star_ico = self._get_icon("star") or "⭐"
                recent_ico = self._get_icon("game") or "🎮"

                status_icon = "🟢" if data.get("in_game") else ("🔵" if data.get("status_text") in ("В сети", "Online") else "⚪")
                profile_lbl = "Профиль Steam" if is_ru() else "Steam Profile"
                lvl_lbl = "Уровень" if is_ru() else "Level"
                status_lbl = "Статус" if is_ru() else "Status"
                caption_lines = [
                    self._with_icon(f"**{profile_lbl}: [{escape_markdown(data['nickname'])}]({data['profile_url']})**", user_ico),
                    self._with_icon(f"**{lvl_lbl}:** {data['level']} • **{status_lbl}:** {status_icon} {escape_markdown(data['status_text'])}", star_ico),
                ]

                if data.get("recent_games"):
                    recent_lbl = "**Недавние игры:**" if is_ru() else "**Recent games:**"
                    caption_lines.append("\n" + self._with_icon(recent_lbl, recent_ico))
                    for g in data["recent_games"][:3]:
                        g_appid = g.get('appid')
                        g_name_l = (g.get('name') or '').lower()
                        if g_appid == 730 or "counter-strike" in g_name_l or "cs2" in g_name_l:
                            g_bullet = "[🔫](5307872926886808571)"
                        elif g_appid == 440 or "team fortress" in g_name_l or "tf2" in g_name_l:
                            g_bullet = "[🎩](5465519392248838285)"
                        elif g_appid == 570 or "dota" in g_name_l:
                            g_bullet = "[⚔️](5418011199914662526)"
                        else:
                            g_bullet = "•"
                        hrs_suffix = "ч." if is_ru() else "hrs"
                        two_wks_lbl = "за 2 нед." if is_ru() else "past 2 wks"
                        caption_lines.append(f"{g_bullet} **{escape_markdown(g['name'])}** — {g['forever_hours']} {hrs_suffix} ({g['two_weeks_hours']} {hrs_suffix} {two_wks_lbl})")

                caption_text = "\n".join(caption_lines)
                parsed_caption = parse_markdown(caption_text.strip())

                try:
                    helper = get_send_messages_helper(account)
                except TypeError:
                    helper = get_send_messages_helper()

                temp_photo_path = self.generate_profile_card(data)
                generated_photo = None
                if temp_photo_path and os.path.exists(temp_photo_path):
                    try:
                        generated_photo = helper.generatePhotoSizes(temp_photo_path, None)
                    except Exception as e_gen:
                        log(f"[SteamPlugin] generatePhotoSizes error: {e_gen}")

                open_prof_btn_text = "🌐 Открыть профиль в Steam" if is_ru() else "🌐 Open Steam Profile"
                sent_ok = False
                if generated_photo is not None:
                    photo_payload = {
                        "peer": peer,
                        "photo": generated_photo,
                        "path": temp_photo_path,
                        "caption": parsed_caption.text,
                        "entities": [entity.to_tlrpc_object() for entity in parsed_caption.entities],
                        "message": None
                    }
                    try:
                        photo_payload_btn = dict(photo_payload)
                        photo_payload_btn["reply_markup"] = {
                            "inline_keyboard": [
                                [{"text": open_prof_btn_text, "url": data["profile_url"]}]
                            ]
                        }
                        send_message(photo_payload_btn)
                        sent_ok = True
                    except Exception as e_btn:
                        log(f"[SteamPlugin] send_message photo with reply_markup failed: {e_btn}, retrying without reply_markup")
                        try:
                            send_message(photo_payload)
                            sent_ok = True
                        except Exception as e_photo:
                            log(f"[SteamPlugin] send_message photo failed: {e_photo}")

                if not sent_ok:
                    log("[SteamPlugin] Falling back to text message for profile card")
                    text_payload = {
                        "peer": peer,
                        "message": parsed_caption.text,
                        "entities": [entity.to_tlrpc_object() for entity in parsed_caption.entities]
                    }
                    try:
                        text_payload_btn = dict(text_payload)
                        text_payload_btn["reply_markup"] = {
                            "inline_keyboard": [
                                [{"text": open_prof_btn_text, "url": data["profile_url"]}]
                            ]
                        }
                        send_message(text_payload_btn)
                    except Exception:
                        send_message(text_payload)

                if temp_photo_path and os.path.exists(temp_photo_path):
                    self.delete_temp_file_async(temp_photo_path)
            except Exception as e:
                import traceback
                log(f"[SteamPlugin] send_profile_card error: {e}\n{traceback.format_exc()}")
                err_msg = f"❌ Ошибка: {e}" if is_ru() else f"❌ Error: {e}"
                self._run_on_ui_thread(lambda: BulletinHelper.show_error(err_msg))

        threading.Thread(target=_worker, daemon=True).start()

    def on_send_message_hook(self, account, params):
        if not hasattr(params, "message") or not isinstance(params.message, str):
            return HookResult()

        message = params.message.strip()
        parts = message.split(None, 1)
        cmd = parts[0].lower() if parts else ""

        if cmd in (".sprofile", ".sp", ".steamprofile"):
            try:
                target_arg = parts[1].strip() if len(parts) > 1 else ""
                steam_id = target_arg or self.get_setting("steam_id", "").strip()
                api_key = self.get_setting("api_key", "").strip()

                if not steam_id:
                    params.message = localise("error_steam_id_not_set")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                if not api_key:
                    params.message = localise("error_api_key_not_set")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                try:
                    BulletinHelper.show_info(localise("loading_profile"))
                except Exception:
                    pass

                self.send_profile_card(params.peer, steam_id, api_key, account)
                return HookResult(strategy=HookStrategy.CANCEL)
            except Exception as e:
                log(f"[SteamPlugin] Ошибка обработки .sprofile: {e}")
                params.message = f"❌ Ошибка: {e}" if is_ru() else f"❌ Error: {e}"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if message in (".slibrary", ".sflibrary"):
            is_full_library = message == ".sflibrary"
            command_name = ".sflibrary" if is_full_library else ".slibrary"

            try:
                log(f"[SteamPlugin] Обработка команды {command_name}")
                steam_id = self.get_setting("steam_id", "").strip()
                api_key = self.get_setting("api_key", "").strip()

                if not steam_id:
                    params.message = localise("error_steam_id_not_set")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                if not api_key:
                    params.message = localise("error_api_key_not_set")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                try:
                    BulletinHelper.show_info(localise("loading_library"))
                    log("[SteamPlugin] Показано уведомление о загрузке")
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка при показе уведомления: {str(e)}")

                def send_library_message(peer):
                    try:
                        log("[SteamPlugin] Загрузка библиотеки...")
                        games, error = self.get_steam_library(steam_id, api_key)

                        if error:
                            log(f"[SteamPlugin] Ошибка при получении библиотеки: {error}")
                            message = error
                        else:
                            if not games:
                                log("[SteamPlugin] Библиотека игр пуста")
                                message = localise("library_empty")
                            else:
                                log(f"[SteamPlugin] Успешно получено {len(games)} игр")
                                games_sorted = sorted(games, key=lambda x: x.get('playtime_forever', 0), reverse=True)

                                games_list = []
                                total_games = len(games_sorted)
                                total_playtime = sum(game.get('playtime_forever', 0) for game in games_sorted) // 60

                                max_games = 30
                                games_to_show = games_sorted[:max_games]

                                for i, game in enumerate(games_to_show, 1):
                                    try:
                                        name = escape_markdown(game.get('name', 'Неизвестная игра' if is_ru() else 'Unknown game'))
                                        g_appid = game.get('appid')
                                        g_name_l = (game.get('name') or '').lower()
                                        if g_appid == 730 or "counter-strike" in g_name_l or "cs2" in g_name_l:
                                            g_ico = "[🔫](5307872926886808571) "
                                        elif g_appid == 440 or "team fortress" in g_name_l or "tf2" in g_name_l:
                                            g_ico = "[🎩](5465519392248838285) "
                                        elif g_appid == 570 or "dota" in g_name_l:
                                            g_ico = "[⚔️](5418011199914662526) "
                                        else:
                                            g_ico = ""
                                        playtime = game.get('playtime_forever', 0)
                                        hours = playtime // 60
                                        minutes = playtime % 60
                                        if hours > 0:
                                            playtime_str = localise("duration_compact_hm", hours=hours, minutes=minutes)
                                        else:
                                            playtime_str = localise("duration_compact_m", minutes=minutes)
                                        games_list.append(f"{i}. {g_ico}{name} - {playtime_str}")
                                    except Exception as game_err:
                                        log(f"[SteamPlugin] Ошибка при обработке игры {i}: {str(game_err)}")

                                if total_games > max_games:
                                    games_list.append("\n" + localise("and_more_games", count=total_games - max_games))

                                sort_buttons = [
                                    [{"text": localise("btn_sort_by_hours"), "callback_data": f"sort_hours_{steam_id}"}],
                                    [{"text": localise("btn_sort_by_last_played"), "callback_data": f"sort_last_played_{steam_id}"}]
                                ]

                                message = f"🎮 *{localise('library_header')}*\n" + localise('total_games_and_time', count=total_games, hours=total_playtime) + "\n\n"
                                message += "\n".join(games_list)
                                message += f"\n\n📊 *{localise('sorting_label')}* {localise('sort_by_hours_text')}"
                                log("[SteamPlugin] Сообщение с библиотекой сформировано")

                        log("[SteamPlugin] Отправляем сообщение с библиотекой и кнопками")
                        parsed = parse_markdown(message)
                        entities = [entity.to_tlrpc_object() for entity in parsed.entities]
                        try:
                            blockquote_entity = TLRPC.TL_messageEntityBlockquote()
                            blockquote_entity.collapsed = True
                            blockquote_entity.offset = 0
                            try:
                                blockquote_entity.length = len(parsed.text.encode('utf-16le')) // 2
                            except Exception:
                                blockquote_entity.length = len(parsed.text)
                            entities.append(blockquote_entity)
                        except Exception as e:
                            log(f"[SteamPlugin] Не удалось добавить свёрнутую цитату: {e}")

                        send_message({
                            "peer": peer,
                            "message": parsed.text,
                            "entities": entities,
                            "reply_markup": {
                                "inline_keyboard": sort_buttons
                            }
                        })

                    except Exception as e:
                        import traceback
                        error_msg = f"{localise('error_unknown_generic', e=str(e))}\n\n{traceback.format_exc()}"
                        log(f"[SteamPlugin] {error_msg}")
                        try:
                            send_message({
                                "peer": peer,
                                "message": localise("failed_to_load_library")
                            })
                        except:
                            pass

                try:
                    BulletinHelper.show_info(localise("loading_library"))
                    sort_type = 'hours' if self.get_setting("sort_by_playtime", True) else 'last_played'
                    self.send_sorted_library(params.peer, steam_id, api_key, sort_type, is_full_library)
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка при запуске потока: {str(e)}")
                    params.message = localise("failed_to_load_library")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                return HookResult(strategy=HookStrategy.CANCEL)

            except Exception as e:
                import traceback
                error_msg = f"❌ Критическая ошибка: {str(e)}\n\n{traceback.format_exc()}"
                log(f"[SteamPlugin] {error_msg}")
                params.message = "❌ Произошла критическая ошибка. Пожалуйста, проверьте логи." if is_ru() else "❌ A critical error occurred. Please check logs."
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

        msg_parts = message.split()
        first_word = msg_parts[0].lower() if msg_parts else ""

        if first_word in (".sinv", ".csinv", ".cs2inv"):
            try:
                log(f"[SteamPlugin] Обработка команды инвентаря: {message}")
                default_steam_id = self.get_setting("steam_id", "").strip()
                api_key = self.get_setting("api_key", "").strip()

                # Загружаем сохраненный выбор игры (по умолчанию 0 -> 730 / CS2)
                saved_val = self.get_setting("last_inv_game", 0)
                if saved_val in (1, 440, "440"):
                    app_id = 440
                elif saved_val in (2, 570, "570"):
                    app_id = 570
                else:
                    app_id = 730

                target_steam_id = default_steam_id
                explicit_game_chosen = False

                for arg in msg_parts[1:]:
                    al = arg.lower()
                    if al in ("tf", "tf2", "teamfortress", "teamfortress2"):
                        app_id = 440
                        explicit_game_chosen = True
                    elif al in ("dota", "dota2", "дота", "дота2"):
                        app_id = 570
                        explicit_game_chosen = True
                    elif al in ("cs", "cs2", "csgo", "кс", "кс2", "ксго"):
                        app_id = 730
                        explicit_game_chosen = True
                    else:
                        target_steam_id = arg

                # Если игра была указана явно - запоминаем выбор для следующих вызовов .sinv!
                if explicit_game_chosen:
                    APPID_TO_INDEX = {730: 0, 440: 1, 570: 2}
                    self.set_setting("last_inv_game", APPID_TO_INDEX.get(app_id, 0))

                if not target_steam_id:
                    params.message = localise("error_steam_id_not_set")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                try:
                    game_name = SUPPORTED_INVENTORY_GAMES.get(app_id, {}).get("full_name", "Steam")
                    BulletinHelper.show_info(localise("loading_inventory_for_game", game=game_name))
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка при показе уведомления: {str(e)}")

                try:
                    self.send_game_inventory(params.peer, target_steam_id, api_key, app_id=app_id)
                except Exception as e:
                    log(f"[SteamPlugin] Ошибка при запуске потока инвентаря: {str(e)}")
                    params.message = localise("error_inventory_generic")
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

                return HookResult(strategy=HookStrategy.CANCEL)

            except Exception as e:
                import traceback
                log(f"[SteamPlugin] Критическая ошибка в команде инвентаря: {str(e)}\n{traceback.format_exc()}")
                params.message = localise("error_inventory_generic")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

        if not (message.lower().startswith(".nowsteam") or message.lower().startswith(".snp")):
            return HookResult()

        try:
            steam_id = self.get_setting("steam_id", "")
            api_key = self.get_setting("api_key", "")

            log(f"[SteamPlugin] Команда .nowsteam получена. Steam ID: {steam_id}, API Key: {'*' * 8 + api_key[-4:] if api_key else 'Не установлен'}")

            if not steam_id:
                BulletinHelper.show_error(localise("error_steam_id_not_set"))
                return HookResult(strategy=HookStrategy.CANCEL)

            if not api_key:
                BulletinHelper.show_error(localise("error_api_key_not_set"))
                return HookResult(strategy=HookStrategy.CANCEL)

            def search_and_reply(peer):
                try:
                    log("[SteamPlugin] Начинаем поиск информации об игре...")
                    result, image_url, playtime, game_url, nickname = self.get_game(steam_id, api_key)
                    log(f"[SteamPlugin] Получен результат: {result}, nickname: {nickname}")
                    
                    if isinstance(result, str) and (result.startswith('❌') or result.startswith('Error') or result.startswith('Ошибка')):
                        BulletinHelper.show_error(result)
                        return

                    if result == self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT):
                        log("[SteamPlugin] Игрок не в игре")
                        text_np = self._with_icon(str(result), self._get_icon("star"))
                        parsed = parse_markdown(text_np)
                        send_message({
                            "peer": peer,
                            "message": parsed.text,
                            "entities": [entity.to_tlrpc_object() for entity in parsed.entities]
                        })
                        return
                    
                   
                    playtime_text = ""
                    if isinstance(result, dict) and 'playtime' in result:
                        hours = result['playtime'] // 60
                        minutes = result['playtime'] % 60
                        if hours > 0:
                            playtime_text = localise("playtime", hours=hours, minutes=minutes)
                        else:
                            playtime_text = localise("playtime_minutes", minutes=minutes)
                    elif playtime is not None:
                        hours = playtime // 60
                        minutes = playtime % 60
                        if hours > 0:
                            playtime_text = localise("playtime", hours=hours, minutes=minutes)
                        else:
                            playtime_text = localise("playtime_minutes", minutes=minutes)
                    
                    caption_message = ""
                    if isinstance(result, dict):
                        g_appid = result.get('appid')
                        g_name_l = (result.get('name') or '').lower()
                        if g_appid == 730 or "counter-strike" in g_name_l or "cs2" in g_name_l:
                            game_ico = self._get_icon('cs2') or self._get_icon('game')
                        elif g_appid == 440 or "team fortress" in g_name_l or "tf2" in g_name_l:
                            game_ico = self._get_icon('tf2') or self._get_icon('game')
                        elif g_appid == 570 or "dota" in g_name_l:
                            game_ico = self._get_icon('dota') or self._get_icon('game')
                        else:
                            game_ico = self._get_icon('game')
                        caption_lines = []
                        caption_lines.append(self._with_icon(localise("playing_format", game=escape_markdown(result['name'])), game_ico))
                        if result.get('developers'):
                            caption_lines.append(self._with_icon(localise("developers", developers=escape_markdown(', '.join(result['developers']))), self._get_icon('dev')))
                        if result.get('publishers') and result['publishers'] != result.get('developers', []):
                            caption_lines.append(self._with_icon(localise("publishers", publishers=escape_markdown(', '.join(result['publishers']))), self._get_icon('pub')))
                        caption_lines.append(self._with_icon(localise("metacritic", score=result.get('metacritic', 'N/A')), self._get_icon('meta')))
                        reviews_percent = result.get('reviews_percent')
                        if reviews_percent is not None:
                            total_formatted = f"{result.get('reviews_total', 0):,}".replace(',', ' ')
                            reviews_line = localise("reviews", percent=reviews_percent, total=total_formatted)
                        else:
                            reviews_line = localise("reviews_na")
                        caption_lines.append(self._with_icon(reviews_line, self._get_icon('reviews')))
                        if result.get('genres'):
                            caption_lines.append(self._with_icon(localise("genres", genres=escape_markdown(', '.join(result['genres'][:3]))), self._get_icon('genre')))
                        if isinstance(result, dict) and 'playtime' in result:
                            hours = result['playtime'] // 60
                            minutes = result['playtime'] % 60
                            if hours > 0:
                                pt = localise("playtime", hours=hours, minutes=minutes)
                            else:
                                pt = localise("playtime_minutes", minutes=minutes)
                            caption_lines.append(self._with_icon(pt, self._get_icon('time')))
                        if result.get('store_url'):
                            caption_lines.append("\n" + self._with_icon(localise("game_link", url=escape_markdown(result['store_url'])), self._get_icon('link')))
                        caption_message = "\n".join(caption_lines)
                    else:
                        line_playing = self._with_icon(localise("playing_format", game=escape_markdown(result)), self._get_icon('game'))
                        if playtime is not None:
                            hours = playtime // 60
                            minutes = playtime % 60
                            if hours > 0:
                                pt = localise("playtime", hours=hours, minutes=minutes)
                            else:
                                pt = localise("playtime_minutes", minutes=minutes)
                            line_time = self._with_icon(pt, self._get_icon('time'))
                            caption_message = f"{line_playing}\n{line_time}"
                        else:
                            caption_message = line_playing
                        if game_url:
                            caption_message += "\n\n" + self._with_icon(localise("game_link", url=escape_markdown(game_url)), self._get_icon('link'))

                    try:
                        temp_photo_path = self._make_card(result, nickname, image_url)
                        helper = get_send_messages_helper()
                        if temp_photo_path:
                            generated_photo = helper.generatePhotoSizes(temp_photo_path, None)
                            if generated_photo is not None:
                                log("[SteamPlugin] Отправляем сообщение с карточкой и подписью")
                                parsed_caption = parse_markdown(caption_message.strip())
                                send_message({
                                    "peer": peer,
                                    "photo": generated_photo,
                                    "path": temp_photo_path,
                                    "caption": parsed_caption.text,
                                    "entities": [entity.to_tlrpc_object() for entity in parsed_caption.entities],
                                    "message": None
                                })
                                self.delete_temp_file_async(temp_photo_path)
                                return
                            else:
                                log("[SteamPlugin] Не удалось сгенерировать фото (card)")
                                self.delete_temp_file_async(temp_photo_path)
                        log("[SteamPlugin] Переходим на fallback-фото без обработки")
                        fallback_path = self.download_game_image(NO_STEAM_FALLBACK_URL)
                        if fallback_path:
                            generated_photo = helper.generatePhotoSizes(fallback_path, None)
                            if generated_photo is not None:
                                parsed_caption = parse_markdown(caption_message.strip())
                                send_message({
                                    "peer": peer,
                                    "photo": generated_photo,
                                    "path": fallback_path,
                                    "caption": parsed_caption.text,
                                    "entities": [entity.to_tlrpc_object() for entity in parsed_caption.entities],
                                    "message": None
                                })
                                self.delete_temp_file_async(fallback_path)
                                return
                            else:
                                log("[SteamPlugin] Не удалось сгенерировать фото (fallback)")
                                self.delete_temp_file_async(fallback_path)
                        BulletinHelper.show_error(localise("error_unknown_generic", e="card generation failed"))
                    except Exception as e:
                        log(f"[SteamPlugin] Ошибка при создании или отправке карточки: {e}")
                        BulletinHelper.show_error(localise("error_unknown", e=str(e)))

                except Exception as e:
                    log(f"[SteamPlugin] Ошибка в потоке поиска: {e}")
                    BulletinHelper.show_error(localise("error_unknown", e=str(e)))

            try:
                BulletinHelper.show_info(localise("searching"))
            except Exception as e:
                log(f"[SteamPlugin] Ошибка при создании диалога: {e}")

            threading.Thread(target=lambda: search_and_reply(params.peer), daemon=True).start()
            return HookResult(strategy=HookStrategy.CANCEL)

        except Exception as e:
            params.message = localise("error_unknown", e=str(e))
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def _make_card(self, game_info, nickname, image_url):
        log(f"[SteamPlugin] Starting upgraded _make_card with game_info: {game_info}, nickname: {nickname}")
        if not game_info or not isinstance(game_info, dict):
            log(f"[SteamPlugin] Invalid game info: {game_info}")
            return None

        width, height = 1080, 1080

        try:
            game_name = game_info.get('name', 'Unknown Game')
            playtime = game_info.get('playtime', 0)
            hours, minutes = divmod(playtime, 60)
            if is_ru():
                if hours > 0:
                    playtime_text = f"{hours} ч. {minutes} м."
                else:
                    playtime_text = f"{minutes} м."
            else:
                if hours > 0:
                    playtime_text = f"{hours}h {minutes}m"
                else:
                    playtime_text = f"{minutes}m"

            developers = ", ".join(game_info.get('developers', [])) or "N/A"
            publishers = ", ".join(game_info.get('publishers', [])) or "N/A"
            genres = ", ".join(game_info.get('genres', [])[:3]) or "N/A"
            release_date = game_info.get('release_date', 'N/A')
            metacritic = str(game_info.get('metacritic', 'N/A'))
            reviews_percent = game_info.get('reviews_percent')
            reviews_total = game_info.get('reviews_total', 0)
            avatar_url = game_info.get('avatar_url', '')

            default_card_fmt = "{nick} играет в {game}" if is_ru() else "{nick} is playing {game}"
            card_text_format = self.get_setting("card_text_format", default_card_fmt)
            header_status_text = card_text_format.replace("{nick}", nickname).replace("{game}", game_name)
        except Exception as e:
            log(f"[SteamPlugin] Error extracting game info: {e}")
            return None

        original_image = None
        if image_url and image_url.strip():
            try:
                resp = requests.get(image_url, timeout=10)
                if resp.status_code == 200:
                    original_image = Image.open(io.BytesIO(resp.content)).convert("RGBA")
            except Exception as e:
                log(f"[SteamPlugin] Error downloading game cover: {e}")

        avatar_image = None
        if avatar_url and avatar_url.strip():
            try:
                a_resp = requests.get(avatar_url, timeout=8)
                if a_resp.status_code == 200:
                    avatar_image = Image.open(io.BytesIO(a_resp.content)).convert("RGBA")
            except Exception as e:
                log(f"[SteamPlugin] Error downloading avatar: {e}")

        card = Image.new("RGBA", (width, height), (16, 24, 34, 255))
        if original_image:
            try:
                ambient = original_image.resize((width, height))
                ambient = ambient.filter(ImageFilter.GaussianBlur(55))
                dark_overlay = Image.new("RGBA", (width, height), (14, 20, 27, 215))
                card = Image.alpha_composite(ambient, dark_overlay)
            except Exception as e:
                log(f"[SteamPlugin] Error creating ambient background: {e}")

        draw = ImageDraw.Draw(card)

        font_player = self._get_card_font(26)
        font_sub = self._get_card_font(19)
        font_title = self._get_card_font(32)
        font_badge_lbl = self._get_card_font(17)
        font_badge_val = self._get_card_font(23)
        font_details = self._get_card_font(19)
        font_footer = self._get_card_font(17)

        def _round_corners(img, radius):
            mask = Image.new('L', img.size, 0)
            mask_draw = ImageDraw.Draw(mask)
            try:
                mask_draw.rounded_rectangle([(0, 0), img.size], radius=radius, fill=255)
            except Exception:
                mask_draw.rectangle([(0, 0), img.size], fill=255)
            out = Image.new('RGBA', img.size, (0, 0, 0, 0))
            out.paste(img, (0, 0), mask)
            return out

        head_y = 68
        if avatar_image:
            av_size = 68
            av_thumb = avatar_image.resize((av_size, av_size), RESAMPLE_LANCZOS)
            av_round = _round_corners(av_thumb, 14)
            try:
                draw.rounded_rectangle([(58, head_y - 2), (58 + av_size + 4, head_y + av_size + 2)], radius=16, outline=(144, 186, 60), width=3)
            except Exception:
                draw.rectangle([(58, head_y - 2), (58 + av_size + 4, head_y + av_size + 2)], outline=(144, 186, 60), width=3)
            card.paste(av_round, (60, head_y), av_round)

            info_x = 145
            nick_trunc = self._truncate_text_width(draw, nickname, font_player, 650)
            draw.text((info_x, head_y + 4), nick_trunc, font=font_player, fill=(255, 255, 255))
            draw.text((info_x, head_y + 38), ("Сейчас в игре" if is_ru() else "Currently in-game"), font=font_sub, fill=(144, 186, 60))
        else:
            header_trunc = self._truncate_text_width(draw, header_status_text, font_player, 750)
            draw.text((60, head_y + 16), header_trunc, font=font_player, fill=(255, 255, 255))

        try:
            draw.rounded_rectangle([(870, head_y + 12), (1020, head_y + 52)], radius=10, fill=(33, 56, 77), outline=(144, 186, 60), width=2)
        except Exception:
            draw.rectangle([(870, head_y + 12), (1020, head_y + 52)], fill=(33, 56, 77), outline=(144, 186, 60))
        badge_txt = "В игре" if is_ru() else "In-Game"
        w_b = self._calc_text_width(draw, badge_txt, font_sub)
        draw.text(((870 + 1020 - w_b) / 2, head_y + 20), badge_txt, font=font_sub, fill=(144, 186, 60))

        draw.line([(60, 155), (1020, 155)], fill=(38, 59, 80), width=2)

        banner_w, banner_h = 960, 460
        banner_x, banner_y = 60, 175
        if original_image:
            try:
                banner_thumb = original_image.resize((banner_w, banner_h), RESAMPLE_LANCZOS)
                banner_round = _round_corners(banner_thumb, 16)
                card.paste(banner_round, (banner_x, banner_y), banner_round)
            except Exception as e:
                log(f"[SteamPlugin] Error pasting banner: {e}")
        else:
            try:
                draw.rounded_rectangle([(banner_x, banner_y), (banner_x + banner_w, banner_y + banner_h)], radius=16, fill=(27, 40, 56), outline=(38, 59, 80), width=2)
            except Exception:
                draw.rectangle([(banner_x, banner_y), (banner_x + banner_w, banner_y + banner_h)], fill=(27, 40, 56))

        try:
            draw.rounded_rectangle([(banner_x, banner_y), (banner_x + banner_w, banner_y + banner_h)], radius=16, outline=(38, 59, 80), width=2)
        except Exception:
            pass

        title_trunc = self._truncate_text_width(draw, game_name, font_title, 960)
        draw.text((60, 655), title_trunc, font=font_title, fill=(255, 255, 255))

        p1_x1, p1_x2 = 60, 360
        p_y1, p_y2 = 712, 797
        try:
            draw.rounded_rectangle([(p1_x1, p_y1), (p1_x2, p_y2)], radius=12, fill=(22, 32, 45, 240), outline=(38, 59, 80), width=1)
        except Exception:
            draw.rectangle([(p1_x1, p_y1), (p1_x2, p_y2)], fill=(22, 32, 45, 240), outline=(38, 59, 80))
        draw.text((p1_x1 + 16, p_y1 + 12), ("Время в игре" if is_ru() else "Playtime"), font=font_badge_lbl, fill=(143, 152, 160))
        draw.text((p1_x1 + 16, p_y1 + 42), playtime_text, font=font_badge_val, fill=(102, 192, 244))

        p2_x1, p2_x2 = 380, 680
        try:
            draw.rounded_rectangle([(p2_x1, p_y1), (p2_x2, p_y2)], radius=12, fill=(22, 32, 45, 240), outline=(38, 59, 80), width=1)
        except Exception:
            draw.rectangle([(p2_x1, p_y1), (p2_x2, p_y2)], fill=(22, 32, 45, 240), outline=(38, 59, 80))
        draw.text((p2_x1 + 16, p_y1 + 12), "Metacritic", font=font_badge_lbl, fill=(143, 152, 160))
        meta_color = (144, 186, 60) if metacritic.isdigit() and int(metacritic) >= 75 else (102, 192, 244)
        meta_val_str = f"{metacritic}/100" if metacritic.isdigit() else metacritic
        draw.text((p2_x1 + 16, p_y1 + 42), meta_val_str, font=font_badge_val, fill=meta_color)

        p3_x1, p3_x2 = 700, 1020
        try:
            draw.rounded_rectangle([(p3_x1, p_y1), (p3_x2, p_y2)], radius=12, fill=(22, 32, 45, 240), outline=(38, 59, 80), width=1)
        except Exception:
            draw.rectangle([(p3_x1, p_y1), (p3_x2, p_y2)], fill=(22, 32, 45, 240), outline=(38, 59, 80))
        draw.text((p3_x1 + 16, p_y1 + 12), ("Отзывы в Steam" if is_ru() else "Steam Reviews"), font=font_badge_lbl, fill=(143, 152, 160))
        if is_ru():
            rev_str = f"{reviews_percent}% положит." if reviews_percent is not None else "Нет оценок"
        else:
            rev_str = f"{reviews_percent}% positive" if reviews_percent is not None else "No reviews"
        rev_color = (144, 186, 60) if reviews_percent and reviews_percent >= 70 else (102, 192, 244)
        draw.text((p3_x1 + 16, p_y1 + 42), rev_str, font=font_badge_val, fill=rev_color)

        d_y1, d_y2 = 815, 965
        try:
            draw.rounded_rectangle([(60, d_y1), (1020, d_y2)], radius=12, fill=(22, 32, 45, 210), outline=(38, 59, 80), width=1)
        except Exception:
            draw.rectangle([(60, d_y1), (1020, d_y2)], fill=(22, 32, 45, 210), outline=(38, 59, 80))

        draw.text((78, d_y1 + 16), ("Жанры:" if is_ru() else "Genres:"), font=font_details, fill=(143, 152, 160))
        g_trunc = self._truncate_text_width(draw, genres, font_details, 780)
        draw.text((220, d_y1 + 16), g_trunc, font=font_details, fill=(255, 255, 255))

        draw.text((78, d_y1 + 54), ("Разработчик:" if is_ru() else "Developer:"), font=font_details, fill=(143, 152, 160))
        dev_trunc = self._truncate_text_width(draw, developers, font_details, 780)
        draw.text((220, d_y1 + 54), dev_trunc, font=font_details, fill=(255, 255, 255))

        draw.text((78, d_y1 + 92), ("Дата выхода:" if is_ru() else "Release Date:"), font=font_details, fill=(143, 152, 160))
        draw.text((220, d_y1 + 92), release_date, font=font_details, fill=(255, 255, 255))

        draw.line([(60, 990), (1020, 990)], fill=(38, 59, 80), width=1)
        draw.text((60, 1010), "Steam Plugin", font=font_footer, fill=(102, 192, 244))
        if self.get_setting("show_card_authors", True):
            draw.text((740, 1010), "by @KangelPlugins & @MGEPlugins", font=font_footer, fill=(143, 152, 160))

        card_rgb = card.convert("RGB")
        temp_photo_path = File(self._temp_dir, f"now_steam_{uuid.uuid4().hex[:8]}.jpg").getAbsolutePath()
        card_rgb.save(temp_photo_path, "JPEG", quality=92)
        log(f"[SteamPlugin] Game card saved successfully: {temp_photo_path}")
        return temp_photo_path



GUIDE_DONE_KEY = "steam_guide_seen"
GUIDE_FIRST_DELAY_MS = 1800
GUIDE_PAGE_MS = 240
GUIDE_DIM_ALPHA = 60

