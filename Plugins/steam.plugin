            "recent": "[🎮](5265139050263626266)",
            "dev": "[📱](5363920828465431862)",
            "pub": "[❤️](5366551886776253280)",
            "meta": "[💘](5364175348227395877)",
            "reviews": "[👍](5366471772751280978)",
            "genre": "[📝](5267392860122006833)",
            "time": "[⏰](5267166897597599285)",
            "link": "[🎮](5265139050263626266)",
            "cs2": "[🔫](5307872926886808571)",
            "tf2": "[🎩](5465519392248838285)",
            "dota": "[⚔️](5418011199914662526)",
            "dota2": "[⚔️](5418011199914662526)",
        }
        std = {
