    def _with_icon(self, text: str, icon: str) -> str:
        try:
            if not icon:
                return text
            return f"{icon} | {text}"
        except Exception:
            return text

    def _streamer(self):
        log("[Steam] Streamer started")
        while not self._stop_streamer:
            try:
                try:
                    interval_val = self.get_setting("check_interval", DEFAULT_CHECK_INTERVAL)
                    check_interval = int(interval_val) if interval_val else DEFAULT_CHECK_INTERVAL
                    if check_interval < 5:
                        check_interval = 5
                except:
                    check_interval = DEFAULT_CHECK_INTERVAL
                
                if self.get_setting("update_bio", False):
                    log("[Steam] Update bio is enabled")
                    userFull = get_messages_controller().getUserFull(get_user_config().getClientUserId())
                    if not userFull:
                        log("[Steam] Failed to get userFull")
                        time.sleep(check_interval)
                        continue

                    stream_place = self.get_setting("stream_place", 1 if get_user_config().isPremium() else 0)
                    max_len = 140 if get_user_config().isPremium() else 70

                    steam_id = self.get_setting("steam_id", "")
                    api_key = self.get_setting("api_key", "")

                    if not steam_id:
                        log("[Steam] Steam ID is not set")
                        time.sleep(check_interval)
                        continue

                    result, _, playtime, _, _ = self.get_game(steam_id, api_key)

                    enable_live_updates = self.get_setting("enable_live_updates", True)
                    if isinstance(result, dict) and enable_live_updates:
                        try:
                            game_name = result.get('name', str(result))
                            playtime_int = int(playtime) if playtime else 0
                            playtime_hours = playtime_int // 60
                            if self.last_game_name != game_name:
                                log(f"[LiveUpdates] 🎮 Game changed: {game_name} ({playtime_hours}h)")
                                self._show_game_notification(game_name, playtime_hours)
                                self.last_game_name = game_name
                                self.current_game_name = game_name
                                self.current_playtime_hours = playtime_hours
                                self.last_notification_time = time.time()
                            else:
                                self.current_playtime_hours = playtime_hours
                        except Exception as e:
                            log(f"[LiveUpdates] ❌ Error: {e}")
                    else:
                        if self.last_game_name is not None:
                            log(f"[LiveUpdates] 🛑 Game stopped, cancelling notification")
                            self._cancel_game_notification()
                            self.last_game_name = None
                            self.current_game_name = None
                            self.current_playtime_hours = 0

                    if result != self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT):
                        new_about_text = self.get_setting("track_display_format", DEFAULT_STREAM_STRING)
                        if isinstance(result, dict):
                            new_about_text = new_about_text.replace("{game}", str(result['name']))
                        else:
                            new_about_text = new_about_text.replace("{game}", str(result))

                        if stream_place == 0:
                            if userFull.about != new_about_text[:max_len]:
                                try:
                                    req = TL_account.updateProfile()
                                    req.flags = int(4)
                                    req.about = new_about_text[:max_len]
                                    send_request(req, ())
                                except Exception as e:
                                    log(f"[Steam] Error updating bio: {e}")
                        else:
                            if not get_user_config().isPremium():
                                log("[Steam] User is not premium")
                                time.sleep(check_interval)
                                continue
                            try:
                                req = TL_account.updateBusinessLocation()
                                req.address = new_about_text[:96]
                                req.flags = int(1)
                                send_request(req, ())
                            except Exception as e:
                                log(f"[Steam] Error updating business location: {e}")
                    else:
                        default_bio = self.get_setting("default_stream_text", DEFAULT_STREAM_TEXT)
                        if stream_place == 0:
                            if userFull.about != default_bio[:max_len]:
                                try:
                                    req = TL_account.updateProfile()
                                    req.flags = int(4)
                                    req.about = default_bio[:max_len]
                                    send_request(req, ())
                                except Exception as e:
                                    log(f"[Steam] Error setting default bio: {e}")
                        else:
                            if not get_user_config().isPremium():
                                log("[Steam] User is not premium")
                                time.sleep(check_interval)
                                continue
                            try:
                                req = TL_account.updateBusinessLocation()
                                req.address = default_bio[:96]
                                req.flags = int(1)
                                send_request(req, ())
                            except Exception as e:
                                log(f"[Steam] Error setting default bio in business location: {e}")
                    
                    time.sleep(check_interval)
                else:
                    time.sleep(check_interval)
            except Exception as e:
                log(f"[Steam]: {e}")
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        try:
            self.add_on_callback_query_hook()
        except Exception as e:
            log(f"[SteamPlugin] Не удалось зарегистрировать callback query hook: {e}")
        try:
            self.install_deeplink_hook()
        except Exception as e:
            log(f"[SteamPlugin] Не удалось установить deeplink hook: {e}")
        for hook_name in ("add_on_url_hook", "add_on_open_url_hook", "add_on_link_click_hook"):
            if hasattr(self, hook_name):
                try:
                    getattr(self, hook_name)()
                    log(f"[SteamPlugin] Зарегистрирован {hook_name}")
                except Exception as e:
                    log(f"[SteamPlugin] Не удалось вызвать {hook_name}: {e}")
        self._temp_dir = self._get_temp_dir()
        if self._temp_dir:
            threading.Thread(target=self._download_fonts, daemon=True).start()
            log("Steam plugin loaded successfully")
        else:
            log("Failed to initialize temp directory for Steam")

    def _download_fonts(self):
        try:
            for font_name, font_url in FONTS.items():
                font_path = File(self._temp_dir, f"{font_name}-Regular.ttf").getAbsolutePath()
                if not os.path.exists(font_path):
                    response = requests.get(font_url)
                    with open(font_path, 'wb') as f:
                        f.write(response.content)
                    log(f"Downloaded font: {font_name}")
        except Exception as e:
            log(f"Error downloading fonts: {e}")

    def _get_temp_dir(self):
        try:
            base_dir = ApplicationLoader.getFilesDirFixed()
            if base_dir:
                temp_dir = File(base_dir, TEMP_DIR_NAME)
                if temp_dir.exists() or temp_dir.mkdirs():
                    return temp_dir
        except Exception as e:
            log(f"Error getting temp directory from ApplicationLoader: {e}")
        try:
            import tempfile
            sys_tmp = tempfile.gettempdir()
            temp_dir = File(sys_tmp, TEMP_DIR_NAME)
            if temp_dir.exists() or temp_dir.mkdirs():
                return temp_dir
            return File(sys_tmp)
        except Exception as e:
            log(f"Error getting fallback temp directory: {e}")
            return None

    def download_game_image(self, image_url):
        if not image_url:
            return None
        temp_dir = self._get_temp_dir()
        if not temp_dir or not temp_dir.isDirectory():
            return None

        filename = f"game_{uuid.uuid4()}.jpg"
        temp_photo_path = File(temp_dir, filename).getAbsolutePath()

        try:
            head = requests.head(image_url, timeout=5)
            content_length = int(head.headers.get('content-length', 0))
            if content_length > 10 * 1024 * 1024:
                return None

            resp = requests.get(image_url, stream=True, timeout=10)
            resp.raise_for_status()

            with open(temp_photo_path, 'wb') as f:
                for chunk in resp.iter_content(chunk_size=8192):
                    if chunk:
                        f.write(chunk)
            return temp_photo_path
        except Exception as e:
            try:
                if os.path.exists(temp_photo_path):
                    os.remove(temp_photo_path)
            except Exception:
                pass
            return None

    def delete_temp_file_async(self, file_path, delay_seconds=5):
        def _delete():
            try:
                time.sleep(delay_seconds)
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception as e:
                pass
        threading.Thread(target=_delete, daemon=True).start()

    def _test_steam_connection(self):
        steam_id = self.get_setting("steam_id", "").strip()
        api_key = self.get_setting("api_key", "").strip()
        if not steam_id:
            BulletinHelper.show_error(localise("conn_test_steam_id_missing"))
            return
        if not api_key:
            BulletinHelper.show_error(localise("conn_test_api_key_missing"))
            return

        BulletinHelper.show_info(localise("conn_test_in_progress"))

        def _worker():
            try:
                resolved_id = resolve_steam_id(steam_id, api_key) or steam_id
                api = SteamAPI(api_key, resolved_id)
                summary = api.get_player_summary()
                if not summary or 'response' not in summary or not summary['response'].get('players'):
                    self._run_on_ui_thread(lambda: BulletinHelper.show_error(localise("conn_test_profile_not_found")))
                    return

                p = summary['response']['players'][0]
                nick = p.get('personaname', 'Unknown')
                status = localise("conn_test_status_in_game") if 'gameextrainfo' in p else (localise("conn_test_status_online") if p.get('personastate', 0) > 0 else localise("conn_test_status_offline"))
                game_info = f" ({p['gameextrainfo']})" if 'gameextrainfo' in p else ""
                msg = localise("conn_test_success", nick=nick, status=status, game_info=game_info)
                self._run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
            except Exception as e:
                self._run_on_ui_thread(lambda: BulletinHelper.show_error(localise("conn_test_error", e=str(e))))

        threading.Thread(target=_worker, daemon=True).start()

    def _load_sticker_async(self, image_view, sticker_set_name, sticker_index, cache_key=None):
        import weakref
        _iv_ref = weakref.ref(image_view)

        def _safe_set_image(loc, size, doc):
            iv = _iv_ref()
            if iv is not None:
                self._run_on_ui_thread(lambda: iv.setImage(loc, size, None, 0, doc))

        def load_in_background():
            try:
                if cache_key and hasattr(self, '_sticker_cache') and cache_key in self._sticker_cache:
                    cached = self._sticker_cache[cache_key]
                    _safe_set_image(cached['location'], cached['size'], cached['document'])
                    return

                current_account = 0
                try:
                    fragment = get_last_fragment()
                    if fragment:
                        current_account = fragment.getCurrentAccount()
                except Exception:
                    pass

                from org.telegram.messenger import MediaDataController, ImageLocation
                media_controller = MediaDataController.getInstance(current_account)
                sticker_set = media_controller.getStickerSetByName(sticker_set_name)

                if sticker_set and sticker_set.documents and sticker_set.documents.size() > sticker_index:
                    sticker_document = sticker_set.documents.get(sticker_index)
                    image_location = ImageLocation.getForDocument(sticker_document)
                    if cache_key:
                        if not hasattr(self, '_sticker_cache'):
                            self._sticker_cache = {}
                        self._sticker_cache[cache_key] = {
                            'location': image_location,
                            'document': sticker_document,
                            'size': "150_150"
                        }
                    _safe_set_image(image_location, "150_150", sticker_document)
                else:
                    try:
                        from org.telegram.tgnet import TLRPC
                        input_set = TLRPC.TL_inputStickerSetShortName()
                        input_set.short_name = sticker_set_name

                        def on_set_response(result):
                            try:
                                if result and result.documents and result.documents.size() > sticker_index:
                                    doc = result.documents.get(sticker_index)
                                    img_loc = ImageLocation.getForDocument(doc)
                                    if cache_key:
                                        if not hasattr(self, '_sticker_cache'):
                                            self._sticker_cache = {}
                                        self._sticker_cache[cache_key] = {
                                            'location': img_loc,
                                            'document': doc,
                                            'size': "150_150"
                                        }
                                    _safe_set_image(img_loc, "150_150", doc)
                            except Exception:
                                pass

                        from org.telegram.messenger import Utilities
                        from java import dynamic_proxy

                        class CallbackProxy(dynamic_proxy(Utilities.Callback)):
                            def __init__(self, fn):
                                super().__init__()
                                self._fn = fn
                            def run(self, arg):
                                try:
                                    self._fn(arg)
                                except Exception:
                                    pass

                        media_controller.getStickerSet(input_set, None, False, CallbackProxy(on_set_response))
                    except Exception:
                        pass
            except Exception as e:
                log(f"[SteamPlugin] _load_sticker_async error: {e}")

        threading.Thread(target=load_in_background, daemon=True).start()

    def _build_header_logo_view(self):
        try:
            from android.widget import LinearLayout, TextView
            from android.view import Gravity
            from android.util import TypedValue
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            from org.telegram.ui.Components import LayoutHelper

            fragment = get_last_fragment()
            ctx = fragment.getContext() if fragment else ApplicationLoader.applicationContext
            if not ctx:
                return None

            layout = LinearLayout(ctx)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setGravity(Gravity.CENTER)
            layout.setPadding(0, AndroidUtilities.dp(24), 0, AndroidUtilities.dp(16))

            created_image = False
            try:
                from org.telegram.ui.Components import BackupImageView
                image_view = BackupImageView(ctx)
                image_view.setRoundRadius(AndroidUtilities.dp(14))
                icon_str = globals().get("__icon__", "Kangelcons_by_fStikBot/0")
                if "/" in icon_str:
                    set_name, idx = icon_str.split("/", 1)
                    self._load_sticker_async(image_view, set_name, int(idx), f"header_{set_name}_{idx}")
                layout.addView(image_view, LayoutHelper.createLinear(72, 72, Gravity.CENTER, 0, 0, 0, 10))
                created_image = True
            except Exception as e:
                log(f"[SteamPlugin] BackupImageView creation error: {e}")

            if not created_image:
                from android.widget import ImageView
                from android.graphics.drawable import GradientDrawable
                badge = ImageView(ctx)
                drawable = GradientDrawable()
                drawable.setShape(GradientDrawable.OVAL)
                accent_color = Theme.getColor(Theme.key_featuredStickers_addButton)
                drawable.setColor(accent_color)
                badge.setBackground(drawable)
                try:
                    badge_icon = ctx.getResources().getDrawable(R_tg.drawable.files_storage)
                    badge_icon = badge_icon.mutate()
                    badge_icon.setTint(Theme.getColor(Theme.key_featuredStickers_buttonText))
                    badge.setImageDrawable(badge_icon)
                except Exception:
                    pass
                badge.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
                p = AndroidUtilities.dp(14)
                badge.setPadding(p, p, p, p)
                layout.addView(badge, LayoutHelper.createLinear(64, 64, Gravity.CENTER, 0, 0, 0, 10))

            title = TextView(ctx)
            title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            title.setTypeface(AndroidUtilities.getTypeface(AndroidUtilities.TYPEFACE_ROBOTO_MEDIUM))
            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 19)
            title.setText("Steam Plugin")
            title.setGravity(Gravity.CENTER)
            layout.addView(title, LayoutHelper.createLinear(-2, -2, Gravity.CENTER, 0, 0, 0, 4))

            version = TextView(ctx)
            version.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            version.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            version.setText("Версия 2.0" if is_ru() else "Version 2.0")
            version.setGravity(Gravity.CENTER)
            layout.addView(version, LayoutHelper.createLinear(-2, -2, Gravity.CENTER, 0, 0, 0, 0))

            return layout
        except Exception as e:
            log(f"[SteamPlugin] _build_header_logo_view error: {e}")
            return None

    def _open_url(self, url: str):
        try:
            from org.telegram.messenger.browser import Browser
            fragment = get_last_fragment()
            ctx = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
            if ctx:
                Browser.openUrl(ctx, url)
        except Exception as e:
            log(f"[SteamPlugin] open_url error: {e}")

    def _open_telegram_channel(self, username: str):
        try:
            from org.telegram.messenger.browser import Browser
            fragment = get_last_fragment()
            ctx = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
            if ctx:
                Browser.openUrl(ctx, f"https://t.me/{username.lstrip('@')}")
        except Exception as e:
            log(f"[SteamPlugin] open_telegram_channel error: {e}")

    def _show_quickstart_guide(self):
        def _do_open():
            ok = _guide_open(self)
            if not ok:
                if is_ru():
                    text = (
                        "1. Получи Steam API Key:\n"
                        "   https://steamcommunity.com/dev/apikey\n\n"
                        "2. Вставь ссылку на профиль или ник в поле Steam ID\n\n"
                        "3. Введи оба значения в Настройках -> Аккаунт и API Steam\n\n"
                        "4. Отправь .nowsteam или .sprofile в чат!"
                    )
                else:
                    text = (
                        "1. Get Steam API Key:\n"
                        "   https://steamcommunity.com/dev/apikey\n\n"
                        "2. Paste your profile link or nickname as Steam ID\n\n"
                        "3. Enter both in Settings -> Account & Steam API\n\n"
                        "4. Send .nowsteam or .sprofile to a chat!"
                    )
                self.alert_manager.show_info_alert("Steam Plugin", text, "OK")
        self._run_on_ui_thread(_do_open)

    def _show_inventory_privacy_guide(self):
        if is_ru():
            title = "Приватность инвентаря Steam"
            text = (
                "Чтобы инвентарь был доступен в Telegram, он должен быть открыт в настройках Steam:\n\n"
                "1. Откройте профиль Steam в приложении или браузере\n"
                "2. Нажмите 'Редактировать профиль' -> 'Приватность'\n"
                "3. Установите:\n"
                "   • Мой профиль: Открытый (Public)\n"
                "   • Инвентарь: Открытый (Public)\n\n"
                "После этого команда .sinv сразу сможет загружать скины и предметы!"
            )
            btn = "Понятно"
        else:
            title = "Steam Inventory Privacy"
            text = (
                "For inventory to be accessible in Telegram, it must be set to public in Steam settings:\n\n"
                "1. Open your Steam profile in app or browser\n"
                "2. Click 'Edit Profile' -> 'Privacy Settings'\n"
                "3. Set:\n"
                "   • My Profile: Public\n"
                "   • Inventory: Public\n\n"
                "After that, .sinv will be able to load skins and items right away!"
            )
            btn = "Got it"
        self.alert_manager.show_info_alert(title, text, btn)

    def _handle_show_steam_guide_alert_click(self, view):
        title = localise("steam_guide_title")
        text = localise("steam_guide_text")
        close_button = localise("alert_close_button")
        self.alert_manager.show_info_alert(title, text, close_button)

    def _handle_show_faq_alert_click(self, view):
        title = localise("font_faq_title")
        text = localise("font_faq_text")
        close_button = localise("alert_close_button")
        self.alert_manager.show_info_alert(title, text, close_button)

