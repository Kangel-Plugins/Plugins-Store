    def create_settings(self):
        try:
            items = []
            if 'Custom' in globals() and Custom is not None:
                header_view = self._build_header_logo_view()
                if header_view is not None:
                    try:
                        items.append(Custom(view=header_view))
                        items.append(Divider())
                    except Exception:
                        try:
                            items.append(Custom(header_view))
                            items.append(Divider())
                        except Exception as e:
                            log(f"[SteamPlugin] Custom header error: {e}")

            if not items:
                items.extend([
                    Header(text="Steam Plugin"),
                    Text(text="Версия: 2.0" if is_ru() else "Version: 2.0", icon="filled_info"),
                    Divider(),
                ])

            items.extend([
                Header(text="Быстрый старт" if is_ru() else "Quick Start"),
