    def _sub_stream_settings(self):
        update_bio = self.get_setting("update_bio", False)
        items = [
            Header(text="Авто-статус в Telegram" if is_ru() else "Telegram Auto-Status"),
            Switch(
                key="update_bio",
                text="Включить авто-трансляцию" if is_ru() else "Enable auto-status",
                default=False,
                subtext="Автоматически обновляет профиль информацией об игре" if is_ru() else "Automatically updates profile with game info",
                on_change=lambda new_value: self._show_stream_alert(new_value),
                icon="ic_ab_search",
                link_alias="update_bio"
            ),
        ]
        if update_bio:
            items.extend([
                Selector(
                    key="stream_place",
                    text="Куда транслировать статус" if is_ru() else "Status location",
                    default=1 if get_user_config().isPremium() else 0,
                    items=["О себе (Био)", "Эмодзи-статус (Telegram Premium)"] if is_ru() else ["About (Bio)", "Emoji Status (Telegram Premium)"],
                    icon="menu_premium_location" if get_user_config().isPremium() else "msg_openprofile",
                    link_alias="stream_place"
                ) if get_user_config().isPremium() else None,
                Input(
                    key="check_interval",
                    text="Интервал проверки (секунды)" if is_ru() else "Check interval (seconds)",
                    subtext="Как часто проверять статус игры в Steam" if is_ru() else "How often to check game status in Steam",
                    default=DEFAULT_CHECK_INTERVAL,
                    icon="input_schedule",
                    link_alias="check_interval"
                ),
                Input(
                    key="track_display_format",
                    text="Шаблон статуса в игре" if is_ru() else "In-game status template",
                    subtext="Используйте {game} для названия игры" if is_ru() else "Use {game} for game name",
                    default=DEFAULT_STREAM_STRING,
                    icon="input_forward",
                    link_alias="track_display_format"
                ),
                Input(
                    key="default_stream_text",
                    text="Текст когда не в игре" if is_ru() else "Offline/idle text",
                    subtext="Отображается, когда игра не запущена" if is_ru() else "Shown when no game is running",
                    default=DEFAULT_STREAM_TEXT,
                    icon="input_reply",
                    link_alias="default_stream_text"
                ),
            ])
            if Build.VERSION.SDK_INT >= 36:
                items.append(
                    Switch(
                        key="enable_live_updates",
                        text="Уведомления Live Updates" if is_ru() else "Live Updates notifications",
                        default=True,
                        subtext="Отображает интерактивное уведомление Live Updates во время игры (Android 16+)" if is_ru() else "Display interactive Live Updates notification while playing (Android 16+)",
                        icon="msg_notifications",
                        link_alias="enable_live_updates"
                    )
                )
        return [x for x in items if x is not None]

