_RESOLVED_STEAM_ID_CACHE = {}

def resolve_steam_id(raw_id: str, api_key: str = None) -> Optional[str]:
    if not raw_id:
        return None
    raw_id = raw_id.strip()
    if raw_id in _RESOLVED_STEAM_ID_CACHE:
        return _RESOLVED_STEAM_ID_CACHE[raw_id]

    if raw_id.isdigit() and len(raw_id) >= 16:
        _RESOLVED_STEAM_ID_CACHE[raw_id] = raw_id
        return raw_id

    match_profile = re.search(r"steamcommunity\.com/profiles/(\d+)", raw_id)
    if match_profile:
        sid = match_profile.group(1)
        _RESOLVED_STEAM_ID_CACHE[raw_id] = sid
        return sid

    vanity = raw_id
    match_id = re.search(r"steamcommunity\.com/id/([^/?#]+)", raw_id)
    if match_id:
        vanity = match_id.group(1)
    else:
        vanity = vanity.strip("/").lstrip("@")

    if api_key:
        try:
            res = requests.get(
                "https://api.steampowered.com/ISteamUser/ResolveVanityURL/v0001/",
                params={"key": api_key, "vanityurl": vanity},
                timeout=10,
                headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
            )
            if res.status_code == 200:
                data = res.json().get("response", {})
                if data.get("success") == 1 and data.get("steamid"):
                    sid = str(data["steamid"])
                    _RESOLVED_STEAM_ID_CACHE[raw_id] = sid
                    return sid
        except Exception as e:
            log(f"[SteamPlugin] Ошибка при ResolveVanityURL: {e}")

    try:
        res = requests.get(
            f"https://steamcommunity.com/id/{vanity}?xml=1",
            timeout=10,
            headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
        )
        if res.status_code == 200:
            match = re.search(r"<steamID64>(\d+)</steamID64>", res.text)
            if match:
                sid = match.group(1)
                _RESOLVED_STEAM_ID_CACHE[raw_id] = sid
                return sid
    except Exception as e:
        log(f"[SteamPlugin] Ошибка при парсинге XML профиля: {e}")

    return raw_id if raw_id.isdigit() else None


def is_ru() -> bool:
    try:
        return Locale.getDefault().getLanguage().lower().startswith("ru")
    except Exception:
        return True


class SteamAPI:
    def __init__(self, api_key: str, steam_id: str):
        self.api_key = api_key
        self.steam_id = steam_id
        self.base_url = "https://api.steampowered.com"
        self.session = requests.Session()
        self.session.timeout = 15
        self.session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
            "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        })

    def _make_request(self, endpoint: str, params: dict = None) -> dict:
        if params is None:
            params = {}
            
        params['key'] = self.api_key
        if 'steamid' not in params:
            params['steamid'] = self.steam_id

        max_retries = 3
        retry_delay = 2
        
        for attempt in range(max_retries):
            try:
                response = self.session.get(
                    f"{self.base_url}/{endpoint}",
                    params=params,
                    timeout=15
                )
                response.raise_for_status()
                return response.json()
                
            except requests.exceptions.RequestException as e:
                log(f"[SteamAPI] Request failed (attempt {attempt + 1}/{max_retries}): {e}")
                if attempt < max_retries - 1:
                    time.sleep(retry_delay)
                    continue
                raise

    def get_player_summary(self) -> dict:
        return self._make_request("ISteamUser/GetPlayerSummaries/v0002/", {
            'steamids': self.steam_id
        })

    def get_recent_games(self, count: int = 3) -> dict:
        return self._make_request("IPlayerService/GetRecentlyPlayedGames/v0001/", {
            'count': count
        })

    def get_steam_level(self, steam_id: str = None) -> int:
        try:
            target_id = steam_id or self.steam_id
            res = self._make_request("IPlayerService/GetSteamLevel/v1/", {'steamid': target_id})
            return int(res.get("response", {}).get("player_level", 0))
        except Exception as e:
            log(f"[SteamAPI] Error getting steam level: {e}")
            return 0

    def get_owned_games(self) -> dict:

        return self._make_request("IPlayerService/GetOwnedGames/v0001/", {
            'include_appinfo': 1,
            'include_played_free_games': 1
        })

    def get_game_details(self, app_id: int) -> dict:
        try:
            response = self.session.get(
                "https://store.steampowered.com/api/appdetails",
                params={
                    'appids': app_id,
                    'l': 'russian' if is_ru() else 'english'
                },
                timeout=15
            )
            response.raise_for_status()
            data = response.json()
            return data.get(str(app_id), {}).get('data', {})
        except Exception as e:
            log(f"[SteamAPI] Error getting game details: {e}")
            return {}

    def get_reviews(self, app_id: int) -> dict:
        try:
            response = self.session.get(
                f"https://store.steampowered.com/appreviews/{app_id}",
                params={
                    'json': 1,
                    'language': 'all',
                    'purchase_type': 'all',
                    'num_per_page': 0,
                },
                timeout=15
            )
            response.raise_for_status()
            data = response.json()
            if data.get('success') != 1:
                return {}
            return data.get('query_summary', {})
        except Exception as e:
            log(f"[SteamAPI] Error getting reviews: {e}")
            return {}

    def get_inventory(self, steam_id: str, app_id: int = 730, context_id: int = 2):
        clean_steam_id = resolve_steam_id(steam_id, self.api_key) or steam_id
        base_url = f"https://steamcommunity.com/inventory/{clean_steam_id}/{app_id}/{context_id}"
        attempts = [
            {'l': 'russian' if is_ru() else 'english'},
            {'l': 'english' if is_ru() else 'russian'},
            {},
        ]
        headers = {
            'Referer': f'https://steamcommunity.com/profiles/{clean_steam_id}/inventory/',
            'Accept': 'application/json, text/javascript, */*; q=0.01',
            'X-Requested-With': 'XMLHttpRequest',
        }
        last_status = None
        for attempt_idx, params in enumerate(attempts):
            try:
                response = self.session.get(base_url, params=params, headers=headers, timeout=20)
                last_status = response.status_code
                if response.status_code == 403:
                    return None, 'private'
                if response.status_code == 429:
                    log(f"[SteamAPI] Inventory 429 (Rate Limit), попытка {attempt_idx + 1}/{len(attempts)}")
                    if attempt_idx < len(attempts) - 1:
                        time.sleep(2)
                        continue
                    return None, 'rate_limit'
                if response.status_code == 400:
                    log(f"[SteamAPI] Inventory 400 with params={params}, trying next fallback")
                    continue
                response.raise_for_status()
                data = response.json()
                if not data or not data.get('success'):
                    if isinstance(data, dict) and 'private' in str(data.get('Error', '')).lower():
                        return None, 'private'
                    return None, 'private'
                return data, None
            except Exception as e:
                log(f"[SteamAPI] Error getting inventory (params={params}): {e}")
                continue
        log(f"[SteamAPI] Inventory request failed on all fallbacks, last status: {last_status}")
        if last_status == 429:
            return None, 'rate_limit'
        return None, 'error'


