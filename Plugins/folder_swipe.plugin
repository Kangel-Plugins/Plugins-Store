__id__ = "folder_swipe"
__name__ = "Folder Swipe"
__description__ = "Переключение папок свайпом, как на iPhone: свайп из середины списка чатов листает папки, а свайп от правого края выполняет действие над чатом (прочитать, закрепить и т.д.)"
__author__ = "Irlandec"
__version__ = "1.1.0"
__icon__ = "FolderSwipeByIrlandec/0"
__min_version__ = "12.10.6"
__category__ = ["appearance", "tools", "chats"]

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class

# Код действия «Сменить папку» (SwipeGestureSettingsView.SWIPE_GESTURE_FOLDERS)
SWIPE_FOLDERS = 5

# Индекс в списке совпадает с кодом действия в SwipeGestureSettingsView
CHAT_ACTION_LABELS = ["Закрепить", "Прочитать", "Архивировать", "Без звука", "Удалить"]
DEFAULT_CHAT_ACTION = 1

# Доля ширины экрана у правого края, где свайп считается свайпом по чату
EDGE_LABELS = ["20%", "30%", "40%", "50%"]
EDGE_FRACTIONS = [0.2, 0.3, 0.4, 0.5]
DEFAULT_EDGE = 1

ACTION_DOWN = 0
VIEW_VISIBLE = 0


def _saved_swipe_action():
    # Значение из «Настройки чатов → Свайп влево в списке чатов», как оно сохранено на диске
    from java import jclass
    context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
    prefs = context.getSharedPreferences("mainconfig", 0)
    return int(prefs.getInt("ChatSwipeAction", -1))


def _int_or_none(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _index_setting(plugin, key, default, size):
    try:
        index = int(plugin.get_setting(key, default))
    except Exception:
        index = default
    return index if 0 <= index < size else default


class SwipeActionSetter:
    """Меняет действие свайпа, которое Telegram читает через SharedConfig.getChatSwipeAction().

    Основной путь — приватное поле chatSwipeAction (меняется только в памяти).
    Если поля с таким именем нет, используем публичный updateChatListSwipeSetting,
    который ещё и сохраняет значение, поэтому вызываем его только при изменении.
    """

    def __init__(self, logger):
        self.field = None
        self.last = None
        try:
            field = find_class("org.telegram.messenger.SharedConfig").getDeclaredField("chatSwipeAction")
            field.setAccessible(True)
            field.getInt(None)
            self.field = field
        except Exception as e:
            logger.info("Folder swipe: no chatSwipeAction field (%r), using updateChatListSwipeSetting" % (e,))

    def set(self, value):
        if self.field is not None:
            self.field.setInt(None, value)
        elif value != self.last:
            self._update(value)
        self.last = value

    def _update(self, value):
        from java import jclass
        jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(value)


class TouchDownHook(MethodHook):
    """DialogsActivity.ContentView.onInterceptTouchEvent.

    Вызывается на каждом касании раньше, чем список чатов и сама ContentView решают,
    что делать со свайпом, поэтому действие выбирается сразу в момент касания:
    у правого края — действие над чатом, в остальной части экрана — смена папки.
    """

    def __init__(self, plugin, setter):
        self.plugin = plugin
        self.setter = setter

    def before_hooked_method(self, param):
        try:
            ev = param.args[0]
            if ev is None or ev.getActionMasked() != ACTION_DOWN:
                return
            view = param.thisObject
            width = view.getWidth()
            if width <= 0:
                return
            # Без видимых вкладок папок (папок нет, вкладки скрыты, открыт архив) Telegram
            # выполнил бы для «Сменить папку» архивацию чата, поэтому там всегда действие над чатом
            if not self._folder_tabs_visible(view):
                zone = "нет вкладок → чат"
                action = self.plugin.chat_action()
            elif ev.getX() >= width * (1 - self.plugin.edge_fraction()):
                zone = "край → чат"
                action = self.plugin.chat_action()
            else:
                zone = "середина → папка"
                action = SWIPE_FOLDERS
            self.setter.set(action)
            if self.plugin.get_setting("debug", False):
                self._show_debug(view, zone)
        except Exception as e:
            self.plugin.logger.error("Folder swipe: touch handling failed: %r" % (e,))

    def _folder_tabs_visible(self, view):
        # FilterTabsView — прямой потомок ContentView (см. ContentView.onLayout)
        for i in range(view.getChildCount()):
            child = view.getChildAt(i)
            if child.getClass().getName().endswith("FilterTabsView"):
                return child.getVisibility() == VIEW_VISIBLE
        # Вкладки не нашлись (другая разметка в этой версии) — не мешаем листать папки
        return True

    def _show_debug(self, view, zone):
        from java import jclass
        from android.widget import Toast
        account = jclass("org.telegram.messenger.UserConfig").selectedAccount
        actual = jclass("org.telegram.messenger.SharedConfig").getChatSwipeAction(account)
        Toast.makeText(view.getContext(), "%s (действие %d)" % (zone, actual), 0).show()


class FolderSwipePlugin(BasePlugin):
    def on_plugin_load(self):
        self.setter = None
        try:
            self._remember_original_action()
            self.setter = SwipeActionSetter(self.logger)
            content_view = find_class("org.telegram.ui.DialogsActivity$ContentView")
            self.hook_all_methods(content_view, "onInterceptTouchEvent", TouchDownHook(self, self.setter))
            self.logger.info("Folder swipe enabled")
        except Exception as e:
            self.logger.error("Folder swipe: failed to enable: %r" % (e,))

    def on_plugin_unload(self):
        # Возвращаем настройку свайпа, которая была в Telegram до включения плагина
        try:
            if self.setter is not None and self.setter.field is not None:
                # Плагин менял только значение в памяти: на диске лежит настройка пользователя
                # (включая изменения, сделанные им в настройках чатов, пока плагин был включён)
                self.setter.set(_saved_swipe_action())
            else:
                original = _int_or_none(self.get_setting("original_swipe_action", None))
                if original is not None:
                    from java import jclass
                    jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(original)
            # При следующем включении исходная настройка запомнится заново
            self.set_setting("original_swipe_action", "")
        except Exception as e:
            self.logger.error("Folder swipe: failed to disable: %r" % (e,))

    def _remember_original_action(self):
        if _int_or_none(self.get_setting("original_swipe_action", None)) is not None:
            # Плагин не был корректно выключен (например, приложение закрылось) — исходная уже сохранена
            return
        current = _saved_swipe_action()
        # Ранние тестовые версии записывали настройку на диск и сохраняли исходную в prev_action
        legacy = _int_or_none(self.get_setting("prev_action", None))
        original = legacy if legacy is not None else current
        if legacy is not None:
            self.set_setting("prev_action", "")
            if legacy != current:
                from java import jclass
                jclass("org.telegram.messenger.SharedConfig").updateChatListSwipeSetting(legacy)
        self.set_setting("original_swipe_action", original)

    def chat_action(self):
        return _index_setting(self, "chat_action", DEFAULT_CHAT_ACTION, len(CHAT_ACTION_LABELS))

    def edge_fraction(self):
        return EDGE_FRACTIONS[_index_setting(self, "edge_width", DEFAULT_EDGE, len(EDGE_FRACTIONS))]

    def create_settings(self):
        from ui.settings import Header, Selector, Switch, Text
        return [
            Header(text="Свайпы в списке чатов"),
            Selector(
                key="chat_action",
                text="Свайп от правого края",
                default=DEFAULT_CHAT_ACTION,
                items=CHAT_ACTION_LABELS,
            ),
            Selector(
                key="edge_width",
                text="Ширина зоны у края",
                default=DEFAULT_EDGE,
                items=EDGE_LABELS,
            ),
            Switch(
                key="debug",
                text="Режим отладки",
                default=False,
            ),
            Text(text="Свайп, начатый у правого края, выполняет действие над чатом. Свайп из середины или левой части экрана переключает папки (влево — следующая, вправо — предыдущая). Папки должны быть показаны вкладками над списком чатов. В режиме отладки при каждом касании показывается, какой жест выбран."),
        ]
