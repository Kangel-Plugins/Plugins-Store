logger = zwylib.build_log(__name__)


class MC:
    _fields = {}

    @classmethod
    def _field(cls, name: str):
        field = cls._fields.get(name)
        if field is None:
            field = MediaController.getClass().getDeclaredField(name)
            field.setAccessible(True)
            cls._fields[name] = field
        return field

    @classmethod
    def get(cls, name: str) -> Optional[Any]:
        try:
            return cls._field(name).get(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return None


NOTES: List[str] = []

JObject = jclass("java.lang.Object")
SKIP_FIELDS = {
    "listeners", "handler", "eventHandler", "applicationHandler", "playbackLooper", "applicationLooper",
    "analyticsCollector", "bandwidthMeter", "trackSelector", "loadControl", "mediaSourceFactory", "clock",
}


def note(text: str):
    logger.debug(text)
    if text in NOTES:
        return
    NOTES.append(text)
    del NOTES[:-12]


def find_audio_track(root, max_nodes: int = 1500, max_depth: int = 9):
    """
    Telegram's release build strips getAudioSessionId() from ExoPlayer, so we look for the android.media.AudioTrack
    in the fields of the player instead (player -> renderers -> audio sink -> audioTrack).
    """
    queue = [(root, 0)]
    seen = set()
    index = 0

    while index < len(queue) and len(seen) < max_nodes:
        obj, depth = queue[index]
        index += 1

        # Chaquopy turns String and boxed primitives into Python values, there is nothing to look into
        if obj is None or isinstance(obj, (str, int, float, bool, bytes)):
            continue

        try:
            jobj = cast(JObject, obj)
            key = int(System.identityHashCode(jobj))
            if key in seen:
                continue
            seen.add(key)

            cls = jobj.getClass()
            name = str(cls.getName())
            if name == "android.media.AudioTrack":
                return cast(AudioTrack, obj)
            if depth >= max_depth:
                continue

            if cls.isArray():
                if not cls.getComponentType().isPrimitive():
                    for i in range(min(int(JArray.getLength(jobj)), 32)):
                        queue.append((JArray.get(jobj, i), depth + 1))
            elif Collection.getClass().isInstance(jobj):
                for item in cast(Collection, obj).toArray()[:32]:
                    queue.append((item, depth + 1))
            elif "exoplayer2" in name or "media3" in name or "exteragram" in name:
                c = cls
                while c is not None and str(c.getName()) != "java.lang.Object":
                    for field in c.getDeclaredFields():
                        if Modifier.isStatic(field.getModifiers()) or field.getType().isPrimitive():
                            continue
                        if str(field.getName()) in SKIP_FIELDS:
                            continue
                        field.setAccessible(True)
                        value = field.get(jobj)
                        if value is not None:
                            queue.append((value, depth + 1))
                    c = c.getSuperclass()
        except Exception as e:
            note(f"search error: {e}")
    note(f"bfs: visited~{len(seen) // 100 * 100}, limit_hit={len(seen) >= max_nodes}")
    return None


def _get(obj, name):
    c = cast(JObject, obj).getClass()
    while c is not None:
        try:
            f = c.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            c = c.getSuperclass()
    return None


def find_audio_track_direct(exo):
    """Direct path: ExoPlayerImpl.renderers -> audio renderer -> audioSink -> audioTrack (maybe via AudioOutput wrapper)."""
    try:
        renderers = _get(exo, "renderers")
        if renderers is None:
            note("direct: renderers field not found")
            return None
        arr = cast(JObject, renderers)
        for i in range(int(JArray.getLength(arr))):
            r = JArray.get(arr, i)
            if r is None or "Audio" not in str(cast(JObject, r).getClass().getName()):
                continue
            sink = _get(r, "audioSink")
            if sink is None:
                note("direct: audioSink not found")
                continue
            for _ in range(6):
                inner = _get(sink, "sink")
                if inner is None:
                    break
                sink = inner
            out = _get(sink, "audioTrack")
            if out is None:
                out = find_audio_track(sink, max_nodes=800, max_depth=6)
            if out is not None and str(cast(JObject, out).getClass().getName()) != "android.media.AudioTrack":
                out = _get(out, "audioTrack")
            if out is not None:
                return cast(AudioTrack, out)
            try:
                sink_cls = cast(JObject, sink).getClass()
                names = []
                c = sink_cls
                while c is not None and str(c.getName()) != "java.lang.Object":
                    names += [f"{f.getName()}:{f.getType().getSimpleName()}" for f in c.getDeclaredFields()
                              if not Modifier.isStatic(f.getModifiers())]
                    c = c.getSuperclass()
                note(f"direct: no AudioTrack in {sink_cls.getName()}; fields: " + ", ".join(names[:40]))
            except Exception as e:
                note(f"direct: sink dump failed: {e}")
    except Exception as e:
        note(f"direct search error: {e}")
    return None


def exo_players(video_player) -> list:
    result = []
    for name in ("player", "audioPlayer"):
        try:
            field = video_player.getClass().getDeclaredField(name)
            field.setAccessible(True)
            exo = field.get(video_player)
        except Exception as e:
            note(f"field {name}: {e}")
            continue
        if exo is not None:
            result.append((name, exo))
    return result


_tracks = {}


def force_session_id(exo, name: str) -> int:
    """Gives the player our own audio session id (AudioSink picks it up and re-creates the track with it)."""
    try:
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        am = cast(AudioManager, ctx.getSystemService("audio"))
        sid = int(am.generateAudioSessionId())
        if sid <= 0:
            note(f"{name}: generateAudioSessionId returned {sid}")
            return 0
        cast(jclass("androidx.media3.exoplayer.ExoPlayer"), exo).setAudioSessionId(sid)
        note(f"{name}: forced audio session {sid}")
        return sid
    except Exception as e:
        note(f"{name}: force session failed: {e}")
        return 0


def get_audio_session_id(video_player) -> int:
    for name, exo in exo_players(video_player):
        key = int(System.identityHashCode(cast(JObject, exo)))
        if len(_tracks) > 16:
            _tracks.clear()
        state = _tracks.setdefault(key, {"track": None, "next_try": 0.0, "fails": 0})

        if state.get("forced"):
            return state["forced"]

        track = state["track"]
        if track is not None:
            try:
                session = int(track.getAudioSessionId())
                if session > 0:
                    return session
            except Exception as e:
                note(f"AudioTrack lost: {e}")
            state["track"] = None

        now = time.monotonic()
        if now < state["next_try"]:
            continue

        track = find_audio_track_direct(exo) or find_audio_track(exo)
        session = 0
        if track is not None:
            try:
                session = int(track.getAudioSessionId())
            except Exception as e:
                note(f"{name}: getAudioSessionId failed: {e}")

        if session > 0:
            state["track"] = track
            state["fails"] = 0
            note(f"{name}: found AudioTrack, session {session}")
            return session

        if session <= 0 and state["fails"] >= 3 and not state.get("forced_tried"):
            state["forced_tried"] = True
            forced = force_session_id(exo, name)
            if forced > 0:
                state["forced"] = forced
                return forced

        state["fails"] += 1
        state["next_try"] = now + (0.8 if state["fails"] < 6 else 8.0)
        if state["fails"] == 1:
            note(f"{name}: AudioTrack not found yet in {cast(JObject, exo).getClass().getName()}")
    return 0


def interpolate_gain(freq_hz: float, gains: List[float]) -> float:
    """Gain in dB at the given frequency, interpolated between the UI bands on a log frequency axis."""
    if freq_hz <= UI_FREQS[0]:
        return gains[0]
    if freq_hz >= UI_FREQS[-1]:
        return gains[-1]

    for i in range(len(UI_FREQS) - 1):
        low, high = UI_FREQS[i], UI_FREQS[i + 1]
        if low <= freq_hz <= high:
            t = (math.log(freq_hz) - math.log(low)) / (math.log(high) - math.log(low))
            return gains[i] + (gains[i + 1] - gains[i]) * t
    return 0.0


def nearest_index(entry: SettingEntry, values: Tuple[int, ...]) -> int:
    current = entry.safe_get(int)
    return min(range(len(values)), key=lambda i: abs(values[i] - current))


class Effects:
    def __init__(self):
        self.session = 0
        self.equalizer = None
        self.bass = None
        self.virtualizer = None
        self.loudness = None
        self.errors: List[str] = []

    def _fail(self, text: str, exc: Exception):
        logger.warning(f"{text}: {exc}")
        self.errors = (self.errors + [f"{text}: {exc}"])[-8:]

    def _create(self, name: str, factory, *args):
        try:
            return factory(*args)
        except Exception as e:
            self._fail(f"{name} is not available", e)
            return None

    def attach(self, session: int):
        if session == self.session and self.equalizer is not None:
            return

        self.release()
        self.errors = []
        self.session = session
        self.equalizer = self._create("Equalizer", AudioEqualizer, 0, session)
        self.bass = self._create("BassBoost", BassBoost, 0, session)
        self.virtualizer = self._create("Virtualizer", Virtualizer, 0, session)
        self.loudness = self._create("LoudnessEnhancer", LoudnessEnhancer, session)
        logger.info(f"Attached to the audio session {session}, equalizer created: {self.equalizer is not None}.")
        self.apply()

    def release(self):
        for name in ("equalizer", "bass", "virtualizer", "loudness"):
            effect = getattr(self, name)
            setattr(self, name, None)
            if effect is None:
                continue
            try:
                effect.setEnabled(False)
                effect.release()
            except Exception:
                logger.debug(f"Failed to release {name}:", exc_info=True)
        self.session = 0

    def apply(self):
        self._apply_equalizer()
        self._apply_strength(self.bass, S.bass.safe_get(int) * 10, "bass boost")
        self._apply_strength(self.virtualizer, S.virtualizer.safe_get(int) * 10, "virtualizer")
        self._apply_loudness()

    def _apply_equalizer(self):
        if self.equalizer is None:
            return

        try:
            gains = [float(entry.safe_get(int)) for entry in BAND_ENTRIES]
            level_range = self.equalizer.getBandLevelRange()
            min_level, max_level = int(level_range[0]), int(level_range[1])

            for band in range(int(self.equalizer.getNumberOfBands())):
                freq_hz = self.equalizer.getCenterFreq(jshort(band)) / 1000
                level = round(interpolate_gain(freq_hz, gains) * 100)
                level = max(min_level, min(max_level, level))
                self.equalizer.setBandLevel(jshort(band), jshort(level))

            self.equalizer.setEnabled(any(gains))
        except Exception as e:
            self._fail("Failed to apply the equalizer", e)

    def _apply_strength(self, effect, strength: int, name: str):
        if effect is None:
            return

        try:
            if strength > 0:
                effect.setStrength(jshort(strength))
            effect.setEnabled(strength > 0)
        except Exception as e:
            self._fail(f"Failed to apply {name}", e)

    def _apply_loudness(self):
        if self.loudness is None:
            return

        try:
            # make-up gain: the platform effects bundle lowers the overall level when bands, bass or
            # virtualizer are boosted, so the user compensates it manually with this slider
            gain_mb = max(0, S.loudness.safe_get(int)) * 100
            if gain_mb > 0:
                self.loudness.setTargetGain(gain_mb)
            self.loudness.setEnabled(gain_mb > 0)
        except Exception as e:
            self._fail("Failed to apply loudness boost", e)


effects = Effects()


def is_enabled() -> bool:
    value = S.enabled.get()
    return True if value is None else bool(value)


def sync(enabled: Optional[bool] = None):
    """Makes the effects follow the player that is playing right now."""
    if enabled is None:
        enabled = is_enabled()

    if not enabled:
        effects.release()
        return

    controller = MediaController.getInstance()
    message = controller.getPlayingMessageObject()
    if message is None or not message.isMusic():
        effects.release()
        return

    player = MC.get("audioPlayer")
    if player is None:
        effects.release()
        return

    session = get_audio_session_id(player)
    if session > 0:
        effects.attach(session)


def build_report() -> str:
    lines = [f"{__name__} {__version__}"]
    try:
        lines.append(f"enabled={S.enabled.get()!r}, preset={S.preset.get()!r}")
        lines.append("bands (dB): " + ", ".join(str(e.safe_get(int)) for e in BAND_ENTRIES))
        lines.append(f"bass={S.bass.safe_get(int)}, virtualizer={S.virtualizer.safe_get(int)}, loudness={S.loudness.safe_get(int)}")

        message = MediaController.getInstance().getPlayingMessageObject()
        lines.append(f"playing message: {message is not None}, isMusic: {bool(message.isMusic()) if message is not None else None}")

        player = MC.get("audioPlayer")
        lines.append(f"audioPlayer: {None if player is None else str(player.getClass().getName())}")
        if player is not None:
            fields = player.getClass().getDeclaredFields()
            lines.append("player fields: " + ", ".join(f"{f.getName()}:{f.getType().getSimpleName()}" for f in fields))
            lines.append("player impl: " + ", ".join(
                f"{n}={cast(JObject, e).getClass().getName()}" for n, e in exo_players(player)
            ))
            lines.append(f"audio session id found: {get_audio_session_id(player)}")
            lines.append("session notes: " + (" | ".join(NOTES) or "none"))

        lines.append(f"attached session: {effects.session}")
        eq = effects.equalizer
        if eq is None:
            lines.append("equalizer: not created")
        else:
            bands = int(eq.getNumberOfBands())
            lines.append(f"equalizer: enabled={eq.getEnabled()}, hasControl={eq.hasControl()}, bands={bands}")
            lines.append("center Hz: " + ", ".join(str(int(eq.getCenterFreq(jshort(i)) / 1000)) for i in range(bands)))
            lines.append("levels mB: " + ", ".join(str(int(eq.getBandLevel(jshort(i)))) for i in range(bands)))
        lines.append("errors: " + (" | ".join(effects.errors) or "none"))
    except Exception as e:
        lines.append("report failed: " + str(zwylib.format_exc_only(e)))
    return "\n".join(lines)


class SessionWatcher:
    def __init__(self):
        self.token = 0

    def start(self):
        self.token += 1
        self._schedule(self.token, 0)

    def stop(self):
        self.token += 1

    def _schedule(self, token: int, delay: int):
        run_on_ui_thread(lambda: self._tick(token), delay)

    def _tick(self, token: int):
        if token != self.token:
            return

        try:
            sync()
        except Exception:
            logger.error("An error occurred while syncing the effects:", exc_info=True)

        self._schedule(token, POLL_MS)


watcher = SessionWatcher()


def play_message_after_hook(param):
    try:
        if param.getResult():
            sync()
    except Exception:
        logger.error("An error occurred in the playMessage hook:", exc_info=True)


def cleanup_player_before_hook(param):
    try:
        effects.release()
    except Exception:
        logger.error("An error occurred in the cleanupPlayer hook:", exc_info=True)


def build_slider(entry: SettingEntry, values: Tuple[int, ...], labels: List[str], on_change=None) -> Custom:
    def on_choose(index: int):
        item.intValue = index
        # reloading would rebuild the settings page right under the finger
        SettingsManager.set(entry.plugin_id, entry, values[index], reload_settings=False)
        try:
            if on_change is not None:
                on_change(values[index])
        except Exception:
            logger.error("An error occurred in the slider callback:", exc_info=True)

    # UItem.asSlideView(String[] choices, int chosen, Utilities.Callback<Integer> whenChose)
    item = UItem.asSlideView(
        jarray(String)(labels),
        nearest_index(entry, values),
        zwylib.Callback1(on_choose)
    )
    return Custom(item=item)


def on_band_changed(_value):
    SettingsManager.set(S.preset.plugin_id, S.preset, CUSTOM_PRESET, reload_settings=False)
    effects.apply()


def on_extra_changed(_value):
    effects.apply()


def on_preset_changed(value):
    try:
        index = int(value)
        if not 0 <= index < len(PRESETS):
            return

        SettingsManager.set(S.preset.plugin_id, S.preset, index, reload_settings=False)
        gains = PRESETS[index][1]
        last = len(BAND_ENTRIES) - 1
        for i, (entry, gain) in enumerate(zip(BAND_ENTRIES, gains)):
            # the last write rebuilds the page so the sliders jump to the preset values
            SettingsManager.set(entry.plugin_id, entry, gain, reload_settings=(i == last))
        effects.apply()
    except Exception:
        logger.error("Failed to apply the preset:", exc_info=True)


def on_enabled_changed(value):
    try:
        sync(enabled=bool(value))
    except Exception:
        logger.error("Failed to toggle the equalizer:", exc_info=True)


class EqualizerPlugin(BasePlugin):
    def on_plugin_load(self):
        logger.setLevel(logging.DEBUG if S.debug_mode.get() else logging.INFO)

        clazz = jclass("org.telegram.messenger.MediaController").getClass()
        play_message = HookUtils.find_max_args_method(clazz, "playMessage")
        cleanup_player = HookUtils.find_max_args_method(clazz, "cleanupPlayer")

        if play_message and cleanup_player:
            HookUtils.hook_after(play_message, play_message_after_hook)
            HookUtils.hook_before(cleanup_player, cleanup_player_before_hook)
        else:
            logger.error("Failed to hook MediaController methods, falling back to polling only.")

        run_on_ui_thread(watcher.start)
        logger.info("Loaded.")

    def on_plugin_unload(self):
        watcher.stop()
        run_on_ui_thread(effects.release)
        logger.info("Unloaded.")

    def create_settings(self):
        try:
            preset_names = [getattr(L, key) for key, _ in PRESETS] + [L.p_custom]
            db_labels = [str(i) for i in BAND_DB]
            percent_labels = [str(i) if i else L.off for i in PERCENT_STEPS]
            loudness_labels = [str(i) if i else L.off for i in LOUDNESS_STEPS]

            items = [
                S.enabled.as_switch(text=L.prefs_enabled, on_change=on_enabled_changed),
                S.preset.as_selector(text=L.prefs_preset, items=preset_names, on_change=on_preset_changed),
                Header(L.prefs_bands),
            ]
            for entry, key in zip(BAND_ENTRIES, BAND_LOCALE_KEYS):
                items.append(Header(getattr(L, key)))
                items.append(build_slider(entry, BAND_DB, db_labels, on_band_changed))
            items.append(Divider(L.prefs_bands_hint))

            items += [
                Header(L.prefs_bass),
                build_slider(S.bass, PERCENT_STEPS, percent_labels, on_extra_changed),
                Header(L.prefs_virtualizer),
                build_slider(S.virtualizer, PERCENT_STEPS, percent_labels, on_extra_changed),
                Header(L.prefs_loudness),
                build_slider(S.loudness, LOUDNESS_STEPS, loudness_labels, on_extra_changed),
                Divider(L.prefs_extra_hint),
                Text(
                    text=L.prefs_diagnostics,
                    icon="msg_info",
                    on_click=lambda v: copy_to_clipboard(build_report())
                ),
                Divider(L.prefs_diagnostics_hint),
                S.debug_mode.as_switch(
                    text=L.prefs_debug_mode,
                    on_change=lambda enabled: logger.setLevel(logging.DEBUG if enabled else logging.INFO)
                ),
            ]
            return items
        except Exception as e:
            logger.error("An error occurred while generating settings:", exc_info=True)
            trace = zwylib.format_exc_from(e)
            return [
                Divider(f"An error occurred while generating settings:\n{zwylib.format_exc_only(e)}"),
                Text(
                    text="Copy full traceback",
                    icon="msg_copy",
                    on_click=lambda v: copy_to_clipboard(trace)
                )
            ]
