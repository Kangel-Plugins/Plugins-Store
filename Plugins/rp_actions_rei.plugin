NSFW_CMDS = {"выебать", "изнасиловать", "секс", "трахнуть", "делать секс", "отдаться", "уебать", "отсосать", "отлизать"}

ALIASES = {
    "уёбать": "уебать",
    "уе6ать": "уебать",
    "выёбать": "выебать",
    "вые6ать": "выебать",
}

_QUOTE_RE = re.compile(r"\(([^)]+)\)\s*$")
_USERNAME_RE = re.compile(r"^\w+$")
_LINK_RE = re.compile(r"\[([^\]]+)\]\([^)]+\)")
_SKIP_PLAIN_LIMIT = 32


def _build_index(aliases: list, customs: list) -> list:
    entries = []
    for e in aliases:
        name = str(e.get("alias", "")).strip().lower()
        action = str(e.get("action", "")).strip().lower()
        if name and action in ACTIONS:
            entries.append((name, action, False))
    for e in customs:
        name = str(e.get("name", "")).strip().lower()
        if name:
            entries.append((name, name, True))
    for cmd in ACTIONS:
        entries.append((cmd, cmd, False))
    for cmd, key in ALIASES.items():
        entries.append((cmd, key, False))
    entries.sort(key=lambda x: -len(x[0]))
    return entries


def _split_args(rest: str) -> Optional[Tuple[str, str]]:
    if rest and not (rest[0].isspace() or rest[0] == "("):
        return None
    rest = rest.strip()
    quote = ""
    m = _QUOTE_RE.search(rest)
    if m:
        quote = m.group(1).strip()
        rest = rest[:m.start()].strip()
    if not rest:
        return "", quote
    if rest.startswith("@") and _USERNAME_RE.match(rest[1:]):
        return rest[1:], quote
    return None


def _parse_action(message: str, index: list) -> Optional[Tuple[str, bool, str, str]]:
    msg = message.strip()
    low = msg.lower()
    for name, key, is_custom in index:
        if low.startswith(name):
            args = _split_args(msg[len(name):])
            if args is not None:
                return key, is_custom, args[0], args[1]
    return None


def _parse_nick_command(message: str) -> Tuple[Optional[str], Optional[str], Optional[str]]:
    msg = message.strip()
    if msg.lower() in (".ники", ".nicks"):
        return "list", None, None

    head = msg.split(None, 1)
    if len(head) < 2 or head[0].lower() != ".ник":
        return None, None, None

    body = head[1].strip()
    first, _, rest = body.partition(" ")
    rest = rest.strip()

    if first.lower() == "убрать":
        if rest:
            return "remove_other", rest.split()[0].lstrip("@"), None
        return "remove_self", None, None

    if first.startswith("@"):
        if rest:
            return "set_other", first.lstrip("@"), rest
        return None, None, None

    return "set_self", None, body


def _md_link(display: str, user_id: Optional[int]) -> str:
    if user_id:
        return f"[{display}](tg://openmessage?user_id={user_id})"
    return display


def _send(params: dict, reply_msg, reply_top):
    if reply_msg is not None:
        params["replyToMsg"] = reply_msg
    if reply_top is not None:
        params["replyToTopMsg"] = reply_top
    send_message(params)


def _blockquote_entity(length: int):
    from org.telegram.tgnet import TLRPC
    e = TLRPC.TL_messageEntityBlockquote()
    e.offset = 0
    e.length = length
    e.collapsed = True
    e.flags = 1
    return e


def _build_and_send(md_text: str, peer: Any, reply_msg=None, reply_top=None, quote_all: bool = False):
    try:
        parsed = parse_markdown(md_text)
        entities = [e.to_tlrpc_object() for e in parsed.entities]
        if quote_all:
            entities.append(_blockquote_entity(len(parsed.text.encode("utf-16-le")) // 2))
        _send({"peer": peer, "message": parsed.text, "entities": entities}, reply_msg, reply_top)
    except Exception as e:
        log(f"[RP] send: {e}")
        try:
            _send({"peer": peer, "message": _LINK_RE.sub(r"\1", md_text), "entities": []}, reply_msg, reply_top)
        except Exception as e2:
            log(f"[RP] send fallback: {e2}")


def _get_forum_reply_top(reply_msg, peer):
    if reply_msg is None:
        return None
    try:
        from org.telegram.messenger import MessageObject, ChatObject
        from org.telegram.tgnet import TLRPC

        peer_id = getattr(peer, "channel_id", None) or getattr(peer, "chat_id", None)
        if not peer_id:
            return None

        mc = get_messages_controller()
        chat = mc.getChat(peer_id)
        if not chat or not ChatObject.isForum(chat):
            return None

        account = get_user_config().selectedAccount
        topic_id = 0
        try:
            owner = getattr(reply_msg, "messageOwner", None)
            if owner:
                reply_to = getattr(owner, "reply_to", None)
                if reply_to:
                    top_id = getattr(reply_to, "reply_to_top_id", 0)
                    topic_id = top_id if top_id != 0 else getattr(reply_to, "reply_to_msg_id", 0)
            if topic_id == 0:
                topic_id = MessageObject.getTopicId(account, owner if owner else reply_msg, True)
        except Exception as e:
            log(f"[RP] topic_id: {e}")

        if topic_id <= 0:
            return None

        topic_message = TLRPC.TL_message()
        topic_message.message = ""
        topic_message.id = topic_id
        topic_message.peer_id = mc.getPeer(-peer_id)
        return MessageObject(account, topic_message, False, False)
    except Exception as e:
        log(f"[RP] forum_reply_top: {e}")
        return None


class RpActionsPlugin(BasePlugin):

    def on_plugin_load(self):
        self._aliases: list = []
        self._custom_actions: list = []
        self._index: list = []
        self._skip_plain: set = set()
        self._init_defaults()
        self._aliases = self._load_list("aliases")
        self._custom_actions = self._load_list("custom_actions")
        self._index = _build_index(self._aliases, self._custom_actions)
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        self._aliases = []
        self._custom_actions = []
        self._index = []
        self._skip_plain.clear()

    def _init_defaults(self):
        for key, val in (("actions_enabled", True), ("show_emoji", True), ("nsfw", True), ("confirm_rp", False)):
            if self.get_setting(key, None) is None:
                self.set_setting(key, val)
        if self.get_setting("nicks", None) is None:
            self._save_nicks({})

    def _activity(self):
        fragment = get_last_fragment()
        return fragment.getParentActivity() if fragment else None

    def _load_list(self, key: str) -> list:
        try:
            raw = self.get_setting(key, None)
            data = json.loads(str(raw)) if raw else []
            return [e for e in data if isinstance(e, dict)] if isinstance(data, list) else []
        except Exception as e:
            self.log(f"[RP] load {key}: {e}")
            return []

    def _save_aliases(self, aliases: list):
        self._aliases = aliases
        self._index = _build_index(self._aliases, self._custom_actions)
        self.set_setting("aliases", json.dumps(aliases, ensure_ascii=False), reload_settings=True)

    def _save_custom_actions(self, actions: list):
        self._custom_actions = actions
        self._index = _build_index(self._aliases, self._custom_actions)
        self.set_setting("custom_actions", json.dumps(actions, ensure_ascii=False), reload_settings=True)

    def _load_nicks(self) -> dict:
        try:
            raw = self.get_setting("nicks", "{}")
            return json.loads(raw) if raw else {}
        except Exception as e:
            self.log(f"[RP] load_nicks: {e}")
            return {}

    def _save_nicks(self, data: dict):
        try:
            self.set_setting("nicks", json.dumps(data, ensure_ascii=False))
        except Exception as e:
            self.log(f"[RP] save_nicks: {e}")

    def _get_nick_entry(self, user_id: Optional[int], username: Optional[str]) -> Optional[dict]:
        nicks = self._load_nicks()
        if user_id:
            e = nicks.get(f"uid:{user_id}")
            if e:
                return e
        if username:
            e = nicks.get(f"@{username.lower()}")
            if e:
                return e
        return None

    def _set_nick(self, user_id: Optional[int], username: Optional[str], nick: str):
        nicks = self._load_nicks()
        if user_id:
            key = f"uid:{user_id}"
            entry = nicks.get(key, {})
            entry["nick"] = nick
            if username:
                entry["username"] = username.lower()
            nicks[key] = entry
            if username:
                nicks[f"@{username.lower()}"] = {"nick": nick, "user_id": user_id}
        elif username:
            nicks[f"@{username.lower()}"] = {"nick": nick, "user_id": None}
        self._save_nicks(nicks)

    def _remove_nick(self, user_id: Optional[int], username: Optional[str]):
        nicks = self._load_nicks()
        uname = username.lower() if username else None
        if user_id:
            entry = nicks.pop(f"uid:{user_id}", {})
            uname = entry.get("username") or uname
        if uname:
            nicks.pop(f"@{uname}", None)
            for key in [k for k, v in nicks.items() if k.startswith("uid:") and v.get("username") == uname]:
                nicks.pop(key, None)
        self._save_nicks(nicks)

    def _self_id_uname(self, account: int) -> Tuple[Optional[int], Optional[str]]:
        try:
            from org.telegram.messenger import UserConfig
            user = UserConfig.getInstance(account).getCurrentUser()
            if user:
                return int(user.id), (str(user.username) if user.username else None)
        except Exception as e:
            self.log(f"[RP] self_id: {e}")
        return None, None

    def _uid_by_username(self, account: int, username: str) -> Optional[int]:
        try:
            from org.telegram.messenger import MessagesController
            user = MessagesController.getInstance(account).getUserByUsername(username)
            if user:
                return int(user.id)
        except Exception as e:
            self.log(f"[RP] uid_by_uname: {e}")
        return None

    def _get_tg_display(self, user) -> str:
        try:
            first = str(user.first_name) if user.first_name else ""
            last = str(user.last_name) if user.last_name else ""
            name = (first + " " + last).strip()
            if name:
                return name
            if user.username:
                return str(user.username)
        except Exception:
            pass
        return "Кто-то"

    def _user_md(self, user) -> str:
        uid = int(user.id)
        uname = str(user.username) if user.username else None
        entry = self._get_nick_entry(uid, uname)
        display = entry["nick"] if (entry and entry.get("nick")) else self._get_tg_display(user)
        return _md_link(display, uid)

    def _actor_md(self, account: int) -> str:
        try:
            from org.telegram.messenger import UserConfig
            user = UserConfig.getInstance(account).getCurrentUser()
            return self._user_md(user) if user else "Кто-то"
        except Exception as e:
            self.log(f"[RP] actor_md: {e}")
            return "Кто-то"

    def _target_md(self, account: int, params: Any, target_username: str) -> str:
        try:
            if target_username:
                return self._mention_by_uname_md(account, target_username)
            return self._mention_from_reply_md(account, params)
        except Exception as e:
            self.log(f"[RP] target_md: {e}")
            return f"@{target_username}" if target_username else ""

    def _mention_by_uname_md(self, account: int, username: str) -> str:
        try:
            from org.telegram.messenger import MessagesController
            user = MessagesController.getInstance(account).getUserByUsername(username)
            if user:
                return self._user_md(user)
            entry = self._get_nick_entry(None, username)
            if entry and entry.get("nick"):
                return _md_link(entry["nick"], entry.get("user_id"))
            return f"@{username}"
        except Exception as e:
            self.log(f"[RP] mention_by_uname: {e}")
            return f"@{username}"

    def _mention_from_reply_md(self, account: int, params: Any) -> str:
        try:
            reply_to = getattr(params, "replyToMsg", None)
            owner = getattr(reply_to, "messageOwner", None) if reply_to is not None else None
            if owner is None:
                return ""

            uid = None
            from_id = getattr(owner, "from_id", None)
            if from_id is not None:
                peer_uid = getattr(from_id, "user_id", None)
                if peer_uid:
                    uid = int(peer_uid)
            if uid is None:
                sender_id = getattr(owner, "sender_id", None)
                if sender_id and sender_id > 0:
                    uid = int(sender_id)
            if uid is None:
                return ""

            from org.telegram.messenger import MessagesController
            user = MessagesController.getInstance(account).getUser(uid)
            return self._user_md(user) if user else _md_link("Кто-то", uid)
        except Exception as e:
            self.log(f"[RP] mention_from_reply: {e}")
            return ""

    def _apply_nick_cmd(self, account: int, action: str, username: Optional[str], nick: Optional[str]):
        try:
            if action == "set_self":
                uid, uname = self._self_id_uname(account)
                self._set_nick(uid, uname, nick)
            elif action == "set_other":
                self._set_nick(self._uid_by_username(account, username), username, nick)
            elif action == "remove_self":
                uid, uname = self._self_id_uname(account)
                self._remove_nick(uid, uname)
            elif action == "remove_other":
                self._remove_nick(self._uid_by_username(account, username), username)
        except Exception as e:
            self.log(f"[RP] nick_cmd: {e}")

    def _build_nick_list_md(self) -> str:
        nicks = self._load_nicks()
        if not nicks:
            return "📋 Ников нет.\n.ник <Имя> — свой\n.ник @user <Имя> — другому"
        lines = ["📋 *Сохранённые ники:*\n"]
        seen = set()
        for key, entry in nicks.items():
            if not key.startswith("uid:"):
                continue
            uid = int(key[4:])
            seen.add(uid)
            uname = entry.get("username")
            suffix = f" (@{uname})" if uname else f" (id:{uid})"
            lines.append(f"• {_md_link(entry.get('nick', '—'), uid)}{suffix}")
        for key, entry in nicks.items():
            if not key.startswith("@"):
                continue
            uid = entry.get("user_id")
            if uid and uid in seen:
                continue
            lines.append(f"• {_md_link(entry.get('nick', '—'), uid)} ({key})")
        return "\n".join(lines)

    def _custom_data(self, name: str) -> Optional[dict]:
        for e in self._custom_actions:
            if str(e.get("name", "")).strip().lower() == name:
                phrases = e.get("phrases", [])
                if isinstance(phrases, str):
                    phrases = [p.strip() for p in phrases.split("\n") if p.strip()]
                return {
                    "emoji": e.get("emoji") or "🎭",
                    "eid": e.get("eid") or None,
                    "phrases": phrases or ["{actor} сделал кое-что с {target}"],
                    "weights": e.get("weights") or [],
                }
        return None

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        try:
            msg = params.message
            if not isinstance(msg, str):
                return HookResult()

            msg = msg.strip()
            low = msg.lower()
            peer = params.peer

            if low in (".рпк", ".rpk"):
                help_text = self._build_help()
                run_on_ui_thread(lambda: _build_and_send(help_text, peer, quote_all=True))
                return HookResult(strategy=HookStrategy.CANCEL)

            if low in (".рп", ".rp"):
                enabled = not self.get_setting("actions_enabled", True)
                self.set_setting("actions_enabled", enabled)
                if enabled:
                    BulletinHelper.show_success("РП Действия включены ✅")
                else:
                    BulletinHelper.show_info("РП Действия выключены ⛔")
                return HookResult(strategy=HookStrategy.CANCEL)

            nick_action, nick_uname, nick_val = _parse_nick_command(msg)
            if nick_action:
                if nick_action == "list":
                    md = self._build_nick_list_md()
                    run_on_ui_thread(lambda: _build_and_send(md, peer))
                else:
                    self._apply_nick_cmd(account, nick_action, nick_uname, nick_val)
                return HookResult(strategy=HookStrategy.CANCEL)

            skip_key = (str(peer), msg)
            if skip_key in self._skip_plain:
                self._skip_plain.discard(skip_key)
                return HookResult()

            if msg.startswith(".") or not self.get_setting("actions_enabled", True):
                return HookResult()

            parsed = _parse_action(msg, self._index)
            if parsed is None:
                return HookResult()
            key, is_custom, target_username, quote = parsed

            if is_custom:
                action_data = self._custom_data(key)
            else:
                action_data = ACTIONS.get(key)
                if key in NSFW_CMDS and not self.get_setting("nsfw", True):
                    return HookResult()
            if action_data is None:
                return HookResult()

            actor_md = self._actor_md(account)
            target_md = self._target_md(account, params, target_username)
            md_text = self._build_rp_md(actor_md, target_md, action_data,
                                        self.get_setting("show_emoji", True), quote)

            reply_msg = getattr(params, "replyToMsg", None)
            reply_top = getattr(params, "replyToTopMsg", None)
            if reply_top is None:
                reply_top = _get_forum_reply_top(reply_msg, peer)

            if self.get_setting("confirm_rp", False):
                run_on_ui_thread(lambda: self._show_confirm_dialog(md_text, msg, peer, reply_msg, reply_top))
            else:
                run_on_ui_thread(lambda: _build_and_send(md_text, peer, reply_msg, reply_top))
            return HookResult(strategy=HookStrategy.CANCEL)

        except Exception as e:
            self.log(f"[RP] hook: {e}")
            return HookResult()

    def _show_confirm_dialog(self, md_text: str, original_msg: str, peer, reply_msg, reply_top):
        try:
            activity = self._activity()
            if not activity:
                _build_and_send(md_text, peer, reply_msg, reply_top)
                return

            from android.widget import LinearLayout, TextView, FrameLayout
            from android.graphics.drawable import GradientDrawable
            from android.view import Gravity
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme

            dp = AndroidUtilities.dp

            def on_send(dlg, _):
                dlg.dismiss()
                _build_and_send(md_text, peer, reply_msg, reply_top)

            def on_cancel(dlg, _):
                dlg.dismiss()

            def on_plain(dlg, _):
                dlg.dismiss()
                try:
                    if len(self._skip_plain) >= _SKIP_PLAIN_LIMIT:
                        self._skip_plain.clear()
                    self._skip_plain.add((str(peer), original_msg))
                    _send({"peer": peer, "message": original_msg, "entities": []}, reply_msg, reply_top)
                except Exception as e:
                    self.log(f"[RP] plain send: {e}")

            outer = LinearLayout(activity)
            outer.setOrientation(LinearLayout.VERTICAL)
            outer.setPadding(dp(8), dp(8), dp(8), dp(4))

            try:
                bg = Theme.getColor(Theme.key_chat_outBubble)
            except Exception:
                bg = -13938056
            drawable = GradientDrawable()
            drawable.setColor(bg)
            drawable.setCornerRadius(dp(12))

            bubble = FrameLayout(activity)
            bubble.setBackground(drawable)

            tv = TextView(activity)
            tv.setText(_LINK_RE.sub(r"\1", md_text))
            tv.setPadding(dp(10), dp(6), dp(10), dp(6))
            tv.setTextSize(15)
            try:
                tv.setTextColor(Theme.getColor(Theme.key_chat_messageTextOut))
            except Exception:
                pass
            bubble.addView(tv, FrameLayout.LayoutParams(-2, -2))

            lp = LinearLayout.LayoutParams(-2, -2)
            lp.gravity = Gravity.END
            outer.addView(bubble, lp)

            builder = AlertDialogBuilder(activity)
            builder.set_title("Предпросмотр")
            builder.set_view(outer)
            builder.set_positive_button("Отправить", on_send)
            builder.set_neutral_button("Отмена", on_cancel)
            builder.set_negative_button("Как есть", on_plain)
            builder.show()
        except Exception as e:
            self.log(f"[RP] confirm_dialog: {e}")
            _build_and_send(md_text, peer, reply_msg, reply_top)

    def _build_rp_md(self, actor: str, target: str, action_data: dict, show_emoji: bool, quote: str = "") -> str:
        phrases = action_data["phrases"]
        weights = action_data.get("weights") or []
        phrase = None
        if weights and len(weights) >= len(phrases):
            try:
                phrase = random.choices(phrases, weights=weights[:len(phrases)], k=1)[0]
            except Exception:
                phrase = None
        if phrase is None:
            phrase = random.choice(phrases)

        if target:
            text = phrase.replace("{actor}", actor).replace("{target}", target)
        else:
            text = (phrase
                    .replace("{actor}", actor)
                    .replace(" {target}", "")
                    .replace("{target} ", "")
                    .replace("{target}", ""))
        text = " ".join(text.split())

        if show_emoji:
            emoji = action_data["emoji"]
            eid = action_data.get("eid")
            header = f"[{emoji}]({eid})" if eid else emoji
            text = f"{header} | {text}"

        if quote:
            text += f"\n💬 С репликой: «{quote}»"
        return text

    def _build_help(self) -> str:
        lines = ["🎭 *РП Действия* — команды \\(без точки\\):\n"]
        for key, data in ACTIONS.items():
            lines.append(f"{data['emoji']} {key}")
        for entry in self._custom_actions:
            lines.append(f"{entry.get('emoji') or '🎭'} {entry.get('name', '')}")
        lines.append("\n─────────────────")
        lines.append("📝 *Ники* \\(с точкой\\):")
        lines.append("`.ник <Имя>` — установить свой ник")
        lines.append("`.ник @username <Имя>` — ник другому")
        lines.append("`.ник убрать` — удалить свой")
        lines.append("`.ник убрать @username` — удалить чужой")
        lines.append("`.ники` — список")
        lines.append("\n💡 Цель: @username после команды или ответь на сообщение")
        lines.append("\n.рп — вкл/выкл | .рпк — эта справка")
        lines.append("\n@LuPlugins")
        return "\n".join(lines)

    def _styled_edittext(self, activity, hint: str, initial: str = "", multiline: bool = False, text_size: int = 0):
        from android.widget import EditText
        from org.telegram.ui.ActionBar import Theme
        et = EditText(activity)
        et.setHint(hint)
        if text_size:
            et.setTextSize(text_size)
        if multiline:
            et.setMinLines(2)
            et.setMaxLines(4)
        else:
            et.setSingleLine(True)
        try:
            et.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            et.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
        except Exception:
            pass
        if initial:
            et.setText(initial)
        return et

    def _gray_label(self, activity, text: str, size: int = 0):
        from android.widget import TextView
        from org.telegram.ui.ActionBar import Theme
        tv = TextView(activity)
        tv.setText(text)
        if size:
            tv.setTextSize(size)
        try:
            tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
        except Exception:
            pass
        return tv

    def _pick_action(self, activity, title: str, on_pick):
        names = list(ACTIONS.keys())

        def on_item(bld, idx):
            bld.dismiss()
            on_pick(names[idx])

        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_items(names, on_item)
        builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
        builder.show()

    def _show_entry_menu(self, title: str, on_edit, on_delete):
        try:
            activity = self._activity()
            if not activity:
                return

            def on_item(bld, idx):
                bld.dismiss()
                run_on_ui_thread(on_edit if idx == 0 else on_delete)

            try:
                from org.telegram.messenger import R
                icons = [R.drawable.group_edit, R.drawable.msg_delete]
            except Exception:
                icons = None

            builder = AlertDialogBuilder(activity)
            builder.set_title(title)
            builder.set_items(["Редактировать", "Удалить"], on_item, icons)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.show()
        except Exception as e:
            self.log(f"[RP] entry_menu: {e}")

    def _confirm_delete(self, title: str, message: str, on_confirm):
        try:
            activity = self._activity()
            if not activity:
                return

            def on_click(bld, _):
                bld.dismiss()
                try:
                    on_confirm()
                except Exception as e:
                    self.log(f"[RP] delete: {e}")

            builder = AlertDialogBuilder(activity)
            builder.set_title(title)
            builder.set_message(message)
            builder.set_positive_button("Удалить", on_click)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
            builder.show()
        except Exception as e:
            self.log(f"[RP] confirm_delete: {e}")

    def _show_add_alias(self, view=None):
        try:
            activity = self._activity()
            if not activity:
                return
            self._pick_action(activity, "Выбери действие",
                              lambda action: run_on_ui_thread(lambda: self._show_alias_dialog(None, action)))
        except Exception as e:
            self.log(f"[RP] add_alias: {e}")

    def _show_alias_dialog(self, original: Optional[dict], action: str,
                           text: Optional[str] = None, error: Optional[str] = None):
        try:
            activity = self._activity()
            if not activity:
                return
            from android.widget import LinearLayout, Button
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            dp = AndroidUtilities.dp

            selected = [action]
            initial = text if text is not None else (original.get("alias", "") if original else "")

            ll = LinearLayout(activity)
            ll.setOrientation(LinearLayout.VERTICAL)
            ll.setPadding(dp(24), dp(8), dp(24), dp(4))

            tv_action = self._gray_label(activity, f"Действие: {action}")
            lp_tv = LinearLayout.LayoutParams(-1, -2)
            lp_tv.bottomMargin = dp(4)
            ll.addView(tv_action, lp_tv)

            btn_change = Button(activity)
            btn_change.setText("Сменить действие")
            try:
                btn_change.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
            except Exception:
                pass
            lp_btn = LinearLayout.LayoutParams(-2, -2)
            lp_btn.bottomMargin = dp(12)
            ll.addView(btn_change, lp_btn)

            et = self._styled_edittext(activity, "алиас (напр. чмок)", initial)
            if error:
                et.setError(error)
            ll.addView(et, LinearLayout.LayoutParams(-1, -2))

            def on_action_changed(new_action: str):
                selected[0] = new_action
                tv_action.setText(f"Действие: {new_action}")

            btn_change.setOnClickListener(OnClickListener(
                lambda v: self._pick_action(activity, "Сменить действие", on_action_changed)))

            def on_save(dlg, _):
                try:
                    alias = str(et.getText()).strip().lower()
                    err = None
                    if not alias:
                        err = "Введи алиас"
                    elif any(a.get("alias") == alias and a != original for a in self._aliases):
                        err = "Такой алиас уже есть"
                    dlg.dismiss()
                    if err:
                        chosen = selected[0]
                        run_on_ui_thread(lambda: self._show_alias_dialog(original, chosen, alias, err))
                        return
                    aliases = list(self._aliases)
                    entry = {"alias": alias, "action": selected[0]}
                    if original in aliases:
                        aliases[aliases.index(original)] = entry
                    else:
                        aliases.append(entry)
                    self._save_aliases(aliases)
                except Exception as ex:
                    self.log(f"[RP] alias save: {ex}")

            builder = AlertDialogBuilder(activity)
            builder.set_title("Редактировать алиас" if original else f"Алиас для «{action}»")
            builder.set_view(ll)
            builder.set_positive_button("Сохранить" if original else "Добавить", on_save)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.show()
        except Exception as e:
            self.log(f"[RP] alias_dialog: {e}")

    def _show_alias_menu(self, entry: dict):
        self._show_entry_menu(
            f"{entry.get('alias', '?')} -> {entry.get('action', '?')}",
            lambda: self._show_alias_dialog(entry, entry.get("action", "")),
            lambda: self._confirm_delete(
                "Удалить алиас?",
                f"{entry.get('alias', '?')} -> {entry.get('action', '?')}",
                lambda: self._save_aliases([a for a in self._aliases if a != entry]),
            ),
        )

    def _custom_draft(self, entry: Optional[dict]) -> dict:
        if not entry:
            return {"name": "", "emoji": "", "eid": "", "p1": "", "p2": "", "p3": "", "weights": "60 25 15"}
        phrases = entry.get("phrases", [])
        weights = entry.get("weights", [])
        return {
            "name": entry.get("name", ""),
            "emoji": entry.get("emoji", ""),
            "eid": str(entry.get("eid") or ""),
            "p1": phrases[0] if len(phrases) > 0 else "",
            "p2": phrases[1] if len(phrases) > 1 else "",
            "p3": phrases[2] if len(phrases) > 2 else "",
            "weights": " ".join(str(w) for w in weights) if weights else "60 25 15",
        }

    def _validate_custom(self, vals: dict, original: Optional[dict]):
        name = vals["name"].strip().lower()
        if not name:
            return None, ("name", "Введи название команды")
        if not vals["p1"]:
            return None, ("p1", "Фраза 1 обязательна")
        if name in ACTIONS or name in ALIASES:
            return None, ("name", "Конфликт со встроенной командой")
        old_name = original.get("name") if original else None
        if any(a.get("name") == name and name != old_name for a in self._custom_actions):
            return None, ("name", "Такая команда уже есть")

        eid = None
        if vals["eid"]:
            try:
                eid = int(vals["eid"])
            except ValueError:
                return None, ("eid", "EID должен быть числом")

        phrases = [p for p in (vals["p1"], vals["p2"], vals["p3"]) if p]
        weights = []
        if vals["weights"]:
            try:
                parts = [int(x) for x in vals["weights"].split()]
            except ValueError:
                return None, ("weights", "Целые числа через пробел")
            while parts and len(parts) < len(phrases):
                parts.append(parts[-1])
            weights = parts[:len(phrases)]

        return {"name": name, "emoji": vals["emoji"] or "🎭", "eid": eid,
                "phrases": phrases, "weights": weights}, None

    def _show_custom_dialog(self, original: Optional[dict] = None,
                            draft: Optional[dict] = None, error: Optional[tuple] = None):
        try:
            activity = self._activity()
            if not activity:
                return
            from android.widget import LinearLayout, ScrollView
            from org.telegram.messenger import AndroidUtilities
            dp = AndroidUtilities.dp

            values = draft or self._custom_draft(original)
            fields = (
                ("name", "Команда", "обнюхать"),
                ("emoji", "Эмодзи", "👃"),
                ("eid", "EID премиум эмодзи (необязательно)", "5251269269424982151"),
                ("p1", "Фраза 1  •  {actor} = исполнитель, {target} = цель", "{actor} понюхал {target}"),
                ("p2", "Фраза 2 (необязательно)", "{actor} жадно нюхает {target}..."),
                ("p3", "Фраза 3 (необязательно)", "{actor} не отрывается от {target}"),
                ("weights", "Шансы фраз 1/2/3 (через пробел, напр: 60 25 15)", "60 25 15"),
            )

            sv = ScrollView(activity)
            ll = LinearLayout(activity)
            ll.setOrientation(LinearLayout.VERTICAL)
            ll.setPadding(dp(20), dp(4), dp(20), dp(4))
            sv.addView(ll)

            edits = {}
            for key, label, hint in fields:
                lp_label = LinearLayout.LayoutParams(-1, -2)
                lp_label.topMargin = dp(10)
                lp_label.bottomMargin = dp(2)
                ll.addView(self._gray_label(activity, label, 11), lp_label)
                et = self._styled_edittext(activity, hint, values.get(key, ""), text_size=14)
                lp_et = LinearLayout.LayoutParams(-1, -2)
                lp_et.bottomMargin = dp(6)
                ll.addView(et, lp_et)
                edits[key] = et

            if error and error[0] in edits:
                edits[error[0]].setError(error[1])

            def on_save(dlg, _):
                try:
                    vals = {k: str(et.getText()).strip() for k, et in edits.items()}
                    entry, err = self._validate_custom(vals, original)
                    dlg.dismiss()
                    if err:
                        run_on_ui_thread(lambda: self._show_custom_dialog(original, vals, err))
                        return
                    actions = list(self._custom_actions)
                    index = next((i for i, a in enumerate(actions)
                                  if original and a.get("name") == original.get("name")), None)
                    if index is None:
                        actions.append(entry)
                    else:
                        actions[index] = entry
                    self._save_custom_actions(actions)
                except Exception as ex:
                    self.log(f"[RP] custom save: {ex}")

            builder = AlertDialogBuilder(activity)
            builder.set_title("Редактировать" if original else "Новая команда")
            builder.set_view(sv)
            builder.set_positive_button("Сохранить" if original else "Добавить", on_save)
            builder.set_negative_button("Отмена", lambda b, _: b.dismiss())
            builder.show()
        except Exception as e:
            self.log(f"[RP] custom_dialog: {e}")

    def _show_add_custom(self, view=None):
        self._show_custom_dialog()

    def _show_custom_menu(self, entry: dict):
        name = entry.get("name", "?")
        self._show_entry_menu(
            name,
            lambda: self._show_custom_dialog(entry),
            lambda: self._confirm_delete(
                "Удалить команду?",
                f"'{name}' будет удалена безвозвратно",
                lambda: self._save_custom_actions([a for a in self._custom_actions if a != entry]),
            ),
        )

    def create_settings(self) -> List[Any]:
        try:
            items: List[Any] = [
                Header(text="Основные"),
                Switch(key="actions_enabled", text="Включить РП действия", default=True, icon="msg_edit"),
                Switch(key="show_emoji", text="Показывать эмодзи в начале", default=True, icon="msg_emoji_smiles"),
                Switch(
                    key="confirm_rp",
                    text="Диалог подтверждения РП",
                    default=False,
                    icon="msg_info",
                    subtext="Спрашивать перед отправкой действия",
                ),
                Switch(key="nsfw", text="NSFW команды (18+)", default=True, icon="msg_secret"),
                Divider(),
                Header(text="Алиасы"),
                Text(text="Добавить алиас", icon="msg_add", on_click=self._show_add_alias, accent=True),
            ]
            for entry in self._aliases:
                items.append(Text(
                    text=f"{entry.get('alias', '')}  ->  {entry.get('action', '')}",
                    icon="msg_edit",
                    subtext="Нажми для редактирования или удаления",
                    on_click=lambda v, e=entry: self._show_alias_menu(e),
                ))
            items += [
                Divider(),
                Header(text="Свои команды"),
                Text(text="Добавить команду", icon="msg_add", on_click=self._show_add_custom, accent=True),
            ]
            for entry in self._custom_actions:
                eid = entry.get("eid")
                subtext = f"Фраз: {len(entry.get('phrases', []))}" + (f", eid: {eid}" if eid else "")
                items.append(Text(
                    text=f"{entry.get('emoji') or '🎭'} {entry.get('name', '')}",
                    icon="msg_edit",
                    subtext=subtext,
                    on_click=lambda v, e=entry: self._show_custom_menu(e),
                ))
            return items
        except Exception as e:
            self.log(f"[RP] settings: {e}")
            return [Header(text="Ошибка загрузки настроек")]
