# slider stops in seconds, 0 turns the transition off
AUTO_DURATIONS = (1, 2, 3, 5, 8, 12)
MANUAL_DURATIONS = (0, 1, 2, 3, 4, 5)

TICK_MS = 30
NATIVE_FADE_MS = 300
MIN_AUTO_FADE_MS = 500
FADE_IN_START_TIMEOUT = 3.0

# MediaController constants
AUDIO_NO_FOCUS_CAN_DUCK = 1
VOLUME_DUCK = 0.2
REPEAT_MODE_NONE = 0
REPEAT_MODE_ONE = 2

_AU_CHANNEL_ID = 2521243181
_AU_MSG_ID = 138


class S:
    auto_duration = SettingEntry("auto_duration_sec", 5)
    manual_duration = SettingEntry("manual_duration_sec", 1)
    curve = SettingEntry("curve", 0, icon="msg_stats")
    debug_mode = SettingEntry("debug_mode", False, icon="msg_log")


logger = zwylib.build_log(__name__)


def get_duration_index(entry: SettingEntry, durations: Tuple[int, ...]) -> int:
    seconds = entry.safe_get(int)
    return min(range(len(durations)), key=lambda i: abs(durations[i] - seconds))


def get_auto_fade_ms() -> int:
    return AUTO_DURATIONS[get_duration_index(S.auto_duration, AUTO_DURATIONS)] * 1000


def get_manual_fade_ms() -> int:
    return MANUAL_DURATIONS[get_duration_index(S.manual_duration, MANUAL_DURATIONS)] * 1000


def is_equal_power() -> bool:
    return S.curve.safe_get(int) == 0


def fade_gain(progress: float, equal_power: bool) -> float:
    progress = min(max(progress, 0.0), 1.0)
    return math.sin(progress * math.pi / 2) if equal_power else progress


class MC:
    _fields: Dict[str, Any] = {}

    @classmethod
    def _field(cls, name: str):
        field = cls._fields.get(name)
        if field is None:
            field = MediaController.getClass().getDeclaredField(name)
            field.setAccessible(True)
            cls._fields[name] = field
        return field

    @classmethod
    def get(cls, name: str) -> Optional[Any]:
        try:
            return cls._field(name).get(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return None

    @classmethod
    def get_float(cls, name: str, default: float) -> float:
        try:
            return cls._field(name).getFloat(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return default

    @classmethod
    def get_int(cls, name: str, default: int) -> int:
        try:
            return cls._field(name).getInt(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return default

    @classmethod
    def get_bool(cls, name: str, default: bool) -> bool:
        try:
            return cls._field(name).getBoolean(MediaController.getInstance())
        except Exception:
            logger.debug(f"Failed to read '{name}':", exc_info=True)
            return default

    @classmethod
    def set(cls, name: str, value: Any):
        cls._field(name).set(MediaController.getInstance(), value)

    @classmethod
    def set_float(cls, name: str, value: float):
        cls._field(name).setFloat(MediaController.getInstance(), value)


def get_duck_factor() -> float:
    return VOLUME_DUCK if MC.get_int("audioFocus", 2) == AUDIO_NO_FOCUS_CAN_DUCK else 1.0


def is_cast_active() -> bool:
    try:
        return bool(jclass("org.telegram.ui.CastSync").isActive())
    except Exception:
        return False


def cancel_native_volume_animator():
    animator = MC.get("audioVolumeAnimator")
    if animator is not None:
        animator.removeAllUpdateListeners()
        animator.cancel()


def destroy_listen_reporter():
    # same as cleanupPlayer does: flushes the listen report of the track we are leaving
    reporter = MC.get("reporter")
    if reporter is None:
        return

    try:
        method = reporter.getClass().getDeclaredMethod("destroy")
        method.setAccessible(True)
        method.invoke(reporter)
        MC.set("reporter", None)
    except Exception:
        logger.debug("Failed to destroy listen reporter:", exc_info=True)


def is_track_available(message: MessageObject) -> bool:
    owner = message.messageOwner
    if owner.attachPath and File(owner.attachPath).exists():
        return True
    if FileLoader.getInstance(message.currentAccount).getPathToMessage(owner).exists():
        return True
    return (
        SharedConfig.streamMedia
        and not message.shouldEncryptPhotoOrVideo()
        and not DialogObject.isEncryptedDialog(message.getDialogId())
    )


def can_auto_advance(controller: MediaController) -> bool:
    """Mirrors playNextMessageWithoutOrder(byStop=true): True only if offtg would start another track."""
    playlist = MC.get("shuffledPlaylist") if SharedConfig.shuffleMusic else controller.getPlaylist()
    if playlist is None or playlist.size() < 2:
        return False

    force_loop = MC.get_bool("forceLoopCurrentPlaylist", False)
    if SharedConfig.repeatMode == REPEAT_MODE_ONE and not force_loop:
        return False

    size = playlist.size()
    current_index = controller.getPlayingMessageObjectNum()
    if not 0 <= current_index < size:
        return False

    next_index = current_index + (1 if SharedConfig.playOrderReversed else -1)
    if next_index < 0 or next_index >= size:
        if SharedConfig.repeatMode == REPEAT_MODE_NONE and not force_loop:
            return False
        next_index = 0 if next_index >= size else size - 1

    next_message = playlist.get(next_index)
    return next_message is not None and next_message.isMusic() and is_track_available(next_message)


class MutedVisualizerDelegate(dynamic_proxy(VideoPlayer.AudioVisualizerDelegate)):
    def onVisualizerUpdate(self, playing, animate, values):
        pass

    def needUpdate(self):
        return False


class FadeOut:
    def __init__(self, player: VideoPlayer, start_volume: float, duration_ms: int, equal_power: bool):
        self.player = player
        self.start_volume = start_volume
        self.duration = duration_ms / 1000
        self.equal_power = equal_power
        self.started = time.monotonic()
        self.released = False

    def _progress(self) -> float:
        return (time.monotonic() - self.started) / self.duration

    def get_volume(self) -> float:
        return self.start_volume * fade_gain(1 - self._progress(), self.equal_power)

    def hurry(self):
        if (1 - self._progress()) * self.duration <= NATIVE_FADE_MS / 1000:
            return

        self.start_volume = self.get_volume()
        self.duration = NATIVE_FADE_MS / 1000
        self.equal_power = False
        self.started = time.monotonic()

    def release(self):
        if self.released:
            return

        self.released = True
        try:
            self.player.releasePlayer(True)
        except Exception:
            logger.error("Failed to release the faded out player:", exc_info=True)

    def tick(self) -> bool:
        if self.released:
            return False

        if self._progress() >= 1:
            self.release()
            return False

        self.player.setVolume(get_duck_factor() * self.get_volume())
        return True


class FadeIn:
    def __init__(self, player: VideoPlayer, duration_ms: int, equal_power: bool):
        self.player = player
        self.duration = duration_ms / 1000
        self.equal_power = equal_power
        self.created = time.monotonic()
        self.started: Optional[float] = None
        self.volume = 0.0

    def apply(self, volume: float):
        self.volume = volume
        MC.set_float("audioVolume", volume)
        self.player.setVolume(get_duck_factor() * volume)

    def tick(self) -> bool:
        current_player = MC.get("audioPlayer")
        if current_player is None or not current_player.equals(self.player):
            return False

        now = time.monotonic()
        if self.started is None:
            if self.player.getCurrentPosition() <= 0 and now - self.created < FADE_IN_START_TIMEOUT:
                self.apply(0.0)
                return True
            self.started = now

        progress = (now - self.started) / self.duration
        if progress >= 1:
            self.apply(1.0)
            return False

        self.apply(fade_gain(progress, self.equal_power))
        return True


class Crossfader:
    def __init__(self):
        self.fade_in: Optional[FadeIn] = None
        self.fade_outs: List[FadeOut] = []
        self.ticking = False
        self.active = True

        self.auto_fade_ms = 0  # set while the watcher is switching tracks
        self.pending_fade_ms = 0  # set while playMessage is about to clean up the previous music player
        self.taken_fade_ms = 0  # set once the previous player was taken over from cleanupPlayer

    def _ensure_ticking(self):
        if not self.ticking and self.active:
            self.ticking = True
            run_on_ui_thread(self._tick, TICK_MS)

    def _tick(self):
        if not self.active:
            self.ticking = False
            return

        try:
            self.fade_outs = [i for i in self.fade_outs if i.tick()]
            if self.fade_in is not None and not self.fade_in.tick():
                self.fade_in = None
        except Exception:
            logger.error("An error occurred while fading:", exc_info=True)
            self.finish()

        if self.fade_outs or self.fade_in is not None:
            run_on_ui_thread(self._tick, TICK_MS)
        else:
            self.ticking = False

    def add_fade_out(self, player: VideoPlayer, start_volume: float, duration_ms: int):
        self.fade_outs.append(FadeOut(player, start_volume, duration_ms, is_equal_power()))
        self._ensure_ticking()

    def start_fade_in(self, player: VideoPlayer, duration_ms: int):
        self.fade_in = FadeIn(player, duration_ms, is_equal_power())
        self.fade_in.apply(0.0)
        self._ensure_ticking()

    def cancel_fade_in(self) -> Optional[float]:
        if self.fade_in is None:
            return None

        volume = self.fade_in.volume
        self.fade_in = None
        return volume

    def hurry_fade_outs(self):
        for fade_out in self.fade_outs:
            fade_out.hurry()

    def finish(self):
        for fade_out in self.fade_outs:
            fade_out.release()
        self.fade_outs = []

        if self.fade_in is not None:
            try:
                self.fade_in.apply(1.0)
            except Exception:
                logger.error("Failed to restore the volume:", exc_info=True)
            self.fade_in = None

    def shutdown(self):
        self.active = False
        self.finish()


class EndOfTrackWatcher:
    def __init__(self):
        self.token = 0

    def start(self):
        self.token += 1
        self._schedule(self.token, 0)

    def stop(self):
        self.token += 1

    def _schedule(self, token: int, delay: int):
        run_on_ui_thread(lambda: self._tick(token), delay)

    def _tick(self, token: int):
        if token != self.token:
            return

        try:
            delay = self._check()
        except Exception:
            logger.error("An error occurred while watching the track:", exc_info=True)
            delay = 1000

        if delay is not None:
            self._schedule(token, delay)

    @staticmethod
    def _check() -> Optional[int]:
        controller = MediaController.getInstance()
        message = controller.getPlayingMessageObject()
        if message is None or not message.isMusic():
            return None

        if controller.isMessagePaused() or is_cast_active():
            return 500

        player = MC.get("audioPlayer")
        if player is None:
            return 500

        duration = player.getDuration()
        position = player.getCurrentPosition()
        if duration <= 0 or position < 0:
            return 250

        speed = max(player.getPlaybackSpeed(), 0.1)
        remaining = (duration - position) / speed

        # short tracks should not be eaten by the transition completely
        fade_ms = min(get_auto_fade_ms(), duration / speed / 3)
        if fade_ms < MIN_AUTO_FADE_MS:
            return 1000

        gap = remaining - fade_ms
        if gap > 0:
            return int(min(max(gap / 2, 40), 1000))

        if not can_auto_advance(controller):
            return 500

        logger.debug(f"{remaining:.0f} ms left, starting the next track.")
        crossfader.auto_fade_ms = int(max(min(fade_ms, remaining), NATIVE_FADE_MS))
        try:
            controller.playNextMessage()
        finally:
            crossfader.auto_fade_ms = 0
        return 500


crossfader = Crossfader()
watcher = EndOfTrackWatcher()


def play_message_before_hook(param):
    crossfader.pending_fade_ms = 0
    crossfader.taken_fade_ms = 0

    message: MessageObject = param.args[0]
    if message is None or not message.isMusic():
        return

    current_message = param.thisObject.getPlayingMessageObject()
    if current_message is None or not current_message.isMusic() or is_cast_active():
        return

    crossfader.pending_fade_ms = crossfader.auto_fade_ms or get_manual_fade_ms()


def cleanup_player_before_hook(param):
    fade_ms = crossfader.pending_fade_ms
    crossfader.pending_fade_ms = 0

    crossfader.hurry_fade_outs()
    crossfader.cancel_fade_in()

    if fade_ms <= 0:
        return

    player = MC.get("audioPlayer")
    if player is None or not player.isPlaying():
        return

    start_volume = MC.get_float("audioVolume", 1.0)
    try:
        # with no audioPlayer cleanupPlayer skips its own 300 ms fade out & release, the rest of it runs as usual
        MC.set("audioPlayer", None)
    except Exception:
        logger.error("Failed to take over the player, falling back to offtg behavior:", exc_info=True)
        return

    try:
        cancel_native_volume_animator()
        destroy_listen_reporter()
        player.allowMultipleInstances = True
        player.setAudioVisualizerDelegate(MutedVisualizerDelegate())
        Theme.unrefAudioVisualizeDrawable(param.thisObject.getPlayingMessageObject())
    except Exception:
        logger.error("An error occurred while taking over the player:", exc_info=True)

    logger.debug(f"Took over the player, fading out for {fade_ms} ms.")
    crossfader.add_fade_out(player, start_volume, fade_ms)
    crossfader.taken_fade_ms = fade_ms


def play_message_after_hook(param):
    fade_ms = crossfader.taken_fade_ms
    crossfader.pending_fade_ms = 0
    crossfader.taken_fade_ms = 0

    message: MessageObject = param.args[0]
    if message is not None and message.isMusic():
        watcher.start()

    if fade_ms <= 0:
        return

    player = MC.get("audioPlayer")
    if player is None or not param.getResult():
        crossfader.hurry_fade_outs()
        return

    cancel_native_volume_animator()
    crossfader.start_fade_in(player, fade_ms)
    logger.debug(f"Fading in for {fade_ms} ms.")


def pause_message_after_hook(param):
    if not param.getResult():
        return

    crossfader.hurry_fade_outs()
    volume = crossfader.cancel_fade_in()
    if volume is None:
        return

    # offtg fades out from the full volume on pause, start from where the fade in has stopped instead
    animator = MC.get("audioVolumeAnimator")
    if animator is not None and animator.isRunning():
        animator.setFloatValues(jarray(jfloat)([volume, 0.0]))

    player = MC.get("audioPlayer")
    if player is not None:
        MC.set_float("audioVolume", volume)
        player.setVolume(get_duck_factor() * volume)


def build_duration_slider(entry: SettingEntry, durations: Tuple[int, ...]) -> Custom:
    def on_choose(index: int):
        item.intValue = index
        # reloading would rebuild the settings page right under the finger
        SettingsManager.set(entry.plugin_id, entry, durations[index], reload_settings=False)

    # UItem.asSlideView(String[] choices, int chosen, Utilities.Callback<Integer> whenChose)
    item = UItem.asSlideView(
        jarray(String)([str(i) if i else L.off for i in durations]),
        get_duration_index(entry, durations),
        zwylib.Callback1(on_choose)
    )
    return Custom(item=item)


class Crossfade(BasePlugin):
    def on_plugin_load(self):
        logger.setLevel(logging.DEBUG if S.debug_mode.get() else logging.INFO)
        zwylib.add_autoupdater_task(__id__, _AU_CHANNEL_ID, _AU_MSG_ID)

        clazz = jclass("org.telegram.messenger.MediaController").getClass()
        play_message = HookUtils.find_max_args_method(clazz, "playMessage")
        cleanup_player = HookUtils.find_max_args_method(clazz, "cleanupPlayer")
        pause_message = HookUtils.find_max_args_method(clazz, "pauseMessage")

        if not play_message or not cleanup_player or not pause_message:
            logger.error("Failed to hook MediaController methods.")
            return

        HookUtils.hook_before(play_message, play_message_before_hook)
        HookUtils.hook_after(play_message, play_message_after_hook)
        HookUtils.hook_before(cleanup_player, cleanup_player_before_hook)
        HookUtils.hook_after(pause_message, pause_message_after_hook)

        run_on_ui_thread(watcher.start)
        logger.info("Loaded.")

    def on_plugin_unload(self):
        zwylib.remove_autoupdater_task(__id__)
        watcher.stop()
        run_on_ui_thread(crossfader.shutdown)
        logger.info("Unloaded.")

    def create_settings(self):
        try:
            return [
                Header(f"{L.prefs_auto_duration}, {L.sec}"),
                build_duration_slider(S.auto_duration, AUTO_DURATIONS),
                Header(f"{L.prefs_manual_duration}, {L.sec}"),
                build_duration_slider(S.manual_duration, MANUAL_DURATIONS),
                Divider(L.prefs_durations_hint),
                S.curve.as_selector(
                    text=L.prefs_curve,
                    items=[L.curve_equal_power, L.curve_linear],
                ),
                Divider(L.prefs_curve_hint),
                S.debug_mode.as_switch(
                    text=L.prefs_debug_mode,
                    on_change=lambda enabled: logger.setLevel(logging.DEBUG if enabled else logging.INFO)
                ),
            ]
        except Exception as e:
            logger.error("An error occurred while generating settings:", exc_info=True)
            trace = zwylib.format_exc_from(e)
            return [
                Divider(f"An error occurred while generating settings:\n{zwylib.format_exc_only(e)}"),
                Text(
                    text="Copy full traceback",
                    icon="msg_copy",
                    on_click=lambda v: copy_to_clipboard(trace)
                )
            ]
