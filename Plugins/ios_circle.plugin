def _safe_str(v):
    try:
        if v is None:
            return None
        return str(v)
    except Exception:
        return None


def _cls_name(cls):
    try:
        n = cls.getName()
        if n:
            return str(n)
    except Exception:
        pass
    try:
        return str(cls)
    except Exception:
        return "?"


def _real_class(cls):
    if cls is None:
        return None
    try:
        cls.getDeclaredMethods()
        return cls
    except Exception:
        pass
    try:
        jc = cls.getClass()
        jc.getDeclaredMethods()
        return jc
    except Exception:
        pass
    try:
        from java import jclass
        jc = jclass("java.lang.Class").forName(_cls_name(cls))
        jc.getDeclaredMethods()
        return jc
    except Exception:
        return cls


def _safe_find_class(name):
    cls = _sdk_find_class(name)
    if cls is None:
        return None
    return _real_class(cls)


def _method_names(clazz):
    names = []
    try:
        for m in clazz.getDeclaredMethods():
            try:
                n = str(m.getName())
            except Exception:
                continue
            if n.startswith("$") or "lambda" in n.lower():
                continue
            names.append(n)
    except Exception:
        return []
    return sorted(set(names))


class _SafeHook(MethodHook):
    def __init__(self, plugin, before=None, after=None):
        super(_SafeHook, self).__init__()
        self.plugin = plugin
        self.before_fn = before
        self.after_fn = after

    def before_hooked_method(self, param):
        if self.before_fn is None:
            return
        try:
            self.before_fn(param)
        except Exception:
            pass

    def after_hooked_method(self, param):
        if self.after_fn is None:
            return
        try:
            self.after_fn(param)
        except Exception:
            pass


class _ClassLoadWatch(MethodHook):
    def __init__(self, plugin):
        super(_ClassLoadWatch, self).__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            name = str(param.args[0])
        except Exception:
            return
        self.plugin._on_class_loaded(name)


class _NotifyHook(MethodHook):
    def __init__(self, plugin):
        super(_NotifyHook, self).__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_notification(param)
        except Exception:
            pass


class IosCirclePlugin(BasePlugin):
    ICV = "org.telegram.ui.Components.InstantCameraView"

    def __init__(self):
        super(IosCirclePlugin, self).__init__()
        self._mixer_class = None
        self._mixer_status = "not loaded"
        self._counts = {}
        self._notes = {}
        self._unhooks = []
        self._round_paths = set()
        self._processed = set()
        self._busy = set()
        self._switches_ms = []
        self._recording = False
        self._session_active = False
        self._rec_start = 0
        self._last_stop_ms = 0
        self._reattempts = 0
        self._watch_pending = False
        self._inner_scanned = False
        self._icv_scanned = False
        self._nc_started = None
        self._nc_stopped = None
        self._remembered_this_session = False
        self._passthrough = 0
        self._xb = None
        self._hooks_ready = False
        self._welcome_shown = False
        self._mix_factory = None
        self._mix_preview = None
        self._mix_layer_a = None
        self._mix_layer_b = None
        self._mix_anim = None
        self._mix_anim_layer = None
        self._mix_tick_r = None
        self._preview_ready = False
        self._preview_bitmaps = {}

    def on_plugin_load(self):
        self._load_mixer()
        self._load_notification_ids()
        self._install_hooks(only_missing=False)
        if not self._hooks_ready:
            self._install_classwatch()
            self._schedule_rehook(3)
        self._ensure_preview_images()

    def on_plugin_unload(self):
        self._round_paths.clear()
        self._processed.clear()
        self._busy.clear()
        self._session_active = False
        self._recording = False
        self._passthrough = 0
        self._stop_mix_anim()
        self._mix_preview = None
        self._mix_layer_a = None
        self._mix_layer_b = None
        self._preview_bitmaps = {}

    def _app_context(self):
        ApplicationLoaderCls = _safe_find_class("org.telegram.messenger.ApplicationLoader")
        ctx = None
        if ApplicationLoaderCls is not None:
            try:
                ctx = ApplicationLoaderCls.applicationContext
            except Exception:
                ctx = None
            if ctx is None:
                try:
                    ctx = get_private_field(ApplicationLoaderCls, "applicationContext")
                except Exception:
                    ctx = None
        if ctx is None:
            from java import jclass
            ctx = jclass("android.app.ActivityThread").currentApplication()
        return ctx

    def _open_tg_link(self, username):
        try:
            context = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW, Uri.parse("tg://resolve?domain=" + username))
            intent.setPackage(context.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        except Exception:
            pass

    def _show_welcome_dialog(self):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment:
                return
            activity = current_fragment.getParentActivity()
            if not activity:
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title(__name__)
            builder.set_message("Кажется там еще больше крутых плагинов")

            def on_hide(bld, which):
                self.set_setting("welcome_shown", True)
                bld.dismiss()

            def on_channel(bld, which):
                self.set_setting("welcome_shown", True)
                self._open_tg_link("HzzzPlugins")
                bld.dismiss()

            builder.set_positive_button("👀 Посмотреть канал автора", on_channel)
            builder.set_negative_button("Скрыть", on_hide)
            builder.show()
        except Exception:
            pass

    def _on_reload_dex(self, view=None):
        self._mixer_class = None
        self._clear_preview_cache()
        self._load_mixer()
        if self._mixer_class is not None:
            self._toast("DEX reloaded")
        else:
            self._toast("DEX failed")
        self._ensure_preview_images()

    def create_settings(self):
        self._install_hooks(only_missing=True)
        if not self._welcome_shown and not self.get_setting("welcome_shown", False):
            self._welcome_shown = True
            try:
                run_on_ui_thread(self._show_welcome_dialog)
            except Exception:
                self._show_welcome_dialog()
        dex_ok = self._mixer_class is not None
        status = ("DEX ready" if dex_ok else "DEX failed") + " | 2.9-public | by h z z z"
        items = [
            Text(text=status),
            Selector(
                key="mix_duration",
                text="Mix duration",
                default=2,
                items=MIX_MS_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Selector(
                key="easing",
                text="Easing",
                default=1,
                items=EASE_ITEMS,
                on_change=self._on_mix_setting,
            ),
            Text(text="Reload DEX", subtext="нажми если чет сломалось", on_click=self._on_reload_dex),
            Divider(),
        ]
        preview = self._mix_preview_setting()
        if preview is not None:
            items.append(preview)
            items.append(Divider())
        items.extend([
            Text(text="Сделал: @exoseo", on_click=lambda v: self._open_tg_link("exoseo")),
            Text(text="Канал: @HzzzPlugins", on_click=lambda v: self._open_tg_link("HzzzPlugins")),
        ])
        return items

    def _on_mix_setting(self, index):
        pass

    def _mix_preview_setting(self):
        setting = None
        if SimpleSettingFactory is not None:
            try:
                if self._mix_factory is None:
                    self._mix_factory = SimpleSettingFactory(
                        self._create_mix_preview_view,
                        self._bind_mix_preview_view,
                        is_clickable=False,
                        is_shadow=False,
                    )
                factory = self._mix_factory
                try:
                    setting = factory()
                except Exception:
                    setting = None
                if setting is None and Custom is not None:
                    try:
                        inst = getattr(factory, "instance", None)
                        java_factory = None
                        if inst is not None:
                            java_factory = getattr(inst, "java", inst)
                        if java_factory is not None:
                            setting = Custom(factory=java_factory)
                    except Exception:
                        setting = None
            except Exception:
                setting = None
        if setting is None and Custom is not None:
            try:
                ctx = None
                try:
                    frag = get_last_fragment()
                    if frag is not None:
                        ctx = frag.getParentActivity()
                except Exception:
                    ctx = None
                if ctx is None:
                    ctx = self._app_context()
                if ctx is not None:
                    setting = Custom(view=self._build_mix_preview(ctx))
            except Exception:
                setting = None
        return setting

    def _create_mix_preview_view(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            return self._build_mix_preview(context)
        except Exception:
            try:
                from android.widget import FrameLayout
                from org.telegram.messenger import AndroidUtilities
                root = FrameLayout(context)
                h = AndroidUtilities.dp(228)
                root.setMinimumHeight(h)
                try:
                    from android.view import ViewGroup
                    root.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, h))
                except Exception:
                    pass
                return root
            except Exception:
                from android.view import View
                return View(context)

    def _bind_mix_preview_view(self, view, item, divider, adapter, list_view):
        self._mix_preview = view
        layer = None
        try:
            tag = view.getTag()
        except Exception:
            tag = None
        if isinstance(tag, (list, tuple)) and len(tag) >= 1:
            layer = tag[0]
        else:
            layer = tag
            try:
                holder = view.getChildAt(0)
                if holder is not None:
                    layer = holder.getChildAt(0)
            except Exception:
                pass
        if layer is not None:
            self._mix_layer_a = layer
            self._mix_layer_b = layer
        self._apply_preview_images()

    def _build_mix_preview(self, context):
        from android.widget import FrameLayout, LinearLayout
        from android.view import Gravity, ViewGroup
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.Components import LayoutHelper

        size_dp = 176
        size = AndroidUtilities.dp(size_dp)
        pad = AndroidUtilities.dp(26)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setGravity(Gravity.CENTER)
        root.setPadding(0, pad, 0, pad)
        try:
            root.setMinimumHeight(size + pad * 2)
        except Exception:
            pass
        try:
            root.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        except Exception:
            pass

        holder = FrameLayout(context)
        try:
            oval = GradientDrawable()
            oval.setShape(GradientDrawable.OVAL)
            oval.setColor(0xFF141414)
            holder.setBackground(oval)
            holder.setClipToOutline(True)
        except Exception:
            pass
        try:
            holder.setMinimumWidth(size)
            holder.setMinimumHeight(size)
        except Exception:
            pass

        img = self._make_preview_layer(context, size)

        fill = None
        try:
            fill = LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT)
        except Exception:
            fill = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT)
        holder.addView(img, fill)

        holder_lp = None
        try:
            holder_lp = LayoutHelper.createLinear(size_dp, size_dp, Gravity.CENTER)
        except Exception:
            try:
                holder_lp = LinearLayout.LayoutParams(size, size)
                holder_lp.gravity = Gravity.CENTER
            except Exception:
                holder_lp = ViewGroup.LayoutParams(size, size)
        root.addView(holder, holder_lp)

        try:
            root.setTag([img])
        except Exception:
            root.setTag(img)
        self._mix_preview = root
        self._mix_layer_a = img
        self._mix_layer_b = img
        self._apply_preview_images()
        return root

    def _make_preview_layer(self, context, size_px):
        radius = int(size_px / 2) if size_px else 0
        try:
            from org.telegram.ui.Components import BackupImageView
            v = BackupImageView(context)
            try:
                v.setRoundRadius(radius)
            except Exception:
                pass
            return v
        except Exception:
            pass
        from android.widget import ImageView
        v = ImageView(context)
        try:
            v.setScaleType(ImageView.ScaleType.CENTER_CROP)
        except Exception:
            pass
        try:
            v.setAdjustViewBounds(False)
        except Exception:
            pass
        return v

    def _preview_dir(self):
        base = None
        try:
            base = get_plugins_dir()
        except Exception:
            base = None
        if not base:
            try:
                base = get_files_dir()
            except Exception:
                base = None
        if not base:
            try:
                base = get_cache_dir()
            except Exception:
                base = None
        if not base:
            base = "/data/data"
        path = os.path.join(str(base), "ios_circle")
        try:
            ensure_dir_exists(path)
        except Exception:
            try:
                os.makedirs(path)
            except Exception:
                pass
        return path

    def _preview_path(self):
        d = self._preview_dir()
        return os.path.join(d, "preview.gif")

    def _preview_paths(self):
        p = self._preview_path()
        return p, p

    def _file_ok(self, path):
        try:
            return os.path.isfile(path) and os.path.getsize(path) > 1024
        except Exception:
            return False

    def _clear_preview_cache(self):
        self._preview_ready = False
        self._preview_bitmaps = {}
        try:
            d = self._preview_dir()
            for name in ("preview.gif", "preview_a.jpg", "preview_b.jpg",
                         "preview.gif.part", "preview_a.jpg.part", "preview_b.jpg.part"):
                path = os.path.join(d, name)
                try:
                    if os.path.isfile(path):
                        os.remove(path)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            run_on_ui_thread(self._apply_preview_images)
        except Exception:
            try:
                self._apply_preview_images()
            except Exception:
                pass

    def _ensure_preview_images(self):
        try:
            path = self._preview_path()
        except Exception:
            return
        if self._file_ok(path):
            self._preview_ready = True
            try:
                run_on_ui_thread(self._apply_preview_images)
            except Exception:
                try:
                    self._apply_preview_images()
                except Exception:
                    pass
            return

        def _dl():
            try:
                self._download_file(PREVIEW_IMG, path)
            except Exception:
                pass
            ok = False
            try:
                ok = self._file_ok(path)
            except Exception:
                ok = False
            self._preview_ready = ok
            if ok:
                try:
                    run_on_ui_thread(self._apply_preview_images)
                except Exception:
                    try:
                        self._apply_preview_images()
                    except Exception:
                        pass

        self._run_bg(_dl)

    def _download_file(self, url, dest):
        tmp = dest + ".part"
        data = None
        try:
            import urllib.request
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            resp = urllib.request.urlopen(req, timeout=30)
            try:
                data = resp.read()
            finally:
                try:
                    resp.close()
                except Exception:
                    pass
        except Exception:
            data = None
        if data is None:
            try:
                from java.net import URL
                from java.io import BufferedInputStream, ByteArrayOutputStream
                conn = URL(url).openConnection()
                conn.setRequestProperty("User-Agent", "Mozilla/5.0")
                conn.setConnectTimeout(15000)
                conn.setReadTimeout(30000)
                conn.connect()
                inp = BufferedInputStream(conn.getInputStream())
                bos = ByteArrayOutputStream()
                buf = bytearray(8192)
                try:
                    from jarray import zeros
                    jbuf = zeros(8192, "b")
                    while True:
                        n = inp.read(jbuf)
                        if n is None or int(n) < 0:
                            break
                        bos.write(jbuf, 0, int(n))
                    data = bos.toByteArray()
                except Exception:
                    data = None
                try:
                    inp.close()
                except Exception:
                    pass
            except Exception:
                data = None
        if data is None or len(data) < 1024:
            return False
        try:
            ensure_dir_exists(os.path.dirname(dest))
        except Exception:
            try:
                os.makedirs(os.path.dirname(dest))
            except Exception:
                pass
        try:
            write_file_bytes(tmp, bytes(data) if not isinstance(data, bytes) else data)
            os.replace(tmp, dest)
            return self._file_ok(dest)
        except Exception:
            pass
        try:
            raw = bytes(data) if not isinstance(data, bytes) else data
            f = open(tmp, "wb")
            try:
                f.write(raw)
            finally:
                f.close()
            os.replace(tmp, dest)
            return self._file_ok(dest)
        except Exception:
            try:
                from java.io import FileOutputStream, File
                fos = FileOutputStream(tmp)
                fos.write(data)
                fos.close()
                File(tmp).renameTo(File(dest))
                return self._file_ok(dest)
            except Exception:
                return False

    def _decode_preview_bitmap(self, path, view):
        if not self._file_ok(path):
            return None
        cached = None
        try:
            cached = self._preview_bitmaps.get(path)
        except Exception:
            cached = None
        if cached is not None:
            return cached
        try:
            from android.graphics import BitmapFactory
            bounds = BitmapFactory.Options()
            bounds.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path, bounds)
            w = int(bounds.outWidth or 0)
            h = int(bounds.outHeight or 0)
            target = 512
            try:
                vw = int(view.getWidth()) if view is not None else 0
                if vw > 64:
                    target = vw
            except Exception:
                pass
            if target < 256:
                target = 256
            sample = 1
            while w > 0 and h > 0 and (w / sample) > (target * 2) and (h / sample) > (target * 2):
                sample = sample * 2
            opts = BitmapFactory.Options()
            opts.inJustDecodeBounds = False
            opts.inSampleSize = int(sample)
            bmp = BitmapFactory.decodeFile(path, opts)
            if bmp is not None:
                try:
                    self._preview_bitmaps[path] = bmp
                except Exception:
                    pass
            return bmp
        except Exception:
            return None

    def _put_gif(self, view, path):
        """Показать гифку с бесконечным циклом через BackupImageView / ImageReceiver."""
        if view is None or not self._file_ok(path):
            return
        try:
            view.setImage(path, None, None)
            try:
                ir = view.getImageReceiver()
                if ir is not None:
                    try:
                        ir.setAllowStartAnimation(True)
                    except Exception:
                        pass
                    try:
                        ir.setAutoRepeat(1)
                    except Exception:
                        pass
                    try:
                        ir.startAnimation()
                    except Exception:
                        pass
            except Exception:
                pass
            return
        except Exception:
            pass
        try:
            from org.telegram.messenger import ImageLocation
            loc = ImageLocation.getForPath(path)
            view.setImage(loc, None, None, None, 0)
            try:
                ir = view.getImageReceiver()
                if ir is not None:
                    try:
                        ir.setAllowStartAnimation(True)
                    except Exception:
                        pass
                    try:
                        ir.setAutoRepeat(1)
                    except Exception:
                        pass
                    try:
                        ir.startAnimation()
                    except Exception:
                        pass
            except Exception:
                pass
            return
        except Exception:
            pass
        try:
            ir = view.getImageReceiver()
            if ir is not None:
                try:
                    from org.telegram.messenger import ImageLocation
                    loc = ImageLocation.getForPath(path)
                    ir.setImage(loc, None, None, None, 0, None, None, 1)
                except Exception:
                    try:
                        ir.setImage(path, None, None)
                    except Exception:
                        pass
                try:
                    ir.setAllowStartAnimation(True)
                except Exception:
                    pass
                try:
                    ir.setAutoRepeat(1)
                except Exception:
                    pass
                try:
                    ir.startAnimation()
                except Exception:
                    pass
                return
        except Exception:
            pass
        bmp = self._decode_preview_bitmap(path, view)
        if bmp is None:
            return
        try:
            view.setImageBitmap(bmp)
            return
        except Exception:
            pass
        try:
            from android.graphics.drawable import BitmapDrawable
            res = view.getContext().getResources()
            view.setImageDrawable(BitmapDrawable(res, bmp))
        except Exception:
            pass

    def _put_bitmap(self, view, path):
        self._put_gif(view, path)

    def _apply_preview_images(self):
        a_view = getattr(self, "_mix_layer_a", None)
        b_view = getattr(self, "_mix_layer_b", None)
        if a_view is None and b_view is None:
            return
        try:
            path = self._preview_path()
        except Exception:
            return
        if a_view is not None:
            self._put_gif(a_view, path)
        if b_view is not None and b_view is not a_view:
            self._put_gif(b_view, path)

    def _stop_mix_anim(self):
        self._mix_anim_layer = None
        old = getattr(self, "_mix_anim", None)
        self._mix_anim = None
        if old is not None and old is not True:
            try:
                old.cancel()
            except Exception:
                pass

    def _mix_ease(self, kind, x):
        if x <= 0.0:
            return 0.0
        if x >= 1.0:
            return 1.0
        k = int(kind)
        if k == 0:
            return x
        if k == 2:
            return self._bezier_ease(x, 0.42, 0.0, 0.58, 1.0)
        return self._bezier_ease(x, 0.25, 0.1, 0.25, 1.0)

    def _bezier_ease(self, x, x1, y1, x2, y2):
        t = x
        for _ in range(8):
            cx = 3.0 * x1
            bx = 3.0 * (x2 - x1) - cx
            ax = 1.0 - cx - bx
            xt = ((ax * t + bx) * t + cx) * t
            dxt = (3.0 * ax * t + 2.0 * bx) * t + cx
            if abs(dxt) < 1e-6:
                break
            t = t - (xt - x) / dxt
            if t < 0.0:
                t = 0.0
            elif t > 1.0:
                t = 1.0
        cy = 3.0 * y1
        by = 3.0 * (y2 - y1) - cy
        ay = 1.0 - cy - by
        return ((ay * t + by) * t + cy) * t

    def _mix_alpha_at(self, frac, mix_ms, hold_ms):
        total = float(hold_ms * 2 + mix_ms * 2)
        if total <= 0:
            return 0.0
        ms = float(frac) * total
        easing = int(self.get_setting("easing", 1) or 1)
        a = float(hold_ms)
        b = a + float(mix_ms)
        c = b + float(hold_ms)
        if ms < a:
            return 0.0
        if ms < b:
            return self._mix_ease(easing, (ms - a) / float(mix_ms))
        if ms < c:
            return 1.0
        return 1.0 - self._mix_ease(easing, (ms - c) / float(mix_ms))

    def _mix_cycle_times(self):
        mix_i = int(self.get_setting("mix_duration", 2) or 2)
        if mix_i < 0 or mix_i >= len(MIX_MS_VALUES):
            mix_i = 2
        mix_ms = int(MIX_MS_VALUES[mix_i])
        hold_ms = int(PREVIEW_CYCLE_MS) - mix_ms
        if hold_ms < 200:
            hold_ms = 200
        total = hold_ms * 2 + mix_ms * 2
        return mix_ms, hold_ms, total

    def _now_anim_ms(self):
        try:
            from android.os import SystemClock
            return int(SystemClock.uptimeMillis())
        except Exception:
            pass
        try:
            from java.lang import System
            return int(System.currentTimeMillis())
        except Exception:
            return int(time.time() * 1000)

    def _apply_mix_alpha(self, layer, value):
        if layer is None:
            return
        a = float(value)
        if a < 0.0:
            a = 0.0
        if a > 1.0:
            a = 1.0
        try:
            layer.setAlpha(a)
            return
        except Exception:
            pass
        try:
            layer.setAlpha(int(a * 255))
        except Exception:
            pass

    def _post_mix_tick(self, layer, delay):
        r = getattr(self, "_mix_tick_r", None)
        if layer is None or r is None:
            return
        try:
            layer.postDelayed(r, int(delay))
            return
        except Exception:
            pass
        try:
            layer.post(r)
        except Exception:
            pass

    def _start_mix_anim(self, layer_b):
        self._stop_mix_anim()
        if layer_b is None:
            return
        mix_ms, hold_ms, total = self._mix_cycle_times()
        self._mix_anim_mix = mix_ms
        self._mix_anim_hold = hold_ms
        self._mix_anim_total = total
        self._mix_anim_layer = layer_b
        self._mix_anim_t0 = self._now_anim_ms()
        plugin = self

        def _tick():
            layer = getattr(plugin, "_mix_anim_layer", None)
            if layer is None:
                return
            try:
                total_i = int(plugin._mix_anim_total)
                if total_i <= 0:
                    return
                now = plugin._now_anim_ms()
                frac = float((now - plugin._mix_anim_t0) % total_i) / float(total_i)
                a = plugin._mix_alpha_at(frac, plugin._mix_anim_mix, plugin._mix_anim_hold)
                plugin._apply_mix_alpha(layer, a)
            except Exception:
                pass
            plugin._post_mix_tick(layer, 16)

        started = False
        try:
            runner = _R
            if runner is None:
                raise Exception("no R")
            self._mix_tick_r = runner(_tick)
            self._mix_anim = True
            self._post_mix_tick(layer_b, 0)
            started = True
        except Exception:
            started = False
        if started:
            return
        try:
            from java import dynamic_proxy
            from java.lang import Runnable

            class _Tick(dynamic_proxy(Runnable)):
                def run(self):
                    _tick()

            self._mix_tick_r = _Tick()
            self._mix_anim = True
            self._post_mix_tick(layer_b, 0)
            started = True
        except Exception:
            started = False
        if started:
            return
        try:
            from android.animation import ValueAnimator
            from android.view.animation import LinearInterpolator
            from java import dynamic_proxy
            anim = ValueAnimator.ofFloat(0.0, 1.0)
            anim.setDuration(int(total))
            anim.setRepeatCount(ValueAnimator.INFINITE)
            anim.setRepeatMode(ValueAnimator.RESTART)
            anim.setInterpolator(LinearInterpolator())

            class _UL(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self, animation):
                    try:
                        t = float(animation.getAnimatedFraction())
                        a = plugin._mix_alpha_at(t, mix_ms, hold_ms)
                        plugin._apply_mix_alpha(layer_b, a)
                    except Exception:
                        pass

            anim.addUpdateListener(_UL())
            anim.start()
            self._mix_anim = anim
        except Exception:
            self._mix_anim = None

    def _install_classwatch(self):
        if self._hooks_ready:
            return
        try:
            cl = _safe_find_class("java.lang.ClassLoader")
            if cl is None:
                return
            unhooks = self.hook_all_methods(cl, "loadClass", _ClassLoadWatch(self))
            if unhooks:
                self._unhooks.extend(unhooks)
        except Exception:
            pass

    def _on_class_loaded(self, name):
        if self._hooks_ready or self._watch_pending:
            return
        if not name.startswith("org.telegram") and not name.startswith("com.exteragram"):
            return
        wanted = (
            self.ICV, self.ICV + "$VideoRecorder", self.ICV + "$CameraGLThread",
            self.ICV + "$EncoderRenderer", self.ICV + "$Delegate",
            "org.telegram.messenger.SendMessagesHelper",
            "org.telegram.ui.ChatActivity",
            "org.telegram.messenger.NotificationCenter",
        )
        if name not in wanted and not name.startswith(self.ICV + "$"):
            return
        self._watch_pending = True

        def _ui():
            self._watch_pending = False
            self._install_hooks(only_missing=True)

        try:
            run_on_ui_thread(_ui)
        except Exception:
            _ui()

    def _short_for(self, class_name):
        return class_name.split(".")[-1].split("$")[-1]

    def _mark_ready(self):
        send_ok = (
            self._counts.get("InstantCameraView.send", 0) > 0
            or self._counts.get("ChatActivity.sendMedia", 0) > 0
            or self._counts.get("Delegate.sendMedia", 0) > 0
            or self._counts.get("SendMessagesHelper~prepareSendingVideo", 0) > 0
        )
        flip_ok = (
            self._counts.get("InstantCameraView.switchCamera", 0) > 0
            or self._counts.get("CameraGLThread.flipSurfaces", 0) > 0
            or self._counts.get("CameraGLThread.reinitForNewCamera", 0) > 0
            or self._counts.get("CameraGLThread.switchCamera", 0) > 0
        )
        if send_ok and flip_ok:
            self._hooks_ready = True

    def _schedule_rehook(self, delay_s):
        if self._reattempts >= 3 or self._hooks_ready:
            return

        def _bg():
            time.sleep(delay_s)

            def _ui():
                self._reattempts += 1
                self._install_hooks(only_missing=True)
                if not self._hooks_ready:
                    self._schedule_rehook(delay_s * 2)

            try:
                run_on_ui_thread(_ui)
            except Exception:
                pass

        self._run_bg(_bg)

    def _load_notification_ids(self):
        try:
            nc = _safe_find_class("org.telegram.messenger.NotificationCenter")
            if nc is None:
                return
            self._nc_started = self._static_int(nc, "recordStarted")
            self._nc_stopped = self._static_int(nc, "recordStopped")
        except Exception:
            pass

    def _static_int(self, clazz, name):
        try:
            f = clazz.getDeclaredField(name)
            f.setAccessible(True)
            return int(f.get(None))
        except Exception:
            pass
        try:
            v = get_private_field(clazz, name)
            if v is not None:
                return int(v)
        except Exception:
            pass
        try:
            return int(getattr(clazz, name))
        except Exception:
            return None

    def _install_hooks(self, only_missing=False):
        H = _SafeHook
        self._hook_overloads(self.ICV, "send", H(self, self._before_icv_send, self._after_icv_send), only_missing)
        self._hook_overloads(self.ICV, "switchCamera", H(self, None, self._after_switch), only_missing)
        self._hook_overloads(self.ICV, "showCamera", H(self, None, self._after_show_camera), only_missing)
        self._hook_overloads(self.ICV, "togglePause", H(self, None, self._after_toggle_pause), only_missing)
        self._hook_overloads(self.ICV, "cancel", H(self, None, self._after_cancel), only_missing)
        self._scan_icv_once()
        self._hook_inner_classes(only_missing)
        self._hook_overloads("org.telegram.ui.ChatActivity", "sendMedia", H(self, self._before_send_media, None), only_missing)
        self._hook_overloads(self.ICV + "$Delegate", "sendMedia", H(self, self._before_send_media, None), only_missing)
        for cls in (
            "org.telegram.messenger.camera.CameraXController",
            "com.exteragram.messenger.camera.CameraXController",
            "org.telegram.ui.Components.CameraView",
        ):
            self._hook_overloads(cls, "switchCamera", H(self, None, self._after_switch), only_missing, quiet=True)
            self._hook_overloads(cls, "switchToNext", H(self, None, self._after_switch), only_missing, quiet=True)
        self._hook_contains("org.telegram.messenger.SendMessagesHelper", "prepareSendingVideo",
                            H(self, self._before_prepare_video, None), only_missing)
        self._hook_notifications(only_missing)
        self._mark_ready()

    def _hook_notifications(self, only_missing):
        short = "NotificationCenter.postNotificationName"
        if only_missing and self._counts.get(short, 0) > 0:
            return
        if self._nc_started is None and self._nc_stopped is None:
            return
        clazz = _safe_find_class("org.telegram.messenger.NotificationCenter")
        if clazz is None:
            return
        try:
            unhooks = self.hook_all_methods(clazz, "postNotificationName", _NotifyHook(self))
            n = len(unhooks or [])
            if unhooks:
                self._unhooks.extend(unhooks)
            self._counts[short] = max(self._counts.get(short, 0), n)
        except Exception:
            self._counts.setdefault(short, 0)

    def _on_notification(self, param):
        try:
            nid_i = int(param.args[0])
        except Exception:
            return
        if self._nc_started is not None and nid_i == int(self._nc_started):
            self._latch_recording(param.thisObject)
            return
        if self._nc_stopped is not None and nid_i == int(self._nc_stopped):
            self._recording = False
            self._session_active = False
            self._last_stop_ms = self._now_ms()

    def _scan_icv_once(self):
        if self._icv_scanned:
            return
        icv = _safe_find_class(self.ICV)
        if icv is None:
            return
        self._icv_scanned = True

    def _hook_inner_classes(self, only_missing):
        H = _SafeHook
        icv = _safe_find_class(self.ICV)
        inners = []
        if icv is not None:
            try:
                declared = icv.getDeclaredClasses()
                if declared is not None:
                    for c in declared:
                        inners.append(c)
            except Exception:
                pass
        for name in (
            self.ICV + "$VideoRecorder",
            self.ICV + "$CameraGLThread",
            self.ICV + "$EncoderRenderer",
            self.ICV + "$EncoderHandler",
            self.ICV + "$Delegate",
            self.ICV + "_VideoRecorder",
            self.ICV + "_CameraGLThread",
            "org.telegram.ui.Components.VideoRecorder",
        ):
            c = _safe_find_class(name)
            if c is not None:
                inners.append(c)
        seen = set()
        for inner in inners:
            try:
                full = str(inner.getName())
            except Exception:
                continue
            if full in seen:
                continue
            seen.add(full)
            names = _method_names(inner)
            short = self._short_for(full)
            name_set = set(names)
            for m in START_METHODS:
                if m in name_set:
                    self._hook_on(inner, full, m, H(self, self._before_vr_start, None), only_missing)
            if "onEncoderSurfaceCreated" in name_set:
                self._hook_on(inner, full, "onEncoderSurfaceCreated",
                              H(self, None, self._after_encoder_created), only_missing)
            for m in STOP_METHODS:
                if m in name_set:
                    self._hook_on(inner, full, m, H(self, None, self._after_stop), only_missing)
            if short in ("CameraGLThread", "VideoRecorder", "EncoderHandler"):
                for m in GL_STOP_METHODS:
                    if m in name_set:
                        self._hook_on(inner, full, m, H(self, None, self._after_stop), only_missing, quiet=True)
            for m in FLIP_METHODS:
                if m in name_set:
                    self._hook_on(inner, full, m, H(self, None, self._after_switch), only_missing)
            if "sendMedia" in name_set:
                self._hook_on(inner, full, "sendMedia", H(self, self._before_send_media, None), only_missing)
        self._inner_scanned = True

    def _hook_overloads(self, class_name, method_name, handler, only_missing=False, quiet=False):
        short = self._short_for(class_name) + "." + method_name
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        clazz = _safe_find_class(class_name)
        if clazz is None:
            self._counts.setdefault(short, 0)
            return 0
        return self._hook_on(clazz, class_name, method_name, handler, only_missing, quiet=quiet)

    def _hook_on(self, clazz, class_name, method_name, handler, only_missing=False, quiet=False):
        short = self._short_for(class_name) + "." + method_name
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        n = 0
        try:
            unhooks = self.hook_all_methods(clazz, method_name, handler)
            n = len(unhooks or [])
            if unhooks:
                self._unhooks.extend(unhooks)
        except Exception:
            pass
        if n == 0:
            try:
                methods = clazz.getDeclaredMethods()
                for m in methods:
                    if str(m.getName()) != method_name:
                        continue
                    try:
                        m.setAccessible(True)
                        u = self.hook_method(m, handler)
                        if u:
                            self._unhooks.append(u)
                        n += 1
                    except Exception:
                        pass
            except Exception:
                pass
        self._counts[short] = max(self._counts.get(short, 0), n)
        return n

    def _hook_contains(self, class_name, needle, handler, only_missing=False):
        short = self._short_for(class_name) + "~" + needle
        if only_missing and self._counts.get(short, 0) > 0:
            return self._counts[short]
        clazz = _safe_find_class(class_name)
        if clazz is None:
            self._counts.setdefault(short, 0)
            return 0
        n = 0
        try:
            for m in clazz.getDeclaredMethods():
                if needle not in str(m.getName()):
                    continue
                try:
                    m.setAccessible(True)
                    u = self.hook_method(m, handler)
                    if u:
                        self._unhooks.append(u)
                    n += 1
                except Exception:
                    pass
        except Exception:
            pass
        self._counts[short] = max(self._counts.get(short, 0), n)
        return n

    def _load_mixer(self):
        try:
            from java import jclass
            from java.nio import ByteBuffer
            Base64 = jclass("android.util.Base64")
            Build = jclass("android.os.Build")
            File = jclass("java.io.File")
            FileOutputStream = jclass("java.io.FileOutputStream")
            raw = Base64.decode(DEX_B64.strip(), 0)
            if raw is None or len(raw) < 64:
                self._mixer_status = "empty dex"
                return
            ctx = self._app_context()
            parent_cl = ctx.getClassLoader()
            sdk = int(Build.VERSION.SDK_INT)
            if sdk >= 26:
                InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
                loader = InMemoryDexClassLoader(ByteBuffer.wrap(raw), parent_cl)
            else:
                DexClassLoader = jclass("dalvik.system.DexClassLoader")
                cache = ctx.getCodeCacheDir() if sdk >= 21 else ctx.getDir("dex", 0)
                dex_file = File(cache, "ioscircle2.dex")
                fos = FileOutputStream(dex_file)
                fos.write(raw)
                fos.close()
                opt = File(cache, "ioscircle2_opt")
                if not opt.exists():
                    opt.mkdirs()
                loader = DexClassLoader(dex_file.getAbsolutePath(), opt.getAbsolutePath(), None, parent_cl)
            cls = loader.loadClass("ioscircle.Mixer")
            self._mixer_class = cls
            self._mixer_status = "loaded"
        except Exception as e:
            self._mixer_class = None
            self._mixer_status = "%s: %s" % (type(e).__name__, e)

    def _java_array(self, component, values, setter):
        from java import jclass
        Array = jclass("java.lang.reflect.Array")
        n = len(values)
        arr = Array.newInstance(component, n)
        for i in range(n):
            setter(arr, i, values[i])
        return arr

    def _box_arg(self, t, v):
        from java import jclass
        Integer = jclass("java.lang.Integer")
        Long = jclass("java.lang.Long")
        Boolean = jclass("java.lang.Boolean")
        Array = jclass("java.lang.reflect.Array")
        tn = str(t.getName())
        if tn in ("java.lang.String", "String"):
            return None if v is None else str(v)
        if tn == "int":
            return Integer.valueOf(int(v))
        if tn == "long":
            return Long.valueOf(int(v))
        if tn == "boolean":
            return Boolean.valueOf(bool(v))
        if tn in ("[J", "long[]"):
            seq = list(v or [])
            return self._java_array(Long.TYPE, [int(x) for x in seq], Array.setLong)
        if tn in ("[I", "int[]"):
            seq = list(v or [])
            return self._java_array(Integer.TYPE, [int(x) for x in seq], Array.setInt)
        return v

    def _invoke_static(self, m, values):
        from java import jclass, jarray
        try:
            from java.lang import Object
        except Exception:
            Object = jclass("java.lang.Object")
        ptypes = list(m.getParameterTypes())
        if len(ptypes) != len(values):
            raise Exception("param count %d != %d" % (len(ptypes), len(values)))
        boxed = [self._box_arg(t, v) for t, v in zip(ptypes, values)]
        obj_arr = jarray(Object)(boxed)
        last = None
        try:
            return m.invoke(None, obj_arr)
        except Exception as e:
            last = e
        try:
            return m.invoke(None, boxed)
        except Exception as e:
            last = e
        try:
            return m.invoke(None, *boxed)
        except Exception as e:
            last = e
        raise last

    def _valid_cuts(self):
        out = []
        for x in self._switches_ms:
            try:
                v = int(x)
            except Exception:
                continue
            if v <= 40:
                continue
            if out and abs(v - out[-1]) < 70:
                continue
            out.append(v)
        return out

    def _mix_file(self, in_path, out_path):
        if self._mixer_class is None:
            return "mixer not loaded"
        try:
            mix_i = int(self.get_setting("mix_duration", 2) or 2)
            if mix_i < 0 or mix_i >= len(MIX_MS_VALUES):
                mix_i = 2
            mix_ms = MIX_MS_VALUES[mix_i]
            easing = int(self.get_setting("easing", 1) or 1)
            cuts = self._valid_cuts()
            spec = "mixMs=%d;freeze=1;easing=%d;cuts=%s" % (
                mix_ms,
                easing,
                ",".join(str(int(c)) for c in cuts),
            )
            run = None
            proc = None
            proc_cuts = None
            for m in self._mixer_class.getDeclaredMethods():
                nm = str(m.getName())
                nparams = 0
                try:
                    nparams = len(list(m.getParameterTypes()))
                except Exception:
                    pass
                if nm == "run" and nparams == 3:
                    run = m
                elif nm == "process" and nparams == 5:
                    proc = m
                elif nm == "processWithCuts" and nparams == 6:
                    proc_cuts = m
            last_err = "no process method"
            if run is not None:
                run.setAccessible(True)
                try:
                    return self._invoke_static(run, [in_path, out_path, spec])
                except Exception as e:
                    last_err = "%s: %s" % (type(e).__name__, e)
            if cuts and proc_cuts is not None:
                proc_cuts.setAccessible(True)
                try:
                    return self._invoke_static(proc_cuts, [in_path, out_path, mix_ms, True, easing, cuts])
                except Exception as e:
                    last_err = "%s: %s" % (type(e).__name__, e)
            if proc is not None:
                proc.setAccessible(True)
                try:
                    return self._invoke_static(proc, [in_path, out_path, mix_ms, True, easing])
                except Exception as e:
                    last_err = "%s: %s" % (type(e).__name__, e)
            return last_err
        except Exception as e:
            return "%s: %s" % (type(e).__name__, e)

    def _read_field(self, obj, name):
        if obj is None:
            return None
        try:
            v = get_private_field(obj, name)
            if v is not None:
                return v
        except Exception:
            pass
        try:
            v = getattr(obj, name, None)
            if v is not None:
                return v
        except Exception:
            pass
        try:
            cls = obj.getClass()
        except Exception:
            return None
        hops = 0
        while cls is not None and hops < 6:
            hops += 1
            try:
                f = cls.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                pass
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
        return None

    def _as_bool(self, v):
        if v is None:
            return False
        try:
            if v is True:
                return True
            if v is False:
                return False
        except Exception:
            pass
        try:
            s = str(v).strip().lower()
            if s in ("true", "1"):
                return True
            if s in ("false", "0", "none", "null"):
                return False
        except Exception:
            pass
        try:
            return bool(v.booleanValue())
        except Exception:
            pass
        try:
            return bool(v)
        except Exception:
            return False

    def _as_long(self, v):
        if v is None:
            return 0
        try:
            return int(v)
        except Exception:
            pass
        try:
            return int(v.longValue())
        except Exception:
            pass
        try:
            return int(str(v))
        except Exception:
            return 0

    def _path_of(self, obj):
        if obj is None:
            return None
        try:
            if hasattr(obj, "getAbsolutePath"):
                p = _safe_str(obj.getAbsolutePath())
                if p:
                    return p
        except Exception:
            pass
        try:
            s = _safe_str(obj)
            if s and s.lower().endswith(".mp4") and ("/" in s or "\\" in s):
                return s
        except Exception:
            pass
        return None

    def _chain(self, obj):
        out = []
        seen = set()
        cur = obj
        depth = 0
        while cur is not None and depth < 4:
            try:
                ident = id(cur)
            except Exception:
                ident = depth
            if ident in seen:
                break
            seen.add(ident)
            out.append(cur)
            nxt = None
            for name in OUTER_FIELDS:
                try:
                    nxt = self._read_field(cur, name)
                except Exception:
                    nxt = None
                if nxt is not None and nxt is not cur:
                    break
                nxt = None
            cur = nxt
            depth += 1
        return out

    def _remember_file(self, obj):
        if obj is None:
            return
        for o in self._chain(obj):
            path = self._path_of(o)
            if path:
                self._round_paths.add(path)
            for name in FILE_FIELDS:
                try:
                    f = self._read_field(o, name)
                    p = self._path_of(f)
                    if p:
                        self._round_paths.add(p)
                except Exception:
                    pass
        if len(self._round_paths) > 24:
            extra = list(self._round_paths)[:-16]
            for p in extra:
                self._round_paths.discard(p)
        if self._round_paths:
            self._remembered_this_session = True

    def _field_truthy(self, obj, name):
        return self._as_bool(self._read_field(obj, name))

    def _is_recording_obj(self, obj):
        if obj is None:
            return False
        for o in self._chain(obj):
            for name in RECORDING_FIELDS:
                if self._field_truthy(o, name):
                    return True
            rst = self._as_long(self._read_field(o, "recordStartTime"))
            if rst > 100000:
                return True
            rec_t = self._as_long(self._read_field(o, "recordedTime"))
            if rec_t > 200:
                return True
            for name in ENCODER_FIELDS:
                try:
                    enc = self._read_field(o, name)
                except Exception:
                    enc = None
                if enc is not None:
                    if self._field_truthy(enc, "started") or self._field_truthy(enc, "running"):
                        return True
        return False

    def _record_start_from(self, obj):
        for o in self._chain(obj):
            rst = self._as_long(self._read_field(o, "recordStartTime"))
            if rst > 100000:
                return rst
        return 0

    def _now_ms(self):
        try:
            from java.lang import System
            return int(System.currentTimeMillis())
        except Exception:
            return int(time.time() * 1000)

    def _latch_recording(self, obj):
        self._remember_file(obj)
        self._recording = True
        self._session_active = True
        rst = self._record_start_from(obj) if obj is not None else 0
        now = self._now_ms()
        if rst > 100000 and self._rec_start and rst > self._rec_start + 120:
            shift = rst - self._rec_start
            self._rec_start = rst
            adj = []
            for c in self._switches_ms:
                try:
                    v = int(c) - int(shift)
                except Exception:
                    continue
                if v > 40:
                    adj.append(v)
            self._switches_ms = adj
        elif not self._rec_start:
            self._rec_start = rst if rst else now
            self._switches_ms = []
            self._remembered_this_session = False
            self._remember_file(obj)

    def _ensure_recording(self, obj):
        self._remember_file(obj)
        if self._session_active and self._recording:
            if not self._rec_start:
                rst = self._record_start_from(obj)
                self._rec_start = rst if rst else self._now_ms()
            else:
                rst = self._record_start_from(obj)
                if rst > 100000 and rst > self._rec_start + 120:
                    shift = rst - self._rec_start
                    self._rec_start = rst
                    adj = []
                    for c in self._switches_ms:
                        try:
                            v = int(c) - int(shift)
                        except Exception:
                            continue
                        if v > 40:
                            adj.append(v)
                    self._switches_ms = adj
            return True
        rec = self._recording or self._is_recording_obj(obj)
        if not rec:
            return False
        self._latch_recording(obj)
        return True

    def _after_encoder_created(self, param):
        self._remember_file(param.thisObject)
        if self._is_recording_obj(param.thisObject) or self._session_active:
            self._latch_recording(param.thisObject)

    def _after_show_camera(self, param):
        from_paused = False
        try:
            if param.args and len(param.args) > 0:
                from_paused = bool(param.args[0])
        except Exception:
            from_paused = False
        self._remember_file(param.thisObject)
        if from_paused:
            return
        if self._is_recording_obj(param.thisObject):
            self._latch_recording(param.thisObject)
            return
        self._recording = False
        self._session_active = False
        self._rec_start = 0
        self._switches_ms = []
        self._remembered_this_session = False

    def _after_toggle_pause(self, param):
        self._remember_file(param.thisObject)
        self._recording = bool(self._is_recording_obj(param.thisObject))

    def _after_cancel(self, param):
        self._recording = False
        self._session_active = False
        self._last_stop_ms = self._now_ms()

    def _before_vr_start(self, param):
        try:
            if param.args and len(param.args) > 0:
                self._remember_file(param.args[0])
        except Exception:
            pass
        self._latch_recording(param.thisObject)

    def _after_stop(self, param):
        self._remember_file(param.thisObject)
        if self._session_active or self._recording:
            self._last_stop_ms = self._now_ms()
        self._recording = False
        self._session_active = False

    def _after_switch(self, param):
        obj = param.thisObject
        if not self._ensure_recording(obj):
            return
        now = self._now_ms()
        delta = now - self._rec_start if self._rec_start else 0
        if delta <= 40:
            return
        try:
            cls_name = _cls_name(obj.getClass())
        except Exception:
            cls_name = ""
        short = cls_name.split(".")[-1] if cls_name else ""
        echo = (
            short in ("CameraGLThread", "EncoderRenderer", "EncoderHandler", "CameraView")
            or "CameraX" in short
            or "GLThread" in short
        )
        if self._switches_ms:
            gap = delta - self._switches_ms[-1]
            if gap < 70:
                return
            if echo and gap < 480:
                return
        self._switches_ms.append(delta)

    def _before_icv_send(self, param):
        try:
            state = int(param.args[0])
        except Exception:
            state = -1
        self._remember_file(param.thisObject)
        if state == 4 or state == 1 or state == 3:
            self._recording = False
            self._session_active = False
            self._last_stop_ms = self._now_ms()

    def _after_icv_send(self, param):
        self._remember_file(param.thisObject)

    def _is_round_info(self, info):
        if info is None:
            return False
        try:
            v = getattr(info, "roundVideo", None)
            if self._as_bool(v):
                return True
        except Exception:
            pass
        try:
            if self._as_bool(self._read_field(info, "roundVideo")):
                return True
        except Exception:
            pass
        try:
            if self._as_bool(get_private_field(info, "roundVideo")):
                return True
        except Exception:
            pass
        return False

    def _snapshot_args(self, param):
        try:
            n = len(param.args)
            return [param.args[i] for i in range(n)]
        except Exception:
            try:
                return list(param.args)
            except Exception:
                return []

    def _xposed_bridge(self):
        if self._xb is not None:
            return self._xb
        for name in (
            "de.robv.android.xposed.XposedBridge",
            "org.lsposed.lspd.impl.LSPosedBridge",
        ):
            cls = _safe_find_class(name)
            if cls is not None:
                self._xb = cls
                return cls
        self._xb = False
        return None

    def _call_original(self, method, this, args):
        last = None
        xb = self._xposed_bridge()
        if xb and xb is not False:
            try:
                from java import jarray
                from java.lang import Object
                jargs = jarray(Object)(list(args))
                xb.invokeOriginalMethod(method, this, jargs)
                return True
            except Exception as e:
                last = e
        try:
            name = str(method.getName())
            fn = getattr(this, name)
            fn(*tuple(args))
            return True
        except Exception as e:
            last = e
        try:
            if this is None:
                method.invoke(None, *tuple(args))
            else:
                method.invoke(this, *tuple(args))
            return True
        except Exception as e:
            last = e
        return False

    def _resend_on_ui(self, method, this, args):
        def _invoke():
            self._passthrough += 1
            try:
                ok = self._call_original(method, this, args)
                if not ok:
                    self._toast("iOS mix: send failed")
            except Exception:
                self._toast("iOS mix: send failed")
            finally:
                if self._passthrough > 0:
                    self._passthrough -= 1

        try:
            run_on_ui_thread(_invoke)
        except Exception:
            _invoke()

    def _before_send_media(self, param):
        if self._passthrough > 0:
            return
        if not self.get_setting("enabled", True) or self._mixer_class is None:
            return
        entry = param.args[0] if param.args else None
        info = None
        try:
            if param.args and len(param.args) > 1:
                info = param.args[1]
        except Exception:
            info = None
        path = self._entry_path(entry)
        is_round = self._is_round_info(info) or (path in self._round_paths)
        cuts = self._valid_cuts()
        if not path or path in self._processed or path in self._busy:
            return
        if not is_round:
            return
        if not cuts:
            return
        args = self._snapshot_args(param)
        this = param.thisObject
        method = param.method
        param.setResult(None)
        self._busy.add(path)
        self._cancel_upload(path)
        self._toast("iOS mix…")
        self._run_bg(lambda: self._process_then_send(this, method, args, entry, info, path))

    def _before_prepare_video(self, param):
        if self._passthrough > 0:
            return
        if not self.get_setting("enabled", True) or self._mixer_class is None:
            return
        cuts = self._valid_cuts()
        if not cuts:
            return
        path = None
        path_index = -1
        round_flag = False
        info = None
        try:
            for i in range(len(param.args)):
                a = param.args[i]
                try:
                    if a is not None and (hasattr(a, "roundVideo") or "VideoEditedInfo" in type(a).__name__):
                        info = a
                        if self._is_round_info(a):
                            round_flag = True
                except Exception:
                    pass
                s = None
                try:
                    if isinstance(a, str) and a.lower().endswith(".mp4"):
                        s = a
                    elif a is not None and hasattr(a, "getAbsolutePath"):
                        s = _safe_str(a.getAbsolutePath())
                except Exception:
                    s = None
                if s and (s in self._round_paths or s in self._busy):
                    path = s
                    path_index = i
        except Exception:
            return
        if path is None and (round_flag or self._is_round_info(info)):
            try:
                for i in range(len(param.args)):
                    a = param.args[i]
                    if isinstance(a, str) and a.lower().endswith(".mp4"):
                        path, path_index = a, i
                        break
            except Exception:
                pass
        if not path or path in self._processed or path in self._busy:
            return
        if not (round_flag or self._is_round_info(info) or path in self._round_paths):
            return
        args = self._snapshot_args(param)
        this = param.thisObject
        method = param.method
        param.setResult(None)
        self._busy.add(path)
        self._cancel_upload(path)
        self._toast("iOS mix…")

        def _go():
            try:
                self._wait_stable(path, 8000)
                out = self._do_mix(path)
                if out and out != path and path_index >= 0:
                    try:
                        args[path_index] = out
                    except Exception:
                        pass
                    self._processed.add(out)
                self._processed.add(path)
            except Exception:
                pass
            finally:
                self._busy.discard(path)
            self._resend_on_ui(method, this, args)

        self._run_bg(_go)

    def _entry_path(self, entry):
        if entry is None:
            return None
        for name in ("path", "imagePath", "originalPath"):
            try:
                v = getattr(entry, name, None)
                if v:
                    return _safe_str(v)
            except Exception:
                pass
            try:
                v = self._read_field(entry, name)
                if v:
                    return _safe_str(v)
            except Exception:
                pass
        return self._path_of(entry)

    def _set_entry_path(self, entry, info, out):
        if entry is not None:
            for name in ("path", "imagePath", "originalPath"):
                try:
                    setattr(entry, name, out)
                except Exception:
                    try:
                        set_private_field(entry, name, out)
                    except Exception:
                        pass
        if info is not None:
            try:
                info.originalPath = out
            except Exception:
                try:
                    set_private_field(info, "originalPath", out)
                except Exception:
                    pass
            try:
                info.notReadyYet = False
            except Exception:
                try:
                    set_private_field(info, "notReadyYet", False)
                except Exception:
                    pass
            try:
                from java.io import File
                sz = int(File(out).length())
                if sz > 0:
                    try:
                        info.estimatedSize = sz
                    except Exception:
                        try:
                            set_private_field(info, "estimatedSize", sz)
                        except Exception:
                            pass
            except Exception:
                pass

    def _process_then_send(self, this, method, args, entry, info, path):
        try:
            self._wait_stable(path, 8000)
            out = self._do_mix(path)
            if out and out != path:
                self._set_entry_path(entry, info, out)
                self._processed.add(out)
            self._processed.add(path)
        except Exception:
            self._toast("iOS mix failed, sending original")
        finally:
            self._busy.discard(path)
        self._resend_on_ui(method, this, args)

    def _do_mix(self, path):
        cache = get_cache_dir() or "/data/data"
        out_dir = os.path.join(str(cache), "ioscircle")
        try:
            ensure_dir_exists(out_dir)
        except Exception:
            try:
                os.makedirs(out_dir)
            except Exception:
                out_dir = os.path.dirname(path)
        base = os.path.splitext(os.path.basename(path))[0]
        out_path = os.path.join(out_dir, base + "_iosmix.mp4")
        err = self._mix_file(path, out_path)
        if err is None or (isinstance(err, str) and err.strip() == ""):
            self._toast("iOS mix ready")
            return out_path
        err_s = _safe_str(err) or "unknown"
        if "NO_CUTS" in err_s:
            return path
        self._toast("iOS mix skipped: " + err_s)
        return path

    def _wait_stable(self, path, timeout_ms):
        try:
            from java.io import File
            from java.lang import Thread as JThread
            f = File(path)
            last = -1
            stable = 0
            waited = 0
            while waited < timeout_ms:
                sz = int(f.length()) if f.exists() else 0
                if sz > 64 and sz == last:
                    stable += 1
                    if stable >= 4:
                        return True
                else:
                    stable = 0
                last = sz
                JThread.sleep(80)
                waited += 80
            return f.exists() and int(f.length()) > 64
        except Exception:
            return True

    def _cancel_upload(self, path):
        try:
            FileLoader = _sdk_find_class("org.telegram.messenger.FileLoader")
            UserConfig = _sdk_find_class("org.telegram.messenger.UserConfig")
            if FileLoader is None or UserConfig is None:
                return
            acc = int(UserConfig.selectedAccount)
            FileLoader.getInstance(acc).cancelFileUpload(path, False)
        except Exception:
            pass

    def _run_bg(self, fn):
        try:
            from java.lang import Thread
            t = Thread(fn)
            t.setName("ioscircle-mix")
            t.start()
        except Exception:
            try:
                import threading
                threading.Thread(target=fn, name="ioscircle-mix").start()
            except Exception:
                fn()

    def _toast(self, msg):
        def _show():
            try:
                BulletinHelper.show_info(msg)
            except Exception:
                pass
        try:
            run_on_ui_thread(_show)
        except Exception:
            _show()
