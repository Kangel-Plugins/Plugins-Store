import base64
import hashlib
import os
import threading
import time
import zlib
from typing import Any, List
from base_plugin import BasePlugin
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.settings import Divider, Selector, Switch

__id__ = "spam_collapse"
__name__ = "Spam Collapse"
__description__ = "Сворачивает повторяющиеся спам-сообщения / Collapses repeated spam messages"
__author__ = "@dekma0091"
__version__ = "1.3"
__icon__ = "pixelcamera/18"
__min_version__ = "13.1.1"

ENTRY_CLASS = "ni.dekma.spam_collapse.SpamCollapseBridge"
_DEX_BASE64 = ""

BuildVersion = jclass("android.os.Build$VERSION")
IntegerClass = jclass("java.lang.Integer")
BooleanClass = jclass("java.lang.Boolean")

_last_lang_check = 0.0
_cached_is_eng = False
_ACTIVE_INSTANCE = None

try:
    from client_utils import PLUGINS_QUEUE, get_queue_by_name, run_on_queue
    def _run_bg(task):
        try:
            if get_queue_by_name(PLUGINS_QUEUE) is not None:
                run_on_queue(task, PLUGINS_QUEUE)
                return
        except Exception:
            pass
        threading.Thread(target=task, daemon=True).start()
except Exception:
    def _run_bg(task):
        threading.Thread(target=task, daemon=True).start()

def _is_english():
    global _last_lang_check, _cached_is_eng
    now = time.time()
    if now - _last_lang_check < 2.0:
        return _cached_is_eng
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
            _last_lang_check = now
            return _cached_is_eng
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
        _last_lang_check = now
        return _cached_is_eng
    except Exception:
        return False

def _tr(ru, en):
    return en if _is_english() else ru

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._method_cache = {}
        self._pending_cfg = None

    def load(self):
        if self.loaded:
            self.unload()
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context not ready")
        if int(BuildVersion.SDK_INT) < 26:
            raise RuntimeError("API 26+ required")
        if not _DEX_BASE64:
            raise RuntimeError("DEX payload empty")
        raw = base64.b64decode(_DEX_BASE64)
        try:
            payload = zlib.decompress(raw)
        except Exception:
            payload = raw
        buf = None
        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            buf = ByteBuffer.wrap(payload)
            self.loader = InMemoryDexClassLoader(buf, context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        except Exception:
            cache_dir = context.getCacheDir().getAbsolutePath()
            dex_hash = hashlib.sha256(_DEX_BASE64.encode()).hexdigest()[:12]
            dex_path = os.path.join(cache_dir, f"plugin_{dex_hash}.dex")
            opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
            os.makedirs(opt_dir, exist_ok=True)
            if not os.path.exists(dex_path):
                with open(dex_path, "wb") as f:
                    f.write(payload)
            DexClassLoader = jclass("dalvik.system.DexClassLoader")
            self.loader = DexClassLoader(dex_path, opt_dir, None, context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        finally:
            del buf
            del payload
            del raw
        self._method_cache.clear()
        if self._pending_cfg is not None:
            cfg = self._pending_cfg
            self._pending_cfg = None
            try:
                self._invoke("updateConfig", *cfg)
            except Exception:
                pass
        self._invoke("load")
        self.loaded = True

    def unload(self):
        if self.clazz:
            try:
                self._invoke("unload")
            except Exception:
                pass
        self._method_cache.clear()
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._pending_cfg = None

    def update_config(self, *args):
        if not self.loaded:
            self._pending_cfg = args
            return
        try:
            self._invoke("updateConfig", *args)
        except Exception:
            pass

    def _invoke(self, name, *args):
        if not self.clazz:
            raise RuntimeError("DEX not loaded")
        key = (name, len(args))
        cached = self._method_cache.get(key)
        if not cached:
            for m in self.clazz.getDeclaredMethods():
                if str(m.getName()) == name and len(m.getParameterTypes()) == len(args):
                    m.setAccessible(True)
                    cached = (m, [str(pt.getName()) for pt in m.getParameterTypes()])
                    self._method_cache[key] = cached
                    break
            if not cached:
                raise RuntimeError(f"method not found: {name}/{len(args)}")
        method, types = cached
        converted = []
        for i, arg in enumerate(args):
            t = types[i]
            if t in ("int", "java.lang.Integer"):
                converted.append(IntegerClass.valueOf(int(arg)))
            elif t in ("boolean", "java.lang.Boolean"):
                converted.append(BooleanClass.valueOf(bool(arg)))
            else:
                converted.append(arg)
        return method.invoke(None, *converted)

class SpamCollapsePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)
        self._lock = threading.Lock()
        self.is_active = False
        self.is_loading = False

    def on_plugin_load(self):
        global _ACTIVE_INSTANCE
        if _ACTIVE_INSTANCE is not None and _ACTIVE_INSTANCE is not self:
            try:
                _ACTIVE_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_INSTANCE = self
        def _bg_init():
            with self._lock:
                if self.is_active or self.is_loading:
                    return
                self.is_loading = True
            try:
                self._sync_settings()
                self.bridge.load()
                with self._lock:
                    self.is_active = True
                    self.is_loading = False
            except Exception:
                with self._lock:
                    self.is_active = False
                    self.is_loading = False
        _run_bg(_bg_init)

    def on_plugin_unload(self):
        global _ACTIVE_INSTANCE
        with self._lock:
            self.is_active = False
        try:
            self.bridge.unload()
        except Exception:
            pass
        if _ACTIVE_INSTANCE is self:
            _ACTIVE_INSTANCE = None

    def on_settings_changed(self, *args):
        self._sync_settings()

    def set_setting(self, key, value, reload=False):
        super().set_setting(key, value, reload)
        self._sync_settings()

    def _make_on_change(self, key):
        def _cb(*a):
            self._sync_settings()
        return _cb

    def _sync_settings(self):
        try:
            raw_min = self.get_setting("min_count", 0)
            min_count = raw_min if isinstance(raw_min, int) and raw_min >= 2 else ((raw_min if isinstance(raw_min, int) else 0) + 2)
            if min_count < 2:
                min_count = 2
            elif min_count > 5:
                min_count = 5
            self.bridge.update_config(
                min_count,
                bool(self.get_setting("collapse_messages", True)),
                bool(self.get_setting("collapse_gifs", True)),
                bool(self.get_setting("collapse_stickers", True)),
                bool(self.get_setting("collapse_voice", False)),
                bool(self.get_setting("collapse_round_video", False)),
                bool(self.get_setting("collapse_files", False)),
                bool(self.get_setting("collapse_polls", False)),
            )
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        cur_min = self.get_setting("min_count", 0)
        if isinstance(cur_min, int) and cur_min >= 2:
            cur_min = cur_min - 2
        elif not isinstance(cur_min, int) or cur_min < 0 or cur_min > 3:
            cur_min = 0
        return [
            Selector(key="min_count", text=_tr("Минимум повторов", "Minimum repeats"), default=cur_min, items=[_tr("2 раза", "2 times"), _tr("3 раза", "3 times"), _tr("4 раза", "4 times"), _tr("5 раз", "5 times")], on_change=self._make_on_change("min_count")),
            Divider(text=_tr("Типы контента", "Content types")),
            Switch(key="collapse_messages", text=_tr("Сворачивать сообщения", "Collapse messages"), default=True, on_change=self._make_on_change("collapse_messages")),
            Switch(key="collapse_gifs", text=_tr("Сворачивать гифки", "Collapse GIFs"), default=True, on_change=self._make_on_change("collapse_gifs")),
            Switch(key="collapse_stickers", text=_tr("Сворачивать стикеры", "Collapse stickers"), default=True, on_change=self._make_on_change("collapse_stickers")),
            Switch(key="collapse_voice", text=_tr("Сворачивать голосовые", "Collapse voice messages"), default=False, on_change=self._make_on_change("collapse_voice")),
            Switch(key="collapse_round_video", text=_tr("Сворачивать кружки", "Collapse video messages"), default=False, on_change=self._make_on_change("collapse_round_video")),
            Switch(key="collapse_files", text=_tr("Сворачивать файлы", "Collapse files"), default=False, on_change=self._make_on_change("collapse_files")),
            Switch(key="collapse_polls", text=_tr("Сворачивать опросы", "Collapse polls"), default=False, on_change=self._make_on_change("collapse_polls")),
        ]
