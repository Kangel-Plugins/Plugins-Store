COLOR_VIOLET_BRIGHT = Color.parseColor("#B85CFF")
COLOR_VIOLET_FILL = Color.parseColor("#33B85CFF")
COLOR_BG_DARK = Color.parseColor("#17171A")
COLOR_CARD_DARK = Color.parseColor("#232328")
COLOR_CARD_LIGHT = Color.parseColor("#2F2F36")
COLOR_TEXT_MAIN = Color.parseColor("#FFFFFF")
COLOR_TEXT_SUB = Color.parseColor("#8E8E93")
COLOR_DANGER = Color.parseColor("#FF453A")
COLOR_WHITE = Color.parseColor("#FFFFFF")

_DP_CACHE = {}
_DENSITY_VAL = 0.0
_CLASS_META_CACHE = {}
_RES_NAME_CACHE = {}

_BAD_CONTAINERS = (
    "DecorView", "ActionBarOverlayLayout", "ContentFrameLayout",
    "DrawerLayout", "SizeNotifierFrameLayout", "RecyclerListView",
    "RecyclerView", "ViewPager", "ActionBarLayout", "LaunchActivity",
    "WindowManager", "PhoneWindow"
)

_EASE = AccelerateDecelerateInterpolator()


def _get_density():
    global _DENSITY_VAL
    if _DENSITY_VAL <= 0.0:
        try:
            d = float(AndroidUtilities.density)
            if d > 0.0:
                _DENSITY_VAL = d
                return d
        except Exception:
            pass
        return 1.0
    return _DENSITY_VAL


def dp(value):
    v = float(value)
    cached = _DP_CACHE.get(v)
    if cached is not None:
        return cached
    res = int(AndroidUtilities.dp(v))
    if len(_DP_CACHE) > 512:
        _DP_CACHE.clear()
    _DP_CACHE[v] = res
    return res


def px_to_dp(px_val):
    density = _get_density()
    return round(float(px_val) / density, 1)


def make_bg(fill_color, radius_dp=14, stroke_color=0, stroke_dp=0):
    drawable = GradientDrawable()
    drawable.setColor(fill_color)
    drawable.setCornerRadius(float(dp(radius_dp)))
    if stroke_dp > 0:
        drawable.setStroke(dp(stroke_dp), stroke_color)
    return drawable


def get_tg_drawable(ctx, name, tint=None):
    try:
        res_id = ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName())
        if res_id != 0:
            d = ctx.getDrawable(res_id)
            if d is not None:
                d = d.mutate()
                if tint is not None:
                    d.setColorFilter(PorterDuffColorFilter(tint, PorterDuffMode.SRC_IN))
                return d
    except Exception:
        pass
    return None


def _get_class_meta(v):
    cls = v.getClass()
    cid = int(cls.hashCode())
    meta = _CLASS_META_CACHE.get(cid)
    if meta is not None:
        return meta

    cls_name = str(cls.getSimpleName() or "")
    cls_full = str(cls.getName() or "")
    cls_short = cls_full.split(".")[-1].split("$")[-1] if cls_full else cls_name

    is_bad = False
    for bad in _BAD_CONTAINERS:
        if bad in cls_name or bad in cls_full:
            is_bad = True
            break

    is_vg = isinstance(v, ViewGroup)
    is_menu_item = ("ActionBarMenuItem" in cls_name) or ("ActionBarMenuItem" in cls_full)
    is_avatar_container = "ChatAvatarContainer" in cls_name
    is_enter_view = "ChatActivityEnterView" in cls_name
    is_action_bar = ("ActionBar" in cls_name) and ("Menu" not in cls_name) and ("Layout" not in cls_name)
    is_recycler = ("RecyclerListView" in cls_name) or ("RecyclerView" in cls_name) or ("RecyclerListView" in cls_full)
    is_image_or_lottie = ("ImageView" in cls_name) or ("RLottie" in cls_name) or ("BackupImage" in cls_name)
    is_frame_or_linear = ("FrameLayout" in cls_name) or ("LinearLayout" in cls_name)
    is_cell = ("Cell" in cls_name) or ("Cell" in cls_full)
    is_text_or_edit = ("TextView" in cls_name) or ("EditText" in cls_name) or ("SimpleTextView" in cls_name)
    is_context_or_bar = ("FragmentContextView" in cls_name) or ("FilterTabsView" in cls_name) or ("TopPanel" in cls_name) or ("Pinned" in cls_name)

    meta = (
        cls_name,
        cls_full,
        cls_short,
        is_bad,
        is_vg,
        is_menu_item,
        is_avatar_container,
        is_enter_view,
        is_action_bar,
        is_recycler,
        is_image_or_lottie,
        is_frame_or_linear,
        is_cell,
        is_text_or_edit,
        is_context_or_bar
    )
    if len(_CLASS_META_CACHE) > 2048:
        _CLASS_META_CACHE.clear()
    _CLASS_META_CACHE[cid] = meta
    return meta


def _get_res_id_name(view, vid):
    if vid <= 0:
        return ""
    cached = _RES_NAME_CACHE.get(vid)
    if cached is not None:
        return cached
    name = ""
    try:
        res = view.getResources()
        if res is not None:
            name = str(res.getResourceEntryName(vid) or "")
    except Exception:
        name = ""
    if len(_RES_NAME_CACHE) > 4096:
        _RES_NAME_CACHE.clear()
    _RES_NAME_CACHE[vid] = name
    return name


class ClickProxy(dynamic_proxy(OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        if self.fn:
            self.fn(v)


class TouchProxy(dynamic_proxy(OnTouchListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onTouch(self, v, event):
        if self.fn:
            return bool(self.fn(v, event))
        return False


class LayoutProxy(dynamic_proxy(OnGlobalLayoutListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onGlobalLayout(self):
        if self.fn:
            self.fn()


class RunnableProxy(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        if self.fn:
            self.fn()

# hzzz guard | т.к. мои плагины часто заражают вирусами, я сделал защиту от вредоносной модификации кода. анализирует себя перед запуском и не запускает код при обнаружении
_HZZZ_POPUP_VIEW = None
_HZZZ_POPUP_ACTIVE = False
_HZZZ_DRAG_PROXY = None
_HZZZ_PLUGIN_FILE = __file__ if "__file__" in dir() else ""
try:
    BasePlugin.__init_subclass__ = object.__init_subclass__
except Exception:
    pass


def _hzzz_get_current_activity():
    frag = get_last_fragment()
    if frag is not None:
        act = frag.getParentActivity()
        if act is not None:
            return act
    try:
        if LaunchActivity is not None and hasattr(LaunchActivity, "instance") and LaunchActivity.instance is not None:
            return LaunchActivity.instance
    except Exception:
        pass
    return None


def hide_hzzz_guard_popup():
    global _HZZZ_POPUP_ACTIVE, _HZZZ_POPUP_VIEW
    _HZZZ_POPUP_ACTIVE = False

    def _remove_on_ui():
        global _HZZZ_POPUP_VIEW
        try:
            if _HZZZ_POPUP_VIEW is not None:
                parent = _HZZZ_POPUP_VIEW.getParent()
                if parent is not None:
                    parent.removeView(_HZZZ_POPUP_VIEW)
                _HZZZ_POPUP_VIEW = None

            act = _hzzz_get_current_activity()
            if act is not None and act.getWindow() is not None:
                decor = act.getWindow().getDecorView()
                if isinstance(decor, ViewGroup):
                    for i in range(int(decor.getChildCount()) - 1, -1, -1):
                        ch = decor.getChildAt(i)
                        if ch is None:
                            continue
                        tag = str(ch.getTag() or "") if ch.getTag() is not None else ""
                        if tag in ("HZZZ_GUARD_POPUP", "HZZZ_GUARD_ALERT", "UZQ_ANTIRAT_CARD"):
                            decor.removeView(ch)
                        elif isinstance(ch, LinearLayout) and int(ch.getChildCount()) == 1:
                            sub = ch.getChildAt(0)
                            if isinstance(sub, TextView) and "тебе ОЧЕНЬ повезло" in str(sub.getText() or ""):
                                ch.removeAllViews()
                                ch.setVisibility(View.GONE)
                                decor.removeView(ch)
        except Exception:
            pass

    run_on_ui_thread(_remove_on_ui)


def show_hzzz_guard_popup(reason_text):
    global _HZZZ_POPUP_ACTIVE
    _HZZZ_POPUP_ACTIVE = True

    def _attach_on_ui():
        global _HZZZ_POPUP_VIEW, _HZZZ_DRAG_PROXY
        if not _HZZZ_POPUP_ACTIVE:
            return
        try:
            act = _hzzz_get_current_activity()
            if act is None or act.getWindow() is None:
                run_on_ui_thread(_attach_on_ui, 500)
                return

            decor = act.getWindow().getDecorView()
            if decor is None:
                run_on_ui_thread(_attach_on_ui, 500)
                return

            if _HZZZ_POPUP_VIEW is None or _HZZZ_POPUP_VIEW.getContext() != act:
                card = LinearLayout(act)
                card.setTag("HZZZ_GUARD_POPUP")
                card.setOrientation(LinearLayout.VERTICAL)
                card.setPadding(dp(18), dp(18), dp(18), dp(18))
                card.setBackground(make_bg(COLOR_BG_DARK, 16, COLOR_DANGER, 2))
                card.setElevation(float(dp(20)))

                tv = TextView(act)
                tv.setText(
                    "тебе ОЧЕНЬ повезло, этот плагин был заражен раткой \n"
                    "вредоносный код возможно запущен, проверь сессии и желательно  переустанови клиент \n"
                    "чтобы убрать это окно, отключи плагин. также можешь написать в чат канала @uzuqo и сказать откуда был скачан вредонос \n"
                    "прична срабатывания: " + str(reason_text)
                )
                tv.setTextColor(COLOR_WHITE)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
                tv.setTypeface(Typeface.DEFAULT_BOLD)
                card.addView(tv)

                drag_offset = [0.0, 0.0]

                def _on_touch(v, ev):
                    act_masked = ev.getActionMasked()
                    if act_masked == MotionEvent.ACTION_DOWN:
                        drag_offset[0] = card.getTranslationX() - ev.getRawX()
                        drag_offset[1] = card.getTranslationY() - ev.getRawY()
                        return True
                    if act_masked == MotionEvent.ACTION_MOVE:
                        nx = ev.getRawX() + drag_offset[0]
                        ny = ev.getRawY() + drag_offset[1]
                        parent = card.getParent()
                        if parent is not None:
                            pw, ph = parent.getWidth(), parent.getHeight()
                            vw, vh = card.getWidth(), card.getHeight()
                            if pw > 0 and vw > 0:
                                lx = max(0.0, float(pw - vw) / 2.0)
                                nx = max(-lx, min(lx, nx))
                            if ph > 0 and vh > 0:
                                ly = max(0.0, float(ph - vh) / 2.0)
                                ny = max(-ly, min(ly, ny))
                        card.setTranslationX(float(nx))
                        card.setTranslationY(float(ny))
                        return True
                    return True

                _HZZZ_DRAG_PROXY = TouchProxy(_on_touch)
                card.setOnTouchListener(_HZZZ_DRAG_PROXY)
                _HZZZ_POPUP_VIEW = card

            if _HZZZ_POPUP_VIEW.getParent() is None:
                lp = FrameLayoutParams(dp(310), FrameLayoutParams.WRAP_CONTENT, Gravity.CENTER)
                decor.addView(_HZZZ_POPUP_VIEW, lp)
            else:
                _HZZZ_POPUP_VIEW.setVisibility(View.VISIBLE)
                _HZZZ_POPUP_VIEW.bringToFront()
        except Exception:
            pass

    run_on_ui_thread(_attach_on_ui)


def hzzz_guard_scan():
    import ast
    import re as _re_guard

    if not _HZZZ_PLUGIN_FILE or not os.path.exists(_HZZZ_PLUGIN_FILE):
        return ""
    try:
        with open(_HZZZ_PLUGIN_FILE, "r", encoding="utf-8", errors="ignore") as f:
            source_code = f.read()
        tree = ast.parse(source_code)
    except Exception:
        return ""

    guard_funcs = {
        "_hzzz_get_current_activity",
        "hide_hzzz_guard_popup",
        "show_hzzz_guard_popup",
        "hzzz_guard_scan",
    }
    allowed_top_names = guard_funcs | {
        "_get_density",
        "dp",
        "px_to_dp",
        "make_bg",
        "get_tg_drawable",
        "_get_class_meta",
        "_get_res_id_name",
        "ClickProxy",
        "TouchProxy",
        "LayoutProxy",
        "RunnableProxy",
        "EditModePlugin",
    }

    blocked_imports = {
        "base64": "Base64 encoding",
        "zlib": "Zlib compression",
        "marshal": "Marshal bytecode",
        "lzma": "LZMA compression",
        "bz2": "BZ2 compression",
        "gzip": "Gzip compression",
        "pickle": "Pickle serialization",
        "binascii": "Hex/Binascii encoding",
        "codecs": "Codecs/ROT13 encoding",
        "hashlib": "Hash/Crypto payload",
        "hmac": "HMAC payload",
        "subprocess": "Subprocess shell",
        "socket": "Socket networking",
        "ssl": "SSL networking",
        "ctypes": "Ctypes native code",
        "importlib": "Dynamic importlib",
        "builtins": "Builtins override",
        "requests": "HTTP requests lib",
        "urllib": "Urllib networking",
        "http": "HTTP client",
        "ftplib": "FTP networking",
        "telnetlib": "Telnet networking",
        "paramiko": "SSH paramiko",
        "crypto": "Crypto payload",
        "Cryptodome": "Crypto payload",
        "nacl": "Crypto nacl",
        "pycryptodome": "Crypto payload",
    }
    blocked_calls = {
        "exec": "Dynamic execution (exec)",
        "eval": "Dynamic execution (eval)",
        "compile": "Dynamic compilation (compile)",
        "__import__": "Dynamic import (__import__)",
        "b64decode": "Base64 decode",
        "b64encode": "Base64 encode",
        "b85decode": "Base85 decode",
        "b85encode": "Base85 encode",
        "a85decode": "Ascii85 decode",
        "decompress": "Compressed payload (decompress)",
        "compress": "Compressed payload (compress)",
        "fromhex": "Hex decode (fromhex)",
        "unhexlify": "Hex decode (unhexlify)",
        "hexlify": "Hex encode (hexlify)",
        "system": "OS system call",
        "popen": "OS popen",
        "Popen": "Subprocess Popen",
    }

    suspicious_alias_re = _re_guard.compile(r"^_?[a-zA-Z]?\d*$|^_+$|^[a-z]{1,3}$|^_b\d*$|^b64|^_b64|^zlib|^_z|^_m|^_p|^_c")

    skip_ranges = []
    for top_node in tree.body:
        if isinstance(top_node, ast.FunctionDef) and top_node.name in guard_funcs:
            end_ln = getattr(top_node, "end_lineno", top_node.lineno + 200) or (top_node.lineno + 200)
            skip_ranges.append((top_node.lineno, end_ln))
        if isinstance(top_node, ast.Try):
            try:
                for h in getattr(top_node, "body", []):
                    if isinstance(h, ast.Assign):
                        for t in h.targets:
                            if isinstance(t, ast.Attribute) and "BasePlugin" in str(getattr(t, "value", "")):
                                end_ln = getattr(top_node, "end_lineno", top_node.lineno + 5) or (top_node.lineno + 5)
                                skip_ranges.append((top_node.lineno, end_ln))
                                break
            except Exception:
                pass

    def is_skipped(ln):
        return any(s <= ln <= e for s, e in skip_ranges)

    hex_strings = []
    b64_strings = []
    aliased_blocked = []
    suspicious_names = set()

    for node in ast.walk(tree):
        ln = getattr(node, "lineno", 0)
        if not ln or is_skipped(ln):
            continue

        if isinstance(node, (ast.Import, ast.ImportFrom)):
            mod_root = (getattr(node, "module", "") or "").split(".")[0]
            for alias in node.names:
                name_root = alias.name.split(".")[0]
                pkg = mod_root or name_root
                asname = alias.asname or ""
                if pkg in blocked_imports:
                    if asname:
                        return (
                            f"Line {ln}: Obfuscated import {pkg} as {asname} "
                            f"({blocked_imports[pkg]})"
                        )
                    return f"Line {ln}: {blocked_imports[pkg]} (import {pkg})"
                if name_root in blocked_calls or name_root in (
                    "b64decode", "b64encode", "decompress", "unhexlify", "fromhex",
                    "loads", "exec", "eval", "compile", "__import__"
                ):
                    if asname:
                        return f"Line {ln}: Obfuscated from-import {name_root} as {asname}"
                    return f"Line {ln}: Blocked from-import ({name_root})"
                if asname and (asname.startswith("_") or suspicious_alias_re.match(asname)):
                    aliased_blocked.append((ln, f"suspicious alias {pkg or name_root} as {asname}"))
                    suspicious_names.add(asname)

        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name):
                    tid = target.id
                    if isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):
                        val = node.value.value
                        if len(val) >= 24 and all(c in "0123456789abcdefABCDEF" for c in val):
                            hex_strings.append((ln, tid))
                            if tid.startswith("_"):
                                return f"Line {ln}: Hex-encoded payload ({tid})"
                        if (
                            len(val) >= 32
                            and _re_guard.fullmatch(r"[A-Za-z0-9+/=_-]+", val)
                            and (val.count("=") <= 2 or "+" in val or "/" in val)
                        ):
                            b64_strings.append((ln, tid))
                            if tid.startswith("_") or tid in suspicious_names:
                                return f"Line {ln}: Base64-like payload ({tid})"
                    if isinstance(node.value, ast.Attribute):
                        attr = node.value.attr
                        if attr in blocked_calls:
                            return f"Line {ln}: Aliased dangerous attr ({attr} -> {tid})"
                    if isinstance(node.value, ast.Name) and node.value.id in blocked_calls:
                        return f"Line {ln}: Aliased dangerous name ({node.value.id} -> {tid})"

        if isinstance(node, ast.Call):
            fn = ""
            if isinstance(node.func, ast.Name):
                fn = node.func.id
            elif isinstance(node.func, ast.Attribute):
                fn = node.func.attr
                if isinstance(node.func.value, ast.Name):
                    base = node.func.value.id
                    if base in suspicious_names or (base.startswith("_") and len(base) <= 4):
                        if fn in blocked_calls or fn in ("decode", "encode", "loads", "load"):
                            return f"Line {ln}: Obfuscated call {base}.{fn}"
            if fn in blocked_calls:
                return f"Line {ln}: {blocked_calls[fn]}"
            if fn == "getattr" and len(node.args) >= 2:
                arg1 = node.args[1]
                if isinstance(arg1, ast.Constant) and isinstance(arg1.value, str):
                    if arg1.value in blocked_calls or arg1.value in ("exec", "eval", "open", "__import__"):
                        return f"Line {ln}: Dynamic getattr('{arg1.value}')"

        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            val = node.value
            if (
                len(val) >= 48
                and _re_guard.fullmatch(r"[A-Za-z0-9+/=_-]{48,}", val)
                and not any(c in val for c in " \n\t█▓▒░▄▀")
            ):
                b64_strings.append((ln, "<inline>"))

    if aliased_blocked and (hex_strings or b64_strings):
        return (
            f"Line {aliased_blocked[0][0]}: Obfuscated alias + payload "
            f"({aliased_blocked[0][1]})"
        )
    if len(hex_strings) >= 2:
        return f"Line {hex_strings[0][0]}: Hex-encoded RAT payload ({hex_strings[0][1]})"
    if len(b64_strings) >= 2:
        return f"Line {b64_strings[0][0]}: Base64-encoded RAT payload"

    for top_node in tree.body:
        ln = getattr(top_node, "lineno", 0)
        if is_skipped(ln):
            continue
        if isinstance(top_node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            if top_node.name not in allowed_top_names:
                return f"Line {ln}: Injected function/class ({top_node.name})"

    return ""


_HZZZ_GUARD_REASON = hzzz_guard_scan()
if _HZZZ_GUARD_REASON:
    raise RuntimeError(
        "HZZZ Guard: malware detected - plugin load aborted. Reason: "
        + str(_HZZZ_GUARD_REASON)
    )



class EditModePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.rules = {}
        self._active_global_rules = {}
        self._active_local_rules = {}
        self._resolved_Rule_views = {}
        self._sem_key_cache = {}
        self.history_stack = []
        self.original_states = {}
        self.edit_mode_active = False
        self.inspect_mode = False
        self.move_drag_mode = False
        self.menu_expanded = False
        self.overlay_root = None
        self.attached_decor = None
        self.layout_listener = None
        self.running = False
        self.selected_view = None
        self.highlight_views_pool = []
        self._highlight_box_states = []
        self.drag_start_raw_x = 0.0
        self.drag_start_raw_y = 0.0
        self.view_start_tx = 0.0
        self.view_start_ty = 0.0
        self.fab_x = -1
        self.fab_y = -1
        self._core_refs = []
        self.refs = []
        self.toast_view = None
        self.toast_handler = None
        self.toast_hide_runnable = None

        self._loc_buf1 = jarray(jint)([0, 0])
        self._loc_buf2 = jarray(jint)([0, 0])

        self._in_apply = False
        self._layout_pending = False
        self._last_layout_ts = 0.0
        self._layout_debounce_runnable = None

        self._save_lock = threading.Lock()
        self._save_pending_runnable = None

        self._bg_move_inactive = None
        self._bg_move_active = None
        self._bg_fab_inspect = None
        self._bg_fab_normal = None
        self._bg_toast_ok = None
        self._bg_toast_err = None

        self._shimmer_phase = 0.0
        self._shimmer_running = False
        self._shimmer_runnable = None
        self._shimmer_last_ts = 0.0
        self._last_wave_scan_ts = 0.0
        self._menu_animating = False
        self._toast_animating = False
        self._welcome_shown = False

        # layer diving under overlapping elements (tap again to go deeper)
        self._tap_candidates = []
        self._tap_idx = 0
        self._last_tap_x = -9999.0
        self._last_tap_y = -9999.0
        # temporary clipChildren=false while dragging so translated views aren't clipped
        self._clip_restore = []
        self._drag_base_vx = 0
        self._drag_base_vy = 0
        self._drag_vw = 0
        self._drag_vh = 0
        self._drag_screen_w = 0
        self._drag_screen_h = 0

    def _keep_core(self, obj):
        self._core_refs.append(obj)
        return obj

    def _keep(self, obj):
        self.refs.append(obj)
        if len(self.refs) > 300:
            self.refs = self.refs[-150:]
        return obj

    def _rebuild_rule_indices(self):
        global_r = {}
        local_r = {}
        for sig, rule in self.rules.items():
            if not rule.get("enabled", True):
                continue
            tx_px = float(dp(float(rule.get("tx_dp", 0.0))))
            ty_px = float(dp(float(rule.get("ty_dp", 0.0))))
            mode = rule.get("mode", "gone")
            if mode == "gone":
                target_vis = View.GONE
            elif mode == "invisible":
                target_vis = View.INVISIBLE
            else:
                target_vis = View.VISIBLE

            compiled = (rule, target_vis, tx_px, ty_px, rule.get("path", ""))
            if rule.get("is_global", False) or sig.startswith("global:"):
                global_r[sig] = compiled
            else:
                local_r[sig] = compiled

        self._active_global_rules = global_r
        self._active_local_rules = local_r

    def _storage_path(self):
        ctx = ApplicationLoader.applicationContext
        files_dir = ctx.getFilesDir().getAbsolutePath()
        return os.path.join(files_dir, "edit_mode_rules.json")

    def _load_data(self):
        path = self._storage_path()
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.rules = data.get("rules", {})
                self.fab_x = int(data.get("fab_x", -1))
                self.fab_y = int(data.get("fab_y", -1))
                self._rebuild_rule_indices()
                return
            except Exception:
                pass
        raw_setting = self.get_setting("rules_backup_json", "")
        if raw_setting:
            try:
                data = json.loads(raw_setting)
                self.rules = data.get("rules", {})
            except Exception:
                self.rules = {}
        self._rebuild_rule_indices()

    def _reload_settings_ui(self):
        def _do():
            try:
                self.set_setting("edit_mode_active", bool(self.edit_mode_active), reload_settings=True)
                self.set_setting("_ui_sync_ts", int(time.time() * 1000), reload_settings=True)
            except Exception:
                pass
        run_on_ui_thread(_do)

    def _save_data(self, immediate=False):
        self._rebuild_rule_indices()
        if immediate or self.toast_handler is None:
            self._flush_save_async()
            return
        if self._save_pending_runnable is not None:
            try:
                self.toast_handler.removeCallbacks(self._save_pending_runnable)
            except Exception:
                pass
        else:
            self._save_pending_runnable = self._keep_core(RunnableProxy(self._flush_save_async))
        try:
            self.toast_handler.postDelayed(self._save_pending_runnable, 250)
        except Exception:
            self._flush_save_async()

    def _flush_save_async(self):
        payload = {
            "rules": dict(self.rules),
            "fab_x": self.fab_x,
            "fab_y": self.fab_y,
            "updated_at": int(time.time())
        }
        raw = json.dumps(payload, ensure_ascii=False)
        try:
            self.set_setting("rules_backup_json", raw, reload_settings=True)
        except Exception:
            pass
        path = self._storage_path()

        def _writer():
            with self._save_lock:
                try:
                    with open(path, "w", encoding="utf-8") as f:
                        f.write(raw)
                except Exception:
                    pass

        try:
            threading.Thread(target=_writer, daemon=True).start()
        except Exception:
            _writer()

    def on_plugin_load(self):
        if _HZZZ_GUARD_REASON:
            self.running = False
            show_hzzz_guard_popup(_HZZZ_GUARD_REASON)
            return
        hide_hzzz_guard_popup()
        self._load_data()
        self.edit_mode_active = bool(self.get_setting("edit_mode_active", False))
        self.running = True
        run_on_ui_thread(self._start_engine)

    def on_plugin_unload(self):
        hide_hzzz_guard_popup()
        if _HZZZ_GUARD_REASON:
            self.running = False
            return
        self.running = False
        self._flush_save_async()
        run_on_ui_thread(self._stop_engine)

    def _get_activity(self):
        frag = get_last_fragment()
        if frag is not None:
            act = frag.getParentActivity()
            if act is not None:
                return act
        try:
            if LaunchActivity is not None and hasattr(LaunchActivity, "instance") and LaunchActivity.instance is not None:
                return LaunchActivity.instance
        except Exception:
            pass
        return None

    def _start_engine(self):
        self._ensure_overlay()
        self._apply_all_rules()

    def _stop_engine(self):
        self._stop_shimmer()
        self._restore_all_views()
        self._detach_overlay()
        self._sem_key_cache.clear()
        self._resolved_Rule_views.clear()

    def _detach_overlay(self):
        if self.attached_decor is not None and self.layout_listener is not None:
            try:
                vto = self.attached_decor.getViewTreeObserver()
                if vto is not None and vto.isAlive():
                    vto.removeOnGlobalLayoutListener(self.layout_listener)
            except Exception:
                pass
        self.layout_listener = None

        if self.toast_handler is not None:
            if self.toast_hide_runnable is not None:
                try:
                    self.toast_handler.removeCallbacks(self.toast_hide_runnable)
                except Exception:
                    pass
            if self._layout_debounce_runnable is not None:
                try:
                    self.toast_handler.removeCallbacks(self._layout_debounce_runnable)
                except Exception:
                    pass
            if self._shimmer_runnable is not None:
                try:
                    self.toast_handler.removeCallbacks(self._shimmer_runnable)
                except Exception:
                    pass

        if self.overlay_root is not None:
            try:
                parent = self.overlay_root.getParent()
                if parent is not None:
                    parent.removeView(self.overlay_root)
            except Exception:
                pass

        self.overlay_root = None
        self.attached_decor = None
        self.highlight_views_pool = []
        self._highlight_box_states = []
        self.toast_view = None
        self.toast_hide_runnable = None
        self._core_refs.clear()
        self._shimmer_running = False

    def _ensure_overlay(self):
        act = self._get_activity()
        if act is None:
            return
        window = act.getWindow()
        if window is None:
            return
        decor = window.getDecorView()
        if decor is None:
            return
        if self.attached_decor == decor and self.overlay_root is not None:
            if self.overlay_root.getParent() == decor:
                if isinstance(decor, ViewGroup):
                    cnt = decor.getChildCount()
                    if cnt > 1 and decor.getChildAt(cnt - 1) != self.overlay_root:
                        self.overlay_root.bringToFront()
                self._sync_overlay_visibility()
                return
        self._detach_overlay()
        self.attached_decor = decor
        self._sem_key_cache.clear()
        self._resolved_Rule_views.clear()
        self._build_overlay(act, decor)
        try:
            vto = decor.getViewTreeObserver()
            self.layout_listener = self._keep_core(LayoutProxy(self._on_global_layout))
            vto.addOnGlobalLayoutListener(self.layout_listener)
        except Exception:
            pass

    def _on_global_layout(self):
        if not self.running or self._in_apply:
            return
        if not self._active_global_rules and not self._active_local_rules and not self.inspect_mode:
            return

        now = time.monotonic()
        elapsed = now - self._last_layout_ts
        if elapsed < 0.110:
            if not self._layout_pending and self.toast_handler is not None:
                self._layout_pending = True
                if self._layout_debounce_runnable is None:
                    self._layout_debounce_runnable = self._keep_core(RunnableProxy(self._run_debounced_layout))
                delay_ms = max(16, int((0.110 - elapsed) * 1000))
                try:
                    self.toast_handler.postDelayed(self._layout_debounce_runnable, delay_ms)
                except Exception:
                    self._layout_pending = False
            return

        self._last_layout_ts = now
        self._execute_layout_sync()

    def _run_debounced_layout(self):
        self._layout_pending = False
        if not self.running or self._in_apply:
            return
        self._last_layout_ts = time.monotonic()
        self._execute_layout_sync()

    def _execute_layout_sync(self):
        # re-bind overlay if Telegram swapped DecorView (gallery, player, profile…)
        try:
            act = self._get_activity()
            if act is not None and act.getWindow() is not None:
                decor = act.getWindow().getDecorView()
                if decor is not None and decor != self.attached_decor:
                    self._ensure_overlay()
        except Exception:
            pass
        self._in_apply = True
        try:
            if self._active_global_rules or self._active_local_rules:
                self._apply_all_rules()
            if self.inspect_mode and not self.move_drag_mode:
                self._update_all_highlights()
                if self.selected_view is not None:
                    self._update_selection_box()
        finally:
            self._in_apply = False

    def _build_overlay(self, ctx, decor):
        self._bg_move_inactive = make_bg(COLOR_CARD_DARK, 14)
        self._bg_move_active = make_bg(COLOR_VIOLET_BRIGHT, 14)
        self._bg_fab_inspect = make_bg(COLOR_WHITE, 27, COLOR_VIOLET_BRIGHT, 2)
        self._bg_fab_normal = make_bg(COLOR_VIOLET_BRIGHT, 27)
        self._bg_toast_ok = make_bg(COLOR_BG_DARK, 16, COLOR_VIOLET_BRIGHT, 1)
        self._bg_toast_err = make_bg(COLOR_BG_DARK, 16, COLOR_DANGER, 1)

        root = FrameLayout(ctx)
        root.setTag("EDITMODE_OVERLAY_ROOT")
        root.setClickable(False)
        root.setFocusable(False)

        self.boxes_container = FrameLayout(ctx)
        self.boxes_container.setClickable(False)
        self.boxes_container.setFocusable(False)
        self.boxes_container.setVisibility(View.GONE)
        root.addView(self.boxes_container, FrameLayoutParams(FrameLayoutParams.MATCH_PARENT, FrameLayoutParams.MATCH_PARENT))

        self.selection_box = FrameLayout(ctx)
        self.selection_box.setBackground(make_bg(COLOR_VIOLET_FILL, 12, COLOR_VIOLET_BRIGHT, 3))
        self.selection_box.setVisibility(View.GONE)
        self.selection_box.setClickable(False)
        lp_sel = FrameLayoutParams(0, 0)
        lp_sel.gravity = Gravity.TOP | Gravity.LEFT
        self._sel_box_lp = lp_sel
        self._sel_box_state = (-1, -1, -1, -1)
        root.addView(self.selection_box, lp_sel)

        self.touch_layer = FrameLayout(ctx)
        self.touch_layer.setVisibility(View.GONE)
        self.touch_layer.setOnTouchListener(self._keep_core(TouchProxy(self._on_inspector_touch)))
        root.addView(self.touch_layer, FrameLayoutParams(FrameLayoutParams.MATCH_PARENT, FrameLayoutParams.MATCH_PARENT))

        self._build_inspector_controls(ctx, root)
        self._build_fab_menu(ctx, root)
        self._build_fabs(ctx, root)

        decor.addView(root, FrameLayoutParams(FrameLayoutParams.MATCH_PARENT, FrameLayoutParams.MATCH_PARENT))
        self.overlay_root = root
        self._sync_overlay_visibility()

    def _build_inspector_controls(self, ctx, root):
        bar = LinearLayout(ctx)
        bar.setOrientation(LinearLayout.HORIZONTAL)
        bar.setGravity(Gravity.CENTER_VERTICAL)
        bar.setBackground(make_bg(COLOR_BG_DARK, 18, COLOR_CARD_LIGHT, 1))
        bar.setPadding(dp(6), dp(4), dp(6), dp(4))
        bar.setVisibility(View.GONE)
        bar.setAlpha(0.0)

        self.btn_move_pill = TextView(ctx)
        self.btn_move_pill.setText("двигать")
        self.btn_move_pill.setTextColor(COLOR_TEXT_MAIN)
        self.btn_move_pill.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        self.btn_move_pill.setBackground(self._bg_move_inactive)
        self.btn_move_pill.setPadding(dp(12), dp(8), dp(12), dp(8))
        self.btn_move_pill.setOnClickListener(self._keep_core(ClickProxy(lambda v: self._toggle_move_drag())))
        bar.addView(self.btn_move_pill, LinearLayoutParams(LinearLayoutParams.WRAP_CONTENT, LinearLayoutParams.WRAP_CONTENT))

        btn_hide = TextView(ctx)
        btn_hide.setText("скрыть")
        btn_hide.setTextColor(COLOR_WHITE)
        btn_hide.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        btn_hide.setBackground(make_bg(COLOR_VIOLET_BRIGHT, 14))
        btn_hide.setPadding(dp(14), dp(8), dp(14), dp(8))
        lp_hide = LinearLayoutParams(LinearLayoutParams.WRAP_CONTENT, LinearLayoutParams.WRAP_CONTENT)
        lp_hide.leftMargin = dp(6)
        btn_hide.setOnClickListener(self._keep_core(ClickProxy(lambda v: self._hide_selected_element_instant())))
        bar.addView(btn_hide, lp_hide)

        btn_cancel = TextView(ctx)
        btn_cancel.setText("✕")
        btn_cancel.setTextColor(COLOR_TEXT_SUB)
        btn_cancel.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        btn_cancel.setGravity(Gravity.CENTER)
        btn_cancel.setBackground(make_bg(COLOR_CARD_DARK, 14))
        btn_cancel.setPadding(dp(10), dp(8), dp(10), dp(8))
        lp_c = LinearLayoutParams(LinearLayoutParams.WRAP_CONTENT, LinearLayoutParams.WRAP_CONTENT)
        lp_c.leftMargin = dp(6)
        btn_cancel.setOnClickListener(self._keep_core(ClickProxy(lambda v: self._clear_selection())))
        bar.addView(btn_cancel, lp_c)

        self.control_bar = bar
        lp_bar = FrameLayoutParams(FrameLayoutParams.WRAP_CONTENT, FrameLayoutParams.WRAP_CONTENT)
        lp_bar.gravity = Gravity.TOP | Gravity.LEFT
        self._ctrl_bar_lp = lp_bar
        self._ctrl_bar_state = (-1, -1)
        root.addView(bar, lp_bar)

    def _clear_selection(self):
        self._restore_clip_ancestors()
        self.selected_view = None
        self.move_drag_mode = False
        self.btn_move_pill.setText("двигать")
        self.btn_move_pill.setBackground(self._bg_move_inactive)
        if self.selection_box.getVisibility() != View.GONE:
            self.selection_box.setVisibility(View.GONE)
        if self.control_bar.getVisibility() != View.GONE:
            self._animate_hide(self.control_bar)
        self._sel_box_state = (-1, -1, -1, -1)
        self._ctrl_bar_state = (-1, -1)
        self._tap_candidates = []
        self._tap_idx = 0

    def _build_fab_menu(self, ctx, root):
        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setBackground(make_bg(COLOR_BG_DARK, 18, COLOR_CARD_LIGHT, 1))
        card.setPadding(dp(6), dp(6), dp(6), dp(6))
        card.setVisibility(View.GONE)
        card.setAlpha(0.0)
        card.setScaleX(0.92)
        card.setScaleY(0.92)

        self.menu_btn_edit = self._create_svg_popup_item(
            ctx, "msg_edit", COLOR_TEXT_MAIN, "редактировать", "", lambda v: self._enter_inspect_mode()
        )
        card.addView(self.menu_btn_edit)

        self.menu_btn_hidden, self.menu_hidden_badge = self._create_svg_popup_item_with_badge(
            ctx, "msg_view_file", COLOR_TEXT_MAIN, "измененные элементы", str(len(self.rules)), lambda v: self._open_hidden_elements_sheet()
        )
        card.addView(self.menu_btn_hidden)

        self.menu_btn_help = self._create_svg_popup_item(
            ctx, "msg_help", COLOR_TEXT_MAIN, "как работает?", "", lambda v: self._open_help_sheet()
        )
        card.addView(self.menu_btn_help)

        self.menu_btn_exit = self._create_svg_popup_item(
            ctx, "msg_close", COLOR_DANGER, "выйти из режима", "", lambda v: self._exit_edit_mode_completely()
        )
        card.addView(self.menu_btn_exit)

        self.menu_popup = card
        lp = FrameLayoutParams(dp(230), FrameLayoutParams.WRAP_CONTENT)
        lp.gravity = Gravity.BOTTOM | Gravity.RIGHT
        lp.rightMargin = dp(80)
        lp.bottomMargin = dp(100)
        self._menu_popup_lp = lp
        root.addView(card, lp)

    def _create_svg_popup_item(self, ctx, icon_name, icon_tint, title, badge, on_click):
        row, _ = self._create_svg_popup_item_with_badge(ctx, icon_name, icon_tint, title, badge, on_click)
        return row

    def _create_svg_popup_item_with_badge(self, ctx, icon_name, icon_tint, title, badge, on_click):
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(12), dp(10), dp(12), dp(10))

        iv = ImageView(ctx)
        d = get_tg_drawable(ctx, icon_name, icon_tint)
        if d is not None:
            iv.setImageDrawable(d)
        lp_iv = LinearLayoutParams(dp(20), dp(20))
        lp_iv.rightMargin = dp(12)
        row.addView(iv, lp_iv)

        tv = TextView(ctx)
        tv.setText(title)
        tv.setTextColor(icon_tint if icon_tint == COLOR_DANGER else COLOR_TEXT_MAIN)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        lp_tv = LinearLayoutParams(0, LinearLayoutParams.WRAP_CONTENT, 1.0)
        row.addView(tv, lp_tv)

        badge_tv = TextView(ctx)
        badge_tv.setText(badge)
        badge_tv.setTextColor(COLOR_TEXT_SUB)
        badge_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        row.addView(badge_tv, LinearLayoutParams(LinearLayoutParams.WRAP_CONTENT, LinearLayoutParams.WRAP_CONTENT))

        row.setOnClickListener(self._keep_core(ClickProxy(on_click)))
        return row, badge_tv

    def _build_fabs(self, ctx, root):
        undo_wrap = FrameLayout(ctx)
        undo_wrap.setBackground(make_bg(COLOR_WHITE, 24, COLOR_VIOLET_BRIGHT, 1))
        self.undo_fab_text = TextView(ctx)
        self.undo_fab_text.setText("↺")
        self.undo_fab_text.setTextColor(COLOR_VIOLET_BRIGHT)
        self.undo_fab_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
        self.undo_fab_text.setTypeface(Typeface.DEFAULT_BOLD)
        self.undo_fab_text.setGravity(Gravity.CENTER)
        undo_wrap.addView(self.undo_fab_text, FrameLayoutParams(FrameLayoutParams.MATCH_PARENT, FrameLayoutParams.MATCH_PARENT))
        undo_wrap.setVisibility(View.GONE)
        undo_wrap.setAlpha(0.0)
        undo_wrap.setOnClickListener(self._keep_core(ClickProxy(lambda v: self._undo_last_rule())))
        lp_undo = FrameLayoutParams(dp(48), dp(48))
        lp_undo.gravity = Gravity.BOTTOM | Gravity.RIGHT
        lp_undo.rightMargin = dp(20)
        lp_undo.bottomMargin = dp(165)
        self._undo_fab_lp = lp_undo
        self.undo_fab = undo_wrap
        root.addView(undo_wrap, lp_undo)

        fab_wrap = FrameLayout(ctx)
        fab_wrap.setBackground(self._bg_fab_normal)
        self.main_fab_text = TextView(ctx)
        self.main_fab_text.setText("✎")
        self.main_fab_text.setTextColor(COLOR_WHITE)
        self.main_fab_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
        self.main_fab_text.setTypeface(Typeface.DEFAULT_BOLD)
        self.main_fab_text.setGravity(Gravity.CENTER)
        fab_wrap.addView(self.main_fab_text, FrameLayoutParams(FrameLayoutParams.MATCH_PARENT, FrameLayoutParams.MATCH_PARENT))

        lp_fab = FrameLayoutParams(dp(54), dp(54))
        if self.fab_x >= 0 and self.fab_y >= 0:
            lp_fab.gravity = Gravity.TOP | Gravity.LEFT
            lp_fab.leftMargin = self.fab_x
            lp_fab.topMargin = self.fab_y
        else:
            lp_fab.gravity = Gravity.BOTTOM | Gravity.RIGHT
            lp_fab.rightMargin = dp(18)
            lp_fab.bottomMargin = dp(100)
        self._main_fab_lp = lp_fab
        fab_wrap.setOnTouchListener(self._keep_core(TouchProxy(self._on_fab_touch)))
        self.main_fab = fab_wrap
        root.addView(fab_wrap, lp_fab)

        toast = TextView(ctx)
        toast.setTextColor(COLOR_TEXT_MAIN)
        toast.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        toast.setGravity(Gravity.CENTER)
        toast.setPadding(dp(14), dp(10), dp(14), dp(10))
        toast.setBackground(self._bg_toast_ok)
        toast.setVisibility(View.GONE)
        toast.setAlpha(0.0)
        toast.setScaleX(0.9)
        toast.setScaleY(0.9)
        lp_toast = FrameLayoutParams(FrameLayoutParams.WRAP_CONTENT, FrameLayoutParams.WRAP_CONTENT)
        lp_toast.gravity = Gravity.TOP | Gravity.LEFT
        self._toast_lp = lp_toast
        root.addView(toast, lp_toast)
        self.toast_view = toast
        try:
            self.toast_handler = Handler(Looper.getMainLooper())
        except Exception:
            self.toast_handler = None

    def _animate_show(self, view, duration=200):
        if view is None:
            return
        try:
            view.animate().cancel()
            if view.getVisibility() != View.VISIBLE:
                view.setAlpha(0.0)
                view.setScaleX(0.92)
                view.setScaleY(0.92)
                view.setVisibility(View.VISIBLE)
            view.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(duration).setInterpolator(_EASE).start()
        except Exception:
            view.setAlpha(1.0)
            view.setScaleX(1.0)
            view.setScaleY(1.0)
            view.setVisibility(View.VISIBLE)

    def _animate_hide(self, view, duration=180, then_gone=True):
        if view is None:
            return
        try:
            view.animate().cancel()
            def _end():
                if then_gone and view.getAlpha() < 0.05:
                    view.setVisibility(View.GONE)
                    view.setAlpha(0.0)
                    view.setScaleX(0.92)
                    view.setScaleY(0.92)
            view.animate().alpha(0.0).scaleX(0.92).scaleY(0.92).setDuration(duration).setInterpolator(_EASE).withEndAction(RunnableProxy(_end)).start()
        except Exception:
            view.setVisibility(View.GONE)
            view.setAlpha(0.0)

    def _on_fab_touch(self, v, event):
        action = event.getActionMasked()
        raw_x = float(event.getRawX())
        raw_y = float(event.getRawY())
        if action == MotionEvent.ACTION_DOWN:
            self.fab_down_x = raw_x
            self.fab_down_y = raw_y
            self.fab_moved = False
            v.getLocationOnScreen(self._loc_buf1)
            self.overlay_root.getLocationOnScreen(self._loc_buf2)
            self.fab_orig_x = int(self._loc_buf1[0])
            self.fab_orig_y = int(self._loc_buf1[1])
            self._fab_decor_ox = int(self._loc_buf2[0])
            self._fab_decor_oy = int(self._loc_buf2[1])
            self._fab_max_x = max(0, int(self.overlay_root.getWidth()) - dp(58))
            self._fab_max_y = max(0, int(self.overlay_root.getHeight()) - dp(58))
            return True
        elif action == MotionEvent.ACTION_MOVE:
            dx = raw_x - self.fab_down_x
            dy = raw_y - self.fab_down_y
            if self.fab_moved or abs(dx) > dp(8) or abs(dy) > dp(8):
                self.fab_moved = True
                nx = int(self.fab_orig_x + dx - self._fab_decor_ox)
                ny = int(self.fab_orig_y + dy - self._fab_decor_oy)
                nx = max(dp(6), min(nx, self._fab_max_x))
                ny = max(dp(32), min(ny, self._fab_max_y))
                if nx != self.fab_x or ny != self.fab_y:
                    self.fab_x = nx
                    self.fab_y = ny
                    lp = self._main_fab_lp
                    lp.gravity = Gravity.TOP | Gravity.LEFT
                    lp.leftMargin = nx
                    lp.topMargin = ny
                    lp.rightMargin = 0
                    lp.bottomMargin = 0
                    v.requestLayout()
                    self._reposition_popup_near_fab(nx, ny)
            return True
        elif action == MotionEvent.ACTION_UP:
            if self.fab_moved:
                self._save_data()
            else:
                self._on_fab_clicked()
            return True
        return False

    def _reposition_popup_near_fab(self, fx=None, fy=None):
        if self.menu_popup is None or self.main_fab is None or self.overlay_root is None:
            return
        if fx is None or fy is None:
            self.main_fab.getLocationOnScreen(self._loc_buf1)
            self.overlay_root.getLocationOnScreen(self._loc_buf2)
            fx = int(self._loc_buf1[0] - self._loc_buf2[0])
            fy = int(self._loc_buf1[1] - self._loc_buf2[1])

        root_w = int(self.overlay_root.getWidth())
        root_h = int(self.overlay_root.getHeight())
        pw = dp(230)
        ph = dp(180)
        px = fx - pw - dp(8)
        if px < dp(10):
            px = min(fx + dp(62), max(dp(10), root_w - pw - dp(10)))
        py = max(dp(40), min(fy - ph + dp(54), root_h - ph - dp(16)))

        lp = self._menu_popup_lp
        lp.gravity = Gravity.TOP | Gravity.LEFT
        lp.leftMargin = int(px)
        lp.topMargin = int(py)
        lp.rightMargin = 0
        lp.bottomMargin = 0
        if self.menu_popup.getVisibility() == View.VISIBLE:
            self.menu_popup.requestLayout()

        lp_u = self._undo_fab_lp
        lp_u.gravity = Gravity.TOP | Gravity.LEFT
        lp_u.leftMargin = int(fx + dp(3))
        lp_u.topMargin = int(max(dp(36), fy - dp(56)))
        lp_u.rightMargin = 0
        lp_u.bottomMargin = 0
        if self.undo_fab.getVisibility() == View.VISIBLE:
            self.undo_fab.requestLayout()

        self._reposition_toast_near_fab(fx, fy)

    def _reposition_toast_near_fab(self, fx=None, fy=None):
        if self.toast_view is None or self.main_fab is None or self.overlay_root is None:
            return
        if self.toast_view.getVisibility() != View.VISIBLE:
            return
        if fx is None or fy is None:
            self.main_fab.getLocationOnScreen(self._loc_buf1)
            self.overlay_root.getLocationOnScreen(self._loc_buf2)
            fx = int(self._loc_buf1[0] - self._loc_buf2[0])
            fy = int(self._loc_buf1[1] - self._loc_buf2[1])

        tw = getattr(self, "_last_toast_w", dp(140))
        th = getattr(self, "_last_toast_h", dp(40))
        px = fx - tw - dp(10)
        if px < dp(8):
            px = fx + dp(58)
        py = fy + (dp(54) - th) // 2
        max_x = max(0, int(self.overlay_root.getWidth()) - tw - dp(8))
        max_y = max(0, int(self.overlay_root.getHeight()) - th - dp(8))
        px = max(dp(8), min(int(px), max_x))
        py = max(dp(32), min(int(py), max_y))

        lp = self._toast_lp
        lp.gravity = Gravity.TOP | Gravity.LEFT
        lp.leftMargin = px
        lp.topMargin = py
        self.toast_view.requestLayout()

    def _show_toast(self, text, is_error=False):
        if self.toast_view is None or self.overlay_root is None:
            self._ensure_overlay()
        if self.toast_view is None or self.overlay_root is None:
            return
        if self.toast_handler is not None and self.toast_hide_runnable is not None:
            try:
                self.toast_handler.removeCallbacks(self.toast_hide_runnable)
            except Exception:
                pass
        self.toast_view.setText(str(text))
        if is_error:
            self.toast_view.setBackground(self._bg_toast_err)
            self.toast_view.setTextColor(COLOR_DANGER)
        else:
            self.toast_view.setBackground(self._bg_toast_ok)
            self.toast_view.setTextColor(COLOR_TEXT_MAIN)

        try:
            self.toast_view.measure(0, 0)
            self._last_toast_w = int(self.toast_view.getMeasuredWidth())
            self._last_toast_h = int(self.toast_view.getMeasuredHeight())
        except Exception:
            self._last_toast_w = dp(140)
            self._last_toast_h = dp(40)

        self._reposition_toast_near_fab()
        self._animate_show(self.toast_view, 200)

        def hide():
            self._animate_hide(self.toast_view, 180)

        if self.toast_hide_runnable is None:
            self.toast_hide_runnable = self._keep_core(RunnableProxy(hide))
        if self.toast_handler is not None:
            try:
                self.toast_handler.postDelayed(self.toast_hide_runnable, 2200)
            except Exception:
                pass

    def _on_fab_clicked(self):
        if self.inspect_mode:
            self._exit_inspect_mode()
            return
        self.menu_expanded = not self.menu_expanded
        self._sync_overlay_visibility()

    def _enter_inspect_mode(self):
        self._ensure_overlay()
        self.edit_mode_active = True
        self.menu_expanded = False
        self.inspect_mode = True
        self.move_drag_mode = False
        self.selected_view = None
        self.set_setting("edit_mode_active", True, reload_settings=True)
        self._reload_settings_ui()
        self._sync_overlay_visibility()
        self._update_all_highlights()
        self._start_shimmer()
        self._show_toast("режим редактирования")

    def _exit_inspect_mode(self):
        self.inspect_mode = False
        self.move_drag_mode = False
        self._stop_shimmer()
        self._clear_selection()
        self._sync_overlay_visibility()
        self._reload_settings_ui()

    def _exit_edit_mode_completely(self):
        self.menu_expanded = False
        self.inspect_mode = False
        self.move_drag_mode = False
        self.edit_mode_active = False
        self.set_setting("edit_mode_active", False, reload_settings=True)
        self._reload_settings_ui()
        self._stop_shimmer()
        self._clear_selection()
        self._sync_overlay_visibility()
        self._show_toast("отключен")

    def _start_shimmer(self):
        if self._shimmer_running or self.toast_handler is None:
            return
        self._shimmer_running = True
        self._shimmer_phase = 0.0
        self._shimmer_last_ts = time.monotonic()
        if self._shimmer_runnable is None:
            self._shimmer_runnable = self._keep_core(RunnableProxy(self._tick_shimmer))
        try:
            self.toast_handler.post(self._shimmer_runnable)
        except Exception:
            self._shimmer_running = False

    def _stop_shimmer(self):
        self._shimmer_running = False
        if self.toast_handler is not None and self._shimmer_runnable is not None:
            try:
                self.toast_handler.removeCallbacks(self._shimmer_runnable)
            except Exception:
                pass
        for i, (box, lp) in enumerate(self.highlight_views_pool):
            try:
                box.setAlpha(1.0)
            except Exception:
                pass

    def _tick_shimmer(self):
        if not self._shimmer_running or not self.inspect_mode or not self.running:
            self._shimmer_running = False
            return
        now = time.monotonic()
        dt = now - self._shimmer_last_ts
        self._shimmer_last_ts = now
        self._shimmer_phase = (self._shimmer_phase + dt * 0.42) % 1.0

        if not self.move_drag_mode and (now - self._last_wave_scan_ts) >= 0.45:
            self._last_wave_scan_ts = now
            self._update_all_highlights()
            if self.selected_view is not None:
                self._update_selection_box()

        num_waves = 8.0
        screen_h = max(1, int(self.overlay_root.getHeight()) if self.overlay_root else 1)
        band_h = screen_h / num_waves
        phase = self._shimmer_phase
        cycle = num_waves + 1.0

        for i, (box, lp) in enumerate(self.highlight_views_pool):
            st = self._highlight_box_states[i]
            if not st[4]:
                continue
            try:
                cy = st[1] + st[3] * 0.5
                band = cy / band_h
                dist = ((band - phase * cycle) % cycle)
                if dist > cycle * 0.5:
                    dist = cycle - dist
                t = max(0.0, 1.0 - dist / 2.6)
                ease = t * t * (3.0 - 2.0 * t)
                alpha = 0.26 + 0.74 * ease
                box.setAlpha(float(alpha))
            except Exception:
                pass

        if self.toast_handler is not None:
            try:
                # 48ms ≈ 20 fps — enough for soft wave, avoids flooding UI thread with Python
                self.toast_handler.postDelayed(self._shimmer_runnable, 48)
            except Exception:
                self._shimmer_running = False

    def _sync_overlay_visibility(self):
        if self.overlay_root is None:
            return
        self._in_apply = True
        try:
            if self.menu_hidden_badge is not None:
                self.menu_hidden_badge.setText(str(len(self.rules)))
            if not self.edit_mode_active:
                self.main_fab.setVisibility(View.GONE)
                self._animate_hide(self.menu_popup)
                self._animate_hide(self.undo_fab)
                self.touch_layer.setVisibility(View.GONE)
                self.boxes_container.setVisibility(View.GONE)
                self.selection_box.setVisibility(View.GONE)
                self._animate_hide(self.control_bar)
                if self.toast_view is not None:
                    self._animate_hide(self.toast_view)
                return

            self.main_fab.setVisibility(View.VISIBLE)
            if self.inspect_mode:
                self._animate_hide(self.menu_popup)
                self.touch_layer.setVisibility(View.VISIBLE)
                self.boxes_container.setVisibility(View.VISIBLE)
                self.main_fab.setBackground(self._bg_fab_inspect)
                self.main_fab_text.setText("✓")
                self.main_fab_text.setTextColor(COLOR_VIOLET_BRIGHT)
                if len(self.history_stack) > 0:
                    self._animate_show(self.undo_fab, 200)
                else:
                    self._animate_hide(self.undo_fab)
                self._reposition_popup_near_fab()
                self._update_selection_box()
            else:
                self.touch_layer.setVisibility(View.GONE)
                self.boxes_container.setVisibility(View.GONE)
                self.selection_box.setVisibility(View.GONE)
                self._animate_hide(self.control_bar)
                self._animate_hide(self.undo_fab)
                if self.menu_expanded:
                    self._reposition_popup_near_fab()
                    self._animate_show(self.menu_popup, 200)
                    self.main_fab.setBackground(self._bg_fab_normal)
                    self.main_fab_text.setText("✕")
                    self.main_fab_text.setTextColor(COLOR_WHITE)
                else:
                    self._animate_hide(self.menu_popup)
                    self.main_fab.setBackground(self._bg_fab_normal)
                    self.main_fab_text.setText("✎")
                    self.main_fab_text.setTextColor(COLOR_WHITE)
        finally:
            self._in_apply = False

    def _on_inspector_touch(self, v, event):
        if not self.inspect_mode or self.attached_decor is None:
            return False
        action = event.getActionMasked()
        raw_x = float(event.getRawX())
        raw_y = float(event.getRawY())

        if self.move_drag_mode and self.selected_view is not None:
            if action == MotionEvent.ACTION_DOWN:
                self.drag_start_raw_x = raw_x
                self.drag_start_raw_y = raw_y
                self.view_start_tx = float(self.selected_view.getTranslationX())
                self.view_start_ty = float(self.selected_view.getTranslationY())
                self.overlay_root.getLocationOnScreen(self._loc_buf2)
                ox = int(self._loc_buf2[0])
                oy = int(self._loc_buf2[1])
                bvx, bvy, bvw, bvh = self._get_view_bounds_in_overlay(self.selected_view, ox, oy)
                self._drag_base_vx = int(bvx)
                self._drag_base_vy = int(bvy)
                self._drag_vw = max(dp(12), int(bvw))
                self._drag_vh = max(dp(12), int(bvh))
                self._drag_screen_w = max(dp(300), int(self.overlay_root.getWidth()))
                self._drag_screen_h = max(dp(500), int(self.overlay_root.getHeight()))
                return True
            elif action == MotionEvent.ACTION_MOVE:
                dx = raw_x - self.drag_start_raw_x
                dy = raw_y - self.drag_start_raw_y
                self._in_apply = True
                try:
                    self.selected_view.setTranslationX(self.view_start_tx + dx)
                    self.selected_view.setTranslationY(self.view_start_ty + dy)
                    self._update_selection_box_fast(
                        int(self._drag_base_vx + dx),
                        int(self._drag_base_vy + dy),
                        self._drag_vw,
                        self._drag_vh,
                        self._drag_screen_w,
                        self._drag_screen_h
                    )
                finally:
                    self._in_apply = False
                return True
            elif action == MotionEvent.ACTION_UP:
                self._quick_save_position(self.selected_view)
                self._update_all_highlights()
                return True
            return True

        if action == MotionEvent.ACTION_UP:
            candidates = self._find_view_at(self.attached_decor, int(raw_x), int(raw_y))
            if not candidates:
                return True
            # native layer diving: same spot → next deeper element, no toasts
            near = (
                abs(raw_x - self._last_tap_x) < dp(28)
                and abs(raw_y - self._last_tap_y) < dp(28)
                and self._tap_candidates
            )
            if near:
                # prefer same ordered set when possible
                self._tap_idx = (self._tap_idx + 1) % max(1, len(candidates))
            else:
                self._tap_idx = 0
            self._tap_candidates = candidates
            self._last_tap_x = raw_x
            self._last_tap_y = raw_y
            idx = self._tap_idx % len(candidates)
            target = candidates[idx]
            if target is not None:
                self.selected_view = target
                self._update_selection_box()
                self._update_all_highlights()
            return True
        return True

    def _is_bad_container(self, cls_name, cls_full):
        for bad in _BAD_CONTAINERS:
            if bad in cls_name or bad in cls_full:
                return True
        return False

    def _is_recycler_item(self, v):
        try:
            p = v.getParent()
            if p is not None and isinstance(p, View):
                return bool(_get_class_meta(p)[9])
        except Exception:
            pass
        return False

    def _is_selectable_element(self, v, decor_w, decor_h, max_h):
        if v is None or v == self.overlay_root:
            return False
        meta = _get_class_meta(v)
        if meta[3]:
            return False
        try:
            w = int(v.getWidth())
            h = int(v.getHeight())
        except Exception:
            return False
        min_dim = dp(6)
        if w < min_dim or h < min_dim or w > decor_w or h > max_h:
            return False

        if meta[12] or meta[5] or meta[6] or meta[7] or meta[8] or meta[14]:
            return True

        if self._is_recycler_item(v):
            return True

        if not meta[4]:
            if w >= int(decor_w * 0.98) and h >= int(decor_h * 0.78):
                return False
            return True

        try:
            is_click = bool(v.isClickable())
        except Exception:
            is_click = False

        if is_click:
            if w >= int(decor_w * 0.96) and h >= int(decor_h * 0.65):
                return False
            return True

        try:
            cnt = int(v.getChildCount())
            has_bg = v.getBackground() is not None
        except Exception:
            cnt = 0
            has_bg = False

        if cnt == 0:
            if has_bg and not (w >= int(decor_w * 0.96) and h >= int(decor_h * 0.55)):
                return True
            return False

        if w >= int(decor_w * 0.92) and h >= int(decor_h * 0.28):
            return False

        if meta[0] in ("FrameLayout", "LinearLayout") and not has_bg and int(v.getId()) <= 0:
            if w >= int(decor_w * 0.75) or h >= dp(96):
                return False

        return True

    def _get_view_bounds_in_overlay(self, v, ox, oy):
        loc = self._loc_buf1
        v.getLocationOnScreen(loc)
        vx = int(loc[0] - ox)
        vy = int(loc[1] - oy)
        vw = int(v.getWidth())
        vh = int(v.getHeight())
        meta = _get_class_meta(v)
        if "ChatMessageCell" in meta[0]:
            try:
                bl = int(v.getBackgroundDrawableLeft())
                br = int(v.getBackgroundDrawableRight())
                bt = int(v.getBackgroundDrawableTop())
                bb = int(v.getBackgroundDrawableBottom())
                if br > bl and (br - bl) >= dp(24) and bl >= 0 and br <= vw + dp(12):
                    vx = vx + bl
                    vw = br - bl
                if bb > bt and (bb - bt) >= dp(16) and bt >= 0 and bb <= vh + dp(12):
                    vy = vy + bt
                    vh = bb - bt
            except Exception:
                pass
        return vx, vy, vw, vh

    def _score_view_for_wave(self, v):
        try:
            sc = 0
            meta = _get_class_meta(v)
            if meta[5]:
                sc += 55
            elif meta[6]:
                sc += 48
            elif meta[12] or self._is_recycler_item(v):
                sc += 45
            elif meta[7] or meta[14]:
                sc += 40
            if v.isClickable():
                sc += 30
            if meta[10] or meta[13]:
                sc += 24
            if int(v.getId()) > 0:
                sc += 14
            return sc
        except Exception:
            return 0

    def _get_button_container(self, v):
        if v is None:
            return None

        meta = _get_class_meta(v)
        cls = meta[0]
        if meta[5] or meta[6] or meta[7] or meta[12]:
            return v

        best = v
        curr = v
        depth = 0
        dp_56 = dp(56)
        dp_72 = dp(72)
        dp_80 = dp(80)

        while curr is not None and depth < 8:
            p = curr.getParent()
            if p is None or not isinstance(p, ViewGroup):
                break
            p_meta = _get_class_meta(p)
            if p_meta[3]:
                break
            if p_meta[5]:
                return p
            if p_meta[6] and not (meta[10] or meta[13]):
                return p

            p_name = p_meta[0]
            if "ActionBar" in p_name and "ImageView" in cls and (
                "back" in str(v.getTag() or "").lower()
                or int(v.getId()) > 0
                or (v.isClickable() and int(v.getWidth()) <= dp_56 and int(v.getHeight()) <= dp_56)
            ):
                return v

            pw = int(p.getWidth())
            ph = int(p.getHeight())
            p_click = bool(p.isClickable())
            if p_click and 0 < pw <= dp_72 and 0 < ph <= dp_72:
                best = p

            if p_meta[11] and 0 < pw <= dp_80 and 0 < ph <= dp_80 and p_click:
                best = p

            curr = p
            depth += 1

        return best

    def _find_view_at(self, root_view, x, y):
        if root_view is None:
            return None
        decor_w = max(1, int(root_view.getWidth()))
        decor_h = max(1, int(root_view.getHeight()))
        max_h = int(decor_h * 0.88)
        min_dim = dp(6)
        candidates = []
        seen_cand = set()
        loc = self._loc_buf1
        overlay = self.overlay_root

        def add_candidate(cand_v, depth):
            if cand_v is None:
                return
            cid = int(cand_v.hashCode())
            if cid in seen_cand:
                return
            if not self._is_selectable_element(cand_v, decor_w, decor_h, max_h):
                return
            try:
                cand_v.getLocationOnScreen(loc)
                cvx, cvy = int(loc[0]), int(loc[1])
                cvw, cvh = int(cand_v.getWidth()), int(cand_v.getHeight())
                if not ((cvx <= x <= cvx + cvw) and (cvy <= y <= cvy + cvh)):
                    return
                t_meta = _get_class_meta(cand_v)
                area = max(1, cvw * cvh)
                if "ChatMessageCell" in t_meta[0]:
                    try:
                        bl = int(cand_v.getBackgroundDrawableLeft())
                        br = int(cand_v.getBackgroundDrawableRight())
                        bt = int(cand_v.getBackgroundDrawableTop())
                        bb = int(cand_v.getBackgroundDrawableBottom())
                        if br > bl and (br - bl) >= dp(24):
                            area = max(1, (br - bl) * max(dp(16), (bb - bt) if bb > bt else cvh))
                    except Exception:
                        pass
                priority = self._score_view_for_wave(cand_v)
                seen_cand.add(cid)
                candidates.append((priority, depth, -area, cand_v))
            except Exception:
                pass

        def walk(v, depth):
            if v is None or v == overlay:
                return
            try:
                if v.getVisibility() != View.VISIBLE or float(v.getAlpha()) <= 0.05:
                    return
            except Exception:
                return
            w = int(v.getWidth())
            h = int(v.getHeight())
            if w < min_dim or h < min_dim:
                return
            try:
                v.getLocationOnScreen(loc)
            except Exception:
                return
            vx, vy = int(loc[0]), int(loc[1])
            inside = (vx <= x <= vx + w) and (vy <= y <= vy + h)
            meta = _get_class_meta(v)

            if not inside:
                if meta[4]:
                    try:
                        if v.getClipChildren():
                            return
                    except Exception:
                        pass
                    cnt = v.getChildCount()
                    for i in range(cnt):
                        walk(v.getChildAt(i), depth + 1)
                return

            if not meta[3] and h <= max_h:
                target_v = self._get_button_container(v)
                if target_v is not None:
                    add_candidate(target_v, depth)
                if target_v != v:
                    add_candidate(v, depth)

            if meta[4]:
                cnt = v.getChildCount()
                for i in range(cnt):
                    walk(v.getChildAt(i), depth + 1)

        walk(root_view, 0)
        if not candidates:
            return []
        # Sort so "front" elements come first: higher priority, smaller area, deeper depth.
        # Repeated taps cycle from front → under layers.
        candidates.sort(key=lambda item: (item[0], item[2], item[1]), reverse=True)
        return [c[3] for c in candidates]

    def _update_all_highlights(self):
        if not self.inspect_mode or self.attached_decor is None or self.boxes_container is None:
            return

        decor_w = max(1, int(self.attached_decor.getWidth()))
        decor_h = max(1, int(self.attached_decor.getHeight()))
        max_h = int(decor_h * 0.88)
        min_dim = dp(6)
        num_waves = 8
        max_per_wave = 36
        band_h = max(1.0, float(decor_h) / float(num_waves))
        wave_buckets = [[] for _ in range(num_waves)]
        seen = set()
        overlay = self.overlay_root

        self.overlay_root.getLocationOnScreen(self._loc_buf2)
        ox, oy = int(self._loc_buf2[0]), int(self._loc_buf2[1])

        def register_candidate(cand_v):
            if cand_v is None or cand_v == overlay:
                return
            v_id = int(cand_v.hashCode())
            if v_id in seen:
                return
            if not self._is_selectable_element(cand_v, decor_w, decor_h, max_h):
                return
            try:
                vx, vy, vw, vh = self._get_view_bounds_in_overlay(cand_v, ox, oy)
                if vw < min_dim or vh < min_dim:
                    return
                if vx + vw <= 0 or vx >= decor_w or vy + vh <= 0 or vy >= decor_h:
                    return
                seen.add(v_id)
                cy = vy + vh * 0.5
                w_idx = max(0, min(num_waves - 1, int(cy / band_h)))
                sc = self._score_view_for_wave(cand_v)
                area = max(1, vw * vh)
                wave_buckets[w_idx].append((sc, -area, vx, vy, vw, vh, cand_v))
            except Exception:
                pass

        def walk(v):
            if v is None or v == overlay:
                return
            try:
                if v.getVisibility() != View.VISIBLE or float(v.getAlpha()) <= 0.05:
                    return
            except Exception:
                return
            w = int(v.getWidth())
            h = int(v.getHeight())
            if w <= 0 or h <= 0:
                return

            meta = _get_class_meta(v)
            if w >= min_dim and h >= min_dim and h <= max_h and not meta[3]:
                target_v = self._get_button_container(v)
                if target_v is not None:
                    register_candidate(target_v)
                if target_v != v:
                    register_candidate(v)

            if meta[4]:
                try:
                    cnt = v.getChildCount()
                    for i in range(cnt):
                        walk(v.getChildAt(i))
                except Exception:
                    pass

        walk(self.attached_decor)

        found = []
        for w_idx in range(num_waves):
            bucket = wave_buckets[w_idx]
            if not bucket:
                continue
            if len(bucket) > max_per_wave:
                bucket.sort(key=lambda t: (t[0], t[1]), reverse=True)
                bucket = bucket[:max_per_wave]
            bucket.sort(key=lambda t: (t[3], t[2]))
            for entry in bucket:
                found.append((entry[6], entry[2], entry[3], entry[4], entry[5]))

        pool_len = len(self.highlight_views_pool)
        needed = len(found)

        if pool_len < needed:
            ctx = self.boxes_container.getContext()
            for _ in range(needed - pool_len):
                box = FrameLayout(ctx)
                box.setBackground(make_bg(0x00000000, 10, COLOR_VIOLET_BRIGHT, 2))
                box.setClickable(False)
                box.setFocusable(False)
                box.setAlpha(0.55)
                lp = FrameLayoutParams(0, 0)
                lp.gravity = Gravity.TOP | Gravity.LEFT
                self.boxes_container.addView(box, lp)
                self.highlight_views_pool.append((box, lp))
                self._highlight_box_states.append((-1, -1, -1, -1, False))

        self._in_apply = True
        try:
            for i, (box, lp) in enumerate(self.highlight_views_pool):
                prev_state = self._highlight_box_states[i]
                if i < needed:
                    item, vx, vy, vw, vh = found[i]
                    try:
                        if item == self.selected_view or item.getVisibility() != View.VISIBLE:
                            if prev_state[4]:
                                box.setVisibility(View.GONE)
                                self._highlight_box_states[i] = (-1, -1, -1, -1, False)
                            continue
                        if vw <= 0 or vh <= 0:
                            if prev_state[4]:
                                box.setVisibility(View.GONE)
                                self._highlight_box_states[i] = (-1, -1, -1, -1, False)
                            continue

                        new_state = (vx, vy, vw, vh, True)
                        if new_state != prev_state:
                            lp.width = vw
                            lp.height = vh
                            lp.leftMargin = vx
                            lp.topMargin = vy
                            if not prev_state[4]:
                                box.setVisibility(View.VISIBLE)
                            box.requestLayout()
                            self._highlight_box_states[i] = new_state
                    except Exception:
                        if prev_state[4]:
                            box.setVisibility(View.GONE)
                            self._highlight_box_states[i] = (-1, -1, -1, -1, False)
                else:
                    if prev_state[4]:
                        box.setVisibility(View.GONE)
                        self._highlight_box_states[i] = (-1, -1, -1, -1, False)
        finally:
            self._in_apply = False

    def _toggle_move_drag(self):
        if self.selected_view is None:
            return
        self.move_drag_mode = not self.move_drag_mode
        if self.move_drag_mode:
            self.btn_move_pill.setText("зафиксировать")
            self.btn_move_pill.setBackground(self._bg_move_active)
            self._disable_clip_along_ancestors(self.selected_view)
        else:
            self.btn_move_pill.setText("двигать")
            self.btn_move_pill.setBackground(self._bg_move_inactive)
            self._restore_clip_ancestors()

    def _disable_clip_along_ancestors(self, view):
        self._restore_clip_ancestors()
        if view is None:
            return
        try:
            curr = view.getParent()
            depth = 0
            while curr is not None and isinstance(curr, ViewGroup) and depth < 12:
                try:
                    was = bool(curr.getClipChildren())
                    if was:
                        curr.setClipChildren(False)
                        self._clip_restore.append((WeakReference(curr), True))
                except Exception:
                    pass
                try:
                    p = curr.getParent()
                    curr = p if isinstance(p, View) else None
                except Exception:
                    break
                depth += 1
        except Exception:
            pass

    def _restore_clip_ancestors(self):
        for wref, was in self._clip_restore:
            try:
                v = wref.get() if wref is not None else None
                if v is not None and isinstance(v, ViewGroup):
                    v.setClipChildren(bool(was))
            except Exception:
                pass
        self._clip_restore = []

    def _hide_selected_element_instant(self):
        view = self.selected_view
        if view is None:
            return
        sig, label, path_str, is_global = self._compute_signature(view)
        is_rec = self._is_recycler_item(view)
        self._remember_original_state(view, sig)
        self._in_apply = True
        try:
            view.setVisibility(View.GONE)
        finally:
            self._in_apply = False
        # Recycler cells are reused — permanent path/GONE rules would poison other rows.
        # Keep only a WeakRef-bound rule so visibility is applied only to this exact view instance.
        rule = {
            "sig": sig,
            "name": label,
            "class_label": label,
            "path": path_str if not is_rec else "",
            "is_global": False if is_rec else is_global,
            "mode": "gone",
            "tx_dp": 0.0,
            "ty_dp": 0.0,
            "enabled": True,
            "recycler_bound": bool(is_rec)
        }
        self.rules[sig] = rule
        self._resolved_Rule_views[sig] = WeakReference(view)
        if sig not in self.history_stack:
            self.history_stack.append(sig)
        self._save_data(immediate=True)
        self._reload_settings_ui()
        self._clear_selection()
        self._apply_all_rules()
        self._update_all_highlights()
        self._sync_overlay_visibility()

    def _quick_save_position(self, view):
        if view is None:
            return
        sig, label, path_str, is_global = self._compute_signature(view)
        is_rec = self._is_recycler_item(view)
        self._remember_original_state(view, sig)
        tx_dp = px_to_dp(view.getTranslationX())
        ty_dp = px_to_dp(view.getTranslationY())
        existing = self.rules.get(sig, {})
        # For recycler items keep translation only on the exact WeakRef instance.
        rule = {
            "sig": sig,
            "name": existing.get("name", "") or label,
            "class_label": label,
            "path": path_str if not is_rec else "",
            "is_global": False if is_rec else is_global,
            "mode": existing.get("mode", "move"),
            "tx_dp": tx_dp,
            "ty_dp": ty_dp,
            "enabled": True,
            "recycler_bound": bool(is_rec)
        }
        self.rules[sig] = rule
        self._resolved_Rule_views[sig] = WeakReference(view)
        if sig not in self.history_stack:
            self.history_stack.append(sig)
        self._save_data(immediate=True)
        self._reload_settings_ui()
        self._sync_overlay_visibility()

    def _update_selection_box_fast(self, vx, vy, vw, vh, screen_w, screen_h):
        new_sel = (vx, vy, vw, vh)
        if new_sel != self._sel_box_state:
            lp_box = self._sel_box_lp
            lp_box.width = vw
            lp_box.height = vh
            lp_box.leftMargin = vx
            lp_box.topMargin = vy
            self.selection_box.requestLayout()
            self._sel_box_state = new_sel
        if self.selection_box.getVisibility() != View.VISIBLE:
            self.selection_box.setVisibility(View.VISIBLE)

        bar_w = dp(210)
        bar_h = dp(46)
        bx = max(dp(8), min(vx, screen_w - bar_w - dp(8)))
        by = vy + vh + dp(8)
        if by + bar_h > screen_h - dp(75):
            by = max(dp(36), vy - bar_h - dp(8))
        new_bar = (int(bx), int(by))
        if new_bar != self._ctrl_bar_state:
            lp_bar = self._ctrl_bar_lp
            lp_bar.leftMargin = new_bar[0]
            lp_bar.topMargin = new_bar[1]
            self.control_bar.requestLayout()
            self._ctrl_bar_state = new_bar
        if self.control_bar.getVisibility() != View.VISIBLE:
            self._animate_show(self.control_bar, 180)

    def _update_selection_box(self):
        v = self.selected_view
        if v is None or self.overlay_root is None or not self.inspect_mode:
            if self.selection_box is not None and self.selection_box.getVisibility() != View.GONE:
                self.selection_box.setVisibility(View.GONE)
            if self.control_bar is not None and self.control_bar.getVisibility() != View.GONE:
                self._animate_hide(self.control_bar)
            return

        self.overlay_root.getLocationOnScreen(self._loc_buf2)
        ox = int(self._loc_buf2[0])
        oy = int(self._loc_buf2[1])
        vx, vy, raw_vw, raw_vh = self._get_view_bounds_in_overlay(v, ox, oy)
        vw = max(dp(12), int(raw_vw))
        vh = max(dp(12), int(raw_vh))
        screen_w = max(dp(300), int(self.overlay_root.getWidth()))
        screen_h = max(dp(500), int(self.overlay_root.getHeight()))
        self._update_selection_box_fast(vx, vy, vw, vh, screen_w, screen_h)

    def _evaluate_semantic_key_with_context(self, view, in_action_bar, in_enter_view, in_avatar, in_menu_item, parent_menu_item):
        v_hash = int(view.hashCode())
        cached = self._sem_key_cache.get(v_hash)
        if cached is not None:
            return cached

        meta = _get_class_meta(view)
        v_cls = meta[0]
        vid = int(view.getId())
        id_name = _get_res_id_name(view, vid) if vid > 0 else ""

        res = (None, None)
        if in_action_bar or in_avatar:
            if in_avatar or meta[6]:
                if "ImageView" in v_cls or "Avatar" in v_cls or "BackupImageView" in v_cls:
                    res = ("global:chat_avatar", "аватарка чата")
                elif "TextView" in v_cls or "SimpleTextView" in v_cls:
                    res = ("global:chat_title", "заголовок чата")
                else:
                    res = ("global:chat_avatar_container", "аватар + заголовок")
            elif (
                "back" in id_name.lower()
                or "Back" in v_cls
                or (
                    "ImageView" in v_cls
                    and view.isClickable()
                    and int(view.getWidth()) <= dp(56)
                    and int(view.getHeight()) <= dp(56)
                    and not in_menu_item
                )
            ):
                try:
                    view.getLocationOnScreen(self._loc_buf1)
                    if int(self._loc_buf1[0]) < dp(80):
                        res = ("global:actionbar_back", "кнопка «назад»")
                except Exception:
                    res = ("global:actionbar_back", "кнопка «назад»")

            if res[0] is None:
                if in_menu_item and parent_menu_item is not None:
                    mi_id = int(parent_menu_item.getId())
                    mi_name = _get_res_id_name(parent_menu_item, mi_id) if mi_id > 0 else ""
                    if mi_name:
                        res = (f"global:actionbar_item_{mi_name}", f"кнопка {mi_name}")
                    else:
                        res = (f"global:actionbar_item_{mi_id}", "элемент меню")
                elif id_name:
                    res = (f"global:actionbar_{id_name}", f"кнопка {id_name}")

        if res[0] is None and in_enter_view:
            low_id = id_name.lower()
            low_cls = v_cls.lower()
            if "attach" in low_id or "attach" in low_cls or "paperclip" in low_id:
                res = ("global:enter_attach", "кнопка вложений")
            elif "send" in low_id or "send" in low_cls:
                res = ("global:enter_send", "кнопка отправки")
            elif "audio" in low_id or "voice" in low_id or "mic" in low_id or "record" in low_id:
                res = ("global:enter_voice", "голосовое / кружочек")
            elif "emoji" in low_id or "smile" in low_id or "sticker" in low_id:
                res = ("global:enter_emoji", "эмодзи / стикеры")
            elif "EditText" in v_cls or "edit" in low_id:
                res = ("global:enter_input", "поле ввода")
            elif id_name:
                res = (f"global:enter_{id_name}", f"кнопка {id_name}")

        if res[0] is None and id_name:
            res = (f"global:id_{id_name}", f"элемент ({id_name})")

        if len(self._sem_key_cache) > 4096:
            self._sem_key_cache.clear()
        self._sem_key_cache[v_hash] = res
        return res

    def _compute_semantic_key(self, view):
        if view is None:
            return None, None
        v_hash = int(view.hashCode())
        cached = self._sem_key_cache.get(v_hash)
        if cached is not None:
            return cached

        curr = view
        in_action_bar = False
        in_enter_view = False
        in_avatar = False
        in_menu_item = False
        parent_menu_item = None
        decor = self.attached_decor

        while curr is not None and curr != decor:
            meta = _get_class_meta(curr)
            if meta[8]:
                in_action_bar = True
            if meta[7]:
                in_enter_view = True
            if meta[6]:
                in_avatar = True
            if meta[5]:
                in_menu_item = True
                parent_menu_item = curr
            p = curr.getParent()
            curr = p if isinstance(p, View) else None

        return self._evaluate_semantic_key_with_context(
            view, in_action_bar, in_enter_view, in_avatar, in_menu_item, parent_menu_item
        )

    def _compute_signature(self, view):
        sem_key, sem_label = self._compute_semantic_key(view)
        if sem_key:
            return sem_key, sem_label, "", True

        meta = _get_class_meta(view)
        cls_short = meta[2]
        parts = []
        curr = view
        depth = 0
        decor = self.attached_decor
        while curr is not None and curr != decor and depth < 32:
            p = curr.getParent()
            c_short = _get_class_meta(curr)[2]
            idx = 0
            if p is not None and isinstance(p, ViewGroup):
                cnt = p.getChildCount()
                for i in range(cnt):
                    if p.getChildAt(i) == curr:
                        idx = i
                        break
            parts.append(f"{c_short}[{idx}]")
            curr = p if isinstance(p, View) else None
            depth += 1
        parts.reverse()
        path_str = "/".join(parts)
        short_hash = hex(abs(hash(path_str)) % 0xFFF)[2:]
        class_label = f"{cls_short}:{short_hash}"
        sig = f"{class_label}|{path_str}"
        return sig, class_label, path_str, False

    def _remember_original_state(self, view, sig):
        vid = int(view.hashCode())
        if vid not in self.original_states:
            self.original_states[vid] = {
                "view_ref": WeakReference(view),
                "sig": sig,
                "visibility": int(view.getVisibility()),
                "alpha": float(view.getAlpha()),
                "tx": float(view.getTranslationX()),
                "ty": float(view.getTranslationY())
            }

    def _restore_rule_views(self, sig):
        self._resolved_Rule_views.pop(sig, None)
        to_delete = []
        self._in_apply = True
        try:
            for vid, st in list(self.original_states.items()):
                if st.get("sig") == sig:
                    v_ref = st.get("view_ref")
                    v = v_ref.get() if v_ref is not None else None
                    if v is not None:
                        try:
                            v.setVisibility(int(st["visibility"]))
                            v.setAlpha(float(st["alpha"]))
                            v.setTranslationX(float(st["tx"]))
                            v.setTranslationY(float(st["ty"]))
                        except Exception:
                            pass
                    to_delete.append(vid)
        finally:
            self._in_apply = False
        for vid in to_delete:
            self.original_states.pop(vid, None)

    def _restore_all_views(self):
        self._resolved_Rule_views.clear()
        self._in_apply = True
        try:
            for vid, st in list(self.original_states.items()):
                v_ref = st.get("view_ref")
                v = v_ref.get() if v_ref is not None else None
                if v is not None:
                    try:
                        v.setVisibility(int(st["visibility"]))
                        v.setAlpha(float(st["alpha"]))
                        v.setTranslationX(float(st["tx"]))
                        v.setTranslationY(float(st["ty"]))
                    except Exception:
                        pass
        finally:
            self._in_apply = False
        self.original_states.clear()

    def _resolve_view_by_path(self, path_str):
        if self.attached_decor is None or not path_str:
            return None
        steps = path_str.split("/")
        curr = self.attached_decor
        overlay = self.overlay_root
        for step in steps:
            if not _get_class_meta(curr)[4]:
                return None
            if "[" not in step or not step.endswith("]"):
                return None
            c_name, idx_part = step[:-1].split("[", 1)
            try:
                idx = int(idx_part)
            except Exception:
                return None
            if idx < 0 or idx >= curr.getChildCount():
                return None
            child = curr.getChildAt(idx)
            if child is None or child == overlay:
                return None
            child_short = _get_class_meta(child)[2]
            if child_short != c_name:
                return None
            curr = child
        return curr

    def _apply_compiled_rule_to_view(self, v, sig, compiled):
        _, target_vis, tx_px, ty_px, _ = compiled
        self._remember_original_state(v, sig)
        try:
            cur_tx = float(v.getTranslationX())
            if abs(cur_tx - tx_px) > 0.5:
                v.setTranslationX(tx_px)
            cur_ty = float(v.getTranslationY())
            if abs(cur_ty - ty_px) > 0.5:
                v.setTranslationY(ty_px)
            cur_vis = int(v.getVisibility())
            if cur_vis != target_vis:
                v.setVisibility(target_vis)
        except Exception:
            pass

    def _apply_all_rules(self):
        if self.attached_decor is None:
            return
        global_rules = self._active_global_rules
        local_rules = self._active_local_rules
        if not global_rules and not local_rules:
            return

        prev_apply = self._in_apply
        self._in_apply = True
        overlay = self.overlay_root
        try:
            if global_rules:
                def scan_and_apply(v, in_ab, in_ev, in_av, in_mi, p_mi):
                    if v is None or v == overlay:
                        return
                    meta = _get_class_meta(v)
                    if meta[9]:
                        return

                    cur_ab = in_ab or meta[8]
                    cur_ev = in_ev or meta[7]
                    cur_av = in_av or meta[6]
                    cur_mi = in_mi or meta[5]
                    cur_pmi = v if meta[5] else p_mi

                    sem_key, _ = self._evaluate_semantic_key_with_context(
                        v, cur_ab, cur_ev, cur_av, cur_mi, cur_pmi
                    )
                    if sem_key is not None:
                        compiled = global_rules.get(sem_key)
                        if compiled is not None:
                            self._apply_compiled_rule_to_view(v, sem_key, compiled)

                    if meta[4]:
                        cnt = v.getChildCount()
                        for i in range(cnt):
                            scan_and_apply(v.getChildAt(i), cur_ab, cur_ev, cur_av, cur_mi, cur_pmi)

                scan_and_apply(self.attached_decor, False, False, False, False, None)

            if local_rules:
                for sig, compiled in local_rules.items():
                    rule_obj = compiled[0]
                    is_recycler_bound = bool(rule_obj.get("recycler_bound", False)) if isinstance(rule_obj, dict) else False
                    target = None
                    wref = self._resolved_Rule_views.get(sig)
                    if wref is not None:
                        cached_v = wref.get()
                        if cached_v is not None and cached_v.isAttachedToWindow():
                            target = cached_v
                    # Never re-resolve path for recycler-bound rules — recycling would apply GONE/tx to wrong cells.
                    if target is None and not is_recycler_bound:
                        path_str = compiled[4]
                        if path_str:
                            target = self._resolve_view_by_path(path_str)
                            if target is not None and target != overlay:
                                self._resolved_Rule_views[sig] = WeakReference(target)
                    if target is not None and target != overlay:
                        self._apply_compiled_rule_to_view(target, sig, compiled)
        finally:
            self._in_apply = prev_apply

    def _undo_last_rule(self):
        while self.history_stack:
            last_sig = self.history_stack.pop()
            if last_sig in self.rules:
                self.rules.pop(last_sig, None)
                self._restore_rule_views(last_sig)
                self._save_data(immediate=True)
                self._reload_settings_ui()
                self._apply_all_rules()
                self._update_all_highlights()
                self._sync_overlay_visibility()
                self._show_toast("ласт действие отменено")
                return
        self._show_toast("нечего отменять")

    def _create_bottom_dialog(self, ctx):
        dlg = Dialog(ctx)
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE)
        win = dlg.getWindow()
        if win is not None:
            win.setBackgroundDrawable(make_bg(0x00000000, 0))
            win.setLayout(WindowManagerLayoutParams.MATCH_PARENT, WindowManagerLayoutParams.WRAP_CONTENT)
            win.setGravity(Gravity.BOTTOM)
        return dlg

    def _open_hidden_elements_sheet(self):
        act = self._get_activity()
        if act is None:
            return
        self.menu_expanded = False
        self._sync_overlay_visibility()

        dlg = self._create_bottom_dialog(act)
        root = LinearLayout(act)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackground(make_bg(COLOR_BG_DARK, 22, COLOR_CARD_LIGHT, 1))
        root.setPadding(dp(18), dp(14), dp(18), dp(20))

        title = TextView(act)
        title.setText(f"измененные элементы ({len(self.rules)})")
        title.setTextColor(COLOR_TEXT_MAIN)
        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
        title.setGravity(Gravity.CENTER)
        lp_t = LinearLayoutParams(LinearLayoutParams.MATCH_PARENT, LinearLayoutParams.WRAP_CONTENT)
        lp_t.bottomMargin = dp(14)
        root.addView(title, lp_t)

        scroll = ScrollView(act)
        list_box = LinearLayout(act)
        list_box.setOrientation(LinearLayout.VERTICAL)

        if not self.rules:
            empty_tv = TextView(act)
            empty_tv.setText("список пуст")
            empty_tv.setTextColor(COLOR_TEXT_SUB)
            empty_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            empty_tv.setGravity(Gravity.CENTER)
            empty_tv.setPadding(dp(16), dp(24), dp(16), dp(24))
            list_box.addView(empty_tv)
        else:
            card_bg_proto = make_bg(COLOR_CARD_DARK, 14)
            d_del_proto = get_tg_drawable(act, "msg_delete", COLOR_DANGER)
            for sig, rule in list(self.rules.items()):
                card = LinearLayout(act)
                card.setOrientation(LinearLayout.HORIZONTAL)
                card.setGravity(Gravity.CENTER_VERTICAL)
                card_bg = card_bg_proto.getConstantState().newDrawable().mutate() if card_bg_proto.getConstantState() else make_bg(COLOR_CARD_DARK, 14)
                card.setBackground(card_bg)
                card.setPadding(dp(14), dp(12), dp(14), dp(12))

                info_col = LinearLayout(act)
                info_col.setOrientation(LinearLayout.VERTICAL)
                nm = TextView(act)
                nm.setText(str(rule.get("name") or rule.get("class_label", "element")))
                nm.setTextColor(COLOR_TEXT_MAIN)
                nm.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
                info_col.addView(nm)

                mode_map = {"gone": "скрыт", "invisible": "прозрачный", "move": "смещен"}
                m_str = mode_map.get(rule.get("mode", "gone"), "скрыт")
                tx_v = rule.get("tx_dp", 0)
                ty_v = rule.get("ty_dp", 0)
                sub_info = TextView(act)
                scope_str = "везде" if rule.get("is_global", False) else "локально"
                sub_info.setText(f"{scope_str} - {m_str} ({tx_v}, {ty_v} dp)")
                sub_info.setTextColor(COLOR_TEXT_SUB)
                sub_info.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                info_col.addView(sub_info)

                card.addView(info_col, LinearLayoutParams(0, LinearLayoutParams.WRAP_CONTENT, 1.0))

                toggle_btn = TextView(act)
                is_on = bool(rule.get("enabled", True))
                toggle_btn.setText("вкл" if is_on else "выкл")
                toggle_btn.setTextColor(COLOR_VIOLET_BRIGHT if is_on else COLOR_TEXT_SUB)
                toggle_btn.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
                toggle_btn.setPadding(dp(10), dp(6), dp(10), dp(6))

                def on_toggle(v, s=sig, btn=toggle_btn):
                    if s not in self.rules:
                        return
                    cur = bool(self.rules[s].get("enabled", True))
                    new_state = not cur
                    self.rules[s]["enabled"] = new_state
                    btn.setText("вкл" if new_state else "выкл")
                    btn.setTextColor(COLOR_VIOLET_BRIGHT if new_state else COLOR_TEXT_SUB)
                    if cur:
                        self._restore_rule_views(s)
                    self._save_data(immediate=True)
                    self._reload_settings_ui()
                    self._apply_all_rules()
                    if self.inspect_mode:
                        self._update_all_highlights()

                toggle_btn.setOnClickListener(self._keep(ClickProxy(on_toggle)))
                card.addView(toggle_btn)

                del_iv = ImageView(act)
                if d_del_proto is not None:
                    d_copy = d_del_proto.getConstantState().newDrawable().mutate() if d_del_proto.getConstantState() else get_tg_drawable(act, "msg_delete", COLOR_DANGER)
                    del_iv.setImageDrawable(d_copy)
                lp_del = LinearLayoutParams(dp(22), dp(22))
                lp_del.leftMargin = dp(10)

                def on_delete(v, s=sig, row_card=card):
                    self.rules.pop(s, None)
                    self._restore_rule_views(s)
                    self._save_data(immediate=True)
                    self._reload_settings_ui()
                    self._apply_all_rules()
                    if self.inspect_mode:
                        self._update_all_highlights()
                    self._sync_overlay_visibility()
                    try:
                        list_box.removeView(row_card)
                        title.setText(f"измененные элементы ({len(self.rules)})")
                        if not self.rules:
                            dlg.dismiss()
                            self._open_hidden_elements_sheet()
                    except Exception:
                        dlg.dismiss()
                        self._open_hidden_elements_sheet()

                del_iv.setOnClickListener(self._keep(ClickProxy(on_delete)))
                card.addView(del_iv, lp_del)

                lp_c = LinearLayoutParams(LinearLayoutParams.MATCH_PARENT, LinearLayoutParams.WRAP_CONTENT)
                lp_c.bottomMargin = dp(8)
                list_box.addView(card, lp_c)

        scroll.addView(list_box)
        lp_sc = LinearLayoutParams(LinearLayoutParams.MATCH_PARENT, dp(310))
        lp_sc.bottomMargin = dp(14)
        root.addView(scroll, lp_sc)

        btn_close = TextView(act)
        btn_close.setText("закрыть")
        btn_close.setTextColor(COLOR_WHITE)
        btn_close.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        btn_close.setGravity(Gravity.CENTER)
        btn_close.setBackground(make_bg(COLOR_VIOLET_BRIGHT, 20))
        btn_close.setPadding(dp(14), dp(12), dp(14), dp(12))
        btn_close.setOnClickListener(self._keep(ClickProxy(lambda v: (self._reload_settings_ui(), dlg.dismiss()))))
        root.addView(btn_close)

        dlg.setContentView(root)
        dlg.show()

    def _open_help_sheet(self):
        act = self._get_activity()
        if act is None:
            return
        self.menu_expanded = False
        self._sync_overlay_visibility()

        dlg = self._create_bottom_dialog(act)
        root = LinearLayout(act)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackground(make_bg(COLOR_BG_DARK, 22, COLOR_CARD_LIGHT, 1))
        root.setPadding(dp(20), dp(16), dp(20), dp(22))

        hdr = TextView(act)
        hdr.setText("как работает?")
        hdr.setTextColor(COLOR_TEXT_MAIN)
        hdr.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
        hdr.setGravity(Gravity.CENTER)
        lp_h = LinearLayoutParams(LinearLayoutParams.MATCH_PARENT, LinearLayoutParams.WRAP_CONTENT)
        lp_h.bottomMargin = dp(12)
        root.addView(hdr, lp_h)

        body = TextView(act)
        body.setText(
            "1 после включения «режим редактирования», часть кнопок будут обведены, остальные ищи сам\n\n"
            "2. тапни по любому элементу и он выделится увеличенной обводкой\n\n"
            "3. кнопка «скрыть» удаляет элемент с экрана\n\n"
            "4. кнопка «двигать» позволяет свободно перетаскивать элемент\n\n\n"
            "! если плагин лагает, то вероятно: ты либо сделал слишком много изменений интерфейса, либо он конфликтует с другим плагином, например, CherryHeader. отключи плагины, меняющие те элементы, которые ты сам хочешь изменить"
        )
        body.setTextColor(COLOR_TEXT_SUB)
        body.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        lp_b = LinearLayoutParams(LinearLayoutParams.MATCH_PARENT, LinearLayoutParams.WRAP_CONTENT)
        lp_b.bottomMargin = dp(16)
        root.addView(body, lp_b)

        btn_ok = TextView(act)
        btn_ok.setText("ок")
        btn_ok.setTextColor(COLOR_WHITE)
        btn_ok.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        btn_ok.setGravity(Gravity.CENTER)
        btn_ok.setBackground(make_bg(COLOR_VIOLET_BRIGHT, 20))
        btn_ok.setPadding(dp(14), dp(12), dp(14), dp(12))
        btn_ok.setOnClickListener(self._keep(ClickProxy(lambda v: dlg.dismiss())))
        root.addView(btn_ok)

        dlg.setContentView(root)
        dlg.show()

    def _export_to_clipboard(self, v=None):
        act = self._get_activity()
        ctx = act if act is not None else ApplicationLoader.applicationContext
        if ctx is None:
            return
        payload = {"rules": self.rules, "version": 3}
        raw = json.dumps(payload, ensure_ascii=False)
        try:
            cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText("EditModeConfig", raw)
            cm.setPrimaryClip(clip)
            self._show_toast("скопировано")
        except Exception:
            try:
                AndroidUtilities.addToClipboard(raw)
                self._show_toast("скопировано")
            except Exception:
                self._show_toast("ошибка копирования", True)

    def _import_from_clipboard(self, v=None):
        act = self._get_activity()
        ctx = act if act is not None else ApplicationLoader.applicationContext
        if ctx is None:
            return
        try:
            cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = cm.getPrimaryClip() if cm is not None else None
            if clip is None or int(clip.getItemCount()) == 0:
                self._show_toast("буфер пуст", True)
                return
            item = clip.getItemAt(0)
            raw_txt = ""
            if item is not None:
                txt_obj = item.getText()
                if txt_obj is None:
                    try:
                        txt_obj = item.coerceToText(ctx)
                    except Exception:
                        txt_obj = None
                if txt_obj is not None:
                    if isinstance(txt_obj, str):
                        raw_txt = txt_obj.strip()
                    elif hasattr(txt_obj, "toString"):
                        raw_txt = str(txt_obj.toString()).strip()
                    else:
                        raw_txt = str(txt_obj).strip()
            if not raw_txt:
                self._show_toast("буфер пуст", True)
                return
            parsed = None
            try:
                parsed = json.loads(raw_txt)
            except Exception:
                start_idx = raw_txt.find("{")
                end_idx = raw_txt.rfind("}")
                if start_idx != -1 and end_idx > start_idx:
                    parsed = json.loads(raw_txt[start_idx:end_idx + 1])
            if isinstance(parsed, dict) and "rules" in parsed and isinstance(parsed.get("rules"), dict):
                self._restore_all_views()
                self.rules = dict(parsed.get("rules", {}))
                self._save_data(immediate=True)
                self._apply_all_rules()
                self._update_all_highlights()
                self._sync_overlay_visibility()
                self._reload_settings_ui()
                self._show_toast(f"импортировано: {len(self.rules)}")
                return
        except Exception:
            pass
        self._show_toast("нет подходящего конфига", True)

    def _reset_all_rules(self, v=None):
        self.rules.clear()
        self.history_stack.clear()
        self._restore_all_views()
        self._save_data(immediate=True)
        self._update_all_highlights()
        self._sync_overlay_visibility()
        self._reload_settings_ui()
        self._show_toast("элементы восстановлены")

    def _toggle_rule_from_settings(self, sig, val):
        if sig in self.rules:
            self.rules[sig]["enabled"] = bool(val)
            self._save_data(immediate=True)
            self._reload_settings_ui()
            run_on_ui_thread(lambda: (self._restore_rule_views(sig) if not val else self._apply_all_rules()))

    def _on_edit_mode_toggle(self, val):
        self.edit_mode_active = bool(val)
        self.set_setting("edit_mode_active", self.edit_mode_active, reload_settings=True)
        if self.edit_mode_active:
            run_on_ui_thread(self._enter_inspect_mode)
        else:
            run_on_ui_thread(self._exit_edit_mode_completely)
        self._reload_settings_ui()

    def _open_tg_link(self, username):
        try:
            context = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(f"tg://resolve?domain={username}"))
            intent.setPackage(context.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        except Exception:
            pass

    def _show_welcome_dialog(self):
        try:
            current_fragment = get_last_fragment()
            activity = current_fragment.getParentActivity() if current_fragment else self._get_activity()
            if not activity:
                return

            builder = AlertDialogBuilder(activity)
            builder.set_title(__name__)
            builder.set_message("больше уникальных плагинов и проектов в канале")

            def on_hide(bld, which):
                self.set_setting("welcome_shown", True)
                bld.dismiss()

            def on_channel(bld, which):
                self.set_setting("welcome_shown", True)
                self._open_tg_link("HzzzPlugins")
                bld.dismiss()

            builder.set_positive_button("перейти и больше не показывать", on_channel)
            builder.set_negative_button("скрыть", on_hide)
            builder.show()
        except Exception:
            pass

    def create_settings(self):
        if not self._welcome_shown and not self.get_setting("welcome_shown", False):
            self._welcome_shown = True
            run_on_ui_thread(self._show_welcome_dialog)

        self.set_setting("edit_mode_active", bool(self.edit_mode_active))

        items = [

            Header(text="основные"),
            Switch(
                key="edit_mode_active",
                text="режим редактирования",
                default=self.edit_mode_active,
                icon="msg_edit",
                on_change=self._on_edit_mode_toggle
            ),
            Text(
                text=f"измененные элементы ({len(self.rules)})",
                icon="msg_view_file",
                on_click=lambda v: run_on_ui_thread(self._open_hidden_elements_sheet)
            ),
            Divider(),
            Header(text="синхронизация и сброс"),
            Text(
                text="экспортировать в буфер обмена",
                icon="msg_share",
                on_click=lambda v: run_on_ui_thread(self._export_to_clipboard)
            ),
            Text(
                text="импорт из буфера",
                icon="msg_retry",
                on_click=lambda v: run_on_ui_thread(self._import_from_clipboard)
            ),
            Text(
                text="восстановить все элементы",
                icon="msg_delete",
                red=True,
                on_click=lambda v: run_on_ui_thread(self._reset_all_rules)
            ),
            Divider(),
            Header(text=f"6.9-public-beta | thanks TikTokYou"),
            Text(
                text="канал: @HzzzPlugins",
                on_click=lambda v: self._open_tg_link("HzzzPlugins")
            ),
            Text(
                text="сделал: @exoseo",
                on_click=lambda v: self._open_tg_link("exoseo")
            ),
            Text(
                    text="найдет все тайны: @xucxbot",
                    accent=True,
                    on_click=lambda v: self._open_tg_link("xucxbot")
                ),
            Divider(),
            Divider(text="если плагин лагает, то вероятно: либо ты сделал слишком много изменений интерфейса, либо он конфликтует с другим плагином, например, CherryHeader. отключи плагины, меняющие те элементы, которые ты сам хочешь изменить"),
        ]

        return items