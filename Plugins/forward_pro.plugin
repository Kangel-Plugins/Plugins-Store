LOCALE_CONTROLLER = 'org.telegram.messenger.LocaleController'
_CAPABILITY_CACHE = {}
_LAST_LANG = [None]
_LANG_NAME_MAP = {'english': 'en', 'russian': 'ru', 'русский': 'ru'}
STRINGS = {'ru': {'header_main': 'Forward Pro', 'enabled_title': 'Выбор аккаунта при пересылке', 'enabled_sub': 'Аватар аккаунта в экране «Переслать…» открывает список аккаунтов', 'drop_author_title': 'Пересылать без автора', 'drop_author_sub': 'Если сообщение можно переслать напрямую — скрыть отправителя', 'copy_only_title': 'Всегда копией', 'copy_only_sub': 'Не пытаться пересылать напрямую, всегда отправлять копию', 'goto_title': 'Переход к оригиналу в Избранном', 'goto_sub': 'Показывать стрелку перехода и для сообщений авторов, скрывших аккаунт при пересылке', 'bypass_title': 'Обходить запрет пересылки', 'bypass_sub': 'Защищённый контент отправляется копией: текст заново, файлы скачиваются и загружаются заново. Кнопки «Переслать» в защищённых чатах активны', 'hint': 'Сообщения всегда пересылаются с подписью «Переслано из». Если выбранный аккаунт не видит источник, пересылка идёт через личку между аккаунтами (служебные сообщения сразу удаляются у обоих). Копия — только если это невозможно или источник запрещает пересылку.', 'menu_title': 'Отправить в'}, 'en': {'header_main': 'Forward Pro', 'enabled_title': 'Account picker when forwarding', 'enabled_sub': 'The account avatar on the "Forward to…" screen opens the account list', 'drop_author_title': 'Forward without author', 'drop_author_sub': 'When a direct forward is possible, hide the sender', 'copy_only_title': 'Always as copy', 'copy_only_sub': 'Never try a direct forward, always send a copy', 'goto_title': 'Go to original in Saved Messages', 'goto_sub': 'Show the go-to arrow also for messages whose authors hide their account in forwards', 'bypass_title': 'Bypass forwarding restrictions', 'bypass_sub': 'Protected content is sent as a copy: text is resent, files are downloaded and uploaded again. Forward buttons are enabled in protected chats', 'hint': 'Messages are always forwarded with the "Forwarded from" header. If the selected account cannot see the source, the forward is relayed through the private chat between the accounts (relay messages are deleted for both right away). A copy is sent only if that is impossible or the source forbids forwarding.', 'menu_title': 'Sent to'}}

def _class_name(obj):
    try:
        return str(obj.getClass().getName())
    except Exception:
        return type(obj).__name__

def _has_method(obj, name):
    cache_key = '%s#%s' % (_class_name(obj), name)
    cached = _CAPABILITY_CACHE.get(cache_key)
    if cached is not None:
        return cached
    ok = callable(getattr(obj, name, None))
    _CAPABILITY_CACHE[cache_key] = ok
    return ok

def _locale_controller():
    try:
        if find_class is not None:
            cls = find_class(LOCALE_CONTROLLER)
            if cls is not None:
                return cls
    except Exception:
        pass
    try:
        return jclass(LOCALE_CONTROLLER)
    except Exception:
        return None

def _locale_instance():
    cls = _locale_controller()
    if cls is None:
        return None
    try:
        return cls.getInstance()
    except Exception:
        return None

def _norm_lang(raw):
    if raw is None:
        return None
    try:
        code = str(raw).strip().lower()
    except Exception:
        return None
    if not code or code in ('null', 'none'):
        return None
    code = _LANG_NAME_MAP.get(code, code)
    code = code.replace('_', '-').split('-', 1)[0]
    return code if code in STRINGS else None

def _lang_from_locale(inst):
    info = None
    if _has_method(inst, 'getCurrentLocaleInfo'):
        try:
            info = inst.getCurrentLocaleInfo()
        except Exception:
            info = None
    if info is None:
        info = _get_field(inst, 'currentLocaleInfo')
    if info is None:
        return None
    for getter in ('getLangCode', 'getBaseLangCode', 'getPluralLangCode', 'getKey'):
        if not _has_method(info, getter):
            continue
        try:
            code = _norm_lang(getattr(info, getter)())
        except Exception:
            code = None
        if code:
            return code
    for fld in ('shortName', 'pluralLangCode', 'baseLangCode', 'langCode', 'name'):
        code = _norm_lang(_get_field(info, fld))
        if code:
            return code
    return None

def _get_lang():
    inst = _locale_instance()
    if inst is not None:
        try:
            code = _lang_from_locale(inst)
            if code:
                return code
        except Exception:
            pass
        if _has_method(inst, 'getCurrentLocale'):
            try:
                locale_obj = inst.getCurrentLocale()
                if locale_obj is not None:
                    code = _norm_lang(locale_obj.getLanguage())
                    if code:
                        return code
            except Exception:
                pass
        locale_obj = _get_field(inst, 'currentLocale')
        if locale_obj is not None:
            try:
                code = _norm_lang(locale_obj.getLanguage())
                if code:
                    return code
            except Exception:
                pass
        if _has_method(inst, 'getCurrentLanguageName'):
            try:
                code = _norm_lang(inst.getCurrentLanguageName())
                if code:
                    return code
            except Exception:
                pass
    try:
        code = _norm_lang(jclass('java.util.Locale').getDefault().getLanguage())
        if code:
            return code
    except Exception:
        pass
    return 'en'

def _tr(key):
    return STRINGS.get(_get_lang(), STRINGS['en']).get(key, key)

def _walk_classes(obj):
    try:
        cls = obj.getClass()
    except Exception:
        return
    for _ in range(10):
        if cls is None:
            return
        yield cls
        try:
            cls = cls.getSuperclass()
        except Exception:
            return

def _get_field(obj, name):
    if obj is None:
        return None
    for cls in _walk_classes(obj):
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            pass
    return None

def _has_field(obj, name):
    for cls in _walk_classes(obj):
        try:
            cls.getDeclaredField(name)
            return True
        except Exception:
            pass
    return False

def _set_field(obj, name, value):
    for cls in _walk_classes(obj):
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            field.set(obj, value)
            return True
        except Exception:
            pass
    return False

def _call_private(obj, name, types, args):
    for cls in _walk_classes(obj):
        try:
            m = cls.getDeclaredMethod(name, *types)
            m.setAccessible(True)
            return (True, m.invoke(obj, *args))
        except Exception:
            pass
    return (False, None)

def _java_array_to_list(array):
    if array is None:
        return []
    try:
        return [array[i] for i in range(len(array))]
    except Exception:
        try:
            return [x for x in array]
        except Exception:
            return []

def _collect_methods(clazz, method_name):
    current = clazz
    while current is not None:
        found = []
        for getter in ('getDeclaredMethods', 'getMethods'):
            try:
                members = _java_array_to_list(getattr(current, getter)())
            except Exception:
                members = []
            for member in members:
                try:
                    if member.getName() == method_name:
                        found.append(member)
                except Exception:
                    pass
            if found:
                return found
        try:
            current = current.getSuperclass()
        except Exception:
            return []
    return []

def _jlist(lst):
    if lst is None:
        return []
    try:
        return [lst.get(i) for i in range(int(lst.size()))]
    except Exception:
        try:
            return [x for x in lst]
        except Exception:
            return []

def _jcls(name):
    try:
        return jclass(name)
    except Exception:
        return None

def _is_class_obj(c):
    try:
        return c is not None and str(c.getName()) != ''
    except Exception:
        return False

def _class_obj(name):
    if find_class is not None:
        try:
            c = find_class(name)
            if _is_class_obj(c):
                return c
        except Exception:
            pass
    JavaClass = jclass('java.lang.Class')
    try:
        loader = jclass('org.telegram.messenger.ApplicationLoader').applicationContext.getClassLoader()
        return JavaClass.forName(name, False, loader)
    except Exception:
        pass
    try:
        return JavaClass.forName(name)
    except Exception:
        return None

def _ident(obj):
    try:
        return int(System.identityHashCode(obj))
    except Exception:
        return 0

def _ui(fn, delay=0):

    def _safe():
        try:
            fn()
        except Exception:
            pass
    try:
        if delay:
            run_on_ui_thread(_safe, delay)
        else:
            run_on_ui_thread(_safe)
    except Exception:
        pass
_OnClick = _jcls('android.view.View$OnClickListener')
_OnLongClick = _jcls('android.view.View$OnLongClickListener')
_DlgClick = _jcls('android.content.DialogInterface$OnClickListener')
_ReqDelegate = _jcls('org.telegram.tgnet.RequestDelegate')
_DialogsDelegate = _jcls('org.telegram.ui.DialogsActivity$DialogsActivityDelegate')

class _ClickProxy(dynamic_proxy(_OnClick)):

    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, view):
        try:
            self._fn(view)
        except Exception:
            pass

class _LongClickProxy(dynamic_proxy(_OnLongClick)):

    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onLongClick(self, view):
        try:
            self._fn(view)
        except Exception:
            pass
        return True

class _DlgClickProxy(dynamic_proxy(_DlgClick)):

    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onClick(self, dialog, which):
        try:
            self._fn(int(which))
        except Exception:
            pass

class _RequestProxy(dynamic_proxy(_ReqDelegate)):

    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self, response, error):
        try:
            self._fn(response, error)
        except Exception:
            pass

class _ForwardDelegate(dynamic_proxy(_DialogsDelegate)):

    def __init__(self, plugin, ctx):
        super().__init__()
        self._plugin = plugin
        self._ctx = ctx

    def didSelectDialogs(self, *args):
        try:
            return bool(self._plugin._on_dialogs_selected(self._ctx, args))
        except Exception:
            return False

    def canSelectStories(self):
        return False

    def didSelectStories(self, fragment):
        return False

def _rpc(account, req, cb):
    try:
        cm = jclass('org.telegram.tgnet.ConnectionsManager').getInstance(account)
        cm.sendRequest(req, _RequestProxy(cb))
    except Exception:
        cb(None, None)

def _err_text(error):
    if error is None:
        return 'NO_RESPONSE'
    try:
        return str(error.text)
    except Exception:
        return str(error)

def _rand():
    return random.getrandbits(62) + 1

class _Runner(object):

    def __init__(self, steps, on_done):
        self._steps = steps
        self._idx = 0
        self._done = on_done

    def next(self):
        if self._idx >= len(self._steps):
            try:
                self._done()
            except Exception:
                pass
            return
        step = self._steps[self._idx]
        self._idx += 1
        try:
            step(self.next)
        except Exception:
            self.next()

class _LanguageChangeHook(MethodHook):

    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        try:
            self._plugin._refresh_language()
        except Exception:
            pass

