class _OpenSelectorHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            frag = param.thisObject
            if self.plugin._is_f2a(frag):
                anchor = param.args[0] if param.args is not None and len(param.args) > 0 else None
                self.plugin._show_menu(frag, anchor)
                param.setResult(Boolean(True))
        except Exception:
            pass

class _PresentHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin._fix_child_account(param.thisObject, param.args)
        except Exception:
            pass
_MVEL_SAVED_GOTO = 'this.messageOwner != null && this.messageOwner.fwd_from != null'

class _OpenOriginalHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if param.args is None or len(param.args) == 0:
                return
            frag = param.thisObject
            msg = param.args[0]
            fwd = msg.messageOwner.fwd_from if msg is not None and msg.messageOwner is not None else None
            peer = fwd.saved_from_peer if fwd is not None else None
            if peer is None:
                return
            channel_id = int(getattr(peer, 'channel_id', 0) or 0)
            msg_id = int(fwd.saved_from_msg_id or 0)
            acc = int(frag.getCurrentAccount())
            reachable = self.plugin._reachable(acc, -channel_id) if channel_id else True
            if not channel_id or reachable:
                return
            url = 'https://t.me/c/%d/%d' % (channel_id, msg_id) if msg_id else 'https://t.me/c/%d' % channel_id
            jclass('org.telegram.messenger.browser.Browser').openUrl(frag.getParentActivity(), url)
            param.setResult(None)
        except Exception:
            pass

class _SavedGotoHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin._opt('saved_goto', True):
                return
            msg = param.thisObject
            if bool(param.getResult()):
                return
            if not bool(getattr(msg, 'isSaved', False)):
                return
            fwd = msg.messageOwner.fwd_from if msg.messageOwner is not None else None
            if fwd is None or fwd.saved_from_peer is None or int(fwd.saved_from_msg_id or 0) == 0:
                return
            if bool(msg.messageOwner.noforwards):
                return
            param.setResult(Boolean(True))
        except Exception:
            pass

class _NoForwardsHook(MethodHook):

    def __init__(self, plugin, name):
        self.plugin = plugin
        self.name = name

    def after_hooked_method(self, param):
        try:
            if getattr(_NF_RAW, 'on', False) or not bool(param.getResult()):
                return
            if not self.plugin._opt('bypass_protect', True):
                return
            param.setResult(Boolean(False))
        except Exception:
            pass
_MVEL_CAN_FORWARD = 'this.messageOwner != null && (this.messageOwner.noforwards || (this.messageOwner.media != null && this.messageOwner.media.ttl_seconds > 0))'

class _CanForwardHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if getattr(_NF_RAW, 'on', False) or bool(param.getResult()):
                return
            msg = param.thisObject
            owner = msg.messageOwner
            if owner is None or isinstance(owner, TLRPC.TL_message_secret):
                return
            try:
                if msg.isSponsored() or msg.isLiveLocation():
                    return
            except Exception:
                pass
            if _msg_ttl(msg) <= 0 and (not (bool(owner.noforwards) and self.plugin._opt('bypass_protect', True))):
                return
            param.setResult(Boolean(True))
        except Exception:
            pass

class _ChatSelectHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if self.plugin._take_protected_forward(param.thisObject, param.args):
                param.setResult(Boolean(True))
        except Exception:
            pass

class ForwardProPlugin(BasePlugin):

    def on_plugin_load(self):
        self._hooks = []
        self._switch_restore_epoch = object()
        self._pickers = {}
        self._foreign = None
        if ConcurrentHashMap is not None:
            try:
                self._foreign = ConcurrentHashMap.newKeySet()
            except Exception:
                self._foreign = None
        self._hook_all()
        self._hook_locale()

    def on_plugin_unload(self):
        self._switch_restore_epoch = None
        for h in list(self._hooks):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []
        self._pickers = {}

    def _hook_locale(self):
        _CAPABILITY_CACHE.clear()
        try:
            _LAST_LANG[0] = _get_lang()
        except Exception:
            _LAST_LANG[0] = None
        clazz = _class_obj(LOCALE_CONTROLLER)
        if clazz is None:
            return
        lang_hook = _LanguageChangeHook(self)
        for method_name in ('applyLanguage', 'recreateFormatters'):
            try:
                self._hook_methods(clazz, method_name, lang_hook)
            except Exception:
                pass

    def _refresh_language(self):
        try:
            lang = _get_lang()
        except Exception:
            return
        if lang == _LAST_LANG[0]:
            return
        _LAST_LANG[0] = lang

        def do_reload():
            for name in ('reload_settings', 'reloadSettings'):
                fn = getattr(self, name, None)
                if callable(fn):
                    try:
                        fn()
                        return
                    except Exception:
                        pass
            try:
                tick = int(self.get_setting('lang_tick', 0) or 0) + 1
            except Exception:
                tick = 1
            try:
                self.set_setting('lang_tick', tick, reload_settings=True)
            except Exception:
                pass
        _ui(do_reload)

    def _opt(self, key, default):
        try:
            return bool(self.get_setting(key, default))
        except Exception:
            return default

    def create_settings(self):
        items = [Header(text=_tr('header_main')), Switch(key='enabled', text=_tr('enabled_title'), subtext=_tr('enabled_sub'), default=True), Switch(key='drop_author', text=_tr('drop_author_title'), subtext=_tr('drop_author_sub'), default=False), Switch(key='copy_only', text=_tr('copy_only_title'), subtext=_tr('copy_only_sub'), default=False), Switch(key='saved_goto', text=_tr('goto_title'), subtext=_tr('goto_sub'), default=True), Switch(key='bypass_protect', text=_tr('bypass_title'), subtext=_tr('bypass_sub'), default=True), Divider(text=_tr('hint'))]
        return items

    def _hook_methods(self, clazz, name, hook):
        unhooks = None
        try:
            unhooks = self.hook_all_methods(clazz, name, hook)
        except Exception:
            unhooks = None
        if unhooks:
            unhooks = list(unhooks)
        else:
            unhooks = []
            for m in _collect_methods(clazz, name):
                try:
                    m.setAccessible(True)
                    u = self.hook_method(m, hook)
                    if u:
                        unhooks.append(u)
                except Exception:
                    pass
        self._hooks.extend(unhooks)
        return unhooks

    @staticmethod
    def _filtered(hook_cls, method, expr, obj=None):
        if HookFilter is None or hook_filters is None:
            return hook_cls
        try:
            base = getattr(hook_cls, method)

            def wrapper(s, param, _f=base):
                return _f(s, param)
            if expr is None:
                return hook_cls
            if not isinstance(expr, str):
                cond = expr
            else:
                cond = HookFilter.Condition(expr, object=obj) if obj is not None else HookFilter.Condition(expr)
            new_cls = type(hook_cls.__name__ + 'Filtered', (hook_cls,), {method: hook_filters(cond)(wrapper)})
            return new_cls
        except Exception:
            return hook_cls

    def _present_hook(self):
        if self._foreign is None:
            return _PresentHook(self)
        return self._filtered(_PresentHook, 'before_hooked_method', 'object.contains(java.lang.System.identityHashCode(this))', self._foreign)(self)

    def _hook_all(self):
        dialogs = _class_obj('org.telegram.ui.DialogsActivity')
        base = _class_obj('org.telegram.ui.ActionBar.BaseFragment')
        if dialogs is None:
            return
        self._hook_methods(dialogs, 'onFragmentCreate', _FragmentCreateHook(self))
        self._hook_methods(dialogs, 'createView', _CreateViewHook(self))
        if not self._hook_methods(dialogs, 'showSearch', _PickerSearchHook(self)):
            pass
        self._hook_methods(dialogs, 'onResume', _PickerResumeHook(self))
        if not self._hook_methods(dialogs, 'openAccountSelector', _OpenSelectorHook(self)):
            pass
        if base is not None:
            self._hook_methods(base, 'presentFragment', self._present_hook())
        chat = _class_obj('org.telegram.ui.ChatActivity')
        if chat is not None and (not self._hook_methods(chat, 'openOriginalReplyChat', _OpenOriginalHook(self))):
            pass
        mo = _class_obj('org.telegram.messenger.MessageObject')
        if mo is not None:
            hook_cls = self._filtered(_SavedGotoHook, 'after_hooked_method', _MVEL_SAVED_GOTO)
            self._hook_methods(mo, 'needDrawShareButton', hook_cls(self))
        self._hook_unlock()

    def _hook_unlock(self):
        names = 0
        for cname in ('org.telegram.messenger.MessagesController', 'org.telegram.ui.ChatActivity'):
            clazz = _class_obj(cname)
            if clazz is None:
                continue
            for name in self._bool_methods_like(clazz, 'noforwards'):
                hook_cls = self._filtered(_NoForwardsHook, 'after_hooked_method', getattr(HookFilter, 'RESULT_IS_TRUE', None) if HookFilter is not None else None)
                if self._hook_methods(clazz, name, hook_cls(self, name)):
                    names += 1
        if not names:
            pass
        mo = _class_obj('org.telegram.messenger.MessageObject')
        if mo is not None:
            self._hook_methods(mo, 'canForwardMessage', self._filtered(_CanForwardHook, 'after_hooked_method', _MVEL_CAN_FORWARD)(self))
        chat = _class_obj('org.telegram.ui.ChatActivity')
        if chat is not None and (not self._hook_methods(chat, 'didSelectDialogs', _ChatSelectHook(self))):
            pass

    @staticmethod
    def _bool_methods_like(clazz, needle):
        out = []
        try:
            for m in _java_array_to_list(clazz.getDeclaredMethods()):
                try:
                    name = str(m.getName())
                    if needle in name.lower() and str(m.getReturnType().getName()) == 'boolean' and (name not in out):
                        out.append(name)
                except Exception:
                    pass
        except Exception:
            pass
        return out

    def _peer_nf(self, account, did):
        _NF_RAW.on = True
        try:
            mc = self._mc(account)
            if did < 0:
                chat = mc.getChat(-did)
                if chat is not None and bool(getattr(chat, 'noforwards', False)):
                    return True
            try:
                return bool(mc.isPeerNoForwards(int(did)))
            except Exception:
                return False
        finally:
            _NF_RAW.on = False

    def _take_protected_forward(self, chat, args):
        if not self._opt('enabled', True) or args is None or len(args) < 2:
            return False
        frag = args[0]
        da = _jcls('org.telegram.ui.DialogsActivity')
        if frag is None or da is None or (not isinstance(frag, da)):
            return False
        msgs = self._collect_messages(chat)
        if not msgs:
            return False
        if not any((self._restricted(m) for m in msgs)) and (not self._peer_nf(int(chat.getCurrentAccount()), int(msgs[0].getDialogId()))):
            return False
        ctx = self._ctx_for(frag)
        if ctx is None:
            return False
        return bool(self._on_dialogs_selected(ctx, args))

    def _register(self, frag, ctx, account):
        key = _ident(frag)
        ref = WeakReference(frag) if WeakReference is not None else None
        self._pickers[key] = {'ref': ref, 'ctx': ctx, 'acc': account}
        if self._foreign is not None:
            try:
                if account != ctx['src']:
                    self._foreign.add(Integer(key))
                else:
                    self._foreign.remove(Integer(key))
            except Exception:
                pass
        for k in list(self._pickers.keys()):
            r = self._pickers[k].get('ref')
            if r is not None and r.get() is None:
                self._pickers.pop(k, None)
                if self._foreign is not None:
                    try:
                        self._foreign.remove(Integer(k))
                    except Exception:
                        pass

    def _entry(self, frag):
        e = self._pickers.get(_ident(frag))
        if e is None:
            return None
        r = e.get('ref')
        if r is not None and r.get() is None:
            return None
        return e

    def _is_f2a(self, frag):
        try:
            args = frag.getArguments()
            return args is not None and args.getBoolean('f2a', False)
        except Exception:
            return False

    @staticmethod
    def _accounts():
        uc = jclass('org.telegram.messenger.UserConfig')
        out = []
        for a in range(int(uc.MAX_ACCOUNT_COUNT)):
            try:
                cfg = uc.getInstance(a)
                if cfg.isClientActivated():
                    out.append((int(cfg.loginTime), a))
            except Exception:
                pass
        out.sort()
        return [a for _, a in out]

    @staticmethod
    def _account_name(account):
        try:
            user = jclass('org.telegram.messenger.UserConfig').getInstance(account).getCurrentUser()
            return str(jclass('org.telegram.messenger.UserObject').getUserName(user))
        except Exception:
            return '#%d' % account

    def _prepare_picker(self, frag):
        if not self._opt('enabled', True):
            return
        args = frag.getArguments()
        if args is None:
            return
        if not args.getBoolean('onlySelect', False) or args.getInt('dialogsType', 0) != 3:
            return
        if args.getBoolean('quote', False) or args.getBoolean('reply_to', False):
            return
        if args.getBoolean('allowSwitchAccount', False) and (not args.getBoolean('f2a', False)):
            return
        if len(self._accounts()) < 2:
            return
        delegate = _get_field(frag, 'delegate')
        entry = self._entry(frag)
        chat_cls = _jcls('org.telegram.ui.ChatActivity')
        is_chat = delegate is not None and chat_cls is not None and isinstance(delegate, chat_cls)
        if entry is None and (not is_chat):
            return
        args.putBoolean('allowSwitchAccount', True)
        args.putBoolean('f2a', True)

    def _install_switch(self, frag):
        if not self._is_f2a(frag):
            return
        item = _get_field(frag, 'switchItem')
        if item is None:
            item = self._create_switch_item(frag)
        if item is None:
            return
        _set_field(frag, 'switchItem', item)
        item.setOnClickListener(_ClickProxy(lambda v: self._show_menu(frag, v)))
        item.setOnLongClickListener(_LongClickProxy(lambda v: self._show_menu(frag, v)))

    def _queue_switch_restore(self, frag):
        if not self._is_f2a(frag) or not self._opt('enabled', True):
            return
        epoch = self._switch_restore_epoch
        if epoch is None:
            return
        view = frag.getFragmentView()
        if view is None:
            return
        view_id = _ident(view)
        ref = WeakReference(frag) if WeakReference is not None else None

        def restore():
            if self._switch_restore_epoch is not epoch:
                return
            target = ref.get() if ref is not None else frag
            if target is None:
                return
            current_view = target.getFragmentView()
            if current_view is None or _ident(current_view) != view_id:
                return
            self._restore_switch(target)
        _ui(restore, 1)
        _ui(restore, 300)

    def _restore_switch(self, frag):
        if not self._is_f2a(frag) or not self._opt('enabled', True):
            return
        if bool(_get_field(frag, 'searching')) or bool(_get_field(frag, 'searchIsShowed')):
            return
        bar = frag.getActionBar()
        if bar is None:
            return
        try:
            if bar.isSearchFieldVisible():
                return
        except Exception:
            pass
        self._install_switch(frag)
        item = _get_field(frag, 'switchItem')
        if item is None:
            item = bar.createMenu().getItem(3882)
        if item is None:
            return
        changed = int(item.getVisibility()) != 0 or float(item.getAlpha()) < 0.99
        item.animate().cancel()
        item.setVisibility(0)
        item.setAlpha(1.0)
        item.requestLayout()
        if changed:
            pass

    def _create_switch_item(self, frag):
        try:
            AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
            LayoutHelper = jclass('org.telegram.ui.Components.LayoutHelper')
            BackupImageView = jclass('org.telegram.ui.Components.BackupImageView')
            AvatarDrawable = jclass('org.telegram.ui.Components.AvatarDrawable')
            ImageLocation = jclass('org.telegram.messenger.ImageLocation')
            Gravity = jclass('android.view.Gravity')
            menu = frag.getActionBar().createMenu()
            existing = menu.getItem(3882)
            if existing is not None:
                return existing
            item = menu.addItemWithWidth(3882, 0, AndroidUtilities.dp(56))
            acc = frag.getCurrentAccount()
            user = jclass('org.telegram.messenger.UserConfig').getInstance(acc).getCurrentUser()
            avatar = AvatarDrawable()
            avatar.setTextSize(AndroidUtilities.dp(12))
            avatar.setInfo(acc, user)
            image = BackupImageView(frag.getParentActivity())
            image.setRoundRadius(AndroidUtilities.dp(18))
            image.getImageReceiver().setCurrentAccount(acc)
            item.addView(image, LayoutHelper.createFrame(36, 36, Gravity.CENTER))
            image.setImage(ImageLocation.getForUserOrChat(user, ImageLocation.TYPE_SMALL), '50_50', avatar, user)
            return item
        except Exception:
            return None

    @staticmethod
    def _collect_messages(chat):
        out = []
        fwd = _get_field(chat, 'forwardingMessage')
        if fwd is not None:
            group = _get_field(chat, 'forwardingMessageGroup')
            if group is not None:
                try:
                    out.extend(_jlist(group.messages))
                except Exception:
                    out.append(fwd)
            else:
                out.append(fwd)
            return out
        arrays = _java_array_to_list(_get_field(chat, 'selectedMessagesIds'))
        for a in range(len(arrays) - 1, -1, -1):
            sparse = arrays[a]
            if sparse is None:
                continue
            pairs = []
            for i in range(int(sparse.size())):
                pairs.append((int(sparse.keyAt(i)), sparse.valueAt(i)))
            pairs.sort(key=lambda p: p[0])
            out.extend([p[1] for p in pairs if p[1] is not None])
        return out

    def _ctx_for(self, frag):
        entry = self._entry(frag)
        if entry is not None:
            return entry['ctx']
        delegate = _get_field(frag, 'delegate')
        chat_cls = _jcls('org.telegram.ui.ChatActivity')
        if delegate is None or chat_cls is None or (not isinstance(delegate, chat_cls)):
            return None
        msgs = self._collect_messages(delegate)
        ctx = {'src': int(delegate.getCurrentAccount()), 'msgs': msgs, 'origin': delegate, 'chat': delegate}
        self._register(frag, ctx, int(frag.getCurrentAccount()))
        return ctx

    def _show_menu(self, frag, anchor):
        ctx = self._ctx_for(frag)
        if ctx is None:
            return
        if not ctx['msgs']:
            return
        current = int(frag.getCurrentAccount())
        accounts = [a for a in self._accounts() if a != current]
        if not accounts:
            return
        if anchor is not None and self._show_item_options(frag, anchor, accounts, current):
            return
        self._show_dialog_menu(frag, accounts, current)

    def _show_item_options(self, frag, anchor, accounts, current):
        try:
            ItemOptions = jclass('org.telegram.ui.Components.ItemOptions')
            LayoutHelper = jclass('org.telegram.ui.Components.LayoutHelper')
            o = ItemOptions.makeOptions(frag, anchor)
            holder = {'o': o}
            for acc in accounts:
                btn = self._account_row(frag, acc, acc == current)
                if btn is None:
                    return False

                def _pick(_v, _acc=acc):
                    try:
                        holder['o'].dismiss()
                    except Exception:
                        pass
                    self._switch(frag, _acc)
                btn.setOnClickListener(_ClickProxy(_pick))
                o.addView(btn, LayoutHelper.createLinear(230, 48))
            try:
                AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
                Theme = jclass('org.telegram.ui.ActionBar.Theme')
                dp = AndroidUtilities.dp
                bg = Theme.createRoundRectDrawable(dp(24), frag.getThemedColor(Theme.key_windowBackgroundWhite))
                bg.getPaint().setShadowLayer(dp(6), 0, dp(1), Theme.multAlpha(-16777216, 0.15))
                o.setViewAdditionalOffsets(-dp(4), -dp(4), -dp(4), -dp(4))
                o.setScrimViewBackground(bg)
                o.translate(0, -dp(4))
            except Exception:
                pass
            o.setGravity(jclass('android.view.Gravity').RIGHT)
            o.show()
            return True
        except Exception:
            return False

    def _account_row(self, frag, account, selected):
        try:
            btn = frag.accountView(account, selected)
            if btn is not None:
                return btn
        except Exception:
            pass
        try:
            ctx = frag.getParentActivity()
            AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
            dp = AndroidUtilities.dp
            Theme = jclass('org.telegram.ui.ActionBar.Theme')
            LayoutHelper = jclass('org.telegram.ui.Components.LayoutHelper')
            BackupImageView = jclass('org.telegram.ui.Components.BackupImageView')
            AvatarDrawable = jclass('org.telegram.ui.Components.AvatarDrawable')
            LinearLayout = jclass('android.widget.LinearLayout')
            FrameLayout = jclass('android.widget.FrameLayout')
            TextView = jclass('android.widget.TextView')
            GradientDrawable = jclass('android.graphics.drawable.GradientDrawable')
            Gravity = jclass('android.view.Gravity')
            TextUtils = jclass('android.text.TextUtils')
            user = jclass('org.telegram.messenger.UserConfig').getInstance(account).getCurrentUser()
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            try:
                row.setBackground(Theme.createRadSelectorDrawable(frag.getThemedColor(Theme.key_listSelector), 0, 0))
            except Exception:
                pass
            container = FrameLayout(ctx)
            if selected:
                ring = GradientDrawable()
                ring.setShape(GradientDrawable.OVAL)
                ring.setColor(0)
                try:
                    accent = frag.getThemedColor(Theme.key_featuredStickers_addButton)
                except Exception:
                    accent = -14575885
                ring.setStroke(max(1, int(round(dp(1.33)))), accent)
                container.setBackground(ring)
            row.addView(container, LayoutHelper.createLinear(34, 34, Gravity.CENTER_VERTICAL, 12, 0, 0, 0))
            avatar = AvatarDrawable()
            try:
                avatar.setInfo(account, user)
            except Exception:
                avatar.setInfo(user)
            image = BackupImageView(ctx)
            image.setRoundRadius(dp(16))
            if selected:
                image.setScaleX(0.833)
                image.setScaleY(0.833)
            image.getImageReceiver().setCurrentAccount(account)
            try:
                image.setForUserOrChat(user, avatar)
            except Exception:
                ImageLocation = jclass('org.telegram.messenger.ImageLocation')
                image.setImage(ImageLocation.getForUserOrChat(user, ImageLocation.TYPE_SMALL), '50_50', avatar, user)
            container.addView(image, LayoutHelper.createFrame(32, 32, Gravity.CENTER))
            text = TextView(ctx)
            text.setTextSize(1, 16)
            text.setTextColor(frag.getThemedColor(Theme.key_dialogTextBlack))
            text.setText(self._account_name(account))
            text.setMaxLines(2)
            text.setEllipsize(TextUtils.TruncateAt.END)
            row.addView(text, LayoutHelper.createLinear(0, -2, 1.0, Gravity.CENTER_VERTICAL, 13, 0, 14, 0))
            return row
        except Exception:
            return None

    def _show_dialog_menu(self, frag, accounts, current):
        Builder = jclass('org.telegram.ui.ActionBar.AlertDialog$Builder')
        names = []
        for acc in accounts:
            n = self._account_name(acc)
            names.append(('✓ ' if acc == current else '') + n)
        b = Builder(frag.getParentActivity())
        b.setTitle(_tr('menu_title'))
        b.setItems(names, _DlgClickProxy(lambda which: self._switch(frag, accounts[which])))
        frag.showDialog(b.create())

    def _switch(self, frag, account):
        current = int(frag.getCurrentAccount())
        if account == current:
            return
        ctx = self._ctx_for(frag)
        if ctx is None:
            return
        DialogsActivity = jclass('org.telegram.ui.DialogsActivity')
        Bundle = jclass('android.os.Bundle')
        args = Bundle(frag.getArguments())
        new = DialogsActivity(args)
        new.setCurrentAccount(account)
        if account == ctx['src']:
            new.setDelegate(ctx['origin'])
        else:
            new.setDelegate(_ForwardDelegate(self, ctx))
        self._register(new, ctx, account)
        frag.presentFragment(new, True)

    def _fix_child_account(self, frag, args):
        entry = self._entry(frag)
        if entry is None or args is None or len(args) == 0:
            return
        child = args[0]
        base = _jcls('org.telegram.ui.ActionBar.BaseFragment')
        if child is None or base is None or (not isinstance(child, base)):
            return
        if self._entry(child) is not None:
            return
        acc = entry['acc']
        if int(child.getCurrentAccount()) == acc or child.getFragmentView() is not None:
            return
        try:
            child.setCurrentAccount(acc)
        except Exception:
            pass

    def _on_dialogs_selected(self, ctx, args):
        frag = args[0]
        dids = args[1]
        message = args[2] if len(args) > 2 else None
        notify = bool(args[4]) if len(args) > 4 else True
        schedule = int(args[5]) if len(args) > 5 else 0
        account = int(frag.getCurrentAccount())
        targets = []
        for i in range(int(dids.size())):
            k = dids.get(i)
            targets.append((int(k.dialogId), int(getattr(k, 'topicId', 0) or 0)))
        comment = str(message) if message is not None and len(str(message).strip()) > 0 else None
        self._clear_chat_selection(ctx)
        _ui(lambda: frag.finishFragment())
        job = {'acc': account, 'src': ctx['src'], 'msgs': list(ctx['msgs']), 'notify': notify, 'schedule': schedule, 'ok': 0, 'fail': 0, 'restricted': 0, 'unsupported': 0, 'errors': []}
        steps = []
        for did, topic in targets:
            if comment:
                steps.append(lambda nxt, d=did, t=topic: self._send_text(job, d, t, comment, nxt))
            steps.append(lambda nxt, d=did, t=topic: self._forward_to(job, d, t, nxt))
        threading.Thread(target=_Runner(steps, lambda: self._report(job)).next, name='F2ASend').start()
        return True

    def _clear_chat_selection(self, ctx):
        chat = ctx.get('chat')
        if chat is None:
            return

        def _clear():
            if _get_field(chat, 'forwardingMessage') is not None:
                _set_field(chat, 'forwardingMessage', None)
                _set_field(chat, 'forwardingMessageGroup', None)
                return
            for name in ('selectedMessagesIds', 'selectedMessagesCanCopyIds', 'selectedMessagesCanStarIds'):
                for sparse in _java_array_to_list(_get_field(chat, name)):
                    try:
                        sparse.clear()
                    except Exception:
                        pass
            for m in ('hideActionMode', 'updateVisibleRows'):
                _call_private(chat, m, [], [])
        _ui(_clear)

    def _report(self, job):
        pass

    @staticmethod
    def _mc(account):
        return jclass('org.telegram.messenger.MessagesController').getInstance(account)

    def _apply_common(self, job, req, topic, reply_flag):
        req.silent = not job['notify']
        if job['schedule']:
            req.schedule_date = job['schedule']
            req.flags |= 1024
        if topic and reply_flag:
            rt = TLRPC.TL_inputReplyToMessage()
            rt.reply_to_msg_id = topic
            rt.top_msg_id = topic
            rt.flags |= 1
            req.reply_to = rt
            req.flags |= 1

    def _on_updates(self, job, response):
        if response is not None and isinstance(response, TLRPC.Updates):
            self._mc(job['acc']).processUpdates(response, False)

    def _fail(self, job, n, error):
        job['fail'] += n
        job['errors'].append(_err_text(error))

    def _send_text(self, job, did, topic, text, nxt, entities=None, count=False):
        req = TLRPC.TL_messages_sendMessage()
        req.peer = self._mc(job['acc']).getInputPeer(did)
        req.message = text
        req.random_id = _rand()
        if entities is not None and entities.size() > 0:
            req.entities = entities
            req.flags |= 8
        self._apply_common(job, req, topic, True)

        def cb(response, error):
            if error is None and response is not None:
                self._on_updates(job, response)
                if count:
                    job['ok'] += 1
            elif count:
                self._fail(job, 1, error)
            else:
                job['errors'].append(_err_text(error))
            nxt()
        _rpc(job['acc'], req, cb)

    @staticmethod
    def _restricted(msg):
        try:
            if msg.messageOwner.noforwards:
                return True
        except Exception:
            pass
        return _msg_ttl(msg) > 0

    def _source_chat(self, job, msgs):
        try:
            did = int(msgs[0].getDialogId())
            if did < 0:
                return self._mc(job['src']).getChat(-did)
        except Exception:
            pass
        return None

    def _forward_to(self, job, did, topic, nxt):
        msgs = [m for m in job['msgs'] if m is not None]
        allowed = [m for m in msgs if not self._restricted(m)]
        src_chat = self._source_chat(job, msgs)
        if src_chat is not None and bool(getattr(src_chat, 'noforwards', False)):
            allowed = []
        try:
            if allowed and self._peer_nf(job['src'], int(msgs[0].getDialogId())):
                allowed = []
        except Exception:
            pass
        protected = [m for m in msgs if m not in allowed]
        if protected:
            done = nxt
            if allowed:
                done = lambda: self._forward_allowed(job, did, topic, allowed, src_chat, nxt)
            self._on_forward_restricted(job, did, topic, protected, done, 'pre-check')
            return
        self._forward_allowed(job, did, topic, allowed, src_chat, nxt)

    def _forward_allowed(self, job, did, topic, allowed, src_chat, nxt):
        ChatObject = jclass('org.telegram.messenger.ChatObject')
        if self._opt('copy_only', False):
            self._copy_all(job, did, topic, allowed, nxt)
            return
        native = src_chat is not None and bool(ChatObject.isChannel(src_chat))
        if not native:
            self._relay_forward(job, did, topic, allowed, nxt)
            return

        def after_peer(peer):
            if peer is None:
                self._relay_forward(job, did, topic, allowed, nxt)
                return
            self._native_forward(job, did, topic, allowed, peer, nxt)
        self._resolve_source_peer(job, src_chat, after_peer)

    @staticmethod
    def _me(account):
        return jclass('org.telegram.messenger.UserConfig').getInstance(account).getCurrentUser()

    def _user_peer(self, account, user, cb):
        mc = self._mc(account)
        uid = int(user.id)
        local = mc.getUser(Long(uid))
        if local is not None and int(getattr(local, 'access_hash', 0) or 0) != 0 and (not bool(getattr(local, 'min', False))):
            cb(mc.getInputPeer(uid))
            return
        username = None
        try:
            username = jclass('org.telegram.messenger.UserObject').getPublicUsername(user)
        except Exception:
            username = getattr(user, 'username', None)

        def by_phone():
            phone = str(getattr(user, 'phone', '') or '')
            if not phone:
                cb(None)
                return
            try:
                req = TLRPC.TL_contacts_resolvePhone()
            except Exception:
                cb(None)
                return
            req.phone = phone

            def on_phone(response, error):
                if error is not None or response is None:
                    cb(None)
                    return
                try:
                    mc.putUsers(response.users, False)
                except Exception:
                    pass
                ok = mc.getUser(Long(uid)) is not None
                cb(mc.getInputPeer(uid) if ok else None)
            _rpc(account, req, on_phone)
        if not username:
            by_phone()
            return
        req = TLRPC.TL_contacts_resolveUsername()
        req.username = str(username)

        def on_name(response, error):
            if error is not None or response is None:
                by_phone()
                return
            try:
                mc.putUsers(response.users, False)
            except Exception:
                pass
            ok = mc.getUser(Long(uid)) is not None
            if ok:
                cb(mc.getInputPeer(uid))
            else:
                by_phone()
        _rpc(account, req, on_name)

    @staticmethod
    def _sent_ids(response, randoms):
        by_random = {}
        new_ids = []
        ups = getattr(response, 'updates', None)
        if ups is None:
            return []
        for i in range(int(ups.size())):
            u = ups.get(i)
            name = str(u.getClass().getSimpleName())
            try:
                if name == 'TL_updateMessageID':
                    by_random[int(u.random_id)] = int(u.id)
                elif name.startswith('TL_updateNewMessage') or name.startswith('TL_updateNewChannelMessage'):
                    new_ids.append(int(u.message.id))
            except Exception:
                pass
        ordered = [by_random[r] for r in randoms if r in by_random]
        return ordered if ordered else sorted(new_ids)

    def _relay_forward(self, job, did, topic, msgs, nxt):
        src, acc = (job['src'], job['acc'])
        a_user, b_user = (self._me(src), self._me(acc))
        if a_user is None or b_user is None:
            self._copy_all(job, did, topic, msgs, nxt)
            return
        b_id = int(b_user.id)
        src_did = int(msgs[0].getDialogId())

        def fallback(reason):
            self._copy_all(job, did, topic, msgs, nxt)

        def step1(peer_b_in_a):
            if peer_b_in_a is None:
                fallback('target account user unknown to source account')
                return
            req = TLRPC.TL_messages_forwardMessages()
            req.from_peer = self._mc(src).getInputPeer(src_did)
            req.to_peer = peer_b_in_a
            ids = ArrayList()
            rnd = ArrayList()
            randoms = []
            for m in msgs:
                ids.add(Integer(int(m.getId())))
                r = _rand()
                randoms.append(r)
                rnd.add(Long(r))
            req.id = ids
            req.random_id = rnd
            req.silent = True
            t0 = int(time.time())

            def on_a(response, error):
                if error is not None or response is None:
                    et = _err_text(error)
                    if 'FORWARDS_RESTRICTED' in et:
                        self._on_forward_restricted(job, did, topic, msgs, nxt, 'relay A: %s' % et)
                        return
                    fallback('A.forwardMessages: %s' % et)
                    return
                relay_ids = self._sent_ids(response, randoms)
                try:
                    self._mc(src).processUpdates(response, False)
                except Exception:
                    pass
                self._user_peer(acc, a_user, lambda peer_a_in_b: step2(peer_a_in_b, relay_ids, t0))
            _rpc(src, req, on_a)

        def step2(peer_a_in_b, relay_ids, t0, attempt=0):
            if peer_a_in_b is None:
                self._relay_cleanup(src, b_id, relay_ids)
                fallback('source account user unknown to target account')
                return
            req = TLRPC.TL_messages_getHistory()
            req.peer = peer_a_in_b
            req.limit = len(msgs) + 10

            def on_hist(response, error):
                found = []
                if error is None and response is not None:
                    try:
                        for tm in _jlist(response.messages):
                            if bool(getattr(tm, 'out', False)):
                                continue
                            if int(getattr(tm, 'date', 0) or 0) < t0 - 10:
                                continue
                            found.append(int(tm.id))
                    except Exception:
                        pass
                if len(found) < len(msgs):
                    if attempt < 10:
                        threading.Timer(0.4, lambda: step2(peer_a_in_b, relay_ids, t0, attempt + 1)).start()
                        return
                    self._relay_cleanup(src, b_id, relay_ids)
                    fallback('relay messages not visible in target account (found %d/%d)' % (len(found), len(msgs)))
                    return
                b_ids = sorted(found)[-len(msgs):]
                step3(peer_a_in_b, b_ids, relay_ids)
            _rpc(acc, req, on_hist)

        def step3(peer_a_in_b, b_ids, relay_ids):
            req = TLRPC.TL_messages_forwardMessages()
            req.from_peer = peer_a_in_b
            req.to_peer = self._mc(acc).getInputPeer(did)
            ids = ArrayList()
            rnd = ArrayList()
            randoms = []
            for i in b_ids:
                ids.add(Integer(i))
                r = _rand()
                randoms.append(r)
                rnd.add(Long(r))
            req.id = ids
            req.random_id = rnd
            req.drop_author = self._opt('drop_author', False)
            req.silent = not job['notify']
            if topic:
                req.top_msg_id = topic
                req.flags |= 512
            if job['schedule']:
                req.schedule_date = job['schedule']
                req.flags |= 1024

            def on_b(response, error):
                self._relay_cleanup(src, b_id, relay_ids)
                if error is not None or response is None:
                    et = _err_text(error)
                    if 'FORWARDS_RESTRICTED' in et:
                        self._on_forward_restricted(job, did, topic, msgs, nxt, 'relay B: %s' % et)
                        return
                    fallback('B.forwardMessages: %s' % et)
                    return
                self._patch_saved_header(job, did, response, randoms, msgs, force=True)
                self._on_updates(job, response)
                job['ok'] += len(msgs)
                nxt()
            _rpc(acc, req, on_b)
        self._user_peer(src, b_user, step1)

    def _relay_cleanup(self, src, b_id, relay_ids):
        if not relay_ids:
            return
        mc = self._mc(src)
        ids = ArrayList()
        for i in relay_ids:
            ids.add(Integer(i))

        def via_tl():
            req = TLRPC.TL_messages_deleteMessages()
            req.id = ids
            req.revoke = True

            def cb(response, error):
                pass
            _rpc(src, req, cb)

        def via_controller():
            for args in ((ids, None, None, b_id, 0, True, 0), (ids, None, None, b_id, True, 0), (ids, None, None, b_id, True, False)):
                try:
                    mc.deleteMessages(*args)
                    return
                except Exception:
                    pass
            via_tl()
        _ui(via_controller)

    def _resolve_source_peer(self, job, src_chat, cb):
        mc = self._mc(job['acc'])
        chat_id = int(src_chat.id)
        local = mc.getChat(chat_id)
        if local is not None and int(local.access_hash) != 0 and (not bool(getattr(local, 'min', False))):
            cb(mc.getInputPeer(-chat_id))
            return
        username = None
        try:
            username = jclass('org.telegram.messenger.ChatObject').getPublicUsername(src_chat)
        except Exception:
            username = getattr(src_chat, 'username', None)
        if not username:
            cb(None)
            return
        req = TLRPC.TL_contacts_resolveUsername()
        req.username = str(username)

        def on_resolved(response, error):
            if error is not None or response is None:
                cb(None)
                return
            try:
                mc.putUsers(response.users, False)
                mc.putChats(response.chats, False)
            except Exception:
                pass
            local2 = mc.getChat(chat_id)
            cb(mc.getInputPeer(-chat_id) if local2 is not None else None)
        _rpc(job['acc'], req, on_resolved)

    def _native_forward(self, job, did, topic, msgs, from_peer, nxt):
        chunks = [msgs[i:i + 100] for i in range(0, len(msgs), 100)]
        state = {'i': 0}

        def send_chunk():
            if state['i'] >= len(chunks):
                nxt()
                return
            chunk = chunks[state['i']]
            state['i'] += 1
            req = TLRPC.TL_messages_forwardMessages()
            req.from_peer = from_peer
            req.to_peer = self._mc(job['acc']).getInputPeer(did)
            ids = ArrayList()
            rnd = ArrayList()
            randoms = []
            for m in chunk:
                ids.add(Integer(int(m.getId())))
                r = _rand()
                randoms.append(r)
                rnd.add(Long(r))
            req.id = ids
            req.random_id = rnd
            req.drop_author = self._opt('drop_author', False)
            req.silent = not job['notify']
            if topic:
                req.top_msg_id = topic
                req.flags |= 512
            if job['schedule']:
                req.schedule_date = job['schedule']
                req.flags |= 1024

            def cb(response, error):
                if error is None and response is not None:
                    self._patch_saved_header(job, did, response, randoms, chunk)
                    self._on_updates(job, response)
                    job['ok'] += len(chunk)
                    send_chunk()
                    return
                text = _err_text(error)
                if 'FORWARDS_RESTRICTED' in text:
                    self._on_forward_restricted(job, did, topic, chunk, send_chunk, 'native: %s' % text)
                    return
                rest = [m for c in chunks[state['i'] - 1:] for m in c]
                state['i'] = len(chunks)
                self._relay_forward(job, did, topic, rest, nxt)
            _rpc(job['acc'], req, cb)
        send_chunk()

    def _patch_saved_header(self, job, did, response, randoms, src_msgs, force=False):
        try:
            me = self._me(job['acc'])
            if me is None or int(me.id) != int(did):
                return
            if not self._opt('saved_goto', True):
                return
            new_ids = self._sent_ids(response, randoms)
            by_new = {}
            for i, nid in enumerate(new_ids):
                if i < len(src_msgs):
                    by_new[nid] = src_msgs[i]
            ups = getattr(response, 'updates', None)
            if ups is None:
                return
            patched = 0
            for i in range(int(ups.size())):
                u = ups.get(i)
                m = getattr(u, 'message', None)
                if m is None:
                    continue
                fwd = getattr(m, 'fwd_from', None)
                src = by_new.get(int(m.id))
                if fwd is None or src is None:
                    continue
                if fwd.saved_from_peer is not None and int(fwd.saved_from_msg_id or 0) != 0 and (not force):
                    continue
                src_did = int(src.getDialogId())
                peer = self._peer_of_dialog(job['src'], src_did)
                if peer is None:
                    continue
                fwd.saved_from_peer = peer
                fwd.saved_from_msg_id = int(src.getId())
                fwd.flags |= 16
                patched += 1
                uids = []
                fid = getattr(fwd, 'from_id', None)
                if fid is not None and int(getattr(fid, 'user_id', 0) or 0) != 0:
                    uids.append(int(fid.user_id))
                self._share_peers(job['src'], job['acc'], src_did, uids)
        except Exception:
            pass

    @staticmethod
    def _tl_clone(obj, base):
        SerializedData = jclass('org.telegram.tgnet.SerializedData')
        out = SerializedData(int(obj.getObjectSize()))
        obj.serializeToStream(out)
        inp = SerializedData(out.toByteArray())
        return base.TLdeserialize(inp, inp.readInt32(False), False)

    def _share_peers(self, src, acc, chat_did, user_ids):
        a_mc, b_mc = (self._mc(src), self._mc(acc))
        chats, users = (ArrayList(), ArrayList())
        try:
            if chat_did < 0 and b_mc.getChat(Long(-chat_did)) is None:
                chat = a_mc.getChat(Long(-chat_did))
                if chat is not None:
                    c = self._tl_clone(chat, TLRPC.Chat)
                    c.min = True
                    c.left = True
                    c.access_hash = 0
                    chats.add(c)
            for uid in user_ids:
                if b_mc.getUser(Long(uid)) is not None:
                    continue
                user = a_mc.getUser(Long(uid))
                if user is None:
                    continue
                u = self._tl_clone(user, TLRPC.User)
                u.min = True
                u.access_hash = 0
                users.add(u)
            if chats.size() == 0 and users.size() == 0:
                return
            for c in _jlist(chats):
                b_mc.putChat(c, True)
            for u in _jlist(users):
                b_mc.putUser(u, True)
            try:
                jclass('org.telegram.messenger.MessagesStorage').getInstance(acc).putUsersAndChats(users, chats, True, True)
            except Exception:
                pass
        except Exception:
            pass

    def _reachable(self, account, dialog_id):
        try:
            mc = self._mc(account)
            if dialog_id > 0:
                return mc.getUser(Long(dialog_id)) is not None
            chat = mc.getChat(Long(-dialog_id))
            if chat is None:
                return False
            ChatObject = jclass('org.telegram.messenger.ChatObject')
            if ChatObject.isNotInChat(chat) and (not ChatObject.isPublic(chat)):
                return False
            return True
        except Exception:
            return False

    @staticmethod
    def _peer_of_dialog(account, dialog_id):
        if dialog_id > 0:
            p = TLRPC.TL_peerUser()
            p.user_id = dialog_id
            return p
        chat = None
        try:
            chat = jclass('org.telegram.messenger.MessagesController').getInstance(account).getChat(-dialog_id)
        except Exception:
            pass
        if chat is not None and bool(jclass('org.telegram.messenger.ChatObject').isChannel(chat)):
            p = TLRPC.TL_peerChannel()
            p.channel_id = -dialog_id
            return p
        p = TLRPC.TL_peerChat()
        p.chat_id = -dialog_id
        return p

    @staticmethod
    def _entities(owner):
        out = ArrayList()
        try:
            for e in _jlist(owner.entities):
                if isinstance(e, (TLRPC.TL_messageEntityMentionName, TLRPC.TL_inputMessageEntityMentionName)):
                    continue
                out.add(e)
        except Exception:
            pass
        return out

    @staticmethod
    def _input_media(owner):
        media = getattr(owner, 'media', None)
        if media is None or isinstance(media, (TLRPC.TL_messageMediaEmpty, TLRPC.TL_messageMediaWebPage)):
            return None
        if int(getattr(media, 'ttl_seconds', 0) or 0) > 0:
            return 'unsupported'
        if isinstance(media, TLRPC.TL_messageMediaPhoto) and isinstance(getattr(media, 'photo', None), TLRPC.TL_photo):
            ip = TLRPC.TL_inputPhoto()
            ip.id = media.photo.id
            ip.access_hash = media.photo.access_hash
            ip.file_reference = media.photo.file_reference
            im = TLRPC.TL_inputMediaPhoto()
            im.id = ip
            im.spoiler = bool(getattr(media, 'spoiler', False))
            return im
        if isinstance(media, TLRPC.TL_messageMediaDocument) and isinstance(getattr(media, 'document', None), TLRPC.TL_document):
            idoc = TLRPC.TL_inputDocument()
            idoc.id = media.document.id
            idoc.access_hash = media.document.access_hash
            idoc.file_reference = media.document.file_reference
            im = TLRPC.TL_inputMediaDocument()
            im.id = idoc
            im.spoiler = bool(getattr(media, 'spoiler', False))
            return im
        if isinstance(media, TLRPC.TL_messageMediaVenue):
            im = TLRPC.TL_inputMediaVenue()
            gp = TLRPC.TL_inputGeoPoint()
            gp.lat = media.geo.lat
            gp._long = media.geo._long
            im.geo_point = gp
            im.title = media.title
            im.address = media.address
            im.provider = media.provider
            im.venue_id = media.venue_id
            im.venue_type = media.venue_type or ''
            return im
        if isinstance(media, TLRPC.TL_messageMediaGeo):
            im = TLRPC.TL_inputMediaGeoPoint()
            gp = TLRPC.TL_inputGeoPoint()
            gp.lat = media.geo.lat
            gp._long = media.geo._long
            im.geo_point = gp
            return im
        if isinstance(media, TLRPC.TL_messageMediaContact):
            im = TLRPC.TL_inputMediaContact()
            im.phone_number = media.phone_number
            im.first_name = media.first_name
            im.last_name = media.last_name
            im.vcard = media.vcard or ''
            return im
        return 'unsupported'

    def _on_forward_restricted(self, job, did, topic, msgs, nxt, where):
        if not self._opt('bypass_protect', True):
            ttl_msgs = [m for m in msgs if _msg_ttl(m) > 0]
            skipped = len(msgs) - len(ttl_msgs)
            if skipped:
                job['restricted'] += skipped
            if not ttl_msgs:
                nxt()
                return
            self._copy_protected(job, did, topic, ttl_msgs, nxt)
            return
        self._copy_protected(job, did, topic, msgs, nxt)

    @staticmethod
    def _needs_file(msg):
        media = getattr(msg.messageOwner, 'media', None)
        if isinstance(media, TLRPC.TL_messageMediaPhoto):
            return isinstance(getattr(media, 'photo', None), TLRPC.TL_photo)
        if isinstance(media, TLRPC.TL_messageMediaDocument):
            if not isinstance(getattr(media, 'document', None), TLRPC.TL_document):
                return False
            try:
                if msg.isSticker() or msg.isAnimatedSticker() or msg.isAnimatedEmoji():
                    return False
            except Exception:
                pass
            return True
        return False

    def _copy_protected(self, job, did, topic, msgs, nxt):
        steps = []
        for m in msgs:
            if self._needs_file(m):
                steps.append(lambda n, m=m: self._reupload(job, did, m, n, topic))
            else:
                steps.append(lambda n, m=m: self._copy_one(job, did, topic, m, n, False))
        _Runner(steps, nxt).next()

    def _units(self, msgs):
        units = []
        for m in msgs:
            gid = 0
            try:
                gid = int(m.messageOwner.grouped_id)
            except Exception:
                pass
            if gid and units and (units[-1][0] == gid):
                units[-1][1].append(m)
            else:
                units.append((gid, [m]))
        return units

    def _copy_all(self, job, did, topic, msgs, nxt):
        steps = []
        for gid, unit in self._units(msgs):
            if gid and len(unit) > 1:
                steps.append(lambda n, u=unit: self._copy_album(job, did, topic, u, n, True))
            else:
                steps.append(lambda n, m=unit[0]: self._copy_one(job, did, topic, m, n, True))
        _Runner(steps, nxt).next()

    @staticmethod
    def _media_error(text):
        return any((k in text for k in ('FILE_REFERENCE', 'MEDIA_EMPTY', 'MEDIA_INVALID', 'PHOTO_INVALID', 'DOCUMENT_INVALID', 'FILE_ID_INVALID')))

    def _copy_one(self, job, did, topic, msg, nxt, allow_refresh):
        owner = msg.messageOwner
        media = self._input_media(owner)
        text = str(owner.message or '')
        ttl = _msg_ttl(msg)
        if ttl > 0:
            if self._needs_file(msg):
                self._reupload(job, did, msg, nxt, topic)
            else:
                job['unsupported'] += 1
                nxt()
            return
        if media == 'unsupported':
            job['unsupported'] += 1
            nxt()
            return
        if media is None:
            if not text:
                job['unsupported'] += 1
                nxt()
                return
            self._send_text(job, did, topic, text, nxt, self._entities(owner), count=True)
            return
        req = TLRPC.TL_messages_sendMedia()
        req.peer = self._mc(job['acc']).getInputPeer(did)
        req.media = media
        req.message = text
        req.random_id = _rand()
        ents = self._entities(owner)
        if ents.size() > 0:
            req.entities = ents
            req.flags |= 8
        self._apply_common(job, req, topic, True)

        def cb(response, error):
            if error is None and response is not None:
                self._on_updates(job, response)
                job['ok'] += 1
                nxt()
                return
            et = _err_text(error)
            if self._media_error(et) and allow_refresh:
                self._refresh(job, [msg], lambda fresh: self._copy_one(job, did, topic, fresh[0], nxt, False))
                return
            if self._media_error(et) or 'FORWARDS_RESTRICTED' in et:
                self._reupload(job, did, msg, nxt, topic)
                return
            self._fail(job, 1, error)
            nxt()
        _rpc(job['acc'], req, cb)

    def _copy_album(self, job, did, topic, msgs, nxt, allow_refresh):
        items = ArrayList()
        for m in msgs:
            media = self._input_media(m.messageOwner)
            if media is None or media == 'unsupported':
                self._copy_all_single(job, did, topic, msgs, nxt)
                return
            sm = TLRPC.TL_inputSingleMedia()
            sm.media = media
            sm.random_id = _rand()
            sm.message = str(m.messageOwner.message or '')
            ents = self._entities(m.messageOwner)
            if ents.size() > 0:
                sm.entities = ents
                sm.flags |= 1
            items.add(sm)
        req = TLRPC.TL_messages_sendMultiMedia()
        req.peer = self._mc(job['acc']).getInputPeer(did)
        req.multi_media = items
        self._apply_common(job, req, topic, True)

        def cb(response, error):
            if error is None and response is not None:
                self._on_updates(job, response)
                job['ok'] += len(msgs)
                nxt()
                return
            et = _err_text(error)
            if self._media_error(et) and allow_refresh:
                self._refresh(job, msgs, lambda fresh: self._copy_album(job, did, topic, fresh, nxt, False))
                return
            self._copy_all_single(job, did, topic, msgs, nxt)
        _rpc(job['acc'], req, cb)

    def _copy_all_single(self, job, did, topic, msgs, nxt):
        steps = [lambda n, m=m: self._copy_one(job, did, topic, m, n, True) for m in msgs]
        _Runner(steps, nxt).next()

    def _refresh(self, job, msgs, cb):
        src = job['src']
        mc = self._mc(src)
        did = int(msgs[0].getDialogId())
        ids = ArrayList()
        for m in msgs:
            ids.add(Integer(int(m.getId())))
        src_chat = self._source_chat(job, msgs)
        if src_chat is not None and bool(jclass('org.telegram.messenger.ChatObject').isChannel(src_chat)):
            req = TLRPC.TL_channels_getMessages()
            req.channel = mc.getInputChannel(-did)
            req.id = ids
        else:
            req = TLRPC.TL_messages_getMessages()
            req.id = ids
        MessageObject = jclass('org.telegram.messenger.MessageObject')

        def on_resp(response, error):
            fresh = []
            if error is None and response is not None:
                by_id = {}
                try:
                    for tm in _jlist(response.messages):
                        by_id[int(tm.id)] = tm
                except Exception:
                    pass
                for m in msgs:
                    tm = by_id.get(int(m.getId()))
                    if tm is not None and (not isinstance(tm, TLRPC.TL_messageEmpty)):
                        try:
                            fresh.append(MessageObject(src, tm, False, False))
                            continue
                        except Exception:
                            pass
                    fresh.append(m)
            else:
                fresh = list(msgs)
            cb(fresh)
        _rpc(src, req, on_resp)

    def _local_path(self, msg):
        File = jclass('java.io.File')
        FileLoader = jclass('org.telegram.messenger.FileLoader')
        fl = FileLoader.getInstance(_msg_account(msg))
        owner = msg.messageOwner
        cands = []
        try:
            if owner.attachPath:
                cands.append(str(owner.attachPath))
        except Exception:
            pass
        for getter in (lambda: fl.getPathToMessage(owner), lambda: fl.getPathToMessage(owner, True)):
            try:
                f = getter()
                if f is not None:
                    cands.append(str(f.getAbsolutePath()))
            except Exception:
                pass
        attach = self._attach(owner)
        if attach is not None:
            for flag in (True, False):
                try:
                    f = fl.getPathToAttach(attach, flag)
                    if f is not None:
                        cands.append(str(f.getAbsolutePath()))
                except Exception:
                    pass
        for p in cands:
            try:
                jf = File(p)
                if jf.exists() and jf.length() > 0:
                    return p
            except Exception:
                pass
        for p in cands:
            try:
                if File(p + '.enc').exists():
                    out = self._decrypt_enc(p)
                    if out is not None:
                        return out
            except Exception:
                pass
        return None

    @staticmethod
    def _decrypt_enc(path):
        File = jclass('java.io.File')
        FileLoader = jclass('org.telegram.messenger.FileLoader')
        EFIS = jclass('org.telegram.messenger.secretmedia.EncryptedFileInputStream')
        enc = File(path + '.enc')
        icache = FileLoader.getInternalCacheDir()
        key = None
        for name in (enc.getName() + '.key', File(path).getName() + '.key'):
            k = File(icache, name)
            if k.exists():
                key = k
                break
        if key is None:
            return None
        out = File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE), 'f2a_' + File(path).getName())
        if out.exists() and out.length() > 0:
            return str(out.getAbsolutePath())
        FOS = jclass('java.io.FileOutputStream')
        ins = EFIS(enc, key)
        os_ = FOS(out)
        try:
            buf = jarray(jbyte)(65536)
            while True:
                n = ins.read(buf, 0, 65536)
                if n is None or n < 0:
                    break
                os_.write(buf, 0, n)
        finally:
            try:
                ins.close()
            except Exception:
                pass
            os_.close()
        return str(out.getAbsolutePath()) if out.length() > 0 else None

    @staticmethod
    def _attach(owner):
        media = getattr(owner, 'media', None)
        if media is None:
            return None
        if isinstance(media, TLRPC.TL_messageMediaDocument):
            return media.document
        if isinstance(media, TLRPC.TL_messageMediaPhoto) and media.photo is not None:
            try:
                AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
                return jclass('org.telegram.messenger.FileLoader').getClosestPhotoSizeWithSize(media.photo.sizes, AndroidUtilities.getPhotoSize())
            except Exception:
                return None
        return None

    def _start_download(self, msg):
        FileLoader = jclass('org.telegram.messenger.FileLoader')
        fl = FileLoader.getInstance(_msg_account(msg))
        owner = msg.messageOwner
        media = owner.media
        prio = int(getattr(FileLoader, 'PRIORITY_HIGH', 3))
        if isinstance(media, TLRPC.TL_messageMediaDocument):
            fl.loadFile(media.document, msg, prio, 0)
        elif isinstance(media, TLRPC.TL_messageMediaPhoto):
            size = self._attach(owner)
            ImageLocation = jclass('org.telegram.messenger.ImageLocation')
            fl.loadFile(ImageLocation.getForPhoto(size, media.photo), msg, 'jpg', prio, 0)

    def _send_local(self, job, did, topic, msg, path):
        acc = job['acc']
        SMH = jclass('org.telegram.messenger.SendMessagesHelper')
        Params = jclass('org.telegram.messenger.SendMessagesHelper$SendMessageParams')
        owner = msg.messageOwner
        media = owner.media
        caption = str(owner.message or '')
        ents = self._entities(owner)
        notify = bool(job['notify'])
        sched = int(job['schedule'] or 0)
        if topic:
            pass
        helper = SMH.getInstance(acc)
        if isinstance(media, TLRPC.TL_messageMediaPhoto):
            photo = helper.generatePhotoSizes(path, None)
            if photo is None:
                raise Exception('generatePhotoSizes returned null')
            photo.date = int(time.time())
            params = Params.of(photo, path, int(did), None, None, caption, ents, None, None, notify, sched, 0, 0, None, False)
        else:
            src = media.document
            doc = TLRPC.TL_document()
            doc.flags = src.flags
            doc.file_reference = jarray(jbyte)([])
            doc.dc_id = -2147483648
            doc.user_id = src.user_id
            doc.mime_type = src.mime_type
            doc.file_name = src.file_name
            doc.date = int(time.time())
            doc.size = int(jclass('java.io.File')(path).length())
            doc.thumbs = src.thumbs
            doc.video_thumbs = src.video_thumbs
            doc.attributes = src.attributes
            doc.localPath = path
            try:
                if msg.isGif():
                    doc.mime_type = 'video/mp4'
            except Exception:
                pass
            params = Params.of(doc, None, path, int(did), None, None, caption, ents, None, None, notify, sched, 0, 0, None, None, False)
        try:
            params.hasMediaSpoilers = bool(getattr(media, 'spoiler', False))
            params.invert_media = bool(getattr(owner, 'invert_media', False))
        except Exception:
            pass
        done = threading.Event()
        box = {}

        def run():
            try:
                helper.sendMessage(params)
            except Exception as e:
                box['e'] = e
            done.set()
        _ui(run)
        done.wait(15)
        if 'e' in box:
            raise box['e']

    def _reupload(self, job, did, msg, nxt, topic=0):

        def worker():
            path = self._local_path(msg)
            if path is None:
                try:
                    self._start_download(msg)
                except Exception:
                    pass
                deadline = time.time() + 180
                while path is None and time.time() < deadline:
                    time.sleep(0.5)
                    path = self._local_path(msg)
            if path is None:
                self._fail(job, 1, None)
                nxt()
                return
            try:
                self._send_local(job, did, topic, msg, path)
                job['ok'] += 1
                time.sleep(1.0)
                nxt()
                return
            except Exception:
                pass
            caption = str(msg.messageOwner.message or '') or None
            try:
                import client_utils as cu
                media = msg.messageOwner.media
                if isinstance(media, TLRPC.TL_messageMediaPhoto):
                    cu.send_photo(did, path, caption=caption, account=job['acc'])
                elif msg.isVideo():
                    cu.send_video(did, path, caption=caption, account=job['acc'])
                else:
                    cu.send_document(did, path, caption=caption, account=job['acc'])
                job['ok'] += 1
                time.sleep(1.0)
            except Exception:
                self._fail(job, 1, None)
            nxt()
        threading.Thread(target=worker, name='F2AReupload').start()
_NF_RAW = threading.local()

def _msg_ttl(msg):
    try:
        media = msg.messageOwner.media
        return int(getattr(media, 'ttl_seconds', 0) or 0) if media is not None else 0
    except Exception:
        return 0

def _msg_account(msg):
    try:
        return int(msg.currentAccount)
    except Exception:
        return int(jclass('org.telegram.messenger.UserConfig').selectedAccount)
