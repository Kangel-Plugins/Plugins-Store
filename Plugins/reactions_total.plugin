import time
import traceback

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from android_utils import log, run_on_ui_thread
from ui.settings import Header, Switch, Selector, Input, Divider

__id__ = "reactions_total"
__name__ = "Reactions Total"
__description__ = "Сумма реакций в строке под постом, рядом с просмотрами и пересылками / Total reactions next to views and forwards"
__author__ = "Daxo-Developer @Daxo_OS"
__version__ = "2.0.0"
__min_version__ = "12.10.6"
__icon__ = "DaxoOS/1"

POS_LEFT, POS_RIGHT = 0, 1
LABELS = ["\u2665", "\u03a3", ""]
SEP = " \u00b7 "

_cfg_cache = {"t": 0.0, "v": None}
_seen_errors = set()
_state = {}
# подпись, которую мы подменили на время построения ячейки: key -> [исходное значение, глубина вызова]
_pending = {}


def notify(text):
    def show():
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info(text)
        except Exception as e:
            log("reactions_total notify: %s" % e)
    try:
        run_on_ui_thread(show)
    except Exception as e:
        log("reactions_total notify: %s" % e)


def report(where, e):
    key = where + str(e)
    if key in _seen_errors:
        return
    _seen_errors.add(key)
    log("reactions_total %s: %s\n%s" % (where, e, traceback.format_exc()))


def items(lst):
    if lst is None:
        return []
    return [lst.get(i) for i in range(lst.size())]


def fmt_count(n, compact):
    if not compact or n < 1000:
        return str(n)
    if n < 1000000:
        s, suffix = n / 1000.0, "K"
    else:
        s, suffix = n / 1000000.0, "M"
    return ("%.1f" % s).rstrip("0").rstrip(".") + suffix


def reactions_total(msg, skip_paid):
    try:
        r = msg.messageOwner.reactions
        if r is None or r.results is None:
            return 0
        total = 0
        for rc in items(r.results):
            if skip_paid and rc.reaction is not None:
                if "Paid" in str(rc.reaction.getClass().getSimpleName()):
                    continue
            total += int(rc.count)
        return total
    except Exception as e:
        report("total", e)
        return 0


def make_signature(cfg, total, current):
    tag = (LABELS[cfg["style"]] + fmt_count(total, cfg["compact"])).strip()
    if not current:
        return tag
    if cfg["position"] == POS_LEFT:
        return tag + SEP + current
    return current + SEP + tag


class ContentHook(MethodHook):
    # Подпись канала ячейка выводит в строке с просмотрами и временем,
    # поэтому на время сборки ячейки дописываем счётчик к post_author
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            cfg = self.plugin.cfg()
            if not cfg["enabled"]:
                return
            msg = param.args[0]
            owner = msg.messageOwner
            key = owner.hashCode()
            slot = _pending.get(key)
            if slot is not None:
                slot[1] += 1
                return
            total = reactions_total(msg, cfg["skip_paid"])
            if total < max(1, cfg["min_count"]):
                return
            if cfg["only_channels"] and not owner.post:
                return
            orig = owner.post_author
            current = str(orig) if orig is not None else ""
            owner.post_author = make_signature(cfg, total, current)
            _pending[key] = [orig, 1]
            if cfg["debug"] and not _state.get("debug_shown"):
                _state["debug_shown"] = True
                notify("Reactions Total: хук сработал, реакций %d" % total)
        except Exception as e:
            report("before", e)

    def after_hooked_method(self, param):
        try:
            owner = param.args[0].messageOwner
            key = owner.hashCode()
            slot = _pending.get(key)
            if slot is None:
                return
            slot[1] -= 1
            if slot[1] <= 0:
                owner.post_author = slot[0]
                _pending.pop(key, None)
        except Exception as e:
            report("after", e)


class ReactionsTotalPlugin(BasePlugin):
    def hook_by_name(self, cls, name, hook):
        count = 0
        try:
            for m in cls.getDeclaredMethods():
                if str(m.getName()) == name:
                    self.hook_method(m, hook)
                    count += 1
        except Exception as e:
            report("hook_method " + name, e)
        if count == 0:
            try:
                self.hook_all_methods(cls, name, hook)
                count = -1
            except Exception as e:
                report("hook_all_methods " + name, e)
        return count

    def on_plugin_load(self):
        cls = find_class("org.telegram.ui.Cells.ChatMessageCell")
        if cls is None:
            log("reactions_total: ChatMessageCell не найден")
            notify("Reactions Total: ChatMessageCell не найден")
            return
        hook = ContentHook(self)
        ok = False
        for name in ("setMessageContent", "setMessageObject"):
            n = self.hook_by_name(cls, name, hook)
            log("reactions_total: %s hooked=%s" % (name, n))
            ok = ok or n != 0
        if not ok:
            notify("Reactions Total: не удалось поставить хуки, смотрите логи")

    def cfg(self):
        now = time.time()
        if _cfg_cache["v"] is not None and now - _cfg_cache["t"] < 0.5:
            return _cfg_cache["v"]
        try:
            min_count = int(str(self.get_setting("min_count", "1")).strip() or 1)
        except ValueError:
            min_count = 1
        v = {
            "enabled": bool(self.get_setting("enabled", True)),
            "position": int(self.get_setting("position", POS_LEFT)),
            "style": min(2, max(0, int(self.get_setting("style", 0)))),
            "compact": bool(self.get_setting("compact", False)),
            "only_channels": bool(self.get_setting("only_channels", False)),
            "skip_paid": bool(self.get_setting("skip_paid", False)),
            "debug": bool(self.get_setting("debug", False)),
            "min_count": min_count,
        }
        _cfg_cache["v"] = v
        _cfg_cache["t"] = now
        return v

    def create_settings(self):
        return [
            Header(text="Сумма реакций"),
            Switch(key="enabled", text="Включить", default=True),
            Selector(key="position", text="Позиция в строке", default=POS_LEFT,
                     items=["Перед подписью (рядом с просмотрами)", "После подписи"]),
            Divider(),
            Header(text="Вид"),
            Selector(key="style", text="Значок", default=0, items=["\u2665", "\u03a3", "Только число"]),
            Switch(key="compact", text="Сокращать числа", subtext="1200 \u2192 1.2K", default=False),
            Divider(),
            Header(text="Фильтры"),
            Switch(key="only_channels", text="Только посты каналов", default=False),
            Switch(key="skip_paid", text="Не считать платные реакции (звёзды)", default=False),
            Input(key="min_count", text="Показывать от N реакций", default="1"),
            Divider(),
            Switch(key="debug", text="Отладка", subtext="Один раз покажет уведомление, когда хук сработает", default=False),
        ]
