_LOG_PATH = None; _LOG_LOCK = threading.Lock()
_LOG_Q_MAX = 512
_LOG_ROTATE_BYTES = 4 * 1024 * 1024
_LOG_Q = collections.deque(maxlen=_LOG_Q_MAX)
_LOG_DROPPED = 0
_LOG_WRITER = None
_LOG_WRITER_RUN = True
def _cd_on_main_thread():
    try:
        return threading.current_thread() is threading.main_thread()
    except Exception:
        return False
def _log_rotate(path, limit):
    try:
        if path and os.path.exists(path) and os.path.getsize(path) > limit:
            bak = path + ".1"
            try:
                if os.path.exists(bak): os.remove(bak)
            except Exception: pass
            os.replace(path, bak)
    except Exception: pass
def _log_flush():
    n = 0
    try:
        if not _LOG_Q: return 0
        batch = []
        while True:
            try: batch.append(_LOG_Q.popleft())
            except IndexError: break
        if not batch: return 0
        with _LOG_LOCK:
            if _LOG_PATH:
                try:
                    _log_rotate(_LOG_PATH, _LOG_ROTATE_BYTES)
                    with open(_LOG_PATH, "a", encoding="utf-8") as f:
                        for ln in batch:
                            f.write(ln + "\n"); n += 1
                except Exception: pass
        for ln in batch:
            try: print(f"[Culprit] {ln}")
            except Exception: pass
    except Exception: pass
    return n
def _log_writer_loop():
    while globals().get("_LOG_WRITER_RUN"):
        try: _log_flush()
        except Exception: pass
        try: _exc_rate_flush_if_dirty()
        except Exception: pass
        try: time.sleep(0.5)
        except Exception: return
    try: _exc_rate_flush_if_dirty(force=True)
    except Exception: pass
    try: _log_flush()
    except Exception: pass
def _log_writer_ensure():
    global _LOG_WRITER
    try:
        if _LOG_WRITER is not None and _LOG_WRITER.is_alive(): return
        if not globals().get("_LOG_WRITER_RUN"): return
        t = threading.Thread(target=_log_writer_loop, name="culprit-log-writer", daemon=True)
        _LOG_WRITER = t; t.start()
    except Exception:
        _LOG_WRITER = None
def _init_log():
    global _LOG_PATH, _LOG_WRITER_RUN
    _LOG_WRITER_RUN = True
    try:
        d = File(_DIR)
        if not d.exists(): d.mkdirs()
        _LOG_PATH = File(d, f"breadcrumb_{int(time.time())}.log").getAbsolutePath()
    except Exception: _LOG_PATH = None
    _log_writer_ensure()
def _log(msg):
    global _LOG_DROPPED
    line = f"[{time.strftime('%H:%M:%S')}] {msg}"
    if _cd_on_main_thread():
        try:
            if len(_LOG_Q) >= _LOG_Q_MAX: _LOG_DROPPED += 1
            _LOG_Q.append(line)
        except Exception: pass
        _log_writer_ensure()
        return
    try:
        if _LOG_Q: _log_flush()
    except Exception: pass
    with _LOG_LOCK:
        if _LOG_PATH:
            try:
                _log_rotate(_LOG_PATH, _LOG_ROTATE_BYTES)
                with open(_LOG_PATH, "a", encoding="utf-8") as f: f.write(line + "\n")
            except Exception: pass
    try: print(f"[Culprit] {line}")
    except Exception: pass

_Slot = None
_REG_BUF = None
_REG_ADDR = 0
if _CTYPES_OK:
    try:
        class _Slot(ctypes.Structure):
            _fields_ = [("tid", ctypes.c_int64),
                        ("pid_idx", ctypes.c_int32),
                        ("seq", ctypes.c_int32)]
        _REG_BUF = (_Slot * _REG_N)()
        _REG_ADDR = ctypes.addressof(_REG_BUF)
    except Exception:
        _Slot = None; _REG_BUF = None; _REG_ADDR = 0


_PID_IDX = {}; _IDX_PID = []; _INTERN_LOCK = threading.RLock()
def _pidindex_path():
    return _data_path(_PIDINDEX_FILE)
def _persist_pidindex():
    p = _pidindex_path()
    if not p: return
    try:
        with _INTERN_LOCK:
            data = list(_IDX_PID)
        _atomic_json_write(p, data)
    except Exception:
        pass
_IDXNAMES_FILE = "idx_names.json"
def _idxnames_path():
    return _data_path(_IDXNAMES_FILE)
_IDXNAMES_GEN = 0
def _persist_idxnames():
    p = _idxnames_path()
    if not p: return
    try:
        with _INTERN_LOCK:
            names = list(_IDX_PID)
        cur = {}
        try:
            with open(p, "r", encoding="utf-8") as f:
                old = json.load(f)
            if isinstance(old, dict):
                cur = {str(k): v for k, v in old.items() if isinstance(v, str) and v}
        except Exception:
            cur = {}
        global _IDXNAMES_GEN
        for idx, nm in enumerate(names):
            if isinstance(nm, str) and nm:
                prev = cur.get(str(idx))
                if prev is None:
                    cur[str(idx)] = nm
                elif prev != nm:
                    cur[str(idx)] = nm
                    _IDXNAMES_GEN += 1
                    try: _log("Block#2 idx-sidecar remap idx=%d %r->%r (gen=%d)" % (idx, prev, nm, _IDXNAMES_GEN))
                    except Exception: pass
        _atomic_json_write(p, cur)
    except Exception:
        pass
def _resolve_idx_durable(i):
    if i is None or i < 0: return None
    p = _idxnames_path()
    if not p: return None
    try:
        with open(p, "r", encoding="utf-8") as f:
            m = json.load(f)
        if isinstance(m, dict):
            v = m.get(str(i))
            return v if (isinstance(v, str) and v) else None
    except Exception:
        pass
    return None
_CANON_CACHE = {}
def _canon_pid(pid):
    if not isinstance(pid, str) or not pid:
        return pid
    cached = _CANON_CACHE.get(pid)
    if cached is not None:
        return cached
    try:
        for m in list(_sys.modules.values()):
            try:
                if getattr(m, "__name__", None) == pid:
                    cid = getattr(m, "__id__", None)
                    if isinstance(cid, str) and cid:
                        _CANON_CACHE[pid] = cid
                        return cid
            except Exception:
                pass
    except Exception:
        pass
    return pid
def _jni_name_register(idx, name):
    try:
        fn = globals().get("_JNI_OWNER_REGISTER")
        if fn is not None:
            fn(int(idx), name.encode("utf-8"))
    except Exception:
        pass

def _b34_art_diagnostic(texts, proc_pid, exit_ts):
    try:
        proc_pid = int(proc_pid); exit_ts = int(exit_ts)
        if proc_pid <= 0 or exit_ts <= 0: return None
    except Exception:
        return None
    rx = re.compile(r"^\s*\d\d-\d\d\s+\d\d:\d\d:\d\d\.\d+\s+(\d+)\s+(\d+)\s+F\s+[^:]+:\s*(.*)$")
    rows = []
    for text in texts or []:
        for line in (text or "").splitlines():
            m = rx.match(line)
            if not m or int(m.group(1)) != proc_pid: continue
            ts = _b28_logcat_event_ts(line, exit_ts)
            if ts is None or not (-1000 <= exit_ts - ts <= 15000): continue
            rows.append((int(ts), int(m.group(2)), m.group(3)))
    banners = [r for r in rows if "gc tried to mark invalid reference" in r[2].lower()
               or "jni detected error" in r[2].lower()]
    if not banners: return None
    ts, tid, msg = max(banners, key=lambda r: r[0])
    parts = [msg]
    for t, d, body in rows:
        if d == tid and 0 <= t - ts <= 1000 and body != msg and len(parts) < 8:
            if re.search(r"\b(?:ref|holder)\s*=", body) and body not in parts:
                parts.append(body)
    rec = {"abort_message": " ".join(parts)[:2000], "abort_message_src": "fatal_logcat_pid_time",
           "art_diagnostic_pid": proc_pid, "art_diagnostic_tid": tid,
           "art_diagnostic_ts": ts, "art_diagnostic_delta_ms": exit_ts - ts,
           "cause_proven": False}
    _parse_abort_structured(rec)
    return rec

def _b34_apply_art_diagnostic(v, rec):
    if not rec: return
    v.update(rec)
    if (rec.get("abort_flags") or {}).get("gc_mark_invalid_ref"):
        v.update(heap_corruption=True, abort_family="art_heap_corruption",
                 cause="ART GC detected an invalid reference; origin of corruption unproven",
                 culprit="unknown", culprit_kind="unknown", confidence="low", attribution=False,
                 correlation_kind="art_diagnostic_pid_time", cause_proven=False)
        for k in ("conclusion", "safe_mode_conclusion", "boot_window_suspect", "boot_window_plugins"):
            v.pop(k, None)

def _trc_jni_owner(cap):
    try:
        if not cap.get("complete") or int(cap.get("jni_context_valid") or 0) != 1: return None
        if int(cap.get("pid") or 0) <= 0 or int(cap.get("tid") or 0) <= 0: return None
        if int(cap.get("abort_tid") or 0) != int(cap["tid"]): return None
        now = int(cap["mono_ms"]); start = int(cap["jni_begin_mono_ms"]); abort = int(cap["abort_mono_ms"])
        if not (0 < start <= abort <= now and now - abort <= 3000): return None
        owner = cap.get("jni_owner_name") or ""
        if not owner or re.search(r"[\s=]", owner) or int(cap.get("jni_owner_idx", -1)) < 0: return None
        op = cap.get("jni_op") or ""
        if op not in ("NewGlobalRef", "DeleteGlobalRef"): return None
        msg = cap.get("abort_message") or ""
        low = msg.lower()
        if "jni detected error" not in low or "gc tried to mark" in low or op.lower() not in low: return None
        ref = int(cap["jni_ref"], 16)
        if ref == 0: return None
        calls = re.findall(r"\b(?:NewGlobalRef|DeleteGlobalRef)\b", msg)
        if not calls or any(c != op for c in calls): return None
        matches = re.finditer(r"(?:invalid|deleted|stale|bad)\s+(?:(?:weak\s+)?(?:global|local)\s+)?(?:reference|jobject)\b[^\n]{0,64}?\b(0x[0-9a-f]+)\b", low)
        if not any(int(m.group(1), 16) == ref for m in matches): return None
        return {"plugin": owner, "idx": int(cap["jni_owner_idx"]), "src": "rejected-jni-argument",
                "conf": "high", "op": op, "ref": cap["jni_ref"]}
    except Exception:
        return None

def _intern(pid):
    if not (isinstance(pid, str) and pid):
        return -1
    with _INTERN_LOCK:
        i = _PID_IDX.get(pid)
        if i is not None:
            return i
    try: pid = _canon_pid(pid)
    except Exception: pass
    if not (isinstance(pid, str) and pid):
        return -1
    _grew = None
    with _INTERN_LOCK:
        i = _PID_IDX.get(pid)
        if i is None:
            i = len(_IDX_PID); _IDX_PID.append(pid); _PID_IDX[pid] = i
            _grew = len(_IDX_PID)
    if _grew is not None:
        _jni_name_register(i, pid)
        _PERSIST_IO_LOCK.acquire()
        try:
            try: _persist_pidindex()
            except Exception: pass
            try: _persist_idxnames()
            except Exception: pass
        finally:
            try: _PERSIST_IO_LOCK.release()
            except Exception: pass
        _publish_pid_count(_grew)
    return i
def _deidx_name(name):
    try:
        if isinstance(name, str) and len(name) > 1 and name[0] == "#" and name[1:].isdigit():
            nm = _resolve_idx_durable(int(name[1:]))
            if nm:
                return nm
    except Exception:
        pass
    return name

def _resolve_idx(i):
    if i is None or i < 0: return None
    with _INTERN_LOCK:
        return _IDX_PID[i] if 0 <= i < len(_IDX_PID) else None
def _mn_read_json_both(path):
    out = []
    try:
        _mp = _aw_mirror_path(path) if path else None
    except Exception:
        _mp = None
    for _fp in (path, _mp):
        if not _fp:
            continue
        try:
            with open(_fp, "r", encoding="utf-8") as _f:
                out.append(json.load(_f))
        except Exception:
            pass
    return out
def _load_pidindex():
    saved = []
    p = _pidindex_path()
    for _pi_blob in _mn_read_json_both(p):
        try:
            _lst = list(_pi_blob)
        except Exception:
            continue
        if len([x for x in _lst if isinstance(x, str) and x]) > len([x for x in saved if isinstance(x, str) and x]):
            saved = _lst
    sidecar = {}
    sp = _idxnames_path()
    _maps = [_mm for _mm in _mn_read_json_both(sp) if isinstance(_mm, dict)]
    _maps.sort(key=len)
    for _mm in _maps:
        for k, v in _mm.items():
            try:
                if isinstance(v, str) and v:
                    sidecar[int(k)] = v
            except Exception:
                pass
    if sidecar and len(sidecar) > len([x for x in saved if isinstance(x, str) and x]):
        n = max(sidecar) + 1
        if all(j in sidecar for j in range(n)):
            saved = [sidecar[j] for j in range(n)]
    with _INTERN_LOCK:
        if _IDX_PID:
            return
        for nm in saved:
            idx = len(_IDX_PID)
            _IDX_PID.append(nm)
            if isinstance(nm, str) and nm and nm not in _PID_IDX:
                _PID_IDX[nm] = idx
        try: _persist_idxnames()
        except Exception: pass

def _cur_tid():
    if _NATIVE_OK and _NLIB is not None:
        try: return int(_NLIB.cd_gettid())
        except Exception: pass
    return None

def _reg_get(tid):
    if tid is None: return None
    if _NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_reg_lookup_tid"):
        try:
            res = int(_NLIB.cd_reg_lookup_tid(ctypes.c_int64(int(tid))))
            return res if res >= 0 else None
        except Exception:
            pass
    return None

_EXC_RATE = {}
_EXC_RATE_LOCK = threading.Lock()
_EXC_RATE_WINDOW_MS = 60000
_EXC_RATE_MAXKEEP = 240
_EXC_RATE_HOT = 30.0
_EXC_RATE_DIRTY = {}
_EXC_RATE_DIRTY_LOCK = threading.Lock()
_EXC_RATE_FLUSH_LOCK = threading.Lock()
_EXC_RATE_LAST_FLUSH = 0.0
_EXC_RATE_REFRESH_S = 1.0
_EXC_RATE_DIRTY_MAX = 256
_EXC_RATE_ID_FIELDS = ("culprit", "where", "py_file", "py_line", "reason", "symbol")

def _exc_rate_identity(kind, ts, rec):
    return (kind, ts) + tuple(rec.get(k) for k in _EXC_RATE_ID_FIELDS)

def _exc_rate_refresh_note(kind, base_ts, rec):
    fields = {k: rec.get(k) for k in ("throws_per_min", "throws_in_window", "high_rate")}
    fields["rate_ts"] = rec["ts"]
    ident = _exc_rate_identity(kind, base_ts, rec)
    with _EXC_RATE_DIRTY_LOCK:
        if ident in _EXC_RATE_DIRTY or len(_EXC_RATE_DIRTY) < _EXC_RATE_DIRTY_MAX:
            _EXC_RATE_DIRTY[ident] = fields
    try:
        with _RECENT_VERDICTS_LOCK:
            for item in _RECENT_VERDICTS:
                if (item.get("kind") == kind and item.get("ts") == base_ts
                        and all(item.get(k) == rec.get(k) for k in
                                ("culprit", "where", "py_file", "py_line"))):
                    item.update(fields)
    except Exception:
        pass

def _exc_rate_flush_if_dirty(force=False):
    global _EXC_RATE_LAST_FLUSH
    if not _EXC_RATE_FLUSH_LOCK.acquire(blocking=force):
        return
    try:
        now = time.monotonic()
        with _EXC_RATE_DIRTY_LOCK:
            if not _EXC_RATE_DIRTY or (not force and now - _EXC_RATE_LAST_FLUSH < _EXC_RATE_REFRESH_S):
                return
            batch = dict(_EXC_RATE_DIRTY)
            _EXC_RATE_DIRTY.clear()
            _EXC_RATE_LAST_FLUSH = now
        failed = {}
        for kind in ("hook", "pyerr"):
            updates = {k: v for k, v in batch.items() if k[0] == kind}
            if not updates:
                continue
            try:
                path = _hook_verdict_path() if kind == "hook" else _pyerr_verdict_path()
                limit = _HOOK_FAILS_MAX if kind == "hook" else _PYERR_FAILS_MAX
                with _PERSIST_IO_LOCK:
                    rp = _rc_read_path(path) if path else None
                    if not rp:
                        continue
                    with open(rp, "r", encoding="utf-8") as f:
                        rows = json.load(f)
                    if not isinstance(rows, list):
                        continue
                    changed = False
                    for item in rows:
                        if not isinstance(item, dict):
                            continue
                        fields = updates.get(_exc_rate_identity(kind, item.get("ts"), item))
                        if fields and fields["rate_ts"] >= (item.get("rate_ts") or item.get("ts") or 0):
                            item.update(fields)
                            changed = True
                    if changed and _atomic_json_write(path, rows, limit) is False:
                        raise OSError("exception rate refresh write failed")
            except Exception:
                failed.update(updates)
        if failed:
            with _EXC_RATE_DIRTY_LOCK:
                for ident, fields in failed.items():
                    if ident not in _EXC_RATE_DIRTY and len(_EXC_RATE_DIRTY) < _EXC_RATE_DIRTY_MAX:
                        _EXC_RATE_DIRTY[ident] = fields
    finally:
        _EXC_RATE_FLUSH_LOCK.release()

def _exc_rate_record(culprit):
    if not culprit: return (0.0, 0)
    now = int(time.time() * 1000)
    try:
        with _EXC_RATE_LOCK:
            lst = _EXC_RATE.get(culprit)
            if lst is None: lst = _EXC_RATE[culprit] = []
            lst.append(now)
            cut = now - _EXC_RATE_WINDOW_MS
            drop = 0
            for _ts in lst:
                if _ts >= cut: break
                drop += 1
            if drop: del lst[:drop]
            if len(lst) > _EXC_RATE_MAXKEEP: del lst[:len(lst) - _EXC_RATE_MAXKEEP]
            n = len(lst)
            span = (lst[-1] - lst[0]) if n >= 2 else 0
            per_min = (n * 60000.0 / span) if span > 0 else float(n)
            return (round(per_min, 2), n)
    except Exception:
        return (0.0, 0)

_ARM_OK = False
_PIDCOUNT_OK = False
_SEED_OK = False
_JP_ARM_SEED = False
def _publish_pid_count(n):
    if not (_PIDCOUNT_OK and _NLIB is not None): return
    try: _NLIB.cd_reg_set_pid_count(int(n))
    except Exception: pass
def _scoped_arm(pid):
    if not (_ARM_OK and _NLIB is not None): return False
    try:
        _NLIB.cd_scope_arm(int(_intern(pid))); return True
    except Exception:
        return False
def _scoped_arm_clear():
    if not (_ARM_OK and _NLIB is not None): return
    try: _NLIB.cd_scope_arm_clear()
    except Exception: pass

_MARKW_OK = False
def _scoped_mark_worker():
    if not (_MARKW_OK and _NLIB is not None): return False
    try:
        return int(_NLIB.cd_scope_mark_worker()) == 0
    except Exception:
        return False

def _scoped_seed_arm(pid):
    if not (_SEED_OK and _NLIB is not None): return False
    try:
        return int(_NLIB.cd_seed_arm(int(_intern(pid)))) == 0
    except Exception:
        return False

_OD_LAST_ENTRY = {}
_OD_ENTRY_GEN = [0]
_OD_ENTRY_FLUSHED = [0]
_OD_OWNER_CHANGED = [False]
_OD_LAST_FLUSH_MS = [0]
def _scoped_set(pid):
    tid = _cur_tid()
    if tid is None: return False
    idx = _intern(pid)
    if _SCOPE_OK and _NLIB is not None:
        try: _NLIB.cd_scope_enter(int(idx))
        except Exception: pass
        try:
            _od_prev = _OD_LAST_ENTRY.get(tid)
            _OD_LAST_ENTRY[tid] = (pid, int(time.time() * 1000))
            _OD_ENTRY_GEN[0] += 1
            if _od_prev is None or _od_prev[0] != pid:
                _OD_OWNER_CHANGED[0] = True
        except Exception:
            pass
        return True
    return False
def _scoped_clear():
    if _SCOPE_OK and _NLIB is not None:
        try: _NLIB.cd_scope_leave()
        except Exception: pass
        return
    return

_DIRECT_LOCK = threading.Lock()
_DIRECT_BYTES = {}
_DIRECT_TOTAL = 0
_DIRECT_UNTAGGED = 0
_DIRECT_LIVE = {}
_DIRECT_LIVE_TOTAL = 0
_DIRECT_LIVE_UNTAGGED = 0
_DIRECT_REGS = {}
_DIRECT_REG_LOCK = threading.Lock()
_DIRECT_RQ = None
_WeakReference = None
_SysClass = None
_DIRECT_REAPER = None
_DIRECT_REAPER_STOP = None

def _direct_snapshot():
    with _DIRECT_LOCK:
        return {
            "total": _DIRECT_TOTAL, "untagged": _DIRECT_UNTAGGED, "by_pid": dict(_DIRECT_BYTES),
            "live_total": _DIRECT_LIVE_TOTAL, "live_untagged": _DIRECT_LIVE_UNTAGGED,
            "live_by_pid": dict(_DIRECT_LIVE),
        }

def _direct_pid_now():
    try:
        idx = _reg_get(_cur_tid())
        if idx is not None and idx >= 0:
            return _resolve_idx(idx)
    except Exception:
        pass
    return None

def _direct_register(obj, nbytes):
    global _DIRECT_TOTAL, _DIRECT_UNTAGGED, _DIRECT_LIVE_TOTAL, _DIRECT_LIVE_UNTAGGED
    try:
        n = int(nbytes)
    except Exception:
        return
    if n <= 0:
        return
    pid = _direct_pid_now()
    with _DIRECT_LOCK:
        _DIRECT_TOTAL += n
        if pid is None: _DIRECT_UNTAGGED += n
        else: _DIRECT_BYTES[pid] = _DIRECT_BYTES.get(pid, 0) + n
    reg_ok = False
    if obj is not None and _DIRECT_RQ is not None and _WeakReference is not None and _SysClass is not None:
        try:
            wr = _WeakReference(obj, _DIRECT_RQ)
            ihc = int(_SysClass.identityHashCode(wr))
            with _DIRECT_REG_LOCK:
                _DIRECT_REGS.setdefault(ihc, []).append([wr, pid, n])
            reg_ok = True
        except Exception:
            reg_ok = False
    if reg_ok:
        with _DIRECT_LOCK:
            _DIRECT_LIVE_TOTAL += n
            if pid is None: _DIRECT_LIVE_UNTAGGED += n
            else: _DIRECT_LIVE[pid] = _DIRECT_LIVE.get(pid, 0) + n

def _direct_reaper(stop_evt):
    global _DIRECT_LIVE_TOTAL, _DIRECT_LIVE_UNTAGGED
    if _DIRECT_RQ is None or _SysClass is None:
        return
    while not stop_evt.is_set():
        ref = None
        try:
            ref = _DIRECT_RQ.remove(500)
        except Exception:
            ref = None
        if ref is None:
            continue
        rec = None
        try:
            ihc = int(_SysClass.identityHashCode(ref))
            with _DIRECT_REG_LOCK:
                bucket = _DIRECT_REGS.get(ihc)
                if bucket:
                    for i in range(len(bucket)):
                        try:
                            if bucket[i][0].equals(ref):
                                rec = bucket.pop(i); break
                        except Exception:
                            pass
                    if not bucket:
                        _DIRECT_REGS.pop(ihc, None)
        except Exception:
            rec = None
        if rec is not None:
            _, pid, cap = rec
            with _DIRECT_LOCK:
                _DIRECT_LIVE_TOTAL = max(0, _DIRECT_LIVE_TOTAL - cap)
                if pid is None:
                    _DIRECT_LIVE_UNTAGGED = max(0, _DIRECT_LIVE_UNTAGGED - cap)
                else:
                    v = _DIRECT_LIVE.get(pid, 0) - cap
                    if v > 0: _DIRECT_LIVE[pid] = v
                    else: _DIRECT_LIVE.pop(pid, None)

def _direct_live_start():
    global _DIRECT_RQ, _WeakReference, _SysClass, _DIRECT_REAPER, _DIRECT_REAPER_STOP
    if _DIRECT_RQ is not None:
        return True
    wref = _jc("java.lang.ref.WeakReference")
    rq   = _jc("java.lang.ref.ReferenceQueue")
    sysc = _jc("java.lang.System")
    if not (wref and rq and sysc):
        _log("Block#3D: live-tracking недоступен (нет WeakReference/ReferenceQueue/System)")
        return False
    _WeakReference = wref; _SysClass = sysc
    try:
        _DIRECT_RQ = rq()
    except Exception as e:
        _log(f"Block#3D: ReferenceQueue init err: {e}"); _DIRECT_RQ = None; return False
    _DIRECT_REAPER_STOP = threading.Event()
    _DIRECT_REAPER = threading.Thread(target=_direct_reaper, args=(_DIRECT_REAPER_STOP,), name="culprit-direct-reaper", daemon=True)
    _DIRECT_REAPER.start()
    return True

_LEAK_FILE_NAME = "leak_verdict.json"
_LEAK_FAILS_MAX = 20
_LEAK_DEDUP_MS = 60000
_LEAK_SEEN = {}; _LEAK_SEEN_LOCK = threading.Lock()
_BLOCK27_ON = True
_BLOCK27_VG_ON = False
_VIEW_REGS = {}
_VIEW_REG_LOCK = threading.Lock()
_B27_REAPER = None
_B27_REAPER_STOP = None
_B27_SWEEP_MS = 3000
_B27_GRACE_MS = 1500
_B27C_ON = True
_B27C_FILE_NAME = "context_leak.json"
_B27C_EVERY_N = 20
_B27C_MAX_DEPTH = 14
_B27C_MAX_VIEWS = 400
_B27C_CHILD_HEAD = 24
_B27C_CHILD_TAIL = 24
_B27C_SCAN_BUDGET_S = 1.5
_B27C_PY_CANDS = 768
_B27C_FEED_MS = 300000
_B27C_TICK = [0]
_B27C_STATE = {}
_B27C_STATE_MAX = 64
_B27C_DEDUP_ATTR_MS = 1200000
_B27C_UNATTR_RETRY_MS = 240000
_B27C_LAST_FIND = {}
_B27C_FINDINGS = {}
_B27C_CONFIRM_MS = _B27C_DEDUP_ATTR_MS * 2
_B27C_CLS_CACHE = {}

def _leak_verdict_path():
    return _data_path(_LEAK_FILE_NAME)

_B27_LOG_WINDOW_MS = 10000
_B27_LOG_BURST = 3
_B27_LOG_STATE = {}
_B27_LOG_LOCK = threading.Lock()

def _b27_log_emit_summary(owner, suppressed, span_ms, last_ihc, last_desc):
    if suppressed <= 0: return
    try: _log("Block#27: track view owner=%s +%d more (%s, last ihc=%d) in %.1fs [throttled]" % (owner, suppressed, last_desc, last_ihc, span_ms/1000.0))
    except Exception: pass

def _b27_log_track(ihc, owner, desc):
    now = int(time.time()*1000)
    line = None; summary = None
    with _B27_LOG_LOCK:
        st = _B27_LOG_STATE.get(owner)
        if st is None or (now - st[0]) >= _B27_LOG_WINDOW_MS:
            if st is not None and st[2] > 0:
                summary = (owner, st[2], now - st[0], st[3], st[4])
            _B27_LOG_STATE[owner] = [now, 1, 0, ihc, desc]
            line = "Block#27: track view ihc=%d owner=%s (%s)" % (ihc, owner, desc)
        else:
            st[1] += 1; st[3] = ihc; st[4] = desc
            if st[1] <= _B27_LOG_BURST:
                line = "Block#27: track view ihc=%d owner=%s (%s)" % (ihc, owner, desc)
            else:
                st[2] += 1
    if line:
        try: _log(line)
        except Exception: pass
    if summary is not None:
        _b27_log_emit_summary(summary[0], summary[1], summary[2], summary[3], summary[4])

def _b27_log_flush():
    now = int(time.time()*1000)
    pending = []
    with _B27_LOG_LOCK:
        for owner in list(_B27_LOG_STATE.keys()):
            st = _B27_LOG_STATE[owner]
            if (now - st[0]) >= _B27_LOG_WINDOW_MS:
                if st[2] > 0:
                    pending.append((owner, st[2], now - st[0], st[3], st[4]))
                _B27_LOG_STATE.pop(owner, None)
    for p in pending:
        _b27_log_emit_summary(p[0], p[1], p[2], p[3], p[4])

def _b27_owner_now():
    try:
        pid = _pm_scan_py(_pm_python_stack(48))
        if pid and pid != _SELF_ID: return pid
    except Exception: pass
    try:
        pid = _direct_pid_now()
        if pid and pid != _SELF_ID: return pid
    except Exception: pass
    return None

def _b27_view_ihc(view):
    try:
        return int(jclass("java.lang.System").identityHashCode(view))
    except Exception:
        return None

def _b27_weakref(view):
    try:
        return jclass("java.lang.ref.WeakReference")(view)
    except Exception:
        return None

def _b27_register_add(view, desc, owner=None):
    if not _BLOCK27_ON or view is None: return
    if owner is None:
        owner = _b27_owner_now()
    if not owner or owner == _SELF_ID: return
    ihc = _b27_view_ihc(view)
    if ihc is None: return
    wref = _b27_weakref(view)
    if wref is None:
        return
    with _VIEW_REG_LOCK:
        bucket = _VIEW_REGS.setdefault(ihc, [])
        for r in bucket:
            if r[1] == owner:
                r[3] = desc
                if len(r) > 4 and wref is not None: r[4] = wref
                return
        bucket.append([ihc, owner, int(time.time()*1000), desc, wref])
    _b27_log_track(ihc, owner, desc)

def _b27_register_remove(view):
    if view is None: return
    ihc = _b27_view_ihc(view)
    if ihc is None: return
    with _VIEW_REG_LOCK:
        bucket = _VIEW_REGS.get(ihc)
        if not bucket:
            return
        kept = []
        for r in bucket:
            wr = r[4] if len(r) > 4 else None
            vobj = None
            if wr is not None:
                try: vobj = wr.get()
                except Exception: vobj = None
            drop = False
            if vobj is not None:
                try:
                    if vobj is view or bool(vobj.equals(view)): drop = True
                except Exception:
                    drop = False
            if not drop:
                kept.append(r)
        if kept:
            _VIEW_REGS[ihc] = kept
        else:
            _VIEW_REGS.pop(ihc, None)

_FSPLUG_LOG_ONCE = [False]
_B19_FSMAP_LOG_ONCE = [False]
_FSPLUG_CACHE = [0, None]
def _installed_plugin_ids_fs():
    now = 0
    try:
        now = int(time.time() * 1000)
        c = _FSPLUG_CACHE[1]
        if c is not None and (now - _FSPLUG_CACHE[0]) < 30000:
            return set(c)
    except Exception:
        pass
    out = set()
    try:
        d = None
        try: d = _b11p_plugins_dir()
        except Exception: d = None
        if not d:
            try:
                fp = globals().get("__file__")
                if isinstance(fp, str) and fp: d = os.path.dirname(fp)
            except Exception: d = None
        if d and os.path.isdir(d):
            for fn in os.listdir(d):
                if not fn.endswith(".py"): continue
                pid = fn[:-3]
                if not pid or pid == _SELF_ID or pid == __id__: continue
                out.add(pid)
    except Exception:
        pass
    try:
        _FSPLUG_CACHE[0] = now; _FSPLUG_CACHE[1] = set(out)
    except Exception:
        pass
    return out

def _b27_live_pids():
    out = set()
    reg = {}
    try:
        with _REG_LOCK:
            reg = dict(_REGISTRY)
    except Exception:
        reg = {}
    try:
        for e in _b11_plugin_entries():
            try:
                k = _safe_str(e.getKey())
                if not k: continue
                r = reg.get(k)
                if r is not None and not r.get("inst"):
                    continue
                out.add(k)
            except Exception: pass
    except Exception: pass
    try:
        for pid, r in reg.items():
            if r and r.get("inst"): out.add(pid)
    except Exception: pass
    try:
        fs_added = 0
        for pid in _installed_plugin_ids_fs():
            if pid in out: continue
            r = reg.get(pid)
            if r is not None and not r.get("inst"): continue
            out.add(pid); fs_added += 1
        if fs_added and not _FSPLUG_LOG_ONCE[0]:
            _FSPLUG_LOG_ONCE[0] = True
            _log("Block#27: live-owner set дополнен FS-фолбэком (+%d ids, итого %d)" % (fs_added, len(out)))
    except Exception: pass
    return out

def _b27_write_leak(owner, by_desc, age_ms, count):
    p = _leak_verdict_path()
    if not p: return
    try:
        parts = sorted(by_desc.items(), key=lambda kv: -kv[1])
    except Exception:
        parts = list(by_desc.items())
    where = ", ".join("%s x%d" % (d, n) for d, n in parts) if parts else "view-leak"
    kinds = set(by_desc.keys())
    if kinds == {"WindowManager.addView"}:
        reason = "view добавлен через WindowManager.addView и не снят (removeView/removeViewImmediate) до выгрузки плагина"
    elif kinds == {"ViewGroup.addView"}:
        reason = "view добавлен в иерархию через ViewGroup.addView и не снят (removeView) до выгрузки плагина"
    else:
        reason = "views добавлены через %s и остались прикреплёнными до выгрузки плагина" % " + ".join(sorted(kinds))
    rec = {"had_leak": True, "culprit": owner, "src": "view-reaper", "confidence": "high",
           "kind": "view-leak", "where": where, "leaked_views": count, "by_desc": by_desc,
           "age_ms": age_ms, "reason": reason,
           "exc_cls": "ViewLeak", "exc_msg": where, "ts": int(time.time()*1000),
           "event_type": "view_leak", "dropbox_tag": "app_memory_leak", "tombstone_norm_version": 1}
    key = "%s" % owner; now = rec["ts"]
    with _LEAK_SEEN_LOCK:
        if now - _LEAK_SEEN.get(key, 0) < _LEAK_DEDUP_MS: return
        _LEAK_SEEN[key] = now
    try:
        with _HX_LEAK_LOCK: _HX_LEAK_RECENT[owner] = now
    except Exception: pass
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, _LEAK_FAILS_MAX)
    except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass
    try:
        _log("================ VIEW-LEAK VERDICT (Block#27) ================")
        _log("ВИНОВНИК УТЕЧКИ: %r conf=high views=%d age=%dms (%s)" % (owner, count, age_ms, where))
        _log("  причина: %s" % rec["reason"])
        _log("==============================================================")
    except Exception: pass

def _b27c_path():
    return _data_path(_B27C_FILE_NAME)

def _b27c_cls(name):
    c = _B27C_CLS_CACHE.get(name, 0)
    if c == 0:
        try: c = _java_lang_class(name)
        except Exception: c = None
        _B27C_CLS_CACHE[name] = c
    return c

def _b27c_dead_ctx(view):
    try:
        ctx = view.getContext()
    except Exception:
        return None
    act_cls = _b27c_cls("android.app.Activity")
    cw_cls = _b27c_cls("android.content.ContextWrapper")
    if act_cls is None:
        return None
    hops = 0
    while ctx is not None and hops < 5:
        try:
            if act_cls.isInstance(ctx):
                break
            if cw_cls is not None and cw_cls.isInstance(ctx):
                ctx = ctx.getBaseContext(); hops += 1; continue
        except Exception:
            return None
        return None
    else:
        return None
    if ctx is None:
        return None
    try:
        _dead = bool(ctx.isDestroyed())
        _fin = bool(ctx.isFinishing())
        if _dead or _fin:
            return (str(ctx.getClass().getName()), _dead)
    except Exception:
        pass
    return None

def _b27c_scan_root(root, deadline=0.0):
    out = []
    try:
        _rd = _b27c_dead_ctx(root)
        if _rd is not None:
            out.append((root, _rd[0], _rd[1], True))
            return out
    except Exception:
        return out
    vg_cls = _b27c_cls("android.view.ViewGroup")
    q = [(root, 0)]; seen = 0
    while q and seen < _B27C_MAX_VIEWS:
        if deadline and time.monotonic() > deadline:
            break
        v, d = q.pop(0); seen += 1
        if d > 0:
            dead = None
            try: dead = _b27c_dead_ctx(v)
            except Exception: dead = None
            if dead is not None:
                out.append((v, dead[0], dead[1], False))
                continue
        if d >= _B27C_MAX_DEPTH:
            continue
        try:
            if vg_cls is not None and vg_cls.isInstance(v):
                n = int(v.getChildCount())
                if n <= _B27C_CHILD_HEAD + _B27C_CHILD_TAIL:
                    idxs = range(n)
                else:
                    idxs = list(range(_B27C_CHILD_HEAD)) + list(range(n - _B27C_CHILD_TAIL, n))
                for i in idxs:
                    c = v.getChildAt(i)
                    if c is not None:
                        q.append((c, d + 1))
        except Exception:
            pass
    return out

def _b27c_roots():
    out = []
    try:
        wmg_cls = _java_lang_class("android.view.WindowManagerGlobal")
        wmg = jclass("android.view.WindowManagerGlobal").getInstance()
        f = wmg_cls.getDeclaredField("mViews")
        f.setAccessible(True)
        lst = f.get(wmg)
        n = int(lst.size())
        for i in range(min(n, 12)):
            v = lst.get(i)
            if v is not None:
                out.append(v)
    except Exception:
        pass
    if not out:
        try:
            fr = jclass("org.telegram.ui.LaunchActivity").getSafeLastFragment()
            act = fr.getParentActivity() if fr is not None else None
            if act is not None and not bool(act.isDestroyed()):
                out.append(act.getWindow().getDecorView())
        except Exception:
            pass
    return out

def _b27c_ledger_owner(ihc):
    try:
        with _VIEW_REG_LOCK:
            bucket = _VIEW_REGS.get(ihc)
            if bucket:
                for rec in bucket:
                    if rec[1]:
                        return rec[1]
    except Exception:
        pass
    return None

def _b27c_py_owner(ihc):
    try:
        import gc as _gc
        known = set([k for k in (_known_union() or []) if isinstance(k, str) and k and k != _SELF_ID])
        if not known:
            return (None, None)
        Sys = jclass("java.lang.System")
        cands = []
        for o in _gc.get_objects():
            try:
                m = getattr(type(o), "__module__", None)
            except Exception:
                continue
            if m in known:
                cands.append((m, o))
                if len(cands) >= _B27C_PY_CANDS:
                    break
        def _is_view(val):
            try:
                return hasattr(val, "isAttachedToWindow") and int(Sys.identityHashCode(val)) == ihc
            except Exception:
                return False
        for m, o in cands:
            visited = set()
            budget = 400
            stack = [("", o, 0)]
            while stack and budget > 0:
                pfx, cur, d = stack.pop()
                try:
                    if id(cur) in visited:
                        continue
                    visited.add(id(cur))
                except Exception:
                    continue
                pairs = []
                try:
                    if isinstance(cur, dict):
                        pairs = [("{%r}" % (k,), v2) for k, v2 in list(cur.items())[:24]]
                    elif isinstance(cur, (list, tuple, set, frozenset)):
                        pairs = [("[%d]" % i, v2) for i, v2 in enumerate(list(cur)[:24])]
                    else:
                        pairs = list(vars(cur).items())[:48]
                except Exception:
                    pairs = []
                for k, val in pairs:
                    budget -= 1
                    if budget <= 0:
                        break
                    if val is None:
                        continue
                    if _is_view(val):
                        return (m, pfx + str(k))
                    if d >= 3:
                        continue
                    try:
                        tm = getattr(type(val), "__module__", None)
                    except Exception:
                        tm = None
                    if tm in known or isinstance(val, (dict, list, tuple, set, frozenset)):
                        stack.append((pfx + str(k) + ".", val, d + 1))
        return (None, None)
    except Exception:
        return (None, None)
def _b27c_emit(view, ihc, act_name, owner, attr_path, owner_src, strong, is_root, hits):
    p = _b27c_path()
    if not p:
        return False
    try: vcls = str(view.getClass().getName())
    except Exception: vcls = "View"
    try: attached = bool(view.isAttachedToWindow())
    except Exception: attached = None
    if strong:
        _rs = "view pins a DESTROYED Activity via mContext: the Activity was recreated (theme/language/rotation) and the old view was re-attached/retained, so the whole old Activity graph cannot be GC'd"
        _wd = "destroyed"
    else:
        _rs = "view retains a FINISHING Activity across %d consecutive sweeps via mContext: the Activity never reached destroyed state, yet the view keeps pinning its graph well past a normal transition" % max(1, int(hits))
        _wd = "finishing"
    rec = {"had_leak": True,
           "verdict": "ACTIVITY CONTEXT LEAK",
           "culprit": (owner if owner else "unattributed (see suspect_view)"),
           "culprit_known": bool(owner),
           "src": "context-sentinel/b27c",
           "confidence": ("high" if (owner and strong) else "medium"),
           "kind": ("plugin-context" if owner else "context-leak"),
           "where": "%s (ihc=%d) attached=%s" % (vcls, ihc, attached),
           "suspect_view": vcls,
           "dead_activity": act_name,
           "dead_state": ("destroyed" if strong else "finishing"),
           "root_level": bool(is_root),
           "sweeps_confirmed": int(hits),
           "owner_attr_path": attr_path, "owner_src": owner_src,
           "reason": _rs,
           "exc_cls": "ContextLeak", "exc_msg": "%s -> %s %s" % (vcls, _wd, act_name),
           "ts": int(time.time() * 1000),
           "event_type": "context_leak", "dropbox_tag": "app_memory_leak", "tombstone_norm_version": 1}
    ok = False
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    cur = list(json.load(f))
            except Exception:
                cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, _LEAK_FAILS_MAX)
        ok = True
    except Exception:
        ok = False
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass
    if ok:
        try:
            _log("=============== CONTEXT-LEAK VERDICT (Block#27C) ===============")
            _log("+NW: %s (ihc=%d) pins %s %s (root_level=%s, sweeps=%d) -> culprit=%r (src=%s, attr=%s)" % (vcls, ihc, rec["dead_state"], act_name, is_root, hits, rec["culprit"], owner_src, attr_path))
            _log("================================================================")
        except Exception:
            pass
    return ok
def _b27c_feed_decay(now):
    for _k in list(_B27C_LAST_FIND.keys()):
        if now - int(_B27C_LAST_FIND.get(_k) or 0) > _B27C_CONFIRM_MS:
            _B27C_LAST_FIND.pop(_k, None)
    for _k in list(_B27C_FINDINGS.keys()):
        _fl2 = [_t for _t in (_B27C_FINDINGS.get(_k) or []) if now - _t <= _B27C_CONFIRM_MS]
        if _fl2:
            _B27C_FINDINGS[_k] = _fl2
        else:
            _B27C_FINDINGS.pop(_k, None)
def _b27c_sweep():
    if not _B27C_ON:
        return
    now = int(time.time() * 1000)
    roots = _b27c_roots()
    if not roots:
        _b27c_feed_decay(now)
        return
    found = set()
    _dl = time.monotonic() + _B27C_SCAN_BUDGET_S
    for root in roots:
        if time.monotonic() > _dl:
            break
        for v, act_name, strong, is_root in _b27c_scan_root(root, _dl):
            ihc = _b27_view_ihc(v)
            if ihc is None:
                continue
            key = (ihc, act_name)
            found.add(key)
            st = _B27C_STATE.get(key)
            if st is None:
                st = {"first": now, "last": now, "hits": 0, "emitted": 0, "owner": None, "attr": None, "osrc": None, "owner_emitted": False}
                _B27C_STATE[key] = st
                if len(_B27C_STATE) > _B27C_STATE_MAX:
                    for _k in sorted(_B27C_STATE, key=lambda x: _B27C_STATE[x].get("last", 0))[:len(_B27C_STATE) - _B27C_STATE_MAX]:
                        if _k != key:
                            _B27C_STATE.pop(_k, None)
            st["hits"] = int(st.get("hits", 0)) + 1
            st["last"] = now
            if not st.get("owner"):
                _own = _b27c_ledger_owner(ihc)
                if _own:
                    st["owner"] = _own; st["osrc"] = "b27-ledger"
                else:
                    _own, _ap = _b27c_py_owner(ihc)
                    if _own:
                        st["owner"] = _own; st["attr"] = _ap; st["osrc"] = "py-owner-scan"
            _need = 1 if (strong and not is_root) else 2
            if int(st.get("hits", 0)) < _need:
                continue
            if st.get("owner") and st.get("owner_emitted"):
                _B27C_LAST_FIND[st["owner"]] = now
            _em = int(st.get("emitted", 0))
            if _em:
                _age = now - _em
                if st.get("owner") and st.get("owner_emitted"):
                    if _age < _B27C_DEDUP_ATTR_MS:
                        continue
                elif (not st.get("owner")) and _age < _B27C_UNATTR_RETRY_MS:
                    continue
            if _b27c_emit(v, ihc, act_name, st.get("owner"), st.get("attr"), st.get("osrc"), strong, is_root, int(st.get("hits", 0))):
                st["emitted"] = now
                st["owner_emitted"] = bool(st.get("owner"))
                if st.get("owner"):
                    _B27C_LAST_FIND[st["owner"]] = now
                    _fl = [_t for _t in _B27C_FINDINGS.get(st["owner"], []) if now - _t <= _B27C_CONFIRM_MS]
                    _fl.append(now)
                    _B27C_FINDINGS[st["owner"]] = _fl[-16:]
    for _k in list(_B27C_STATE.keys()):
        _st = _B27C_STATE.get(_k) or {}
        if _k not in found and not _st.get("emitted") and (now - int(_st.get("last", now))) > 300000:
            _B27C_STATE.pop(_k, None)
    _b27c_feed_decay(now)
def _b27_is_live_leak(wref):
    if wref is None: return (False, True)
    try: vobj = wref.get()
    except Exception: return (False, True)
    if vobj is None: return (True, False)
    try:
        if vobj.getParent() is not None: return (True, True)
    except Exception: pass
    try:
        if bool(vobj.isAttachedToWindow()): return (True, True)
    except Exception: pass
    return (True, False)

_B27_EMPTY_LIVE_STREAK = 0
def _b27_sweep(force_all=False):
    try:
        with _VIEW_REG_LOCK:
            snap = [(ihc, list(bucket)) for ihc, bucket in _VIEW_REGS.items()]
        if not snap: return
        live = _b27_live_pids()
        global _B27_EMPTY_LIVE_STREAK
        if not live:
            _B27_EMPTY_LIVE_STREAK += 1
            if _B27_EMPTY_LIVE_STREAK in (1, 5, 20) or (_B27_EMPTY_LIVE_STREAK % 100 == 0):
                try: _log("Block#27 WARN: live-owner set EMPTY for %d sweep(s) -- leak detection inert (host getPlugins() API change?)" % _B27_EMPTY_LIVE_STREAK)
                except Exception: pass
        elif _B27_EMPTY_LIVE_STREAK:
            try: _log("Block#27: live-owner set recovered after %d empty sweep(s)" % _B27_EMPTY_LIVE_STREAK)
            except Exception: pass
            _B27_EMPTY_LIVE_STREAK = 0
        now = int(time.time()*1000)
        leaked = {}; drop_recs = {}
        for ihc, bucket in snap:
            for rec in bucket:
                owner = rec[1]; ts = rec[2]; desc = rec[3]
                wref = rec[4] if len(rec) > 4 else None
                if (now - ts) < _B27_GRACE_MS and not force_all: continue
                decided, is_leak = _b27_is_live_leak(wref)
                if decided and not is_leak:
                    drop_recs.setdefault(ihc, set()).add(id(rec)); continue
                gone = (owner not in live) if live else False
                if force_all and not gone:
                    drop_recs.setdefault(ihc, set()).add(id(rec)); continue
                if not gone: continue
                info = leaked.setdefault(owner, {"total": 0, "by_desc": {}, "age": now - ts})
                info["total"] += 1
                info["by_desc"][desc] = info["by_desc"].get(desc, 0) + 1
                if (now - ts) > info["age"]: info["age"] = now - ts
                drop_recs.setdefault(ihc, set()).add(id(rec))
        for owner, info in leaked.items():
            _b27_write_leak(owner, info["by_desc"], info["age"], info["total"])
        if drop_recs:
            with _VIEW_REG_LOCK:
                for ihc, ids in drop_recs.items():
                    bucket = _VIEW_REGS.get(ihc)
                    if not bucket: continue
                    kept = [r for r in bucket if id(r) not in ids]
                    if kept: _VIEW_REGS[ihc] = kept
                    else: _VIEW_REGS.pop(ihc, None)
    except Exception as e:
        try: _log("Block#27 sweep err: %s" % e)
        except Exception: pass

def _b27_reaper(stop_evt):
    while not stop_evt.is_set():
        try: stop_evt.wait(_B27_SWEEP_MS/1000.0)
        except Exception: pass
        if stop_evt.is_set(): break
        _gil_begin(_GIL_B27)
        try:
            _b27_sweep(False)
            _b27_log_flush()
            try:
                _B27C_TICK[0] += 1
                if _B27C_TICK[0] % _B27C_EVERY_N == 0:
                    _b27c_sweep()
            except Exception:
                pass
            try: _od_entry_flush()
            except Exception: pass
        finally:
            _gil_end(_GIL_B27)

class _ViewAddHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            try:
                if param.getThrowable() is not None: return
            except Exception: pass
            args = param.args
            if args is not None and len(args) >= 1 and args[0] is not None:
                pass
                _b27_register_add(args[0], "WindowManager.addView")
        except Exception: pass

class _ViewRemoveHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            if not _VIEW_REGS: return
            args = param.args
            if args is not None and len(args) >= 1 and args[0] is not None:
                _b27_register_remove(args[0])
        except Exception: pass

class _ViewGroupAddHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            try:
                if param.getThrowable() is not None: return
            except Exception: pass
            try: owner = _direct_pid_now()
            except Exception: owner = None
            if not owner or owner == _SELF_ID: return
            args = param.args
            if args is not None and len(args) >= 1 and args[0] is not None:
                pass
                _b27_register_add(args[0], "ViewGroup.addView", owner=owner)
        except Exception: pass

class _DirectAllocHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            try:
                if param.getThrowable() is not None: return
            except Exception:
                pass
            args = param.args
            if args is not None and len(args) >= 1 and args[0] is not None:
                _direct_register(getattr(param, "thisObject", None), args[0])
        except Exception:
            pass

class _DirectAllocResultHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            try:
                if param.getThrowable() is not None: return
            except Exception:
                pass
            args = param.args
            if args is not None and len(args) >= 1 and args[0] is not None:
                obj = None
                try: obj = param.getResult()
                except Exception: obj = None
                _direct_register(obj, args[0])
        except Exception:
            pass

_PYF_LAYOUTS = {(3, 11): (56, 8, 8, 48), (3, 12): (56, 0, 24, 8)}
_PYF_ON = [False]

def _pyf_register_all():
    if not (_THSTART_NATIVE_OK and _NLIB is not None): return 0
    n = 0
    try: mods = list(_sys.modules.items())
    except Exception: return 0
    for nm, mod in mods:
        try:
            if mod is None: continue
            pid = _pid_of_module_pkg(nm)
            if not pid: continue
            d = getattr(mod, "__dict__", None)
            if d is None: continue
            if int(_NLIB.cd_pyf_register(ctypes.c_int64(id(d)), ctypes.c_int32(int(_intern(pid))))) >= 0:
                n += 1
        except Exception:
            pass
    return n

def _pyf_setup():
    if not (_THSTART_NATIVE_OK and _NLIB is not None): return "n/a"
    lay = _PYF_LAYOUTS.get(tuple(_sys.version_info[:2]))
    if lay is None:
        return "OFF (Python %d.%d: layout неизвестен)" % tuple(_sys.version_info[:2])
    try:
        if int(_NLIB.cd_pyf_layout(*[ctypes.c_int32(x) for x in lay])) != 0:
            return "OFF (PyGILState_GetThisThreadState не резолвится)"
        d = int(_NLIB.cd_pyf_selftest(ctypes.c_int64(id(globals()))))
    except Exception as e:
        return "OFF (err %r)" % (e,)
    if d < 0:
        return "OFF (selftest=%d)" % d
    _PYF_ON[0] = True
    return "ON (py%d.%d, selftest depth=%d)" % (tuple(_sys.version_info[:2]) + (d,))

def thread_start_stats():
    if not (_THSTART_NATIVE_OK and _NLIB is not None): return None
    try:
        buf = (ctypes.c_int64 * 9)()
        k = int(_NLIB.cd_thread_start_stats(buf, ctypes.c_int32(9)))
        keys = ("fires", "seed_scope", "seed_active", "seed_py", "py_walks", "no_tstate", "py_miss", "read_fail", "pyf_on")
        return {keys[i]: int(buf[i]) for i in range(min(k, 9))}
    except Exception:
        return None

def get_culprit_for_tid(tid):
    res = _resolve_idx(_reg_get(tid))
    if (not res or res == "⟨unknown⟩") and _DEX.is_loaded():
        try:
            dex_res = _DEX.call("pyGetThreadOwner", int(tid))
            if dex_res: return str(dex_res)
        except Exception: pass
    return res
def registry_info():
    return {
        "addr": _REG_ADDR,
        "slots": _REG_N,
        "slot_bytes": (ctypes.sizeof(_Slot) if (_REG_BUF is not None) else 0),
        "backend": ("native-shared" if _REG_BUF is not None else "none"),
        "layout": "struct{int64 tid; int32 pid_idx; int32 seq;}",
        "version": _REG_LAYOUT_VER,
    }

_REG_SNAP_FILE = "reg_snapshot.json"
def _mn_proc_starttime():
    try:
        with open("/proc/self/stat", "r") as _f:
            _stx = _f.read()
        return int(_stx.rsplit(")", 1)[1].split()[19])
    except Exception:
        return -1
def _proc_age_ms():
    try:
        _st = _mn_proc_starttime()
        if _st < 0: return -1
        with open("/proc/uptime", "r") as _f:
            _up = float(_f.read().split()[0])
        _hz = float(os.sysconf("SC_CLK_TCK") or 100)
        _age = int((_up - _st / _hz) * 1000.0)
        return _age if _age >= 0 else -1
    except Exception:
        return -1
def _dl_recent_load_ts(mod):
    try:
        lib = globals().get("_NLIB")
        if lib is None or not mod or not hasattr(lib, "cd_dlevents_dump"): return 0
        lib.cd_dlevents_dump.argtypes = [ctypes.c_char_p, ctypes.c_int]; lib.cd_dlevents_dump.restype = ctypes.c_int
        _buf = ctypes.create_string_buffer(65536)
        _n = int(lib.cd_dlevents_dump(_buf, 65536))
        if _n <= 0: return 0
        _best = 0; _m = str(mod)
        for _ln in _buf.value.decode("utf-8", "replace").splitlines():
            _p = _ln.split(" ", 5)
            if len(_p) < 6 or _p[1] != "dlopen": continue
            _nm = _p[5].strip()
            if _nm == _m or _nm.endswith("/" + _m):
                _best = max(_best, int(_p[0]))
        return _best
    except Exception:
        return 0
def _reg_snap_path():
    try:
        _d = _app_priv_dir()
        return os.path.join(_d, _REG_SNAP_FILE) if _d else None
    except Exception:
        return None
def _reg_snapshot_dump():
    if _REG_BUF is None:
        return 0
    _m = {}
    try:
        for _i in range(_REG_N):
            _s = _REG_BUF[_i]
            for _try in range(3):
                _s1 = int(_s.seq)
                if _s1 & 1:
                    continue
                _t = int(_s.tid); _x = int(_s.pid_idx)
                _s2 = int(_s.seq)
                if _s1 != _s2 or (_s2 & 1):
                    continue
                if _t > 0 and _x >= 0:
                    _nm = _resolve_idx(_x)
                    if isinstance(_nm, str) and _nm:
                        _m[str(_t)] = _nm
                break
    except Exception:
        return 0
    if not _m:
        return 0
    _p = _reg_snap_path()
    if not _p:
        return 0
    try:
        if _atomic_json_write_impl(_p, {"pid": int(os.getpid()), "st": _mn_proc_starttime(), "ts": int(time.time() * 1000), "map": _m}):
            return len(_m)
    except Exception:
        pass
    return 0
def _reg_snapshot_restore():
    _p = _reg_snap_path()
    if not _p:
        return 0
    try:
        with open(_p, "r", encoding="utf-8") as _f:
            _rec = json.load(_f)
    except Exception:
        return 0
    try: os.remove(_p)
    except Exception: pass
    try:
        if not isinstance(_rec, dict) or int(_rec.get("pid") or -1) != int(os.getpid()):
            return 0
        _age = int(time.time() * 1000) - int(_rec.get("ts") or 0)
        if _age < 0 or _age > 60000:
            return 0
        _stn = _mn_proc_starttime()
        if _stn < 0 or int(_rec.get("st", -2)) != _stn:
            return 0
    except Exception:
        return 0
    if not (_NATIVE_OK and _NLIB is not None):
        return 0
    _n = 0
    for _tk, _nm in (_rec.get("map") or {}).items():
        try:
            _t = int(_tk)
            if _t <= 0 or not os.path.exists("/proc/self/task/%d" % _t):
                continue
            _x = _intern(_nm)
            if not (isinstance(_x, int) and _x >= 0):
                continue
            if int(_NLIB.cd_reg_lookup_tid(ctypes.c_int64(_t))) >= 0:
                continue
            if int(_NLIB.cd_reg_publish_tid(ctypes.c_int64(_t), ctypes.c_int32(_x))) == 0:
                _n += 1
        except Exception:
            pass
    return _n
def _selftest_registry():
    info = registry_info()
    if _REG_BUF is None:
        _log(f"Block#2 реестр: shared-buffer N/A (ctypes={_CTYPES_OK}) — native-моста нет (+DT)")
        return
    try:
        test_tid = 0x7FABCD01
        test_idx = _intern("__regtest__")
        _i0 = test_tid & (_REG_N - 1)
        _REG_BUF[_i0].seq = _REG_BUF[_i0].seq + 1
        _REG_BUF[_i0].tid = test_tid
        _REG_BUF[_i0].pid_idx = test_idx
        _REG_BUF[_i0].seq = _REG_BUF[_i0].seq + 1
        ptr = ctypes.cast(_REG_ADDR, ctypes.POINTER(_Slot))
        i = test_tid & (_REG_N - 1); found = None
        for _ in range(_REG_N):
            if ptr[i].tid == test_tid:
                s1 = ptr[i].seq; idx = ptr[i].pid_idx; s2 = ptr[i].seq
                found = idx if (s1 == s2 and not (s1 & 1)) else None
                break
            if ptr[i].tid == 0: break
            i = (i + 1) & (_REG_N - 1)
        ok = (found == test_idx)
        _REG_BUF[_i0].seq = _REG_BUF[_i0].seq + 1
        _REG_BUF[_i0].pid_idx = -1
        _REG_BUF[_i0].seq = _REG_BUF[_i0].seq + 1
        _REG_BUF[_i0].tid = -1
        _log(f"Block#2 реестр self-test: {'PASS' if ok else 'FAIL'} "
             f"(addr=0x{_REG_ADDR:x}, slots={_REG_N}, slot={info['slot_bytes']}B, raw-read={found}/{test_idx})")
    except Exception as e:
        _log(f"Block#2 реестр self-test err: {e}")

def _app_context():
    try:
        c = jclass("org.telegram.messenger.ApplicationLoader")
        ctx = getattr(c, "applicationContext", None)
        return ctx
    except Exception:
        return None

def _b3_native_dir():
    base = None
    ctx = _app_context()
    if ctx is not None:
        try: base = ctx.getCodeCacheDir().getAbsolutePath()
        except Exception:
            try: base = ctx.getFilesDir().getAbsolutePath()
            except Exception: base = None
    if not base: base = _DIR
    d = File(base, "culprit_native")
    try:
        if not d.exists(): d.mkdirs()
    except Exception: pass
    return d.getAbsolutePath()


def _load_native():
    global _NLIB, _NATIVE_OK
    _NLIB = None
    _NATIVE_OK = False
    _log("MaxTrace: безопасный режим активен (нативный бинарник исключен)")
    return

def _so_health():
    return {"ok": True, "state": "pure_safe_mode", "abi": _SO_ABI_EXPECT, "expect": _SO_ABI_EXPECT}


def native_mem_snapshot(top=5):
    d = _direct_snapshot()
    if not d["live_by_pid"] and d["total"] == 0:
        return None
    _pairs_src = dict(d["live_by_pid"])
    if int(d["live_untagged"]) > 0: _pairs_src["⟨untagged⟩"] = int(d["live_untagged"])
    pairs = sorted(_pairs_src.items(), key=lambda kv: kv[1], reverse=True)
    return {
        "total": 0, "untagged": 0, "dropped": 0, "dropped_bytes": -1, "live": 0,
        "direct_total": d["total"], "direct_untagged": d["untagged"],
        "direct_live_total": d["live_total"], "direct_live_untagged": d["live_untagged"],
        "top": pairs[:top],
    }

class _CrumbFile:
    NAME = "last_breadcrumb.txt"
    def __init__(self):
        self.path = None; self._lock = threading.Lock()
        try:
            d = File(_DIR)
            if not d.exists(): d.mkdirs()
            self.path = File(d, self.NAME).getAbsolutePath()
        except Exception as e:
            _log(f"crumb init err: {e}")
    def read_prev(self):
        try:
            if self.path and os.path.exists(self.path):
                with open(self.path, "r", encoding="utf-8") as f:
                    return f.read().strip()
        except Exception: pass
        return None
    def write(self, pid, where):
        if not self.path: return
        with self._lock:
            try:
                with open(self.path, "w", encoding="utf-8") as f:
                    f.write(f"{pid}\t{where}\t{int(time.time()*1000)}"); f.flush()
            except Exception: pass
_CRUMB = None

_B34_WAL_NAME = "load_wal.json"
_B34_PID_NAME = "boot_pid.json"
_B34_SEEN_NAME = "exitinfo_seen.json"
_B34_VERDICT_NAME = "exitinfo_verdict.json"
_B34_GRACE_MS = 20000
_B34_WAL_LOCK = threading.Lock()
_B34_WAL_TIMER = [None]
_B34_WAL_SEQ = [0]
_B34_WIN_LOADING_MS = 300000
_B34_WIN_LOADED_MS = 30000
_B34_WIN_SKEW_MS = 2000
_B34_EARLY_NAME = "early_deaths.json"
_B34_EARLY_MS = 60000
_JAVA_OOM_WIN_MS = 3600000
_B34_OOM_WIN_MS = 900000
_B34_RESKILL_OOM_WIN_MS = 21600000
_B34_EARLY_STREAK_TTL_MS = 90000
_B34_SELF_IDS = frozenset(("culprit_detector", "__regtest__"))
_B34_REASONS = {0: "UNKNOWN", 1: "EXIT_SELF", 2: "SIGNALED", 3: "LOW_MEMORY", 4: "CRASH(Java)", 5: "CRASH_NATIVE", 6: "ANR", 7: "INITIALIZATION_FAILURE", 8: "PERMISSION_CHANGE", 9: "EXCESSIVE_RESOURCE_USAGE", 10: "USER_REQUESTED", 11: "USER_STOPPED", 12: "DEPENDENCY_DIED", 13: "OTHER", 14: "FREEZER", 15: "PACKAGE_STATE_CHANGE", 16: "PACKAGE_UPDATED"}
_B34_SIGNALS = {4: "SIGILL", 5: "SIGTRAP", 6: "SIGABRT", 7: "SIGBUS", 8: "SIGFPE", 9: "SIGKILL", 11: "SIGSEGV", 15: "SIGTERM"}
_EXIT_IMP_NAMES = {100: "foreground", 125: "foreground_service", 200: "visible", 230: "perceptible", 300: "service", 325: "top_sleeping", 350: "cant_save_state", 400: "cached", 1000: "gone"}
_EXIT_BG_IMP = 400

def _exitinfo_mem_fields(ei):
    out = {}
    try:
        _pss = int(ei.getPss())
        if _pss > 0: out["exit_pss_kb"] = _pss
    except Exception: pass
    try:
        _rss = int(ei.getRss())
        if _rss > 0: out["exit_rss_kb"] = _rss
    except Exception: pass
    try:
        imp = int(ei.getImportance())
        out["exit_importance"] = imp
        out["exit_importance_name"] = _EXIT_IMP_NAMES.get(imp, str(imp))
        out["exit_foreground"] = imp <= 200
    except Exception: pass
    return out

def _exitinfo_mem_str(f):
    parts = []
    try:
        if f.get("exit_pss_kb"): parts.append("PSS=%.0f МБ" % (int(f["exit_pss_kb"]) / 1024.0))
        if f.get("exit_rss_kb"): parts.append("RSS=%.0f МБ" % (int(f["exit_rss_kb"]) / 1024.0))
        if "exit_importance" in f:
            parts.append("важность=%s/%s (%s)" % (f["exit_importance"], f.get("exit_importance_name"), "на экране" if f.get("exit_foreground") else "в фоне"))
    except Exception: pass
    return ", ".join(parts)

def _exitinfo_latest(max_age_ms=600000, own_only=True, limit=8):
    try:
        sdk = int(getattr(jclass("android.os.Build$VERSION"), "SDK_INT", 0))
        if sdk < 30: return None
        ctx = _app_context()
        if ctx is None: return None
        am = ctx.getSystemService("activity")
        pkg = str(ctx.getPackageName())
        lst = am.getHistoricalProcessExitReasons(pkg, 0, int(limit))
        n = int(lst.size()) if lst is not None else 0
        now = int(time.time() * 1000); best = None; bts = 0
        for i in range(n):
            try:
                ei = lst.get(i)
                if own_only and str(ei.getProcessName()) != pkg: continue
                ts = int(ei.getTimestamp())
                if now - ts > max_age_ms or ts <= bts: continue
                best = ei; bts = ts
            except Exception: pass
        return best
    except Exception:
        return None

_B34_BLAMELESS = {3, 8, 10, 11, 12, 14, 15, 16}
def _b34_path(name):
    try:
        d = File(_DIR)
        if not d.exists(): d.mkdirs()
        return File(d, name).getAbsolutePath()
    except Exception:
        return None
def _b34_read_json(name):
    try:
        p = _b34_path(name)
        if p and os.path.exists(p):
            with open(p, "r", encoding="utf-8") as f:
                return json.load(f)
    except Exception: pass
    return None
def _b34_clear(name):
    try:
        p = _b34_path(name)
        if p and os.path.exists(p): os.remove(p)
    except Exception: pass
_B34_WAL_STACK = []
def _b34_wal_persist_locked():
    p = _b34_path(_B34_WAL_NAME)
    if not p: return
    try:
        if not _B34_WAL_STACK:
            if os.path.exists(p): os.remove(p)
            return
        tmp = "%s.tmp.%d" % (p, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"seq": _B34_WAL_SEQ[0], "stack": list(_B34_WAL_STACK)}, f)
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, p)
    except Exception as e:
        _log("B34 wal write err: %s" % e)
def _b34_wal_push(pid):
    with _B34_WAL_LOCK:
        if _B34_WAL_STACK and _B34_WAL_STACK[-1].get("pid") == pid and _B34_WAL_STACK[-1].get("phase") == "loading":
            _B34_WAL_STACK[-1]["ts"] = int(time.time() * 1000)
            _B34_WAL_STACK[-1]["depth"] = int(_B34_WAL_STACK[-1].get("depth", 1)) + 1
            _b34_wal_persist_locked()
            return
        _B34_WAL_SEQ[0] += 1
        _B34_WAL_STACK.append({"pid": pid, "phase": "loading", "ts": int(time.time() * 1000)})
        _b34_wal_persist_locked()
def _b34_wal_mark_loaded(pid):
    with _B34_WAL_LOCK:
        _B34_WAL_SEQ[0] += 1
        for e in reversed(_B34_WAL_STACK):
            if e.get("pid") == pid and e.get("phase") == "loading":
                if int(e.get("depth", 1)) > 1:
                    e["depth"] = int(e.get("depth", 1)) - 1
                else:
                    e["phase"] = "loaded"; e["ts"] = int(time.time() * 1000)
                break
        else:
            for e in reversed(_B34_WAL_STACK):
                if e.get("pid") == pid and e.get("phase") == "loaded":
                    e["ts"] = int(time.time() * 1000)
                    break
            else:
                _B34_WAL_STACK.append({"pid": pid, "phase": "loaded", "ts": int(time.time() * 1000)})
        _b34_wal_persist_locked()
    _b34_wal_schedule_sweep(None)
def _b34_wal_pop_fail(pid):
    with _B34_WAL_LOCK:
        _B34_WAL_SEQ[0] += 1
        for i in range(len(_B34_WAL_STACK) - 1, -1, -1):
            if _B34_WAL_STACK[i].get("pid") == pid:
                if int(_B34_WAL_STACK[i].get("depth", 1)) > 1:
                    _B34_WAL_STACK[i]["depth"] = int(_B34_WAL_STACK[i].get("depth", 1)) - 1
                else:
                    del _B34_WAL_STACK[i]
                break
        _b34_wal_persist_locked()
def _b34_wal_sweep():
    nxt = None
    with _B34_WAL_LOCK:
        now = int(time.time() * 1000)
        keep = []; changed = False
        for e in _B34_WAL_STACK:
            if e.get("phase") == "loaded":
                try: left = _B34_GRACE_MS - (now - int(e.get("ts", 0)))
                except Exception: left = 0
                if left <= 0:
                    changed = True
                    continue
                if nxt is None or left < nxt: nxt = left
            keep.append(e)
        if changed:
            _B34_WAL_SEQ[0] += 1
            del _B34_WAL_STACK[:]
            _B34_WAL_STACK.extend(keep)
            _b34_wal_persist_locked()
    if nxt is not None:
        _b34_wal_schedule_sweep(nxt)
def _b34_wal_schedule_sweep(delay_ms):
    try:
        t = _B34_WAL_TIMER[0]
        if t is not None:
            try: t.cancel()
            except Exception: pass
        d = (_B34_GRACE_MS if delay_ms is None else max(250, int(delay_ms))) / 1000.0
        t = threading.Timer(d, _b34_wal_sweep)
        t.daemon = True
        _B34_WAL_TIMER[0] = t
        t.start()
    except Exception as e:
        _log("B34 wal timer err: %s" % e)
def _b34_reason_str(code, status):
    r = _B34_REASONS.get(code, "reason=%s" % code)
    try:
        if code == 2:
            r += " (%s)" % _B34_SIGNALS.get(status, "sig=%s" % status)
        elif code == 1:
            r += " (exit=%s)" % status
    except Exception: pass
    return r
def _b34_early_note(ets, cands, reason=None, status=None):
    streak = 1
    try:
        ed = _b34_read_json(_B34_EARLY_NAME) or {}
        old = ed.get("plugins") or []
        fresh = True
        try: fresh = (int(ets) - int(ed.get("last_ts", 0) or 0)) <= _B34_EARLY_STREAK_TTL_MS
        except Exception: pass
        if int(ed.get("count", 0)) > 0 and fresh and set(old) == set(cands or []) and ed.get("exit_reason") == reason and ed.get("exit_status") == status:
            streak = int(ed.get("count", 0)) + 1
    except Exception: pass
    try: _atomic_json_write(_b34_path(_B34_EARLY_NAME), {"count": streak, "last_ts": int(ets), "plugins": list(cands or []), "exit_reason": reason, "exit_status": status})
    except Exception: pass
    return streak
_B34_ANR_CORR_WINDOW_MS = 45000
def _b34_anr_host_correlate(ets, prev_boot_ts):
    if ets is None: return None
    lo = int(ets) - _B34_ANR_CORR_WINDOW_MS; hi = int(ets) + _B34_WIN_SKEW_MS
    floor = 0
    try:
        if prev_boot_ts and int(prev_boot_ts) > 0: floor = int(prev_boot_ts) - _B34_WIN_SKEW_MS
    except Exception: pass
    best = None; best_ts = -1; best_m = None; best_m_ts = -1
    for _kind, _pf in (("host_stall", lambda: _oom_path(_HOST_STALL_FILE_NAME)), ("anr_verdict", _b20_anr_path)):
        try:
            p = _rc_read_path(_pf())
            if not p: continue
            with open(p, "r", encoding="utf-8") as f: _obj = json.load(f)
            if isinstance(_obj, list): recs = _obj
            elif isinstance(_obj, dict): recs = [_obj]
            else: continue
        except Exception: continue
        for r in recs:
            if not isinstance(r, dict) or not bool(r.get("had_anr")): continue
            try: rts = int(r.get("ts", 0))
            except Exception: continue
            if rts <= 0 or rts < lo or rts > hi: continue
            if floor and rts < floor: continue
            r = dict(r); r["_corr_file"] = _kind
            _c = r.get("culprit")
            if rts > best_ts: best = r; best_ts = rts
            if isinstance(_c, str) and _c.strip() and _c not in ("unknown", "host/idle", "none", "none (intentional restart)") and rts > best_m_ts:
                best_m = r; best_m_ts = rts
    return best_m if best_m is not None else best

def _b34_instrumentation_owner(soname):
    low = (soname or "").lower()
    if ("engine_fuzzer" in low) or ("enginefuzzer" in low):
        return "engine_fuzzer"
    if "frida" in low:
        return "frida"
    for _m in ("substrate", "libxposed", "riru", "zygisk", "gum-js"):
        if _m in low:
            return _m
    return None

def _ef_registered_name():
    try:
        with _INTERN_LOCK:
            _names = list(_IDX_PID)
    except Exception:
        _names = []
    for _nm in _names:
        if isinstance(_nm, str) and _b34_instrumentation_owner(_nm) == "engine_fuzzer":
            return _nm
    try:
        _p = _idxnames_path()
        if _p:
            with open(_p, "r", encoding="utf-8") as _f:
                _m = json.load(_f)
            if isinstance(_m, dict):
                for _v in _m.values():
                    if isinstance(_v, str) and _b34_instrumentation_owner(_v) == "engine_fuzzer":
                        return _v
    except Exception:
        pass
    return None


def _b34_native_so_correlate(ets, status):
    try:
        tb = _parse_debuggerd_tombstone(signo=status, crash_ts=ets)
    except Exception:
        tb = None
    if not isinstance(tb, dict):
        return None
    frames = tb.get("frames") or []
    if not frames:
        return None
    wild = (tb.get("code") == -1)
    instr = None; instr_path = None; priv = None; priv_path = None
    for fr in frames:
        mod = (fr.get("module") or ""); low = mod.lower()
        if (not mod) or mod == "<unknown>" or mod.startswith("[anon") or mod.startswith("/memfd") or ("jit-cache" in low) or ("dalvik" in low):
            wild = True; continue
        soname = mod.rsplit("/", 1)[-1]
        own = _b34_instrumentation_owner(soname)
        if own and instr is None:
            instr = own; instr_path = mod
        if priv is None and ("/data/" in mod) and low.endswith(".so") and ("/lib/" not in low):
            priv = soname; priv_path = mod
    if instr is not None:
        if instr == "frida" and wild:
            _efn2 = _ef_registered_name()
            if _efn2:
                instr = "engine_fuzzer"
        return {"culprit": instr, "confidence": "medium" if wild else "low",
                "attribution": bool(wild), "culprit_kind": "native_instrumentation",
                "so_path": instr_path, "wild_branch": bool(wild),
                "tombstone_code": tb.get("code"), "match_score": tb.get("match_score")}
    if priv is not None:
        return {"culprit": "<so:%s>" % priv, "confidence": "low",
                "attribution": False, "culprit_kind": "native_so_suspect",
                "so_path": priv_path, "wild_branch": bool(wild),
                "tombstone_code": tb.get("code"), "match_score": tb.get("match_score")}
    return None


def _b4c_instrumentation_frame_scan(frames):
    if not frames:
        return None
    _TRAMPO = ("libsigchain", "frida-gadget", "libfrida", "frida", "gum-js", "[vdso]", "vdso")
    _TOP_N = 6
    agents = []
    top_owner = None; top_idx = None; top_path = None
    ef_seen = False; tramp = False; fault_soname = None
    idx = -1
    for _fr in frames:
        if not isinstance(_fr, str):
            continue
        idx += 1
        _mod = ""
        for _t in _fr.split():
            if _t.startswith("#") or _t.startswith("pc="):
                continue
            _mod = _t; break
        low = _mod.lower()
        _soname = _mod.split("+", 1)[0].rsplit("/", 1)[-1]
        if idx == 0 and _soname:
            fault_soname = _soname
        if any(_m in low for _m in _TRAMPO):
            tramp = True
        own = _b34_instrumentation_owner(_soname)
        if own:
            if own not in agents:
                agents.append(own)
            if own == "engine_fuzzer":
                ef_seen = True
            if top_owner is None and idx <= _TOP_N:
                top_owner = own; top_idx = idx; top_path = _mod
    if top_owner is None:
        return None
    _immediate = (top_idx is not None and top_idx <= 1)
    if not (tramp or _immediate):
        return None
    owner = "engine_fuzzer" if ef_seen else top_owner
    ef_promoted = False
    if (not ef_seen) and top_owner == "frida" and tramp:
        _efn = _ef_registered_name()
        if _efn:
            owner = "engine_fuzzer"; ef_promoted = True
    strong = (ef_seen or ef_promoted) and (tramp or _immediate)
    return {"owner": owner, "agents": agents, "frame_idx": top_idx,
            "so_path": top_path, "trampoline": bool(tramp),
            "confidence": "high" if strong else "medium",
            "ef_promoted": bool(ef_promoted),
            "fault_soname": fault_soname}


def _b34_oom_correlate(ets, prev_boot_ts, win_ms=None):
    if ets is None:
        return None
    _dir = None
    try:
        _probe = _oom_path("oom_dump_probe.json")
        if _probe: _dir = os.path.dirname(_probe)
    except Exception:
        _dir = None
    _cands = []
    if _dir:
        try:
            for _fn in os.listdir(_dir):
                if not (_fn.startswith("oom_dump_") and _fn.endswith(".json")):
                    continue
                _mid = _fn[len("oom_dump_"):-len(".json")]
                if not _mid.isdigit():
                    continue
                _dts = int(_mid)
                if _dts > int(ets) + _B34_WIN_SKEW_MS:
                    continue
                if (int(ets) - _dts) > (win_ms if win_ms is not None else _B34_OOM_WIN_MS):
                    continue
                if prev_boot_ts and prev_boot_ts > 0 and _dts < prev_boot_ts - _B34_WIN_SKEW_MS:
                    continue
                _cands.append((_dts, os.path.join(_dir, _fn)))
        except Exception:
            pass
    _cands.sort(key=lambda x: x[0], reverse=True)
    _named = []
    for _dts, _pth in _cands:
        try:
            with open(_pth, "r", encoding="utf-8") as _f:
                _rec = json.load(_f)
        except Exception:
            continue
        if not isinstance(_rec, dict):
            continue
        _ov = _rec.get("verdict") if isinstance(_rec.get("verdict"), dict) else None
        if _ov is None:
            try: _ov = _oom_verdict(_rec)
            except Exception: _ov = None
        if not isinstance(_ov, dict):
            continue
        _cul = _ov.get("culprit")
        if not (isinstance(_cul, str) and _cul):
            continue
        if _cul == _UNTAGGED_LABEL or _oom_untagged_alias(_cul):
            continue
        if _cul in _B34_SELF_IDS or _cul in (_SELF_ID, __id__, "unknown", "client (host process)"):
            continue
        _named.append((_dts, _cul, _ov))
    if _named:
        _dts0, _cul0, _ov0 = _named[0]
        _consensus = sum(1 for _x in _named if _x[1] == _cul0)
        _ef = (_b34_instrumentation_owner(_cul0) == "engine_fuzzer")
        _ov_conf = str(_ov0.get("confidence") or "low")
        _ov_rd = str(_ov0.get("reason_detail") or "")
        _conf = _ov_conf
        if _conf == "low":
            _conf = "medium"
        if _consensus >= 2 and (_ef or _ov_rd in ("clear_leader", "probable_leader", "globalref_native", "growth_leader")):
            _conf = "high"
        return {"culprit": _cul0, "confidence": _conf, "attribution": True,
                "culprit_kind": "plugin", "src": "oom_verdict",
                "reason_detail": (_ov_rd or "resource_kill_oom_verdict"),
                "oom_confidence": _ov_conf, "consensus": _consensus,
                "instrumentation_agent": _ef,
                "top_named_bytes": int(_ov0.get("top_named_bytes") or _ov0.get("culprit_bytes") or 0),
                "untagged_bytes": int(_ov0.get("untagged_bytes") or 0),
                "dump_ts": _dts0, "dump_delta_ms": int(ets) - int(_dts0)}
    try:
        _nep = _oom_path("oom_native_emit.json")
        if _nep and os.path.exists(_nep):
            with open(_nep, "r", encoding="utf-8") as _f:
                _ne = json.load(_f)
            if isinstance(_ne, dict):
                _ti = _ne.get("top_idx")
                _nm = _resolve_idx_durable(_ti) if _ti is not None else None
                if isinstance(_nm, str) and _nm and _nm not in _B34_SELF_IDS and _nm not in (_SELF_ID, __id__):
                    _tb = int(_ne.get("top_bytes") or 0)
                    _tot = int(_ne.get("total") or 0)
                    _unt = int(_ne.get("untagged") or 0)
                    _tagged = _tot - _unt
                    _tsh = (float(_tb) / float(_tagged)) if _tagged > 0 else 0.0
                    _ef = (_b34_instrumentation_owner(_nm) == "engine_fuzzer")
                    if _tb >= 8388608 and (_tsh >= 0.50 or _ef):
                        return {"culprit": _nm, "confidence": ("high" if _ef else "medium"),
                                "attribution": True, "culprit_kind": "plugin",
                                "src": "oom_native_emit", "reason_detail": "resource_kill_top_native",
                                "top_bytes": _tb, "tagged_share": round(_tsh, 4),
                                "instrumentation_agent": _ef, "consensus": 1}
    except Exception:
        pass
    return None

def _oom_crash_correlate(crash_ts):
    if crash_ts is None:
        return None
    _boot = 0
    try:
        _bp = _b34_read_json(_B34_PID_NAME)
        if isinstance(_bp, dict):
            _boot = int(_bp.get("ts", 0) or 0)
    except Exception:
        _boot = 0
    if _boot <= 0:
        try: _boot = int(_RC_PROC_START * 1000)
        except Exception: _boot = 0
    try:
        return _b34_oom_correlate(int(crash_ts), _boot, win_ms=_JAVA_OOM_WIN_MS)
    except Exception:
        return None

def _b34_read_json_dur(name):
    try:
        _p = _b34_path(name)
        if _p and os.path.exists(_p):
            with open(_p, "r", encoding="utf-8") as _f:
                d = json.load(_f)
            if isinstance(d, dict): return d
    except Exception:
        pass
    best = None
    try:
        for d in _mn_read_json_both(_b34_path(name)):
            if not isinstance(d, dict): continue
            try: t = int(d.get("ts", 0))
            except Exception: t = 0
            if best is None or t > int(best.get("ts", 0) or 0): best = d
    except Exception:
        pass
    return best
def _b34_write_dur(name, obj):
    _p = _b34_path(name)
    if _p: _atomic_json_write(_p, obj)
    try:
        _mp = _aw_mirror_path(_p) if _p else None
        if _mp: _atomic_json_write(_mp, obj)
    except Exception:
        pass
def _b34_boot_postmortem(fresh_verdict=None):
    
    
    
    
    wal = _b34_read_json(_B34_WAL_NAME)
