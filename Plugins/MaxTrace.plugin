        name = str(cls.getName())
        if name not in self.life_schemas:
            if len(self.life_schemas) >= 32:
                raise RuntimeError("lifecycle schema cap")
            fields, gaps = {}, []
            for n in ("paused", "isPaused", "finishing", "isFinished", "parentLayout"):
