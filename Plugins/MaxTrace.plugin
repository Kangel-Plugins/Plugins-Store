def _b41_bind(lib, c):
    global _THR_OWN_OK, _WREF_OK, _LEAK_FEED_DIM_OK, _FDOWN_OK, _DMB_OWN_OK
    try:
        if hasattr(lib, "cd_thr_live_topn") and hasattr(lib, "cd_thr_adopt"):
            lib.cd_thr_adopt.argtypes = [c.c_int32]; lib.cd_thr_adopt.restype = c.c_int
            lib.cd_thr_live.argtypes = [c.c_int32]; lib.cd_thr_live.restype = c.c_int64
            lib.cd_thr_live_untagged.restype = c.c_int64
            lib.cd_thr_tracked_total.restype = c.c_int64
            lib.cd_thr_adopted_total.restype = c.c_int64
            lib.cd_thr_track_ok.restype = c.c_int
            lib.cd_thr_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_thr_live_topn.restype = c.c_int
            _THR_OWN_OK = True
    except Exception:
        _THR_OWN_OK = False
    try:
        if hasattr(lib, "cd_wref_install") and hasattr(lib, "cd_wref_live_topn"):
            lib.cd_wref_install.restype = c.c_int
            lib.cd_wref_running.restype = c.c_int
            lib.cd_wref_total.restype = c.c_int64
            lib.cd_wref_del_total.restype = c.c_int64
            lib.cd_wref_del_untracked.restype = c.c_int64
            lib.cd_wref_overflow.restype = c.c_int64
            lib.cd_wref_live_untagged.restype = c.c_int64
            lib.cd_wref_live_total.restype = c.c_int64
            lib.cd_wref_live.argtypes = [c.c_int32]; lib.cd_wref_live.restype = c.c_int64
            lib.cd_wref_live_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_wref_live_topn.restype = c.c_int
            _WREF_OK = True
    except Exception:
        _WREF_OK = False
    try:
        if hasattr(lib, "cd_leak_feed_dim"):
            lib.cd_leak_feed_dim.argtypes = [c.c_int32, c.c_int64]; lib.cd_leak_feed_dim.restype = c.c_int
            _LEAK_FEED_DIM_OK = True
    except Exception:
        _LEAK_FEED_DIM_OK = False
    try:
        if hasattr(lib, "cd_fd_owner_topn") and hasattr(lib, "cd_fd_owner_kinds") and hasattr(lib, "cd_fdown_api"):
            lib.cd_fdown_api.restype = c.c_int
            lib.cd_fd_owner_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32]
            lib.cd_fd_owner_topn.restype = c.c_int
            lib.cd_fd_owner_untagged.restype = c.c_int64
            lib.cd_fd_owner_kinds.argtypes = [c.c_int32, c.POINTER(c.c_int64), c.c_int32]
            lib.cd_fd_owner_kinds.restype = c.c_int64
            lib.cd_fdown_stats.argtypes = [c.POINTER(c.c_int64), c.c_int]
            lib.cd_fdown_stats.restype = c.c_int
            _FDOWN_OK = int(lib.cd_fdown_api()) == 1
    except Exception:
        _FDOWN_OK = False
    try:
        if hasattr(lib, "cd_mmap_wa_cfg"):
            lib.cd_mmap_wa_cfg.argtypes = [c.c_int, c.c_int64, c.c_int]
            lib.cd_mmap_wa_cfg.restype = c.c_int
            lib.cd_mmap_wa_cfg(1 if _WA_MMAP_COMMIT_ON else 0, 0, 1 if _WA_MMAP_SHM_ON else 0)
        if hasattr(lib, "cd_fdown_enable"):
            lib.cd_fdown_enable.argtypes = [c.c_int]
            lib.cd_fdown_enable.restype = c.c_int
            lib.cd_fdown_enable(1 if _WA_FD_OWNER_ON else 0)
    except Exception:
        pass
    try:
        if hasattr(lib, "cd_dmabuf_owner_topn"):
            lib.cd_dmabuf_owner_topn.argtypes = [c.POINTER(c.c_int32), c.POINTER(c.c_int64), c.c_int32, c.POINTER(c.c_int64)]
            lib.cd_dmabuf_owner_topn.restype = c.c_int
            _DMB_OWN_OK = True
    except Exception:
        _DMB_OWN_OK = False

