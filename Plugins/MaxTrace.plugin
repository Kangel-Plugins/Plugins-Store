def _b20_anr_path():
    return _data_path(_ANR_FILE_NAME)

def _b20_ack():
    global _B20_UI_TID
    try:
        if _B20_UI_TID is None:
            _B20_UI_TID = int(threading.get_ident())
            _log("Block#20: UI thread tid=%s captured" % _B20_UI_TID)
            try:
                native_ui_tid = _cur_tid()
                globals()["_B33_UI_TID"] = native_ui_tid
                if globals().get("_SELF_NATIVE_OK") and _NLIB is not None and hasattr(_NLIB, "cd_self_set_ui_tid"):
                    _NLIB.cd_self_set_ui_tid(ctypes.c_int64(int(native_ui_tid)))
            except Exception as _e33:
                _log("Block#33: UI tid pass err: %s" % _e33)
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_ack()
            except Exception: pass
    except Exception:
        pass

def _b20_setup_handler():
    global _B20_HANDLER, _B20_PING, _B20_BEAT
    try:
        from java import jclass as _jc, dynamic_proxy as _dp
    except Exception as e:
        _log("Block#20: java bridge unavailable: %r" % e); return False
    try:
        Looper = _jc("android.os.Looper")
        Handler = _jc("android.os.Handler")
        main = Looper.getMainLooper()
        if main is None:
            _log("Block#20: getMainLooper() is None"); return False
        if _B20_HANDLER is not None:
            try: _B20_HANDLER.removeCallbacksAndMessages(None)
            except Exception: pass
        _B20_HANDLER = Handler(main)
    except Exception as e:
        _log("Block#20: Handler(mainLooper) build err: %r" % e); return False
    try:
        if _B20_PING is None:
            Runnable = _jc("java.lang.Runnable")
            class _B20Ping(_dp(Runnable)):
                def run(self):
                    _b20_ack()
            _B20_PING = _B20Ping()
    except Exception as e:
        _log("Block#20: ping Runnable build err: %r" % e); return False
    try:
        if _B20_BEAT is None:
            Runnable = _jc("java.lang.Runnable")
            class _B20Beat(_dp(Runnable)):
                def run(self):
                    _b20_beat()
            _B20_BEAT = _B20Beat()
    except Exception as e:
        _log("Block#20: beat Runnable build err: %r" % e); _B20_BEAT = None
    return True

def _b20_post_ping():
    if _B20_NATIVE and _NLIB is not None:
        try: _NLIB.cd_anr_ping()
        except Exception: pass
    ok = False
    try:
        ok = bool(_B20_HANDLER.post(_B20_PING))
    except Exception as e:
        _log("Block#20: post ping err: %r" % e)
    if not ok:
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_ping_cancel()
            except Exception: pass

def _b20_beat():
    global _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    try:
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_beat()
            except Exception: pass
    except Exception:
        pass

def _b20_post_beat():
    global _B20_BEAT_INFLIGHT
    if _B20_BEAT is None or _B20_HANDLER is None: return
    if _B20_BEAT_INFLIGHT: return
    try:
        from java import jclass as _jc
        Message = _jc("android.os.Message")
        msg = Message.obtain(_B20_HANDLER, _B20_BEAT)
        try: msg.setAsynchronous(True)
        except Exception: pass
        _B20_BEAT_INFLIGHT = True
        if not _B20_HANDLER.sendMessage(msg):
            _B20_BEAT_INFLIGHT = False
    except Exception as e:
        _B20_BEAT_INFLIGHT = False
        _log("Block#20: post beat err: %r" % e)

def _b20_pid_of_frame_mod(mod):
    if not mod or mod == _SELF_ID or mod == __id__:
        return None
    try:
        mobj = _sys.modules.get(mod)
        cand = getattr(mobj, "__id__", None) if mobj is not None else None
        if not (isinstance(cand, str) and cand):
            try:
                c2 = _canon_pid(mod)
                if isinstance(c2, str) and c2 and c2 != mod:
                    cand = c2
            except Exception:
                pass
        if isinstance(cand, str) and cand and cand != _SELF_ID and cand != __id__:
            return cand
    except Exception:
        pass
    return None

def _b20_capture_culprit(fr):
    deepest = None
    stack = []
    f = fr; hops = 0
    while f is not None and hops < 60:
        try:
            g = f.f_globals
            mod = g.get("__name__") or ""
            fn = g.get("__file__") or ((mod + ".py") if mod else "?")
            ln = f.f_lineno
            nm = f.f_code.co_name
        except Exception:
            mod = ""; fn = "?"; ln = -1; nm = "?"
        stack.append("%s:%s %s" % (fn, ln, nm))
        if deepest is None:
            pid = _b20_pid_of_frame_mod(mod)
            if pid:
                deepest = (pid, fn, int(ln) if ln is not None else -1)
        try: f = f.f_back
        except Exception: f = None
        hops += 1
    return deepest, stack[:25]

def _persist_anr_fail(rec):
    p = _b20_anr_path()
    if not p:
        _log("Block#20: нет пути -- пропуск"); return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("Block#20: anr verdict zapisan (%d zapisej) -> %s" % (len(cur), _ANR_FILE_NAME))
    except Exception as e:
        _log("Block#20: verdict persist err: %s: %s" % (type(e).__name__, e))
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

_B20_OPSTAMP_STALE_MARGIN_MS = 300
_B20_HOST_RENDER_ERE = "Shader compilation failed|Pipeline create failed|startInput|startInputInner|Kumiho"
def _b20_host_render_signal():
    try:
        chunks = _b28_read_logcat_re(_B20_HOST_RENDER_ERE, level="V", tail=500)
    except Exception:
        return None
    for _c in (chunks or []):
        if not _c:
            continue
        for _pat in ("Shader compilation failed", "Pipeline create failed", "startInput", "Kumiho"):
            if _pat in _c:
                return _pat
    return None


def _b20_owner_from_op(window_ms):
    try:
        if not (_OP_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_op_read")):
            return None
    except Exception:
        return None
    best = None
    try:
        ob = ctypes.create_string_buffer(_OP_OWNER_MAX)
        ab = ctypes.create_string_buffer(_OP_API_MAX)
        for _dn, _di in _OP_DOMAIN_IDX.items():
            try:
                age = int(_NLIB.cd_op_read(ctypes.c_int32(_di), ob, ctypes.c_int32(_OP_OWNER_MAX), ab, ctypes.c_int32(_OP_API_MAX)))
            except Exception:
                continue
            if age < 0 or age > int(window_ms):
                continue
            own = ob.value.decode("utf-8", "replace") if ob.value else ""
            if not own:
                continue
            if own[:1] == "#" and own[1:].isdigit():
                _nm = _resolve_idx(int(own[1:]))
                if not (isinstance(_nm, str) and _nm):
                    _nm = _resolve_idx_durable(int(own[1:]))
                own = _nm if (isinstance(_nm, str) and _nm) else ""
            if not own:
                continue
            try: own = _canon_pid(own)
            except Exception: pass
            if not isinstance(own, str) or not own or own == _SELF_ID or own == __id__:
                continue
            api = ab.value.decode("utf-8", "replace") if ab.value else ""
            if api == "dispatchMessage":
                continue
            if best is None or age < best[0]:
                best = (age, _dn, own, api)
    except Exception:
        return None
    if best is None:
        return None
    return {"owner": best[2], "domain": best[1], "api": best[3], "age_ms": best[0]}

def _b20_owner_from_op_in_domains(window_ms, domains, owner=None):
    try:
        if not (_OP_NATIVE_OK and _NLIB is not None and _CTYPES_OK and hasattr(_NLIB, "cd_op_read")):
            return None
    except Exception:
        return None
    best = None
    try:
        ob = ctypes.create_string_buffer(_OP_OWNER_MAX)
        ab = ctypes.create_string_buffer(_OP_API_MAX)
        for _dn in domains:
            _di = _OP_DOMAIN_IDX.get(_dn)
            if _di is None:
                continue
            try:
                age = int(_NLIB.cd_op_read(ctypes.c_int32(_di), ob, ctypes.c_int32(_OP_OWNER_MAX), ab, ctypes.c_int32(_OP_API_MAX)))
            except Exception:
                continue
            if age < 0 or age > int(window_ms):
                continue
            own = ob.value.decode("utf-8", "replace") if ob.value else ""
            if not own:
                continue
            if own[:1] == "#" and own[1:].isdigit():
                _nm = _resolve_idx(int(own[1:]))
                if not (isinstance(_nm, str) and _nm):
                    _nm = _resolve_idx_durable(int(own[1:]))
                own = _nm if (isinstance(_nm, str) and _nm) else ""
            if not own:
                continue
            try: own = _canon_pid(own)
            except Exception: pass
            if not isinstance(own, str) or not own or own == _SELF_ID or own == __id__:
                continue
            if owner is not None and own != owner:
                continue
            api = ab.value.decode("utf-8", "replace") if ab.value else ""
            if api == "dispatchMessage":
                continue
            if best is None or age < best[0]:
                best = (age, _dn, own, api)
    except Exception:
        return None
    if best is None:
        return None
    return {"owner": best[2], "domain": best[1], "api": best[3], "age_ms": best[0]}

def _b20_owner_from_scope():
    try:
        if not (_ANR_NATIVE_OK and _NLIB is not None and hasattr(_NLIB, "cd_anr_owner")):
            return None
        idx = int(_NLIB.cd_anr_owner())
    except Exception:
        return None
    if idx is None or idx < 0:
        return None
    nm = _resolve_idx(idx)
    if not (isinstance(nm, str) and nm):
        nm = _resolve_idx_durable(idx)
    if not (isinstance(nm, str) and nm):
        return None
    try: nm = _canon_pid(nm)
    except Exception: pass
    if not isinstance(nm, str) or not nm or nm == _SELF_ID or nm == __id__:
        return None
    return nm

_B29_ON = True
_B29_PERIOD_S = 3.0
_B29_MIN_PCT = 1.0
_B29_TOP_N = 8
_B29_HOG_PCT = 60.0
_B29_STALE_MS = 8000


_GIL_B29, _GIL_B27, _GIL_B6, _GIL_B31, _GIL_B20, _GIL_B28, _GIL_OTHER = 0, 1, 2, 3, 4, 5, 6
_GIL_B6_JHEAP, _GIL_B6_KILL, _GIL_B6_LEAK = 7, 8, 9

def _gil_begin(slot):
    if _GIL_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_gil_mark_begin(int(slot))
        except Exception: pass

def _gil_end(slot):
    if _GIL_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_gil_mark_end(int(slot))
        except Exception: pass


class _CdCpuRow(ctypes.Structure):
    _fields_ = [("tid", ctypes.c_int32), ("owner_idx", ctypes.c_int32),
                ("milli_pct", ctypes.c_int32), ("_pad", ctypes.c_int32),
                ("comm", ctypes.c_char * 16)]

def _b29_owner_from_idx(idx, tid):
    if idx is None or idx < 0:
        try: idx = _reg_get(int(tid))
        except Exception: idx = None
    if idx is None or idx < 0: return None
    nm = _resolve_idx(idx)
    if not (isinstance(nm, str) and nm):
        nm = _resolve_idx_durable(idx)
    if not (isinstance(nm, str) and nm): return None
    try: nm = _canon_pid(nm)
    except Exception: pass
    if not isinstance(nm, str) or not nm or nm == _SELF_ID or nm == __id__:
        return None
    return nm

def _b29_native_read():
    if not (_CPU_NATIVE_OK and _NLIB is not None):
        return None
    try:
        addr = int(_NLIB.cd_cpu_rows_addr())
        rsz = int(_NLIB.cd_cpu_row_size())
        cap = int(_NLIB.cd_cpu_max())
        if addr == 0 or rsz != ctypes.sizeof(_CdCpuRow) or cap <= 0:
            return None
        arr_t = _CdCpuRow * cap
        for _att in range(8):
            s1 = int(_NLIB.cd_cpu_seq())
            if s1 & 1:
                time.sleep(0.0005); continue
            cnt = int(_NLIB.cd_cpu_count())
            if cnt < 0: cnt = 0
            if cnt > cap: cnt = cap
            win = int(_NLIB.cd_cpu_win_ms())
            ts = int(_NLIB.cd_cpu_ts_ms())
            arr = arr_t.from_address(addr)
            raw = [(int(arr[i].tid), int(arr[i].owner_idx), int(arr[i].milli_pct),
                    arr[i].comm.decode("utf-8", "replace")) for i in range(cnt)]
            s2 = int(_NLIB.cd_cpu_seq())
            if s1 == s2:
                age = (int(time.time() * 1000) - ts) if ts else (1 << 30)
                rows = []
                for tid, oidx, mpct, nm in raw:
                    pct = mpct / 1000.0
                    if pct < _B29_MIN_PCT: continue
                    rows.append({"tid": tid, "name": nm, "pct": round(pct, 1),
                                 "owner": _b29_owner_from_idx(oidx, tid)})
                return rows[:_B29_TOP_N], {"age_ms": age, "win_ms": win}
            time.sleep(0.0003)
        return None
    except Exception:
        return None


def _b29_cpu_top():
    if _CPU_NATIVE_OK and _NLIB is not None:
        _nr = _b29_native_read()
        if _nr is not None: return _nr
    return [], None

def _b29_fresh_top(window_ms=160):
    if _CPU_NATIVE_OK and _NLIB is not None:
        try: _NLIB.cd_cpu_sample_now(int(window_ms))
        except Exception: pass
        _nr = _b29_native_read()
        if _nr is not None:
            try: _nr[1]["age_ms"] = 0
            except Exception: pass
            return _nr
    return [], None

def _b29_hog_culprit(rows, meta):
    if not rows or meta is None: return None
    if meta.get("age_ms", 1 << 30) > _B29_STALE_MS: return None
    top = rows[0]
    if top.get("owner") and top["pct"] >= _B29_HOG_PCT:
        if len(rows) == 1 or rows[1]["pct"] < top["pct"] * 0.5 or rows[1].get("owner") == top["owner"]:
            return {"owner": top["owner"], "pct": top["pct"], "tid": top["tid"],
                    "name": top["name"], "age_ms": meta.get("age_ms")}
    return None

_B29_CORROB_PCT = 35.0

def _b29_top_owned_by(rows, owner):
    if not rows or not owner:
        return None
    best = None
    for r in (rows or []):
        try:
            if r.get("owner") == owner and float(r.get("pct") or 0.0) >= _B29_CORROB_PCT:
                if best is None or r["pct"] > best["pct"]:
                    best = r
        except Exception:
            continue
    return best


def _b29_start():
    if not _B29_ON:
        _log("Block#29: disabled"); return
    if _CPU_NATIVE_OK and _NLIB is not None:
        try:
            _rc = int(_NLIB.cd_cpu_start(int(_B29_PERIOD_S * 1000), int(_B29_MIN_PCT * 1000), int(_B29_TOP_N)))
            _log("Block#29 native CPU sampler: start rc=%d period=%.1fs (off-GIL, +DR Lever 1)" % (_rc, _B29_PERIOD_S))
        except Exception as _e:
            _log("Block#29 native CPU sampler start failed (%r) -> CPU sampling OFF (no python fallback, +HW)" % _e)
        return
    _log("Block#29: native CPU sampler unavailable -> CPU sampling OFF (no python fallback, +HW)")

def _b29_stop():
    try:
        if _CPU_NATIVE_OK and _NLIB is not None:
            try: _NLIB.cd_cpu_stop()
            except Exception: pass
    except Exception: pass

_BLOCK33_ON = False
_B33_BASELINE = None
_B33_PERIOD_S = 2.0
_B33_UI_BUDGET_MS_PER_S = 8.0
_B33_TOTAL_BUDGET_MS_PER_S = 25.0
_B33_GIL_GAP_BUDGET_MS_PER_S = 14.0

def _b33_status():
    if not (_B33_NATIVE_OK and _NLIB is not None):
        return None
    try:
        buf = (ctypes.c_int64 * 16)()
        n = int(_NLIB.cd_b33_status(buf, 16))
        if n < 13:
            return None
        v = [int(buf[i]) for i in range(min(n, 16))]
        return {"running": bool(v[0]), "degrade_level": v[1], "gref_level": v[2],
                "strike": v[3], "ok_run": v[4], "na_min_bytes": v[5],
                "na_sample_div": v[6], "cpu_period_ms": v[7], "gref_time_div": v[8],
                "ui_ms_per_s": v[9] / 100.0, "total_ms_per_s": v[10] / 100.0,
                "gil_ms_per_s": v[11] / 100.0, "last_emit_ms": v[12]}
    except Exception:
        return None

def _b33_sync_globals():
    st = _b33_status()
    if not st:
        return None
    global _NA_MIN_BYTES, _B29_PERIOD_S
    try:
        if st.get("na_min_bytes", 0) > 0: _NA_MIN_BYTES = int(st["na_min_bytes"])
        if st.get("cpu_period_ms", 0) > 0: _B29_PERIOD_S = float(st["cpu_period_ms"]) / 1000.0
    except Exception:
        pass
    return st

def _b33_capture_baseline():
    b = {"na_min_bytes": int(_NA_MIN_BYTES), "b29_period_s": float(_B29_PERIOD_S)}
    try:
        if _NLIB is not None:
            if hasattr(_NLIB, "cd_na_sample_div"):
                b["na_sample_div"] = int(_NLIB.cd_na_sample_div())
            if hasattr(_NLIB, "cd_gref_time_div"):
                b["gref_time_div"] = int(_NLIB.cd_gref_time_div())
            if hasattr(_NLIB, "cd_na_is_on"):
                b["na_is_on"] = bool(int(_NLIB.cd_na_is_on()))
    except Exception:
        pass
    return b

def _b33_start():
    global _B33_BASELINE
    if not _BLOCK33_ON:
        _log("Block#33: disabled"); return
    if not (_B33_NATIVE_OK and _NLIB is not None):
        _log("Block#33: cd_b33_start недоступен (старый .so) -> watchdog OFF")
        return
    p = _oom_path(_SELF_OVERHEAD_NAME)
    if not p:
        _log("Block#33: нет каталога для self_overhead.json -> watchdog OFF"); return
    _run0 = 0
    try:
        _run0 = int(_NLIB.cd_b33_running())
    except Exception:
        _run0 = 0
    if _run0 == 0:
        if _B33_BASELINE is not None:
            try: _b33_restore_baseline()
            except Exception: pass
            if _B33_BASELINE is not None:
                _log("Block#33 +PB: previous baseline restore incomplete -> start cancelled")
                return
        _B33_BASELINE = _b33_capture_baseline()
    try:
        rc = int(_NLIB.cd_b33_start(p.encode("utf-8"), str(__id__).encode("utf-8"),
                                    int(_B33_PERIOD_S * 1000),
                                    int(_B33_UI_BUDGET_MS_PER_S * 1000),
                                    int(_B33_TOTAL_BUDGET_MS_PER_S * 1000),
                                    int(_B33_GIL_GAP_BUDGET_MS_PER_S * 1000)))
        _log("Block#33 native watchdog start rc=%d period=%.1fs ui=%.1f total=%.1f gil=%.1f ms/s" % (
            rc, _B33_PERIOD_S, _B33_UI_BUDGET_MS_PER_S, _B33_TOTAL_BUDGET_MS_PER_S, _B33_GIL_GAP_BUDGET_MS_PER_S))
    except Exception as e:
        try: _log("Block#33 start err: %r" % e)
        except Exception: pass

def _b33_restore_baseline(best_effort=False):
    global _NA_MIN_BYTES, _B29_PERIOD_S, _B33_BASELINE
    b = _B33_BASELINE
    if not b:
        return
    _fail = []
    try:
        _NA_MIN_BYTES = int(b["na_min_bytes"])
        _B29_PERIOD_S = float(b["b29_period_s"])
    except Exception:
        return
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_na_min_bytes") and hasattr(_NLIB, "cd_na_enable"):
            _want_on = 1 if b.get("na_is_on", True) else 0
            _cur = int(_NLIB.cd_na_min_bytes())
            _cur_on = int(_NLIB.cd_na_is_on()) if hasattr(_NLIB, "cd_na_is_on") else _want_on
            if _cur != int(_NA_MIN_BYTES) or _cur_on != _want_on:
                _rc = int(_NLIB.cd_na_enable(_want_on, int(_NA_MIN_BYTES)))
                if _rc != 0:
                    _fail.append("na_enable(rc=%d)" % _rc)
    except Exception:
        _fail.append("na_enable")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_na_set_sample_div") and "na_sample_div" in b:
            _NLIB.cd_na_set_sample_div(int(b["na_sample_div"]))
    except Exception:
        _fail.append("na_sample_div")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_gref_set_time_div") and "gref_time_div" in b:
            _NLIB.cd_gref_set_time_div(int(b["gref_time_div"]))
    except Exception:
        _fail.append("gref_time_div")
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_cpu_set_period"):
            _NLIB.cd_cpu_set_period(int(_B29_PERIOD_S * 1000))
    except Exception:
        _fail.append("cpu_set_period")
    try:
        _log("Block#33 +OX: baseline restored (na_min=%d, b29_period=%.1fs, na_div=%s, gref_div=%s, na_on=%s)" % (
            int(_NA_MIN_BYTES), float(_B29_PERIOD_S),
            b.get("na_sample_div", "-"), b.get("gref_time_div", "-"), b.get("na_is_on", "-")))
    except Exception:
        pass
    if _fail:
        try: _log("Block#33 +OZ: baseline restore PARTIAL, failed setters: %s" % ", ".join(_fail))
        except Exception: pass
    if best_effort or not _fail:
        _B33_BASELINE = None

def _b33_stop():
    try:
        if _B33_NATIVE_OK and _NLIB is not None and int(_NLIB.cd_b33_running()) == 1:
            _b33_sync_globals()
            _NLIB.cd_b33_stop()
    except Exception:
        pass


_DN_IDLE_CLASSES = ("android.os.MessageQueue", "android.os.Looper", "android.os.Handler", "android.app.ActivityThread", "com.android.internal.os", "java.lang.reflect.Method", "dalvik.system", "java.lang.Object", "com.chaquo", "java.chaquopy", "org.python")
_DN_PLUGIN_MARKERS = ("chaquo", "chaquopy", "org.python", "pythonplugin")
_DN_SYSCALL_NAMES = {98: "futex", 73: "ppoll", 22: "epoll_pwait", 63: "read", 64: "write", 113: "clock_nanosleep", 101: "nanosleep", 71: "sendmsg", 212: "recvmsg", 29: "ioctl", 56: "openat"}
_DN_MIDSTALL_AFTER_MS = 1200
_DN_MIDSTALL_EVERY_MS = 800
_DN_MIDSTALL_MAX = 5
_DN_MIDSTALL_SNAPSHOT = []

def _dn_capture_java_ui_stack(max_frames=48):
    try:
        from java import jclass as _jc
        Looper = _jc("android.os.Looper")
        main = Looper.getMainLooper()
        if main is None:
            return None, 0, None
        th = main.getThread()
        if th is None:
            return None, 0, None
        elems = th.getStackTrace()
    except Exception as e:
        try: _log("Block#20 +DN: java stack err: %r" % e)
        except Exception: pass
        return None, 0, None
    frames = []
    plugin_n = 0
    component = None
    try:
        n = len(elems)
    except Exception:
        n = 0
    for i in range(n):
        try:
            el = elems[i]
            cls = el.getClassName() or "?"
            mth = el.getMethodName() or "?"
            fn = el.getFileName() or ""
            ln = el.getLineNumber()
        except Exception:
            continue
        frames.append("%s.%s(%s:%s)" % (cls, mth, fn, ln))
        low = cls.lower()
        if any(m in low for m in _DN_PLUGIN_MARKERS):
            plugin_n += 1
        if component is None and not cls.startswith(_DN_IDLE_CLASSES):
            component = "%s.%s" % (cls, mth)
        if len(frames) >= max_frames:
            break
    return frames, plugin_n, component

def _dn_proc_field(path):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return None

def _dn_capture_kernel_state(ui_tid_linux):
    try:
        tid = int(ui_tid_linux)
    except Exception:
        return None
    if tid <= 0:
        return None
    base = "/proc/self/task/%d" % tid
    out = {"tid": tid}
    st = _dn_proc_field(base + "/stat")
    if st:
        try:
            cp = st.rfind(")")
            out["state"] = st[cp + 2] if (cp >= 0 and len(st) > cp + 2) else None
        except Exception:
            out["state"] = None
    out["wchan"] = _dn_proc_field(base + "/wchan")
    sc = _dn_proc_field(base + "/syscall")
    if sc:
        out["syscall_raw"] = sc
        try:
            nr = int(sc.split()[0])
            out["syscall_nr"] = nr
            out["syscall"] = _DN_SYSCALL_NAMES.get(nr)
        except Exception:
            pass
    s = out.get("state")
    wc = (out.get("wchan") or "").lower()
    if s == "R":
        out["nature"] = "on-cpu (host compute / busy-loop)"
    elif s in ("S", "D"):
        if "futex" in wc or out.get("syscall") == "futex":
            out["nature"] = "blocked on lock (futex) - host lock contention"
        elif "binder" in wc or "ioctl" in wc:
            out["nature"] = "blocked in binder IPC"
        elif "poll" in wc or "epoll" in wc:
            out["nature"] = "epoll/poll wait (looper idle or polling)"
        elif "io_schedule" in wc or "wait_on_page" in wc or "folio_wait" in wc or "page_fault" in wc or "filemap" in wc or "__lock_page" in wc or "read_pages" in wc or "balance_dirty_pages" in wc or out.get("syscall") in ("read", "write"):
            out["nature"] = "blocked on page/disk I/O (memory-pressure page-in)"
        else:
            out["nature"] = "sleeping (%s)" % (wc or "?")
    else:
        out["nature"] = "state=%s" % (s or "?")
    return out

def _persist_host_stall(rec, p):
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("Block#20 +DN: host-stall verdict zapisan (%d zapisej) -> %s" % (len(cur), _HOST_STALL_FILE_NAME))
    except Exception as e:
        _log("Block#20 +DN: host verdict persist err: %s: %s" % (type(e).__name__, e))
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _dn_live_scope_owner():
    try:
        tid = globals().get("_B33_UI_TID")
        if tid is None: return None
        idx = _reg_get(int(tid))
        if idx is None or int(idx) < 0: return None
        nm = _resolve_idx(int(idx))
        if not (isinstance(nm, str) and nm): nm = _resolve_idx_durable(int(idx))
        if not (isinstance(nm, str) and nm): return None
        try: nm = _canon_pid(nm)
        except Exception: pass
        if not (isinstance(nm, str) and nm): return None
        return nm
    except Exception:
        return None

def _dn_mid_scope_owner(midsamples, chosen):
    try:
        if chosen is not None and chosen.get("scope_owner"):
            return chosen.get("scope_owner")
        for s in reversed(list(midsamples or [])):
            try:
                if s.get("scope_owner"): return s.get("scope_owner")
            except Exception: continue
    except Exception:
        pass
    return None

def _dn_choose_host_sample(midsamples):
    best = None
    for s in midsamples or []:
        try:
            if s.get("component"):
                if best is None or (s.get("held_ms") or 0) > (best.get("held_ms") or 0):
                    best = s
        except Exception:
            continue
    return best

_DN_HOST_PREFIXES = ("android.", "androidx.", "java.", "javax.", "kotlin.", "kotlinx.", "dalvik.", "libcore.", "sun.", "com.android.", "org.telegram.", "com.exteragram.", "com.chaquo.", "java.chaquopy", "org.python")
def _dn_java_plugin_owner(jframes):
    try:
        _ku = _known_union()
    except Exception:
        _ku = None
    if not _ku:
        return None
    for _f in (jframes or []):
        try:
            _cls = _f.split("(", 1)[0].rsplit(".", 1)[0] if "(" in _f else _f
            if not _cls or _cls.startswith(_DN_HOST_PREFIXES):
                continue
            _pid = _map_stack_to_id(_cls, _ku)
            if _pid and _pid not in (_SELF_ID, __id__):
                return _pid
        except Exception:
            continue
    return None


def _dn_classify_host(jframes, plugin_n, component, kernel, phase):
    top = (jframes[0] if jframes else "") or ""
    idle = (component is None) or top.startswith("android.os.MessageQueue.nativePollOnce")
    if idle:
        return "host/undetermined", "low", "anr/host-idle", True
    if plugin_n > 0:
        if phase == "mid-stall":
            return component, "medium", "anr/host?+plugin-frames", False
        return component, "low", "anr/host?+plugin-frames", False
    if phase == "mid-stall":
        return component, "high", "anr/host", False
    wc = ((kernel or {}).get("wchan") or "").lower()
    st = (kernel or {}).get("state")
    active = (st in ("R", "D")) or ("futex" in wc) or ("binder" in wc) or ("io_schedule" in wc)
    return component, ("medium" if active else "low"), "anr/host", False

_HX_RENDER_NAMES = ("renderthread", "hwuitask", "glthread", "mali-",
                    "gpu completion", "renderengine", "surfaceflinger")
_HX_RENDER_DOM_PCT = 45.0
_HX_UNTAGGED_DOM_PCT = 50.0
_HX_RENDER_RATIO = 1.5
_HX_COCULPRIT_PCT = 60.0
_HX_CPU_STARVE_PCT = 90.0
_HX_LEAK_WINDOW_MS = 120000
_HX_LEAK_RECENT = {}
_HX_LEAK_LOCK = threading.Lock()

_HX_DISPATCH_QUEUE_NAMES = ("stagequeue", "storagequeue", "sendqueue", "downloadqueue", "uploadqueue", "dispatchqueue")

def _hx_is_dispatch_queue_name(nm):
    if not nm: return False
    low = str(nm).lower()
    for t in _HX_DISPATCH_QUEUE_NAMES:
        if t in low: return True
    return False

def _hx_is_render_name(nm):
    if not nm: return False
    low = str(nm).lower()
    for t in _HX_RENDER_NAMES:
        if t in low: return True
    return False

def _hx_owned_hot(rows, owner):
    best = None
    for r in (rows or []):
        try:
            if r.get("owner") == owner and (best is None or float(r.get("pct") or 0.0) > float(best.get("pct") or 0.0)):
                best = r
        except Exception:
            continue
    return best

def _hx_conf_down(conf):
    return {"high": "medium", "medium": "low", "low": "low"}.get(conf, conf)

def _hx_leak_corroborates(owner):
    if not owner: return None
    now = int(time.time() * 1000)
    try:
        with _HX_LEAK_LOCK:
            ts = _HX_LEAK_RECENT.get(owner)
        if ts and (now - ts) <= _HX_LEAK_WINDOW_MS:
            return "view-leak"
    except Exception:
        pass
    try:
        if owner in (_b28_hot_hook_owners() or {}):
            return "hot-hook"
    except Exception:
        pass
    return None

def _hx_apply(culprit, src, conf, py_file, crows):
    extra = {}
    rows = crows or []
    has_pyframe = bool(py_file)
    if rows and not has_pyframe and culprit:
        top = rows[0]
        try: top_pct = float(top.get("pct") or 0.0)
        except Exception: top_pct = 0.0
        if _hx_is_render_name(top.get("name")) and (not top.get("owner")) and top_pct >= _HX_RENDER_DOM_PCT:
            own = _hx_owned_hot(rows, culprit)
            own_pct = float((own or {}).get("pct") or 0.0)
            if own is None or top_pct >= own_pct * _HX_RENDER_RATIO:
                extra["render_bound"] = True
                extra["render_thread"] = {"tid": top.get("tid"), "name": top.get("name"), "pct": round(top_pct, 1)}
                extra["cpu_suggests"] = "host/render"
                _nc = _hx_conf_down(conf)
                if _nc != conf:
                    extra["cv_conf_from"] = conf; conf = _nc
                if "+render?" not in (src or ""):
                    src = (src or "anr/ui-thread") + "+render?"
    if rows and culprit:
        co = None
        for r in rows:
            try:
                ow = r.get("owner"); pc = float(r.get("pct") or 0.0)
            except Exception:
                continue
            if ow and ow != culprit and pc >= _HX_COCULPRIT_PCT and (co is None or pc > co["pct"]):
                co = {"owner": ow, "tid": r.get("tid"), "name": r.get("name"), "pct": round(pc, 1)}
        if co is not None:
            extra["co_culprit"] = co
            if conf == "low":
                extra["cv_note"] = "co_culprit %s burns %.1f%% CPU on a bg thread during the stall" % (co["owner"], co["pct"])
    if culprit and conf == "low" and not extra.get("render_bound"):
        _lk = _hx_leak_corroborates(culprit)
        if _lk:
            extra["cv_conf_from"] = conf; conf = "medium"
            extra["leak_corrob"] = _lk
            if "+leak?" not in (src or ""):
                src = (src or "anr") + "+leak?"
    if rows and not has_pyframe and culprit and not extra.get("render_bound") and not extra.get("co_culprit"):
        _t0 = rows[0]
        try: _tp0 = float(_t0.get("pct") or 0.0)
        except Exception: _tp0 = 0.0
        if (not _t0.get("owner")) and (not _hx_is_render_name(_t0.get("name"))) and _tp0 >= _HX_UNTAGGED_DOM_PCT:
            _o4 = _hx_owned_hot(rows, culprit)
            _o4p = float((_o4 or {}).get("pct") or 0.0)
            if _o4 is None or _tp0 >= _o4p * _HX_RENDER_RATIO:
                extra["untagged_top"] = {"tid": _t0.get("tid"), "name": _t0.get("name"), "pct": round(_tp0, 1)}
                if _hx_is_dispatch_queue_name(_t0.get("name")) and "scope" in (src or "") and not str(culprit).startswith("host"):
                    extra["cpu_suggests"] = "scope-owner-dispatch"
                    extra["dispatch_corroborates"] = {"name": _t0.get("name"), "pct": round(_tp0, 1), "owner": culprit}
                    if conf == "low":
                        extra["cv_conf_from"] = conf; conf = "medium"
                    if "+dispatch?" not in (src or ""):
                        src = (src or "anr/ui-thread") + "+dispatch?"
                else:
                    extra["cpu_suggests"] = "untagged"
                    _nc4 = _hx_conf_down(conf)
                    if _nc4 != conf:
                        extra["cv_conf_from"] = conf; conf = _nc4
                    if "+untagged?" not in (src or ""):
                        src = (src or "anr/ui-thread") + "+untagged?"
    return culprit, src, conf, extra


def _native_event_ms(record):
    """Original native capture time; publication/mtime is not a crash time."""
    if not isinstance(record, dict): return None
    ne = record.get("native_emit")
    values = [record.get("crash_ts"), record.get("event_ts")]
    if isinstance(ne, dict): values.append(ne.get("ts_ms"))
    for value in values:
        stamp = _ui_timestamp_s(value)
        if stamp is not None: return int(round(stamp * 1000.0))
    return None

def _b20_vfork_host_sample(midsamples):
    """Narrow +UA gate: kernel-confirmed host vfork wait, no plugin frames.
    A Python/Java plugin frame or process launch without kernel evidence does
    NOT enter this gate. Scope/op/foreign-thread exit are not direct UI frames.
    """
    chosen = _dn_choose_host_sample(midsamples)
    if not isinstance(chosen, dict): return None
    frames = chosen.get("jframes") or []
    kernel = chosen.get("kernel") or {}
    if int(chosen.get("plugin_n") or 0) != 0: return None
    if _dn_java_plugin_owner(frames): return None
    if float(chosen.get("held_ms") or 0) < 0.5 * _B20_TIMEOUT_MS: return None
    if kernel.get("state") not in ("S", "D"): return None
    if "wait_for_vfork_done" not in str(kernel.get("wchan") or ""): return None
    if not frames or not str(frames[0]).startswith("java.lang.UNIXProcess.forkAndExec"):
        return None
    if not any(str(f).startswith("org.telegram.messenger.EmuDetector.checkIp") for f in frames):
        return None
    return chosen

def _b20_selfkill_corr(waited_ms):
    try:
        # sentinel removed
        rec = globals().get("_B30_LAST_BLOCKED")
        if not isinstance(rec, dict): return None
        _proc = rec.get("proc_pid")
        if _proc is not None and int(_proc) != os.getpid(): return None
        _cu = rec.get("culprit")
        if not _cu or str(_cu).startswith(("unknown", "idx#")): return None
        d = (int(time.time() * 1000) - int(waited_ms)) - int(rec.get("ts") or 0)
        if -500 <= d <= 1500:
            return {"culprit": _cu, "vector": rec.get("vector"), "dropper": rec.get("dropper"), "tid": rec.get("tid"), "kill_ts": int(rec.get("ts") or 0), "delta_ms": int(d)}
    except Exception:
        pass
    return None


def _b20_selfkill_aftermath(waited_ms):
    try:
        rec = globals().get("_B30_LAST_BLOCKED")
        if not isinstance(rec, dict): return None
        _proc = rec.get("proc_pid")
        if _proc is not None and int(_proc) != os.getpid(): return None
        _cu = rec.get("culprit")
        if not _cu or str(_cu).startswith(("unknown", "idx#")): return None
        d = (int(time.time() * 1000) - int(waited_ms)) - int(rec.get("ts") or 0)
        if 1500 < d <= _B20_SELFKILL_AFTERMATH_MS:
            return {"culprit": _cu, "vector": rec.get("vector"), "dropper": rec.get("dropper"), "tid": rec.get("tid"), "kill_ts": int(rec.get("ts") or 0), "delta_ms": int(d)}
    except Exception:
        pass
    return None


def _b20_report_stall(waited_ms):
    try:
        frames = _sys._current_frames()
    except Exception as e:
        _log("Block#20: _current_frames err: %r" % e); return
    fr = frames.get(_B20_UI_TID) if _B20_UI_TID is not None else None
    deepest, stack = (None, [])
    _bi_nature = None
    _sk = None
    if fr is not None:
        try: deepest, stack = _b20_capture_culprit(fr)
        except Exception as e: _log("Block#20: capture err: %r" % e)
    try:
        _crows, _cmeta = _b29_cpu_top()
    except Exception:
        _crows, _cmeta = [], None
    if deepest is None:
        _ua_mid = list(globals().get("_DN_MIDSTALL_SNAPSHOT") or [])
        try: _ua_launch = _b20_vfork_host_sample(_ua_mid)
        except Exception: _ua_launch = None
        if _ua_launch is not None:
            _ua_weak = {"scope_owner": _b20_owner_from_scope()}
            try: _ua_weak["blocked_exit"] = _b20_selfkill_corr(waited_ms)
            except Exception: pass
            _ua_rec = {
                "had_anr": True, "host_side": True, "culprit_kind": "host",
                "event_type": "host_stall", "dropbox_tag": "data_app_anr",
                "tombstone_norm_version": 1,
                "culprit": "java.lang.UNIXProcess.forkAndExec",
                "component": "java.lang.UNIXProcess.forkAndExec",
                "src": "anr/host-vfork+UA", "confidence": "high",
                "where": "ui-thread", "stalled_ms": int(waited_ms),
                "ui_tid": _B20_UI_TID, "ui_tid_linux": globals().get("_B33_UI_TID"),
                "proc_pid": os.getpid(), "so_abi": globals().get("_SO_ABI_SEEN"),
                "plugin_frames_in_ui_stack": 0, "sample_phase": "mid-stall",
                "sample_held_ms": _ua_launch.get("held_ms"), "looper_idle": False,
                "java_stack": _ua_launch.get("jframes"), "kernel": _ua_launch.get("kernel"),
                "hot_frames": _b42_hot_frames(_ua_mid), "cpu_top": _crows,
                "cpu_win_ms": (_cmeta or {}).get("win_ms"),
                "weak_context": _ua_weak,
                "reason": "UI blocked in host EmuDetector.checkIp -> forkAndExec; kernel wait_for_vfork_done. Scope/blocked exit are context, not proof of plugin causation.",
                "ts": int(time.time() * 1000)}
            try: _ui_ctx_attach(_ua_rec)
            except Exception: pass
            _ua_path = _oom_path(_HOST_STALL_FILE_NAME)
            if _ua_path:
                with _B20_LOCK: _persist_host_stall(_ua_rec, _ua_path)
            _log("Block#20 +UA: kernel-confirmed host vfork wait overrides weak scope/selfkill correlation; context=%r" % _ua_weak)
            return
    if deepest is not None:
        culprit, py_file, py_line = deepest
        src = "anr/ui-thread"; conf = "high"; py_mod = culprit
        try:
            _bi_imp = [_f for _f in (stack or []) if any(_m in _f for _m in ("_bootstrap_external", "_bootstrap.pyc", "importer.pyc", "find_spec", "find_module", "_find_and_load", "importlib"))]
            if _bi_imp:
                _bi_nature = "blocking import on UI thread: %s -> import/find_module в apply_ui/tick (перенести импорт в фон)" % culprit
                src = src + "+blocking-import"
                _log("Block#20 +BI: blocking import on UI thread for %r (%d import frames) -> nature tagged" % (culprit, len(_bi_imp)))
        except Exception as _ebi:
            try: _log("Block#20 +BI: import-detect err: %r" % _ebi)
            except Exception: pass
    else:
        owner = _b20_owner_from_scope()
        _opinfo = _b20_owner_from_op(int(waited_ms) + 2500)
        _op_stale = False
        if _opinfo is not None:
            try:
                _op_age = int(_opinfo.get("age_ms") or 0)
