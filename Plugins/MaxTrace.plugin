        minus = self.mh.dropArguments(self.int_constant(-1), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        get_thread = self.lk.unreflect(_q42_cls("java.lang.Thread").getMethod("currentThread"))
        thread_id = self.mh.filterReturnValue(get_thread, self.lk.unreflect(_q42_cls("java.lang.Thread").getMethod("getId")))
        thread_id = self.mh.dropArguments(thread_id, 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
