        def exact_class(cls):
            return self.then(self.class_of, equals_class.bindTo(cls))
        queue_equal = self.mh.insertArguments(self.same_live, 0, self.array([self.main_queue]))
        one = self.mh.dropArguments(self.int_constant(1), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        zero = self.mh.dropArguments(self.int_constant(0), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        send_result = self.mh.guardWithTest(self.result, one, zero)
        send_outcome = self.mh.guardWithTest(self.thrown, zero, send_result)
        run_outcome = self.mh.guardWithTest(self.thrown, one, zero)
                                                                           
                                                                               
        callback_valid = exact_class(callback_class)
        false_value = self.mh.dropArguments(self.mh.constant(_jc("java.lang.Boolean").TYPE, _jc("java.lang.Boolean").FALSE), 0, jarray(_q42_cls("java.lang.Class"))([ref_type]))
        for other_field, other in fields:
            if other_field != field:
                callback_valid = self.mh.guardWithTest(self.then(other, self.is_fragment), false_value, callback_valid)
        for _, _, _, cb in warm:
            if cb is not None and not bool(self.call(callback_valid, cb)):
                return fallback("warm_extra_fragment_capture")
        for run in (False, True):
            callback = self.param_this if run else self.param_callback
            queue = self.param_handler_queue if self.site == "handler_send_at_time" else self.param_this
            identity = self.mh.identity(ref_type)
            for lifecycle in (False, True):
                                                                               
                                                                               
                                                                               
                handles = [identity, identity, mask if lifecycle else minus,
                    self.hash, self.hash, self.hash, callback_valid, exact_class(target_class),
                    self.is_fragment, self.then(queue, queue_equal) if not run else exact_class(callback_class),
                    thread_id, minus if lifecycle else (run_outcome if run else send_outcome)]
