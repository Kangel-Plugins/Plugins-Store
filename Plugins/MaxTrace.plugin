            tail = self.mh.explicitCastArguments(tail, tail.type().changeParameterType(1, Long.TYPE).changeParameterType(2, Long.TYPE))
            tail = self.mh.insertArguments(tail, 1, self.array([Long.valueOf(2), Long.valueOf(12)]))
            text = self.mh.filterReturnValue(tail, self.lk.unreflect(arrays.getMethod("deepToString", array_class)))
            element = self.mh.arrayElementGetter(array_class)
            element = self.mh.explicitCastArguments(element, element.type().changeParameterType(1, Long.TYPE))
            parts = [self.mh.insertArguments(element, 1, self.array([Long.valueOf(i)])) for i in (0, 1)] + [text]
            compact = self.mh.identity(array_class).asCollector(array_class, 3)
            for i, handle in enumerate(parts):
                handle = handle.asType(handle.type().changeReturnType(self.obj))
                compact = self.mh.filterArguments(compact, i, jarray(_jc("java.lang.invoke.MethodHandle"))([handle]))
            signature = compact.type().dropParameterTypes(1, 3)
            compact = self.mh.permuteArguments(compact, signature, jarray(_jc("java.lang.Integer").TYPE)([0, 0, 0]))
