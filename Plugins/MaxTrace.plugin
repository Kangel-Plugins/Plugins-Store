                except Exception: pass
    except Exception: pass
    try:
        _mp_weak = (rec.get("crashed_plugin_id") in (None, "unknown")) or (rec.get("confidence") in (None, "none", "low"))
        if rec.get("mem_pressure") and _mp_weak:
            _occ = _oom_crash_correlate(rec.get("ts") or crash_ts)
            if isinstance(_occ, dict) and _occ.get("culprit"):
                _occonf = _occ.get("confidence") or "medium"
                if _occonf == "high": _occonf = "medium"
