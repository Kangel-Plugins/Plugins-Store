class DexBridge:
    def __init__(self, entry_class: str):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False
        self._methods = {}

    def is_loaded(self):
        return self.loaded

    def load(self):
        if self.loaded:
            return True
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            if not ctx:
                return False
            payload = self._extract_payload()
            if not payload:
                return False
            byte_buffer = jclass("java.nio.ByteBuffer").wrap(payload)
            class_loader = jclass("dalvik.system.InMemoryDexClassLoader")(byte_buffer, ctx.getClassLoader())
            self.clazz = class_loader.loadClass(self.entry_class)
            for m in self.clazz.getDeclaredMethods():
                m.setAccessible(True)
                self._methods[str(m.getName())] = m
            self.loaded = True
            return True
        except Exception as e:
            _log(f"MaxTrace: DEX load error: {e}")
            return False

    def call(self, name: str, *args):
        try:
            if not self.loaded:
                if not self.load():
                    return None
            if name in self._methods:
                return self._methods[name].invoke(None, *args)
        except Exception as e:
            _log(f"MaxTrace: DEX method {name} error: {e}")
        return None

    def _extract_payload(self) -> bytes:
        try:
            with open(__file__, "r", encoding="utf-8") as f:
                content = f.read()
            m_begin = "# " + "__DEX_BEGIN__"
            m_end = "# " + "__DEX_END__"
            if m_begin not in content or m_end not in content:
                return b""
            block = content.split(m_begin, 1)[1].split(m_end, 1)[0]
            lines = [l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#")]
            raw_b64 = "".join(lines)
            if not raw_b64:
                return b""
            import zlib, base64
            return zlib.decompress(base64.b64decode(raw_b64))
        except Exception as e:
            _log(f"MaxTrace: payload error: {e}")
            return b""

_DEX = DexBridge("com.exteraplugins.MaxTrace.Main")

