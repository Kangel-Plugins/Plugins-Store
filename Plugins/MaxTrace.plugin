def _read_and_clear_cb_fails():
    return _read_and_clear_json_list(_cb_verdict_path())

def _b14_java_stack(exc, depth=4):
    _seen = set()
    e = exc
    while e is not None and depth > 0 and id(e) not in _seen:
        _seen.add(id(e))
        _g = getattr(e, "getStackTrace", None)
        if callable(_g):
            try:
                _st = _g()
                if _st: return _st
            except Exception: pass
        for _a in ("java_exception", "_java_exception", "throwable", "javaException"):
            _j = getattr(e, _a, None)
            if _j is not None and callable(getattr(_j, "getStackTrace", None)):
                try:
                    _st = _j.getStackTrace()
                    if _st: return _st
                except Exception: pass
        e = (getattr(e, "__cause__", None) or getattr(e, "__context__", None))
        depth -= 1
    return None

def _b14_record(owner, exc, surface, meth=None):
    if not _BLOCK14_ON: return
    try: _B14_REC_TL.last_exc = id(exc)
    except Exception: pass
    try: exc_cls = type(exc).__name__
    except Exception: exc_cls = "?"
    try: exc_msg = str(exc)
    except Exception: exc_msg = None
    reason = ("%s: %s" % (exc_cls, exc_msg)) if exc_msg else exc_cls
    try: _B14_REC_TL.last_exc_str = reason
    except Exception: pass
    where = ("%s.%s" % (surface, meth)) if meth else surface
    py_mod, py_file, py_line = _b10_pyframe_culprit(exc, owner)
    if py_mod:
        culprit = py_mod; src = "py-frame/" + where; conf = "high"
    elif owner:
        culprit = owner; src = "scope/" + where; conf = "medium"
    else:
        culprit = "unknown"; src = "none"; conf = "low"
    rec = {"had_cb_fail": True, "event_type": "callback_exception", "dropbox_tag": "data_app_crash", "tombstone_norm_version": 1, "culprit": culprit, "src": src, "confidence": conf,
           "surface": surface, "method": meth, "where": where, "scoped_pid": owner,
           "py_module": py_mod, "py_file": py_file, "py_line": py_line, "reason": reason,
           "exc_cls": exc_cls, "exc_msg": exc_msg, "ts": int(time.time() * 1000)}
    try:
        if exc_msg and ("PyObject is closed" in str(exc_msg)):
            rec["cause"] = "stale_java_proxy_in_host_call"
            _sp_cls = None; _sp_m = None; _sp_host = None
            try:
                for _st in (_b14_java_stack(exc) or ()):
                    _scn = str(_st.getClassName()); _smn = str(_st.getMethodName())
                    if _sp_cls is None:
                        if _scn.startswith("$Proxy"):
                            _sp_cls = _scn; _sp_m = _smn
                    elif not (_scn.startswith("java.") or _scn.startswith("javax.") or _scn.startswith("android.") or _scn.startswith("com.chaquo") or _scn.startswith("$Proxy")):
                        _sp_host = _scn.rsplit(".", 1)[-1] + "." + _smn; break
            except Exception:
                pass
            if _sp_cls:
                rec["proxy_class"] = _sp_cls; rec["proxy_method"] = _sp_m
            else:
                rec["proxy_stack_missing"] = True
            if _sp_host:
                rec["host_api"] = _sp_host
            if _sp_m == "equals" and str(_sp_host or "").startswith("NotificationCenter.addObserver"):
                rec["cause"] = "stale_notification_observer_proxy_equals"
            try:
                _spo = _B14_IFACE_OWNER.get(_sp_cls) if _sp_cls else None
                if _spo and abs(int(rec["ts"]) - int(_spo[1])) < _B16_ZOMBIE_WINDOW_MS:
                    rec["stale_proxy_owner"] = _spo[0]
                    if _spo[0] and _spo[0] != culprit:
                        rec["stale_proxy_owner_conflict"] = True
            except Exception:
                pass
    except Exception:
        pass
    _hook_live_mark(rec)
    key = "%s|%s|%s" % (culprit, reason, where); now = rec["ts"]
    try:
        with _CB_SEEN_LOCK:
            if now - _CB_SEEN.get(key, 0) < _CB_DEDUP_MS: return
            _CB_SEEN[key] = now
    except Exception: pass
    try: _b16_push_verdict("cb", rec)
    except Exception: pass
    try: _cb_verdict_log(rec, "live")
    except Exception: pass
    try: _persist_cb_fail(rec)
    except Exception: pass

def _b14_caller_owner(max_up=14):
    try: f = _sys._getframe(2)
    except Exception: return None
    n = 0
    while f is not None and n < max_up:
        try:
            g = f.f_globals; mod = g.get("__name__") or ""
        except Exception: mod = ""
        if mod and mod not in _B14_SDK_MODS and mod != _SELF_ID and mod != __id__:
            try: ow = _b10_owner_from_module(mod)
            except Exception: ow = None
            if ow: return ow
        try: f = f.f_back
        except Exception: f = None
        n += 1
    return None

def _b14_wrap_cb(owner, fn, surface, meth=None):
    if fn is None or not callable(fn) or getattr(fn, _B14_FLAG, False):
        return fn
    def _w(*a, **kw):
        pushed = False
        if owner is not None:
            try: pushed = _scoped_set(owner)
            except Exception: pushed = False
        try:
            return fn(*a, **kw)
        except BaseException as e:
            try: _b19_exc_ring_put(e)
            except Exception: pass
            if owner is not None:
                try: _b14_record(owner, e, surface, meth)
                except Exception: pass
            raise
        finally:
            if pushed:
                try: _scoped_clear()
                except Exception: pass
    try: _functools.update_wrapper(_w, fn)
    except Exception: pass
    try: setattr(_w, _B14_FLAG, True)
    except Exception: pass
    return _w

def _b14_make_func_patch(orig, surface):
    argpos = _B14_CB_ARGPOS.get(surface)
    @_functools.wraps(orig)
    def _patched(*a, **kw):
        owner = None
        try: owner = _b14_caller_owner()
        except Exception: owner = None
        if owner is not None:
            try:
                a = list(a)
                if argpos is _B14_KWARG_ONLY:
                    pass
                elif argpos is not None:
                    if argpos < len(a) and callable(a[argpos]) and not isinstance(a[argpos], type):
                        a[argpos] = _b14_wrap_cb(owner, a[argpos], surface)
                else:
                    for i in range(len(a)):
                        if callable(a[i]) and not isinstance(a[i], type):
                            a[i] = _b14_wrap_cb(owner, a[i], surface)
                            break
                for k in list(kw.keys()):
                    v = kw.get(k)
                    if callable(v) and not isinstance(v, type) and k in ("callback","fn","func","on_complete","on_error","runnable","r","delegate","listener","action","on_click","handler"):
                        kw[k] = _b14_wrap_cb(owner, v, surface, k)
            except Exception: pass
        result = orig(*a, **kw)
        if owner is not None:
            try:
                fn_name = surface.rsplit(".", 1)[-1]
                if fn_name in ("RunnableFactory", "OnCopy", "R",
                               "OnClickListener", "OnLongClickListener"):
                    _ts = int(time.time() * 1000)
                    _B14_IFACE_OWNER[fn_name] = (owner, _ts)
                    try:
                        if result is not None:
                            _rcn = type(result).__name__
                            if _rcn and _rcn != fn_name:
                                _B14_IFACE_OWNER[_rcn] = (owner, _ts)
                                for _rv in (_rcn.lstrip("_"), _rcn.rsplit("$", 1)[-1]):
                                    if _rv and _rv != _rcn:
                                        _B14_IFACE_OWNER[_rv] = (owner, _ts)
                    except Exception: pass
            except Exception: pass
        return result
    try: setattr(_patched, _B14_FLAG, True)
    except Exception: pass
    return _patched

def _b14_import(name):
    if name == "file_utils":
        try:
            import file_utils
            return file_utils
        except Exception:
            return None
    elif name == "intents":
        try:
            import intents
            return intents
        except Exception:
            return None
    return None

def _b14_patch_module(mod, mod_name, names):
    n = 0
    for nm in names:
        try: orig = getattr(mod, nm, None)
        except Exception: orig = None
        if orig is None or not callable(orig) or getattr(orig, _B14_FLAG, False):
            continue
        surface = "%s.%s" % (mod_name, nm)
        try:
            patched = _b14_make_func_patch(orig, surface)
            setattr(mod, nm, patched)
            with _B14_WRAP_LOCK:
                _B14_PATCHED.append((mod, nm, orig, patched))
            n += 1
        except Exception as e:
            _log("Block#14: patch %s err: %s" % (surface, e))
    if n: _log("Block#14: %s obernuto funkcij=%d" % (mod_name, n))
    return n

def _b14_wrap_method(cls, meth_name, surface):
    try: raw = cls.__dict__.get(meth_name)
    except Exception: raw = None
    if raw is None or isinstance(raw, (staticmethod, classmethod, property)):
        return 0
    fn = raw
    if not callable(fn) or getattr(fn, _B14_FLAG, False):
        return 0
    def _make(orig_fn, surf, mname):
        def _w(self, *a, **kw):
            ow = None
            try: ow = _b10_owner_from_module(getattr(type(self), "__module__", None))
            except Exception: ow = None
            pushed = False
            if ow is not None:
                try: pushed = _scoped_set(ow)
                except Exception: pushed = False
            try:
                return orig_fn(self, *a, **kw)
            except BaseException as e:
                if ow is not None:
                    try: _b14_record(ow, e, surf, mname)
                    except Exception: pass
                raise
            finally:
                if pushed:
                    try: _scoped_clear()
                    except Exception: pass
        try: _functools.update_wrapper(_w, orig_fn)
        except Exception: pass
        try: setattr(_w, _B14_FLAG, True)
        except Exception: pass
        return _w
    try:
        _w = _make(fn, surface, meth_name)
        setattr(cls, meth_name, _w)
        with _B14_WRAP_LOCK:
            _prune_dead_wrefs(_B14_WRAPPED_CLASSES)
            _B14_WRAPPED_CLASSES.append((_wref_make(cls), meth_name, _wref_make(fn), _wref_make(_w)))
        return 1
    except Exception:
        return 0

def _b14_register_cb_methods(holder, mod_name):
    import inspect as _inspect
    names = []
    for nm in dir(holder):
        if nm.startswith("_"): continue
        try: fn = getattr(holder, nm, None)
        except Exception: fn = None
        if fn is None or not callable(fn) or isinstance(fn, type): continue
        pos = None; has_cb_kw = False
        try:
            params = list(_inspect.signature(fn).parameters.values())
        except Exception:
            continue
        idx = 0
        for p in params:
            if p.kind in (p.VAR_POSITIONAL, p.VAR_KEYWORD): continue
            if p.name in _B14_CB_PARAM_NAMES:
                has_cb_kw = True
                if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD): pos = idx
                break
            if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD): idx += 1
        if pos is None and not has_cb_kw: continue
        surface = "%s.%s" % (mod_name, nm)
        _B14_CB_ARGPOS[surface] = pos if pos is not None else _B14_KWARG_ONLY
        names.append(nm)
    if names:
        _b14_patch_module(holder, mod_name, names)
        _log("Block#14: %s cb-metodov zaregano=%d (argpos-pinned)" % (mod_name, len(names)))
    return len(names)

def _b14_sweep(reason="sweep"):
    if not _BLOCK14_ON: return 0
    ncd = _B14_NCD; pbase = _B14_PROXY_BASE; ncd_raw = _B14_NCD_RAW
    if ncd is None and pbase is None and ncd_raw is None: return 0
    ncd_n = 0; proxy_n = 0; total = 0; seen = set()
    try: mods = list(_sys.modules.items())
    except Exception: mods = []
    for mname, mod in mods:
        if mod is None: continue
        try: pid = getattr(mod, "__id__", None)
        except Exception: pid = None
        if not (isinstance(pid, str) and pid): continue
        if pid == _SELF_ID or pid == __id__: continue
        names = {mname}
        try:
            nm = getattr(mod, "__name__", None)
            if nm: names.add(nm)
        except Exception: pass
        try: members = list(vars(mod).values())
        except Exception: members = []
        for obj in members:
            if not isinstance(obj, type): continue
            try:
                if getattr(obj, "__module__", None) not in names: continue
            except Exception: continue
            try: k = id(obj)
            except Exception: k = None
            if k in seen: continue
            seen.add(k)
            is_ncd = False
            if ncd is not None:
                try: is_ncd = issubclass(obj, ncd) and obj is not ncd
                except Exception: is_ncd = False
            if (not is_ncd) and (ncd_raw is not None):
                try: is_ncd = issubclass(obj, ncd_raw) and obj is not ncd_raw
                except Exception: is_ncd = False
            has_drn = False
            try: has_drn = callable(obj.__dict__.get("didReceivedNotification"))
            except Exception: has_drn = False
            if has_drn or is_ncd:
                if has_drn:
                    c = _b14_wrap_method(obj, "didReceivedNotification", "notification")
                    if c: ncd_n += c; total += c
            if pbase is not None:
                try: is_proxy = issubclass(obj, pbase) and obj is not pbase
                except Exception: is_proxy = False
                if is_proxy:
                    try: meth_names = [m for m, v in list(obj.__dict__.items())
                                       if (not m.startswith("_")) and callable(v) and m != "didReceivedNotification"
                                       and not isinstance(v, (staticmethod, classmethod, property))
                                       and not getattr(v, _B14_FLAG, False)]
                    except Exception: meth_names = []
                    for m in meth_names:
                        c = _b14_wrap_method(obj, m, "proxy")
                        if c: proxy_n += c; total += c
    if total:
        _log("Block#14 %s: notification-metodov=%d proxy-metodov=%d" % (reason, ncd_n, proxy_n))
    return total

def _rebind_imported_sdk_funcs(tag="boot"):
    try:
        with _B14_WRAP_LOCK:
            patched = list(_B14_PATCHED)
    except Exception:
        patched = []
    if not patched:
        return 0
    pairs = []
    for tup in patched:
        try:
            mod, nm, orig = tup[0], tup[1], tup[2]
            wrapped = getattr(mod, nm, None)
            if wrapped is not None and wrapped is not orig and getattr(wrapped, _B14_FLAG, False):
                pairs.append((nm, orig, wrapped))
        except Exception:
            pass
    if not pairs:
        return 0
    n = 0; mods_touched = 0
    try: mods = list(_sys.modules.items())
    except Exception: mods = []
    for mod_name, mod in mods:
        try:
            pid = _pid_of_module_pkg(mod_name)
        except Exception:
            pid = None
        if not (isinstance(pid, str) and pid and pid != _SELF_ID and pid != __id__):
            continue
        touched = False
        for (nm, orig, wrapped) in pairs:
            try:
                cur = getattr(mod, nm, None)
                if cur is orig:
                    setattr(mod, nm, wrapped); n += 1; touched = True
            except Exception:
                pass
        if touched: mods_touched += 1
    if n:
        _log("Block#14 +BI bound-import rebind (%s): перепривязано имён=%d в плагин-модулях=%d (захваченные 'from client_utils import ...' до патча)" % (tag, n, mods_touched))
    return n

_B14_FILEINFO_CB_ATTRS = ("on_click", "get_icon")
_B14_INTENT_CB_ATTRS = ("callback",)

def _b14_wrap_obj_cbs(owner, obj, attrs, surface):
    if obj is None:
        return
    for attr in attrs:
        try: cb = getattr(obj, attr, None)
        except Exception: cb = None
        if cb is None or not callable(cb) or getattr(cb, _B14_FLAG, False):
            continue
        try: setattr(obj, attr, _b14_wrap_cb(owner, cb, surface, attr))
        except Exception: pass

def _b14_patch_baseplugin_registrars():
    n = 0
    for meth, attrs, surface in (
        ("add_file_hook", _B14_FILEINFO_CB_ATTRS, "base_plugin.add_file_hook"),
        ("add_intent_hook", _B14_INTENT_CB_ATTRS, "base_plugin.add_intent_hook"),
    ):
        orig = getattr(BasePlugin, meth, None)
        if orig is None or getattr(orig, _B14_FLAG, False):
            continue
        def _mk(orig, attrs, surface):
            @_functools.wraps(orig)
            def _patched(self, *a, **kw):
                owner = None
                try: owner = _b10_owner_from_module(getattr(type(self), "__module__", None))
                except Exception: owner = None
                if owner is not None:
                    try:
                        for arg in a:
                            _b14_wrap_obj_cbs(owner, arg, attrs, surface)
                        for v in kw.values():
                            _b14_wrap_obj_cbs(owner, v, attrs, surface)
                    except Exception: pass
                return orig(self, *a, **kw)
            return _patched
        patched = _mk(orig, attrs, surface)
        try: setattr(patched, _B14_FLAG, True)
        except Exception: pass
        try: setattr(patched, "__wrapped__", orig)
        except Exception: pass
        try:
            pass
            with _B14_WRAP_LOCK:
                _B14_WRAPPED_CLASSES.append((_wref_make(BasePlugin), meth, _wref_make(orig), _wref_make(patched)))
            n += 1
        except Exception as e:
            _log("Block#14 +TM registrar patch %s err: %s" % (meth, e))
    return n

def _b14_patch_registrar_classmethods():
    specs = []
    fc = _b14_import("file_utils")
    if fc is not None:
        FC = getattr(fc, "FilesController", None)
        if FC is not None:
            specs.append((FC, "register", _B14_FILEINFO_CB_ATTRS, "file_utils.FilesController.register"))
    it = _b14_import("intents")
    if it is not None:
        IM = getattr(it, "IntentsManager", None)
        if IM is not None:
            specs.append((IM, "new_global_before_handler", _B14_INTENT_CB_ATTRS, "intents.IntentsManager.new_global_before_handler"))
            specs.append((IM, "new_global_after_handler", _B14_INTENT_CB_ATTRS, "intents.IntentsManager.new_global_after_handler"))
    n = 0
    for cls, meth, attrs, surface in specs:
        try: raw = cls.__dict__.get(meth)
        except Exception: raw = None
        if raw is None or getattr(raw, _B14_FLAG, False):
            continue
        is_cm = isinstance(raw, classmethod)
        fn = raw.__func__ if (is_cm or isinstance(raw, staticmethod)) else raw
        if not callable(fn) or getattr(fn, _B14_FLAG, False):
            continue
        def _mk(fn, attrs, surface):
            def _w(bound, *a, **kw):
                owner = None
                try: owner = _b14_caller_owner()
                except Exception: owner = None
                if owner is not None:
                    try:
                        for arg in a:
                            _b14_wrap_obj_cbs(owner, arg, attrs, surface)
                        for v in kw.values():
                            _b14_wrap_obj_cbs(owner, v, attrs, surface)
                    except Exception: pass
                return fn(bound, *a, **kw)
            return _w
        wfn = _mk(fn, attrs, surface)
        try: _functools.update_wrapper(wfn, fn)
        except Exception: pass
        try: setattr(wfn, _B14_FLAG, True)
        except Exception: pass
        new_attr = classmethod(wfn) if is_cm else (staticmethod(wfn) if isinstance(raw, staticmethod) else wfn)
        try:
            setattr(cls, meth, new_attr)
            with _B14_WRAP_LOCK:
                _B14_WRAPPED_CLASSES.append((_wref_make(cls), meth, _wref_make(raw), _wref_make(new_attr)))
            n += 1
        except Exception as e:
            _log("Block#14 +TM registrar classmethod %s err: %s" % (surface, e))
    return n

def _b14_patch_registrars():
    return 0

def _b10_is_passive_target(name):
    try:
        if name.startswith(_B10_PASSIVE_DENY_PREFIXES):
            return False
        return name.startswith(_B10_PASSIVE_POS_PREFIXES)
    except Exception:
        return False

def _b10_passive_load_once():
    global _B10_PASSIVE_LOADED
    if _B10_PASSIVE_LOADED:
        return
    with _B10_PASSIVE_LOCK:
        if _B10_PASSIVE_LOADED:
            return
        _B10_PASSIVE_LOADED = True
        try:
            p = _b10_passive_path()
            rp = _rc_read_path(p) if p else None
            if not rp:
                return
            with open(rp, "r", encoding="utf-8") as f:
                obj = json.load(f)
            hot = obj.get("hot") if isinstance(obj, dict) else {}
            force = obj.get("force") if isinstance(obj, dict) else {}
            now = time.time()
            if isinstance(hot, dict):
                for k, v in hot.items():
                    if not isinstance(v, dict):
                        continue
                    last_hot = float(v.get("last_hot") or 0)
                    if last_hot and now - last_hot <= _B10_PASSIVE_TTL_S:
                        _B10_PASSIVE_HITS[k] = {
                            "owner": v.get("owner"), "method": v.get("method"),
                            "name": v.get("name"), "window_start": now,
                            "count": 0, "rate": float(v.get("rate") or 0.0),
                            "hot_windows": _B10_PASSIVE_HOT_WINDOWS, "hot": True,
                            "last_seen": now, "last_hot": last_hot,
                        }
            if isinstance(force, dict):
                for k, v in force.items():
                    if isinstance(v, dict):
                        _B10_PASSIVE_FORCE[k] = v
        except Exception as _e:
            try: _log("B10 passive load err: %s" % _e)
            except Exception: pass

def _b10_passive_maybe_gc_locked(now):
    try:
        if len(_B10_PASSIVE_HITS) <= _B10_PASSIVE_MAX_KEYS:
            return
        items = list(_B10_PASSIVE_HITS.items())
        def _score(kv):
            k, st = kv
            if k in _B10_PASSIVE_FORCE:
                return 1e18
            if st.get("hot"):
                return 1e15 + float(st.get("last_hot") or 0)
            return float(st.get("last_seen") or 0)
        items.sort(key=_score, reverse=True)
        keep = dict(items[:_B10_PASSIVE_MAX_KEYS])
        _B10_PASSIVE_HITS.clear()
        _B10_PASSIVE_HITS.update(keep)
    except Exception:
        pass

def _b10_passive_flush_if_dirty(force=False):
    global _B10_PASSIVE_DIRTY, _B10_PASSIVE_LAST_PERSIST
    try:
        now = time.time()
        obj = None
        with _B10_PASSIVE_LOCK:
            if not _B10_PASSIVE_DIRTY:
                return
            if not force and now - _B10_PASSIVE_LAST_PERSIST < _B10_PASSIVE_PERSIST_S:
                return
            hot = {}
            for k, st in _B10_PASSIVE_HITS.items():
                if not bool(st.get("hot")):
                    continue
                hot[k] = {
                    "owner": st.get("owner"), "method": st.get("method"),
                    "name": st.get("name"), "rate": st.get("rate"),
                    "last_hot": st.get("last_hot") or now,
                }
            stats = dict(_B10_PASSIVE_STATS)
            stats["persist"] = int(stats.get("persist") or 0) + 1
            obj = {
                "version": 1, "ts": int(now * 1000), "hot": hot,
                "force": dict(_B10_PASSIVE_FORCE), "stats": stats,
            }
            _B10_PASSIVE_DIRTY = False
        if obj is None:
            return
        p = _b10_passive_path()
        if not p:
            return
        ok = _atomic_json_write(p, obj)
        with _B10_PASSIVE_LOCK:
            if ok is False:
                _B10_PASSIVE_DIRTY = True
            else:
                _B10_PASSIVE_STATS["persist"] = int(_B10_PASSIVE_STATS.get("persist") or 0) + 1
                _B10_PASSIVE_LAST_PERSIST = now
    except Exception as _e:
        try: _log("B10 passive flush err: %s" % _e)
        except Exception: pass

def _b10_passive_note_skip_locked(owner, method_key, method_name, now):
    try:
        now_ms = int(now * 1000)
        arr = _B10_PASSIVE_RECENT_SKIPS.get(owner)
        if arr is None:
            arr = []
            _B10_PASSIVE_RECENT_SKIPS[owner] = arr
        arr.append({"method": method_key, "name": method_name, "ts": now_ms})
        if len(arr) > _B10_PASSIVE_RECENT_MAX_PER_OWNER:
            del arr[:-_B10_PASSIVE_RECENT_MAX_PER_OWNER]
    except Exception:
        pass

def _b10_passive_scope_skip(owner, method_name, method_key):
    global _B10_PASSIVE_DIRTY
    try:
        if not _B10_PASSIVE_SCOPE_SKIP:
            return False
        if not owner or not method_name:
            return False
        try: _B10_PASSIVE_STATS["seen"] = int(_B10_PASSIVE_STATS.get("seen") or 0) + 1
        except Exception: pass
        if not _b10_shape_getter(method_name):
            return False
        if not method_key:
            method_key = method_name
        _b10_passive_load_once()
        now = time.time()
        key = _b10_passive_key(owner, method_key)
        with _B10_PASSIVE_LOCK:
            _B10_PASSIVE_STATS["shape_pass"] = int(_B10_PASSIVE_STATS.get("shape_pass") or 0) + 1
            if key in _B10_PASSIVE_FORCE:
                _B10_PASSIVE_STATS["force_scope"] = int(_B10_PASSIVE_STATS.get("force_scope") or 0) + 1
                return False
            st = _B10_PASSIVE_HITS.get(key)
            if st is None:
                st = {
                    "owner": owner, "method": method_key, "name": method_name,
                    "window_start": now, "count": 0, "rate": 0.0,
                    "hot_windows": 0, "hot": False, "last_seen": now, "last_hot": 0.0,
                }
                _B10_PASSIVE_HITS[key] = st
            _was_hot = bool(st.get("hot"))
            elapsed = now - float(st.get("window_start") or now)
            if elapsed >= _B10_PASSIVE_WINDOW_S:
                cnt = int(st.get("count") or 0)
                rate = float(cnt) / max(elapsed, 0.001)
                st["rate"] = rate
                st["count"] = 0
                st["window_start"] = now
                if rate >= _B10_PASSIVE_HOT_RATE:
                    st["hot_windows"] = int(st.get("hot_windows") or 0) + 1
                else:
                    st["hot_windows"] = 0
                if int(st.get("hot_windows") or 0) >= _B10_PASSIVE_HOT_WINDOWS:
                    st["hot"] = True
                    st["last_hot"] = now
            st["count"] = int(st.get("count") or 0) + 1
            st["last_seen"] = now
            hot = bool(st.get("hot"))
            if hot and not _was_hot:
                _B10_PASSIVE_DIRTY = True
            if hot:
                _B10_PASSIVE_STATS["hot_skip"] = int(_B10_PASSIVE_STATS.get("hot_skip") or 0) + 1
                _b10_passive_note_skip_locked(owner, method_key, method_name, now)
            _b10_passive_maybe_gc_locked(now)
            return hot
    except Exception:
        return False

def _b10_passive_mark_force(owner, method_key, method_name=None, why="unknown"):
    global _B10_PASSIVE_DIRTY
    try:
        if not owner or not method_key:
            return
        _b10_passive_load_once()
        now = time.time()
        key = _b10_passive_key(owner, method_key)
        with _B10_PASSIVE_LOCK:
            _B10_PASSIVE_FORCE[key] = {
                "owner": owner, "method": method_key,
                "name": method_name or method_key.rsplit(".", 1)[-1],
                "why": why, "ts": now,
            }
            st = _B10_PASSIVE_HITS.get(key)
            if st is not None:
                st["hot"] = False
                st["hot_windows"] = 0
            _B10_PASSIVE_DIRTY = True
    except Exception:
        pass

def _b10_passive_mark_recent_owner_force(owner, crash_ts, why):
    try:
        if not owner:
            return
        cands = []
        for _o in (owner, _canon_pid(owner)):
            if _o and _o not in cands:
                cands.append(_o)
        now_ms = int(time.time() * 1000)
        try: cts = int(crash_ts) if crash_ts is not None else now_ms
        except Exception: cts = now_ms
        for _ow in cands:
            with _B10_PASSIVE_LOCK:
                arr = list(_B10_PASSIVE_RECENT_SKIPS.get(_ow) or [])
            for it in arr:
                try: ts = int(it.get("ts") or 0)
                except Exception: ts = 0
                if ts and abs(cts - ts) <= _B10_PASSIVE_RECENT_WINDOW_MS:
                    _b10_passive_mark_force(_ow, it.get("method"), it.get("name"), why)
    except Exception:
        pass
_MD_VERDICT_FRESH_MS = 120000
_MD_RT_SO = (
    "libopenjdk.so", "libopenjdkjvm.so", "libart.so", "libandroid_runtime.so",
    "libsigchain.so", "libnativehelper.so",
)

def _b28_reg_hot_hook(pid, method, persist=False):
    try:
        if not pid or not method:
            return False
        try:
            pid = _canon_pid(pid)
        except Exception:
            pass
        if not isinstance(pid, str) or not pid:
            return False
        if pid == _SELF_ID or pid == __id__:
            return False
        if method not in _B28_HOT_METHODS:
            return False
        changed = False
        with _B28_HOOK_REG_LOCK:
            arr = _B28_HOOK_REG.get(pid)
            if arr is None:
                arr = []
                _B28_HOOK_REG[pid] = arr
            if method not in arr:
                arr.append(method)
                changed = True
        if changed:
            try:
                _log("Block#28: hot-hook registered owner=%r method=%s" % (pid, method))
            except Exception:
                pass
            if persist:
                try:
                    _b28_persist_hot_hook(pid, method)
                except Exception:
                    pass
        return True
    except Exception:
        return False
_GLOBALREF_HOOKS_NAME = "globalref_hooks.json"

def _b28_hooks_path():
    return _data_path(_GLOBALREF_HOOKS_NAME)

def _b28_persist_hot_hook(pid, method):
    p = _b28_hooks_path()
    if not p:
        return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = {}
        _rp = _rc_read_path(p)
        if _rp:
            try:
                with open(_rp, "r", encoding="utf-8") as f:
                    cur = dict(json.load(f))
            except Exception:
                cur = {}
        rec = cur.get(pid)
        if not isinstance(rec, dict):
            rec = {"methods": [], "ts": 0}
        methods = list(rec.get("methods") or [])
        if method not in methods:
            methods.append(method)
        rec["methods"] = methods
        rec["ts"] = int(time.time() * 1000)
        cur[pid] = rec
        _atomic_json_write(p, cur)
    except Exception:
        pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_load_persisted_hooks():
    p = _b28_hooks_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return dict(json.load(f))
    except Exception:
        pass
    return {}

def _b28_installed_pids():
    out = set()
    try:
        for e in _b11_plugin_entries():
            try:
                k = _safe_str(e.getKey())
                if k: out.add(k)
            except Exception: pass
    except Exception: pass
    try:
        out |= _installed_plugin_ids_fs()
    except Exception: pass
    return out

def _b28_prune_persisted_hooks():
    try:
        installed = _b28_installed_pids()
        if not installed: return
        cur = _b28_load_persisted_hooks() or {}
        if not cur: return
        pruned = {pid: rec for pid, rec in cur.items() if pid in installed}
        if len(pruned) == len(cur): return
        p = _b28_hooks_path()
        if not p: return
        _PERSIST_IO_LOCK.acquire()
        try:
            _atomic_json_write(p, pruned)
        finally:
            try: _PERSIST_IO_LOCK.release()
            except Exception: pass
        try: _log("Block#28: pruned %d ghost hot-hook owner(s) from globalref_hooks.json" % (len(cur) - len(pruned)))
        except Exception: pass
    except Exception:
        pass

def _b28_combined_hook_owners():
    out = {}
    try:
        with _B28_HOOK_REG_LOCK:
            for pid, methods in _B28_HOOK_REG.items():
                out.setdefault(pid, [])
                for m in (methods or []):
                    if m not in out[pid]:
                        out[pid].append(m)
    except Exception:
        pass
    try:
        for pid, rec in (_b28_load_persisted_hooks() or {}).items():
            ms = rec.get("methods") if isinstance(rec, dict) else rec
            out.setdefault(pid, [])
            for m in (ms or []):
                if m not in out[pid]:
                    out[pid].append(m)
    except Exception:
        pass
    try:
        _inst = _b28_installed_pids()
        if _inst:
            out = {pid: ms for pid, ms in out.items() if pid in _inst}
    except Exception:
        pass
    return out

_B28C_ON = True
_B28C_SAMPLE = 4
_B28C_PERSIST_MS = 3000
_B28C_MIN = 160
_B28C_DOMINANCE = 0.55
_B28C_UNTAG_AMBIENT = 0.90
_B28C_ABS_MIN_SHARE = 0.05
_GLOBALREF_PROXY_NAME = "globalref_proxy.json"
_B28C_COUNTS = {}
_B28C_LOCK = threading.Lock()
_GREF_READ_LOCK = threading.Lock()
_B28C_SEEN = 0
_B28C_LAST = int(time.time() * 1000)

def _b28c_proxy_path():
    return _data_path(_GLOBALREF_PROXY_NAME)

def _b28c_persist(counts, now):
    p = _b28c_proxy_path()
    if not p: return
    try:
        data = {}
        for pid, n in counts.items():
            if not pid or pid == _SELF_ID or pid == __id__: continue
            data[pid] = {"count": int(n), "ts": int(now)}
        _atomic_json_write(p, data)
    except Exception:
        pass

def _b28c_record(owner, weight=1):
    if not owner: return
    now = int(time.time() * 1000)
    due = False; snap = None
    with _B28C_LOCK:
        _B28C_COUNTS[owner] = _B28C_COUNTS.get(owner, 0) + int(weight)
        global _B28C_LAST
        if (now - _B28C_LAST) >= _B28C_PERSIST_MS:
            _B28C_LAST = now; due = True; snap = dict(_B28C_COUNTS)
    if due and snap is not None:
        _b28c_persist(snap, now)

_B28C_NATIVE_THREAD = None
_B28C_NATIVE_STOP = None
_B28C_LAST_GEN = None

def _b28c_native_flush(now=None):
    if not (_GREF_NATIVE_OK and _NLIB is not None): return False
    try:
        if not int(_NLIB.cd_gref_running()): return False
    except Exception:
        return False
    global _B28C_LAST_GEN
    gen = None
    try:
        gen = (int(_NLIB.cd_gref_total()),
               int(_NLIB.cd_gref_arm_generation()))
    except Exception:
        gen = None
    if gen is not None and gen == _B28C_LAST_GEN:
        return False
    try:
        n = int(_NLIB.cd_gref_tags())
    except Exception:
        n = 4096
    if n <= 0 or n > 65536: n = 4096
    try:
        arr = (ctypes.c_int64 * n)()
        m = int(_NLIB.cd_gref_snapshot(arr, ctypes.c_int32(n)))
    except Exception:
        return False
    counts = {}
    for idx in range(m):
        try: cnt = int(arr[idx])
        except Exception: continue
        if cnt <= 0: continue
        name = None
        try: name = _resolve_idx(idx)
        except Exception: name = None
        if not name:
            try: name = _resolve_idx_durable(idx)
            except Exception: name = None
        if not name or name == _SELF_ID or name == __id__: continue
        counts[name] = cnt
    if not counts:
        _B28C_LAST_GEN = gen
        return False
    _b28c_persist(counts, now if now is not None else int(time.time() * 1000))
    _B28C_LAST_GEN = gen
    return True

_B28P_ON = True
_B28P_TABLE_MAX_DEFAULT = 51200
_B28P_WARN_FRAC = 0.85
_B28P_COOLDOWN_MS = 600000
_B28P_LAST_VERDICT_MS = [0]
_B28P_LAST_LOG_MS = [0]

def _b28_gref_pressure_check(now=None):
    if not _B28P_ON: return False
    try:
        if not (globals().get("_GREF_LIVE_OK") and _GREF_NATIVE_OK and _NLIB is not None and ctypes is not None):
            return False
        try:
            if not int(_NLIB.cd_gref_running()): return False
        except Exception:
            return False
        live = 0
        try:
            _NLIB.cd_gref_live_total.restype = ctypes.c_int64
            live = int(_NLIB.cd_gref_live_total())
        except Exception:
            live = 0
        if live <= 0:
            live = int(_gref_live_sum())
        limit = _B28P_TABLE_MAX_DEFAULT
        if live < int(limit * _B28P_WARN_FRAC): return False
        ts = int(now if now is not None else time.time() * 1000)
        if ts - _B28P_LAST_LOG_MS[0] >= 60000:
            _B28P_LAST_LOG_MS[0] = ts
            _log("Block#28P WARN: давление global-ref %d/%d (%.0f%%) -- переполнение и SIGABRT близко" % (live, limit, 100.0 * live / max(1, limit)))
        if ts - _B28P_LAST_VERDICT_MS[0] < _B28P_COOLDOWN_MS: return False
        owner, om = _b28_live_producer()
        if not owner:
            try: owner, om = _b28_proxy_producer()
            except Exception: owner, om = (None, None)
        if not owner:
            try: owner, om = _b28_proxy_top2()
            except Exception: owner, om = (None, None)
        if not owner:
            try:
                _pxc = _ta_proxy_census()
                if _pxc and _pxc.get("culprit") and float(_pxc.get("share") or 0.0) >= 0.6:
                    owner, om = _pxc["culprit"], "py-proxy-census"
                    _log("Block#28P +TD(4): владелец по переписи прокси: %r (%d объектов, доля %.0f%%)" % (owner, int(_pxc.get("count") or 0), 100.0 * float(_pxc.get("share") or 0.0)))
            except Exception:
                pass
        multi = bool(owner and "|" in str(owner))
        conf = "high" if (owner and om == "proxy-producer-live") else ("medium" if owner else "low")
        culprit = owner or globals().get("_UNTAGGED_LABEL", "неизвестный плагин")
        rec = {
            "had_globalref_overflow": False,
            "pre_abort": True,
            "culprit": culprit,
            "culprit_kind": (("plugin-multi:%s" % owner) if multi else ("plugin:%s" % owner)) if owner else "untagged",
            "suspects": (str(owner).split("|") if multi else None),
            "confidence": conf,
            "kind": "jni-globalref-pressure",
            "src": "gref-pressure/pre-abort",
            "sig": "pressure:%s" % (owner or "untagged"),
            "reason": ("таблица JNI global-ref заполнена: %d из %d (порог 85%%) -- переполнение вызовет SIGABRT (ART); пред-смертный вердикт по live-карте владения" % (live, limit)),
            "where": "Chaquopy dynamic_proxy / JNI NewGlobalRef",
            "exc_cls": "JniGlobalRefTablePressure",
            "exc_msg": "global reference table at %d/%d (pre-abort)" % (live, limit),
            "max": None,
            "table_max": limit,
            "live_total": live,
            "dominant_type": None,
            "dominant_count": None,
            "dominant_share": None,
            "is_proxy_object": True,
            "hot_method": None,
            "hook_owner": owner,
            "hook_method": None,
            "hook_match": om,
            "hook_meta": {"n": 0, "status": om or "pressure-unattributed"},
            "ts": ts,
            "event_ts": ts,
            "age_ms": 0,
            "stale_echo": False,
        }
        try:
            _b28_write_verdict(rec)
        except Exception as e:
            _log("Block#28P: ошибка записи пред-смертного вердикта: %s" % e)
            return False
        _B28P_LAST_VERDICT_MS[0] = ts
        _log("Block#28P: пред-смертный вердикт записан: %r conf=%s live=%d/%d src=%s" % (culprit, conf, live, limit, om or "?"))
        return True
    except Exception:
        return False

def _b28c_native_loop(stop_evt):
    while not stop_evt.is_set():
        wrote = False
        try: wrote = bool(_b28c_native_flush())
        except Exception: wrote = False
        if wrote:
            try: _b28_reattribute_untagged()
            except Exception: pass
        try: _b28_gref_pressure_check()
        except Exception: pass
        try: stop_evt.wait(max(0.5, _B28C_PERSIST_MS / 1000.0))
        except Exception: time.sleep(3.0)

def _b28c_start_native_flush():
    global _B28C_NATIVE_THREAD, _B28C_NATIVE_STOP
    if _B28C_NATIVE_THREAD is not None: return False
    if not (_GREF_NATIVE_OK and _NLIB is not None): return False
    try:
        _B28C_NATIVE_STOP = threading.Event()
        t = threading.Thread(target=_b28c_native_loop, args=(_B28C_NATIVE_STOP,), name="CulpritGrefFlush", daemon=True)
        t.start()
        _B28C_NATIVE_THREAD = t
        return True
    except Exception:
        return False

_B28_HOOK_HITS = {}
_B28_HOOK_HITS_LOCK = threading.Lock()
_B28_HITS_LAST = 0
_B28_HITS_PERSIST_MS = 3000
_B28_HITS_NAME = "globalref_hits.json"
def _b28_hits_path():
    return _data_path(_B28_HITS_NAME)
def _b28_persist_hits(snap, now):
    p = _b28_hits_path()
    if not p: return
    try:
        data = {}
        for pid, methods in snap.items():
            if not pid or pid == _SELF_ID or pid == __id__: continue
            data[pid] = {"methods": {k: int(v) for k, v in methods.items()}, "ts": int(now)}
        _atomic_json_write(p, data)
    except Exception:
        pass
def _b28_hit(pid, method):
    if not pid or not method: return
    if pid == _SELF_ID or pid == __id__: return
    now = int(time.time() * 1000)
    due = False; snap = None
    global _B28_HITS_LAST
    with _B28_HOOK_HITS_LOCK:
        d = _B28_HOOK_HITS.get(pid)
        if d is None:
            d = {}; _B28_HOOK_HITS[pid] = d
        d[method] = d.get(method, 0) + 1
        if (now - _B28_HITS_LAST) >= _B28_HITS_PERSIST_MS:
            _B28_HITS_LAST = now; due = True
            snap = {p: dict(m) for p, m in _B28_HOOK_HITS.items()}
    if due and snap is not None:
        try: _b28_persist_hits(snap, now)
        except Exception: pass
def _b28_load_hits():
    p = _b28_hits_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return dict(json.load(f))
    except Exception:
        pass
    return {}
def _b28_hit_winner(method, candidates, ref_ts=None, max_age_ms=None, dominance=0.8):
    if not method: return None
    cset = set(candidates or [])
    mem = {}; disk = {}
    try:
        with _B28_HOOK_HITS_LOCK:
            for pid, m in _B28_HOOK_HITS.items():
                if cset and pid not in cset: continue
                c = int((m or {}).get(method, 0))
                if c > 0: mem[pid] = c
    except Exception:
        pass
    try:
        for pid, rec in (_b28_load_hits() or {}).items():
            if cset and pid not in cset: continue
            if ref_ts is not None and max_age_ms is not None and isinstance(rec, dict):
                try:
                    ts = int(rec.get("ts") or 0)
                    if ts and abs(ts - int(ref_ts)) > int(max_age_ms): continue
                except Exception:
                    pass
            ms = rec.get("methods") if isinstance(rec, dict) else rec
            c = int((ms or {}).get(method, 0))
            if c > 0: disk[pid] = c
    except Exception:
        pass
    tally = {}
    for pid in (set(mem) | set(disk)):
        tally[pid] = max(mem.get(pid, 0), disk.get(pid, 0))
    if not tally: return None
    tot = sum(tally.values()) or 1
    best = max(tally, key=lambda k: tally[k])
    if tally[best] >= dominance * tot:
        return best
    return None

def _b28_proxy_producer(ref_ts=None, max_age_ms=None):
    try:
        p = _b28c_proxy_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp: return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            data = dict(json.load(f))
    except Exception:
        return None, None
    best = None; best_n = 0; total = 0
    for pid, rec in data.items():
        if not pid or pid == _SELF_ID or pid == __id__: continue
        try:
            n = int(rec.get("count") or 0) if isinstance(rec, dict) else int(rec or 0)
            ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
        except Exception:
            continue
        if ref_ts is not None and max_age_ms is not None and ts:
            if abs(ts - int(ref_ts)) > max_age_ms: continue
        total += n
        if n > best_n: best_n = n; best = pid
    if best and best_n >= _B28C_MIN and total > 0 and best_n >= total * _B28C_DOMINANCE:
        return best, "proxy-producer"
    return None, None

_B28P_TOP2_SHARE = 0.60

def _b28_live_producer():
    try:
        if not (globals().get("_GREF_LIVE_OK") and _GREF_NATIVE_OK and _NLIB is not None and ctypes is not None):
            return None, None
        try:
            if not int(_NLIB.cd_gref_running()): return None, None
        except Exception:
            return None, None
        try: overflow = int(_NLIB.cd_gref_overflow())
        except Exception: overflow = 0
        try: del_untracked = int(_NLIB.cd_gref_del_untracked())
        except Exception: del_untracked = 0
        try: creation_total = int(_NLIB.cd_gref_total())
        except Exception: creation_total = 0
        if overflow > 0 or (del_untracked >= _GREF_LIVE_DEGRADE_MIN and float(del_untracked) >= _GREF_LIVE_DEGRADE_FRAC * float(max(1, creation_total))):
            return None, None
        try: n = int(_NLIB.cd_gref_tags())
        except Exception: n = 0
        if n <= 0: return None, None
        arr = (ctypes.c_int64 * n)()
        mcount = int(_NLIB.cd_gref_live_snapshot(arr, ctypes.c_int32(n)))
        rows = []; total = 0
        i = 0
        while i < mcount and i < n:
            v = int(arr[i])
            if v > 0:
                nm = None
                try: nm = _resolve_idx(i)
                except Exception: nm = None
                if not nm:
                    try: nm = _resolve_idx_durable(i)
                    except Exception: nm = None
                if nm and nm != _SELF_ID and nm != __id__:
                    total += v
                    rows.append((v, nm))
            i += 1
        if total <= 0 or not rows: return None, None
        rows.sort(reverse=True)
        n1, p1 = rows[0]
        if n1 >= _B28C_MIN and float(n1) >= float(total) * _B28C_DOMINANCE:
            return p1, "proxy-producer-live"
        if len(rows) >= 2:
            n2, p2 = rows[1]
            if n1 >= _B28C_MIN and n2 >= _B28C_MIN and float(n1 + n2) >= float(total) * _B28P_TOP2_SHARE:
                return "%s|%s" % (p1, p2), "proxy-producer-live-top2"
    except Exception:
        pass
    return None, None

def _b28_proxy_top2(ref_ts=None, max_age_ms=None):
    try:
        p = _b28c_proxy_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp: return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            data = dict(json.load(f))
    except Exception:
        return None, None
    rows = []; total = 0
    for pid, rec in data.items():
        if not pid or pid == _SELF_ID or pid == __id__: continue
        try:
            n = int(rec.get("count") or 0) if isinstance(rec, dict) else int(rec or 0)
            ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
        except Exception:
            continue
        if ref_ts is not None and max_age_ms is not None and ts:
            if abs(ts - int(ref_ts)) > max_age_ms: continue
        total += n
        if n > 0: rows.append((n, pid))
    if total <= 0 or len(rows) < 2: return None, None
    rows.sort(reverse=True)
    n1, p1 = rows[0]; n2, p2 = rows[1]
    if n1 < _B28C_MIN or n2 < _B28C_MIN: return None, None
    if float(n1) >= float(total) * _B28C_DOMINANCE: return None, None
    if float(n1 + n2) >= float(total) * _B28P_TOP2_SHARE:
        return "%s|%s" % (p1, p2), "proxy-producer-top2"
    return None, None

class _ProxyCreateHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            if not _B28C_ON: return
            try:
                if param.getThrowable() is not None: return
            except Exception: pass
            global _B28C_SEEN
            _B28C_SEEN += 1
            if (_B28C_SEEN % _B28C_SAMPLE) != 0: return
            owner = None
            try: owner = _direct_pid_now()
            except Exception: owner = None
            if not owner:
                try: owner = _b27_owner_now()
                except Exception: owner = None
            if not owner or owner == _SELF_ID: return
            _b28c_record(owner, _B28C_SAMPLE)
        except Exception: pass

_B28_BRIDGE_TOKENS = (
    "LSPHooker_", "PyMethodHook", "HookCallbackDispatcher", "XposedBridge",
    "Proxy_Object", "chaquopy", "PyObject", "Reflector", "HookInfo",
    "afterHookedMethod", "beforeHookedMethod",
)

_B28_JNISIG_RE = re.compile(r"^L([\w/$]+);$")
_B28_SUMMARY_RE = re.compile(r"^\s*(\d+)\s+of\s+(\S+)")
_B28_MAX_RE = re.compile(r"max\s*=\s*(\d+)")
_B28_FRAME_RE = re.compile(r"([\w$.]+)\.([\w$<>]+)\s*[\(:]")
_B28_ENTRY_RE = re.compile(r"^\d+:")
_B28_PREFIX_RE = re.compile(r"^\s*\d\d-\d\d \d\d:\d\d:\d\d\.\d+\s+\d+\s+\d+\s+\w\s+[^:]*:\s?(.*)$")
_B28_DEBUG_RE = re.compile(r"\bDEBUG\b[^:]*:\s?")

def _globalref_path():
    return _data_path(_GLOBALREF_FILE_NAME)

def _b28_seen_path():
    return _data_path(_GLOBALREF_SEEN_NAME)

def _b28_load_seen():
    p = _b28_seen_path()
    try:
        _rp = _rc_read_path(p) if p else None
        if _rp:
            with open(_rp, "r", encoding="utf-8") as f:
                return list(json.load(f))
    except Exception:
        pass
    return []

def _b28_save_seen(sigs):
    p = _b28_seen_path()
    if not p: return
    try:
        _atomic_json_write(p, list(sigs)[-_GLOBALREF_SEEN_MAX:], _GLOBALREF_SEEN_MAX)
    except Exception:
        pass

def _b28_strip_prefix(line):
    try:
        m = _B28_DEBUG_RE.search(line)
        if m: return line[m.end():]
        m2 = _B28_PREFIX_RE.match(line)
        if m2: return m2.group(1)
    except Exception:
        pass
    return line

_B28_LOGCAT_TAIL = 8000

_B28_READ_FILTER_ON = True
_B28_MIN_LEVEL = "V"
_B28_KEEP_RE_ERE = "global reference|FATAL EXCEPTION|abort message|signal [0-9]|tombstone|>>> |DEBUG|art::|JNI (DETECTED|ERROR)|ReferenceTable|ANR in"


_B28_LEVELS = ("V", "D", "I", "W", "E")
_B28_NLIB_WARN = False

def _b28_apply_settings(plugin):
    global _B28_READ_FILTER_ON, _B28_MIN_LEVEL, _B28_KEEP_RE_ERE
    try:
        _B28_READ_FILTER_ON = bool(plugin.get_setting("b28_filter_on", True))
    except Exception:
        pass
    try:
        _i = int(plugin.get_setting("b28_min_level", 0) or 0)
        if 0 <= _i < len(_B28_LEVELS):
            _B28_MIN_LEVEL = _B28_LEVELS[_i]
    except Exception:
        pass
    try:
        _rx = plugin.get_setting("b28_keep_re", None)
        if _rx is not None:
            _B28_KEEP_RE_ERE = str(_rx)
    except Exception:
        pass

def _b28_read_logcat(prefilter=True, deadline=None, read_state=None):
    out = []
    global _B28_NLIB_WARN
    bounded = deadline is not None
    notes = []
    if isinstance(read_state, dict):
        notes = read_state.setdefault("notes", [])
    try:
        _ok = (_NLIB is not None and hasattr(_NLIB, "cd_logcat_read_filtered"))
        _timed = (_NLIB is not None and hasattr(_NLIB, "cd_logcat_read_filtered_timed"))
    except Exception:
        _ok = _timed = False
    if bounded and not _timed:
        notes.append("bounded native reader unavailable; verdict/breadcrumb fallback")
        return out
    if not _ok:
        if not _B28_NLIB_WARN:
            _B28_NLIB_WARN = True
            try: _log("Block#28: native logcat unavailable")
            except Exception: pass
        return out
    lvl = (_B28_MIN_LEVEL if (prefilter and _B28_READ_FILTER_ON) else "V")
    rx = (_B28_KEEP_RE_ERE if (prefilter and _B28_READ_FILTER_ON) else "")
    cap = 256 * 1024 if bounded else 3 * 1024 * 1024
    try:
        bufp = ctypes.create_string_buffer(cap)
    except Exception as e:
        notes.append("logcat buffer allocation failed")
        try: _log("Block#28: logcat out-buf alloc err: %s" % e)
        except Exception: pass
        return out
    for buf in ("crash", "main"):
        try:
            if bounded:
                left = int((deadline - time.monotonic()) * 1000)
                if left < 1:
                    notes.append("%s: shared deadline exhausted" % buf)
                    break
                flags = ctypes.c_int32(0)
                n = int(_NLIB.cd_logcat_read_filtered_timed(
                    buf.encode("ascii"), lvl.encode("ascii"), rx.encode("utf-8"),
                    ctypes.c_int32(min(int(_B28_LOGCAT_TAIL), 512)), bufp, ctypes.c_int32(cap),
                    ctypes.c_int32(min(left, 10000)), ctypes.byref(flags)))
                if flags.value & 1: notes.append("%s: timeout, available data retained" % buf)
                if flags.value & 2: notes.append("%s: bounded tail" % buf)
                if flags.value & 4: notes.append("%s: native read/launch error" % buf)
            else:
                n = int(_NLIB.cd_logcat_read_filtered(
                    buf.encode("ascii"), lvl.encode("ascii"), rx.encode("utf-8"),
                    ctypes.c_int32(int(_B28_LOGCAT_TAIL)), bufp, ctypes.c_int32(cap)))
            if n > 0:
                out.append(bufp.raw[:n].decode("utf-8", "replace"))
            elif n < 0:
                notes.append("%s: rc=%d" % (buf, n))
                try: _log("Block#28: native logcat(%s) rc=%d" % (buf, n))
                except Exception: pass
        except Exception as e:
            notes.append("%s: read failed" % buf)
            try: _log("Block#28: native logcat(%s) err: %s" % (buf, e))
            except Exception: pass
    if not out:
        try: _log("Block#28: logcat empty (crash+main)")
        except Exception: pass
    return out

def _b28_read_drop_files():
    texts = []
    try:
        import glob as _glob
        gref_dump = os.path.join(_DIR, _GLOBALREF_DUMP_NAME)
        cands = [gref_dump]
        try:
            cands += _glob.glob(os.path.join(_DIR, "crash*.txt"))
            cands += _glob.glob(os.path.join(_DIR, "tombstone*"))
        except Exception:
            pass
        seen_p = set()
        for p in cands:
            if p in seen_p: continue
            seen_p.add(p)
            try:
                if not os.path.exists(p):
                    continue
                if os.path.getsize(p) > 15 * 1024 * 1024:
                    continue
                if p == gref_dump:
                    _rp = p + ".processing"
                    try:
                        os.rename(p, _rp)
                    except Exception:
                        continue
                    _hit = False
                    try:
                        with open(_rp, "r", encoding="utf-8", errors="replace") as f:
                            raw = f.read()
                        if _B28_OVERFLOW_MARK in raw:
                            texts.append(raw); _hit = True
                    except Exception:
                        pass
                    try:
                        if _hit: os.remove(_rp)
                        elif not os.path.exists(p): os.rename(_rp, p)
                        else: os.remove(_rp)
                    except Exception:
                        pass
                else:
                    with open(p, "r", encoding="utf-8", errors="replace") as f:
                        raw = f.read()
                    if _B28_OVERFLOW_MARK in raw:
                        texts.append(raw)
            except Exception:
                pass
    except Exception:
        pass
    return texts

def _b28_logcat_event_ts(line, ref_ts=None):
    try:
        m = _B28_TS_RE.match(line or "")
        if not m: return None
        mo, da, hh, mm, ss = (int(m.group(i)) for i in range(1, 6))
        frac = int((m.group(6) + "000")[:3])
        if ref_ts is not None:
            try:
                ref = int(ref_ts) / 1000.0
                base_yr = time.localtime(ref).tm_year
                best = None
                for _y in (base_yr - 1, base_yr, base_yr + 1):
                    try: _ep = time.mktime(time.struct_time((_y, mo, da, hh, mm, ss, 0, 0, -1)))
                    except Exception: continue
                    if best is None or abs(_ep - ref) < abs(best - ref):
                        best = _ep
                if best is not None:
                    return int(best * 1000 + frac)
            except Exception:
                pass
        yr = time.localtime().tm_year
        epoch = time.mktime(time.struct_time((yr, mo, da, hh, mm, ss, 0, 0, -1)))
        if epoch - time.time() > 2 * 86400:
            epoch = time.mktime(time.struct_time((yr - 1, mo, da, hh, mm, ss, 0, 0, -1)))
        return int(epoch * 1000 + frac)
    except Exception:
        return None

def _b28_extract_overflow_block(text):
    if not text or _B28_OVERFLOW_MARK not in text:
        return None, None
    lines = text.splitlines()
    idx = None
    for i in range(len(lines) - 1, -1, -1):
        if _B28_OVERFLOW_MARK in lines[i]:
            idx = i; break
    if idx is None: return None, None
    ev_ts = _b28_logcat_event_ts(lines[idx])
    start = max(0, idx - 2)
    end = min(len(lines), idx + 400)
    return "\n".join(lines[start:end]), ev_ts

def _b28_norm_type(t):
    if not t: return t
    t = t.strip().rstrip(",")
    m = _B28_JNISIG_RE.match(t)
    if m:
        return m.group(1).replace("/", ".")
    return t

def _b28_parse_dump(block):
    res = {"max": None, "types": {}, "alloc_frames": [], "entry_types": {}}
    m = _B28_MAX_RE.search(block)
    if m:
        try: res["max"] = int(m.group(1))
        except Exception: pass
    in_alloc = False
    for raw in block.splitlines():
        s = _b28_strip_prefix(raw).strip()
        if not s:
            in_alloc = False
            continue
        if "Allocated at" in s:
            in_alloc = True
            continue
        ms = _B28_SUMMARY_RE.match(s)
        if ms:
            in_alloc = False
            try:
                cnt = int(ms.group(1)); typ = _b28_norm_type(ms.group(2))
                if typ and ("." in typ):
                    res["types"][typ] = res["types"].get(typ, 0) + cnt
            except Exception:
                pass
            continue
        if _B28_ENTRY_RE.match(s):
            in_alloc = False
            toks = s.split()
            tail = toks[-1] if toks else ""
            typ = _b28_norm_type(tail)
            if typ and ("." in typ):
                res["entry_types"][typ] = res["entry_types"].get(typ, 0) + 1
            continue
        if in_alloc:
            fm = _B28_FRAME_RE.search(s)
            if fm:
                res["alloc_frames"].append("%s.%s" % (fm.group(1), fm.group(2)))
    if res["max"] is None and not res["types"] and not res["alloc_frames"]:
        try: _log("Block#28: parse_dump не распознал дамп (max/types/frames пусты) -- формат изменился?")
        except Exception: pass
    return res

def _b28_dominant_type(parsed):
    types = dict(parsed.get("types") or {})
    if not types:
        types = dict(parsed.get("entry_types") or {})
    if not types:
        return None, 0, 0.0
    total = sum(types.values()) or 1
    dom = max(types.items(), key=lambda kv: kv[1])
    return dom[0], dom[1], float(dom[1]) / float(total)

def _b28_hot_method(parsed):
    frames = parsed.get("alloc_frames") or []
    counts = {}
    for fr in frames:
        mth = fr.rsplit(".", 1)[-1]
        for hm in _B28_HOT_METHODS:
            if mth == hm:
                counts[hm] = counts.get(hm, 0) + 1
    if counts:
        return max(counts.items(), key=lambda kv: kv[1])[0], frames
    for fr in frames:
        if any(tok in fr for tok in _B28_BRIDGE_TOKENS):
            continue
        return fr.rsplit(".", 1)[-1], frames
    return None, frames

def _b28_attribute(parsed, hot_method, event_ts=None):
    owner = None; hook_method = None; hook_match = None; meta = {}
    try:
        frames = list(parsed.get("alloc_frames") or [])
        if hot_method:
            frames = ["LSPHooker_.%s" % hot_method] + frames
        owner, hook_method, hook_match, meta = _hook_owner_for_frames(frames)
    except Exception as e:
        try: _log("Block#28 attribute err: %s" % e)
        except Exception: pass
    if owner is None and hot_method:
        try:
            _rt_cands = []
            for pid, methods in _b28_combined_hook_owners().items():
                if not pid or pid == _SELF_ID or pid == __id__:
                    continue
                if hot_method in methods and pid not in _rt_cands:
                    _rt_cands.append(pid)
            if len(_rt_cands) == 1:
                owner = _rt_cands[0]
                hook_method = hot_method
                hook_match = "reg_time"
                meta = {"n": 0, "status": "reg-time"}
                _log("Block#28 attribution via reg-time: %r -> %s" % (owner, hot_method))
            elif len(_rt_cands) > 1:
                _hw = _b28_hit_winner(hot_method, _rt_cands)
                if _hw:
                    owner = _hw
                    hook_method = hot_method
                    hook_match = "reg-time-hits"
                    meta = {"n": 0, "status": "reg-time-hits", "candidates": _rt_cands}
                    _log("Block#28 attribution via live hot-hook hits: %r -> %s (broke reg-time-multi of %d)" % (owner, hot_method, len(_rt_cands)))
                else:
                    hook_match = "reg-time-multi"
                    meta = {"n": 0, "status": "reg-time-multi", "candidates": _rt_cands}
                    _log("Block#28 reg-time ambiguous (%d owners hooked %s): %r" % (len(_rt_cands), hot_method, _rt_cands))
        except Exception:
            pass
    if owner is None:
        try:
            persisted = _b28_load_persisted_hooks()
            _inst = _b28_installed_pids()
            cand = []
            for pid, rec in (persisted or {}).items():
                if not pid or pid == _SELF_ID or pid == __id__:
                    continue
                if _inst and pid not in _inst:
                    continue
                ms = rec.get("methods") if isinstance(rec, dict) else rec
                ms = [m for m in (ms or []) if m in _B28_HOT_METHODS]
                if ms:
                    ts = int(rec.get("ts") or 0) if isinstance(rec, dict) else 0
                    cand.append((pid, ms, ts))
            if cand:
                cand.sort(key=lambda c: c[2], reverse=True)
                owner = cand[0][0]
                hook_method = hot_method if (hot_method in cand[0][1]) else cand[0][1][0]
                if len(cand) == 1:
                    hook_match = "reg-persist"
                    meta = {"n": 0, "status": "reg-persist"}
                else:
                    hook_match = "reg-persist-multi"
                    meta = {"n": 0, "status": "reg-persist-multi", "candidates": [c[0] for c in cand]}
                _log("Block#28 attribution via persisted reg (%s): %r -> %s" % (hook_match, owner, hook_method))
        except Exception:
            pass
    if owner is None:
        try:
            lp, _lm = _b28_live_producer()
            if lp:
                owner = lp; hook_method = None; hook_match = _lm
                meta = {"n": 0, "status": _lm}
                if "|" in str(lp): meta["candidates"] = str(lp).split("|")
                _log("Block#28 attribution via live ownership map: %r (%s)" % (owner, _lm))
        except Exception:
            pass
    if owner is None:
        try:
            pp, _pb = _b28_proxy_producer()
            if pp:
                owner = pp; hook_method = None; hook_match = "proxy-producer"
                meta = {"n": 0, "status": "proxy-producer"}
                _log("Block#28 attribution via proxy-producer: %r" % owner)
        except Exception:
            pass
    if owner is None:
        try:
            tp, _tm = _b28_proxy_top2()
            if tp:
                owner = tp; hook_method = None; hook_match = _tm
                meta = {"n": 0, "status": _tm, "candidates": str(tp).split("|")}
                _log("Block#28 attribution via top-2 producers: %r" % tp)
        except Exception:
            pass
    if owner is None:
        try:
            c_owner, c_basis = _b28_correlate_owner(ref_ts=event_ts or int(time.time() * 1000), max_age_ms=1800000)
            if c_owner:
                owner = c_owner
                hook_method = None
                hook_match = "correlate-%s" % c_basis
                meta = {"n": 0, "status": hook_match, "basis": c_basis}
                _log("Block#28 attribution via correlation (%s): %r" % (hook_match, owner))
        except Exception:
            pass
    return owner, hook_method, hook_match, meta

def _b28_correlate_owner(ref_ts=None, max_age_ms=None):
    try:
        p = _leak_verdict_path()
        _rp = _rc_read_path(p) if p else None
        if not _rp:
            return None, None
        with open(_rp, "r", encoding="utf-8") as f:
            recs = list(json.load(f))
        owners = []
        views_by_owner = {}
        for r in recs:
            if not isinstance(r, dict):
                continue
            c = r.get("culprit"); conf = r.get("confidence")
            if not (c and c != _UNTAGGED_LABEL and c != _SELF_ID and c != __id__
                    and conf in ("high", "medium")):
                continue
            if ref_ts is not None and max_age_ms is not None:
                try:
                    lt = int(r.get("ts") or 0)
                    if lt and abs(lt - int(ref_ts)) > max_age_ms:
                        continue
                except Exception:
                    pass
            if c not in owners:
                owners.append(c)
            try:
                _v = int(r.get("leaked_views") or 0)
            except Exception:
                _v = 0
            if _v <= 0: _v = 1
            views_by_owner[c] = views_by_owner.get(c, 0) + _v
        if len(owners) == 1:
            return owners[0], "view-leak"
        if len(owners) > 1:
            try:
                _tot = sum(views_by_owner.values())
                if _tot > 0:
                    _dom = max(views_by_owner, key=lambda k: views_by_owner[k])
                    if views_by_owner[_dom] >= 0.8 * _tot:
                        return _dom, "view-leak-dominant"
            except Exception:
                pass
    except Exception:
        pass
    return None, None

def _b28_reattribute_untagged():
    _PERSIST_IO_LOCK.acquire()
    try:
        try:
            p = _globalref_path()
            _rp = _rc_read_path(p) if p else None
            if not _rp:
                return
            with open(_rp, "r", encoding="utf-8") as f:
                recs = list(json.load(f))
        except Exception:
            return
        changed = False
        for rec in recs:
            try:
                if not isinstance(rec, dict):
                    continue
                if rec.get("kind") != "jni-globalref-leak":
                    continue
                if rec.get("culprit_kind") != "untagged":
                    continue
                owner = None; basis = None
                try:
                    rec_hm = rec.get("hot_method")
                    cand = []
                    for pid, rr in (_b28_load_persisted_hooks() or {}).items():
                        if not pid or pid == _SELF_ID or pid == __id__:
                            continue
                        ms = rr.get("methods") if isinstance(rr, dict) else rr
                        ms = [m for m in (ms or []) if m in _B28_HOT_METHODS]
                        if rec_hm:
                            if rec_hm in ms:
                                ts = int(rr.get("ts") or 0) if isinstance(rr, dict) else 0
                                cand.append((pid, [rec_hm], ts))
                        elif ms:
                            ts = int(rr.get("ts") or 0) if isinstance(rr, dict) else 0
                            cand.append((pid, ms, ts))
                    if cand:
                        if rec_hm and len(cand) > 1:
                            _hw = _b28_hit_winner(rec_hm, [c[0] for c in cand], ref_ts=rec.get("ts"), max_age_ms=1800000)
                            if _hw:
                                owner = _hw
                                basis = "reg-hits"
                                rec["hook_method"] = rec_hm
                        elif rec_hm or len(cand) == 1:
                            cand.sort(key=lambda c: c[2], reverse=True)
                            owner = cand[0][0]
                            basis = "reg-persist" if rec_hm else "reg-persist-uniq"
                            rec["hook_method"] = cand[0][1][0]
                except Exception:
                    pass
                if owner is None:
                    pp, _pb = _b28_proxy_producer(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if pp:
                        owner = pp; basis = "proxy-producer"
                if owner is None:
                    c_owner, c_basis = _b28_correlate_owner(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if c_owner:
                        owner = c_owner; basis = "correlate-%s" % c_basis
                if owner is None:
                    tp, _tb = _b28_proxy_top2(ref_ts=rec.get("ts"), max_age_ms=1800000)
                    if tp:
                        owner = tp; basis = _tb
                if not owner:
                    continue
                _multi = "|" in str(owner)
                rec["culprit"] = owner
                rec["culprit_kind"] = ("plugin-multi:%s" % owner) if _multi else ("plugin:%s" % owner)
                rec["suspects"] = str(owner).split("|") if _multi else None
                rec["hook_owner"] = owner
                rec["hook_match"] = basis
                if rec.get("confidence") == "low":
                    rec["confidence"] = "medium"
                if basis == "proxy-producer":
                    rec["confidence"] = "high"
                    rec["reason"] = ("плагин создаёт/удерживает множество JNI global-ref без освобождения (мост Chaquopy Java<->Python: dynamic_proxy и/или Class/PyObject-ссылки) -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [виновник определён прямым нативным трекером создания JNI global-ref (NewGlobalRef)]" % rec.get("max"))
                    rec["where"] = "мост Chaquopy (JNI NewGlobalRef)"
                elif basis == "proxy-producer-top2":
                    rec["reason"] = ("плагин создаёт множество Chaquopy dynamic_proxy объектов (Java<->Python колбэки), каждый удерживает JNI global-ref без освобождения -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [ни один продюсер не доминирует; названы два главных подозреваемых, вместе покрывающих большинство созданий]" % rec.get("max"))
                    rec["where"] = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
                elif str(basis).startswith("correlate"):
                    rec["reason"] = ("плагин создаёт множество Chaquopy dynamic_proxy объектов (Java<->Python колбэки), каждый удерживает JNI global-ref без освобождения -> таблица global-ссылок переполнилась (max=%s), ART аварийно завершил процесс [виновник по корреляции с одновременной утечкой того же плагина в этом краше]" % rec.get("max"))
                    rec["where"] = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
                changed = True
                try: _log("Block#28 reattribute untagged -> %r (%s)" % (owner, basis))
                except Exception: pass
            except Exception:
                pass
        if changed:
            try: _atomic_json_write(p, recs, _GLOBALREF_FAILS_MAX)
            except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_signature(parsed, dom_type):
    af = (parsed.get("alloc_frames") or [])
    first = af[0] if af else ""
    return "ovf|max=%s|%s|%s" % (parsed.get("max"), dom_type, first)

def _b28_build_verdict(block, event_ts=None):
    parsed = _b28_parse_dump(block)
    dom_type, dom_count, dom_share = _b28_dominant_type(parsed)
    hot_method, _ = _b28_hot_method(parsed)
    is_proxy = bool(dom_type and ("Proxy_Object" in dom_type or "plugins.Proxy" in dom_type))
    owner, hook_method, hook_match, meta = _b28_attribute(parsed, hot_method, event_ts)
    method_for_msg = hook_method or hot_method or "?"
    produced = bool(hook_match == "proxy-producer")
    multi = bool(owner and "|" in str(owner))
    if owner and not multi and (dom_share >= 0.8 or produced or hook_match == "proxy-producer-live"):
        conf = "high"
    elif owner:
        conf = "medium"
    elif dom_share >= 0.8:
        conf = "medium"
    else:
        conf = "low"
    if owner:
        culprit = owner
        culprit_kind = ("plugin-multi:%s" % owner) if multi else ("plugin:%s" % owner)
    elif hot_method:
        culprit = "хук на %s" % hot_method
        culprit_kind = "untagged"
    else:
        culprit = globals().get("_UNTAGGED_LABEL", "неизвестный плагин")
        culprit_kind = "untagged"
    share_pct = int(round(dom_share * 100))
    correlated = bool(hook_match and str(hook_match).startswith("correlate"))
    proxy_leak = bool(correlated or produced or is_proxy or (owner and not hook_method))
    if proxy_leak:
        reason = ("плагин создаёт множество Chaquopy dynamic_proxy объектов "
                  "(Java<->Python колбэки), каждый удерживает JNI global-ref без "
                  "освобождения -> таблица global-ссылок переполнилась (max=%s), "
                  "ART аварийно завершил процесс" % parsed.get("max"))
        where = "Chaquopy dynamic_proxy (Java<->Python колбэки)"
    elif hook_method or hot_method:
        reason = ("плагин хукнул горячий метод рендера %s и на каждый вызов "
                  "оставляет JNI global-ref (Chaquopy Proxy_Object) без DeleteGlobalRef "
                  "-> таблица global-ссылок переполнилась (max=%s), ART аварийно "
                  "завершил процесс" % (method_for_msg, parsed.get("max")))
        where = "%s (хук плагина, мост Chaquopy)" % method_for_msg
    else:
        reason = ("плагин удерживает JNI global-ref (Chaquopy Proxy_Object/Class) без "
                  "освобождения -> таблица global-ссылок переполнилась (max=%s), ART "
                  "аварийно завершил процесс" % parsed.get("max"))
        where = "мост Chaquopy (JNI NewGlobalRef)"
    if dom_type:
        reason += " — %d%% таблицы заняты %s" % (share_pct, dom_type.rsplit(".", 1)[-1])
    if correlated:
        reason += (" [виновник определён по корреляции с одновременной "
                   "утечкой того же плагина в этом краше]")
    elif produced:
        reason += " [виновник определён прямым трекером создания dynamic_proxy]"
    elif hook_match == "proxy-producer-live":
        reason += " [виновник определён по live-карте владения global-ref: текущие удержания, не кумулятив]"
    elif hook_match in ("proxy-producer-top2", "proxy-producer-live-top2"):
        reason += " [ни один продюсер не доминирует; названы два главных подозреваемых, вместе покрывающих большинство созданий]"
    rec = {
        "had_globalref_overflow": True,
        "culprit": culprit,
        "culprit_kind": culprit_kind,
        "confidence": conf,
        "kind": "jni-globalref-leak",
        "src": "globalref-dump",
        "reason": reason,
        "where": where,
        "exc_cls": "JniGlobalRefTableOverflow",
        "exc_msg": "global reference table overflow (max=%s)" % parsed.get("max"),
        "max": parsed.get("max"),
        "dominant_type": dom_type,
        "dominant_count": dom_count,
        "dominant_share": round(dom_share, 4),
        "is_proxy_object": is_proxy,
        "hot_method": hot_method,
        "hook_owner": owner,
        "hook_method": hook_method,
        "hook_match": hook_match,
        "hook_meta": meta,
        "suspects": (str(owner).split("|") if multi else None),
        "ts": int(time.time() * 1000),
        "event_ts": event_ts,
    }
    try:
        _ps = globals().get("_PROC_START_MS") or 0
        if event_ts and _ps:
            rec["age_ms"] = max(0, int(_ps) - int(event_ts))
            rec["stale_echo"] = bool((int(_ps) - int(event_ts)) > _B28_STALE_ECHO_MS)
        else:
            rec["age_ms"] = None; rec["stale_echo"] = False
    except Exception:
        rec["age_ms"] = None; rec["stale_echo"] = False
    return rec, parsed

def _b28_write_verdict(rec):
    _PERSIST_IO_LOCK.acquire()
    try:
        p = _globalref_path()
        if not p: return
        try:
            cur = []
            _rp = _rc_read_path(p)
            if _rp:
                try:
                    with open(_rp, "r", encoding="utf-8") as f: cur = list(json.load(f))
                except Exception: cur = []
            try:
                _sig = rec.get("sig"); _mx = rec.get("max"); _tagged = bool(rec.get("hook_owner"))
                def _keep(c):
                    if _sig and c.get("sig") == _sig: return False
                    if _tagged and c.get("kind") == rec.get("kind") and c.get("culprit_kind") == "untagged" and c.get("max") == _mx: return False
                    return True
                cur = [c for c in cur if _keep(c)]
            except Exception: pass
            cur.append(rec)
            _atomic_json_write(p, cur, _GLOBALREF_FAILS_MAX)
        except Exception:
            pass
        try:
            _log("============ JNI GLOBALREF-OVERFLOW VERDICT (Block#28) ============")
            _log("ВИНОВНИК УТЕЧКИ JNI-ССЫЛОК: %r conf=%s метод=%s тип=%s (%d%%)" % (
                rec.get("culprit"), rec.get("confidence"), rec.get("hot_method"),
                (rec.get("dominant_type") or "?").rsplit(".", 1)[-1],
                int(round((rec.get("dominant_share") or 0) * 100))))
            _log("  max=%s match4A=%s метод4A=%s" % (rec.get("max"), rec.get("hook_match"), rec.get("hook_method")))
            _log("  причина: %s" % rec.get("reason"))
            _log("==================================================================")
        except Exception:
            pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _b28_prune_stale_verdicts():
    _PERSIST_IO_LOCK.acquire()
    try:
        try:
            p = _globalref_path()
            _rp = _rc_read_path(p) if p else None
            if not _rp: return
            with open(_rp, "r", encoding="utf-8") as f: recs = list(json.load(f))
        except Exception:
            return
        ps = globals().get("_PROC_START_MS") or 0
        keep = []; drop = []
        for rec in recs:
            try:
                if not isinstance(rec, dict) or rec.get("kind") != "jni-globalref-leak":
                    keep.append(rec); continue
                stale = bool(rec.get("stale_echo"))
                if not stale and ps:
                    base = rec.get("event_ts") or rec.get("ts")
                    if base and (int(ps) - int(base)) > _B28_STALE_ECHO_MS:
                        stale = True
                (drop if stale else keep).append(rec)
            except Exception:
                keep.append(rec)
        if not drop: return
        try: _atomic_json_write(p, keep, _GLOBALREF_FAILS_MAX)
        except Exception: pass
        try:
            hp = File(_DIR, "globalref_history.json").getAbsolutePath()
            hist = []
            _hrp = _rc_read_path(hp)
            if _hrp:
                try:
                    with open(_hrp, "r", encoding="utf-8") as f: hist = list(json.load(f))
                except Exception: hist = []
            hist += drop
            _atomic_json_write(hp, hist[-_GLOBALREF_SEEN_MAX:], _GLOBALREF_SEEN_MAX)
        except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _read_globalref_overflow(logcat=True):
    if not _BLOCK28_ON: return None
    _GREF_READ_LOCK.acquire()
    try:
        try: _b28_reattribute_untagged()
        except Exception: pass
        texts = []
        try: texts += _b28_read_drop_files()
        except Exception: pass
        if logcat:
            try: texts += _b28_read_logcat()
            except Exception: pass
        if not texts: return None
        seen = _b28_load_seen()
        new_sigs = list(seen)
        last_rec = None
        changed = False
        seen_changed = False
        for t in texts:
            block, ev_ts = _b28_extract_overflow_block(t)
            if not block: continue
            rec, parsed = _b28_build_verdict(block, event_ts=ev_ts)
            sig = _b28_signature(parsed, rec.get("dominant_type"))
            rec["sig"] = sig
            is_tagged = bool(rec.get("hook_owner"))
            tag_key = sig + "#tagged"
            ev_key = ("evt:%s:%s" % (sig, ev_ts)) if ev_ts else None
            if ev_key and ev_key in new_sigs:
                continue
            if rec.get("stale_echo"):
                try: _log("Block#28: старый logcat-эхо overflow (событие ~%.1f мин до старта) — подавлено, не текущая утечка" % ((rec.get("age_ms") or 0) / 60000.0))
                except Exception: pass
                if ev_key:
                    new_sigs.append(ev_key); seen_changed = True
                continue
            seen_sig = sig in new_sigs
            seen_tagged = tag_key in new_sigs
            if seen_sig and (not is_tagged or seen_tagged) and not ev_key:
                continue
            if seen_sig:
                rec["repeat"] = True
            if not seen_sig:
                new_sigs.append(sig); seen_changed = True
            if is_tagged and not seen_tagged:
                new_sigs.append(tag_key); seen_changed = True
            if ev_key and ev_key not in new_sigs:
                new_sigs.append(ev_key); seen_changed = True
            changed = True
            _b28_write_verdict(rec)
            last_rec = rec
        if changed or seen_changed:
            _b28_save_seen(new_sigs)
        try:
            _b28_prune_stale_verdicts()
        except Exception: pass
        return last_rec
    except Exception as e:
        try: _log("Block#28 read err: %s" % e)
        except Exception: pass
        return None
    finally:
        try: _GREF_READ_LOCK.release()
        except Exception: pass

def _b28_hot_hook_owners():
    out = {}
    try:
        omap, _, _ = _build_hook_owner_map()
        for key, owner in (omap or {}).items():
            if not owner:
                continue
            try:
                mth = str(key).rsplit(".", 1)[-1]
            except Exception:
                continue
            if mth in _B28_HOT_METHODS:
                out.setdefault(owner, [])
                if mth not in out[owner]:
                    out[owner].append(mth)
    except Exception:
        pass
    try:
        with _B28_HOOK_REG_LOCK:
            reg = dict(_B28_HOOK_REG)
        for owner, methods in reg.items():
            if not owner:
                continue
            out.setdefault(owner, [])
            for mth in methods or []:
                if mth in _B28_HOT_METHODS and mth not in out[owner]:
                    out[owner].append(mth)
    except Exception:
        pass
    return out

def _b28_warn_scan(tag="periodic"):
    if not (_BLOCK28_ON and _B28_WARN_ON): return
    try:
        owners = _b28_hot_hook_owners()
        for owner, methods in owners.items():
            key = "%s|%s" % (owner, ",".join(sorted(methods)))
            if key in _B28_WARNED: continue
            _B28_WARNED.add(key)
            _log("⚠ Block#28 РАННЕЕ ПРЕДУПРЕЖДЕНИЕ (%s): плагин %r держит хук на горячем "
                 "методе рендера %s — каждый вызов рискует оставить JNI global-ref "
                 "(Proxy_Object). При утечке таблица дойдёт до предела (~51200) и ART "
                 "аварийно завершит процесс." % (tag, owner, ", ".join(methods)))
    except Exception as e:
        try: _log("Block#28 warn-scan err: %s" % e)
        except Exception: pass

_HX_FLOOD_ON = True
_HX_FLOOD_NAME = "hook_exception_flood.json"
_HX_FLOOD_READ_RE = "Uncaught Exception|FATAL EXCEPTION|NoClassDefFoundError|ClassNotFoundException|XposedBridge|AndroidRuntime"
_HX_FLOOD_HDR_RE = re.compile(r"(Uncaught Exception|FATAL EXCEPTION)")
_HX_FLOOD_FRAME_RE = re.compile(r"\bat\s+([\w.$]+)\(")
_HX_FLOOD_EXCCLS_RE = re.compile(r"((?:[\w$]+\.)+[\w$]+(?:Error|Exception))")
_HX_FLOOD_SKIP_PKG = ("android.", "java.", "javax.", "kotlin.", "kotlinx.",
                      "dalvik.", "libcore.", "sun.", "com.android.",
                      "de.robv.android.xposed.", "org.telegram.")
_HX_FLOOD_MIN_RATE = 1.0
_HX_FLOOD_HI_RATE = 5.0
_HX_FLOOD_MIN_N = 8
_HX_FLOOD_WINDOW_MS = 90000
_HX_FLOOD_DEDUP_MS = 120000
_HX_FLOOD_SEEN = {}
_HX_FLOOD_CUM = {}
_HX_FLOOD_CUM_N = 24
_HX_FLOOD_CUM_WINDOW_MS = 300000

def _b28_read_logcat_re(ere, level="E", tail=6000):
    out = []
    try:
        if not (_NLIB is not None and hasattr(_NLIB, "cd_logcat_read_filtered")):
            return out
    except Exception:
        return out
    cap = 3 * 1024 * 1024
    try: bufp = ctypes.create_string_buffer(cap)
    except Exception: return out
    for buf in ("crash", "main"):
        try:
            n = int(_NLIB.cd_logcat_read_filtered(
                buf.encode("utf-8"), level.encode("ascii"), (ere or "").encode("utf-8"),
                ctypes.c_int32(int(tail)), bufp, ctypes.c_int32(cap)))
        except Exception:
            continue
        if n > 0:
            try: out.append(bufp.value.decode("utf-8", "replace"))
            except Exception: pass
    return out

def _hx_flood_attr_frame(frames):
    for fr in frames:
        if not fr: continue
        if any(fr.startswith(p) for p in _HX_FLOOD_SKIP_PKG): continue
        return fr.rsplit(".", 1)[0] if "." in fr else fr
    if frames:
        f0 = frames[0]
        return f0.rsplit(".", 1)[0] if "." in f0 else f0
    return None

def _hx_flood_path():
    return _data_path(_HX_FLOOD_NAME)

def _hx_flood_emit(attr, sig, n, rate, span_s, missing_class=None):
    now = int(time.time() * 1000)
    key = "%s|%s" % (attr, sig or "")
    if now - _HX_FLOOD_SEEN.get(key, 0) < _HX_FLOOD_DEDUP_MS: return
    _HX_FLOOD_SEEN[key] = now
    pkg = attr.rsplit(".", 1)[0] if (attr and "." in attr) else attr
    rec = {"had_flood": True, "event_type": "hook_exception_flood",
           "dropbox_tag": "app_hook_flood", "tombstone_norm_version": 1,
           "culprit": attr, "culprit_pkg": pkg, "culprit_kind": "hook",
           "src": "logcat/exteraHook", "where": "hook-dispatch",
           "confidence": ("high" if rate >= _HX_FLOOD_HI_RATE else "medium"),
           "exc_cls": sig or "Uncaught Exception", "count": int(n),
           "rate_per_s": round(rate, 2), "window_s": round(span_s, 1),
           "reason": ("hook %s throws %s in a loop (%.1f/s, %d in %.0fs) on the dispatch "
                      "thread -- silently burns CPU/battery and floods logcat; ANR/pyerr "
                      "do not catch it (Java hook exception, not Python)") % (pkg, (sig or "Uncaught Exception"), rate, n, span_s),
           "ts": now}
    if missing_class:
        rec["missing_class"] = missing_class
        _inc, _incconf = _hx_api_incompat(missing_class)
        if _inc:
            rec["event_type"] = "plugin_api_incompatible"
            rec["dropbox_tag"] = "plugin_api_incompatible"
            rec["api_incompatible"] = True
            rec["confidence"] = _incconf or rec.get("confidence")
            rec["reason"] = ("плагин %s собран под устаревший Telegram API: класс %s "
                            "не найден (удалён/переименован) -> плагин надо обновить; "
                            "хук зациклился (%.1f/с, %d за %.0fс), жжёт CPU/батарею и флудит logcat"
                            % (pkg, missing_class, rate, n, span_s))
            rec["fix_hint"] = "обнови/пересобери плагин под текущую версию exteraGram/Telegram"
    p = _hx_flood_path()
    if not p: return
    _PERSIST_IO_LOCK.acquire()
    try:
        cur = []
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f: cur = list(json.load(f))
            except Exception: cur = []
        cur.append(rec)
        _atomic_json_write(p, cur, 20)
        _log("+HX FLOOD: hook %r throws %s %.1f/s (n=%d span=%.0fs) -> %s" % (attr, (sig or "?"), rate, n, span_s, _HX_FLOOD_NAME))
    except Exception as e:
        try: _log("+HX flood persist err: %s" % e)
        except Exception: pass
    finally:
        try: _PERSIST_IO_LOCK.release()
        except Exception: pass

def _hx_flood_scan(tag="periodic"):
    if not (_BLOCK28_ON and _HX_FLOOD_ON): return
    try:
        texts = _b28_read_logcat_re(_HX_FLOOD_READ_RE, level="E", tail=6000)
    except Exception as e:
        try: _log("+HX flood: logcat read err: %s" % e)
        except Exception: pass
        return
    if not texts: return
    now = int(time.time() * 1000)
    cut = now - _HX_FLOOD_WINDOW_MS
    groups = {}
    for blob in texts:
        lines = blob.split("\n")
        N = len(lines); i = 0
        while i < N:
            ln = lines[i]
            if ("XposedBridge" in ln or "AndroidRuntime" in ln) and _HX_FLOOD_HDR_RE.search(ln):
                ets = _b28_logcat_event_ts(ln) or now
                frames = []; sig = None; missing = None; j = i + 1
                while j < N and j < i + 40:
                    fl = lines[j]
                    if _HX_FLOOD_HDR_RE.search(fl): break
                    m = _HX_FLOOD_FRAME_RE.search(fl)
                    if m: frames.append(m.group(1))
                    if sig is None:
                        me = _HX_FLOOD_EXCCLS_RE.search(fl)
                        if me: sig = me.group(1)
                    if missing is None:
                        _mm = _hx_extract_missing(fl)
                        if _mm: missing = _mm
                    j += 1
                if missing is None:
                    missing = _hx_extract_missing(ln)
                attr = _hx_flood_attr_frame(frames) or "unknown-hook"
                g = groups.get(attr)
                if g is None: g = groups[attr] = {"ts": [], "sig": sig, "missing": missing}
                if ets >= cut: g["ts"].append(ets)
                if g["sig"] is None and sig: g["sig"] = sig
                if g.get("missing") is None and missing: g["missing"] = missing
                i = j; continue
            i += 1
    for attr, g in groups.items():
        tss = sorted(g["ts"]); n = len(tss)
        cum = _HX_FLOOD_CUM.setdefault(attr, [])
        if tss: cum.extend(tss)
        cwin = now - _HX_FLOOD_CUM_WINDOW_MS
        cum[:] = sorted(x for x in cum if x >= cwin)
        cn = len(cum)
        span = ((tss[-1] - tss[0]) / 1000.0) if n >= 2 else 0.0
        rate = (n / span) if span > 0 else float(n)
        burst_ok = (n >= _HX_FLOOD_MIN_N and rate >= _HX_FLOOD_MIN_RATE)
        persist_ok = (cn >= _HX_FLOOD_CUM_N)
        if not (burst_ok or persist_ok): continue
        if burst_ok:
            _hx_flood_emit(attr, g.get("sig"), n, rate, span, g.get("missing"))
        else:
            cspan = ((cum[-1] - cum[0]) / 1000.0) if cn >= 2 else 0.0
            crate = (cn / cspan) if cspan > 0 else float(cn)
            _hx_flood_emit(attr, g.get("sig"), cn, crate, cspan, g.get("missing"))


def _b28_loop(stop):
    try: stop.wait(8.0)
    except Exception: pass
    while not stop.is_set():
        _gil_begin(_GIL_B28)
        try:
            _b28_warn_scan("periodic")
            try: _hx_flood_scan("periodic")
            except Exception: pass
        finally:
            _gil_end(_GIL_B28)
        try:
            if stop.wait(_B28_WARN_PERIOD_S): break
        except Exception: break

def _b28_start():
    global _B28_THREAD
    if not _BLOCK28_ON:
        _log("Block#28: отключён (_BLOCK28_ON=False)"); return
    if _B28_THREAD is not None:
        return
    if not _B28_WARN_ON:
        _log("Block#28: пост-мортем включён, раннее предупреждение выключено"); return
    _B28_STOP.clear()
    _B28_THREAD = threading.Thread(target=_b28_loop, args=(_B28_STOP,), name="culprit-b28", daemon=True)
    _B28_THREAD.start()
    _log("Block#28: JNI globalref-overflow детектор активен (пост-мортем logcat/дамп + раннее предупреждение по хукам: %s)" % (", ".join(_B28_HOT_METHODS)))

def _b28_stop():
    global _B28_THREAD
    try:
        _B28_STOP.set()
        t = _B28_THREAD
        if t is not None:
            try: t.join(timeout=2.0)
            except Exception: pass
        _B28_THREAD = None
        _log("Block#28: остановлен")
    except Exception:
        pass


_B20_ON = True
_B20_PING_MS = 2000
_B20_BEAT_MS = 1000
_B20_BEAT = None
_B20_BEAT_INFLIGHT = False
_B20_TIMEOUT_MS = 4500
_B20_IDLE_CPU_MAX = 25.0
_B20_SELFKILL_AFTERMATH_MS = 3000
_B20_STOP = threading.Event()
_B20_THREAD = None
_B20_UI_TID = None
_B20_HANDLER = None
_B20_PING = None
_B20_LOCK = threading.Lock()
_B20_MAX_PLAUSIBLE_MS = 15000
