                        v["culprit"] = _jown["plugin"]
                        v["culprit_kind"] = "plugin"
                        v["confidence"] = _jown["conf"]
                        v["tracer_owner_src"] = _jown["src"] if _jown["src"] in ("rejected-jni-argument", "tracer-registry") else "journal-" + _jown["src"]
                        _log("  +UF: tracer owner evidence: %s idx=%d plugin=%r confidence=%s (fault location=%s)" % (_jown["src"], _jown["idx"], _jown["plugin"], _jown["conf"], _cmod or _bestq.get("pc_module")))
                    else:
                        _amod = _trc_abort_caller_module(_bestq) if _abrt else None
                        v["culprit"] = _amod or _cmod or _bestq.get("pc_module") or ("native (ptrace) " + str(_bestq.get("comm") or ""))
                        v["culprit_kind"] = "host/native"
                        v["confidence"] = "medium" if _abrt else "high"
                        if _abrt:
                            v["tracer_abort"] = True
                            _log("  +UF: abort/software signal (sig=%s si=%s), first non-runtime frame=%s; ownership checked separately" % (_bestq.get("sig"), _bestq.get("si_code"), v["culprit"]))
                    _location_only = not bool(_jown)
                    v["attribution"] = not _location_only
                    if _location_only:
                        _hint = _amod or _cmod
                        v["native_module_hint"] = _hint if _trc_mod_is_realcode(_hint) else None
                        v["attribution_basis"] = "fault_location_only"
                        v["unattributed_reason"] = "native fault location/stack observed; causal owner not established"
