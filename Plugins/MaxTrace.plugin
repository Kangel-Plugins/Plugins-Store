        self.projection_setup.update(callback_class=name, capture_fields=[f for f, _ in fields], capture_gaps=list(gaps)[:8])
        if gaps:
            return fallback("capture_schema_gaps")
        if not fields:
            return fallback("no_capture_fields")
        warm = []
        for item in getattr(self, "trace_warm_targets", ()):
            cb_name, ref = item[:2]
            if cb_name == name and not self.gone(ref):
