        except Exception: pass
        try: _log("Block#42 +TN: hprof-дамп при утечке %s" % ("ВКЛ" if _B42_HPROF_ON else "ВЫКЛ"))
        except Exception: pass

    
    def _ui_lags_subpage(self):
        if not _UI_OK: return []
        items = [Header(text=self._t("⏱ Зависания UI (Watchdog)"))]
        raw_json = _DEX.call("pyGetLagsJson") if _DEX.is_loaded() else None
        lags = []
        if raw_json:
            try: lags = json.loads(str(raw_json))
            except Exception: pass
        if not lags:
            items.append(Text(text=self._t("✅ Зависаний не зафиксировано"), icon="msg_info"))
        else:
            for record in reversed(lags):
                dur = record.get("durationMs", 0)
                culprit = record.get("culprit", "Unknown")
                ts = record.get("timestamp", 0)
                t_str = time.strftime("%H:%M:%S", time.localtime(ts / 1000)) if ts else ""
                full_stack = record.get("fullStack", "")
                def make_click(c=culprit, d=dur, s=full_stack):
                    def handler(*_):
                        try:
                            from ui.alert import AlertDialogBuilder
                            from client_utils import get_last_fragment
                            frag = get_last_fragment()
                            act = frag.getParentActivity() if frag else None
                            b = AlertDialogBuilder(act) if act else AlertDialogBuilder()
                            b.set_title(f"Зависание {d} мс — {c}")
                            b.set_message(f"Виновник: {c}\nДлительность: {d} мс\n\nСтек вызовов:\n{s}")
                            b.set_positive_button("Закрыть", None)
                            b.show()
                        except Exception as e:
                            _log(f"MaxTrace: alert error: {e}")
                    return handler
                items.append(Text(
                    text=f"{dur} мс — {culprit}",
                    description=f"Время: {t_str}",
                    icon="msg_block",
                    on_click=make_click()
                ))
            items.append(Divider())
            def clear_lags(*_):
                if _DEX.is_loaded(): _DEX.call("pyClearLags")
                try:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_info("История зависаний очищена")
                except Exception: pass
            items.append(Text(text="Очистить историю фризов", icon="msg_delete", on_click=clear_lags))
        return items

    def _ui_threads_subpage(self):
        if not _UI_OK: return []
        items = [Header(text=self._t("🧵 Атрибуция потоков по плагинам"))]
        raw_json = _DEX.call("pyGetThreadStatsJson") if _DEX.is_loaded() else None
        threads = {}
        if raw_json:
            try: threads = json.loads(str(raw_json))
            except Exception: pass
        if not threads:
            items.append(Text(text=self._t("Потоков плагинов пока не обнаружено"), icon="msg_info"))
        else:
            for tid, plugin in sorted(threads.items()):
                items.append(Text(text=f"Thread #{tid} → {plugin}", icon="msg_bot"))
        return items

    def _open_tg_url(self, url):
        def _handler(*args, **kwargs):
            view = args[0] if args else None
            try:
                Browser = jclass("org.telegram.messenger.browser.Browser")
                ctx = None
                try:
                    if view is not None and hasattr(view, "getContext"):
                        ctx = view.getContext()
                except Exception:
                    pass
                if ctx is None:
                    ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
                try:
                    uri = jclass("android.net.Uri").parse(url)
                    Browser.openUrl(ctx, uri, True, False, None)
                except Exception:
                    try:
                        Browser.openUrl(ctx, url, True, True)
                    except Exception:
                        Browser.openUrl(ctx, url)
            except Exception:
                try:
                    from android.content import Intent
                    from android.net import Uri
                    ctx = None
                    try:
                        if view is not None and hasattr(view, "getContext"):
                            ctx = view.getContext()
                    except Exception:
                        pass
                    if ctx is None:
                        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
                    intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
                    intent.setPackage(ctx.getPackageName())
                    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                    ctx.startActivity(intent)
                except Exception:
                    pass
        return _handler

    def create_settings(self):
        if not _UI_OK: return []
        try:
            self._ui_refresh_pending()
        except Exception:
            pass
        rows = [Header(text=self._t("🔎 Кто виноват в проблемах"))]

        rows.append(Text(text=self._t(" Покажи виновников"), icon="msg_report", accent=True, create_sub_fragment=self._ui_culprits_subpage))
        rows.append(Text(text=self._t("⏱ Зависания UI (Watchdog)"), icon="msg_block", accent=True, create_sub_fragment=self._ui_lags_subpage))
        rows.append(Text(text=self._t("🧵 Атрибуция потоков плагинов"), icon="msg_bot", accent=True, create_sub_fragment=self._ui_threads_subpage))
        rows.append(Text(text=self._t(" Память (снимок)"), icon="msg_stats", accent=True, create_sub_fragment=self._ui_memory_stats_subpage))
        rows.append(Text(text=self._t(" Фильтр логов (logcat)"), icon="msg_info", accent=True, create_sub_fragment=self._ui_logfilter_subpage))
        rows.append(Switch(key="queue_retention_on", text=self._t("Диагностика удержания экранов в очереди"), default=False, subtext=self._t("Слабые снимки; адресные Java-фильтрованные proof-хуки до 180 с, без GC"), icon="msg_stats", on_change=self._q42_on_toggle))
        rows.append(Switch(key="hprof_on", text=self._t("Дамп Java-кучи (.hprof) при утечке"), default=True, subtext=self._t("Морозит процесс на секунды, десятки МБ; сжатие gzip, лимит 80 МБ"), icon="msg_download", on_change=self._b42_on_hprof_toggle))
        rows.append(Switch(key="widget_on", text=self._t("Виджет виновников (оверлэй)"), default=False, subtext=self._t("Плавающая пилюля: количество виновников и карусель"), icon="msg_report", on_change=self._wg_on_toggle))
        rows.append(Divider())
        rows.append(Text(f"v.{__version__}", icon="msg_info"))
        rows.append(Text(f"{__author__}", icon="msg_channel", on_click=self._open_tg_url("https://t.me/MaxExteraPlugins")))
        return rows

def create_plugin(): return Plugin()

_UI_VERDICT_SOURCES = Plugin._UI_VERDICT_SOURCES


