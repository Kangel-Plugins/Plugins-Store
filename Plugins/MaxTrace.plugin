        globals()["_CP_LIFECYCLE"] = "unloading"
        global _OUR_UEH, _PREV_UEH
        _log("Culprit Detector unloading")
        _b42_nc_reset()
        try: _q42_stop()
        except Exception as e: _log("Block#42 +UG stop: %s" % e)
        try: _thread_shim_detach()
        except Exception: pass
