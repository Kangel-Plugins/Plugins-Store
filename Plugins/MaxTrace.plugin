                rec["op_anim_corrob"] = _corr
                try: _log("+NA: слабый итоговый вердикт + anim-кадры - принят anim op-штамп: плагин=%r api=%s age=%sms conf=%s corrob=%s" % (_oown, _opan.get("api"), _opan.get("age_ms"), rec["confidence"], (",".join(_corr) or "-")))
                except Exception: pass
            elif _wk and _spec:
