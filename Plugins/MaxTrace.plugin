                _log("  +UF: matching ptrace signal; attribution=%s wild=%s (isklyucheno nashih kaskadnyh zahvatov: %d); sig=%s si=%s addr=%s pc=%s comm=%s" % (v.get("culprit"), bool(_wild), _self_n, _bestq.get("sig"), _bestq.get("si_code"), _bestq.get("si_addr"), _bestq.get("pc"), _bestq.get("comm")))
            elif _self_n:
                v["tracer_detector_cascade_only"] = _self_n
                _log("  +QX: vse sovpavshie tracer-zahvaty (%d) -- VTORICHNYE fault nashego obrabotchika (stack-overflow v libculprit pri hijacked-steke), NE pervoprichina -> self-blame podavlen (cause remains unproven)" % _self_n)
            else:
                v["tracer_benign_captures"] = len(_tqs)
                _log("  +QP: treyser-zahvaty proshloy sessii (%d) NE sovpadayut so smert'yu -- fonovye recoverable fault; cause remains unproven" % len(_tqs))
    except Exception as _eqp:
        _log("  +QP tracer correlate err: %s" % _eqp)
    if best is not None and code == 2 and (not v.get("attribution")) and not v.get("heap_corruption") and not (v.get("abort_flags") or {}).get("jni_detected_error") and not benign_self and not blameless and ets is not None:
        
        
        
        try:
            _jo2 = _trc_jrn_owner({"sig": status, "tid": None, "pid": v.get("exit_pid"), "realtime_ms": int(ets)}, exit_only=True)
            if _jo2:
