                except Exception: pass
                try:
                    if (rec.get("pid_stack") == _oown) or (rec.get("culprit_frame") and _pkg_of(rec.get("culprit_frame")) == _oown): _corr.append("stack")
                except Exception: pass
                try:
                    _oapi = _opan.get("api")
                    if _oapi and len(str(_oapi)) >= 6 and any(str(_oapi) in (_f or "") for _f in (rec.get("stack_top") or [])): _corr.append("api-frame")
                except Exception: pass
                rec["crashed_plugin_id_pre_anim"] = _cur
                rec["crashed_plugin_id"] = _oown; rec["src"] = "anim-op"
