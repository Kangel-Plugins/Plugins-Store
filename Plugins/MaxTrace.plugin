def _b42_foreground():
    try:
        fd = _jc("org.telegram.ui.Components.ForegroundDetector")
        inst = fd.getInstance() if fd is not None else None
        if inst is not None:
            return bool(inst.isForeground())
    except Exception:
        pass
    try:
        al = _jc("org.telegram.messenger.ApplicationLoader")
        if al is not None and hasattr(al, "mainInterfacePaused"):
            return not bool(al.mainInterfacePaused)
    except Exception:
        pass
    return False


def _b42_gc(min_gap_ms=0):
    if not _B42_GC_LOCK.acquire(False):
        return False
    attempted = False
    try:
        mono = int(time.monotonic() * 1000)
        previous = _B42_GC_ATTEMPT_MONO[0]
        if min_gap_ms and previous is not None and mono - previous < min_gap_ms:
            return False
        attempted = True
        _B42_GC_ATTEMPT_MONO[0] = mono
        rt = _jc("java.lang.Runtime").getRuntime()
        start_ms = int(time.time() * 1000)
        start_mono = int(time.monotonic() * 1000)
        rt.gc(); rt.runFinalization(); rt.gc()
        end_ms = int(time.time() * 1000)
        end_mono = int(time.monotonic() * 1000)
        old = _B42_GC_STATE[0]
        generation = old[0] + 1 if old is not None else 1
        _B42_GC_STATE[0] = (generation, start_ms, end_ms, start_mono, end_mono)
        _B42_LAST_GC[0] = end_ms
        return True
    except Exception:
        return False
    finally:
        if attempted:
            _B42_GC_ATTEMPT_MONO[0] = int(time.monotonic() * 1000)
        _B42_GC_LOCK.release()


def _b42_gc_stats():
    out = {}
    try:
        Debug = _jc("android.os.Debug")
        if Debug is None:
            return out
        for k in _B42_GC_KEYS:
            try:
                s = Debug.getRuntimeStat(k)
                if s is None:
                    continue
                out[k.replace("art.gc.", "")] = int(str(s))
            except Exception:
                continue
    except Exception:
        pass
    return out


def _b42_gc_stats_str(g):
    if not isinstance(g, dict) or not g:
        return ""
    try:
        p = []
        if g.get("blocking-gc-count") is not None:
            p.append("blocking %s раз/%s мс" % (g.get("blocking-gc-count"), g.get("blocking-gc-time", "?")))
        if g.get("gc-count") is not None:
            p.append("всего %s раз/%s мс" % (g.get("gc-count"), g.get("gc-time", "?")))
        return ("GC: " + ", ".join(p)) if p else ""
    except Exception:
        return ""


def _b42_app_loader():
    if _B42_APP_CL[0] is None:
        cl = None
        try:
            al = _jc("org.telegram.messenger.ApplicationLoader")
            ctx = al.applicationContext if al is not None else None
            cl = ctx.getClassLoader() if ctx is not None else None
        except Exception:
            cl = None
        if cl is None:
            try: cl = _jc("java.lang.Thread").currentThread().getContextClassLoader()
            except Exception: cl = None
        _B42_APP_CL[0] = cl if cl is not None else False
    return _B42_APP_CL[0] if _B42_APP_CL[0] is not False else None


def _b42_proc_age_ms():
    try:
        if _NLIB is not None and hasattr(_NLIB, "cd_proc_age_ms"):
            import ctypes as _c
            _NLIB.cd_proc_age_ms.restype = _c.c_int64
            v = int(_NLIB.cd_proc_age_ms())
            if v >= 0:
                return v
    except Exception:
        pass
    try:
        return int(_jc("android.os.SystemClock").uptimeMillis()) - int(_jc("android.os.Process").getStartUptimeMillis())
    except Exception:
        return -1


def _b42_count_instances(classnames):
    if _B42_VMDEBUG[0] is False or _B42_CLASSARR[0] is False:
        return None
    try:
        if _B42_VMDEBUG[0] is None:
            _B42_VMDEBUG[0] = _jc("dalvik.system.VMDebug")
        if _B42_CLASSARR[0] is None:
            from java import jarray
            _B42_CLASSARR[0] = jarray(_jc("java.lang.Class"))
        vmd = _B42_VMDEBUG[0]
        if vmd is None:
            _B42_VMDEBUG[0] = False
            return None
    except Exception:
        _B42_VMDEBUG[0] = False
        _B42_CLASSARR[0] = False
        return None
    classes = []
    names = []
    _cl = _b42_app_loader()
    _Cls = _jc("java.lang.Class")
    for nm in classnames:
        try:
            k = _Cls.forName(nm, False, _cl) if _cl is not None else _Cls.forName(nm)
            if k is not None:
                classes.append(k); names.append(nm)
        except Exception:
            continue
    if not _B42_CLS_LOGGED[0]:
        _B42_CLS_LOGGED[0] = True
        _miss = [n.rsplit(".", 1)[-1] for n in classnames if n not in names]
        _log("Block#42 +TV: census классов %d/%d (loader=%s)%s" % (len(names), len(classnames), "app" if _cl is not None else "boot", (" нет: " + ",".join(_miss)) if _miss else ""))
    if not classes:
        return None
    try:
        arr = _B42_CLASSARR[0](classes)
    except Exception:
        return None
    try:
        res = _B42_VMDEBUG[0].countInstancesOfClasses(arr, True)
        if res is not None:
            vals = list(res)
            return {names[i]: int(vals[i]) for i in range(min(len(names), len(vals)))}
    except Exception:
        pass
    out = {}
    try:
        for i, k in enumerate(classes):
            try:
                out[names[i]] = int(_B42_VMDEBUG[0].countInstancesOfClass(k, True))
            except Exception:
                continue
        return out or None
    except Exception:
        return None


def _b42_object_census(force=False):
    if not _B42_ON:
        return None
    now = int(time.time() * 1000)
    if not force:
        if now - _B42_OBJ_LAST[0] < _B42_OBJ_PERIOD_MS:
            return None
        if not _b42_foreground():
            return None
        _age = _b42_proc_age_ms()
        if 0 <= _age < _B42_OBJ_WARMUP_MS:
            return None
        _B42_OBJ_LAST[0] = now
    _b42_gc()
    counts = _b42_count_instances(_B42_COUNTED_CLASSES)
    if not counts:
        return None
    if force:
        return counts
    for nm, c in counts.items():
        h = _B42_OBJ_HIST.setdefault(nm, [])
        h.append((now, int(c)))
        if len(h) > _B42_OBJ_KEEP:
            del h[:len(h) - _B42_OBJ_KEEP]
    leaks = []
    for nm, h in _B42_OBJ_HIST.items():
        if len(h) < 3:
            continue
        seq = [c for _, c in h]
        first, last = seq[0], seq[-1]
        growth = last - first
        monotonic = all(seq[i] <= seq[i + 1] for i in range(len(seq) - 1))
        is_singleton = nm in _B42_SINGLETON_CLASSES
        if monotonic and growth >= max(_B42_OBJ_MIN_GROWTH, first * _B42_OBJ_MIN_REL) and (last >= _B42_OBJ_MIN_GROWTH):
            leaks.append({"cls": nm, "first": first, "last": last, "growth": growth,
                          "n": len(seq), "span_s": round((h[-1][0] - h[0][0]) / 1000.0, 1), "kind": "growth"})
        elif is_singleton and last > _B42_OBJ_SINGLETON_MAX:
            leaks.append({"cls": nm, "first": first, "last": last, "growth": growth,
                          "n": len(seq), "span_s": round((h[-1][0] - h[0][0]) / 1000.0, 1), "kind": "singleton-overcount"})
    if not leaks:
        return counts
    leaks.sort(key=lambda d: (d["kind"] != "singleton-overcount", -d["growth"], -d["last"]))
    top = leaks[0]
    short = top["cls"].rsplit(".", 1)[-1]
    rec = {"had_leak": True, "suspected_leak": True, "leak_confirmed": False,
           "attribution": False, "root_status": "not_identified",
           "verdict": "SUSPECTED CLIENT OBJECT RETENTION",
           "culprit": "client (host process)", "culprit_kind": "host", "host_side": True,
           "confidence": "medium" if top["kind"] == "growth" else "low",
           "kind": "client-object-leak", "leak_class": top["cls"], "leak_kind": top["kind"],
           "first": top["first"], "last": top["last"], "growth": top["growth"],
           "samples": top["n"], "span_s": top["span_s"],
           "all_leaks": leaks[:6], "counts": counts,
           "reason": ("живых экземпляров %s выросло %d -> %d за %.0f с (монотонно, %d замеров) -- подозрение на удержание; GC-root и владелец не установлены"
                      % (short, top["first"], top["last"], top["span_s"], top["n"]))
                     if top["kind"] == "growth" else
                     ("%d живых экземпляров %s превышает эвристический порог %d; допустимый navigation stack/кеш и GC-root не проверены"
                      % (top["last"], short, _B42_OBJ_SINGLETON_MAX)),
           "exc_cls": "ClientObjectLeak", "exc_msg": "%s live=%d (+%d)" % (short, top["last"], top["growth"]),
           "gc": _b42_gc_stats(), "nc_observers": _b42_nc_snapshot(),
           "ts": now, "event_type": "client_object_leak", "dropbox_tag": "app_memory_leak",
           "tombstone_norm_version": 1}
    try:
        _ui_ctx_attach(rec)
    except Exception:
        pass
    if _b42_append_dedup(_B42_OBJ_FILE, rec, dedup_key=("leak_class",)):
        _log("================ SUSPECTED OBJECT RETENTION (Block#42 +UB) ================")
        _log("НАБЛЮДЕНИЕ: client class=%s %d->%d (+%d) за %.0fс conf=%s kind=%s; GC-root/owner unresolved"
             % (short, top["first"], top["last"], top["growth"], top["span_s"], rec["confidence"], top["kind"]))
        for l in leaks[:6]:
            _log("  %s: %d->%d (+%d) n=%d" % (l["cls"].rsplit(".", 1)[-1], l["first"], l["last"], l["growth"], l["n"]))
        _log("===================================================================")
    return counts


def _q42_cls(name):
    return _jc("java.lang.Class").forName(name, False, _b42_app_loader())


class _Q42Weak:
    def __init__(self):
        from java import jarray
        self.array = jarray(_jc("java.lang.Object"))
        self.wr = _jc("java.lang.ref.WeakReference")
        self.obj = _q42_cls("java.lang.Object")
        ref = _q42_cls("java.lang.ref.Reference")
        self.mh = _jc("java.lang.invoke.MethodHandles")
        self.lk = self.mh.publicLookup()
        self.get = self.lk.unreflect(ref.getMethod("get"))
        self.ctor = self.lk.unreflectConstructor(_q42_cls("java.lang.ref.WeakReference").getConstructor(self.obj))
        self.null = self.mh.filterReturnValue(self.get, self.lk.unreflect(_q42_cls("java.util.Objects").getMethod("isNull", self.obj)))
        try:
            self.same = self.mh.collectArguments(self.lk.unreflect(ref.getMethod("refersTo", self.obj)), 1, self.get)
        except Exception:
            ar = _q42_cls("java.util.concurrent.atomic.AtomicReference")
            cas = self.lk.unreflect(ar.getMethod("compareAndSet", self.obj, self.obj))
            ar_of = self.mh.filterReturnValue(self.get, self.lk.unreflectConstructor(ar.getConstructor(self.obj)))
            h = self.mh.collectArguments(cas, 0, ar_of)
            h = self.mh.collectArguments(h, 1, self.get)
            h = self.mh.collectArguments(h, 2, self.get)
            self.same = self.mh.permuteArguments(h, h.type().dropParameterTypes(2, 3), jarray(_jc("java.lang.Integer").TYPE)([0, 1, 1]))
        Boolean = _jc("java.lang.Boolean")
        classes = jarray(_q42_cls("java.lang.Class"))
        false_pair = self.mh.dropArguments(self.mh.constant(Boolean.TYPE, Boolean.FALSE), 0, classes([ref, ref]))
        null_second = self.mh.dropArguments(self.null, 0, classes([ref]))
        self.same_live = self.mh.guardWithTest(null_second, false_pair, self.same)
        self.hash = self.mh.filterReturnValue(self.get, self.lk.unreflect(_q42_cls("java.lang.System").getMethod("identityHashCode", self.obj)))
        self.class_of = self.mh.filterReturnValue(self.get, self.lk.unreflect(self.obj.getMethod("getClass")))
        self.name = self.mh.filterReturnValue(self.class_of, self.lk.unreflect(_q42_cls("java.lang.Class").getMethod("getName")))
        inner_get = self.get.asType(self.get.type().changeParameterType(0, self.obj))
        self.deref = self.mh.filterReturnValue(self.get, inner_get)
        self.deref = self.mh.filterReturnValue(self.deref, self.ctor)
        sentinel = _jc("java.util.ArrayList")()
        a, b = self.wr(sentinel), self.wr(sentinel)
        _distinct = _jc("java.util.ArrayList")()
        if self.gone(a) or not self.equal(a, b) or not self.gone(self.wr(None)) or self.equal(a, self.wr(_distinct)):
            raise RuntimeError("weak projection selftest failed")

    def call(self, handle, *args):
        return handle.invokeWithArguments(self.array(list(args)))

    def int_constant(self, value):
        from java import jlong
        value = int(value)
        if not -(1 << 31) <= value < (1 << 31):
            raise ValueError("int constant outside int32")
        handle = self.mh.constant(_jc("java.lang.Long").TYPE, jlong(value))
        return self.mh.explicitCastArguments(handle, handle.type().changeReturnType(_jc("java.lang.Integer").TYPE))

    def check_int_constants(self):
        previous = getattr(self, "int_constant_check", None)
        if previous and previous.get("passed"):
            return
        result = dict(strategy="long_jlong_then_explicit_int", passed=False, checked_values=[])
        self.int_constant_check = result
        try:
            for value in (-(1 << 31), -1, 0, 1, 2, 4, 8, 16, (1 << 31)-1):
                actual = self.call(self.int_constant(value))
                if isinstance(actual, bool) or int(actual) != value:
                    raise RuntimeError("int constant bridge preflight mismatch")
                result["checked_values"].append(value)
            result["passed"] = True
        except Exception as exc:
            result.update(error_type=type(exc).__name__, detail=str(exc)[:160])
            raise

    def then(self, first, second):
        
        typed = second.asType(second.type().changeParameterType(0, first.type().returnType()))
        return self.mh.filterReturnValue(first, typed)

    def pack_weak(self, handles, slots=None):
                                                                           
                                                                      
        from java import jarray
        ref_type = self.get.type().parameterType(0)
        array_class = _q42_cls("[Ljava.lang.Object;")
        pack = self.mh.identity(array_class).asCollector(array_class, len(handles))
        for index, handle in enumerate(handles):
            boxed = handle.asType(handle.type().changeReturnType(self.obj).changeParameterType(0, ref_type))
            pack = self.mh.filterArguments(pack, index, jarray(_jc("java.lang.invoke.MethodHandle"))([boxed]))
        slots = slots if slots is not None else [0]*len(handles)
        signature = pack.type().dropParameterTypes(max(slots)+1, len(handles))
        return self.mh.permuteArguments(pack, signature, jarray(_jc("java.lang.Integer").TYPE)(slots))

    def gone(self, ref):
        return ref is None or bool(self.call(self.null, ref))

    def equal(self, a, b):
        return a is not None and b is not None and bool(self.call(self.same_live, a, b))

    def nullable_equal(self, a, b):
        return (self.gone(a) and self.gone(b)) or self.equal(a, b)

    def identity_hash(self, ref):
        return int(self.call(self.hash, ref))

    def class_name(self, ref):
        return str(self.call(self.name, ref)) if not self.gone(ref) else "<collected>"

    def field_handle(self, field, scalar=None):
        if int(field.getModifiers()) & 8:
            raise RuntimeError("static field is not an object edge")
        typename = str(field.getType().getName())
        if (scalar is None and field.getType().isPrimitive()) or (scalar is not None and typename != scalar):
            raise RuntimeError("field schema mismatch")
        field.setAccessible(True)
        h = self.lk.unreflectGetter(field)
        h = h.asType(h.type().changeParameterType(0, self.obj))
        if scalar is None:
            h = h.asType(h.type().changeReturnType(self.obj))
        h = self.mh.filterReturnValue(self.get, h)
        return self.mh.filterReturnValue(h, self.ctor) if scalar is None else h

    def field(self, cls, name, scalar=None):
        for _ in range(16):
            if cls is None:
                break
            try:
                f = cls.getDeclaredField(name)
            except Exception as exc:
                if not type(exc).__name__.endswith("NoSuchFieldException"):
                    raise
                cls = cls.getSuperclass()
                continue
            return self.field_handle(f, scalar)
        raise RuntimeError("field unavailable: " + name)


class _Q42Ids:
    def __init__(self, probe, cap=8192):
        self.probe, self.cap, self.serial = probe, cap, 0
        self.entries, self.buckets = {}, {}

    def token(self, kind, ref):
        if self.probe.gone(ref):
            return 0
        return self.projected_token(kind, ref, self.probe.identity_hash(ref))

    def projected_token(self, kind, ref, identity_hash):
                                                                          
                                                                            
        key = (kind, identity_hash)
        for token in self.buckets.get(key, ()):
            if self.probe.equal(self.entries[token][1], ref):
                return token
        if len(self.entries) >= self.cap:
            raise RuntimeError("weak identity cap")
        self.serial += 1
        self.entries[self.serial] = (key, ref)
        self.buckets.setdefault(key, []).append(self.serial)
        return self.serial

    def forget(self, token):
        entry = self.entries.pop(token, None)
        if entry is not None:
            bucket = self.buckets[entry[0]]
            bucket.remove(token)
            if not bucket:
                del self.buckets[entry[0]]

    def prune(self):
        for token, (_, ref) in list(self.entries.items()):
            if self.probe.gone(ref):
                self.forget(token)

    def close(self):
        self.entries.clear()
        self.buckets.clear()


def _q42_finished(lifecycle):
    flags = lifecycle.get("flags", {})
    required = ("paused", "isPaused", "finishing", "isFinished", "parentLayout_is_null")
    if not lifecycle.get("complete") or any(k not in flags for k in required):
