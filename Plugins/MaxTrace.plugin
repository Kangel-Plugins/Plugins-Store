        values = self.call(self.trace_projection[(run, read_lifecycle)], pref)
        if len(values) != 3:
            raise RuntimeError("batch projection packet length")
        cb, target, packed = values[0], values[1], str(values[2])
        if len(packed) > 512:
            raise RuntimeError("batch projection scalar packet cap")
        metadata = json.loads(packed)
        if not isinstance(metadata, list) or len(metadata) != 10:
            raise RuntimeError("batch projection scalar packet schema")
        if any(metadata[i] is not True for i in (4, 5, 6, 7)):
            raise RuntimeError("batch projection class/target/queue mismatch")
        if any(type(metadata[i]) is not int for i in (1, 2, 3, 8, 9)):
            raise RuntimeError("batch projection scalar type")
        if any(not -(1 << 31) <= metadata[i] < (1 << 31) for i in (1, 2, 3)) or not 0 < metadata[8] < (1 << 63):
            raise RuntimeError("batch projection scalar range")
        if read_lifecycle:
            bits = metadata[0]
            if not isinstance(bits, list) or len(bits) != 5 or any(type(v) is not int for v in bits) or metadata[9] != -1:
                raise RuntimeError("batch projection before schema")
