                        rec["crashed_plugin_id"] = _zjo
                        rec["confidence"] = _zjc
                        rec["src"] = "zombie-java-proxy/" + str(_zjs)
                elif _zjweak:
                    rec["reason"] = "зомби Java-proxy слушатель: плагин выгружен/перезагружен (PyObject closed), java.lang.reflect.Proxy остался зарегистрирован у хоста (%s; владелец не определён)" % _zjp
                    rec["crashed_plugin_id_native"] = _zjcur
                    rec["crashed_plugin_id"] = "зомби Java-proxy слушатель (владелец не определён)"
                    rec["confidence"] = "low"
                    rec["src"] = "zombie-java-proxy/unresolved"
                else:
                    rec["reason"] = "зомби Java-proxy слушатель (%s; PyObject closed); основная атрибуция сохранена" % _zjp
    except Exception: pass
    rec = _b16_correlate(rec)
    try:
        _oown = (_opan or {}).get("owner")
        if _oown:
            _cur = rec.get("crashed_plugin_id")
            _src0 = rec.get("src") or ""
            _spec = (rec.get("cause") in ("orphaned_dynamic_proxy_runnable", "zombie_xposed_hook", "zombie_java_proxy_listener")) or _src0.startswith("zombie") or _src0.startswith("orphan")
            _wk = (not _cur) or (_cur == "unknown") or (rec.get("confidence") in (None, "low", "none"))
            if _wk and not _spec:
                _corr = []
                try:
                    _oage = _opan.get("age_ms")
                    if _oage is not None and int(_oage) <= 1500: _corr.append("age<=1500ms")
