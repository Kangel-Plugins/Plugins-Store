                rec["reason"] = "OOM-краш: Java-куча исчерпана; виновник-аллокатор по OOM-вердикту: %s (аварийная аллокация в стеке — жертва)" % _occ["culprit"]
                rec["oom_ref"] = {"src": _occ.get("src"), "reason_detail": _occ.get("reason_detail"),
                                  "oom_confidence": _occ.get("oom_confidence"), "consensus": _occ.get("consensus"),
                                  "instrumentation_agent": _occ.get("instrumentation_agent"),
                                  "top_named_bytes": _occ.get("top_named_bytes"), "untagged_bytes": _occ.get("untagged_bytes"),
                                  "dump_delta_ms": _occ.get("dump_delta_ms"), "top_bytes": _occ.get("top_bytes"),
                                  "tagged_share": _occ.get("tagged_share")}
                _log("+PK: OOM-krash skorrelirovan s OOM-verdiktom: culprit=%r kind=%s conf=%s consensus=%s ef=%s src=%s delta=%sms (native_mem top=%r ignoriruetsya dlya java-OOM)" % (rec["crashed_plugin_id"], rec.get("culprit_kind"), rec["confidence"], _occ.get("consensus"), _occ.get("instrumentation_agent"), _occ.get("src"), _occ.get("dump_delta_ms"), (nat or {}).get("top_pid")))
    except Exception as _epk:
        _log("+PK OOM-crash correlate err: %s" % _epk)
    try: _ui_ctx_attach(rec)
    except Exception: pass
    _mk_pre = _moment_inflight_keys()
    _persisted = _write_crash_verdict(rec)
    _moment_crash_drain(_mk_pre)
    if _persisted:
        try:
            if _NLIB is not None and hasattr(_NLIB, "cd_kg_permit_crash"):
                _NLIB.cd_kg_permit_crash()
