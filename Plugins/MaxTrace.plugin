    def _q42_on_toggle(self, value):
        self.set_setting("queue_retention_on", bool(value))
        if value: _q42_start(self)
        else: _q42_stop()

    def _b42_on_hprof_toggle(self, v):
        global _B42_HPROF_ON
        _B42_HPROF_ON = bool(v)
