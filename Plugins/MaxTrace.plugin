        if (_ph_co and (not py_file) and culprit and not _anr_scope_suspect
                and not str(culprit).startswith("host")
                and _ph_co.get("owner") and _ph_co.get("owner") != culprit):
            _ph_hog_pct = float(_ph_co.get("pct") or 0.0)
            _ph_src = str(src or "")
            _ph_weak = (("scope" in _ph_src) or ("op:" in _ph_src) or ("op-stamp" in _ph_src)) and ("selfkill" not in _ph_src)
            _ph_own = _hx_owned_hot(_crows, culprit)
            _ph_own_pct = float((_ph_own or {}).get("pct") or 0.0)
            if (_ph_hog_pct >= _HX_CPU_STARVE_PCT and _ph_weak
                    and (_ph_own is None or _ph_hog_pct >= _ph_own_pct * _HX_RENDER_RATIO)):
                _ph_owner = str(_ph_co.get("owner"))
                _ph_from = conf
                _anr_scope_suspect = culprit
                conf = "high" if _ph_hog_pct >= 95.0 else "medium"
                _hx_extra.pop("co_culprit", None)
                _hx_extra["cpu_starvation"] = {"owner": _ph_owner, "tid": _ph_co.get("tid"), "name": _ph_co.get("name"), "pct": round(_ph_hog_pct, 1)}
                _hx_extra["starved_scope"] = culprit
                _hx_extra["cv_conf_from"] = _ph_from
                _hx_extra["cv_note"] = "CPU starvation: %s burns %.1f%% CPU on thread %s while the UI thread starves; scope-owner %r only held the op-stamp" % (_ph_owner, _ph_hog_pct, _ph_co.get("name"), culprit)
                culprit = _ph_owner; py_mod = _ph_owner
                src = "anr/cpu-starvation+hog:%s" % (_ph_co.get("name") or "?")
                try: _log("Block#20 +PH: CPU-starvation ANR -> %r monopolizes %.1f%% CPU (tid=%s name=%s); op-stamp owner %r demoted to scope_suspect (conf %s->%s, src=%s)" % (_ph_owner, _ph_hog_pct, _ph_co.get("tid"), _ph_co.get("name"), _anr_scope_suspect, _ph_from, conf, src))
                except Exception: pass
    except Exception as _eph:
        try: _log("Block#20 +PH: cpu-starvation promo err: %r" % _eph)
        except Exception: pass
    try:
        _pm_co = (_hx_extra or {}).get("co_culprit")
        _pm_src = str(src or "")
        if (_pm_co and py_file and culprit and not _anr_scope_suspect
                and not str(culprit).startswith("host")
                and ("blocking-import" not in _pm_src)
                and _pm_co.get("owner") and _pm_co.get("owner") != culprit
                and _b34_instrumentation_owner(_pm_co.get("owner"))):
            _pm_hog_pct = float(_pm_co.get("pct") or 0.0)
            _pm_own = _hx_owned_hot(_crows, culprit)
            _pm_own_pct = float((_pm_own or {}).get("pct") or 0.0)
            _pm_ui_tid = globals().get("_B33_UI_TID")
            _pm_ui_pct = None
            for _pm_r in (_crows or []):
                try:
                    if _pm_ui_tid is not None and _pm_r.get("tid") == _pm_ui_tid:
                        _pm_ui_pct = float(_pm_r.get("pct") or 0.0); break
                except Exception:
                    continue
            _pm_ui_starved = (_pm_ui_pct is None) or (_pm_hog_pct >= _pm_ui_pct * _HX_RENDER_RATIO)
            if (_pm_hog_pct >= _HX_CPU_STARVE_PCT and _pm_ui_starved
                    and (_pm_own is None or _pm_hog_pct >= _pm_own_pct * _HX_RENDER_RATIO)):
                _pm_owner = str(_pm_co.get("owner"))
                _pm_from = conf
                _anr_scope_suspect = culprit
                conf = "high" if _pm_hog_pct >= 95.0 else "medium"
                _hx_extra.pop("co_culprit", None)
                _hx_extra["cpu_starvation"] = {"owner": _pm_owner, "tid": _pm_co.get("tid"), "name": _pm_co.get("name"), "pct": round(_pm_hog_pct, 1), "victim_pyframe": True}
                _hx_extra["starved_scope"] = culprit
                _hx_extra["victim_pyframe"] = {"owner": culprit, "module": py_mod, "file": py_file, "line": py_line}
                if _pm_ui_pct is not None:
                    _hx_extra["ui_thread_pct"] = round(_pm_ui_pct, 1)
                _hx_extra["cv_conf_from"] = _pm_from
                _hx_extra["cv_note"] = "GIL/CPU starvation: instrumentation %s burns %.1f%% CPU on thread %s while the UI thread starves; py-frame owner %r is a victim (no hot thread of its own)" % (_pm_owner, _pm_hog_pct, _pm_co.get("name"), culprit)
                culprit = _pm_owner; py_mod = _pm_owner; py_file = ""; py_line = -1; stack = []
                src = "anr/gil-starvation+hog:%s" % (_pm_co.get("name") or "?")
                try: _log("Block#20 +PM: GIL/CPU-starvation ANR -> instrumentation %r monopolizes %.1f%% CPU (tid=%s name=%s, ui=%s%%); py-frame victim %r demoted to scope_suspect (conf %s->%s, src=%s)" % (_pm_owner, _pm_hog_pct, _pm_co.get("tid"), _pm_co.get("name"), _pm_ui_pct, _anr_scope_suspect, _pm_from, conf, src))
                except Exception: pass
    except Exception as _epm:
        try: _log("Block#20 +PM: gil-starvation promo err: %r" % _epm)
        except Exception: pass
    rec = {"had_anr": True, "event_type": "anr", "dropbox_tag": "data_app_anr", "tombstone_norm_version": 1, "culprit": culprit, "src": src, "confidence": conf, "scope_suspect": _anr_scope_suspect,
           "where": "ui-thread", "stalled_ms": int(waited_ms), "ui_tid": _B20_UI_TID, "ui_tid_linux": globals().get("_B33_UI_TID"),
           "py_module": py_mod, "py_file": py_file, "py_line": py_line,
           "stack": stack,
           "hot_frames": _b42_hot_frames(globals().get("_DN_MIDSTALL_SNAPSHOT")),
           "cpu_top": _crows, "cpu_win_ms": (_cmeta or {}).get("win_ms"), "cpu_age_ms": (_cmeta or {}).get("age_ms"),
           "reason": "UI thread unresponsive > %dms (ANR imminent)" % _B20_TIMEOUT_MS,
           "ts": int(time.time() * 1000)}
    try:
        _storage = _b20_storage_evidence(rec)
        if _storage:
            rec["storage_wait"] = _storage
            rec["nature"] = "synchronous storage call on UI; initiator known, storage-side blocker unknown"
            rec["reason"] += "; UI caller %s is waiting in %s; storage-side blocker not identified" % (_storage["initiator"], _storage["blocked_resource"])
    except Exception as e:
        _log("Block#20 storage evidence err: %s" % e)
    if _sk is not None:
        rec["selfkill_corrob"] = _sk
    if _bi_nature:
        rec["nature"] = _bi_nature
        rec["reason"] = "UI thread unresponsive > %dms (ANR imminent); %s" % (_B20_TIMEOUT_MS, _bi_nature)
    if _hx_extra:
        try: rec.update(_hx_extra)
        except Exception: pass
    try:
        _gc_storm_pct = 25.0
        _mem_corrob_ms = 8000
        _heap_pct = 0.0
        for _hr in (_crows or []):
            try:
                _hn = str(_hr.get("name") or "")
                if ("HeapTaskDaemon" in _hn) or ("GCDaemon" in _hn) or ("HeapTask" in _hn):
                    _hp = float(_hr.get("pct") or 0.0)
                    if _hp > _heap_pct: _heap_pct = _hp
            except Exception:
                continue
        if _heap_pct >= _gc_storm_pct:
            _mpc = {"gc_daemon_cpu_pct": round(_heap_pct, 1)}
            _mp_cl = None
            try: _mp_cl = _recent_client_lowmem(_mem_corrob_ms)
            except Exception: _mp_cl = None
            _mp_oom = None
            try: _mp_oom = _recent_oom_dump(_mem_corrob_ms)
            except Exception: _mp_oom = None
            if _mp_cl: _mpc["client_lowmem"] = _mp_cl
            if _mp_oom:
                _mpc["oom_culprit"] = _mp_oom.get("culprit"); _mpc["oom_rate_mbps"] = _mp_oom.get("rate_mbps"); _mpc["oom_ts"] = _mp_oom.get("ts")
            rec["mem_pressure_corrob"] = _mpc
            if conf == "high": rec["confidence"] = "medium"
            if _mp_oom: _mp_extra = ", OOM-виновник %r rate=%s МБ/с" % (_mpc.get("oom_culprit"), _mpc.get("oom_rate_mbps"))
            elif _mp_cl: _mp_extra = ", client_lowmem trim=%s" % (_mp_cl.get("trim_level"),)
            else: _mp_extra = ""
            rec["reason"] = rec.get("reason", "") + " [+MP: GC-демон %.1f%% CPU в окне ANR%s -> часть UI-стойла = GC-wait/давление памяти; атрибуция плагина не меняется]" % (_heap_pct, _mp_extra)
            try: _log("Block#20 +MP: ANR при активном GC-демоне %.1f%% CPU%s -> mem_pressure_corrob, conf=%s (атрибуция %r сохранена)" % (_heap_pct, (" +OOM" if _mp_oom else (" +client_lowmem" if _mp_cl else "")), rec["confidence"], culprit))
            except Exception: pass
    except Exception as _emp:
        try: _log("Block#20 +MP corroborate err: %r" % _emp)
        except Exception: pass
    _ui_ctx_attach(rec)
    try:
        with _B20_LOCK:
            _persist_anr_fail(rec)
    except Exception as e:
        _log("Block#20: verdict write err: %r" % e)
    if rec.get("storage_wait"):
        _log("ИНИЦИАТОР UI storage-ожидания: %r; ресурс=MessagesStorage.getMessage; storage-side blocker НЕ установлен; stalled=%dms" % (culprit, int(waited_ms)))
    else:
        _log("ВИНОВНИК ANR: %r conf=%s stalled=%dms where=ui-thread tid=%s" % (culprit, conf, int(waited_ms), _B20_UI_TID))
    if py_file:
        _log("  modul: %s:%s" % (py_file, py_line))
    _log("  причина: %s" % rec["reason"])
    try:
        _hf = rec.get("hot_frames") or {}
        if _hf.get("in_python"):
            _log("  горячий кадр: %s%% времени в Python-коде%s%s (%s, %s сэмплов)" % (_hf.get("py_pct"), (" плагина %r" % _hf.get("py_owner")) if _hf.get("py_owner") else "", (", вызван из %s" % _hf.get("top_app_frame")) if _hf.get("top_app_frame") else "", _hf.get("source"), _hf.get("samples")))
        elif _hf.get("top_app_frame"):
            _log("  горячий кадр: %s%% времени на %s (%s, %s сэмплов)" % (_hf.get("top_app_pct"), _hf.get("top_app_frame"), _hf.get("source"), _hf.get("samples")))
    except Exception: pass
    _ucs = _ui_ctx_str(rec.get("ui_ctx"))
    if _ucs: _log("  контекст: %s" % _ucs)

def _b20_loop_native(stop, evfd=-1, seq0=-1):
    global _DN_MIDSTALL_SNAPSHOT
    last_seq = seq0
    if last_seq < 0:
        try: last_seq = int(_NLIB.cd_anr_stall_seq())
        except Exception: last_seq = 0
    if evfd < 0:
        try: evfd = int(_NLIB.cd_anr_eventfd())
        except Exception: evfd = -1
    last_ping = 0.0
    last_beat = 0.0
    _uic_last = 0.0
    _infl_since = None
    _mid = []
    ev = 0
    while not stop.is_set():
        try:
            try: ev |= int(_NLIB.cd_anr_events_take())
            except Exception: pass
            now = time.monotonic()
            try: inflight = int(_NLIB.cd_anr_inflight())
            except Exception: inflight = 1
            if (now - last_ping) * 1000.0 >= _B20_PING_MS and not inflight:
                _b20_post_ping(); last_ping = now
            if (now - last_beat) * 1000.0 >= _B20_BEAT_MS:
                _b20_post_beat(); last_beat = now
            if inflight:
                if _infl_since is None: _infl_since = last_ping if last_ping > 0.0 else now
                if ev & 2:
                    _held = (now - _infl_since) * 1000.0
                    try:
                        _jf, _pn, _cmp = _dn_capture_java_ui_stack()
                        if _jf:
                            _ks = _dn_capture_kernel_state(globals().get("_B33_UI_TID"))
                            _mid.append({"held_ms": _held, "jframes": _jf, "plugin_n": _pn, "component": _cmp, "kernel": _ks, "scope_owner": _dn_live_scope_owner()})
                            if len(_mid) > _DN_MIDSTALL_MAX: _mid = _mid[-_DN_MIDSTALL_MAX:]
                    except Exception: pass
            else:
                _infl_since = None
                if _mid and not (ev & 1): _mid = []
                if (now - _uic_last) * 1000.0 >= _UI_CTX_MS:
                    _uic_last = now
                    try: _ui_ctx_refresh()
                    except Exception: pass
            if ev & 1:
                try: seq = int(_NLIB.cd_anr_stall_seq())
                except Exception: seq = last_seq
                if seq != last_seq:
                    last_seq = seq
                    try: waited = int(_NLIB.cd_anr_stalled_ms())
                    except Exception: waited = _B20_TIMEOUT_MS
                    _DN_MIDSTALL_SNAPSHOT = list(_mid)
                    _gil_begin(_GIL_B20)
                    try:
                        _b20_report_stall(waited)
                    finally:
                        _gil_end(_GIL_B20)
            ev = 0
            _tn = time.monotonic()
            timo = max(0.05, _B20_BEAT_MS / 1000.0 - (_tn - last_beat))
            if not inflight:
                _wp = max(0.05, _B20_PING_MS / 1000.0 - (_tn - last_ping))
                if _wp < timo: timo = _wp
            try:
                if select.select([evfd], [], [], timo)[0]:
                    try: os.read(evfd, 8)
                    except Exception: pass
            except Exception:
                stop.wait(timo)
        except Exception as e:
            try: _log("Block#20 native loop err: %r" % e)
            except Exception: pass
            stop.wait(0.25)

def _b20_start():
    global _B20_THREAD, _B20_NATIVE, _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    if not _B20_ON:
        _log("Block#20: disabled"); return
    if not _b20_setup_handler():
        _log("Block#20: setup failed -> ANR watchdog OFF"); return
    _B20_NATIVE = bool(_ANR_NATIVE_OK and _NLIB is not None)
    if not _B20_NATIVE:
        _log("Block#20: native ANR (cd_anr_start) missing -> watchdog OFF (rebuild .so)"); return
    _B20_STOP.clear()
    _a20fd = -1
    try:
        _a20fd = int(_NLIB.cd_anr_eventfd())
    except Exception:
        _a20fd = -1
    _a20seq0 = -1
    try:
        _a20seq0 = int(_NLIB.cd_anr_stall_seq())
    except Exception:
        _a20seq0 = -1
    try:
        _NLIB.cd_anr_mid_cfg(int(_DN_MIDSTALL_AFTER_MS), int(_DN_MIDSTALL_EVERY_MS))
    except Exception:
        pass
    try:
        rc = int(_NLIB.cd_anr_start(int(_B20_TIMEOUT_MS), int(_B20_MAX_PLAUSIBLE_MS), 250))
    except Exception as e:
        _log("Block#20: cd_anr_start err: %r -> watchdog OFF" % e); return
    if rc < 0:
        _log("Block#20: cd_anr_start rc=%d -> watchdog OFF" % rc); return
    if _B42_ON and _B42_HF_OK:
        try:
            _hrc = int(_NLIB.cd_hf_start(int(_B42_HF_EVERY_MS), int(_B42_HF_START_MS), int(_B42_HF_MAX_MS)))
            _log("Block#42 +TN: native hot-frame sampler rc=%d every=%dms" % (_hrc, _B42_HF_EVERY_MS))
        except Exception as _ehf:
            _log("Block#42 +TN: cd_hf_start err: %r" % _ehf)
    _B20_THREAD = threading.Thread(target=_b20_loop_native, args=(_B20_STOP, _a20fd, _a20seq0), name="culprit-anr", daemon=True)
    _B20_THREAD.start()
    _log("Block#20 ANR watchdog: start ping=%dms timeout=%dms detect=C/native (Tier 2b, event-wake) -> %s" % (
        _B20_PING_MS, _B20_TIMEOUT_MS, _ANR_FILE_NAME))

def _b20_stop():
    global _B20_THREAD, _B20_BEAT_INFLIGHT
    _B20_BEAT_INFLIGHT = False
    try:
        _B20_STOP.set()
        if _NLIB is not None:
            try: _NLIB.cd_anr_event_wake()
            except Exception: pass
        t = _B20_THREAD
        if t is not None: t.join(timeout=2.0)
        if _B42_HF_OK and _NLIB is not None:
            try: _NLIB.cd_hf_stop()
            except Exception: pass
        if _B20_NATIVE and _NLIB is not None:
            try: _NLIB.cd_anr_stop()
            except Exception: pass
        _B20_THREAD = None
        try:
            if _B20_HANDLER is not None: _B20_HANDLER.removeCallbacksAndMessages(None)
        except Exception: pass
        globals()["_B20_PING"] = None; globals()["_B20_BEAT"] = None; globals()["_B20_HANDLER"] = None
        globals()["_B20_BEAT_INFLIGHT"] = False
        _log("Block#20 ANR watchdog: stopped (callbacks cleared)")
    except Exception:
        pass

_WG_TICK_S = 3.0
_WG_CARDS_TTL_S = 15.0
_WG_LABEL_MAX = 30
_WG_NOACT_BACKOFF_S = 9.0
_WG_SKIP_MAX = 1
_WG_LOCK = threading.Lock()
_WG = None

_WG_RUNNABLE_CLS = None
_WG_RUNNABLE_LOCK = threading.Lock()

def _wg_runnable(fn):
    global _WG_RUNNABLE_CLS
    cls = _WG_RUNNABLE_CLS
    if cls is None:
        with _WG_RUNNABLE_LOCK:
            cls = _WG_RUNNABLE_CLS
            if cls is None:
                from java import dynamic_proxy
                _R = find_class("java.lang.Runnable")
                class _WgR(dynamic_proxy(_R)):
                    def __init__(self, _fn):
                        super().__init__()
                        self._fn = _fn
                    def run(self):
                        try:
                            self._fn()
                        except Exception as e:
                            try: _log("Block#36 ui err: %s" % e)
                            except Exception: pass
                cls = _WgR
                _WG_RUNNABLE_CLS = _WgR
    return cls(fn)

_WG_MAIN_HANDLER = None

def _wg_handler():
    global _WG_MAIN_HANDLER
    h = _WG_MAIN_HANDLER
    if h is None:
        with _WG_RUNNABLE_LOCK:
            h = _WG_MAIN_HANDLER
            if h is None:
                Looper = find_class("android.os.Looper")
                Handler = find_class("android.os.Handler")
                h = Handler(Looper.getMainLooper())
                _WG_MAIN_HANDLER = h
    return h

def _wg_run_ui(fn):
    try:
        _wg_handler().post(_wg_runnable(fn))
        return True
    except Exception as e:
        try: _log("Block#36 post err: %s" % e)
        except Exception: pass
        return False

_WG_RENDER_MVEL = """
int p1 = indexOf('|');
int p2 = indexOf('|', p1 + 1);
boolean enabled = substring(0, p1).equals("1");

if (!enabled) {
    if (root.getVisibility() != 8) root.setVisibility(8);
    return true;
}

frag = LaunchActivity.getSafeLastFragment();
if (frag != null && frag.getParentActivity() != null) {
    if (!root.getContext().equals(frag.getParentActivity())) {
        return false;
    }
}
if (!root.isAttachedToWindow()) {
    return false;
}
if (root.getVisibility() != 0) root.setVisibility(0);

par = root.getParent();
if (par != null) {
    int n = par.getChildCount();
    if (n > 0 && !par.getChildAt(n - 1).equals(root)) {
        root.bringToFront();
    }
}

int baseBg = Theme.getColor(key_bg);
bg.setColor((int) ((baseBg & 16777215) | -436207616));

int colorInt = Integer.parseInt(substring(p1 + 1, p2));
tv.setText(substring(p2 + 1));

if (colorInt != 0) {
    tv.setTextColor(colorInt);
    iv.setColorFilter(colorInt);
} else {
    int txtCol = Theme.getColor(key_txt);
    tv.setTextColor(txtCol);
    iv.setColorFilter(txtCol);
}
return true;
"""

_WG_TOUCH_MVEL = """
int a = getActionMasked();

if (a == 0) {
    v.animate().cancel();
    x0 = getRawX();
    y0 = getRawY();
    tx = v.getTranslationX();
    ty = v.getTranslationY();
    par = v.getParent();
    if (par != null) {
        int mw = par.getWidth() - v.getWidth();
        int mh = par.getHeight() - v.getHeight();
        if (mw < 0) mw = 0;
        if (mh < 0) mh = 0;
        maxX = (float) mw;
        maxY = (float) mh;
    } else {
        maxX = 10000f;
        maxY = 10000f;
    }
    moved = false;
    menu_shown = false;
    v.postDelayed(lp_run, lpt);
    return "";
}

if (a == 2) {
    float dx = getRawX() - x0;
    float dy = getRawY() - y0;
    if (!moved && (dx > slop || dx < (0 - slop) || dy > slop || dy < (0 - slop))) {
        moved = true;
        v.removeCallbacks(lp_run);
    }
    if (moved && !menu_shown) {
        float nx = tx + dx;
        float ny = ty + dy;
        if (nx > maxX) nx = maxX;
        if (nx < 0) nx = nx * 0;
        if (ny > maxY) ny = maxY;
        if (ny < 0) ny = ny * 0;
        v.setTranslationX((float) nx);
        v.setTranslationY((float) ny);
    }
    return "";
}

if (a == 1 || a == 3) {
    v.removeCallbacks(lp_run);
    if (menu_shown) {
        return (a == 1) ? "M" : "";
    } else if (moved) {
        float curX = v.getTranslationX();
        float curY = v.getTranslationY();
        float parentW = maxX + v.getWidth();
        float center = curX + v.getWidth() / 2f;
        float leftEdge = edgeMargin;
        if (leftEdge > maxX) leftEdge = maxX;
        float rightEdge = maxX - edgeMargin;
        if (rightEdge < leftEdge) rightEdge = leftEdge;
        float targetX = (center <= parentW / 2f) ? leftEdge : rightEdge;
        v.animate().translationX((float) targetX).setDuration(200).start();
        return ((int) targetX) + "," + ((int) curY);
    } else if (a == 1) {
        return "C";
    }
}
return "";
"""

_WG_MVEL_FN = None
_WG_MVEL_TRIED = False

def _wg_mvel():
    global _WG_MVEL_FN, _WG_MVEL_TRIED
    if _WG_MVEL_TRIED:
        return _WG_MVEL_FN
    _WG_MVEL_TRIED = True
    try:
        from elyx import mvel_execute
        _WG_MVEL_FN = mvel_execute
    except Exception as e:
        _WG_MVEL_FN = None
        try: _log("Block#36 +VV: elyx.mvel_execute недоступен (%s) -> виджет не работает" % e)
        except Exception: pass
    return _WG_MVEL_FN

_WG_TOUCH_CLS = None

def _wg_touch_proxy(fn):
    global _WG_TOUCH_CLS
    cls = _WG_TOUCH_CLS
    if cls is None:
        with _WG_RUNNABLE_LOCK:
            cls = _WG_TOUCH_CLS
            if cls is None:
                from java import dynamic_proxy
                _L = find_class("android.view.View$OnTouchListener")
                class _WgTouchL(dynamic_proxy(_L)):
                    def __init__(self, _fn):
                        super().__init__()
                        self._fn = _fn
                    def onTouch(self, v, ev):
                        try:
                            return bool(self._fn(v, ev))
                        except Exception as e:
                            try: _log("Block#36 touch err: %s" % e)
                            except Exception: pass
                        return False
                cls = _WgTouchL
                _WG_TOUCH_CLS = _WgTouchL
    return cls(fn)

class _CdWidget:
    def __init__(self, plugin):
        self.plugin = plugin
        self.root = None; self.tv = None; self.iv = None
        self._bg = None; self._listener = None
        self._stop = threading.Event()
        self._lock = threading.Lock()
        self._worker = None
        self._cards = []
        self._cards_ts = 0.0
        self._rot = 0
        self._menu = None
        self._menu_gen = 0
        self._menu_heal_run = None
        self._drag_st = None
        self._backoff_until = 0.0
        self._dlg_lock = threading.Lock()
        self._dlg_inflight = False
        self._dialog = None
        self._touch_state = None
        self._render_ctx = None
        self._clamp_run = None
        self.build_gen = 0
        self._last_key = None
        self._skip_n = 0
        self._mvel_err_logged = False

    def _dp(self, v):
        try:
            AndroidUtilities = find_class("org.telegram.messenger.AndroidUtilities")
            return int(AndroidUtilities.dp(float(v)))
        except Exception:
            return int(v * 3)

    def _activity(self):
        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            fragment = LaunchActivity.getSafeLastFragment()
            if fragment is not None:
                return fragment.getParentActivity()
        except Exception:
            pass
        return None

    def start(self):
        with self._lock:
            if self._worker is not None and self._worker.is_alive():
                return
            ev = threading.Event()
            self._stop = ev
            self._worker = threading.Thread(target=self._loop, args=(ev,), name="culprit-widget", daemon=True)
            self._worker.start()

    def stop(self, join_s=2.0):
        self._stop.set()
        t = self._worker
        if t is not None and join_s > 0:
            try:
                t.join(timeout=join_s)
                if t.is_alive():
                    _log("Block#36: worker stop timeout")
            except Exception: pass
        self._worker = None
        _wg_run_ui(self.remove)

    def _loop(self, ev):
        while not ev.wait(_WG_TICK_S):
            try:
                if not bool(self.plugin.get_setting("widget_on", False)):
                    continue
                now = time.monotonic()
                if now < self._backoff_until:
                    continue
                if now - self._cards_ts >= _WG_CARDS_TTL_S:
                    try:
                        self._cards = list(self.plugin._ui_collect_culprits() or [])
                    except Exception as e:
                        _log("Block#36 collect err: %s" % e)
                    self._cards_ts = now
                if ev.is_set():
                    break
                self._rot += 1
                payload = self._payload()
                _wg_run_ui(lambda p=payload: self._ui_tick(p))
            except Exception as e:
                try: _log("Block#36 loop err: %s" % e)
                except Exception: pass

    def _ui_tick(self, payload=None):
        if self._stop.is_set():
            return
        _d = self._dialog
        if _d is not None:
            try:
                if not _d.isShowing():
                    if self._dialog is _d:
                        self._dialog = None
            except Exception:
                if self._dialog is _d:
                    self._dialog = None
        if self.root is None:
            if self._activity() is None:
                self._backoff_until = time.monotonic() + _WG_NOACT_BACKOFF_S
                return
            self.ensure()
            if self.root is None:
                return
        self._backoff_until = 0.0
        self._render_payload(payload if payload is not None else self._payload())

    def ensure(self):
        try:
            act = self._activity()
            if act is None:
                return
            if self.root is not None:
                try:
                    same_ctx = bool(self.root.getContext().equals(act))
                except Exception:
                    same_ctx = False
                if not same_ctx:
                    self.remove(); self._build(act); return
                if self.root.isAttachedToWindow():
                    return
                parent = self.root.getParent()
                if parent is not None:
                    parent.removeView(self.root)
                self._attach(act)
                return
            self._build(act)
        except Exception as e:
            _log("Block#36 ensure err: %s" % e)

    def _build(self, act):
        LinearLayout = find_class("android.widget.LinearLayout")
        TextView = find_class("android.widget.TextView")
        ImageView = find_class("android.widget.ImageView")
        GradientDrawable = find_class("android.graphics.drawable.GradientDrawable")
        LLP = find_class("android.widget.LinearLayout$LayoutParams")
        root = LinearLayout(act)
        root.setOrientation(0)
        root.setGravity(16)
        root.setPadding(self._dp(10), self._dp(5), self._dp(10), self._dp(5))
        bg = GradientDrawable()
        bg.setCornerRadius(float(self._dp(16)))
        root.setBackground(bg)
        self._bg = bg
        try: root.setElevation(float(self._dp(8)))
        except Exception: pass
        iv = ImageView(act)
        try:
            ctx = act.getApplicationContext()
            res = ctx.getResources()
            icon_res = res.getIdentifier("msg_report", "drawable", ctx.getPackageName())
            if icon_res: iv.setImageResource(icon_res)
        except Exception: pass
        ilp = LLP(self._dp(14), self._dp(14))
        ilp.rightMargin = self._dp(6)
        root.addView(iv, ilp)
        tv = TextView(act)
        tv.setTextSize(12.0)
        try:
            Typeface = find_class("android.graphics.Typeface")
            tv.setTypeface(Typeface.DEFAULT_BOLD)
        except Exception: pass
        tv.setSingleLine(False)
        try:
            screen_w = int(act.getResources().getDisplayMetrics().widthPixels)
            tv.setMaxWidth(max(self._dp(120), min(self._dp(300), screen_w - self._dp(56))))
        except Exception: tv.setMaxWidth(self._dp(300))
        tv.setText("…")
        root.addView(tv)
        self.root, self.tv, self.iv = (root, tv, iv)
        self._render_ctx = None
        try:
            Theme = find_class("org.telegram.ui.ActionBar.Theme")
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            rctx = jclass("java.util.HashMap")()
            rctx.put("root", root)
            rctx.put("bg", bg)
            rctx.put("tv", tv)
            rctx.put("iv", iv)
            rctx.put("Theme", Theme)
            rctx.put("LaunchActivity", LaunchActivity)
            rctx.put("key_bg", Theme.key_windowBackgroundWhite)
            rctx.put("key_txt", Theme.key_windowBackgroundWhiteBlackText)
            self._render_ctx = rctx
        except Exception as e:
            _log("Block#36 +VV: render ctx err: %s" % e)
        self.build_gen += 1
        self._last_key = None
        self._skip_n = 0
        self._clamp_run = _wg_runnable(self._clamp)
        self.sync_theme()
        if not bool(self.plugin.get_setting("widget_on", False)):
            root.setVisibility(8)
        self._listener = self._make_drag_listener()
        root.setOnTouchListener(self._listener)
        self._attach(act)
        self._render_payload(self._payload(), heal=False)

    def _attach(self, act):
        FLP = find_class("android.widget.FrameLayout$LayoutParams")
        decor = act.getWindow().getDecorView()
        lp = FLP(-2, -2)
        lp.gravity = 51
        lp.leftMargin = 0
        lp.topMargin = 0
        try:
            x = int(str(self.plugin.get_setting("wg_x", str(self._dp(8)))))
            y = int(str(self.plugin.get_setting("wg_y", str(self._dp(96)))))
        except Exception:
            x, y = (self._dp(8), self._dp(96))
        self.root.setTranslationX(float(max(0, x)))
        self.root.setTranslationY(float(max(0, y)))
        decor.addView(self.root, lp)
        try: self.root.bringToFront()
        except Exception: pass
        try:
            if self._clamp_run is not None:
                self.root.post(self._clamp_run)
        except Exception: pass

    def _clamp(self):
        try:
            rv = self.root
            if rv is None: return
            par = rv.getParent()
            if par is None: return
            w = int(par.getWidth()); h = int(par.getHeight())
            if w <= 0 or h <= 0: return
            cur_x = float(rv.getTranslationX()); cur_y = float(rv.getTranslationY())
            nx = max(0.0, min(float(w - int(rv.getWidth())), cur_x))
            ny = max(0.0, min(float(h - int(rv.getHeight())), cur_y))
            if nx != cur_x: rv.setTranslationX(nx)
            if ny != cur_y: rv.setTranslationY(ny)
        except Exception:
            pass

    def _dismiss_menu(self):
        self._cancel_menu_heal()
        try:
            if self._menu is not None:
                self._menu.dismiss()
        except Exception:
            pass
        self._menu = None

    def remove(self):
        self._dismiss_menu()
        try:
            if self._dialog is not None:
                self._dialog.dismiss()
        except Exception:
            pass
        self._dialog = None
        root = self.root
        st = self._touch_state
        cr = self._clamp_run
        try:
            if root is not None and st is not None:
                lp = st.get("lp_run")
                if lp is not None:
                    try: root.removeCallbacks(lp)
                    except Exception: pass
        except Exception:
            pass
        try:
            if root is not None and cr is not None:
                root.removeCallbacks(cr)
        except Exception:
            pass
        try:
            if root is not None:
                root.setOnTouchListener(None)
        except Exception:
            pass
        try:
            if root is not None:
                parent = root.getParent()
                if parent is not None:
                    parent.removeView(root)
        except Exception:
            pass
        rc = self._render_ctx
        self._touch_state = None
        self._render_ctx = None
        self._clamp_run = None
        self._listener = None
        for _m in (st, rc):
            if _m is not None:
                try: _m.clear()
                except Exception: pass
        self._last_key = None
        self._skip_n = 0
        self.root = None; self.tv = None; self.iv = None; self._bg = None

    def sync_theme(self):
        try:
            if self._bg is None: return
            Theme = find_class("org.telegram.ui.ActionBar.Theme")
            base = int(Theme.getColor(Theme.key_windowBackgroundWhite))
            c = (base & 16777215) | (230 << 24)
            c &= 4294967295
            if c >= 2147483648: c -= 4294967296
            from java import jint
            self._bg.setColor(jint(c))
        except Exception:
            pass

    def _items(self):
        current = [c for c in self._cards if c.get("event_scope") == "current"]
        history_n = len(self._cards) - len(current)
        if not current:
            clean = self.plugin._t("✅ В этом процессе событий нет")
            if history_n:
                clean += "\n" + self.plugin._t("История: %d · открыть список") % history_n
            return [clean]
        items = [self.plugin._t("Текущих: %d · история: %d") % (len(current), history_n)]
        for c in current[:10]:
            label = ("%s %s" % (c.get("emoji", ""), c.get("label", "-"))).strip()
            items.append("%s\n%s\n%s" % (
                label, self.plugin._t(c.get("actor_label") if c.get("actor_label") not in (None, "Виноват: %s") else "Владелец: %s") % c.get("culprit", "?"),
                self.plugin._ui_when(c.get("ts"))))
        return items

    def _color_int(self):
        cards = self._cards
        if any(c.get("event_scope") == "current" and c.get("alert_level", "alarm") == "alarm" for c in cards):
            return -769226
        if any(c.get("event_scope") == "current" and c.get("alert_level") == "warning" for c in cards):
            return -26624
        return 0

    def _payload(self):
        enabled = 1 if bool(self.plugin.get_setting("widget_on", False)) else 0
        items = self._items()
        return "%d|%d|%s" % (enabled, self._color_int(), items[self._rot % len(items)])

    def _mvel_frame(self, payload):
        ctx = self._render_ctx
        if ctx is None:
            return True
        fn = _wg_mvel()
        if fn is None:
            return True
        key = (self.build_gen, payload)
        if key == self._last_key and self._skip_n < _WG_SKIP_MAX:
            self._skip_n += 1
            return True
        self._skip_n = 0
        try:
            ok = fn(_WG_RENDER_MVEL, ctx, java_instance=payload)
        except Exception as e:
            if not self._mvel_err_logged:
                self._mvel_err_logged = True
                _log("Block#36 +VV: MVEL render failed: %s" % e)
            return True
        if not ok:
            self._last_key = None
            return False
        changed = (key != self._last_key)
        self._last_key = key
        if changed:
            self._post_clamp()
        return True

    def _post_clamp(self):
        try:
            if self.root is not None and self._clamp_run is not None:
                self.root.post(self._clamp_run)
        except Exception:
            pass

    def _render_payload(self, payload, heal=True):
        try:
            if self.root is None:
                return
            if self._mvel_frame(payload):
                return
            if not heal:
                return
            if self._activity() is None:
                self._backoff_until = time.monotonic() + _WG_NOACT_BACKOFF_S
                return
            self.ensure()
            if self.root is not None:
                self._mvel_frame(payload)
        except Exception as e:
            _log("Block#36 render err: %s" % e)

    def render(self):
        try:
            if self.root is None or self.tv is None:
                return
            self._render_payload(self._payload())
        except Exception as e:
            _log("Block#36 render err: %s" % e)

    def _make_drag_listener(self):
        plugin = self.plugin
        wg = self
        st = jclass("java.util.HashMap")()
        self._touch_state = st
        st.put("v", self.root)
        st.put("x0", 0.0)
        st.put("y0", 0.0)
        st.put("tx", 0.0)
        st.put("ty", 0.0)
        st.put("maxX", 10000.0)
        st.put("maxY", 10000.0)
        st.put("moved", False)
        st.put("menu_shown", False)
        st.put("edgeMargin", float(self._dp(8)))
        try:
            VC = find_class("android.view.ViewConfiguration").get(self.root.getContext())
            st.put("slop", int(VC.getScaledTouchSlop()))
            st.put("lpt", int(VC.getLongPressTimeout()))
        except Exception:
            st.put("slop", 24)
            st.put("lpt", 450)

        def _trigger_long_press():
            if not st.get("moved") and not st.get("menu_shown"):
                st.put("menu_shown", True)
                try:
                    if wg.root is not None:
                        wg.root.performHapticFeedback(0)
                except Exception:
                    pass

        lp_run = _wg_runnable(_trigger_long_press)
        st.put("lp_run", lp_run)
        def dispatch(res, v):
            if res == "M":
                wg.show_menu(v)
            elif res == "C":
                wg._rot += 1
                wg.render()
            elif "," in res:
                try:
                    sx, sy = res.split(",")
                    plugin.set_setting("wg_x", sx)
                    plugin.set_setting("wg_y", sy)
                except Exception:
                    pass

        err = {"logged": False, "ok": False}

        def on_touch(v, ev):
            fn = _wg_mvel()
            if fn is None:
                return False
            try:
                res = str(fn(_WG_TOUCH_MVEL, st, java_instance=ev) or "")
            except Exception as e:
                if not err["logged"]:
                    err["logged"] = True
                    _log("Block#36 +VV: touch MVEL failed: %s" % e)
                return False
            if not err["ok"]:
                err["ok"] = True
                _log("Block#36 +VV: touch MVEL ok")
            try:
                dispatch(res, v)
            except Exception as e:
                try: _log("Block#36 touch err: %s" % e)
                except Exception: pass
            return True

        return _wg_touch_proxy(on_touch)

    def _cancel_menu_heal(self):
        self._menu_gen += 1
        pending = self._menu_heal_run
        self._menu_heal_run = None
        if pending is not None and self.root is not None:
            try: self.root.removeCallbacks(pending)
            except Exception: pass

    def _menu_diag(self, view):
        self._cancel_menu_heal()
        if view is not self.root or view is None or self._stop.is_set():
            return
        gen = self._menu_gen
        started = time.monotonic()
        state = {"lost": False, "healed": False}
        def tick():
            if gen != self._menu_gen or self.root is not view or self._stop.is_set():
                return
            try:
                if not self.plugin.get_setting("widget_on", False) or not view.isAttachedToWindow():
                    self._cancel_menu_heal()
                    return
                elapsed = time.monotonic() - started
                if elapsed >= 60.0:
                    self._cancel_menu_heal()
                    return
                focused = bool(view.hasWindowFocus())
                if not focused:
                    state["lost"] = True
                elif not state["healed"] and (state["lost"] or elapsed >= 3.0):
                    state["healed"] = True
                    self._menu_heal_run = None
                    self._heal_after_menu("focus back" if state["lost"] else "timeout, focus not taken")
                    return
                pending = self._menu_heal_run
                if pending is not None and not view.postDelayed(pending, 150):
                    self._cancel_menu_heal()
            except Exception as e:
                self._cancel_menu_heal()
                try: _log("Block#36 +VY: menu focus wait failed: %s" % e)
                except Exception: pass
        self._menu_heal_run = _wg_runnable(tick)
        try:
            if not view.postDelayed(self._menu_heal_run, 150):
                self._cancel_menu_heal()
        except Exception:
            self._cancel_menu_heal()

    def _heal_after_menu(self, why):
        root = self.root
        if root is None or self._listener is None or self._stop.is_set():
            return
        if not self.plugin.get_setting("widget_on", False):
            return
        for fn in (lambda: root.setEnabled(True), lambda: root.setVisibility(0),
                   lambda: root.setAlpha(1.0), lambda: root.setScaleX(1.0), lambda: root.setScaleY(1.0),
                   lambda: root.getParent().requestDisallowInterceptTouchEvent(False),
                   lambda: root.cancelPendingInputEvents(),
                   lambda: root.setOnTouchListener(self._listener)):
            try: fn()
            except Exception: pass
        try:
            parent = root.getParent()
            n = int(parent.getChildCount())
            if n > 0 and not bool(parent.getChildAt(n - 1).equals(root)):
                root.bringToFront()
        except Exception: pass
        try:
            st = self._touch_state
            if st is not None:
                pending = st.get("lp_run")
                if pending is not None:
                    root.removeCallbacks(pending)
                st.put("menu_shown", False)
                st.put("moved", False)
        except Exception: pass
        _log("Block#36 +VY: menu: heal applied (%s)" % why)


    def show_menu(self, view):
        try:
            self._dismiss_menu()
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            fragment = LaunchActivity.getSafeLastFragment()
            if not fragment:
                return
            try:
                ItemOptions = find_class("org.telegram.ui.Components.ItemOptions")
            except Exception:
                ItemOptions = None
            if ItemOptions is None:
                self.show_all(); return
            from java import jint
            ApplicationLoader = find_class("org.telegram.messenger.ApplicationLoader")
            ctx = ApplicationLoader.applicationContext
            res = ctx.getResources(); pkg = ctx.getPackageName()
            def _icon(name):
                try: return res.getIdentifier(name, "drawable", pkg)
                except Exception: return 0
            options = ItemOptions.makeOptions(fragment, view)
            options.add(jint(_icon("msg_report")), self.plugin._t("Показать всех виновников"), _wg_runnable(self.show_all))
            options.add(jint(_icon("msg_settings")), self.plugin._t("Открыть настройки"), _wg_runnable(self.open_settings))
            self._menu = options
            options.setDrawScrim(False).setDimAlpha(jint(0)).show()
            self._menu_diag(view)
        except Exception as e:
            _log("Block#36 menu err: %s" % e)

    def show_all(self):
        wg = self
        with self._dlg_lock:
            if self._dlg_inflight:
                return
            self._dlg_inflight = True
        def work():
            try:
                if wg._stop.is_set():
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
                    return
                cards = list(wg.plugin._ui_collect_culprits() or [])
                wg._cards = cards; wg._cards_ts = time.monotonic()
                lines = []
                _current_n = sum(c.get("event_scope") == "current" for c in cards)
                lines.append(wg.plugin._t("Текущие события: %d · исторические: %d") % (_current_n, len(cards) - _current_n))
                lines.append(wg.plugin._t("История не означает зависание сейчас."))
                lines.append("")
                if not cards:
                    lines.append(wg.plugin._t("✅ Чисто — виновники не найдены"))
                _group = None
                for i, c in enumerate(cards[:50], 1):
                    if c.get("event_scope") != _group:
                        _group = c.get("event_scope")
                        lines.append(wg.plugin._t("Текущий процесс" if _group == "current" else "История"))
                    lines.append("[%d] %s %s" % (i, c.get("emoji", ""), c.get("label", "-")))
                    lines.append("  " + wg.plugin._t(c.get("actor_label", "Виноват: %s")) % c.get("culprit", "?"))
                    if c.get("reason"):
                        lines.append(wg.plugin._t("  Что случилось: %s") % c["reason"])
                    lines.append(wg.plugin._t("  Когда: %s") % wg.plugin._ui_when(c.get("ts", 0)))
                    lines.append(wg.plugin._t("  Уверенность: %s") % c.get("conf", "?"))
                    if c.get("where"):
                        lines.append(wg.plugin._t("  Где: %s") % c["where"])
                    lines.append("")
                text = "\n".join(lines)
            except Exception as e:
                text = "err: %s" % e
            def ui():
                try:
                    if wg._stop.is_set():
                        return
                    from java import jint
                    LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
                    fragment = LaunchActivity.getSafeLastFragment()
                    if not fragment:
                        return
                    act = fragment.getParentActivity()
                    Builder = find_class("org.telegram.ui.ActionBar.AlertDialog$Builder")
                    b = Builder(act)
                    b.setTitle(wg.plugin._t("Показать всех виновников"))
                    try:
                        TextView = find_class("android.widget.TextView")
                        ScrollView = find_class("android.widget.ScrollView")
                        tv = TextView(act)
                        tv.setText(text)
                        tv.setTextSize(13.0)
                        try:
                            Theme = find_class("org.telegram.ui.ActionBar.Theme")
                            tv.setTextColor(jint(Theme.getColor(Theme.key_dialogTextBlack)))
                        except Exception: pass
                        pad = wg._dp(16)
                        tv.setPadding(pad, pad, pad, pad)
                        sv = ScrollView(act)
                        sv.addView(tv)
                        b.setView(sv)
                    except Exception:
                        b.setMessage(text)
                    try: b.setPositiveButton(wg.plugin._t("Закрыть"), None)
                    except Exception: pass
                    dlg = b.create()
                    _old_dlg = wg._dialog
                    wg._dialog = None
                    if _old_dlg is not None:
                        try: _old_dlg.dismiss()
                        except Exception: pass
                    wg._dialog = dlg
                    fragment.showDialog(dlg)
                except Exception as e:
                    _log("Block#36 dialog err: %s" % e)
                finally:
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
            _posted = False
            try:
                if not wg._stop.is_set():
                    _posted = bool(_wg_run_ui(ui))
            finally:
                if not _posted:
                    with wg._dlg_lock:
                        wg._dlg_inflight = False
        try:
            threading.Thread(target=work, name="culprit-widget-dlg", daemon=True).start()
        except Exception:
            with wg._dlg_lock:
                wg._dlg_inflight = False

    def open_settings(self):
        try:
            from client_utils import get_last_fragment
            from com.exteragram.messenger.plugins import PluginsController
            PluginSettingsActivity = find_class("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
            controller = PluginsController.getInstance()
            plugins_map = getattr(controller, "plugins", None)
            java_plugin = plugins_map.get(__id__) if plugins_map else None
            if java_plugin:
                frag = get_last_fragment()
                if frag:
                    frag.presentFragment(PluginSettingsActivity(java_plugin))
        except Exception as e:
            _log("Block#36 settings err: %s" % e)

def _wg_start(plugin):
    global _WG
    try:
        if not bool(plugin.get_setting("widget_on", False)):
            return
    except Exception:
        pass
    with _WG_LOCK:
        if _WG is None:
            globals()["_WG"] = _CdWidget(plugin)
        w = _WG
    w.start()
    _wg_run_ui(w.ensure)
    _log("Block#36: overlay widget started")

def _wg_stop(join_s=2.0):
    global _WG
    with _WG_LOCK:
        w = _WG
        globals()["_WG"] = None
    if w is not None:
        try: w.stop(join_s=join_s)
        except Exception: pass
        _log("Block#36: overlay widget stopped")

class Plugin(BasePlugin):
    def _install_invasive_hooks(self):
        if globals().get("_SAFE_MODE"):
            _log("Safe-mode (+QH): invasive inline/JNI hooks skipped (dex/view/gref/bitmap/gpu/anim/mvel/binder/camera/mediacodec/gl/looper)")
            return
        self._install_b24_dexhook(); self._install_b27_view_hook(); self._install_b28c_proxy_hook(); self._install_b43_screen_hooks()

    def on_plugin_load(self):
        try:
            _DEX.load()
            _DEX.call("pyInit", True, True, 500)
            _log("MaxTrace: DEX layer (Thread-attribution, UI Watchdog, Screen leaks) activated")
        except Exception as _edex:
            _log(f"MaxTrace: DEX init error: {_edex}")
        globals()["_CP_LIFECYCLE"] = "loading"
        global _CRUMB
        _ui_process_start()
