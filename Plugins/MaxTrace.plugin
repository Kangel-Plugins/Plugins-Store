    except Exception: pass
    try:
        if ("PyObject is closed" in (exc_msg or "")) and rec.get("cause") is None:
            _zjp = None
            for _f in (frames or []):
                if _f.startswith("$Proxy"):
                    _zjp = _f; break
            _zjh = any(("PyInvocationHandler" in _f) or ("java.lang.reflect.Proxy.invoke" in _f) for _f in (frames or []))
            if _zjp and _zjh:
                _zjcls, _zjdot, _zjm = _zjp.rpartition(".")
                rec["cause"] = "zombie_java_proxy_listener"
                rec["proxy_class"] = _zjcls or _zjp
                rec["proxy_method"] = (_zjm if _zjdot else None)
                _zjo, _zjc, _zjs = _orphan_proxy_owner(_zjcls or _zjp, crash_ts)
                _zjcur = rec.get("crashed_plugin_id")
                _zjtidm = (rec.get("src") == "tid" and str(tname or "").strip().lower().startswith("main"))
                if _zjtidm: rec["tid_candidate"] = _zjcur
                _zjweak = (rec.get("confidence") in (None, "low", "none")) or (not _zjcur) or (_zjcur == "unknown") or _zjtidm or (isinstance(_zjcur, str) and _zjcur.startswith("$Proxy")) or (rec.get("src") in ("stack-pkg", "breadcrumb", "none"))
                if _zjo:
                    rec["reason"] = "зомби Java-proxy слушатель: плагин выгружен/перезагружен (PyObject closed), java.lang.reflect.Proxy остался зарегистрирован у хоста (%s; владелец: %s)" % (_zjp, _zjo)
                    if _zjweak:
