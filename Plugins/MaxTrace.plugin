                except Exception as exc:
                    gaps.append(n + ":" + type(exc).__name__)
            self.life_schemas[name] = (fields, gaps)
        fields, missing = self.life_schemas[name]
                                                                               
                                                                                 
        attempts = self.life_mask_attempts.get(name, 0)
        if not missing and name not in self.life_masks and (attempts == 0 or (retry_projection and attempts < 3)):
            self.life_mask_attempts[name] = attempts + 1
