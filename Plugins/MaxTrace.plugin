            _te = {k: _tx.get(k) for k in ("state", "kind", "sig", "code", "core", "realtime_ms", "mono_ms", "pid", "captures", "signals", "cpu_ms", "logcat_snapshots") if _tx.get(k) is not None}
            _st = _tx.get("state")
            _te["interpretation"] = {
                "exit": "supervisor outlived the client long enough to record the kernel wait status of its death",
                "alive": "supervisor was killed (with the client's process group) before it could witness the death",
                "lost": "supervisor lost the tracee without a wait status",
                "throttled": "supervisor had stopped itself earlier (cpu budget); the death was not observed",
            }.get(_st, "unknown")
            v["tracer_exit"] = _te
        _tl = globals().get("_PREV_SESSION_TRACER_LOGCAT")
        if isinstance(_tl, dict) and _tl.get("sections"):
            _secs = [x for x in _tl["sections"] if (not v.get("exit_pid")) or str(x.get("pid")) == str(v.get("exit_pid"))]
            if _secs:
                _rt = (v.get("tracer_ref") or {}).get("realtime_ms")
                try:
                    _sec = min(_secs, key=lambda x: abs(int(x.get("realtime_ms") or 0) - int(_rt))) if _rt else _secs[-1]
                except Exception:
                    _sec = _secs[-1]
                v["tracer_logcat_snapshot"] = {"file": _tl.get("file"), "file_bytes": _tl.get("bytes"),
                    "section": {k: _sec.get(k) for k in ("capture_idx", "realtime_ms", "pid", "tid", "sig", "lines", "budget_ms", "n_lines", "end_flags", "end_bytes", "end_elapsed_ms")}}
    except Exception as _ews:
        _log("  +WV tracer exit/logcat attach err: %r" % (_ews,))
