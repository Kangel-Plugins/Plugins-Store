        Input(key="ai_base_url", text="адрес сервиса", default=AI_DEFAULT_URL, subtext="менять не нужно"),
        Input(key="ai_model", text="модель", default=AI_DEFAULT_MODEL),
        Input(key="ai_request", text="что должна делать команда", default="",
              subtext="пример: команда g - ищет в интернете то, что я напишу. "
                      "или: команда lin - присылает случайное фото"),
        Text(text="создать команду", icon="msg_add", accent=True,
             on_click=lambda view: plugin.start_generation()),
    ]


def manual_page(plugin):
    items = [
        Header(text="сделать самостоятельно"),
        Input(key="man_name", text="имя команды", default="",
              subtext="только буквы, без точки, до 20 знаков"),
        Input(key="man_desc", text="описание", default=""),
        Input(key="man_usage", text="что писать после команды", default="", subtext="например: [запрос]"),
    ]
    if Switch is not None:
        items.append(Switch(key="man_needs", text="без текста не работает", default=False))
    items.extend([
        Divider(text="что делает команда (хватит одного поля, несколько значений - через ;;)"),
        Input(key="man_replies", text="ответ", default="",
              subtext="можно {args} {rand:1-100} {pick:а|б}"),
        Input(key="man_links", text="ссылка в сообщение", default=""),
        Input(key="man_photos", text="фото", default="", subtext="прямая ссылка на картинку"),
        Input(key="man_files", text="файл", default="", subtext="прямая ссылка на файл"),
        Input(key="man_open", text="открыть сайт", default="", subtext="например: https://www.google.com/search?q={q}"),
        Input(key="man_ai", text="задание для ии", default="",
              subtext="например: ответь на вопрос коротко. ии получит текст после команды"),
    ])
    if Switch is not None:
        items.append(Switch(key="man_web", text="ии ищет в интернете", default=False))
    items.extend([
        Text(text="создать команду", icon="msg_add", accent=True,
             on_click=lambda view: plugin.create_manual()),
        Text(text="очистить поля", icon="msg_delete", red=True,
             on_click=lambda view: plugin.clear_manual()),
    ])
    return items


def shop_page(plugin):
    items = [
        Header(text="магазин команд"),
        Text(text="установить все", subtext="добавить все команды из магазина", icon="msg_add", accent=True,
             on_click=lambda view: plugin.install_all()),
    ]
    last_group = None
    for group, spec in SHOP:
        if group != last_group:
            items.append(Divider(text=group))
            last_group = group
        installed = spec["name"] in CUSTOM
        items.append(Text(
            text="." + spec["name"] + ("  ✓" if installed else ""),
            subtext=spec["description"],
            icon="msg_info" if installed else "msg_add",
            on_click=lambda view, n=spec["name"]: plugin.install_shop(n),
        ))
    return items


def custom_command_page(plugin, name):
    spec = CUSTOM.get(name)
    if not spec:
        return [Header(text="мои команды"), Text(text="команда не найдена", icon="msg_error")]

    count = int(plugin.get_setting("custom_edit_count_" + name, len(spec["replies"])) or 0)
    count = max(0, min(count, MAX_REPLIES))
    items = [
        Header(text="команда ." + name),
        Input(key="custom_edit_description_" + name, text="описание", default=spec["description"]),
        Input(key="custom_edit_usage_" + name, text="что писать после команды", default=spec["usage"]),
    ]
    if Switch is not None:
        items.append(Switch(key="custom_edit_needs_" + name, text="без текста не работает", default=spec["needs_args"]))
    items.extend([
        Divider(text="ссылки (несколько - через ;;)"),
        Input(key="custom_edit_links_" + name, text="ссылка в сообщение", default=join_list(spec["links"])),
        Input(key="custom_edit_photos_" + name, text="фото", default=join_list(spec["photos"])),
        Input(key="custom_edit_files_" + name, text="файл", default=join_list(spec["files"])),
        Input(key="custom_edit_open_" + name, text="открыть сайт", default=join_list(spec["open"])),
        Divider(text="ии"),
        Input(key="custom_edit_ai_" + name, text="задание для ии", default=spec["ai"]),
    ])
    if Switch is not None:
        items.append(Switch(key="custom_edit_web_" + name, text="ии ищет в интернете", default=spec["web"]))
    if spec["code"]:
        items.append(Text(text="у команды есть программа", icon="msg_info",
                          subtext="она не меняется здесь. чтобы изменить, создай команду заново"))
    items.append(Divider(text="тексты ответа (выбирается случайный)"))
    for index in range(count):
        default_reply = spec["replies"][index] if index < len(spec["replies"]) else ""
        items.append(Input(key="custom_edit_reply_" + name + "_" + str(index),
                           text="ответ " + str(index + 1), default=default_reply))
        items.append(Text(text="удалить ответ " + str(index + 1), icon="msg_delete", red=True,
                          on_click=lambda view, i=index: plugin.remove_custom_reply(name, i)))
    items.extend([
        Text(text="добавить ответ", icon="msg_add", accent=True,
             on_click=lambda view: plugin.add_custom_reply(name)),
        Text(text="сохранить изменения", icon="msg_save", accent=True,
             on_click=lambda view: plugin.save_custom_edits(name)),
        Text(text="скопировать команду", subtext="чтобы отправить другу", icon="msg_arrow_forward",
             on_click=lambda view: plugin.export_clipboard(name)),
        Text(text="удалить команду", icon="msg_delete", red=True,
             on_click=lambda view: plugin.delete_custom(name)),
    ])
    return items


def kinds_of(spec):
    kinds = []
    if spec["ai"]:
        kinds.append("ии + интернет" if spec["web"] else "ии")
    if spec["code"]:
        kinds.append("программа")
    if spec["replies"]:
        kinds.append("текст")
    if spec["links"]:
        kinds.append("ссылка")
    if spec["photos"]:
        kinds.append("фото")
    if spec["files"]:
        kinds.append("файл")
    if spec["open"]:
        kinds.append("сайт")
    return kinds


def plugin_settings(plugin):
    if Header is None:
        return []
    items = [
        Header(text="свои команды"),
        Text(text="создать через ии", subtext="опиши команду словами", icon="msg_bot",
             on_click=lambda view: None, create_sub_fragment=lambda: ai_page(plugin)),
        Text(text="сделать самостоятельно", subtext="заполни поля вручную", icon="msg_edit",
             on_click=lambda view: None, create_sub_fragment=lambda: manual_page(plugin)),
        Text(text="магазин команд", subtext="готовые команды: нажал и пользуйся", icon="msg_arrow_forward",
             on_click=lambda view: None, create_sub_fragment=lambda: shop_page(plugin)),
        Text(text="импорт и экспорт", subtext="поделиться командами или забрать чужие", icon="msg_arrow_forward",
             on_click=lambda view: None, create_sub_fragment=lambda: transfer_page(plugin)),
        Divider(text="мои команды: нажми, чтобы изменить"),
    ]
    if CUSTOM:
        for name, spec in list(CUSTOM.items()):
            items.append(Text(
                text="." + name,
                subtext=spec["description"] + " | " + ", ".join(kinds_of(spec)),
                icon="msg_arrow_forward",
                on_click=lambda view: None,
                create_sub_fragment=lambda n=name: custom_command_page(plugin, n),
            ))
    else:
        items.append(Text(text="пока нет команд", icon="msg_info"))
    return items


                    

class CommandsPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            custom_load(self)
            self.add_on_send_message_hook()
            self.log("commands " + __version__ + ": загружен")
        except Exception as error:
            self.log("commands: ошибка: " + str(error))

    def create_settings(self):
        return plugin_settings(self)

    def _set_setting(self, key, value, reload_settings=True):
        try:
            self.set_setting(key, value, reload_settings=reload_settings)
        except TypeError:
            self.set_setting(key, value)

    def _text(self, key, default=""):
        return str(self.get_setting(key, default) or "").strip()

    def ai_settings(self):
        key = self._text("ai_api_key")
        url = self._text("ai_base_url", AI_DEFAULT_URL) or AI_DEFAULT_URL
        model = self._text("ai_model", AI_DEFAULT_MODEL) or AI_DEFAULT_MODEL
        return url, key, model

                               

    def start_generation(self):
        url, key, model = self.ai_settings()
        request = self._text("ai_request")
        if not key:
            notify("впиши ключ ии", "error")
            return
        if not request:
            notify("напиши, что должна делать команда", "error")
            return
        notify("ии делает команду...")
        threading.Thread(target=self.generate_worker, args=(url, key, model, request), daemon=True).start()

    def generate_worker(self, url, key, model, request):
        try:
            spec = parse_spec(ai_chat(url, key, model, AI_SYSTEM, request, temperature=0.7, max_tokens=4000))
            if spec is None:
                notify("ии ответил непонятно, попробуй ещё раз", "error")
                return
            if name_taken(spec):
                retry_request = (
                    request + "\n\nВАЖНО: имя ." + spec["name"] +
                    " уже занято. придумай другое уникальное имя из букв, не используй существующие, "
                    "и верни JSON в том же формате."
                )
                spec = parse_spec(ai_chat(url, key, model, AI_SYSTEM, retry_request, temperature=0.7, max_tokens=4000))
                if spec is None or name_taken(spec):
                    notify("имя команды занято. попроси ии придумать другое", "error")
                    return
            self.store_new(spec)
            notify("команда ." + spec["name"] + " готова", "success")
        except Exception as error:
            self.log("commands: ии: " + str(error))
            notify("ошибка: " + str(error)[:120], "error")

                     

    def create_manual(self):
        name = self._text("man_name").lower().lstrip(".")
        if not re.fullmatch(NAME_RE, name):
            notify("имя: только буквы, без пробелов и цифр, до 20 знаков", "error")
            return
        spec = clean_spec({
            "name": name,
            "description": self._text("man_desc"),
            "usage": self._text("man_usage"),
            "needs_args": bool(self.get_setting("man_needs", False)),
            "replies": split_list(self._text("man_replies")),
            "links": split_list(self._text("man_links")),
            "photos": split_list(self._text("man_photos")),
            "files": split_list(self._text("man_files")),
            "open": split_list(self._text("man_open")),
            "ai": self._text("man_ai"),
            "web": bool(self.get_setting("man_web", False)),
        })
        if spec is None:
            notify("заполни хотя бы одно поле действия (ссылки начинаются с http)", "error")
            return
        if name_taken(spec):
            notify("имя ." + name + " уже занято", "error")
            return
        self.clear_manual(reload_settings=False)
        self.store_new(spec)
        notify("команда ." + name + " создана", "success")

    def clear_manual(self, reload_settings=True):
        for key in ("man_name", "man_desc", "man_usage", "man_replies", "man_links",
                    "man_photos", "man_files", "man_open", "man_ai"):
            self._set_setting(key, "", False)
        self._set_setting("man_web", False, False)
        self._set_setting("man_needs", False, reload_settings)

                     

    def install_shop(self, name):
        for _group, raw in SHOP:
            if raw["name"] != name:
                continue
            spec = clean_spec(raw)
            if spec is None:
                notify("не удалось установить ." + name, "error")
                return
            if name_taken(spec):
                notify("." + name + " уже установлена", "info")
                return
            self.store_new(spec)
            notify("команда ." + name + " установлена", "success")
            return

    def install_all(self):
        added = 0
        for _group, raw in SHOP:
            spec = clean_spec(raw)
            if spec is None or name_taken(spec):
                continue
            CUSTOM[spec["name"]] = spec
            self.sync_edit_keys(spec["name"], reload_settings=False)
            added += 1
        custom_save(self)
        notify("установлено команд: " + str(added), "success" if added else "info")

                                

    def store_new(self, spec):
        CUSTOM[spec["name"]] = spec
        self.sync_edit_keys(spec["name"], reload_settings=False)
        custom_save(self)

    def sync_edit_keys(self, name, reload_settings=True):
        spec = CUSTOM.get(name)
        if not spec:
            return
        self._set_setting("custom_edit_description_" + name, spec["description"], False)
        self._set_setting("custom_edit_usage_" + name, spec["usage"], False)
        self._set_setting("custom_edit_needs_" + name, spec["needs_args"], False)
        self._set_setting("custom_edit_links_" + name, join_list(spec["links"]), False)
        self._set_setting("custom_edit_photos_" + name, join_list(spec["photos"]), False)
        self._set_setting("custom_edit_files_" + name, join_list(spec["files"]), False)
        self._set_setting("custom_edit_open_" + name, join_list(spec["open"]), False)
        self._set_setting("custom_edit_ai_" + name, spec["ai"], False)
        self._set_setting("custom_edit_web_" + name, spec["web"], False)
        for index, reply in enumerate(spec["replies"]):
            self._set_setting("custom_edit_reply_" + name + "_" + str(index), reply, False)
        self._set_setting("custom_edit_count_" + name, len(spec["replies"]), reload_settings)

    def _reply_count(self, name, spec):
        return max(0, min(int(self.get_setting("custom_edit_count_" + name, len(spec["replies"])) or 0), MAX_REPLIES))

    def _reply_values(self, name, spec, count):
        return [
            str(self.get_setting("custom_edit_reply_" + name + "_" + str(i),
                                 spec["replies"][i] if i < len(spec["replies"]) else "") or "")
            for i in range(count)
        ]

    def save_custom_edits(self, name):
        spec = CUSTOM.get(name)
        if not spec:
            notify("команда не найдена", "error")
            return
        count = self._reply_count(name, spec)
        replies = [r.strip() for r in self._reply_values(name, spec, count) if r.strip()]
        updated = clean_spec({
            "name": name,
            "aliases": spec["aliases"],
            "description": self.get_setting("custom_edit_description_" + name, spec["description"]),
            "usage": self.get_setting("custom_edit_usage_" + name, spec["usage"]),
            "needs_args": bool(self.get_setting("custom_edit_needs_" + name, spec["needs_args"])),
            "replies": replies,
            "links": split_list(self.get_setting("custom_edit_links_" + name, join_list(spec["links"]))),
            "photos": split_list(self.get_setting("custom_edit_photos_" + name, join_list(spec["photos"]))),
            "files": split_list(self.get_setting("custom_edit_files_" + name, join_list(spec["files"]))),
            "open": split_list(self.get_setting("custom_edit_open_" + name, join_list(spec["open"]))),
            "ai": self.get_setting("custom_edit_ai_" + name, spec["ai"]),
            "web": bool(self.get_setting("custom_edit_web_" + name, spec["web"])),
            "code": spec["code"],
        })
        if not updated:
            notify("нужно хотя бы одно действие", "error")
            return
        CUSTOM[name] = updated
        self.sync_edit_keys(name, reload_settings=False)
        custom_save(self)
        notify("команда ." + name + " обновлена", "success")

    def add_custom_reply(self, name):
        spec = CUSTOM.get(name)
        if not spec:
            return
        count = self._reply_count(name, spec)
        if count >= MAX_REPLIES:
            notify("максимум " + str(MAX_REPLIES) + " ответов", "error")
            return
        self._set_setting("custom_edit_count_" + name, count + 1, True)

    def remove_custom_reply(self, name, index):
        spec = CUSTOM.get(name)
        if not spec:
            return
        count = self._reply_count(name, spec)
        values = self._reply_values(name, spec, count)
        if 0 <= index < len(values):
            values.pop(index)
        for i, value in enumerate(values):
            self._set_setting("custom_edit_reply_" + name + "_" + str(i), value, False)
        self._set_setting("custom_edit_count_" + name, len(values), True)

    def delete_custom(self, name):
        if CUSTOM.pop(name, None) is not None:
            custom_save(self)
            notify("команда ." + name + " удалена", "success")

                              

    def export_clipboard(self, name=None):
        specs = [CUSTOM[name]] if name else list(CUSTOM.values())
        if not specs:
            notify("пока нечего экспортировать", "error")
            return
        try:
            clipboard_set(export_text(specs))
            notify("скопировано команд: " + str(len(specs)), "success")
        except Exception as error:
            self.log("commands: буфер: " + str(error))
            notify("не удалось скопировать: " + str(error)[:80], "error")

    def export_file(self):
        if not CUSTOM:
            notify("пока нечего экспортировать", "error")
            return
        try:
            from client_utils import send_document
            folder = os.path.join(media_dir(), "export" + str(int(time.time())))
            os.makedirs(folder, exist_ok=True)
            path = os.path.join(folder, "commands_export.json")
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(export_text(list(CUSTOM.values())))
            send_document(my_user_id(), path, caption="📦 команды из плагина Commands: " + str(len(CUSTOM)))
            notify("файл отправлен в избранное", "success")
        except Exception as error:
            self.log("commands: экспорт файла: " + str(error))
            notify("не получилось отправить файл, попробуй «скопировать все команды»", "error")

    def finish_import(self, items):
        if not items:
            notify("не нашёл команд в этом тексте", "error")
            return
        added, skipped, bad = import_specs(items)
        for name in added:
            self.sync_edit_keys(name, reload_settings=False)
        if added:
            custom_save(self)
        parts = ["добавлено: " + str(len(added))]
        if skipped:
            parts.append("пропущено (имя занято): " + str(skipped))
        if bad:
            parts.append("не подошло: " + str(bad))
        notify(", ".join(parts), "success" if added else "error")

    def import_clipboard(self):
        try:
            text = clipboard_get()
        except Exception as error:
            self.log("commands: буфер: " + str(error))
            notify("не удалось прочитать буфер обмена", "error")
            return
        if not text.strip():
            notify("буфер обмена пуст", "error")
            return
        self.finish_import(parse_import(text))

    def import_link(self):
        url = clean_url(self._text("import_url"))
        if not url:
            notify("вставь ссылку, она должна начинаться с http", "error")
            return

        def worker():
            try:
                text = http_get(url, limit=1000000)
                self.finish_import(parse_import(text))
            except Exception as error:
                notify("не удалось загрузить: " + str(error)[:80], "error")
        threading.Thread(target=worker, daemon=True).start()

                        

    def process(self, peer, out):
        from client_utils import send_text
        try:
            if out.code:
                self.apply_code(out)
            if out.open_url:
                open_site(out.open_url)
            if out.ai_prompt:
                url, key, model = self.ai_settings()
                if not key:
                    notify("для этой команды нужен ключ ии (настройки → создать через ии)", "error")
                    return
                answer = tidy_answer(ai_chat(url, key, model, out.ai_prompt + RUNTIME_RULES, out.args or "привет",
                                             web=out.web, temperature=0.6, max_tokens=1500))
                if out.web and "openrouter" not in url:
                    answer += "\n\n(поиск в интернете работает только через openrouter)"
                out.text = (out.text + "\n\n" + answer) if out.text else answer
            if out.photo or out.file:
                send_media(peer, out)
            elif out.text:
                send_text(peer, out.text[:4000])
        except Exception as error:
            self.log("commands: выполнение: " + str(error))
            notify("ошибка команды: " + str(error)[:100], "error")

    def apply_code(self, out):
        value = exec_code(out.code, out.args)
        result = ""
        if isinstance(value, dict):
            result = str(value.get("text", "") or "")
            photo = clean_url(value.get("photo", "") or "")
            file = clean_url(value.get("file", "") or "")
            site = clean_url(value.get("open", "") or "")
            link = clean_url(value.get("link", "") or "")
            if photo:
                out.photo = photo
            if file:
                out.file = file
            if site:
                out.open_url = site
            if link:
                result = (result + "\n" + link) if result else link
        elif value is not None:
            result = str(value)
        result = result.strip()[:3500]
        if "{result}" in out.text:
            out.text = out.text.replace("{result}", result)
        elif out.text and result:
            out.text = out.text + "\n\n" + result
        elif result:
            out.text = result

    def on_send_message_hook(self, account, params):
        try:
            message = getattr(params, "message", None)
            if not isinstance(message, str):
                return HookResult()
            text = message.strip()
            if not text.startswith("."):
                return HookResult()
            parts = text[1:].split(maxsplit=1)
            if not parts:
                return HookResult()
            name = parts[0].lower()
            args = parts[1] if len(parts) > 1 else ""

            if name in RESERVED:
                params.message = build_help()
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            out = run_command(name, args)
            if out is None:
                return HookResult()

            if not out.deferred():
                if out.open_url:
                    open_site(out.open_url)
                if out.text:
                    params.message = out.text
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
                return HookResult(strategy=HookStrategy.CANCEL)

            try:
                peer = int(getattr(params, "peer", 0) or 0)
            except Exception:
                peer = 0
            if not peer:
                if out.photo or out.file:
                    params.message = ((out.text + "\n") if out.text else "") + (out.photo or out.file)
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
                notify("не получилось определить чат", "error")
                return HookResult(strategy=HookStrategy.CANCEL)
            if out.ai_prompt or out.code:
                notify("думаю...")
            threading.Thread(target=self.process, args=(peer, out), daemon=True).start()
            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as error:
            self.log("commands: ошибка хука: " + str(error))
            return HookResult()
