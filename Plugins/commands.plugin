    row = [random.choice(symbols) for _ in range(3)]
    if row[0] == row[1] == row[2]:
        end = "🎉 победа! все три совпали"
    else:
        end = "не повезло, попробуй ещё раз"
    return "🎰 " + " | ".join(row) + "\n\n" + end
'''

CODE_PICK = r'''def run(args):
    items = [x.strip() for x in args.split(",") if x.strip()]
    if len(items) < 2:
        return "напиши варианты через запятую. пример: .pick пицца, суши, бургер"
    return "🎯 я выбираю: " + random.choice(items)
'''

CODE_RNG = r'''def run(args):
    parts = args.replace(",", " ").split()
    try:
        a = int(parts[0])
        b = int(parts[1])
    except Exception:
        return "напиши два числа. пример: .rng 1 100"
    if a > b:
        return "⚠️ первое число больше второго. пример: .rng 1 100"
    return "🎲 от " + str(a) + " до " + str(b) + " выпало: " + str(random.randint(a, b))
'''

CODE_REVERSE = r'''def run(args):
    return args[::-1]
'''

CODE_UPSIDE = r'''def run(args):
    text = args.lower()
    return "".join(UP.get(ch, ch) for ch in reversed(text))
'''

CODE_MORSE = r'''def run(args):
    out = []
    for ch in args.upper():
        if ch in M:
            out.append(M[ch])
    if not out:
        return "не нашёл знаков, которые можно перевести"
    return " ".join(out)
'''

CODE_UNMORSE = r'''R = {}
for k, v in M.items():
    if v not in R:
        R[v] = k

def run(args):
    words = args.strip().split(" / ") if " / " in args else args.replace("/", " / ").split(" / ")
    res = []
    bad = []
    for word in words:
        letters = ""
        for code in word.split():
            if code in R:
                letters += R[code]
            else:
                bad.append(code)
        res.append(letters)
    text = " ".join(res).lower()
    if bad:
        return text + "\n\n❓ неизвестный код: " + ", ".join(bad)
    return text
'''

CODE_WC = r'''def run(args):
    return ("📊 символов с пробелами: " + str(len(args)) +
            "\nсимволов без пробелов: " + str(len("".join(args.split()))) +
            "\nслов: " + str(len(args.split())) +
            "\nстрок: " + str(len(args.splitlines())))
'''

CODE_SQRT = r'''def run(args):
    try:
        x = float(args.replace(",", "."))
        if x < 0:
            return "⚠️ из отрицательного числа корень не достать"
        r = math.sqrt(x)
        shown = str(int(r)) if r == int(r) else str(round(r, 6))
    except Exception:
        return "⚠️ напиши число. пример: .sqrt 144"
    return "√" + args.strip() + " = " + shown
'''

CODE_BINARY = r'''def run(args):
    try:
        n = int(args.strip())
    except Exception:
        return "⚠️ напиши целое число. пример: .binary 42"
    return "💻 " + str(n) + " в двоичной системе: " + bin(n).replace("0b", "")
'''

CODE_ROMAN = r'''def run(args):
    try:
        n = int(args.strip())
    except Exception:
        return "⚠️ напиши целое число от 1 до 3999"
    if n < 1 or n > 3999:
        return "⚠️ можно числа от 1 до 3999"
    table = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"),
             (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]
    left = n
    res = ""
    for value, sign in table:
        while left >= value:
            res += sign
            left -= value
    return "🏛️ " + str(n) + " римскими цифрами: " + res
'''

CODE_SPLIT = r'''def run(args):
    parts = args.replace(",", ".").split()
    try:
        total = float(parts[0])
        n = int(parts[1])
    except Exception:
        return "напиши сумму и сколько человек. пример: .split 1500 4"
    if n <= 0 or total < 0:
        return "⚠️ людей должно быть больше нуля, а сумма не меньше нуля"
    return "💸 сумма " + str(round(total, 2)) + " на " + str(n) + " чел.\n\nс каждого: " + str(round(total / n, 2))
'''

CODE_BMI = r'''def run(args):
    parts = args.replace(",", ".").split()
    try:
        weight = float(parts[0])
        height = float(parts[1])
    except Exception:
        return "напиши вес в кг и рост в см. пример: .bmi 70 175"
    if weight <= 0 or height <= 0:
        return "⚠️ числа должны быть больше нуля"
    value = weight / ((height / 100) ** 2)
    return ("⚖️ индекс массы тела: " + str(round(value, 1)) +
            "\n\nэто просто расчёт по формуле. для подростков эти нормы не подходят.")
'''

CODE_DAYS = r'''def run(args):
    try:
        parts = args.strip().split(".")
        target = datetime.date(int(parts[2]), int(parts[1]), int(parts[0]))
    except Exception:
        return "напиши дату так: ДД.ММ.ГГГГ. пример: .days 31.12.2026"
    delta = (target - datetime.date.today()).days
    if delta > 0:
        return "📅 до " + args.strip() + " осталось дней: " + str(delta)
    if delta == 0:
        return "📅 это сегодня!"
    return "📅 с " + args.strip() + " прошло дней: " + str(-delta)
'''

CODE_PASS = r'''def run(args):
    try:
        size = int(args.strip()) if args.strip() else 12
    except Exception:
        return "напиши длину числом. пример: .pass 16"
    if size < 6 or size > 64:
        return "⚠️ длина от 6 до 64"
    rnd = random.SystemRandom()
    groups = [string.ascii_lowercase, string.ascii_uppercase, string.digits, "!@#$%^&*-_?"]
    chars = [rnd.choice(g) for g in groups]
    pool = "".join(groups)
    while len(chars) < size:
        chars.append(rnd.choice(pool))
    rnd.shuffle(chars)
    return "🔐 твой пароль:\n" + "".join(chars) + "\n\nя его нигде не сохраняю"
'''


def shop_item(group, name, description, **fields):
    spec = {"name": name, "description": description}
    spec.update(fields)
    return (group, spec)


