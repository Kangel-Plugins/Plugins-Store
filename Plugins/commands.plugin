def build_help():
    if CUSTOM:
        names = " ".join("." + name for name in sorted(CUSTOM))[:600]
        return HELP_TEXT + "\n\nтвои команды: " + names
    return HELP_TEXT + "\n\nтвоих команд пока нет"


                                                  

def notify(text, kind="info"):
    if BulletinHelper is None or run_on_ui_thread is None:
        return

    def show():
        try:
            if kind == "error":
                BulletinHelper.show_error(text)
            elif kind == "success":
                BulletinHelper.show_success(text)
            else:
                BulletinHelper.show_info(text)
        except Exception:
            pass
    try:
        run_on_ui_thread(show)
    except Exception:
        pass


def open_site(url):
    def go():
        try:
            from client_utils import get_last_fragment
            from android.net import Uri
            from org.telegram.messenger.browser import Browser
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is not None:
                Browser.openUrl(activity, Uri.parse(url))
                return
        except Exception:
            pass
        try:
            from android.content import Intent
            from android.net import Uri
            from org.telegram.messenger import ApplicationLoader
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ApplicationLoader.applicationContext.startActivity(intent)
        except Exception as error:
            notify("не удалось открыть сайт: " + str(error)[:80], "error")
    if run_on_ui_thread is not None:
        try:
            run_on_ui_thread(go)
            return
        except Exception:
            pass
    go()


MEDIA_EXT = {
    "image/jpeg": ".jpg", "image/jpg": ".jpg", "image/png": ".png", "image/webp": ".webp",
    "image/gif": ".gif", "application/pdf": ".pdf", "application/zip": ".zip",
    "video/mp4": ".mp4", "audio/mpeg": ".mp3", "text/plain": ".txt",
}
USER_AGENT = "Mozilla/5.0 (Linux; Android 13; Mobile) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36"
PHOTO_LIMIT = 15 * 1024 * 1024
FILE_LIMIT = 50 * 1024 * 1024


def media_dir():
    try:
        from org.telegram.messenger import ApplicationLoader
        base = str(ApplicationLoader.applicationContext.getCacheDir().getAbsolutePath())
    except Exception:
        base = tempfile.gettempdir()
    path = os.path.join(base, "commands_plugin")
    os.makedirs(path, exist_ok=True)
    try:
        for entry in os.listdir(path):
            full = os.path.join(path, entry)
            if time.time() - os.path.getmtime(full) > 3600:
                shutil.rmtree(full, ignore_errors=True)
    except Exception:
        pass
    return path


def fetch_media(url, kind):
    limit = PHOTO_LIMIT if kind == "photo" else FILE_LIMIT
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"})
    with urllib.request.urlopen(request, timeout=30) as response:
        ctype = response.headers.get("Content-Type", "").split(";")[0].strip().lower()
        final_url = response.geturl()
        data = response.read(limit + 1)
    if len(data) > limit:
        raise RuntimeError("файл слишком большой")
    if not data:
        raise RuntimeError("пустой ответ")
    if kind == "photo" and not ctype.startswith("image/"):
        raise RuntimeError("по ссылке не картинка")
    if ctype in ("text/html", "application/xhtml+xml"):
        raise RuntimeError("по ссылке страница, а не файл")
    url_path = urllib.parse.urlparse(final_url).path
    base = os.path.basename(urllib.parse.unquote(url_path)) or "file"
    ext = MEDIA_EXT.get(ctype, "")
    if not os.path.splitext(base)[1]:
        base += ext or (".jpg" if kind == "photo" else "")
    base = re.sub(r"[^\w.\- ]", "_", base)[:60] or "file"
    folder = os.path.join(media_dir(), str(int(time.time() * 1000)) + str(random.randint(100, 999)))
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, base)
    with open(path, "wb") as handle:
        handle.write(data)
    return path, ctype


def send_media(peer, out):
    from client_utils import send_photo, send_document, send_text
    caption = (out.text or "")[:1024]
    jobs = []
    if out.photo:
        jobs.append(("photo", out.photo))
    if out.file:
        jobs.append(("file", out.file))
    for index, (kind, url) in enumerate(jobs):
        kwargs = {"caption": caption} if (index == 0 and caption) else {}
        try:
            path, ctype = fetch_media(url, kind)
            if kind == "photo" and ctype in ("image/jpeg", "image/jpg", "image/png"):
                send_photo(peer, path, **kwargs)
            else:
                send_document(peer, path, **kwargs)
        except Exception as error:
            notify("не вышло скачать, отправил ссылкой: " + str(error)[:60], "error")
            send_text(peer, (caption + "\n" if kwargs else "") + url)


                

def ai_chat(url, key, model, system, user, web=False, temperature=0.8, max_tokens=3500):
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        "temperature": temperature,
        "max_tokens": max_tokens,
    }
    if web and "openrouter" in url:
        payload["plugins"] = [{"id": "web", "max_results": 5}]
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), method="POST", headers={
        "Content-Type": "application/json",
        "Authorization": "Bearer " + key,
    })
    try:
        with urllib.request.urlopen(req, timeout=120 if web else 90) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "ignore")[:150]
        raise RuntimeError("http " + str(error.code) + " " + detail)
    return data["choices"][0]["message"]["content"]


RUNTIME_RULES = (
