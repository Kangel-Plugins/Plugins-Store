def custom_load(plugin):
    CUSTOM.clear()
    try:
        for item in json.loads(plugin.get_setting("custom_commands", "[]")):
            spec = clean_spec(item)
            if spec and spec["name"] not in RESERVED:
                CUSTOM[spec["name"]] = spec
    except Exception as error:
        plugin.log("commands: загрузка команд: " + str(error))


def custom_save(plugin):
    value = json.dumps(list(CUSTOM.values()), ensure_ascii=False)
    try:
        plugin.set_setting("custom_commands", value, reload_settings=True)
    except TypeError:
        plugin.set_setting("custom_commands", value)


                              

EXPORT_FORMAT = "commands-plugin"


def export_text(specs):
    return json.dumps({"format": EXPORT_FORMAT, "version": 1, "commands": specs}, ensure_ascii=False)


def parse_import(text):
    text = str(text or "").strip()
    data = None
    try:
        data = json.loads(text)
    except ValueError:
        for open_ch, close_ch in (("{", "}"), ("[", "]")):
            start, end = text.find(open_ch), text.rfind(close_ch)
            if start >= 0 and end > start:
                try:
                    data = json.loads(text[start:end + 1])
                    break
                except ValueError:
                    continue
    if isinstance(data, dict) and isinstance(data.get("commands"), list):
        return data["commands"]
    if isinstance(data, dict):
        return [data]
    if isinstance(data, list):
        return data
    return []


def import_specs(items):
    added, skipped, bad = [], 0, 0
    for item in items:
        spec = clean_spec(item)
        if spec is None:
            bad += 1
        elif name_taken(spec):
            skipped += 1
        else:
            CUSTOM[spec["name"]] = spec
            added.append(spec["name"])
    return added, skipped, bad


def clipboard_set(text):
    def go():
        try:
            from org.telegram.messenger import AndroidUtilities
            AndroidUtilities.addToClipboard(text)
            return
        except Exception:
            pass
        from android.content import ClipData, Context
        from org.telegram.messenger import ApplicationLoader
        manager = ApplicationLoader.applicationContext.getSystemService(Context.CLIPBOARD_SERVICE)
        manager.setPrimaryClip(ClipData.newPlainText("commands", text))
    if run_on_ui_thread is not None:
        run_on_ui_thread(go)
    else:
        go()


def clipboard_get():
    from android.content import Context
    from org.telegram.messenger import ApplicationLoader
    context = ApplicationLoader.applicationContext
    manager = context.getSystemService(Context.CLIPBOARD_SERVICE)
    clip = manager.getPrimaryClip()
    if clip is None or clip.getItemCount() == 0:
        return ""
    return str(clip.getItemAt(0).coerceToText(context))


def my_user_id():
    from org.telegram.messenger import UserConfig
    return int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())


