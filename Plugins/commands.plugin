LIST_SEP = ";;"
RESERVED = {"chelp", "кхелп"}
NAME_RE = r"[a-zа-яё]{1,20}"
MAX_REPLIES = 60
MAX_URLS = 30
MAX_CODE = 8000

AI_DEFAULT_URL = "https://openrouter.ai/api/v1/chat/completions"
AI_DEFAULT_MODEL = "openai/gpt-4o-mini"


class Outcome:
    def __init__(self):
        self.text = ""
        self.photo = ""
        self.file = ""
        self.open_url = ""
        self.args = ""
        self.code = ""
        self.ai_prompt = ""
        self.web = False

    def deferred(self):
        return bool(self.code or self.ai_prompt or self.photo or self.file)


def pick(items):
    return random.choice(items)


def clean_text(text, limit):
    text = str(text).strip()
    for bad in ("\u2014", "\u2013", "\u2192", "\u2190"):
        text = text.replace(bad, "-")
    return text[:limit]


def clean_url(value):
    value = str(value).strip()
    if len(value) > 500 or not re.match(r"^https?://\S", value, re.I):
        return None
    return value


def clean_urls(items):
    if isinstance(items, str):
        items = [items]
    if not isinstance(items, list):
        return []
    result = []
    for item in items:
        url = clean_url(item) if isinstance(item, str) else None
        if url and url not in result:
            result.append(url)
    return result[:MAX_URLS]


def split_list(text):
    return [part.strip() for part in str(text).split(LIST_SEP) if part.strip()]


def join_list(items):
    return (" " + LIST_SEP + " ").join(items)


                                    
                                                                   
                                                                        

FORBIDDEN_NODES = (ast.Import, ast.ImportFrom, ast.Global, ast.Nonlocal, ast.ClassDef,
                   ast.AsyncFunctionDef, ast.Await, ast.With, ast.AsyncWith, ast.AsyncFor, ast.Yield, ast.YieldFrom)
FORBIDDEN_NAMES = {
    "exec", "eval", "open", "compile", "globals", "locals", "getattr", "setattr", "delattr",
    "vars", "dir", "input", "breakpoint", "type", "object", "super", "memoryview", "help",
    "exit", "quit", "classmethod", "staticmethod", "property", "builtins", "sys", "os",
}
FORBIDDEN_ATTRS = {"format", "format_map", "mro", "gi_frame", "gi_code", "cr_frame", "f_globals", "f_locals"}
SAFE_BUILTIN_NAMES = [
    "abs", "all", "any", "bin", "bool", "chr", "dict", "divmod", "enumerate", "filter", "float",
    "hex", "int", "isinstance", "len", "list", "map", "max", "min", "oct", "ord", "pow", "range",
    "repr", "reversed", "round", "set", "slice", "sorted", "str", "sum", "tuple", "zip", "frozenset",
    "True", "False", "None", "Exception", "ValueError", "TypeError", "IndexError", "KeyError",
    "ZeroDivisionError", "OverflowError", "ArithmeticError",
]
SAFE_BUILTINS = {name: getattr(builtins, name) for name in SAFE_BUILTIN_NAMES if hasattr(builtins, name)}
                                                                                                               
SAFE_BUILTINS["__import__"] = builtins.__import__


class CodeError(Exception):
    pass


def check_code(src):
    try:
        tree = ast.parse(src)
    except SyntaxError as error:
        raise CodeError("ошибка в коде: " + str(error)[:80])
    has_run = False
    for node in ast.walk(tree):
        if isinstance(node, FORBIDDEN_NODES):
            raise CodeError("в коде нельзя: " + type(node).__name__)
        if isinstance(node, ast.Attribute) and (node.attr.startswith("_") or node.attr in FORBIDDEN_ATTRS):
            raise CodeError("в коде нельзя обращаться к ." + node.attr)
        if isinstance(node, ast.Name) and (node.id.startswith("__") or node.id in FORBIDDEN_NAMES):
            raise CodeError("в коде нельзя использовать " + node.id)
        if isinstance(node, ast.FunctionDef) and node.name == "run":
            has_run = True
    if not has_run:
        raise CodeError("в коде нет функции run(args)")


def http_get(url, limit=300000):
    url = str(url)
    if not re.match(r"^https?://", url, re.I):
        raise ValueError("только http и https")
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"})
    with urllib.request.urlopen(request, timeout=12) as response:
        return response.read(limit).decode("utf-8", "replace")


def http_get_json(url):
    return json.loads(http_get(url))


def exec_code(src, args, timeout=15):
    check_code(src)
    env = {
        "__builtins__": SAFE_BUILTINS,
        "math": math, "random": random, "re": re, "string": string, "json": json,
        "datetime": dt_module, "get": http_get, "get_json": http_get_json,
        "quote": urllib.parse.quote,
    }
    box = {}

    def target():
        counter = [0]

        def tracer(frame, event, arg):
            counter[0] += 1
            if counter[0] > 3000000:
                raise TimeoutError("код работает слишком долго")
            return tracer
        sys.settrace(tracer)
        try:
            exec(compile(src, "<command>", "exec"), env)
            box["value"] = env["run"](args)
        except BaseException as error:
            box["error"] = error
        finally:
            sys.settrace(None)

    thread = threading.Thread(target=target, daemon=True)
    thread.start()
    thread.join(timeout)
    if thread.is_alive():
        raise TimeoutError("код работает слишком долго")
    if "error" in box:
        raise box["error"]
    return box.get("value")


                              

def clean_spec(spec):
    if not isinstance(spec, dict):
        return None
    name = str(spec.get("name", "")).strip().lower().lstrip(".")
    if not re.fullmatch(NAME_RE, name):
        return None
    replies = spec.get("replies") or []
    if isinstance(replies, str):
        replies = [replies]
    if not isinstance(replies, list):
        replies = []
    replies = [clean_text(r, 1000) for r in replies if isinstance(r, str) and r.strip()][:MAX_REPLIES]
    links = clean_urls(spec.get("links") or [])
    photos = clean_urls(spec.get("photos") or [])
    files = clean_urls(spec.get("files") or [])
    sites = clean_urls(spec.get("open") or [])
    aliases = spec.get("aliases") or []
    if not isinstance(aliases, list):
        aliases = []
    aliases = [str(a).strip().lower().lstrip(".") for a in aliases]
    aliases = [a for a in aliases if re.fullmatch(NAME_RE, a) and a != name][:5]
    ai_prompt = clean_text(spec.get("ai", "") or "", 1500)
    code = spec.get("code", "") or ""
    if isinstance(code, list):
        code = "\n".join(str(line) for line in code)
    code = str(code).strip("\n")[:MAX_CODE]
    if code.strip():
        try:
            check_code(code)
        except CodeError:
            code = ""
    else:
        code = ""
    if not (replies or links or photos or files or sites or ai_prompt or code):
        return None
    needs_args = bool(spec.get("needs_args", False))
    for url in links + photos + files + sites:
        if "{q}" in url or "{args}" in url:
            needs_args = True
    return {
        "name": name,
        "aliases": aliases,
        "description": clean_text(spec.get("description", "") or "своя команда", 60),
        "usage": clean_text(spec.get("usage", ""), 30),
        "needs_args": needs_args,
        "replies": replies,
        "links": links,
        "photos": photos,
        "files": files,
        "open": sites,
        "ai": ai_prompt,
        "web": bool(spec.get("web", False)) and bool(ai_prompt),
        "code": code,
    }


def parse_spec(content):
    text = str(content).strip()
    start, end = text.find("{"), text.rfind("}")
    if start < 0 or end <= start:
        return None
    try:
        return clean_spec(json.loads(text[start:end + 1]))
    except ValueError:
        return None


def render_text(text, args, url=False):
    def rand_sub(match):
        low, high = int(match.group(1)), int(match.group(2))
        if low > high:
            low, high = high, low
        return str(random.randint(low, high))

    def pick_sub(match):
        options = [o.strip() for o in match.group(1).split("|") if o.strip()]
        return pick(options) if options else ""

    text = re.sub(r"\{rand:(\d+)-(\d+)\}", rand_sub, text)
    text = re.sub(r"\{pick:([^{}]+)\}", pick_sub, text)
    now = datetime.now()
    text = text.replace("{time}", now.strftime("%H:%M")).replace("{date}", now.strftime("%d.%m.%Y"))
    quoted = urllib.parse.quote(args, safe="")
    text = text.replace("{q}", quoted)
    text = text.replace("{args}", quoted if url else args)
    if url:
        text = text.replace(" ", "%20")
    return text[:3500]


CUSTOM = {}


def find_spec(name):
    spec = CUSTOM.get(name)
    if spec is not None:
        return spec
    for item in CUSTOM.values():
        if name in item["aliases"]:
            return item
    return None


def name_taken(spec):
    for name in [spec["name"]] + spec["aliases"]:
        if name in RESERVED or find_spec(name) is not None:
            return True
    return False


def usage_text(spec):
    return "используй: ." + spec["name"] + (" " + spec["usage"] if spec["usage"] else "")


def run_custom(spec, args):
    args = args.strip()
    out = Outcome()
    if spec["needs_args"] and not args:
        out.text = usage_text(spec)
        return out
    out.args = args
    if spec["replies"]:
        out.text = render_text(pick(spec["replies"]), args)
    if spec["links"]:
        link = render_text(pick(spec["links"]), args, url=True)
        out.text = (out.text + "\n" + link) if out.text else link
    if spec["photos"]:
        out.photo = render_text(pick(spec["photos"]), args, url=True)
    if spec["files"]:
        out.file = render_text(pick(spec["files"]), args, url=True)
    if spec["open"]:
        out.open_url = render_text(pick(spec["open"]), args, url=True)
    out.code = spec["code"]
    out.ai_prompt = spec["ai"]
    out.web = spec["web"]
    return out


def run_command(name, args):
    spec = find_spec(name)
    if spec is None:
        return None
    return run_custom(spec, args)


