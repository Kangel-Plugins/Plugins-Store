    "не длиннее 1500 символов. Не используй длинное тире и стрелки."
)


def tidy_answer(text):
    text = str(text).replace("**", "").replace("__", "").replace("`", "")
    text = re.sub(r"(?m)^#{1,6}\s*", "", text)
    for bad in ("\u2014", "\u2013", "\u2192", "\u2190"):
        text = text.replace(bad, "-")
    return text.strip()[:3500]


