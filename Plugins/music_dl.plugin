class MusicPlugin(BasePlugin):

    # ── i18n ─────────────────────────────────────────────────────────────────

    def _lang(self) -> str:
        # Старые значения 0 и 1 сохранены: настройки при обновлении не собьются.
        value = self.get_setting("language", 2)
        if value == 0: return "ru"
        if value == 1: return "en"
        try:
            from org.telegram.messenger import LocaleController
            locale = LocaleController.getInstance().getCurrentLocale()
            code = str(locale.getLanguage()).lower()
            return "ru" if code == "ru" else "en"
        except Exception:
            try:
                from java.util import Locale
                return "ru" if str(Locale.getDefault().getLanguage()).lower() == "ru" else "en"
            except Exception: return "en"

    def _ui(self, text):
        if self._lang() == "ru": return text
        return _UI_EN.get(text, text)

    def _t(self, key: str, **kw) -> str:
        text = TEXTS.get(self._lang(), TEXTS["ru"]).get(key, key)
        try: return text.format(**kw)
        except: return text

    # ── settings helpers ─────────────────────────────────────────────────────

    def _svc(self)        -> str: return [SERVICE_SC,SERVICE_SP,SERVICE_TD,SERVICE_YM][self.get_setting("service",0)]
    def _per_page(self)   -> int: return [3,5,7,10][self.get_setting("results_per_page",1)]
    def _limit(self)      -> int: return [10,20,30,50][self.get_setting("search_limit",1)]
    def _sc_cid(self)     -> str: return _safe_text(self.get_setting("sc_client_id","")).strip()
    def _sp_dc(self)      -> str: return _safe_text(self.get_setting("sp_dc","")).strip()
    def _td_tok(self)     -> str: return _safe_text(self.get_setting("td_token","")).strip()
    def _performer(self, artist: str) -> str: return f"{artist}"

    def _service_help(self, title, message):
        from android_utils import run_on_ui_thread
        def show():
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            fragment = get_last_fragment()
            if fragment is None:
                return
            box = AlertDialogBuilder(fragment.getParentActivity())
            box.set_title(self._tr(title))
            box.set_message(self._tr(message))
            box.set_positive_button("OK", lambda dialog, which: dialog.dismiss())
            box.show()
        run_on_ui_thread(show)

    def _spotify_guide(self):
        self._service_help("Spotify · SERVICE UPDATE",
            "1. Открой developer.spotify.com/dashboard и создай приложение с Web API. "
            "Скопируй Client ID в настройки плагина. Client Secret не нужен.\n\n"
            "2. В Spotify Dashboard добавь Redirect URI и укажи точно такой же URI в плагине. "
            "Можно использовать https://example.com/callback.\n\n"
            "3. Нажми «Открыть вход Spotify», разреши доступ. После перенаправления "
            "скопируй полный URL страницы, даже если она показывает ошибку, в поле Callback URL.\n\n"
            "4. Нажми «Завершить подключение». Токен будет обновляться автоматически. "
            "В режиме разработки Spotify аккаунт должен иметь доступ к приложению.\n\n"
            "Можно вставить готовый access_token в поле Bearer. Он временный. "
            "sp_dc — старая cookie браузера, это другой вид данных.\n\n"
            "Spotify Web API даёт поиск и доступные preview. Загрузка полных файлов "
            "использует отдельный сервис и может быть недоступна независимо от токена.")

    def _open_service_url(self, url):
        from client_utils import get_last_fragment
        from org.telegram.messenger.browser import Browser
        fragment = get_last_fragment()
        if fragment:
            Browser.openUrl(fragment.getParentActivity(), url)

    def _spotify_login(self):
        client = str(self.get_setting("sp_client", "")).strip()
        redirect = str(self.get_setting("sp_redirect", "")).strip()
        if not client or not redirect.startswith("https://"):
            self._service_help("Spotify", "Укажи Client ID и HTTPS Redirect URI.")
            return
        verifier = secrets.token_urlsafe(48)
        state = secrets.token_urlsafe(24)
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
        self.set_setting("sp_pending", dict(verifier=verifier, state=state, client=client, redirect=redirect), reload_settings=False)
        query = urllib.parse.urlencode(dict(client_id=client, response_type="code", redirect_uri=redirect,
                                           code_challenge_method="S256", code_challenge=challenge, state=state))
        self._open_service_url("https://accounts.spotify.com/authorize?" + query)

    def _spotify_complete(self):
        pending = self.get_setting("sp_pending", {}) or {}
        raw = str(self.get_setting("sp_callback", "")).strip()
        callback = urllib.parse.urlsplit(raw)
        expected = urllib.parse.urlsplit(pending.get("redirect", ""))
        data = urllib.parse.parse_qs(callback.query)
        if not pending or (callback.scheme, callback.netloc, callback.path) != (expected.scheme, expected.netloc, expected.path) or data.get("state", [""])[0] != pending.get("state") or not data.get("code"):
            self._service_help("Spotify", "Callback не соответствует начатому входу. Повтори шаги 1–3.")
            return
        def task():
            try:
                response = requests.post(SP_TOKEN_URL, data=dict(grant_type="authorization_code",
                    code=data["code"][0], redirect_uri=pending["redirect"], client_id=pending["client"],
                    code_verifier=pending["verifier"]), timeout=15)
                if response.status_code != 200:
                    raise ValueError("Spotify отклонил код. Начни вход заново.")
                self._save_sp_token(response.json())
                self.set_setting("sp_pending", {}, reload_settings=False)
                self.set_setting("sp_callback", "", reload_settings=False)
                self._service_help("Spotify", "Подключено.")
            except Exception as exc:
                self._service_help("Spotify", str(exc) if isinstance(exc, ValueError) else "Ошибка соединения с Spotify.")
        threading.Thread(target=task, daemon=True).start()

    def _save_sp_token(self, data):
        if not data.get("access_token"):
            raise ValueError("Spotify не вернул access token")
        self.set_setting("sp_access", data["access_token"], reload_settings=False)
        self.set_setting("sp_expiry", time.time() + int(data.get("expires_in", 3600)), reload_settings=False)
        if data.get("refresh_token"):
            self.set_setting("sp_refresh", data["refresh_token"], reload_settings=False)

    def _spotify_token(self):
        token = str(self.get_setting("sp_access", "")).strip()
        token = re.sub(r"^Bearer\s+", "", token, flags=re.I)
        refresh = self.get_setting("sp_refresh", "")
        if refresh and time.time() >= float(self.get_setting("sp_expiry", 0)) - 60:
            response = requests.post(SP_TOKEN_URL, data=dict(grant_type="refresh_token", refresh_token=refresh,
                                    client_id=str(self.get_setting("sp_client", "")).strip()), timeout=12)
            if response.status_code != 200:
                raise ValueError("Spotify: обнови подключение через инструкцию в настройках")
            self._save_sp_token(response.json())
            return response.json()["access_token"]
        if token:
            return token
        cookie = self._sp_dc()
        if cookie:
            if cookie.startswith("BQ") or cookie.lower().startswith("bearer "):
                return re.sub(r"^Bearer\s+", "", cookie, flags=re.I)
            token, _ = _sp_user_token(cookie)
            if token:
                return token
        return ""

    def _yandex_login(self):
        from android_utils import run_on_ui_thread
        previous = getattr(self, "_ym_login", None)
        if previous is not None:
            previous["cancel"].set()
            if previous.get("dialog") is not None:
                previous["dialog"].dismiss()
        state = {"cancel": threading.Event(), "dialog": None}
        self._ym_login = state

        def request_code():
            try:
                response = requests.post("https://oauth.yandex.ru/device/code", data={
                    "client_id": "23cabbbdc6cd418abb4b39c32c41195d",
                    "device_id": secrets.token_hex(16), "device_name": "Music Downloader"
                }, timeout=15)
                response.raise_for_status()
                code = response.json()
                if not all(code.get(key) for key in ("device_code", "user_code")):
                    raise ValueError("Яндекс не вернул код входа")
                run_on_ui_thread(lambda: show(code))
            except Exception:
                if not state["cancel"].is_set():
                    self._service_help("Яндекс Музыка", "Не удалось начать вход. Проверь соединение и повтори.")
        def show(code):
            if state["cancel"].is_set():
                return
            from client_utils import get_last_fragment
            from android.widget import LinearLayout, TextView
            from org.telegram.ui.ActionBar import BottomSheet, Theme
            from org.telegram.messenger import AndroidUtilities
            from java import jclass, dynamic_proxy
            fragment = get_last_fragment()
            if fragment is None:
                state["cancel"].set()
                return
            activity = fragment.getParentActivity()
            root = LinearLayout(activity)
            root.setOrientation(1)
            dp = AndroidUtilities.dp
            root.setPadding(dp(20), dp(16), dp(20), dp(20))
            label = TextView(activity)
            label.setText(self._tr("Яндекс Музыка\n\nКод входа: ") + str(code["user_code"]) +
                          self._tr("\n\nВойди в свой аккаунт на странице Яндекса и подтверди код. Плагин получит и сохранит токен автоматически."))
            label.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            label.setTextSize(16.0)
            label.setTextIsSelectable(True)
            root.addView(label)
            # Device verification uses only Yandex's own HTTPS endpoint.
            verification = code.get("verification_url") or code.get("verification_uri") or "https://oauth.yandex.ru/device"
            parsed = urllib.parse.urlsplit(verification)
            if parsed.scheme != "https" or parsed.hostname != "oauth.yandex.ru":
                verification = "https://oauth.yandex.ru/device"
            root.addView(self._rhythm_button(activity, "Войти в аккаунт Яндекса",
                                            lambda: self._open_service_url(verification)))
            builder = BottomSheet.Builder(activity)
            builder.setCustomView(root)
            dialog = builder.create()
            state["dialog"] = dialog
            root.addView(self._rhythm_button(activity, "Отмена / Cancel", dialog.dismiss))
            plugin = self
            class Dismiss(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
                def onDismiss(proxy, dismissed):
                    state["cancel"].set()
                    if plugin._ym_login is state:
                        plugin._ym_login = None
            listener = Dismiss()
            state["listener"] = listener
            dialog.setOnDismissListener(listener)
            dialog.show()
            def poll():
                try:
                    data = _ym_wait_token(code, state["cancel"])
                    if data is None:
                        return
                    account = (ym_request("/account/status", data["access_token"]) or {}).get("account") or {}
                    if not account.get("uid"):
                        raise ValueError("Аккаунт Музыки недоступен")
                    def save():
                        if state["cancel"].is_set():
                            return
                        plugin.set_setting("ym_token", data["access_token"], reload_settings=False)
                        dialog.dismiss()
                        plugin._service_help("Яндекс Музыка", "Подключено. Можно искать и слушать музыку.")
                    run_on_ui_thread(save)
                except Exception:
                    def fail():
                        if not state["cancel"].is_set():
                            label.setText(self._tr("Вход истёк или был отклонён. Закрой окно и попробуй снова."))
                    run_on_ui_thread(fail)
            threading.Thread(target=poll, daemon=True).start()
        threading.Thread(target=request_code, daemon=True).start()

    def _np_rpc(self, account, request):
        from java import dynamic_proxy
        from org.telegram.tgnet import ConnectionsManager, RequestDelegate
        event = threading.Event()
        result = {}
        class Callback(dynamic_proxy(RequestDelegate)):
            def run(proxy, response, error):
                result.update(response=response, error=error)
                event.set()
        callback = Callback()
        request_id = ConnectionsManager.getInstance(account).sendRequest(request, callback)
        if not event.wait(25):
            # Do not retry an uncertain write, which may already have reached Telegram.
            ConnectionsManager.getInstance(account).cancelRequest(request_id, True)
            raise RuntimeError("REQUEST_TIMEOUT")
        error = result["error"]
        if error is not None:
            raise RuntimeError(str(error.text))
        return result["response"]

    def _np_enabled(self):
        return bool(self.get_setting("np_bio", False) or self.get_setting("np_channel", False))

    def _np_option_changed(self, key, value):
        self.set_setting(key, bool(value), reload_settings=False)
        self._np_changed()

    def _np_changed(self, _=None):
        from org.telegram.messenger import UserConfig
        uid = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
        owner = int(self.get_setting("np_owner", 0) or 0)
        if self._np_enabled() and owner != uid:
            if owner:
                self.set_setting("np_bio", False, reload_settings=False)
                self.set_setting("np_channel", False, reload_settings=False)
                self._service_help("Сейчас слушаю", "Статус привязан к другому аккаунту. Сначала отключи его в том аккаунте.")
                return
            self.set_setting("np_owner", uid, reload_settings=False)
        self._np_last_snapshot = None
        self._np_poll()

    def _np_start(self):
        self._np_closed = False
        self._np_lock = threading.Lock()
        self._np_busy = False
        self._np_next = 0
        self._np_last_snapshot = None
        self._np_loop_id = 0
        self._np_schedule()

    def _np_schedule(self):
        from android_utils import run_on_ui_thread
        self._np_loop_id += 1
        token = self._np_loop_id
        def tick():
            if self._np_closed or token != self._np_loop_id:
                return
            try:
                self._eq_tick()
                self._np_poll()
            except Exception as exc:
                self.set_setting("np_error", type(exc).__name__, reload_settings=False)
            finally:
                run_on_ui_thread(tick, 5000)
        run_on_ui_thread(tick, 1000)

    def _np_poll(self):
        if getattr(self, "_np_closed", True) or self._np_busy or time.time() < self._np_next:
            return
        from org.telegram.messenger import UserConfig, MediaController
        owner = int(self.get_setting("np_owner", 0) or 0)
        if not owner and self._np_enabled():
            owner = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
            self.set_setting("np_owner", owner, reload_settings=False)
        if not owner:
            return
        account = None
        for index in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
            if int(UserConfig.getInstance(index).getClientUserId()) == owner:
                account = index
                break
        if account is None:
            return
        media, message = self._current_music()
        track = ""
        paused = False
        title = artist = ""
        position = duration = 0
        if message is not None and int(message.currentAccount) == account:
            artist = str(message.getMusicAuthor() or "").strip()
            title = str(message.getMusicTitle() or "").strip()
            track = " — ".join(value for value in (artist, title) if value).replace("\n", " ")
            paused = bool(media.isMessagePaused())
            position = max(0, int(message.audioProgressSec))
            duration = max(0, int(message.getDuration()))
        bio = bool(self.get_setting("np_bio", False))
        channel = bool(self.get_setting("np_channel", False))
        template = str(self.get_setting("np_template", "Сейчас слушаю: {track}\n{position} — {duration}"))
        timing = position // 15 if channel and any(key in template for key in ("{position}", "{duration}")) else 0
        snapshot = (track, paused, bio, channel, timing, template,
                    str(self.get_setting("np_template_emoji", [])),
                    str(self.get_setting("np_idle_template", "")), str(self.get_setting("np_idle_emoji", [])))
        self._np_current = (track, paused)
        if snapshot == self._np_last_snapshot:
            return
        self._np_busy = True
        def work():
            try:
                with self._np_lock:
                    if self._np_closed:
                        return
                    self._np_publish(account, owner, track, paused, bio, channel, title, artist, position, duration)
                self._np_last_snapshot = snapshot
                self._np_next = time.time() + 15
                self.set_setting("np_error", "", reload_settings=False)
                self.set_setting("np_updated", int(time.time()), reload_settings=False)
            except Exception as exc:
                error = str(exc)
                wait = re.search(r"FLOOD_WAIT_(\d+)", error)
                self._np_next = time.time() + (int(wait[1]) + 2 if wait else 60)
                self.set_setting("np_error", error[:180], reload_settings=False)
                self.logger.error("Now playing: %s", type(exc).__name__)
            finally:
                self._np_busy = False
        threading.Thread(target=work, daemon=True).start()

    def _np_publish(self, account, owner, track, paused, bio, channel, title="", artist="", position=0, duration=0):
        from org.telegram.tgnet import TLRPC
        from org.telegram.messenger import MessagesController
        controller = MessagesController.getInstance(account)
        record = dict(self.get_setting("np_record_" + str(owner), {}) or {})
        key = "np_record_" + str(owner)
        prefix = "На паузе: " if paused else "Слушаю: "
        status = prefix + track if track else ""
        bio_error = None
        try:
            record = self._np_apply_bio(account, owner, controller, record, key, status, bio)
        except Exception as exc:
            bio_error = exc
        target = int(record.get("channel", 0) or 0)
        if channel and not target:
            read = TLRPC.TL_users_getFullUser()
            read.id = TLRPC.TL_inputUserSelf()
            target = int(getattr(self._np_rpc(account, read).full_user, "personal_channel_id", 0) or 0)
            if not target:
                raise ValueError("Привяжи свой канал к профилю Telegram.")
        if target and (channel or record.get("message_id")):
            peer = controller.getInputPeer(-target)
            template = str(self.get_setting("np_template", "Сейчас слушаю: {track}\n{position} — {duration}"))
            clock = lambda value: f"{int(value)//60}:{int(value)%60:02d}"
            values = dict(track=track, title=title, artist=artist, position=clock(position),
                          duration=clock(duration), state=self._tr("Сейчас ничего не играет") if not track else self._tr("На паузе") if paused else self._tr("Слушаю"))
            text, emoji = _channel_template(template, self.get_setting("np_template_emoji", []) or [], values) if channel and status else _channel_template(str(self.get_setting("np_idle_template", self._tr("Сейчас ничего не играет"))), self.get_setting("np_idle_emoji", []) or [], values)
            if not text.strip() or len(text.encode("utf-16-le")) // 2 > 4096:
                raise ValueError("Шаблон пуст или сообщение длиннее 4096 символов.")
            def set_entities(request):
                request.flags |= 8
                for row in emoji:
                    entity = TLRPC.TL_messageEntityCustomEmoji()
                    entity.offset = row["offset"]
                    entity.length = row["length"]
                    entity.document_id = int(row["document_id"])
                    request.entities.add(entity)
            if text != record.get("channel_text") or emoji != record.get("channel_emoji"):

                message_id = int(record.get("message_id", 0) or 0)
                if message_id:
                    request = TLRPC.TL_messages_editMessage()
                    request.peer = peer
                    request.id = message_id
                    request.flags = 2048
                    request.message = text
                    set_entities(request)
                    try:
                        self._np_rpc(account, request)
                    except Exception as exc:
                        if "MESSAGE_NOT_MODIFIED" not in str(exc):
                            raise
                elif channel and status:
                    request = TLRPC.TL_messages_sendMessage()
                    request.peer = peer
                    request.message = text
                    set_entities(request)
                    # Stable ID survives retries and prevents duplicate messages.
                    random_id = int(record.get("random_id", 0) or 0) or secrets.randbits(63)
                    record.update(random_id=random_id, channel=target)
                    self.set_setting(key, record, reload_settings=False)
                    request.random_id = random_id
                    response = self._np_rpc(account, request)
                    message_id = int(getattr(response, "id", 0) or 0)
                    updates = getattr(response, "updates", None)
                    if updates is not None:
                        for index in range(updates.size()):
                            update = updates.get(index)
                            message = getattr(update, "message", None)
                            if message is not None and int(getattr(message, "random_id", 0) or 0) in (0, random_id):
                                message_id = int(message.id)
                            if int(getattr(update, "random_id", 0) or 0) == random_id:
                                message_id = int(update.id)
                    if not message_id:
                        raise RuntimeError("MESSAGE_ID_PENDING")
                    record["message_id"] = message_id
                record.update(channel=target, channel_text=text, channel_emoji=emoji)
                self.set_setting(key, record, reload_settings=False)

        if bio_error is not None:
            raise bio_error

    def _np_apply_bio(self, account, owner, controller, record, key, status, bio):
        from org.telegram.tgnet import TLRPC
        if (bio or record.get("last_bio") is not None) and (record.get("bio_status") != status or record.get("bio_enabled") != bio):
            read = TLRPC.TL_users_getFullUser()
            read.id = TLRPC.TL_inputUserSelf()
            full = self._np_rpc(account, read).full_user
            current = str(full.about or "")
            if "original" not in record:
                record["original"] = current
            last = record.get("last_bio")
            if last is not None and current != last:
                # Preserve edits the user made while broadcasting.
                record["original"] = current
                record.pop("last_bio", None)
            original = record["original"]
            desired = original
            if bio and status:
                try:
                    limit = int(controller.getAboutLimit())
                except Exception:
                    limit = 70
                desired = _np_bio_text(original, status, limit)
            if current != desired:
                try:
                    from org.telegram.tgnet.tl import TL_account
                    update = TL_account.updateProfile()
                except ImportError:
                    update = TLRPC.TL_account_updateProfile()
                update.flags = 4
                update.about = desired
                # Persist intent before writing for recovery after interrupted requests.
                record["last_bio"] = desired
                self.set_setting(key, record, reload_settings=False)
                self._np_rpc(account, update)
                full.about = desired
                cached = controller.getUserFull(owner)
                if cached is not None:
                    cached.about = desired
            if bio and status:
                record["last_bio"] = desired
            else:
                record.pop("last_bio", None)
                record.pop("original", None)
            record.update(bio_status=status, bio_enabled=bio)
            self.set_setting(key, record, reload_settings=False)
        return record

    def _np_shutdown(self):
        self._np_closed = True
        self._np_loop_id += 1
        from android_utils import run_on_ui_thread
        def close_login():
            login = getattr(self, "_ym_login", None)
            if login is not None:
                login["cancel"].set()
                if login.get("dialog") is not None:
                    login["dialog"].dismiss()
        run_on_ui_thread(close_login)
        owner = int(self.get_setting("np_owner", 0) or 0)
        if not owner:
            return
        from org.telegram.messenger import UserConfig
        account = next((index for index in range(int(UserConfig.MAX_ACCOUNT_COUNT))
                        if int(UserConfig.getInstance(index).getClientUserId()) == owner), None)
        if account is None:
            return
        def restore():
            with self._np_lock:
                try:
                    self._np_publish(account, owner, "", False, False, False)
                except Exception as exc:
                    self.set_setting("np_error", str(exc)[:180], reload_settings=False)
        threading.Thread(target=restore, daemon=True).start()

    def _np_status(self):
        error = str(self.get_setting("np_error", "") or "")
        current = getattr(self, "_np_current", ("", False))[0]
        updated = int(self.get_setting("np_updated", 0) or 0)
        if self._lang() == "ru":
            message = ("Включи статус в описании или канале профиля. Запусти музыкальный трек в Telegram. "
                       "Обновление занимает до 15 секунд. В канале редактируется одно сообщение. "
                       "Если места в описании мало, статус временно заменяет его целиком. "
                       "После остановки исходное описание восстанавливается.\n\n"
                       "Текущий трек: " + (current or "Нет") + "\nПоследнее обновление: " +
                       (time.strftime("%H:%M:%S", time.localtime(updated)) if updated else "ещё не было") +
                       "\n" + ("Последняя ошибка: " + error if error else "Ошибок пока нет."))
        else:
            message = ("Enable the profile bio or channel status and play a music track in Telegram. "
                       "Updates can take up to 15 seconds. The channel uses one edited message. "
                       "If the full title does not fit alongside your bio, the status temporarily replaces the bio. "
                       "Your original bio is restored when playback stops.\n\n"
                       "Current track: " + (current or "None") + "\nLast update: " +
                       (time.strftime("%H:%M:%S", time.localtime(updated)) if updated else "Not yet") +
                       "\n" + ("Last error: " + self._tr(error) if error else "No errors recorded."))
        self._service_help(self._tr("Сейчас слушаю"), message)

    def _search_kw(self) -> Dict:
        try:
            spotify_token = self._spotify_token() if self._svc() == SERVICE_SP else str(self.get_setting("sp_access", "")).strip()
        except Exception:
            spotify_token = str(self.get_setting("sp_access", "")).strip()
        return {"sc_cid": self._sc_cid(), "sp_token": spotify_token, "ym_token": str(self.get_setting("ym_token", "")).strip(), "td_token": self._td_tok()}

    # ── favorites helpers ─────────────────────────────────────────────────────

    def _get_favs(self) -> List[Dict]:
        v = self.get_setting("liked_tracks",[])
        return v if isinstance(v, list) else []

    def _save_favs(self, items: List[Dict]) -> None:
        self.set_setting("liked_tracks", items, reload_settings=False)

    def _trim_favs(self, items: List[Dict]) -> List[Dict]:
        try: cap = int(self.get_setting("favorites_cap","200"))
        except: cap = 200
        return items[:max(10,min(cap,1000))]

    def _track_rec(self, t: Dict, query: str = "") -> Dict:
        return {
            "id":t.get("id"), "urn":t.get("urn",""), "title":t.get("title",""),
            "artist":t.get("artist",""), "duration":t.get("duration",""),
            "genre":t.get("genre",""), "year":t.get("year",""),
            "plays":t.get("plays",0), "likes":t.get("likes",0),
            "artwork_url":t.get("artwork_url",""), "service":t.get("service",SERVICE_SC),
            "query":query, "liked_at":_now_ts(), "like_count":1,
        }

    def _upsert_fav(self, t: Dict, query: str = "", delta: int = 1) -> Dict:
        with _locks["likes"]:
            favs = self._get_favs(); tid = t.get("id")
            for item in favs:
                if item.get("id") == tid:
                    item["like_count"] = max(1, int(item.get("like_count",1))+delta)
                    item["liked_at"]   = _now_ts()
                    for k in ("title","artist","duration","genre","year","plays","likes","artwork_url","service","urn"):
                        if t.get(k) is not None: item[k] = t[k]
                    if query: item["query"] = query
                    favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
                    self._save_favs(self._trim_favs(favs))
                    return item
            saved = self._track_rec(t, query=query)
            favs.insert(0, saved)
            favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
            self._save_favs(self._trim_favs(favs))
            return saved

    def _remove_fav(self, tid) -> bool:
        with _locks["likes"]:
            favs = self._get_favs(); before = len(favs)
            favs = [x for x in favs if x.get("id") != tid]
            if len(favs) == before: return False
            self._save_favs(favs); return True

    def _show_favs_page(self, pid, page: int):
        favs = self._get_favs()
        favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
        per_page = self._per_page()
        lang = self._lang()
        _search_sessions[pid] = {
            "mode": "favs", "results": favs, "page": page,
            "per_page": per_page, "lang": lang,
        }
        send_text(pid, build_favs_page(favs, page, per_page, lang))

    def _guide_show(self):
        if self.get_setting("guide_accepted_v1", False): return
        try:
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            from android_utils import run_on_ui_thread
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if not activity: return
            guide = AlertDialogBuilder(activity)
            guide.set_title(self._ui("Music Downloader — как пользоваться"))
            guide.set_message(self._ui("Открой нужный чат и отправь команду .search — сообщение не появится в чате.\n\nВведи название, выбери сервис и нажми «Искать». Выбери трек, чтобы отправить его в текущий чат.\n\nБитрейт SoundCloud можно изменить в настройках плагина. Прежние команды .find и dlf также работают."))
            def accept(b, which):
                b.dismiss()
                def confirm():
                    box = AlertDialogBuilder(activity)
                    box.set_title(self._ui("Ты точно понял, как пользоваться?"))
                    box.set_message(self._ui("Учти, больше это окно ты не увидишь."))
                    def yes(dialog, n):
                        self.set_setting("guide_accepted_v1", True, reload_settings=False)
                        dialog.dismiss()
                    def again(dialog, n):
                        dialog.dismiss(); run_on_ui_thread(self._guide_show, 100)
                    box.set_positive_button(self._ui("Да да, я понял"), yes)
                    box.set_negative_button(self._ui("Погоди, я не понял"), again)
                    box.show()
                run_on_ui_thread(confirm, 100)
            guide.set_positive_button(self._ui("Принял"), accept)
            guide.show()
        except Exception as exc:
            try: self.logger.error("Music Downloader guide: %s", exc)
            except: pass

    def _ui_number(self, key, default, low, high):
        try:
            return min(high, max(low, int(self.get_setting(key, str(default)))))
        except (TypeError, ValueError):
            return default

    def _ui_color(self, key, fallback):
        value = str(self.get_setting(key, '')).strip().lstrip('#')
        if re.fullmatch(r'[0-9a-fA-F]{6}', value):
            return int(value, 16) - 0x1000000
        return fallback

    def _open_search_ui(self, pid, source_fragment=None, screen=None, context=None):
        standalone = screen is not None
        from android_utils import run_on_ui_thread, OnClickListener
        from client_utils import get_last_fragment
        from ui.alert import AlertDialogBuilder
        from android.widget import LinearLayout, TextView, EditText, ScrollView, ImageView, FrameLayout, ProgressBar
        from android.view import Gravity
        from android.graphics.drawable import GradientDrawable, RippleDrawable, ShapeDrawable
        from android.graphics.drawable.shapes import PathShape
        from android.graphics import Path
        from android.content.res import ColorStateList
        from android.view.animation import DecelerateInterpolator
        from java import dynamic_proxy, jclass
        from org.telegram.messenger import AndroidUtilities, MediaDataController, UserConfig
        from org.telegram.ui.Components import BackupImageView
        from org.telegram.ui.ActionBar import BottomSheet, Theme
        fragment = source_fragment or get_last_fragment()
        activity = context or (fragment.getParentActivity() if fragment else None)
        if not activity: return
        dp=AndroidUtilities.dp
        def color(key, fallback):
            try: return Theme.getColor(getattr(Theme, key))
            except Exception: return fallback
        primary=self._ui_color('ui_text', color('key_dialogTextBlack', -1))
        secondary=self._ui_color('ui_secondary', color('key_dialogTextGray', -7829368))
        surface=self._ui_color('ui_surface', color('key_dialogBackground', -14671580))
        accent=self._ui_color('ui_accent', color('key_windowBackgroundWhiteBlueText', -10053121))
        field_bg=self._ui_color('ui_card', color('key_windowBackgroundGray', -13421773))
        padding=self._ui_number('ui_padding', 16, 8, 32)
        radius=self._ui_number('ui_radius', 16, 0, 32)
        font_delta=self._ui_number('ui_font', 0, -3, 6)
        row_height=self._ui_number('ui_row', 58, 52, 90)
        def background(fill, radius=radius):
            d=GradientDrawable(); d.setColor(fill); d.setCornerRadius(float(dp(radius))); return d
        root=LinearLayout(activity); root.setOrientation(1); root.setPadding(dp(padding),dp(4),dp(padding),dp(12))
        state={'service':self._svc(),'query':'','page':0,'results':[],'closed':False,'generation':0,'sheet':None,'player':None,'player_token':0,'player_callbacks':[], 'preview_id':None,'preview_button':None, 'service_menu_open':False}
        scroll=ScrollView(activity); scroll.setFillViewport(False); scroll.addView(root)
        if standalone:
            sheet = None
            screen_root = LinearLayout(activity)
            screen_root.setOrientation(1)
            screen_root.setBackgroundColor(surface)
            toolbar = LinearLayout(activity)
            toolbar.setGravity(Gravity.CENTER_VERTICAL)
            toolbar.setPadding(dp(padding), 0, dp(padding), 0)
            screen_root.addView(toolbar, LinearLayout.LayoutParams(-1, dp(56)))
            screen_root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))
            scroll.setFillViewport(True)
        else:
            root.setBackgroundColor(surface)
            compact_root = LinearLayout(activity)
            compact_root.setOrientation(1)
            compact_root.setBackgroundColor(surface)
            builder=BottomSheet.Builder(activity); builder.setCustomView(compact_root)
            sheet=builder.create(); sheet.setFocusable(True)
        state['sheet']=sheet
        def set_preview_icon(view, mode):
            # API overloads differ between Android builds; a failed icon must not
            # interrupt rendering any result or disable the play button.
            spinner=view.getTag()
            if spinner is not None: spinner.setVisibility(0 if mode == 'loading' else 8)
            view.setVisibility(4 if mode == 'loading' else 0)
            view.setContentDescription(self._ui('Загружается аудио') if mode == 'loading' else self._ui('Остановить предпрослушивание') if mode == 'stop' else self._ui('Слушать трек'))
            if mode == 'loading': return
            try:
                shape=Path()
                if mode == 'stop':
                    shape.moveTo(5.0,5.0);shape.lineTo(19.0,5.0);shape.lineTo(19.0,19.0);shape.lineTo(5.0,19.0);shape.close()
                else:
                    shape.moveTo(7.0,3.0);shape.lineTo(20.0,12.0);shape.lineTo(7.0,21.0);shape.close()
                drawable=ShapeDrawable(PathShape(shape,24.0,24.0));drawable.getPaint().setColor(accent)
                view.setImageDrawable(drawable)
            except Exception:
                try:
                    resources=jclass('android.R$drawable')
                    view.setImageResource(resources.ic_media_pause if mode == 'stop' else resources.ic_media_play)
                    view.setColorFilter(accent)
                except Exception: pass
        def show_preview_error(message):
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(self._ui('Предпрослушивание: ')+str(message)[:160])
            except Exception:
                try: self.logger.error('Preview: %s',str(message)[:200])
                except Exception: pass
        def stop_preview():
            state['player_token'] += 1
            player=state.get('player');state['player']=None;state['preview_id']=None
            button=state.get('preview_button');state['preview_button']=None
            if button is not None:
                try: set_preview_icon(button,'play')
                except Exception: pass
            if player is not None:
                try: player.reset();player.release()
                except Exception:
                    try: player.release()
                    except Exception: pass
            manager=state.pop('audio_manager',None);focus=state.pop('audio_focus',None)
            if manager is not None and focus is not None:
                try: manager.abandonAudioFocus(focus)
                except Exception: pass
            state['player_callbacks']=[]
            path=state.pop('preview_path',None)
            if path:
                try: os.unlink(path)
                except OSError: pass
        def on_sheet_closed():
            state['closed']=True;state['generation']+=1;stop_preview()
            clear()
        class OnClose(dynamic_proxy(jclass('android.content.DialogInterface$OnDismissListener'))):
            def onDismiss(self, dialog): on_sheet_closed()
        def close_search():
            if standalone:
                screen.java.finishFragment()
            else:
                sheet.dismiss()
        if standalone:
            screen.cleanup = on_sheet_closed
            screen.stop_preview = stop_preview
        else:
            state['dismiss_listener']=OnClose();sheet.setOnDismissListener(state['dismiss_listener'])
        def preview(item, button):
            if state['preview_id'] == item.get('id'):
                stop_preview(); return
            stop_preview()
            state['preview_id']=item.get('id');state['preview_button']=button;set_preview_icon(button,'loading')
            token=state['player_token']
            def resolve():
                try:
                    service=item.get('service',SERVICE_SC)
                    if service==SERVICE_SP:
                        path=item.get('preview_url')
                        if not path:
                            token_sp=self._spotify_token()
                            if not token_sp and self._sp_dc(): token_sp,_=_sp_user_token(self._sp_dc())
                            if token_sp:
                                response=requests.get(f"{SP_API}/tracks/{item['id']}",headers=_sp_headers(token_sp),timeout=12)
                                response.raise_for_status();path=response.json().get('preview_url')
                        if not path: raise ValueError(self._ui('Spotify не предоставил превью для этого трека'))
                    elif service==SERVICE_YM:
                        path=ym_stream(item["id"], str(self.get_setting("ym_token", "")).strip())
                    elif service==SERVICE_TD:
                        path,err=td_stream(item['id'],custom_token=self._td_tok())
                        if not path: raise ValueError(err or self._ui('Tidal не предоставил поток для прослушивания'))
                    else:
                        stream,err=sc_stream(item['id'],custom=self._sc_cid())
                        if not stream: raise ValueError(err or self._ui('Поток недоступен'))
                        # Use exactly the same AAC decoder and MP3 encoder which is
                        # already used by downloads, avoiding unsupported raw HLS containers.
                        cache_dir=str(activity.getCacheDir().getAbsolutePath())
                        fd,path=tempfile.mkstemp(prefix='music_preview_',suffix='.mp3',dir=cache_dir)
                        os.close(fd)
                        try:
                            _sc_download_mp3(stream,path,128)
                        except Exception:
                            try: os.unlink(path)
                            except OSError: pass
                            raise
                    def play():
                        if state['closed'] or token!=state['player_token']:
                            if service==SERVICE_SC:
                                try: os.unlink(path)
                                except OSError: pass
                            return
                        state['preview_path']=path if service==SERVICE_SC else None
                        try:
                            MediaPlayer=jclass('android.media.MediaPlayer')
                            AudioManager=jclass('android.media.AudioManager')
                            Context=jclass('android.content.Context')
                            class FocusChange(dynamic_proxy(jclass('android.media.AudioManager$OnAudioFocusChangeListener'))):
                                def onAudioFocusChange(self, change):
                                    if change < 0: run_on_ui_thread(stop_preview)
                            focus=FocusChange();manager=activity.getSystemService(Context.AUDIO_SERVICE)
                            if manager.requestAudioFocus(focus,AudioManager.STREAM_MUSIC,AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK) != AudioManager.AUDIOFOCUS_REQUEST_GRANTED:
                                stop_preview();show_preview_error(self._ui('Звук занят другим приложением'));return
                            state['audio_manager']=manager;state['audio_focus']=focus
                            player=MediaPlayer();state['player']=player
                            try: self._eq_external=player
                            except Exception: pass
                            class Prepared(dynamic_proxy(jclass('android.media.MediaPlayer$OnPreparedListener'))):
                                def onPrepared(self, mp):
                                    if token!=state['player_token'] or state['closed']: return
                                    try: mp.start();set_preview_icon(button,'stop')
                                    except Exception: stop_preview()
                            class Complete(dynamic_proxy(jclass('android.media.MediaPlayer$OnCompletionListener'))):
                                def onCompletion(self, mp): stop_preview()
                            class Failed(dynamic_proxy(jclass('android.media.MediaPlayer$OnErrorListener'))):
                                def onError(proxy, mp, what, extra):
                                    stop_preview();show_preview_error(self._ui('Плеер Android не смог открыть аудио (код %s, %s)') % (what, extra));return True
                            prepared,complete,failed=Prepared(),Complete(),Failed()
                            state['player_callbacks']=[prepared,complete,failed,focus]
                            player.setOnPreparedListener(prepared);player.setOnCompletionListener(complete);player.setOnErrorListener(failed)
                            player.setDataSource(path);player.prepareAsync()
                        except Exception as exc:
                            message=str(exc);stop_preview();show_preview_error(message)
                    run_on_ui_thread(play)
                except Exception as exc:
                    message=str(exc)
                    def fail():
                        if token == state['player_token'] and not state['closed']:
                            stop_preview();show_preview_error(message)
                    run_on_ui_thread(fail)
            run_on_queue(resolve)
        def params(w=-1,h=-2,weight=0): return LinearLayout.LayoutParams(w,h,float(weight))
        def clear():
            logo = state.pop('logo', None)
            if logo is not None:
                root.removeView(logo)
                logo.stopLoading()
                logo.destroy()
            root.removeAllViews()
        def row():
            v=LinearLayout(activity); v.setOrientation(0); v.setGravity(Gravity.CENTER_VERTICAL); root.addView(v); return v
        def label(parent,value,size=15,tint=None):
            v=TextView(activity); v.setText(str(value)); v.setTextSize(float(size + font_delta)); v.setTextColor(primary if tint is None else tint); parent.addView(v); return v
        def click(v, callback, fill=None):
            ripple_color = color('key_listSelector', 0x334c8bf5)
            try:
                shape = background(field_bg if fill is None else fill, 16)
                v.setBackground(RippleDrawable(ColorStateList.valueOf(ripple_color), shape, None))
            except Exception:
                v.setBackground(background(field_bg if fill is None else fill,16))
            v.setClickable(True)
            v.setOnClickListener(OnClickListener(lambda _:callback()))
        def text_button(parent,value, callback, width=-2):
            v=TextView(activity); v.setText(value); v.setTextSize(float(14 + font_delta)); v.setTextColor(accent); v.setGravity(Gravity.CENTER); v.setPadding(dp(12),dp(8),dp(12),dp(8)); parent.addView(v,params(width,dp(44))); click(v,callback); return v
        def sticker(index, height=76):
            if not self.get_setting('ui_stickers', True):
                trigger = label(root, '♫', 22, accent)
                trigger.setGravity(Gravity.CENTER)
                self._bind_rhythm_secret(trigger)
                return
            height = self._ui_number('ui_sticker_size', height, 40, 120)
            try:
                image=BackupImageView(activity); lp=params(dp(height),dp(height));lp.gravity=Gravity.CENTER_HORIZONTAL;root.addView(image,lp)
                self._bind_rhythm_secret(image)
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(image,'SpottyAnimated',index,'130_130')
            except Exception: pass
        def status(title,index,detail=''):
            clear(); sticker(index); v=label(root,title,18);v.setGravity(Gravity.CENTER);v.setPadding(0,dp(4),0,dp(4))
            if detail:
                v=label(root,detail,13,secondary);v.setGravity(Gravity.CENTER);v.setPadding(0,0,0,dp(6))
        def form():
            stop_preview();clear(); sticker(30,70)
            v=label(root,self._ui('Что ищем?'),19);v.setPadding(0,0,0,dp(4))
            line=row(); field=EditText(activity);field.setSingleLine(True);field.setTextSize(float(15 + font_delta));field.setTextColor(primary);field.setHintTextColor(secondary);field.setHint(self._ui('Название или исполнитель'));field.setText(state['query']);field.setPadding(dp(14),0,dp(10),0);field.setBackground(background(field_bg,16));line.addView(field,params(0,dp(48),1))
            def submit():
                query=str(field.getText()).strip()
                if not query: field.setError(self._ui('Введите название песни')); return
                AndroidUtilities.hideKeyboard(field)
                search(query)
            def search(query):
                state['query']=query;state['generation']+=1; generation=state['generation']; svc=state['service']
                status(self._ui('Ищем вашу песню…'),31)
                text_button(row(), self._ui('Отмена'), lambda: cancel_search())
                def task():
                    try:
                        kwargs = self._search_kw()
                        if svc == SERVICE_SP:
                            kwargs["sp_token"] = self._spotify_token()
                        results,err=service_search(svc,query,self._limit(),**kwargs)
                        def render():
                            if state['closed'] or generation!=state['generation']: return
                            if err: error(err);return
                            if not results:
                                status(self._ui('Ничего не найдено'),14); footer=row();text_button(footer,self._ui('Новый поиск'),form);return
                            state['results']=results;state['page']=0;results_page()
                        run_on_ui_thread(render)
                    except Exception as exc:
                        message=str(exc)
                        run_on_ui_thread(lambda: error(message) if not state['closed'] and generation==state['generation'] else None)
                run_on_queue(task)
            def cancel_search():
                state['generation'] += 1
                form()
            state['retry'] = search
            text_button(line,self._ui('Искать'),submit)
            if standalone and self.get_setting('ui_record', True): self._show_rhythm_record(root)
            service_line=row(); label(service_line,self._ui('Сервис'),13,secondary)
            def open_services():
                state['service_menu_open']=not state['service_menu_open']
                menu.setVisibility(0 if state['service_menu_open'] else 8)
                if state['service_menu_open']:
                    menu.setAlpha(0.0);menu.animate().alpha(1.0).setDuration(180).start()
            service=text_button(service_line,SERVICE_NAMES[state['service']],open_services)
            menu=LinearLayout(activity);menu.setOrientation(1);menu.setPadding(dp(4),dp(4),dp(4),dp(4));menu.setBackground(background(surface,16));root.addView(menu,params(-1,-2));menu.setVisibility(8)
            for code in (SERVICE_SC,SERVICE_SP,SERVICE_TD,SERVICE_YM):
                option=TextView(activity);option.setText(SERVICE_NAMES[code]);option.setTextColor(primary);option.setTextSize(15.0);option.setGravity(Gravity.CENTER_VERTICAL);option.setPadding(dp(16),0,dp(16),0);menu.addView(option,params(-1,dp(44)))
                def select(value=code):
                    state['service']=value;service.setText(SERVICE_NAMES[value]);state['service_menu_open']=False;menu.setVisibility(8)
                click(option,select,surface)
        def error(message):
            status(self._ui('Произошла ошибка'),18,str(message)[:250]+self._ui('\nСообщите @S1mclick'));actions=row();text_button(actions,self._ui('Повторить'),lambda:state['retry'](state['query']));text_button(actions,self._ui('Изменить'),form)
        def choose(item):
            stop_preview();box=AlertDialogBuilder(activity);box.set_title(self._ui('Отправить трек?'));box.set_message(item.get('title','')+' — '+item.get('artist',''))
            selected_account=int(UserConfig.selectedAccount)
            def send_to(target):
                if int(UserConfig.selectedAccount)!=selected_account:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error(self._ui('Аккаунт изменился. Открой поиск и выбери чат заново.'))
                    return
                if not standalone: close_search()
                tr=dict(item);tr['query']=state['query']
                run_on_ui_thread(lambda:self._download_with_progress(target,tr,selected_account), 250)
            def send_here(b,n):
                b.dismiss();send_to(pid)
            def pick_chat(b,n):
                b.dismiss()
                def picker_error(message):
                    try:
                        from ui.bulletin import BulletinHelper
                        BulletinHelper.show_error(self._ui('Выбор чата: ')+str(message)[:160])
                    except Exception:
                        try: self.logger.error('Chat picker: %s',message)
                        except Exception: pass
                def open_picker():
                    try:
                        Bundle=jclass('android.os.Bundle')
                        DialogsActivity=jclass('org.telegram.ui.DialogsActivity')
                        Delegate=jclass('org.telegram.ui.DialogsActivity$DialogsActivityDelegate')
                        args=Bundle();args.putBoolean('onlySelect',True);args.putBoolean('allowSwitchAccount',False);args.putBoolean('canSelectTopics',False)
                        picker=DialogsActivity(args)
                        class ChatSelection(dynamic_proxy(Delegate)):
                            def didSelectDialogs(proxy, picker_fragment, dialogs, *rest):
                                try:
                                    if dialogs is None or dialogs.size() < 1:
                                        picker_error(self._ui('Чат не выбран'));return False
                                    if dialogs.size() != 1:
                                        picker_error(self._ui('Выбери один чат'));return False
                                    selected=dialogs.get(0)
                                    try: target=int(selected.dialogId)
                                    except Exception:
                                        try: target=int(selected.longValue())
                                        except Exception: raise ValueError(self._ui('не удалось определить выбранный чат'))
                                    try: topic=int(selected.topicId)
                                    except Exception: topic=0
                                    if topic:
                                        picker_error(self._ui('Отправка в темы пока не поддерживается'));return False
                                    if not target:
                                        picker_error(self._ui('не удалось определить выбранный чат'));return False
                                    if int(UserConfig.selectedAccount)!=selected_account:
                                        picker_error(self._ui('аккаунт изменился. Выбери чат заново'));return False
                                    try:
                                        MessagesController=jclass('org.telegram.messenger.MessagesController')
                                        controller=MessagesController.getInstance(selected_account)
                                        if target > 0:
                                            user=controller.getUser(target)
                                            selected_name=((str(user.first_name or '')+' '+str(user.last_name or '')).strip() if user else '')
                                        else:
                                            chat=controller.getChat(-target)
                                            selected_name=str(chat.title or '') if chat else ''
                                        if not selected_name: selected_name=self._ui('Чат ')+str(target)
                                    except Exception: selected_name=self._ui('Чат ')+str(target)
                                    def show_confirmation():
                                        try:
                                            picker_activity=picker_fragment.getParentActivity()
                                            if not picker_activity: raise ValueError(self._ui('окно выбора уже закрыто'))
                                            confirm=AlertDialogBuilder(picker_activity);confirm.set_title(self._ui('Отправить трек?'))
                                            confirm.set_message(item.get('title','')+' — '+item.get('artist','')+self._ui('\n\nКуда: ')+selected_name)
                                            def confirmed(dialog,which):
                                                dialog.dismiss()
                                                if int(UserConfig.selectedAccount)!=selected_account:
                                                    picker_error(self._ui('аккаунт изменился, отправка отменена'));return
                                                try: picker_fragment.finishFragment()
                                                except Exception: pass
                                                self._music_picker_delegate=None;self._music_picker=None
                                                send_to(target)
                                            confirm.set_positive_button(self._ui('Отправить'),confirmed)
                                            confirm.set_negative_button(self._ui('Отмена'),lambda dialog,which:dialog.dismiss())
                                            confirm.show()
                                        except Exception as exc: picker_error(exc)
                                    run_on_ui_thread(show_confirmation, 100)
                                    return False
                                except Exception as exc:
                                    picker_error(exc);return False
                        delegate=ChatSelection()
                        # Keep both Java and Python peers alive after the search sheet closes.
                        self._music_picker_delegate=delegate;self._music_picker=picker
                        picker.setDelegate(delegate)
                        opened=(screen.java if standalone else fragment).presentFragment(picker)
                        if opened is False: raise ValueError(self._ui('экран чатов не открылся'))
                        if not standalone: sheet.dismiss()
                    except Exception as exc: picker_error(exc)
                # Opening a fragment from an AlertDialog click can race the dismiss animation.
                run_on_ui_thread(open_picker, 250)
            if pid:
                box.set_positive_button(self._ui('Отправить сюда'),send_here)
                box.set_neutral_button(self._ui('Другой чат'),pick_chat)
            else:
                box.set_positive_button(self._ui('Другой чат'),pick_chat)
            box.set_negative_button(self._ui('Отмена'),lambda b,n:b.dismiss());box.show()
        def results_page():
            clear();line=row();v=label(line,self._ui('Результаты'),19);v.setLayoutParams(params(0,dp(44),1))
            try:
                image=BackupImageView(activity);line.addView(image,params(dp(44),dp(44)))
                self._bind_rhythm_secret(image)
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(image,'SpottyAnimated',27,'80_80')
            except Exception: pass
            text_button(line,self._ui('Изменить'),form)
            page_size=self._per_page()
            total=len(state['results']);p=state['page'];start=p*page_size
            for item in state['results'][start:start+page_size]:
                outer=LinearLayout(activity);outer.setOrientation(0);outer.setGravity(Gravity.CENTER_VERTICAL);outer.setBackground(background(field_bg));lp=params(-1,dp(row_height));lp.bottomMargin=dp(self._ui_number("ui_gap", 4, 0, 16));root.addView(outer,lp)
                cell=LinearLayout(activity);cell.setOrientation(1);cell.setPadding(dp(12),dp(5),dp(4),dp(5));outer.addView(cell,params(0,-1,1))
                a=label(cell,item.get('title',''),15);a.setSingleLine(True)
                sub=item.get('artist','')+('  ·  '+item['duration'] if item.get('duration') else '');b=label(cell,sub,12,secondary);b.setSingleLine(True)
                click(cell,lambda tr=item:choose(tr),field_bg)
                play_frame=FrameLayout(activity);outer.addView(play_frame,params(dp(52),dp(52)))
                play_button=ImageView(activity);play_button.setPadding(dp(12),dp(12),dp(12),dp(12));play_frame.addView(play_button,FrameLayout.LayoutParams(-1,-1))
                spinner=ProgressBar(activity)
                progress_params=FrameLayout.LayoutParams(dp(24),dp(24),Gravity.CENTER);play_frame.addView(spinner,progress_params);spinner.setVisibility(8)
                try: spinner.setIndeterminateTintList(ColorStateList.valueOf(accent))
                except Exception: pass
                play_button.setTag(spinner)
                click(play_frame,lambda tr=item, control=play_button:preview(tr,control),field_bg)
                set_preview_icon(play_button,'play')
            nav=row();pages=max(1,(total+page_size-1)//page_size)
            def move(delta):
                stop_preview()
                state['page']=max(0,min(pages-1,state['page']+delta))
                results_page()
                root.setTranslationX(float(dp(28) * (1 if delta > 0 else -1)))
                root.setAlpha(0.35)
                root.animate().translationX(0.0).alpha(1.0).setDuration(320).setInterpolator(DecelerateInterpolator()).start()
            if p>0:
                text_button(nav,self._ui('Назад'),lambda:move(-1),dp(88))
            else:
                placeholder=TextView(activity);placeholder.setVisibility(4);nav.addView(placeholder,params(dp(88),dp(44)))
            counter=label(nav,str(p+1)+' / '+str(pages),13,secondary);counter.setGravity(Gravity.CENTER);counter.setLayoutParams(params(0,dp(40),1))
            if p+1<pages:
                text_button(nav,self._ui('Далее'),lambda:move(1),dp(88))
            else:
                placeholder=TextView(activity);placeholder.setVisibility(4);nav.addView(placeholder,params(dp(88),dp(44)))
        if standalone:
            back = text_button(toolbar, '‹', close_search, dp(48))
            back.setContentDescription(self._ui('Назад'))
            title = label(toolbar, self._ui('Музыка · Beta'), 20)
            title.setLayoutParams(params(0, -2, 1))
            title.setPadding(dp(12), 0, 0, 0)
            text_button(toolbar, self._ui('Искать'), form)
            settings = ImageView(activity)
            settings.setImageResource(jclass('org.telegram.messenger.R$drawable').msg_settings)
            settings.setColorFilter(accent)
            settings.setPadding(dp(12), dp(12), dp(12), dp(12))
            settings.setContentDescription(self._tr('Настройки плагина'))
            toolbar.addView(settings, params(dp(48), dp(48)))
            click(settings, self._open_plugin_settings)
        if not standalone:
            compact_bar = LinearLayout(activity)
            compact_bar.setGravity(Gravity.CENTER_VERTICAL)
            compact_bar.setPadding(dp(padding), 0, dp(padding), 0)
            compact_title = TextView(activity)
            compact_title.setText('Music Downloader')
            self._bind_rhythm_secret(compact_title)
            compact_title.setTextSize(18.0)
            compact_title.setTextColor(primary)
            compact_bar.addView(compact_title, params(0, dp(48), 1))
            compact_settings = ImageView(activity)
            compact_settings.setImageResource(jclass('org.telegram.messenger.R$drawable').msg_settings)
            compact_settings.setColorFilter(accent)
            compact_settings.setPadding(dp(12), dp(12), dp(12), dp(12))
            compact_settings.setContentDescription(self._tr('Настройки плагина'))
            compact_bar.addView(compact_settings, params(dp(48), dp(48)))
            def open_compact_settings():
                sheet.dismiss()
                run_on_ui_thread(self._open_plugin_settings, 220)
            click(compact_settings, open_compact_settings)
            compact_root.addView(compact_bar, params(-1, dp(52)))
            compact_root.addView(scroll, params(-1, -2))
        form()
        if standalone:
            return screen_root
        sheet.show()

    def _rhythm_button(self, context, text, action, tint=None):
        from android.widget import TextView
        from android.view import Gravity
        from android.graphics.drawable import GradientDrawable, RippleDrawable
        from android.content.res import ColorStateList
        from android_utils import OnClickListener
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme

        dp = AndroidUtilities.dp
        view = TextView(context)
        view.setText(self._tr(text))
        view.setTextSize(15.0)
        view.setTextColor(tint if tint is not None else Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        view.setGravity(Gravity.CENTER)
        view.setMinHeight(dp(48))
        fill = GradientDrawable()
        fill.setColor(Theme.getColor(Theme.key_windowBackgroundGray))
        fill.setCornerRadius(float(dp(16)))
        view.setBackground(RippleDrawable(ColorStateList.valueOf(Theme.getColor(Theme.key_listSelector)), fill, None))
        view.setOnClickListener(OnClickListener(lambda _: action()))
        return view

    def _bind_rhythm_secret(self, view):
        from android_utils import OnClickListener
        count, previous = 0, 0

        def tap(_):
            nonlocal count, previous
            now = time.monotonic()
            count = count + 1 if now - previous < 0.8 else 1
            previous = now
            if count == 3:
                count = 0
                try:
                    self._play_sdwg(view.getContext(), lambda: None)
                except Exception as exc:
                    from ui.bulletin import BulletinHelper
                    self.logger.error('SDWG open: %s', exc)
                    BulletinHelper.show_error(self._ui('Не удалось открыть SDWG Rhythm') + ' · ' + str(exc)[:140])

        view.setOnClickListener(OnClickListener(tap))

    def _show_rhythm_record(self, parent):
        from android.widget import TextView
        from org.telegram.ui.ActionBar import Theme
        best = self.get_setting('sdwg_records', {}).get('best') or {}
        record = TextView(parent.getContext())
        record.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        details = self._rhythm_score_text(best) if best else self._ui('Сыграй первый раунд')
        record.setText(self._ui('Личный рекорд') + '\n' + details)
        parent.addView(record)

    def _rhythm_score_text(self, entry):
        return f"{entry['score']}  ·  {entry['accuracy']}%  ·  ×{entry['combo']}\n{entry['title']}"

    def _play_sdwg(self, context, on_result):
        from android_utils import run_on_ui_thread
        from android.widget import LinearLayout, TextView, FrameLayout, ScrollView
        from android.view import Gravity
        from java import jclass, dynamic_proxy
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme

        dp = AndroidUtilities.dp
        from org.telegram.ui.ActionBar import BottomSheet
        layout = LinearLayout(context)
        layout.setOrientation(1)
        layout.setPadding(dp(12), dp(12), dp(12), dp(12))
        layout.setBackgroundColor(Theme.getColor(Theme.key_dialogBackground))
        builder = BottomSheet.Builder(context)
        builder.setCustomView(layout)
        dialog = builder.create()
        header = TextView(context)
        header.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        header.setGravity(Gravity.CENTER)
        header.setTextSize(16.0)
        layout.addView(header)
        choices = LinearLayout(context)
        choices.setOrientation(1)
        list_scroll = ScrollView(context)
        list_scroll.addView(choices)
        layout.addView(list_scroll, LinearLayout.LayoutParams(-1, dp(280)))
        field = FrameLayout(context)
        field.setBackgroundColor(self._ui_color('ui_game_bg', 0xff171425 - 2**32))
        field_height = self._ui_number('ui_game_height', 192, 150, 300)
        layout.addView(field, LinearLayout.LayoutParams(-1, dp(field_height)))
        controls = LinearLayout(context)
        layout.addView(controls)
        retry = self._rhythm_button(context, self._ui('Выбрать трек'), lambda: reopen())
        layout.addView(retry)
        state = {'closed': False, 'player': None, 'path': None, 'notes': [], 'running': False,
                 'score': 0, 'combo': 0, 'best_combo': 0, 'judgment': ''}
        sessions = getattr(self, '_rhythm_sessions', None)
        if sessions is None:
            sessions = self._rhythm_sessions = set()

        def release():
            state['running'] = False
            player, state['player'] = state['player'], None
            if player is not None:
                player.release()
            path, state['path'] = state['path'], None
            if path:
                try: os.unlink(path)
                except OSError: pass

        def close():
            if not state['closed']:
                state['closed'] = True
                release()
                sessions.discard(close)
                dialog.dismiss()

        class Dismiss(dynamic_proxy(jclass('android.content.DialogInterface$OnDismissListener'))):
            def onDismiss(proxy, view):
                close()

        listener = Dismiss()
        dialog.setOnDismissListener(listener)
        sessions.add(close)

        def finish():
            release()
            field.setVisibility(8)
            controls.setVisibility(8)
            retry.setVisibility(0)
            accuracy = round(100 * state['score'] / len(state['notes']))
            item = dict(score=round(10000 * state['score'] / len(state['notes'])),
                        accuracy=accuracy, combo=state['best_combo'], title=state['title'])
            records = self.get_setting('sdwg_records', {})
            tracks = records.get('tracks', {})
            tid = state['track_id']
            rank = lambda result: (result.get('score', 0), result.get('combo', 0))
            best = records.get('best') or {}
            personal = not best or rank(item) > rank(best)
            track_best = tid not in tracks or rank(item) > rank(tracks[tid])
            if track_best:
                tracks[tid] = item
            if personal or track_best:
                self.set_setting('sdwg_records', {'best': item if personal else best, 'tracks': tracks}, reload_settings=False)
            headline = 'Новый личный рекорд!' if personal else 'Новый рекорд трека!' if track_best else 'Раунд завершён'
            header.setText(self._ui(headline) + '\n' + self._rhythm_score_text(item))
            on_result()

        arrows = ('←', '↓', '↑', '→')
        colors = tuple(self._ui_color(f"ui_lane_{lane}", default)
                       for lane, default in enumerate((-3113217, -11206661, -65368, -6819841)))

        def hit(lane):
            if not state['running']:
                return
            now = state['player'].getCurrentPosition()
            nearby = [note for note in state['notes'] if note[1] == lane and not note[3] and abs(note[0] - now) <= 155]
            if not nearby:
                state.update(combo=0, judgment='Miss')
                return
            note = min(nearby, key=lambda row: abs(row[0] - now))
            perfect = abs(note[0] - now) <= 75
            note[3] = True
            note[2].setVisibility(4)
            state['score'] += 1 if perfect else 0.65
            state['combo'] += 1
            state['best_combo'] = max(state['combo'], state['best_combo'])
            state['judgment'] = 'Sick!' if perfect else 'Good'

        def build_controls():
            controls.removeAllViews()
            for lane, arrow in enumerate(arrows):
                control = self._rhythm_button(context, arrow, lambda index=lane: hit(index), colors[lane])
                control.setTextSize(24.0)
                controls.addView(control, LinearLayout.LayoutParams(0, dp(55), 1.0))

        def tick():
            if not state['running']:
                return
            try:
                player = state['player']
                now = player.getCurrentPosition()
                if now >= state['duration'] or not player.isPlaying():
                    finish()
                    return
                width = field.getWidth() / 4.0
                target = dp(12)
                for note in state['notes']:
                    when, lane, view, consumed = note
                    if consumed:
                        continue
                    delta = when - now
                    if delta < -155:
                        view.setVisibility(4)
                        state.update(combo=0, judgment='Miss')
                        note[3] = True
                    elif delta <= 1050:
                        view.setVisibility(0)
                        view.setTranslationX(float(width * (lane + 0.5) - dp(17)))
                        view.setTranslationY(float(target + max(0, delta) * dp(field_height - 48) / 1050))
                hud = f"{state['title']}\n{state['judgment']}    ×{state['combo']}"
                if state.get('hud') != hud:
                    header.setText(hud)
                    state['hud'] = hud
                run_on_ui_thread(tick, 24)
            except Exception as exc:
                fail(exc)

        def fail(exc):
            if state['closed']:
                return
            release()
            self.logger.error('SDWG Rhythm: %s', type(exc).__name__)
            detail = str(exc) if isinstance(exc, ValueError) else self._ui('Попробуй другой трек из подборки.')
            header.setText(self._ui('Не удалось запустить раунд') + '\n' + detail[:160])
            field.setVisibility(8)
            controls.setVisibility(8)
            retry.setVisibility(0)

        def ready(track, audio, chart):
            if state['closed']:
                return
            try:
                build_controls()
                field.removeAllViews()
                targets = LinearLayout(context)
                for lane, arrow in enumerate(arrows):
                    target = TextView(context)
                    target.setText(arrow)
                    target.setTextSize(24.0)
                    target.setTextColor(0x66ffffff)
                    target.setGravity(Gravity.CENTER)
                    targets.addView(target, LinearLayout.LayoutParams(0, dp(36), 1.0))
                target_layout = FrameLayout.LayoutParams(-1, dp(36))
                target_layout.topMargin = dp(12)
                field.addView(targets, target_layout)
                notes = []
                rng = random.Random(str(track['id']))
                for when in chart['hits']:
                    lane = rng.randrange(4)
                    view = TextView(context)
                    view.setText(arrows[lane])
                    view.setTextColor(colors[lane])
                    view.setTextSize(24.0)
                    view.setGravity(Gravity.CENTER)
                    view.setVisibility(4)
                    field.addView(view, FrameLayout.LayoutParams(dp(34), dp(36)))
                    notes.append([when, lane, view, False])
                state.update(notes=notes, title=track['title'] + ' — ' + track['artist'],
                             track_id=str(track['id']), duration=chart['duration'],
                             score=0, combo=0, best_combo=0, judgment='')
                cache = str(context.getCacheDir().getAbsolutePath())
                with tempfile.NamedTemporaryFile(dir=cache, suffix=chart.get('suffix', '.mp3'), delete=False) as output:
                    state['path'] = output.name
                    output.write(audio)
                player = jclass('android.media.MediaPlayer')()
                state['player'] = player
                try: self._eq_external = player
                except Exception: pass

                class Prepared(dynamic_proxy(jclass('android.media.MediaPlayer$OnPreparedListener'))):
                    def onPrepared(proxy, media):
                        if state['closed'] or state['player'] != media:
                            return
                        try:
                            media.start()
                            state['running'] = True
                            tick()
                        except Exception as exc:
                            fail(exc)

                class Failed(dynamic_proxy(jclass('android.media.MediaPlayer$OnErrorListener'))):
                    def onError(proxy, media, what, extra):
                        if state['player'] == media:
                            fail(RuntimeError(f'Android audio {what}/{extra}'))
                        return True

                state['listeners'] = (Prepared(), Failed())
                player.setOnPreparedListener(state['listeners'][0])
                player.setOnErrorListener(state['listeners'][1])
                player.setDataSource(state['path'])
                field.setVisibility(0)
                controls.setVisibility(0)
                player.prepareAsync()
            except Exception as exc:
                fail(exc)

        def start(selection=None, preset=None):
            list_scroll.setVisibility(8)
            field.setVisibility(8)
            controls.setVisibility(8)
            retry.setVisibility(8)
            header.setText(self._ui('Готовим раунд…'))

            def load():
                try:
                    if preset is not None:
                        result = _synth_phonk(preset)
                    else:
                        result = self._load_rhythm_track(lambda: state['closed'], selection)
                    run_on_ui_thread(lambda: ready(*result))
                except Exception as exc:
                    run_on_ui_thread(lambda error=exc: fail(error))
            threading.Thread(target=load, daemon=True).start()

        def reopen():
            retry.setVisibility(8)
            list_scroll.setVisibility(0)
            header.setText('SDWG Rhythm')

        def show_choices(rows, loading=False):
            if state['closed']:
                return
            choices.removeAllViews()
            if list_scroll.getVisibility() == 0:
                header.setText('SDWG Rhythm')
            for rank, name in rows:
                choices.addView(self._rhythm_button(context, f'{rank:02d}  {name}',
                                                     lambda query=name: start(selection=query)))
            if not rows and not loading and list_scroll.getVisibility() == 0:
                header.setText('SDWG Rhythm · ' + self._ui('Чарт недоступен'))
            for preset in _PHONK_TRACKS:
                choices.addView(self._rhythm_button(context, '♫  ' + preset[1],
                                                     lambda track=preset: start(preset=track)))

        def load_chart():
            rows = []
            try:
                url = 'https://soundcharts.com/en/charts/soundcloud/united-states'
                with requests.get(url, timeout=6) as response:
                    response.raise_for_status()
                    parser = _RhythmChartParser()
                    parser.feed(response.text)
                rows = sorted(dict(parser.rows).items())[:12]
            except Exception as exc:
                self.logger.error('SDWG chart: %s', type(exc).__name__)
            run_on_ui_thread(lambda: show_choices(rows))

        dialog.show()
        field.setVisibility(8)
        controls.setVisibility(8)
        retry.setVisibility(8)
        show_choices([], loading=True)
        header.setText(self._ui('Загружаем чарт SoundCloud…'))
        threading.Thread(target=load_chart, daemon=True).start()

    def _load_rhythm_track(self, cancelled, selection):
        if not selection:
            raise ValueError(self._ui('Не удалось найти этот трек в SoundCloud.'))
        cid = _sc_get_cid(self._sc_cid())
        if not cid:
            raise ValueError('SoundCloud client_id')
        params = {'client_id': cid, 'q': selection, 'limit': 12}
        with _safe_get(f'{SC_API}/search/tracks', params=params, headers=SC_HEADERS, timeout=8) as response:
            response.raise_for_status()
            entries = [item for item in response.json().get('collection', []) if isinstance(item, dict)]
        matches = []
        query = _normalize(selection)
        for item in entries:
            title = _normalize(item.get('title'))
            user = item.get('user') or {}
            publisher = item.get('publisher_metadata') or {}
            names = (user.get('username'), publisher.get('artist'), user.get('full_name'))
            suffix = query[len(title):].strip() if title and query.startswith(title + ' ') else ''
            if suffix:
                verified = any(name and _normalize(name) and _normalize(name) in suffix for name in names)
                matches.append((verified, len(title), item))
        matches.sort(key=lambda match: match[:2], reverse=True)
        entries = [match[2] for match in matches if match[0]]
        if not entries and matches:
            longest = matches[0][1]
            exact_titles = [match[2] for match in matches if match[1] == longest]
            if len(exact_titles) == 1 and len(_normalize(exact_titles[0].get('title'))) >= 8:
                entries = exact_titles
        if not entries:
            raise ValueError(self._ui('Не удалось найти этот трек в SoundCloud.'))
        candidates = []
        for row in entries:
            if not isinstance(row, dict):
                continue
            raw = row
            if not isinstance(raw, dict) or not raw.get('id') or raw.get('policy') == 'BLOCK':
                continue
            for source in (raw.get('media') or {}).get('transcodings') or []:
                fmt = source.get('format') or {}
                url = source.get('url') or ''
                mime = fmt.get('mime_type', '').lower()
                mp3 = mime.startswith('audio/mpeg')
                aac = 'mp4a' in mime or mime.startswith(('audio/aac', 'audio/mp4'))
                if not url or not (mp3 or aac):
                    continue
                protocol = fmt.get('protocol')
                is_preview = source.get('snipped') or '/preview/' in url
                if (is_preview and protocol in ('progressive', 'hls')) or (
                    protocol in ('progressive', 'hls') and raw.get('policy') == 'ALLOW' and raw.get('streamable')
                    and (mp3 or protocol == 'hls')
                ):
                    candidates.append((not is_preview, raw, url, protocol, '.m4a' if aac else '.mp3'))
        candidates.sort(key=lambda candidate: candidate[0])
        for is_full, raw, url, protocol, suffix in candidates[:8]:
            if cancelled():
                break
            try:
                query = {'client_id': cid}
                if raw.get('track_authorization'):
                    query['track_authorization'] = raw['track_authorization']
                with _safe_get(url, params=query, headers=SC_HEADERS, timeout=6) as response:
                    response.raise_for_status()
                    preview = response.json()['url']
                if protocol == 'hls':
                    audio = _fetch_hls_audio(preview, max_parts=10 if is_full else None)
                else:
                    with _safe_get(preview, headers=SC_HEADERS, stream=True, timeout=6) as response:
                        if is_full:
                            response.raise_for_status()
                            # A bounded prefix of a publicly playable MP3 suffices for a round.
                            data = bytearray()
                            for chunk in response.iter_content(chunk_size=32768):
                                data.extend(chunk)
                                if len(data) >= 1024 * 1024 or cancelled():
                                    break
                            audio = bytes(data)
                        else:
                            audio = _read_stream_bytes(response, limit=1024 * 1024)
                if cancelled():
                    break
                chart = _webview_encode_mp3(audio, '', analyze=True)
                if chart['duration'] >= 8000 and len(chart['hits']) >= 4:
                    chart['suffix'] = suffix
                    return _sc_track(raw), audio, chart
            except Exception as exc:
                self.logger.error('SDWG preview: %s', type(exc).__name__)
        raise ValueError(self._ui('У этого трека нет доступного аудио для раунда.'))

    def _music_tab_changed(self, enabled):
        from android_utils import run_on_ui_thread
        self._music_tab_enabled = bool(enabled)
        if self._music_tab_id is not None:
            self.remove_menu_item(self._music_tab_id)
            self._music_tab_id = None
        if enabled:
            self._music_tab_id = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU, text=self._ui('Музыка · Beta'),
                icon='msg_search', on_click=self._open_music_tab, priority=21))
            self._install_music_tab()
            run_on_ui_thread(self._discover_music_tabs)
        else:
            def remove():
                for view in getattr(self, '_music_tab_views', []):
                    tabs = view.getParent()
                    if tabs is not None:
                        tabs.removeView(view)
                        tabs.onItemsChanged()
                self._music_tab_views = []
            run_on_ui_thread(remove)

    def _install_music_tab(self):
        if getattr(self, '_native_music_tab_hook', None) is not None:
            return
        from base_plugin import MethodHook
        from hook_utils import find_class
        from android_utils import run_on_ui_thread
        host_class = find_class('org.telegram.ui.MainTabsActivity')
        if host_class is None:
            return
        plugin = self

        class TabsHook(MethodHook):
            def after_hooked_method(self, param):
                host = param.thisObject
                run_on_ui_thread(lambda: plugin._attach_music_tab(host))

        self._native_music_tab_hook = TabsHook()
        for name in ('createView', 'onResume'):
            try:
                self.hook_all_methods(host_class, name, self._native_music_tab_hook)
            except Exception as exc:
                self.logger.error('Music tab hook: %s', exc)

    def _discover_music_tabs(self):
        from client_utils import get_last_fragment
        from hook_utils import get_private_field
        fragment = get_last_fragment()
        if fragment is None:
            return
        if str(fragment.getClass().getName()) == 'org.telegram.ui.MainTabsActivity':
            self._attach_music_tab(fragment)
            return
        stack = get_private_field(fragment.getParentActivity(), 'mainFragmentsStack')
        if stack is not None:
            for index in range(stack.size()):
                host = stack.get(index)
                if str(host.getClass().getName()) == 'org.telegram.ui.MainTabsActivity':
                    self._attach_music_tab(host)

    def _attach_music_tab(self, host):
        if not getattr(self, '_music_tab_enabled', False):
            return
        from hook_utils import get_private_field
        from java import jclass
        from android_utils import OnClickListener
        view = None
        tabs = None
        try:
            tabs = get_private_field(host, 'tabsView')
            if tabs is None or tabs.findViewWithTag('music_dl_native_tab') is not None:
                return
            Glass = jclass('org.telegram.ui.Components.glass.GlassTabView')
            Animation = jclass('org.telegram.ui.Components.glass.GlassTabView$TabAnimation')
            Strings = jclass('org.telegram.messenger.R$string')
            view = Glass.createMainNavigationTab(
                tabs.getContext(), host.getResourceProvider(), Animation.MODELS, Strings.MainTabsChats)
            title = 'Музыка' if self._lang() == 'ru' else 'Music'
            view.setText(title)
            view.setContentDescription(title)
            view.setTag('music_dl_native_tab')
            view.setOnClickListener(OnClickListener(lambda _: self._open_music_tab(None, host)))
            tabs.addView(view, 0)
            tabs.setPriority(view, -100)
            tabs.addTabToIgnoreClick(view)
            tabs.setViewVisible(view, True, False)
            tabs.onItemsChanged()
            tabs.requestLayout()
            self._music_tab_views = getattr(self, '_music_tab_views', []) + [view]
        except Exception as exc:
            if view is not None and tabs is not None and view.getParent() is not None:
                tabs.removeView(view)
            self.logger.error('Music tab: %s', exc)

    def _open_music_tab(self, ctx, source=None):
        from android_utils import run_on_ui_thread

        def show():
            from client_utils import get_last_fragment
            from ui.bulletin import BulletinHelper
            try:
                host = source or get_last_fragment()
                if host is None: raise RuntimeError('missing navigation host')
                screen = self._new_music_screen()
                screen.content = self._open_search_ui(None, screen=screen, context=host.getParentActivity())
                if screen.content is None:
                    raise RuntimeError("Music screen has no activity")
                if host.presentFragment(screen.java) is False:
                    raise RuntimeError('fragment was rejected')
                self._music_screen = screen
                try:
                    bar = screen.java.getActionBar()
                    if bar is not None:
                        bar.setVisibility(8)
                except Exception:
                    pass
            except Exception as exc:
                self.logger.error('Music screen: %s', exc)
                BulletinHelper.show_error(self._ui('Не удалось открыть экран музыки') + ' · ' + str(exc)[:140])
        run_on_ui_thread(show)

    def _new_music_screen(self):
        if getattr(self, '_music_screen_class', None) is None:
            from extera_utils.classes import Base, java_subclass, joverride
            from java import jclass
            BaseFragment = jclass('org.telegram.ui.ActionBar.BaseFragment')
            plugin = self

            @java_subclass(BaseFragment)
            class MusicScreen(Base):
                @joverride('createView', ['android.content.Context'])
                def createView(self, context):
                    view = self.content
                    from hook_utils import set_private_field
                    if not set_private_field(self.java, 'fragmentView', view):
                        cls = self.java.getClass()
                        while cls is not None:
                            try:
                                field = cls.getDeclaredField('fragmentView')
                                field.setAccessible(True)
                                field.set(self.java, view)
                                break
                            except Exception:
                                cls = cls.getSuperclass()
                        if cls is None:
                            raise RuntimeError('Music fragment view could not be attached')
                    return view

                @joverride('onPause', [])
                def onPause(self):
                    if hasattr(self, 'stop_preview'): self.stop_preview()
                    super().onPause()

                @joverride('onFragmentDestroy', [])
                def onFragmentDestroy(self):
                    if hasattr(self, 'cleanup'): self.cleanup()
                    if getattr(plugin, '_music_screen', None) is self:
                        plugin._music_screen = None
                    super().onFragmentDestroy()

            self._music_screen_class = MusicScreen
        return self._music_screen_class.new_instance()


    def _handle_chat_search(self, ctx):
        from android_utils import run_on_ui_thread
        from client_utils import get_last_fragment
        def open_search():
            try:
                context = ctx if isinstance(ctx,dict) else {}
                fragment = context.get('fragment') or get_last_fragment()
                # ChatActivity supplies the exact dialog id (including group sign).
                pid = None
                if fragment is not None:
                    try: pid = int(fragment.getDialogId())
                    except Exception: pass
                if not pid:
                    raw = context.get('dialog_id') or context.get('dialogId') or context.get('peer')
                    if raw is not None:
                        try: pid = int(raw)
                        except Exception: pass
                if not pid and context.get('userId'):
                    pid=int(context['userId'])
                if not pid and context.get('chatId'):
                    pid=-abs(int(context['chatId']))
                if not pid:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error('Не удалось определить чат. Открой его и введи .search')
                    return
                self._open_search_ui(pid,fragment)
            except Exception as exc:
                try:
                    self.logger.error('Не удалось открыть поиск из меню чата: %s',exc)
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error('Не удалось открыть поиск: '+str(exc)[:120])
                except Exception: pass
        # Allow the chat action menu to close before opening the bottom sheet.
        run_on_ui_thread(open_search, 250)

    def _download_with_progress(self, pid, track, expected_account):
        from client_utils import get_last_fragment
        from android_utils import run_on_ui_thread
        from ui.alert import AlertDialogBuilder
        from org.telegram.messenger import UserConfig
        fragment=get_last_fragment();activity=fragment.getParentActivity() if fragment else None
        if not activity:
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(self._ui('Не удалось показать загрузку. Повтори попытку.'))
            except Exception: pass
            return
        from android.widget import LinearLayout, TextView, ProgressBar
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme
        from android.content.res import ColorStateList
        from java import jclass
        dp=AndroidUtilities.dp
        layout=LinearLayout(activity);layout.setOrientation(1);layout.setPadding(dp(24),dp(8),dp(24),dp(20))
        status=TextView(activity);status.setText(self._ui('Подключаемся к сервису…'));status.setTextSize(14.0)
        status.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));layout.addView(status)
        try:
            MaterialBar=jclass('com.google.android.material.progressindicator.LinearProgressIndicator')
            MaterialStyle=jclass('com.google.android.material.R$style')
            ContextThemeWrapper=jclass('android.view.ContextThemeWrapper')
            themed=ContextThemeWrapper(activity,MaterialStyle.Widget_Material3Expressive_LinearProgressIndicator_Wavy)
            bar=MaterialBar(themed)
            # Reject older versions which silently lack wavy support.
            bar.setWaveAmplitude(dp(4));bar.setWavelengthDeterminate(dp(32));bar.setWavelengthIndeterminate(dp(32))
            bar.setWaveSpeed(dp(24));bar.setTrackThickness(dp(4))
        except Exception:
            bar=ProgressBar(activity,None,jclass('android.R$attr').progressBarStyleHorizontal)
        bar.setMax(100);bar.setIndeterminate(True)
        try:
            tint=ColorStateList.valueOf(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
            bar.setProgressTintList(tint);bar.setIndeterminateTintList(tint)
        except Exception: pass
        lp=LinearLayout.LayoutParams(-1,dp(24));lp.topMargin=dp(14);layout.addView(bar,lp)
        percent=TextView(activity);percent.setTextSize(12.0);percent.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        percent.setGravity(5);layout.addView(percent)
        title=TextView(activity)
        title.setText(self._ui('Подготовка трека'))
        title.setTextSize(20.0)
        title.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        title.setMinHeight(dp(44))
        layout.addView(title, 0)
        self._bind_rhythm_secret(title)
        progress=AlertDialogBuilder(activity);progress.set_view(layout);progress.show()
        self._music_download_dialog=progress
        def report(stage, detail=''):
            def update():
                try:
                    if stage=='error':
                        progress.dismiss()
                        box=AlertDialogBuilder(activity);box.set_title(self._ui('Не удалось скачать'))
                        box.set_message(str(detail)[:250]+self._ui('\nСообщите @S1mclick'))
                        box.set_positive_button(self._ui('Повторить'),lambda b,n:(b.dismiss(),self._download_with_progress(pid,track,expected_account)))
                        box.set_negative_button(self._ui('Закрыть'),lambda b,n:b.dismiss());box.show()
                    elif stage=='done':
                        progress.dismiss()
                        from ui.bulletin import BulletinHelper
                        BulletinHelper.show_info(self._ui('Файл передан Telegram для отправки'))
                    elif stage=='percent':
                        value=max(0,min(100,int(detail)));bar.setIndeterminate(False);bar.setProgress(value,True)
                        status.setText(self._ui('Скачиваем трек…'));percent.setText(str(value)+'%')
                    else:
                        status.setText(str(detail));bar.setIndeterminate(True);percent.setText('')
                except Exception: pass
            run_on_ui_thread(update)
        def task():
            try:
                if int(UserConfig.selectedAccount)!=expected_account:
                    report('error',self._ui('Аккаунт изменился. Повтори выбор чата.'));return
                self._do_download(pid,track,progress=report,expected_account=expected_account)
            except Exception as exc: report('error',str(exc))
        run_on_queue(task)

    def _attach_music_button(self, fragment, root):
        if not self.get_setting('music_floating_button',True): return
        try:
            from android_utils import OnClickListener
            from android.widget import FrameLayout, ImageView
            from android.view import Gravity
            from android.content.res import ColorStateList
            from android.graphics.drawable import GradientDrawable, RippleDrawable
            from java import jclass, dynamic_proxy
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            if root is None or not isinstance(root,FrameLayout): return
            if not int(fragment.getDialogId()): return
            tag='music_dl_floating_button_v1'
            if root.findViewWithTag(tag) is not None: return
            dp=AndroidUtilities.dp;button=ImageView(root.getContext());button.setTag(tag)
            button.setContentDescription(self._ui('Открыть поиск музыки'));button.setPadding(dp(14),dp(14),dp(14),dp(14))
            try:
                resources=jclass('org.telegram.messenger.R$drawable');button.setImageResource(resources.msg_search)
            except Exception:
                button.setImageResource(jclass('android.R$drawable').ic_menu_search)
            tint=Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)
            button.setColorFilter(tint)
            fill=GradientDrawable();fill.setColor(Theme.getColor(Theme.key_dialogBackground));fill.setCornerRadius(float(dp(18)))
            button.setBackground(RippleDrawable(ColorStateList.valueOf(0x334c8bf5),fill,None));button.setElevation(float(dp(6)))
            lp=FrameLayout.LayoutParams(dp(52),dp(52),Gravity.LEFT|Gravity.TOP)
            root.addView(button,lp)
            # Сохраняем относительную позицию, чтобы она переживала смену размера экрана.
            def stored(key, default):
                try: return max(0, min(1000, int(self.get_setting(key, default)))) / 1000.0
                except Exception: return default / 1000.0
            position={'x':stored('music_button_x',1000),'y':stored('music_button_y',850), 'drag':False}
            def place():
                width=max(0,root.getWidth()-button.getWidth());height=max(0,root.getHeight()-button.getHeight())
                if width and height and not position['drag']:
                    button.setX(float(width*position['x']));button.setY(float(height*position['y']))
            from android_utils import run_on_ui_thread
            run_on_ui_thread(place, 100)
            def opened(_):
                try:
                    pid=int(fragment.getDialogId())
                    if pid: self._open_search_ui(pid,fragment)
                except Exception as exc:
                    try: self.logger.error('Floating music button: %s',exc)
                    except Exception: pass
            button.setOnClickListener(OnClickListener(opened))
            from android.view import ViewConfiguration
            touch_slop=ViewConfiguration.get(root.getContext()).getScaledTouchSlop()
            touch={'x':0.0,'y':0.0,'left':0.0,'top':0.0,'moved':False}
            class TouchListener(dynamic_proxy(jclass('android.view.View$OnTouchListener'))):
                def onTouch(listener, view, event):
                    action=event.getActionMasked()
                    if action==0:  # ACTION_DOWN
                        touch.update(x=event.getRawX(),y=event.getRawY(),left=view.getX(),top=view.getY(),moved=False)
                        position['drag']=False;view.setPressed(True)
                        try: root.requestDisallowInterceptTouchEvent(True)
                        except Exception: pass
                        return True
                    if action==1 or action==3:  # ACTION_UP / ACTION_CANCEL
                        view.setPressed(False)
                        try: root.requestDisallowInterceptTouchEvent(False)
                        except Exception: pass
                        if touch['moved']:
                            width=max(1,root.getWidth()-view.getWidth());height=max(1,root.getHeight()-view.getHeight())
                            position['x']=max(0.0,min(1.0,view.getX()/width));position['y']=max(0.0,min(1.0,view.getY()/height))
                            position['drag']=False
                            if action==1:
                                self.set_setting('music_button_x',int(position['x']*1000),reload_settings=False)
                                self.set_setting('music_button_y',int(position['y']*1000),reload_settings=False)
                        elif action==1: view.performClick()
                        position['drag']=False
                        return True
                    if action==2:  # ACTION_MOVE
                        dx=event.getRawX()-touch['x'];dy=event.getRawY()-touch['y']
                        if not touch['moved'] and dx*dx+dy*dy > touch_slop*touch_slop:
                            touch['moved']=True;position['drag']=True;view.setPressed(False)
                        if touch['moved']:
                            view.setX(float(max(0,min(root.getWidth()-view.getWidth(),touch['left']+dx))))
                            view.setY(float(max(0,min(root.getHeight()-view.getHeight(),touch['top']+dy))))
                        return True
                    return True
            touch_listener=TouchListener();button.setOnTouchListener(touch_listener)
            from java.lang.ref import WeakReference
            self._music_buttons=[ref for ref in self._music_buttons if ref.get() is not None]
            self._music_buttons.append(WeakReference(button))
        except Exception as exc:
            try: self.logger.error('Cannot add floating music button: %s',exc)
            except Exception: pass

    def _floating_setting_changed(self, value):
        from android_utils import run_on_ui_thread
        def update():
            if not value:
                for ref in self._music_buttons:
                    try:
                        button=ref.get()
                        if button is None: continue
                        parent=button.getParent()
                        if parent is not None: parent.removeView(button)
                    except Exception: pass
                self._music_buttons=[]
            else:
                try:
                    from client_utils import get_last_fragment
                    fragment=get_last_fragment()
                    if fragment: self._attach_music_button(fragment,fragment.getFragmentView())
                except Exception: pass
        run_on_ui_thread(update)

    # ── lifecycle ─────────────────────────────────────────────────────────────

    def on_plugin_load(self):
        self._support_start()
        self.add_on_send_message_hook()
        self._music_buttons=[]
        try:
            from base_plugin import MethodHook
            from hook_utils import find_class
            plugin=self
            class MusicChatViewHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        from android_utils import run_on_ui_thread
                        fragment=param.thisObject;root=param.getResult()
                        run_on_ui_thread(lambda:plugin._attach_music_button(fragment,root))
                    except Exception: pass
            self._music_view_hook=MusicChatViewHook()
            self.hook_all_methods(find_class('org.telegram.ui.ChatActivity'),'createView',self._music_view_hook)
            from client_utils import get_last_fragment
            current=get_last_fragment()
            if current:
                from android_utils import run_on_ui_thread
                run_on_ui_thread(lambda:self._attach_music_button(current,current.getFragmentView()),500)
        except Exception as exc:
            try: self.logger.error('Floating music hook: %s',exc)
            except Exception: pass
        from android_utils import run_on_ui_thread
        run_on_ui_thread(self._guide_show, 1000)
        self._menu_ids = []
        self._menu_ids.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU, text=self._tr("Редактировать метаданные"),
            icon="msg_edit", on_click=self._metadata_open)))
        self._menu_ids.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU, text=self._tr("Шаблон музыкального статуса"),
            icon="msg_edit", on_click=self._np_use_template)))
        self._menu_ids.append(self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU, text=self._tr("Шаблон статуса без музыки"),
            icon="msg_edit", on_click=lambda ctx: self._np_use_template(ctx, idle=True))))
        self._np_start()
        self._music_tab_id = None
        self._music_screen = None
        self._music_tab_changed(self.get_setting('music_tab_beta', False))
        try:
            self._menu_ids.append(self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU, text="Поиск музыки",
                icon="msg_search", on_click=self._handle_chat_search, priority=20)))
        except Exception as exc:
            try: self.logger.error("Music chat menu: %s", exc)
            except Exception: pass
        for text, subtext, icon, cb, prio, is_ctx in [
            ("Music Downloader", "Search, favorites & recs", "msg_search", self.handle_music_menu,    20, False),
            ("Favorites",        "Show saved likes",         "msg_saved",  self.handle_fav_menu,      19, False),
            ("Recommendations",  "Based on your likes",      "msg_info",   self.handle_rec_menu,      18, False),
            ("Like best match",  "Save from last search",    "msg_saved",  self.handle_like_ctx_menu, 15, True),
        ]:
            mtype = MenuItemType.MESSAGE_CONTEXT_MENU if is_ctx else MenuItemType.DRAWER_MENU
            self._menu_ids.append(self.add_menu_item(MenuItemData(
                menu_type=mtype, text=text, subtext=subtext,
                icon=icon, on_click=cb, priority=prio,
            )))

    _SETTINGS_ENTRY_ID = 74210

    def _support_start(self):
        self._creator_support = None
        try:
            namespace = {"__name__": "music_dl_creator_support"}
            exec(compile(_CREATOR_SUPPORT_SOURCE, "music_dl_creator_support", "exec"), namespace)
            support = namespace["ChannelSupportPlugin"](self)
            self._creator_support = support
            support.on_plugin_load()
        except Exception as exc:
            self.logger.error("Creator support: %s", exc)

    def _settings_profile_install(self):
        # Older exteraGram builds render main settings in ProfileActivity.
        from base_plugin import MethodHook
        from hook_utils import find_class
        from java import jclass
        plugin = self
        self._settings_profile_rows = jclass("java.util.WeakHashMap")()
        def host(adapter):
            return plugin._java_field(adapter, "this$0")
        def row(fragment):
            if fragment is None:
                return -1
            value = plugin._settings_profile_rows.get(fragment)
            return -1 if value is None else plugin._java_int(value)
        class Rows(MethodHook):
            def after_hooked_method(self, param):
                try:
                    fragment = param.thisObject
                    plugin._settings_profile_rows.remove(fragment)
                    if not plugin.get_setting("settings_entry", True):
                        return
                    anchor = plugin._java_field(fragment, "exteraRow")
                    if anchor is None or plugin._java_int(anchor) < 0:
                        return
                    at = plugin._java_int(anchor) + 1
                    # Shift native row IDs together, so their existing clicks and
                    # bindings retain their correct destinations.
                    changes = []
                    for field in fragment.getClass().getDeclaredFields():
                        name = str(field.getName())
                        if str(field.getType().getName()) != "int":
                            continue
                        if not (name.endswith("Row") or name == "rowCount"):
                            continue
                        field.setAccessible(True)
                        value = int(field.getInt(fragment))
                        if value >= at:
                            changes.append((field, value))
                    applied = []
                    try:
                        for field, value in changes:
                            field.setInt(fragment, value + 1)
                            applied.append((field, value))
                        plugin._settings_profile_rows.put(fragment, jclass("java.lang.Integer")(at))
                    except Exception:
                        for field, value in reversed(applied):
                            field.setInt(fragment, value)
                        raise
                except Exception as exc:
                    plugin.logger.error("Music settings row: %s", exc)
        class Type(MethodHook):
            def before_hooked_method(self, param):
                if int(param.args[0]) == row(host(param.thisObject)):
                    param.setResult(jclass("java.lang.Integer")(4))
        class Bind(MethodHook):
            def before_hooked_method(self, param):
                if int(param.args[1]) != row(host(param.thisObject)):
                    return
                from java import cast
                holder = cast(jclass("androidx.recyclerview.widget.RecyclerView$ViewHolder"), param.args[0])
                cell = cast(jclass("org.telegram.ui.Cells.TextCell"), holder.itemView)
                drawable = jclass("org.telegram.messenger.R$drawable")
                cell.setTextAndIcon("Music Downloader", drawable.msg_settings, True)
                param.setResult(None)
        class Enabled(MethodHook):
            def before_hooked_method(self, param):
                from java import cast
                holder = cast(jclass("androidx.recyclerview.widget.RecyclerView$ViewHolder"), param.args[0])
                if int(holder.getAdapterPosition()) == row(host(param.thisObject)):
                    param.setResult(jclass("java.lang.Boolean")(True))
        class Click(MethodHook):
            def before_hooked_method(self, param):
                if len(param.args) >= 2 and int(param.args[1]) == row(param.thisObject):
                    plugin._open_plugin_settings()
                    param.setResult(None)
        try:
            activity = find_class("org.telegram.ui.ProfileActivity")
            adapter = find_class("org.telegram.ui.ProfileActivity$ListAdapter")
            if activity is None or adapter is None:
                return
            hooks = [Rows(), Type(), Bind(), Enabled(), Click()]
            self._settings_profile_hooks = hooks
            self.hook_all_methods(activity, "updateRowsIds", hooks[0])
            self.hook_all_methods(adapter, "getItemViewType", hooks[1])
            self.hook_all_methods(adapter, "onBindViewHolder", hooks[2])
            self.hook_all_methods(adapter, "isEnabled", hooks[3])
            # The main settings listener is compiled into this instance lambda.
            for method in activity.getDeclaredMethods():
                types = [str(t.getName()) for t in method.getParameterTypes()]
                if (str(method.getName()).startswith("lambda$createView$")
                        and types == ["android.view.View", "int", "float", "float"]):
                    method.setAccessible(True)
                    self.hook_method(method, hooks[4])
        except Exception as exc:
            self.logger.error("Music profile settings hook: %s", exc)

    def _settings_entry_install(self):
        from base_plugin import MethodHook
        from hook_utils import find_class
        plugin = self
        try:
            activity = find_class("org.telegram.ui.SettingsActivity")
            if activity is None:
                return
            class FillHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        plugin._settings_entry_fill(param.args[0])
                    except Exception as exc:
                        try: plugin.logger.error("Settings entry: %s", exc)
                        except Exception: pass
            class ClickHook(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        if plugin._settings_entry_click(param):
                            param.setResult(None)
                    except Exception:
                        pass
            self._settings_fill_hook = FillHook()
            self._settings_click_hook = ClickHook()
            self.hook_all_methods(activity, "fillItems", self._settings_fill_hook)
            self.hook_all_methods(activity, "onClick", self._settings_click_hook)
        except Exception as exc:
            try: self.logger.error("Settings entry hook: %s", exc)
            except Exception: pass

    def _settings_entry_fill(self, raw_items):
        if not self.get_setting("settings_entry", True):
            return
        from java import cast, jclass
        UItem = jclass("org.telegram.ui.Components.UItem")
        items = cast(jclass("java.util.ArrayList"), raw_items)
        size = int(items.size())
        account = -1
        position = -1
        for index in range(size):
            try:
                item = cast(UItem, items.get(index))
                if int(item.id) == self._SETTINGS_ENTRY_ID:
                    return
                text = item.text
                if account < 0 and int(item.id) == 1 and text is not None:
                    account = index
                if position < 0 and text is not None and "extera" in str(text).lower():
                    position = index
            except Exception:
                continue
        # Forks use different IDs for the account row.
        if position >= 0:
            at = position + 1
        else:
            at = max(0, account - 1) if account >= 0 else min(1, size)
        def signed(color):
            return color - (1 << 32) if color >= (1 << 31) else color
        title = "Music Downloader"
        drawable = jclass("org.telegram.messenger.R$drawable")
        try:
            factory = jclass("org.telegram.ui.SettingsActivity$SettingCell$Factory")
            entry = factory.of(self._SETTINGS_ENTRY_ID, signed(0xFFB659FF), signed(0xFF617CFF), drawable.settings_sounds, title)
        except Exception:
            entry = UItem.asButton(self._SETTINGS_ENTRY_ID, drawable.msg_settings, title)
        items.add(at, entry)

    def _settings_entry_click(self, param):
        from java import cast, jclass
        item = cast(jclass("org.telegram.ui.Components.UItem"), param.args[0])
        if int(item.id) != self._SETTINGS_ENTRY_ID:
            return False
        self._open_plugin_settings()
        return True

    def _open_plugin_settings(self):
        from android_utils import run_on_ui_thread
        from client_utils import get_last_fragment
        from com.exteragram.messenger.plugins import PluginsController
        from com.exteragram.messenger.plugins.ui import PluginSettingsActivity
        java_plugin = PluginsController.getInstance().plugins.get(self.id)
        fragment = get_last_fragment()
        if java_plugin is not None and fragment is not None:
            run_on_ui_thread(lambda: fragment.presentFragment(PluginSettingsActivity(java_plugin)))

    def on_plugin_unload(self):
        from android_utils import run_on_ui_thread
        def destroy_logos():
            for ref in getattr(self, '_logo_webviews', ()):
                web = ref.get()
                if web is not None:
                    try:
                        web.stopLoading()
                        web.destroy()
                    except Exception:
                        pass
            self._logo_webviews = []
        run_on_ui_thread(destroy_logos)
        support = getattr(self, '_creator_support', None)
        if support is not None:
            support.on_plugin_unload()
            self._creator_support = None
        for stop in list(getattr(self, "_banner_stops", ())):
            stop()
        from android_utils import run_on_ui_thread
        self._np_shutdown()
        def close_eq():
            self._eq_release()
            web = getattr(self, "_eq_web", None)
            self._eq_web = None
            if web is not None:
                web.stopLoading()
                web.destroy()
        run_on_ui_thread(close_eq)
        from android_utils import run_on_ui_thread
        def close_music():
            for close in list(getattr(self, "_rhythm_sessions", ())):
                close()
            if self._music_screen is not None:
                self._music_screen.java.finishFragment()
        run_on_ui_thread(close_music)
        self._music_tab_changed(False)
        self._floating_setting_changed(False)
        self._music_picker_delegate = None
        self._music_picker = None
        for mid in getattr(self,"_menu_ids",[]):
            try: self.remove_menu_item(mid)
            except: pass

    # ── settings ─────────────────────────────────────────────────────────────


    def _tr(self, value):
        if isinstance(value, list):
            return [self._tr(item) for item in value]
        if not isinstance(value, str):
            return value
        if self._lang() == "en":
            if value in _SERVICE_EN:
                return _SERVICE_EN[value]
            if value in _UI_EN:
                return _UI_EN[value]
            if " / " in value:
                return value.split(" / ", 1)[1]
            for source, translated in _SERVICE_EN.items():
                if source.endswith((": ", "· ")) and value.startswith(source):
                    return translated + value[len(source):]
        elif " / " in value and not value.startswith("http"):
            return value.split(" / ", 1)[0]
        return value

    def _localized_options(self, options):
        import dataclasses
        result = []
        for option in options:
            changes = {}
            for field in ("text", "subtext", "items"):
                if hasattr(option, field):
                    changes[field] = self._tr(getattr(option, field))
            if hasattr(option, "icon") and not getattr(option, "icon", None):
                key = str(getattr(option, "key", ""))
                changes["icon"] = "msg_settings" if key.startswith(("ui_", "eq_")) else "msg_info"
            result.append(dataclasses.replace(option, **changes) if changes else option)
        return result

    def _section_settings(self, section):
        options = []
        for option in self._all_settings():
            if isinstance(option, (Header, Divider)):
                continue
            key = str(getattr(option, "key", "") or "")
            text = str(getattr(option, "text", "") or "")
            group = "search"
            if key.startswith(("sp_", "ym_", "td_", "sc_")) or "Spotify" in text or "Яндекс Музыка" in text:
                group = "services"
            if key.startswith("np_") or "Статус и инструкция" in text:
                group = "profile"
            elif key.startswith("eq_"):
                group = "equalizer"
            elif key.startswith(("ui_", "music_")):
                group = "appearance"
            elif key in ("auto_like_downloads", "favorites_cap"):
                group = "favorites"
            elif key == "language":
                group = "language"
            if section == group:
                options.append(option)
        return self._localized_options(options)

    def _home_banner(self):
        from ui.settings import Custom, SimpleSettingFactory
        if getattr(self, "_home_factory", None) is None:
            def create(context, *args):
                from android.widget import ImageView, LinearLayout, FrameLayout
                from android.graphics import BitmapFactory
                from org.telegram.messenger import AndroidUtilities
                root = LinearLayout(context)
                root.setOrientation(1)
                root.setPadding(0, AndroidUtilities.dp(12), 0, AndroidUtilities.dp(12))
                backdrop = FrameLayout(context)
                root.addView(backdrop, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(224)))
                sparks = FrameLayout(context)
                backdrop.addView(sparks, FrameLayout.LayoutParams(-1, -1))
                if self.get_setting("ui_header_sparks", True):
                    self._banner_native_sparks(sparks)
                data = base64.b64decode(_HOME_IMAGE)
                image = ImageView(context)
                from android.graphics.drawable import GradientDrawable
                rounded = GradientDrawable()
                rounded.setColor(-14671840)
                rounded.setCornerRadius(float(AndroidUtilities.dp(24)))
                image.setBackground(rounded)
                image.setClipToOutline(True)
                image.setImageBitmap(BitmapFactory.decodeByteArray(data, 0, len(data)))
                image_params = FrameLayout.LayoutParams(AndroidUtilities.dp(180), AndroidUtilities.dp(180))
                from android.view import Gravity
                image_params.gravity = Gravity.CENTER
                image_params.topMargin = AndroidUtilities.dp(10)
                backdrop.addView(image, image_params)
                return root
            def bind(view, *args):
                pass
            self._home_factory = SimpleSettingFactory(create, bind, is_clickable=False, is_shadow=False)
        return Custom(factory=self._home_factory.instance.java)


    def _banner_native_sparks(self, frame):
        from java import jclass, jarray, jfloat, dynamic_proxy
        from android.widget import FrameLayout
        from android.graphics.drawable import GradientDrawable
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme
        dp = AndroidUtilities.dp
        try:
            if jclass("android.provider.Settings$Global").getFloat(
                    frame.getContext().getContentResolver(), "animator_duration_scale", 1.0) == 0:
                return
        except Exception:
            pass
        particles = []
        for index in range(14):
            dot = jclass("android.view.View")(frame.getContext())
            shape = GradientDrawable()
            shape.setShape(GradientDrawable.OVAL)
            shape.setColor(self._ui_color("ui_accent", Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)))
            dot.setBackground(shape)
            dot.setAlpha(0.0)
            frame.addView(dot, FrameLayout.LayoutParams(dp(2 if index % 3 else 3), dp(2 if index % 3 else 3)))
            particles.append(dot)
        state = {"attached": False, "size": None, "animators": []}
        plugin = self
        self._banner_stops = getattr(self, "_banner_stops", set())

        def stop():
            for animator in state["animators"]:
                animator.cancel()
            state["animators"] = []
            state["size"] = None
            for dot in particles:
                dot.setAlpha(0.0)
            plugin._banner_stops.discard(stop)

        def start():
            width, height = frame.getWidth(), frame.getHeight()
            if not state["attached"] or width <= 0 or height <= 0 or state["size"] == (width, height):
                return
            stop()
            state["size"] = (width, height)
            plugin._banner_stops.add(stop)
            Holder = jclass("android.animation.PropertyValuesHolder")
            Animator = jclass("android.animation.ObjectAnimator")
            randomizer = random.Random(606)
            for index, dot in enumerate(particles):
                # The entire motion runs on Android's animation clock.
                x0 = width * randomizer.uniform(.3, .7)
                y0 = height * randomizer.uniform(.2, .7)
                x1 = (-dp(3) if index % 2 else width + dp(3)) if index < 10 else width * randomizer.random()
                y1 = height * randomizer.uniform(.55, 1.15)
                holders = [
                    Holder.ofFloat("translationX", jarray(jfloat)([float(x0), float(x1)])),
                    Holder.ofFloat("translationY", jarray(jfloat)([float(y0), float(y1)])),
                    Holder.ofFloat("alpha", jarray(jfloat)([0.0, 0.9, 0.8, 0.0])),
                    Holder.ofFloat("scaleX", jarray(jfloat)([0.4, 1.2, 0.3])),
                    Holder.ofFloat("scaleY", jarray(jfloat)([0.4, 1.2, 0.3])),
                ]
                animator = Animator.ofPropertyValuesHolder(dot, jarray(Holder)(holders))
                animator.setDuration(1800 + index * 85)
                animator.setStartDelay(index * 90)
                animator.setRepeatCount(-1)
                animator.setInterpolator(jclass("android.view.animation.LinearInterpolator")())
                state["animators"].append(animator)
                animator.start()

        class Attach(dynamic_proxy(jclass("android.view.View$OnAttachStateChangeListener"))):
            def onViewAttachedToWindow(proxy, view):
                state["attached"] = True
                start()
            def onViewDetachedFromWindow(proxy, view):
                state["attached"] = False
                stop()
        class Layout(dynamic_proxy(jclass("android.view.View$OnLayoutChangeListener"))):
            def onLayoutChange(proxy, view, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
                start()
        frame.addOnAttachStateChangeListener(Attach())
        frame.addOnLayoutChangeListener(Layout())
        if frame.isAttachedToWindow():
            state["attached"] = True
            start()

    def create_settings(self):
        return self._localized_options([
            self._home_banner(),
            Header(text=self._tr("Music Downloader · 6.0 Beta")),
            Text(text=self._tr("Открыть музыку"), icon="msg_play", on_click=lambda *a: self._open_music_tab(None)),
            Text(text=self._tr("Сервисы и аккаунты"), icon="msg_search", create_sub_fragment=lambda: self._section_settings("services")),
            Text(text=self._tr("Поиск и скачивание"), icon="msg_search", create_sub_fragment=lambda: self._section_settings("search")),
            Text(text=self._tr("Сейчас слушаю · профиль и канал"), icon="msg_info", create_sub_fragment=self._profile_settings),
            Text(text=self._tr("Эквалайзер"), icon="msg_settings", create_sub_fragment=self._equalizer_settings),
            Text(text=self._tr("Редактор метаданных"), icon="msg_edit", on_click=lambda *a: self._metadata_open()),
            Text(text=self._tr("Оформление"), icon="msg_settings", create_sub_fragment=lambda: self._section_settings("appearance")),
            Text(text=self._tr("Избранное"), icon="msg_saved", create_sub_fragment=lambda: self._section_settings("favorites")),
            Text(text=self._tr("Язык / Language"), icon="msg_language", create_sub_fragment=lambda: self._section_settings("language")),
        ])

    def _profile_settings(self):
        return self._localized_options(self._section_settings("profile") + [
            Header(text=self._tr("Сообщение канала")),
            Input(key="np_template", text=self._tr("Шаблон сообщения"), default="Сейчас слушаю: {track}\n{position} — {duration}",
                  subtext=self._tr("{track}, {artist}, {title}, {position}, {duration}, {state}"), on_change=self._np_template_changed),
            Input(key="np_idle_template", text=self._tr("Когда ничего не играет"), default=self._tr("Сейчас ничего не играет"), on_change=self._np_idle_changed),
            Text(text=self._tr("Как добавить премиум-эмоджи"), icon="msg_sticker", on_click=lambda *a: self._emoji_guide()),
            Text(text=self._tr("Обновить сейчас / Проверить статус"), on_click=lambda *a: self._np_refresh()),
        ])

    def _np_idle_changed(self, value):
        self.set_setting("np_idle_emoji", [], reload_settings=False)
        self._np_refresh()

    def _np_template_changed(self, value):
        self.set_setting("np_template_emoji", [], reload_settings=False)
        self._np_refresh()

    def _np_use_template(self, ctx, idle=False):
        message = ctx.get("message")
        if message is None:
            return
        raw = message.messageOwner
        text = str(raw.message or "")
        if not text or len(text.encode("utf-16-le")) // 2 > 3500:
            self._service_help("Шаблон", "Нужно текстовое сообщение длиной до 3500 символов.")
            return
        emoji = []
        for index in range(raw.entities.size()):
            entity = raw.entities.get(index)
            document = getattr(entity, "document_id", 0)
            if document:
                emoji.append(dict(offset=int(entity.offset), length=int(entity.length), document_id=str(document)))
        self.set_setting("np_idle_template" if idle else "np_template", text, reload_settings=False)
        self.set_setting("np_idle_emoji" if idle else "np_template_emoji", emoji, reload_settings=False)
        self._np_refresh()
        self._service_help("Шаблон", "Сохранено. Премиум-эмоджи: " + str(len(emoji)))

    def _np_refresh(self):
        self._np_last_snapshot = None
        self._np_next = 0
        self._np_poll()

    def _equalizer_settings(self):
        from ui.settings import Custom, SimpleSettingFactory
        def create(context, *args):
            return self._equalizer_view(context)
        def bind(view, *args):
            pass
        self._eq_factory = SimpleSettingFactory(create, bind, is_clickable=False, is_shadow=False)
        return self._localized_options([
            Switch(key="eq_enabled", text=self._tr("Эквалайзер"), default=False, on_change=lambda *a: self._eq_curve_changed()),
            Custom(factory=self._eq_factory.instance.java),
            Text(text=self._tr("Плоский"), on_click=lambda *a: self._eq_preset("flat")),
            Text(text=self._tr("Больше баса"), on_click=lambda *a: self._eq_preset("bass")),
            Text(text=self._tr("Вокал"), on_click=lambda *a: self._eq_preset("voice")),
            Text(text=self._tr("Применить / Проверить"), on_click=lambda *a: self._eq_status()),
            Divider(text=self._tr("Пять точек кривой соответствуют частотам 60 Hz, 230 Hz, 910 Hz, 3.6 kHz и 14 kHz. Усиление пересчитывается под полосы устройства.")),
        ])

    def _eq_release(self):
        effect = getattr(self, "_eq_effect", None)
        self._eq_effect = None
        self._eq_session = 0
        if effect is not None:
            try: effect.release()
            except Exception: pass

    def _java_session_id(self, player):
        if player is None:
            return 0
        try:
            return self._java_int(player.getAudioSessionId())
        except Exception:
            pass
        for name in ("audioSessionId", "audioSessionID", "mAudioSessionId"):
            value = self._java_field(player, name)
            if value is not None:
                try:
                    if self._java_int(value) > 0:
                        return self._java_int(value)
                except (TypeError, ValueError):
                    pass
        from java import jarray, jclass
        for method in player.getClass().getMethods():
            if str(method.getName()) == "getAudioSessionId" and len(method.getParameterTypes()) == 0:
                try:
                    method.setAccessible(True)
                    return self._java_int(method.invoke(player, jarray(jclass("java.lang.Object"))([])))
                except Exception:
                    continue
        return 0

    def _install_cover_picker(self):
        from base_plugin import MethodHook
        from hook_utils import find_class
        plugin = self
        class Result(MethodHook):
            def before_hooked_method(self, param):
                if len(param.args) < 3 or int(param.args[0]) != 23857:
                    return
                pending = getattr(plugin, "_cover_picker", None)
                if pending is None:
                    return
                plugin._cover_picker = None
                param.setResult(None)
                if int(param.args[1]) != -1 or param.args[2] is None:
                    return
                uri = param.args[2].getData()
                if uri is not None:
                    pending(uri)
        self._cover_result_hook = Result()
        self.hook_all_methods(find_class("org.telegram.ui.LaunchActivity"), "onActivityResult", self._cover_result_hook)

    def _pick_cover(self, activity, selected):
        from android.content import Intent
        from java import jclass
        if not getattr(self, "_cover_result_hook", None):
            self._install_cover_picker()
        intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
        intent.addCategory(Intent.CATEGORY_OPENABLE)
        intent.setType("image/*")
        def received(uri):
            def copy():
                path = None
                try:
                    stream = activity.getContentResolver().openInputStream(uri)
                    if stream is None:
                        raise ValueError("Не удалось прочитать изображение.")
                    fd, path = tempfile.mkstemp(prefix="music_cover_", dir=str(activity.getCacheDir().getAbsolutePath()))
                    os.close(fd)
                    output = jclass("java.io.FileOutputStream")(path)
                    try:
                        channel = jclass("java.nio.channels.Channels").newChannel(stream)
                        output.getChannel().transferFrom(channel, 0, 12 * 1024 * 1024 + 1)
                    finally:
                        output.close()
                        stream.close()
                    if os.path.getsize(path) > 12 * 1024 * 1024:
                        raise ValueError("Обложка должна быть меньше 12 МБ.")
                    with open(path, "rb") as source:
                        header = source.read(12)
                    if not (header.startswith(b"\xff\xd8\xff") or header.startswith(b"\x89PNG\r\n\x1a\n")):
                        raise ValueError("Выбери изображение JPEG или PNG.")
                    from android.graphics import BitmapFactory
                    options = jclass("android.graphics.BitmapFactory$Options")()
                    options.inJustDecodeBounds = True
                    BitmapFactory.decodeFile(path, options)
                    if options.outWidth <= 0 or options.outHeight <= 0 or options.outWidth * options.outHeight > 32000000:
                        raise ValueError("Изображение повреждено или слишком большое.")
                    from android_utils import run_on_ui_thread
                    run_on_ui_thread(lambda: selected(path))
                except Exception as exc:
                    if path:
                        try: os.unlink(path)
                        except OSError: pass
                    self._service_help("Обложка", str(exc) if isinstance(exc, ValueError) else "Не удалось прочитать изображение.")
            threading.Thread(target=copy, daemon=True).start()
        self._cover_picker = received
        activity.startActivityForResult(intent, 23857)

    def _emoji_guide(self):
        if self._lang() == "ru":
            message = ("1. Открой Избранное и напиши сообщение-шаблон, например:\n\n"
                       "Сейчас слушаю: {track}\n{position} — {duration}\n\n"
                       "2. Вставь свои премиум-эмоджи обычной клавиатурой Telegram и отправь сообщение.\n\n"
                       "3. Нажми на отправленное сообщение, в меню выбери «Шаблон музыкального статуса». "
                       "Может потребоваться прокрутить меню.\n\n"
                       "4. Включи «Текущий трек в канале профиля» в настройках плагина. "
                       "Статус использует сохранённые эмоджи, {track} заменяется названием трека.\n\n"
                       "Не вставляй ссылки на эмоджи в текстовое поле. Для сохранения премиум-эмоджи "
                       "нужен именно пункт в меню отправленного сообщения.")
        else:
            message = ("1. Open Saved Messages and send a template such as:\n\n"
                       "Listening to: {track}\n{position} — {duration}\n\n"
                       "2. Insert custom emoji using Telegram's emoji keyboard before sending.\n\n"
                       "3. Tap your sent message and choose “Use as music status template”. You may need to scroll the menu.\n\n"
                       "4. Enable “Current track in profile channel” in the plugin settings. "
                       "The saved emoji are preserved and {track} is replaced with the track name.\n\n"
                       "Use the sent message menu to import custom emoji; emoji links in the text field do not work.")
        message += ("\n\nДля отдельного шаблона без музыки выбери в меню сообщения «Шаблон статуса без музыки»."
                    if self._lang() == "ru" else
                    "\n\nFor a separate idle message, choose “Use as idle music status template” in the sent message menu.")
        self._service_help(self._tr("Премиум-эмоджи"), message)

    def _eq_tick(self):
        if getattr(self, "_np_closed", True):
            return
        from org.telegram.messenger import MediaController
        from hook_utils import get_private_field
        try:
            if not self.get_setting("eq_enabled", False):
                self._eq_release()
                self._eq_error = self._tr("Включи эквалайзер.")
                return
            # A player can own an active audio session before MessageObject is populated.
            media = MediaController.getInstance()
            session = self._eq_session_id(media)
            if session <= 0:
                self._eq_release()
                _, message = self._current_music()
                self._eq_error = ("Трек найден, но аудиосессия пока недоступна. Попробуй приостановить и продолжить воспроизведение."
                                  if message is not None else "Запусти музыкальный трек в Telegram.")
                return
            if session != getattr(self, "_eq_session", 0):
                self._eq_release()
                from android.media.audiofx import Equalizer
                self._eq_effect = Equalizer(0, session)
                self._eq_session = session
            effect = self._eq_effect
            self._eq_apply_curve()
            effect.setEnabled(True)
            self._eq_error = ""
        except Exception as exc:
            self._eq_release()
            self._eq_error = self._ui("Эквалайзер недоступен: ") + type(exc).__name__ + " · " + str(exc)[:140]

    def _eq_status(self):
        self._eq_tick()
        effect = getattr(self, "_eq_effect", None)
        text = self._tr("Работает · полос: ") + str(effect.getNumberOfBands()) if effect is not None else self._tr(getattr(self, "_eq_error", "Включи эквалайзер."))
        if effect is None:
            text += "\n\n" + "; ".join(getattr(self, "_eq_debug", []))
        self._service_help("Эквалайзер", text)

    def _eq_curve_gains(self):
        live = getattr(self, "_eq_live_gains", None)
        return live if live is not None else (self.get_setting("eq_gains", {}) or {})

    def _eq_apply_curve(self):
        effect = getattr(self, "_eq_effect", None)
        if effect is None or not self.get_setting("eq_enabled", False):
            return
        bounds = effect.getBandLevelRange()
        gains = self._eq_curve_gains()
        for band in range(int(effect.getNumberOfBands())):
            frequency = int(effect.getCenterFreq(band))
            value = max(int(bounds[0]), min(int(bounds[1]), _eq_interpolate(gains, frequency)))
            effect.setBandLevel(band, value)

    def _eq_curve_changed(self):
        self._eq_live_gains = None
        self._eq_tick()
        self._eq_redraw()

    def _eq_preset(self, kind):
        values = {
            "flat": (0, 0, 0, 0, 0),
            "bass": (500, 250, -100, 0, 0),
            "voice": (-200, -100, 200, 300, 100),
        }[kind]
        gains = dict(zip((str(freq) for freq in _EQ_FREQUENCIES), values))
        self.set_setting("eq_gains", gains, reload_settings=False)
        self._eq_curve_changed()

    def _java_field(self, obj, name):
        if obj is None:
            return None
        cls = obj.getClass()
        while cls is not None:
            try:
                field = cls.getDeclaredField(name)
                field.setAccessible(True)
                return field.get(obj)
            except Exception:
                cls = cls.getSuperclass()
        return None

    def _current_music(self):
        from org.telegram.messenger import MediaController
        from java import cast, jclass
        media = MediaController.getInstance()
        message = media.getPlayingMessageObject()
        if message is None:
            message = self._java_field(media, "playingMessageObject")
        if message is None:
            return media, None
        message = cast(jclass("org.telegram.messenger.MessageObject"), message)
        try:
            if message.isMusic():
                return media, message
            if message.isVoice() or message.isRoundVideo():
                return media, None
        except AttributeError:
            pass
        document = message.getDocument()
        if document is not None and str(document.mime_type or "").startswith("audio/"):
            for index in range(document.attributes.size()):
                if bool(getattr(document.attributes.get(index), "voice", False)):
                    return media, None
            return media, message
        return media, None

    def _java_call(self, obj, name, *args):
        from java import jarray, jclass
        for method in obj.getClass().getMethods():
            if str(method.getName()) == name and len(method.getParameterTypes()) == len(args):
                method.setAccessible(True)
                boxed = [jclass("java.lang.Integer")(a) if isinstance(a, int) else a for a in args]
                return method.invoke(obj, jarray(jclass("java.lang.Object"))(boxed))
        raise AttributeError(name)

    def _eq_session_id(self, media):
        self._eq_debug = []
        external = getattr(self, "_eq_external", None)
        if external is not None:
            try:
                if external.isPlaying():
                    session = self._java_session_id(external)
                    if session > 0:
                        self._eq_debug.append("plugin player session=" + str(session))
                        return session
            except Exception:
                self._eq_external = None
        session = self._eq_find_session(media)
        self._eq_debug.append("Telegram audio session=" + str(session))
        return session

    def _java_int(self, value):
        try:
            return int(value)
        except (TypeError, ValueError):
            from java import cast, jclass
            return int(cast(jclass("java.lang.Number"), value).intValue())

    def _eq_find_session(self, obj, depth=0):
        # Media3 hides AudioTrack behind renderer -> sink, often deeper than
        # the public player wrapper. Never create an effect on global session 0.
        from java import jclass
        System = jclass("java.lang.System")
        Array = jclass("java.lang.reflect.Array")
        fields = ("audioPlayer", "player", "exoPlayer", "simpleExoPlayer",
                  "renderers", "audioSink", "sink", "audioTrack",
                  "forwardingAudioSink", "wrappedAudioSink", "delegate")
        queue = [(obj, depth, "MediaController")]
        seen = set()
        fallback = 0
        inspected = []
        while queue and len(seen) < 96:
            node, level, path = queue.pop(0)
            if node is None or level > 9:
                continue
            try:
                identity = int(System.identityHashCode(node))
                if identity in seen:
                    continue
                seen.add(identity)
                cls = node.getClass()
                name = str(cls.getName())
                if cls.isArray():
                    for index in range(min(16, int(Array.getLength(node)))):
                        queue.append((Array.get(node, index), level + 1, path + "[]"))
                    continue
                inspected.append(name.rsplit(".", 1)[-1])
                try:
                    session = self._java_session_id(node)
                except Exception:
                    session = 0
                if session > 0:
                    if name == "android.media.AudioTrack":
                        self._eq_debug.append(path + " session=" + str(session))
                        return session
                    fallback = fallback or session
                for field in fields:
                    try:
                        child = self._java_field(node, field)
                    except Exception:
                        child = None
                    if child is not None:
                        queue.append((child, level + 1, path + "." + field))
            except Exception:
                continue
        if not fallback:
            self._eq_debug.append("Player path: " + " → ".join(inspected[-10:]))
        return fallback

    def _eq_graph_config(self):
        low, high = -1500, 1500
        effect = getattr(self, "_eq_effect", None)
        if effect is not None:
            limits = effect.getBandLevelRange()
            low, high = int(limits[0]), int(limits[1])
        if high <= low:
            low, high = -1500, 1500
        return dict(low=low, high=high, values=[max(low, min(high, _eq_interpolate(self._eq_curve_gains(), freq))) for freq in _EQ_FREQUENCIES])

    def _eq_redraw(self):
        view = getattr(self, "_eq_web", None)
        if view is not None:
            view.evaluateJavascript("window.eqSet&&window.eqSet(" + json.dumps(self._eq_graph_config()) + ")", None)

    def _equalizer_view(self, context):
        from android.widget import LinearLayout, TextView
        from android.webkit import WebView, WebChromeClient
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.messenger import AndroidUtilities
        from java import jclass, cast
        from extera_utils.classes import Base, java_subclass, joverride
        root = LinearLayout(context)
        root.setOrientation(1)
        dp = AndroidUtilities.dp
        root.setPadding(dp(12), dp(8), dp(12), dp(12))
        self._eq_live_gains = None
        root.addView(self._rhythm_button(context, self._tr("Сбросить"), lambda: self._eq_preset("flat")))
        web = WebView(context)
        web.setBackgroundColor(0)
        settings = web.getSettings()
        settings.setJavaScriptEnabled(True)
        settings.setAllowFileAccess(False)
        settings.setAllowContentAccess(False)
        settings.setBlockNetworkLoads(True)
        plugin = self
        @java_subclass(WebChromeClient)
        class Chrome(Base):
            @joverride("onConsoleMessage", ["android.webkit.ConsoleMessage"])
            def onConsoleMessage(self, raw):
                message = str(cast(jclass("android.webkit.ConsoleMessage"), raw).message())
                if not message.startswith("MUSIC_EQ:"):
                    return False
                try:
                    data = json.loads(message[len("MUSIC_EQ:"):])
                    values = data["values"]
                    if len(values) != 5 or any(not isinstance(v, (int, float)) or not math.isfinite(v) for v in values):
                        return True
                    limits = plugin._eq_graph_config()
                    plugin._eq_live_gains = {str(freq): max(limits["low"], min(limits["high"], round(value))) for freq, value in zip(_EQ_FREQUENCIES, values)}
                    plugin._eq_apply_curve()
                    if data.get("final"):
                        plugin.set_setting("eq_gains", plugin._eq_live_gains, reload_settings=False)
                        plugin._eq_live_gains = None
                except Exception as exc:
                    plugin._eq_error = str(exc)[:180]
                return True
        peer = Chrome.new_instance()
        web.setWebChromeClient(peer.java)
        self._eq_chrome = peer
        self._eq_web = web
        def css(key):
            return "#" + format(Theme.getColor(key) & 0xffffff, "06x")
        colors = ":root{--surface:" + css(Theme.key_windowBackgroundGray) + ";--text:" + css(Theme.key_dialogTextBlack) + ";--muted:" + css(Theme.key_dialogTextGray) + ";--accent:" + css(Theme.key_windowBackgroundWhiteBlueText) + "}"
        html = _EQ_HTML.replace("</style>", colors + "</style>").replace("INITIAL_CONFIG", json.dumps(self._eq_graph_config()))
        web.loadDataWithBaseURL("https://localhost/", html, "text/html", "UTF-8", None)
        root.addView(web, LinearLayout.LayoutParams(-1, dp(300)))
        hint = TextView(context)
        hint.setText(self._tr("Тяни точки вверх и вниз. Изменения слышны сразу. Кривую можно настроить до запуска музыки."))
        hint.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
        root.addView(hint)
        return root

    def _metadata_open(self, ctx=None):
        from org.telegram.messenger import MediaController, FileLoader
        media, message = self._current_music()
        if message is None:
            self._service_help("Метаданные", "Сначала запусти музыкальный трек в Telegram, затем открой редактор снова.")
            return
        try:
            attached = str(getattr(message.messageOwner, "attachPath", "") or "")
            path = attached if os.path.isfile(attached) else str(FileLoader.getPathToMessage(message.messageOwner).getAbsolutePath())
            if not os.path.isfile(path):
                raise ValueError("Сначала полностью скачай трек в Telegram.")
            account = int(message.currentAccount)
        except Exception:
            self._service_help("Метаданные", "Сначала полностью скачай трек в Telegram.")
            return
        from android_utils import run_on_ui_thread
        def load():
            try:
                import mutagen
                from mutagen.easymp4 import EasyMP4Tags
                EasyMP4Tags.RegisterTextKey("composer", "\xa9wrt")
                audio = mutagen.File(path, easy=True)
                if audio is None:
                    raise ValueError("Формат трека не поддерживается.")
                values = {key: " / ".join(audio.get(key, [])) for key in (
                    "title", "artist", "album", "albumartist", "date", "genre", "tracknumber", "discnumber", "composer")}
                run_on_ui_thread(lambda: self._metadata_editor(path, account, values))
            except Exception as exc:
                self._service_help("Метаданные", str(exc) if isinstance(exc, ValueError) else
                                   "Не удалось прочитать файл. Перезапусти плагин после установки зависимости mutagen.")
        threading.Thread(target=load, daemon=True).start()

    def _metadata_editor(self, path, account, values):
        from client_utils import get_last_fragment
        from android.widget import LinearLayout, TextView, EditText, ScrollView, ImageView
        from org.telegram.ui.ActionBar import BottomSheet, Theme
        from org.telegram.messenger import AndroidUtilities, UserConfig
        fragment = get_last_fragment()
        if fragment is None:
            return
        activity = fragment.getParentActivity()
        root = LinearLayout(activity)
        root.setOrientation(1)
        root.setPadding(24, 16, 24, 24)
        scroll = ScrollView(activity)
        scroll.addView(root)
        cover = {"path": None}
        cover_preview = ImageView(activity)
        root.addView(cover_preview, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(120)))
        cover_label = TextView(activity)
        cover_label.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
        root.addView(cover_label)
        def cover_selected(path):
            from android.graphics import BitmapFactory
            previous = cover["path"]
            cover["path"] = path
            options = __import__("java").jclass("android.graphics.BitmapFactory$Options")()
            options.inSampleSize = 4
            cover_preview.setImageBitmap(BitmapFactory.decodeFile(path, options))
            cover_label.setText(self._ui("Новая обложка выбрана"))
            if previous:
                try: os.unlink(previous)
                except OSError: pass
        root.addView(self._rhythm_button(activity, self._ui("Выбрать обложку"), lambda: self._pick_cover(activity, cover_selected)))
        fields = {}
        for key, title in (
            ("title", "Название"), ("artist", "Исполнитель"), ("album", "Альбом"),
            ("albumartist", "Исполнитель альбома"), ("date", "Год / дата"), ("genre", "Жанр"),
            ("tracknumber", "Номер трека"), ("discnumber", "Номер диска"), ("composer", "Композитор")):
            label = TextView(activity)
            label.setText(self._tr(title))
            label.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
            root.addView(label)
            field = EditText(activity)
            field.setText(values.get(key, ""))
            field.setSingleLine(True)
            field.setFocusableInTouchMode(True)
            field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            field.setHintTextColor(Theme.getColor(Theme.key_dialogTextGray))
            root.addView(field)
            fields[key] = field
        status = TextView(activity)
        status.setText(self._tr("Сохранится копия трека в Избранное."))
        status.setTextColor(Theme.getColor(Theme.key_dialogTextGray))
        root.addView(status)
        builder = BottomSheet.Builder(activity)
        builder.setCustomView(scroll)
        dialog = builder.create()
        dialog.setFocusable(True)
        def save():
            data = {key: str(field.getText()).strip() for key, field in fields.items()}
            button.setEnabled(False)
            status.setText(self._tr("Сохраняем…"))
            def work():
                output = None
                try:
                    # Inspect format rather than Telegram's extensionless cache filename.
                    import mutagen
                    media = mutagen.File(path, easy=True)
                    mime = media.mime if media is not None else []
                    extension = ".mp3" if "audio/mpeg" in mime else ".m4a" if "audio/mp4" in mime else ".flac" if "audio/flac" in mime else ".ogg"
                    folder = tempfile.mkdtemp(prefix="music_tags_", dir=str(activity.getCacheDir().getAbsolutePath()))
                    filename = re.sub(r'[/\\\x00-\x1f]', "_", data.get("title") or "Edited track")[:100]
                    output = os.path.join(folder, filename + extension)
                    changes = {key: value for key, value in data.items() if value != values.get(key, "")}
                    _metadata_copy(path, output, changes, cover.get("path"))
                    def deliver():
                        try:
                            if int(UserConfig.selectedAccount) != account:
                                raise ValueError("Аккаунт изменился. Вернись к исходному аккаунту и сохрани снова.")
                            peer = int(UserConfig.getInstance(account).getClientUserId())
                            send_audio(peer, output, caption=" — ".join(v for v in (data["artist"], data["title"]) if v))
                            dialog.dismiss()
                        except Exception as exc:
                            status.setText(self._tr(str(exc)[:180]))
                            button.setEnabled(True)
                    from android_utils import run_on_ui_thread
                    run_on_ui_thread(deliver)
                except Exception as exc:
                    from android_utils import run_on_ui_thread
                    message = str(exc)[:160]
                    def fail():
                        status.setText(self._tr(message))
                        button.setEnabled(True)
                    run_on_ui_thread(fail)
            threading.Thread(target=work, daemon=True).start()
        button = self._rhythm_button(activity, "Сохранить копию в Избранное", save)
        root.addView(button)
        dialog.show()
        from java import jclass
        from android_utils import run_on_ui_thread
        flags = jclass("android.view.WindowManager$LayoutParams")
        window = dialog.getWindow()
        window.clearFlags(flags.FLAG_NOT_FOCUSABLE | flags.FLAG_ALT_FOCUSABLE_IM)
        window.setSoftInputMode(flags.SOFT_INPUT_ADJUST_RESIZE)
        def keyboard():
            fields["title"].requestFocus()
            AndroidUtilities.showKeyboard(fields["title"])
        run_on_ui_thread(keyboard, 200)

