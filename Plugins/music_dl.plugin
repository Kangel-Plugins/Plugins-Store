# Remove decorative emoji from plugin-owned templates, preserving track names.
def _plain_ui(value):
    value = re.sub(r"[\U0001F000-\U0001FAFF\u2600-\u27BF\uFE0F\u200D]", "", value)
    return value.strip()

for _lang_map in TEXTS.values():
    for _key, _value in list(_lang_map.items()):
        _lang_map[_key] = _plain_ui(_value)

