'Could not open the chat picker', 'Звук занят другим приложением': 'Audio is in use by another app', 'Ничего не найдено': 'No results found', 'Новый поиск': 'New search', 'Tidal не предоставил поток для прослушивания': 'Tidal did not provide an audio stream', 'Поток недоступен': 'Stream unavailable', 'Трек слишком большой': 'Track is too large', 'Плеер Android не смог открыть аудио (код %s, %s)': 'Android could not play audio (code %s, %s)', 'Чат не выбран': 'No chat selected', 'Выбери один чат': 'Select one chat', 'Отправка в темы пока не поддерживается': 'Sending to topics is not supported yet', 'не удалось определить выбранный чат': 'Could not identify the selected chat', 'аккаунт изменился. Выбери чат заново': 'Account changed. Select a chat again', 'Чат ': 'Chat ', 'Отправить': 'Send', 'окно выбора уже закрыто': 'The chat picker has already closed', '\n\nКуда: ': '\n\nTo: ', 'аккаунт изменился, отправка отменена': 'Account changed; sending cancelled', 'Подключаемся к сервису…': 'Connecting to the service…', 'Подготовка трека': 'Preparing track', 'Не удалось показать загрузку. Повтори попытку.': 'Could not show download progress. Try again.', 'Аккаунт изменился. Повтори выбор чата.': 'Account changed. Select a chat again.', 'Не удалось скачать': 'Download failed', 'Закрыть': 'Close', 'Файл передан Telegram для отправки': 'File handed to Telegram for sending', 'Скачиваем трек…': 'Downloading track…', 'Конвертируем в MP3…': 'Converting to MP3…', 'Подготавливаем название и обложку…': 'Preparing title and artwork…', 'Передаём файл в Telegram…': 'Handing file to Telegram…', 'Аккаунт изменился; отправка отменена.': 'Account changed; sending cancelled.', 'Открыть поиск музыки': 'Open music search', '\nПрослушиваний: ': '\nPlays: ', '  Лайков: ': '  Likes: ', '\nЖанр: ': '\nGenre: ', 'Плавающая кнопка поиска': 'Floating search button', 'Показывать кнопку внутри открытого чата': 'Show the button inside the open chat'}

class MusicPlugin(BasePlugin):

    # ── i18n ─────────────────────────────────────────────────────────────────

    def _lang(self) -> str:
        # Старые значения 0 и 1 сохранены: настройки при обновлении не собьются.
        value = self.get_setting("language", 2)
        if value == 0: return "ru"
        if value == 1: return "en"
        try:
            from org.telegram.messenger import LocaleController
            locale = LocaleController.getInstance().getCurrentLocale()
            code = str(locale.getLanguage()).lower()
            return "ru" if code == "ru" else "en"
        except Exception:
            try:
                from java.util import Locale
                return "ru" if str(Locale.getDefault().getLanguage()).lower() == "ru" else "en"
            except Exception: return "en"

    def _ui(self, text):
        if self._lang() == "ru": return text
        return _UI_EN.get(text, text)

    def _t(self, key: str, **kw) -> str:
        text = TEXTS.get(self._lang(), TEXTS["ru"]).get(key, key)
        try: return text.format(**kw)
        except: return text

    # ── settings helpers ─────────────────────────────────────────────────────

    def _svc(self)        -> str: return [SERVICE_SC,SERVICE_SP,SERVICE_TD][self.get_setting("service",0)]
    def _per_page(self)   -> int: return [3,5,7,10][self.get_setting("results_per_page",1)]
    def _limit(self)      -> int: return [10,20,30,50][self.get_setting("search_limit",1)]
    def _sc_cid(self)     -> str: return _safe_text(self.get_setting("sc_client_id","")).strip()
    def _sp_dc(self)      -> str: return _safe_text(self.get_setting("sp_dc","")).strip()
    def _td_tok(self)     -> str: return _safe_text(self.get_setting("td_token","")).strip()
    def _performer(self, artist: str) -> str: return f"{artist}"

    def _search_kw(self) -> Dict:
        return {"sc_cid": self._sc_cid(), "sp_dc": self._sp_dc(), "td_token": self._td_tok()}

    # ── favorites helpers ─────────────────────────────────────────────────────

    def _get_favs(self) -> List[Dict]:
        v = self.get_setting("liked_tracks",[])
        return v if isinstance(v, list) else []

    def _save_favs(self, items: List[Dict]) -> None:
        self.set_setting("liked_tracks", items, reload_settings=False)

    def _trim_favs(self, items: List[Dict]) -> List[Dict]:
        try: cap = int(self.get_setting("favorites_cap","200"))
        except: cap = 200
        return items[:max(10,min(cap,1000))]

    def _track_rec(self, t: Dict, query: str = "") -> Dict:
        return {
            "id":t.get("id"), "urn":t.get("urn",""), "title":t.get("title",""),
            "artist":t.get("artist",""), "duration":t.get("duration",""),
            "genre":t.get("genre",""), "year":t.get("year",""),
            "plays":t.get("plays",0), "likes":t.get("likes",0),
            "artwork_url":t.get("artwork_url",""), "service":t.get("service",SERVICE_SC),
            "query":query, "liked_at":_now_ts(), "like_count":1,
        }

    def _upsert_fav(self, t: Dict, query: str = "", delta: int = 1) -> Dict:
        with _locks["likes"]:
            favs = self._get_favs(); tid = t.get("id")
            for item in favs:
                if item.get("id") == tid:
                    item["like_count"] = max(1, int(item.get("like_count",1))+delta)
                    item["liked_at"]   = _now_ts()
                    for k in ("title","artist","duration","genre","year","plays","likes","artwork_url","service","urn"):
                        if t.get(k) is not None: item[k] = t[k]
                    if query: item["query"] = query
                    favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
                    self._save_favs(self._trim_favs(favs))
                    return item
            saved = self._track_rec(t, query=query)
            favs.insert(0, saved)
            favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
            self._save_favs(self._trim_favs(favs))
            return saved

    def _remove_fav(self, tid) -> bool:
        with _locks["likes"]:
            favs = self._get_favs(); before = len(favs)
            favs = [x for x in favs if x.get("id") != tid]
            if len(favs) == before: return False
            self._save_favs(favs); return True

    def _show_favs_page(self, pid, page: int):
        favs = self._get_favs()
        favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
        per_page = self._per_page()
        lang = self._lang()
        _search_sessions[pid] = {
            "mode": "favs", "results": favs, "page": page,
            "per_page": per_page, "lang": lang,
        }
        send_text(pid, build_favs_page(favs, page, per_page, lang))

    def _guide_show(self):
        if self.get_setting("guide_accepted_v1", False): return
        try:
            from client_utils import get_last_fragment
            from ui.alert import AlertDialogBuilder
            from android_utils import run_on_ui_thread
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if not activity: return
            guide = AlertDialogBuilder(activity)
            guide.set_title(self._ui("Music Downloader — как пользоваться"))
            guide.set_message(self._ui("Открой нужный чат и отправь команду .search — сообщение не появится в чате.\n\nВведи название, выбери сервис и нажми «Искать». Выбери трек, чтобы отправить его в текущий чат.\n\nБитрейт SoundCloud можно изменить в настройках плагина. Прежние команды .find и dlf также работают."))
            def accept(b, which):
                b.dismiss()
                def confirm():
                    box = AlertDialogBuilder(activity)
                    box.set_title(self._ui("Ты точно понял, как пользоваться?"))
                    box.set_message(self._ui("Учти, больше это окно ты не увидишь."))
                    def yes(dialog, n):
                        self.set_setting("guide_accepted_v1", True, reload_settings=False)
                        dialog.dismiss()
                    def again(dialog, n):
                        dialog.dismiss(); run_on_ui_thread(self._guide_show, 100)
                    box.set_positive_button(self._ui("Да да, я понял"), yes)
                    box.set_negative_button(self._ui("Погоди, я не понял"), again)
                    box.show()
                run_on_ui_thread(confirm, 100)
            guide.set_positive_button(self._ui("Принял"), accept)
            guide.show()
        except Exception as exc:
            try: self.logger.error("Music Downloader guide: %s", exc)
            except: pass

    def _open_search_ui(self, pid, source_fragment=None):
        from android_utils import run_on_ui_thread, OnClickListener
        from client_utils import get_last_fragment
        from ui.alert import AlertDialogBuilder
        from android.widget import LinearLayout, TextView, EditText, ScrollView, ImageView, FrameLayout, ProgressBar
        from android.view import Gravity
        from android.graphics.drawable import GradientDrawable, RippleDrawable, ShapeDrawable
        from android.graphics.drawable.shapes import PathShape
        from android.graphics import Path
        from android.content.res import ColorStateList
        from android.view.animation import DecelerateInterpolator
        from java import dynamic_proxy, jclass
        from org.telegram.messenger import AndroidUtilities, MediaDataController, UserConfig
        from org.telegram.ui.Components import BackupImageView
        from org.telegram.ui.ActionBar import BottomSheet, Theme
        fragment = source_fragment or get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity: return
        dp=AndroidUtilities.dp
        def color(key, fallback):
            try: return Theme.getColor(getattr(Theme, key))
            except Exception: return fallback
        primary=color('key_dialogTextBlack',-1)
        secondary=color('key_dialogTextGray',-7829368)
        surface=color('key_dialogBackground',-14671580)
        accent=color('key_windowBackgroundWhiteBlueText',-10053121)
        field_bg=color('key_windowBackgroundGray',-13421773)
        def background(fill, radius=16):
            d=GradientDrawable(); d.setColor(fill); d.setCornerRadius(float(dp(radius))); return d
        root=LinearLayout(activity); root.setOrientation(1); root.setPadding(dp(16),dp(4),dp(16),dp(12))
        state={'service':self._svc(),'query':'','page':0,'results':[],'closed':False,'generation':0,'sheet':None,'player':None,'player_token':0,'player_callbacks':[], 'preview_id':None,'preview_button':None, 'service_menu_open':False}
        scroll=ScrollView(activity); scroll.setFillViewport(False); scroll.addView(root)
        builder=BottomSheet.Builder(activity); builder.setCustomView(scroll)
        sheet=builder.create(); sheet.setFocusable(True); state['sheet']=sheet
        def set_preview_icon(view, mode):
            # API overloads differ between Android builds; a failed icon must not
            # interrupt rendering any result or disable the play button.
            spinner=view.getTag()
            if spinner is not None: spinner.setVisibility(0 if mode == 'loading' else 8)
            view.setVisibility(4 if mode == 'loading' else 0)
            view.setContentDescription(self._ui('Загружается аудио') if mode == 'loading' else self._ui('Остановить предпрослушивание') if mode == 'stop' else self._ui('Слушать трек'))
            if mode == 'loading': return
            try:
                shape=Path()
                if mode == 'stop':
                    shape.moveTo(5.0,5.0);shape.lineTo(19.0,5.0);shape.lineTo(19.0,19.0);shape.lineTo(5.0,19.0);shape.close()
                else:
                    shape.moveTo(7.0,3.0);shape.lineTo(20.0,12.0);shape.lineTo(7.0,21.0);shape.close()
                drawable=ShapeDrawable(PathShape(shape,24.0,24.0));drawable.getPaint().setColor(accent)
                view.setImageDrawable(drawable)
            except Exception:
                try:
                    resources=jclass('android.R$drawable')
                    view.setImageResource(resources.ic_media_pause if mode == 'stop' else resources.ic_media_play)
                    view.setColorFilter(accent)
                except Exception: pass
        def show_preview_error(message):
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(self._ui('Предпрослушивание: ')+str(message)[:160])
            except Exception:
                try: self.logger.error('Preview: %s',str(message)[:200])
                except Exception: pass
        def stop_preview():
            state['player_token'] += 1
            player=state.get('player');state['player']=None;state['preview_id']=None
            button=state.get('preview_button');state['preview_button']=None
            if button is not None:
                try: set_preview_icon(button,'play')
                except Exception: pass
            if player is not None:
                try: player.reset();player.release()
                except Exception:
                    try: player.release()
                    except Exception: pass
            manager=state.pop('audio_manager',None);focus=state.pop('audio_focus',None)
            if manager is not None and focus is not None:
                try: manager.abandonAudioFocus(focus)
                except Exception: pass
            state['player_callbacks']=[]
            path=state.pop('preview_path',None)
            if path:
                try: os.unlink(path)
                except OSError: pass
        def on_sheet_closed():
            state['closed']=True;state['generation']+=1;stop_preview()
        class OnClose(dynamic_proxy(jclass('android.content.DialogInterface$OnDismissListener'))):
            def onDismiss(self, dialog): on_sheet_closed()
        state['dismiss_listener']=OnClose();sheet.setOnDismissListener(state['dismiss_listener'])
        def preview(item, button):
            if state['preview_id'] == item.get('id'):
                stop_preview(); return
            stop_preview()
            state['preview_id']=item.get('id');state['preview_button']=button;set_preview_icon(button,'loading')
            token=state['player_token']
            def resolve():
                try:
                    service=item.get('service',SERVICE_SC)
                    if service==SERVICE_SP:
                        path=item.get('preview_url')
                        if not path:
                            token_sp=_sp_anon_token()
                            if not token_sp and self._sp_dc(): token_sp,_=_sp_user_token(self._sp_dc())
                            if token_sp:
                                response=requests.get(f"{SP_API}/tracks/{item['id']}",headers=_sp_headers(token_sp),timeout=12)
                                response.raise_for_status();path=response.json().get('preview_url')
                        if not path: raise ValueError(self._ui('Spotify не предоставил превью для этого трека'))
                    elif service==SERVICE_TD:
                        path,err=td_stream(item['id'],custom_token=self._td_tok())
                        if not path: raise ValueError(err or self._ui('Tidal не предоставил поток для прослушивания'))
                    else:
                        stream,err=sc_stream(item['id'],custom=self._sc_cid())
                        if not stream: raise ValueError(err or self._ui('Поток недоступен'))
                        if stream['protocol'] == 'hls':
                            audio=_fetch_hls_audio(stream['url'])
                        else:
                            response=_sc_get_retry(stream['url'],headers=SC_HEADERS)
                            response.raise_for_status();audio=response.content
                            if len(audio)>25*1024*1024: raise ValueError(self._ui('Трек слишком большой'))
                        # Use exactly the same AAC decoder and MP3 encoder which is
                        # already used by downloads, avoiding unsupported raw HLS containers.
                        cache_dir=str(activity.getCacheDir().getAbsolutePath())
                        fd,path=tempfile.mkstemp(prefix='music_preview_',suffix='.mp3',dir=cache_dir)
                        os.close(fd)
                        try:
                            if stream.get('codec') == 'aac':
                                _webview_encode_mp3(audio,path,128)
                            elif stream.get('protocol') == 'hls':
                                _sc_download_mp3(stream,path,128)
                            else:
                                with open(path,'wb') as output: output.write(_mp3_payload(audio))
                        except Exception:
                            try: os.unlink(path)
                            except OSError: pass
                            raise
                    def play():
                        if state['closed'] or token!=state['player_token']:
                            if service==SERVICE_SC:
                                try: os.unlink(path)
                                except OSError: pass
                            return
                        state['preview_path']=path if service==SERVICE_SC else None
                        try:
                            MediaPlayer=jclass('android.media.MediaPlayer')
                            AudioManager=jclass('android.media.AudioManager')
                            Context=jclass('android.content.Context')
                            class FocusChange(dynamic_proxy(jclass('android.media.AudioManager$OnAudioFocusChangeListener'))):
                                def onAudioFocusChange(self, change):
                                    if change < 0: run_on_ui_thread(stop_preview)
                            focus=FocusChange();manager=activity.getSystemService(Context.AUDIO_SERVICE)
                            if manager.requestAudioFocus(focus,AudioManager.STREAM_MUSIC,AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK) != AudioManager.AUDIOFOCUS_REQUEST_GRANTED:
                                stop_preview();show_preview_error(self._ui('Звук занят другим приложением'));return
                            state['audio_manager']=manager;state['audio_focus']=focus
                            player=MediaPlayer();state['player']=player
                            class Prepared(dynamic_proxy(jclass('android.media.MediaPlayer$OnPreparedListener'))):
                                def onPrepared(self, mp):
                                    if token!=state['player_token'] or state['closed']: return
                                    try: mp.start();set_preview_icon(button,'stop')
                                    except Exception: stop_preview()
                            class Complete(dynamic_proxy(jclass('android.media.MediaPlayer$OnCompletionListener'))):
                                def onCompletion(self, mp): stop_preview()
                            class Failed(dynamic_proxy(jclass('android.media.MediaPlayer$OnErrorListener'))):
                                def onError(proxy, mp, what, extra):
                                    stop_preview();show_preview_error(self._ui('Плеер Android не смог открыть аудио (код %s, %s)') % (what, extra));return True
                            prepared,complete,failed=Prepared(),Complete(),Failed()
                            state['player_callbacks']=[prepared,complete,failed,focus]
                            player.setOnPreparedListener(prepared);player.setOnCompletionListener(complete);player.setOnErrorListener(failed)
                            player.setDataSource(path);player.prepareAsync()
                        except Exception as exc:
                            message=str(exc);stop_preview();show_preview_error(message)
                    run_on_ui_thread(play)
                except Exception as exc:
                    message=str(exc)
                    def fail():
                        if token == state['player_token'] and not state['closed']:
                            stop_preview();show_preview_error(message)
                    run_on_ui_thread(fail)
            run_on_queue(resolve)
        def params(w=-1,h=-2,weight=0): return LinearLayout.LayoutParams(w,h,float(weight))
        def clear(): root.removeAllViews()
        def row():
            v=LinearLayout(activity); v.setOrientation(0); v.setGravity(Gravity.CENTER_VERTICAL); root.addView(v); return v
        def label(parent,value,size=15,tint=None):
            v=TextView(activity); v.setText(str(value)); v.setTextSize(float(size)); v.setTextColor(primary if tint is None else tint); parent.addView(v); return v
        def click(v, callback, fill=None):
            ripple_color = color('key_listSelector', 0x334c8bf5)
            try:
                shape = background(field_bg if fill is None else fill, 16)
                v.setBackground(RippleDrawable(ColorStateList.valueOf(ripple_color), shape, None))
            except Exception:
                v.setBackground(background(field_bg if fill is None else fill,16))
            v.setClickable(True)
            v.setOnClickListener(OnClickListener(lambda _:callback()))
        def text_button(parent,value, callback, width=-2):
            v=TextView(activity); v.setText(value); v.setTextSize(14.0); v.setTextColor(accent); v.setGravity(Gravity.CENTER); v.setPadding(dp(12),dp(8),dp(12),dp(8)); parent.addView(v,params(width,dp(44))); click(v,callback); return v
        def sticker(index, height=76):
            try:
                image=BackupImageView(activity); lp=params(dp(height),dp(height));lp.gravity=Gravity.CENTER_HORIZONTAL;root.addView(image,lp)
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(image,'SpottyAnimated',index,'130_130')
            except Exception: pass
        def status(title,index,detail=''):
            clear(); sticker(index); v=label(root,title,18);v.setGravity(Gravity.CENTER);v.setPadding(0,dp(4),0,dp(4))
            if detail:
                v=label(root,detail,13,secondary);v.setGravity(Gravity.CENTER);v.setPadding(0,0,0,dp(6))
        def form():
            stop_preview();clear(); sticker(30,70)
            v=label(root,self._ui('Что ищем?'),19);v.setPadding(0,0,0,dp(4))
            line=row(); field=EditText(activity);field.setSingleLine(True);field.setTextSize(15.0);field.setTextColor(primary);field.setHintTextColor(secondary);field.setHint(self._ui('Название или исполнитель'));field.setText(state['query']);field.setPadding(dp(14),0,dp(10),0);field.setBackground(background(field_bg,16));line.addView(field,params(0,dp(48),1))
            def submit():
                query=str(field.getText()).strip()
                if not query: field.setError(self._ui('Введите название песни')); return
                AndroidUtilities.hideKeyboard(field)
                state['query']=query;state['generation']+=1; generation=state['generation']; svc=state['service']
                status(self._ui('Ищем вашу песню…'),31)
                def task():
                    try:
                        results,err=service_search(svc,query,self._limit(),**self._search_kw())
                        def render():
                            if state['closed'] or generation!=state['generation']: return
                            if err: error(err);return
                            if not results:
                                status(self._ui('Ничего не найдено'),14); footer=row();text_button(footer,self._ui('Новый поиск'),form);return
                            state['results']=results;state['page']=0;results_page()
                        run_on_ui_thread(render)
                    except Exception as exc:
                        message=str(exc)
                        run_on_ui_thread(lambda: error(message) if not state['closed'] and generation==state['generation'] else None)
                run_on_queue(task)
            text_button(line,'⌕',submit,dp(48)).setTextSize(24.0)
            service_line=row(); label(service_line,self._ui('Сервис'),13,secondary)
            def open_services():
                state['service_menu_open']=not state['service_menu_open']
                menu.setVisibility(0 if state['service_menu_open'] else 8)
                if state['service_menu_open']:
                    menu.setAlpha(0.0);menu.animate().alpha(1.0).setDuration(180).start()
            service=text_button(service_line,SERVICE_NAMES[state['service']],open_services)
            menu=LinearLayout(activity);menu.setOrientation(1);menu.setPadding(dp(4),dp(4),dp(4),dp(4));menu.setBackground(background(surface,16));root.addView(menu,params(-1,-2));menu.setVisibility(8)
            for code in (SERVICE_SC,SERVICE_SP,SERVICE_TD):
                option=TextView(activity);option.setText(SERVICE_NAMES[code]);option.setTextColor(primary);option.setTextSize(15.0);option.setGravity(Gravity.CENTER_VERTICAL);option.setPadding(dp(16),0,dp(16),0);menu.addView(option,params(-1,dp(44)))
                def select(value=code):
                    state['service']=value;service.setText(SERVICE_NAMES[value]);state['service_menu_open']=False;menu.setVisibility(8)
                click(option,select,surface)
        def error(message):
            status(self._ui('Произошла ошибка'),18,str(message)[:250]+self._ui('\nСообщите @S1mclick'));actions=row();text_button(actions,self._ui('Повторить'),form)
        def choose(item):
            stop_preview();box=AlertDialogBuilder(activity);box.set_title(self._ui('Отправить трек?'));box.set_message(item.get('title','')+' — '+item.get('artist',''))
            selected_account=int(UserConfig.selectedAccount)
            def send_to(target):
                if int(UserConfig.selectedAccount)!=selected_account:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error(self._ui('Аккаунт изменился. Открой поиск и выбери чат заново.'))
                    return
                state['closed']=True;sheet.dismiss();tr=dict(item);tr['query']=state['query'];run_on_ui_thread(lambda:self._download_with_progress(target,tr,selected_account),250)
            def send_here(b,n):
                b.dismiss();send_to(pid)
            def pick_chat(b,n):
                b.dismiss()
                def picker_error(message):
                    try:
                        from ui.bulletin import BulletinHelper
                        BulletinHelper.show_error(self._ui('Выбор чата: ')+str(message)[:160])
                    except Exception:
                        try: self.logger.error('Chat picker: %s',message)
                        except Exception: pass
                def open_picker():
                    try:
                        Bundle=jclass('android.os.Bundle')
                        DialogsActivity=jclass('org.telegram.ui.DialogsActivity')
                        Delegate=jclass('org.telegram.ui.DialogsActivity$DialogsActivityDelegate')
                        args=Bundle();args.putBoolean('onlySelect',True);args.putBoolean('allowSwitchAccount',False);args.putBoolean('canSelectTopics',False)
                        picker=DialogsActivity(args)
                        class ChatSelection(dynamic_proxy(Delegate)):
                            def didSelectDialogs(proxy, picker_fragment, dialogs, *rest):
                                try:
                                    if dialogs is None or dialogs.size() < 1:
                                        picker_error(self._ui('Чат не выбран'));return False
                                    if dialogs.size() != 1:
                                        picker_error(self._ui('Выбери один чат'));return False
                                    selected=dialogs.get(0)
                                    try: target=int(selected.dialogId)
                                    except Exception:
                                        try: target=int(selected.longValue())
                                        except Exception: raise ValueError(self._ui('не удалось определить выбранный чат'))
                                    try: topic=int(selected.topicId)
                                    except Exception: topic=0
                                    if topic:
                                        picker_error(self._ui('Отправка в темы пока не поддерживается'));return False
                                    if not target:
                                        picker_error(self._ui('не удалось определить выбранный чат'));return False
                                    if int(UserConfig.selectedAccount)!=selected_account:
                                        picker_error(self._ui('аккаунт изменился. Выбери чат заново'));return False
                                    try:
                                        MessagesController=jclass('org.telegram.messenger.MessagesController')
                                        controller=MessagesController.getInstance(selected_account)
                                        if target > 0:
                                            user=controller.getUser(target)
                                            selected_name=((str(user.first_name or '')+' '+str(user.last_name or '')).strip() if user else '')
                                        else:
                                            chat=controller.getChat(-target)
                                            selected_name=str(chat.title or '') if chat else ''
                                        if not selected_name: selected_name=self._ui('Чат ')+str(target)
                                    except Exception: selected_name=self._ui('Чат ')+str(target)
                                    def show_confirmation():
                                        try:
                                            picker_activity=picker_fragment.getParentActivity()
                                            if not picker_activity: raise ValueError(self._ui('окно выбора уже закрыто'))
                                            confirm=AlertDialogBuilder(picker_activity);confirm.set_title(self._ui('Отправить трек?'))
                                            confirm.set_message(item.get('title','')+' — '+item.get('artist','')+self._ui('\n\nКуда: ')+selected_name)
                                            def confirmed(dialog,which):
                                                dialog.dismiss()
                                                if int(UserConfig.selectedAccount)!=selected_account:
                                                    picker_error(self._ui('аккаунт изменился, отправка отменена'));return
                                                try: picker_fragment.finishFragment()
                                                except Exception: pass
                                                self._music_picker_delegate=None;self._music_picker=None
                                                send_to(target)
                                            confirm.set_positive_button(self._ui('Отправить'),confirmed)
                                            confirm.set_negative_button(self._ui('Отмена'),lambda dialog,which:dialog.dismiss())
                                            confirm.show()
                                        except Exception as exc: picker_error(exc)
                                    run_on_ui_thread(show_confirmation, 100)
                                    return False
                                except Exception as exc:
                                    picker_error(exc);return False
                        delegate=ChatSelection()
                        # Keep both Java and Python peers alive after the search sheet closes.
                        self._music_picker_delegate=delegate;self._music_picker=picker
                        picker.setDelegate(delegate)
                        opened=fragment.presentFragment(picker)
                        if opened is False: raise ValueError(self._ui('экран чатов не открылся'))
                        sheet.dismiss()
                    except Exception as exc: picker_error(exc)
                # Opening a fragment from an AlertDialog click can race the dismiss animation.
                run_on_ui_thread(open_picker, 250)
            box.set_positive_button(self._ui('Отправить сюда'),send_here)
            box.set_neutral_button(self._ui('Другой чат'),pick_chat)
            box.set_negative_button(self._ui('Отмена'),lambda b,n:b.dismiss());box.show()
        def results_page():
            clear();line=row();v=label(line,self._ui('Результаты'),19);v.setLayoutParams(params(0,dp(44),1))
            try:
                image=BackupImageView(activity);line.addView(image,params(dp(44),dp(44)))
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(image,'SpottyAnimated',27,'80_80')
            except Exception: pass
            text_button(line,self._ui('Изменить'),form)
            total=len(state['results']);p=state['page'];start=p*5
            for item in state['results'][start:start+5]:
                outer=LinearLayout(activity);outer.setOrientation(0);outer.setGravity(Gravity.CENTER_VERTICAL);outer.setBackground(background(field_bg,12));lp=params(-1,dp(58));lp.bottomMargin=dp(4);root.addView(outer,lp)
                cell=LinearLayout(activity);cell.setOrientation(1);cell.setPadding(dp(12),dp(5),dp(4),dp(5));outer.addView(cell,params(0,-1,1))
                a=label(cell,item.get('title',''),15);a.setSingleLine(True)
                sub=item.get('artist','')+('  ·  '+item['duration'] if item.get('duration') else '');b=label(cell,sub,12,secondary);b.setSingleLine(True)
                click(cell,lambda tr=item:choose(tr),field_bg)
                play_frame=FrameLayout(activity);outer.addView(play_frame,params(dp(52),dp(52)))
                play_button=ImageView(activity);play_button.setPadding(dp(12),dp(12),dp(12),dp(12));play_frame.addView(play_button,FrameLayout.LayoutParams(-1,-1))
                spinner=ProgressBar(activity)
                progress_params=FrameLayout.LayoutParams(dp(24),dp(24),Gravity.CENTER);play_frame.addView(spinner,progress_params);spinner.setVisibility(8)
                try: spinner.setIndeterminateTintList(ColorStateList.valueOf(accent))
                except Exception: pass
                play_button.setTag(spinner)
                click(play_frame,lambda tr=item, control=play_button:preview(tr,control),field_bg)
                set_preview_icon(play_button,'play')
            nav=row();pages=max(1,(total+4)//5)
            def move(delta):
                stop_preview()
                state['page']=max(0,min(pages-1,state['page']+delta))
                results_page()
                root.setTranslationX(float(dp(28) * (1 if delta > 0 else -1)))
                root.setAlpha(0.35)
                root.animate().translationX(0.0).alpha(1.0).setDuration(320).setInterpolator(DecelerateInterpolator()).start()
            if p>0:
                text_button(nav,self._ui('Назад'),lambda:move(-1),dp(88))
            else:
                placeholder=TextView(activity);placeholder.setVisibility(4);nav.addView(placeholder,params(dp(88),dp(44)))
            counter=label(nav,str(p+1)+' / '+str(pages),13,secondary);counter.setGravity(Gravity.CENTER);counter.setLayoutParams(params(0,dp(40),1))
            if p+1<pages:
                text_button(nav,self._ui('Далее'),lambda:move(1),dp(88))
            else:
                placeholder=TextView(activity);placeholder.setVisibility(4);nav.addView(placeholder,params(dp(88),dp(44)))
        form();sheet.show()


    def _handle_chat_search(self, ctx):
        from android_utils import run_on_ui_thread
        from client_utils import get_last_fragment
        def open_search():
            try:
                context = ctx if isinstance(ctx,dict) else {}
                fragment = context.get('fragment') or get_last_fragment()
                # ChatActivity supplies the exact dialog id (including group sign).
                pid = None
                if fragment is not None:
                    try: pid = int(fragment.getDialogId())
                    except Exception: pass
                if not pid:
                    raw = context.get('dialog_id') or context.get('dialogId') or context.get('peer')
                    if raw is not None:
                        try: pid = int(raw)
                        except Exception: pass
                if not pid and context.get('userId'):
                    pid=int(context['userId'])
                if not pid and context.get('chatId'):
                    pid=-abs(int(context['chatId']))
                if not pid:
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error('Не удалось определить чат. Открой его и введи .search')
                    return
                self._open_search_ui(pid,fragment)
            except Exception as exc:
                try:
                    self.logger.error('Не удалось открыть поиск из меню чата: %s',exc)
                    from ui.bulletin import BulletinHelper
                    BulletinHelper.show_error('Не удалось открыть поиск: '+str(exc)[:120])
                except Exception: pass
        # Allow the chat action menu to close before opening the bottom sheet.
        run_on_ui_thread(open_search, 250)

    def _download_with_progress(self, pid, track, expected_account):
        from client_utils import get_last_fragment
        from android_utils import run_on_ui_thread
        from ui.alert import AlertDialogBuilder
        from org.telegram.messenger import UserConfig
        fragment=get_last_fragment();activity=fragment.getParentActivity() if fragment else None
        if not activity:
            try:
                from ui.bulletin import BulletinHelper
                BulletinHelper.show_error(self._ui('Не удалось показать загрузку. Повтори попытку.'))
            except Exception: pass
            return
        from android.widget import LinearLayout, TextView, ProgressBar
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.ui.ActionBar import Theme
        from android.content.res import ColorStateList
        from java import jclass
        dp=AndroidUtilities.dp
        layout=LinearLayout(activity);layout.setOrientation(1);layout.setPadding(dp(24),dp(8),dp(24),dp(20))
        status=TextView(activity);status.setText(self._ui('Подключаемся к сервису…'));status.setTextSize(14.0)
        status.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));layout.addView(status)
        try:
            MaterialBar=jclass('com.google.android.material.progressindicator.LinearProgressIndicator')
            MaterialStyle=jclass('com.google.android.material.R$style')
            ContextThemeWrapper=jclass('android.view.ContextThemeWrapper')
            themed=ContextThemeWrapper(activity,MaterialStyle.Widget_Material3Expressive_LinearProgressIndicator_Wavy)
            bar=MaterialBar(themed)
            # Reject older versions which silently lack wavy support.
            bar.setWaveAmplitude(dp(4));bar.setWavelengthDeterminate(dp(32));bar.setWavelengthIndeterminate(dp(32))
            bar.setWaveSpeed(dp(24));bar.setTrackThickness(dp(4))
        except Exception:
            bar=ProgressBar(activity,None,jclass('android.R$attr').progressBarStyleHorizontal)
        bar.setMax(100);bar.setIndeterminate(True)
        try:
            tint=ColorStateList.valueOf(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
            bar.setProgressTintList(tint);bar.setIndeterminateTintList(tint)
        except Exception: pass
        lp=LinearLayout.LayoutParams(-1,dp(24));lp.topMargin=dp(14);layout.addView(bar,lp)
        percent=TextView(activity);percent.setTextSize(12.0);percent.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        percent.setGravity(5);layout.addView(percent)
        progress=AlertDialogBuilder(activity);progress.set_title(self._ui('Подготовка трека'));progress.set_view(layout);progress.show()
        self._music_download_dialog=progress
        def report(stage, detail=''):
            def update():
                try:
                    if stage=='error':
                        progress.dismiss()
                        box=AlertDialogBuilder(activity);box.set_title(self._ui('Не удалось скачать'))
                        box.set_message(str(detail)[:250]+self._ui('\nСообщите @S1mclick'))
                        box.set_positive_button(self._ui('Повторить'),lambda b,n:(b.dismiss(),self._download_with_progress(pid,track,expected_account)))
                        box.set_negative_button(self._ui('Закрыть'),lambda b,n:b.dismiss());box.show()
                    elif stage=='done':
                        progress.dismiss()
                        from ui.bulletin import BulletinHelper
                        BulletinHelper.show_info(self._ui('Файл передан Telegram для отправки'))
                    elif stage=='percent':
                        value=max(0,min(100,int(detail)));bar.setIndeterminate(False);bar.setProgress(value,True)
                        status.setText(self._ui('Скачиваем трек…'));percent.setText(str(value)+'%')
                    else:
                        status.setText(str(detail));bar.setIndeterminate(True);percent.setText('')
                except Exception: pass
            run_on_ui_thread(update)
        def task():
            try:
                if int(UserConfig.selectedAccount)!=expected_account:
                    report('error',self._ui('Аккаунт изменился. Повтори выбор чата.'));return
                self._do_download(pid,track,progress=report,expected_account=expected_account)
            except Exception as exc: report('error',str(exc))
        run_on_queue(task)

    def _attach_music_button(self, fragment, root):
        if not self.get_setting('music_floating_button',True): return
        try:
            from android_utils import OnClickListener
            from android.widget import FrameLayout, ImageView
            from android.view import Gravity
            from android.content.res import ColorStateList
            from android.graphics.drawable import GradientDrawable, RippleDrawable
            from java import jclass, dynamic_proxy
            from org.telegram.messenger import AndroidUtilities
            from org.telegram.ui.ActionBar import Theme
            if root is None or not isinstance(root,FrameLayout): return
            if not int(fragment.getDialogId()): return
            tag='music_dl_floating_button_v1'
            if root.findViewWithTag(tag) is not None: return
            dp=AndroidUtilities.dp;button=ImageView(root.getContext());button.setTag(tag)
            button.setContentDescription(self._ui('Открыть поиск музыки'));button.setPadding(dp(14),dp(14),dp(14),dp(14))
            try:
                resources=jclass('org.telegram.messenger.R$drawable');button.setImageResource(resources.msg_search)
            except Exception:
                button.setImageResource(jclass('android.R$drawable').ic_menu_search)
            tint=Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)
            button.setColorFilter(tint)
            fill=GradientDrawable();fill.setColor(Theme.getColor(Theme.key_dialogBackground));fill.setCornerRadius(float(dp(18)))
            button.setBackground(RippleDrawable(ColorStateList.valueOf(0x334c8bf5),fill,None));button.setElevation(float(dp(6)))
            lp=FrameLayout.LayoutParams(dp(52),dp(52),Gravity.LEFT|Gravity.TOP)
            root.addView(button,lp)
            # Сохраняем относительную позицию, чтобы она переживала смену размера экрана.
            def stored(key, default):
                try: return max(0, min(1000, int(self.get_setting(key, default)))) / 1000.0
                except Exception: return default / 1000.0
            position={'x':stored('music_button_x',1000),'y':stored('music_button_y',850), 'drag':False}
            def place():
                width=max(0,root.getWidth()-button.getWidth());height=max(0,root.getHeight()-button.getHeight())
                if width and height and not position['drag']:
                    button.setX(float(width*position['x']));button.setY(float(height*position['y']))
            from android_utils import run_on_ui_thread
            run_on_ui_thread(place, 100)
            def opened(_):
                try:
                    pid=int(fragment.getDialogId())
                    if pid: self._open_search_ui(pid,fragment)
                except Exception as exc:
                    try: self.logger.error('Floating music button: %s',exc)
                    except Exception: pass
            button.setOnClickListener(OnClickListener(opened))
            from android.view import ViewConfiguration
            touch_slop=ViewConfiguration.get(root.getContext()).getScaledTouchSlop()
            touch={'x':0.0,'y':0.0,'left':0.0,'top':0.0,'moved':False}
            class TouchListener(dynamic_proxy(jclass('android.view.View$OnTouchListener'))):
                def onTouch(listener, view, event):
                    action=event.getActionMasked()
                    if action==0:  # ACTION_DOWN
                        touch.update(x=event.getRawX(),y=event.getRawY(),left=view.getX(),top=view.getY(),moved=False)
                        position['drag']=False;view.setPressed(True)
                        try: root.requestDisallowInterceptTouchEvent(True)
                        except Exception: pass
                        return True
                    if action==1 or action==3:  # ACTION_UP / ACTION_CANCEL
                        view.setPressed(False)
                        try: root.requestDisallowInterceptTouchEvent(False)
                        except Exception: pass
                        if touch['moved']:
                            width=max(1,root.getWidth()-view.getWidth());height=max(1,root.getHeight()-view.getHeight())
                            position['x']=max(0.0,min(1.0,view.getX()/width));position['y']=max(0.0,min(1.0,view.getY()/height))
                            position['drag']=False
                            if action==1:
                                self.set_setting('music_button_x',int(position['x']*1000),reload_settings=False)
                                self.set_setting('music_button_y',int(position['y']*1000),reload_settings=False)
                        elif action==1: view.performClick()
                        position['drag']=False
                        return True
                    if action==2:  # ACTION_MOVE
                        dx=event.getRawX()-touch['x'];dy=event.getRawY()-touch['y']
                        if not touch['moved'] and dx*dx+dy*dy > touch_slop*touch_slop:
                            touch['moved']=True;position['drag']=True;view.setPressed(False)
                        if touch['moved']:
                            view.setX(float(max(0,min(root.getWidth()-view.getWidth(),touch['left']+dx))))
                            view.setY(float(max(0,min(root.getHeight()-view.getHeight(),touch['top']+dy))))
                        return True
                    return True
            touch_listener=TouchListener();button.setOnTouchListener(touch_listener)
            from java.lang.ref import WeakReference
            self._music_buttons=[ref for ref in self._music_buttons if ref.get() is not None]
            self._music_buttons.append(WeakReference(button))
        except Exception as exc:
            try: self.logger.error('Cannot add floating music button: %s',exc)
            except Exception: pass

    def _floating_setting_changed(self, value):
        from android_utils import run_on_ui_thread
        def update():
            if not value:
                for ref in self._music_buttons:
                    try:
                        button=ref.get()
                        if button is None: continue
                        parent=button.getParent()
                        if parent is not None: parent.removeView(button)
                    except Exception: pass
                self._music_buttons=[]
            else:
                try:
                    from client_utils import get_last_fragment
                    fragment=get_last_fragment()
                    if fragment: self._attach_music_button(fragment,fragment.getFragmentView())
                except Exception: pass
        run_on_ui_thread(update)

    # ── lifecycle ─────────────────────────────────────────────────────────────

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._music_buttons=[]
        try:
            from base_plugin import MethodHook
            from hook_utils import find_class
            plugin=self
            class MusicChatViewHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        from android_utils import run_on_ui_thread
                        fragment=param.thisObject;root=param.getResult()
                        run_on_ui_thread(lambda:plugin._attach_music_button(fragment,root))
                    except Exception: pass
            self._music_view_hook=MusicChatViewHook()
            self.hook_all_methods(find_class('org.telegram.ui.ChatActivity'),'createView',self._music_view_hook)
            from client_utils import get_last_fragment
            current=get_last_fragment()
            if current:
                from android_utils import run_on_ui_thread
                run_on_ui_thread(lambda:self._attach_music_button(current,current.getFragmentView()),500)
        except Exception as exc:
            try: self.logger.error('Floating music hook: %s',exc)
            except Exception: pass
        from android_utils import run_on_ui_thread
        run_on_ui_thread(self._guide_show, 1000)
        self._menu_ids = []
        try:
            self._menu_ids.append(self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU, text="Поиск музыки",
                icon="msg_search", on_click=self._handle_chat_search, priority=20)))
        except Exception as exc:
            try: self.logger.error("Music chat menu: %s", exc)
            except Exception: pass
        for text, subtext, icon, cb, prio, is_ctx in [
            ("Music Downloader", "Search, favorites & recs", "msg_search", self.handle_music_menu,    20, False),
            ("Favorites",        "Show saved likes",         "msg_saved",  self.handle_fav_menu,      19, False),
            ("Recommendations",  "Based on your likes",      "msg_info",   self.handle_rec_menu,      18, False),
            ("Like best match",  "Save from last search",    "msg_saved",  self.handle_like_ctx_menu, 15, True),
        ]:
            mtype = MenuItemType.MESSAGE_CONTEXT_MENU if is_ctx else MenuItemType.DRAWER_MENU
            self._menu_ids.append(self.add_menu_item(MenuItemData(
                menu_type=mtype, text=text, subtext=subtext,
                icon=icon, on_click=cb, priority=prio,
            )))

    def on_plugin_unload(self):
        self._floating_setting_changed(False)
        self._music_picker_delegate = None
        self._music_picker = None
        for mid in getattr(self,"_menu_ids",[]):
            try: self.remove_menu_item(mid)
            except: pass

    # ── settings ─────────────────────────────────────────────────────────────

    def create_settings(self):
        return [
            Header(text=self._t("lang_hdr")),
            Selector(key="language", text=self._t("lang_select"), default=2,
                     items=["Русский", "English", "Автоматический / Automatic"], icon="msg_info"),
            Divider(),
            Header(text=self._t("svc_hdr")),
            Selector(key="service", text=self._t("svc_select"), default=0,
                     items=["SoundCloud ☁️","Spotify 🟢","Tidal 🌊"], icon="msg_search"),
            Input(key="sc_client_id", text=self._t("sc_cid"), default="",
                  subtext=self._t("sc_cid_sub"), icon="msg_search"),
            Input(key="sp_dc", text=self._t("sp_dc_key"), default="",
                  subtext=self._t("sp_dc_sub"), icon="msg_search"),
            Input(key="td_token", text=self._t("td_token"), default="",
                  subtext=self._t("td_token_sub"), icon="msg_search"),
            Divider(),
            Selector(key="mp3_bitrate", text=self._t("mp3_bitrate"), default=1,
                     items=["128 kb/s", "192 kb/s", "256 kb/s", "320 kb/s"], icon="msg_settings"),
            Header(text=self._t("ui_hdr")),
            Switch(key="music_floating_button", text=self._ui("Плавающая кнопка поиска"), default=True,
                   subtext=self._ui("Показывать кнопку внутри открытого чата"), icon="msg_search", on_change=self._floating_setting_changed),
            Selector(key="results_per_page", text=self._t("per_page"), default=1,
                     items=["3","5","7","10"], icon="msg_list"),
            Selector(key="search_limit", text=self._t("limit"), default=1,
                     items=["10","20","30","50"], icon="msg_search"),
            Switch(key="show_stats", text=self._t("show_stats"), default=True,
                   subtext=self._t("show_stats_sub"), icon="msg_stats"),
            Switch(key="show_genre", text=self._t("show_genre"), default=False,
                   subtext=self._t("show_genre_sub"), icon="msg_topic"),
            Divider(),
            Header(text=self._t("fav_hdr")),
            Switch(key="auto_like_downloads", text=self._t("auto_like"), default=True,
                   subtext=self._t("auto_like_sub"), icon="msg_saved"),
            Input(key="favorites_cap", text=self._t("fav_cap"), default="200",
                  subtext=self._t("fav_cap_sub"), icon="msg_more"),
        ]

    # ── recommendations ──────────────────────────────────────────────────────

    def _recommend(self, seeds: List[Dict], limit: int = 10) -> Tuple[List[Dict], Optional[str]]:
        favs = self._get_favs()
        if not favs and not seeds: return [], self._t("rec_need_likes")
        tc = Counter()
        for item in favs[:25]: tc.update(_tokens(_blob(item)))
        if not tc and seeds:
            for item in seeds[:5]: tc.update(_tokens(_blob(item)))
        profile_q = " ".join(t for t,_ in tc.most_common(5)).strip()
        queries = []
        if profile_q: queries.append(profile_q)
        for item in favs[:3]:
            q = " ".join(x for x in [item.get("artist",""),item.get("title","")] if x).strip()
            if q: queries.append(q)
        for item in seeds[:2]:
            q = " ".join(x for x in [item.get("artist",""),item.get("title","")] if x).strip()
            if q: queries.append(q)
        queries    = list(dict.fromkeys(queries))
        candidates = []
        kw         = self._search_kw()
        svc        = self._svc()
        for q in queries[:4]:
            res, _ = service_search(svc, q, max(20,limit*3), **kw)
            candidates.extend(res)
        candidates = _dedupe(candidates)
        liked_ids  = {x.get("id") for x in favs}
        seed_blob  = " ".join(_blob(x) for x in seeds)
        scored = []
        for t in candidates:
            if t.get("id") in liked_ids: continue
            s = _profile_score(t, favs)
            if seeds: s += SequenceMatcher(None,_normalize(_blob(t)),_normalize(seed_blob)).ratio()*2.0
            if profile_q: s += _base_score(profile_q,t)*0.35
            s += min(int(t.get("plays",0)),500000)/500000.0
            scored.append((s,t))
        scored.sort(key=lambda x:x[0],reverse=True)
        out, seen = [], set()
        for s,t in scored:
            tid = t.get("id")
            if tid in seen: continue
            seen.add(tid); t["_rec_score"]=s; out.append(t)
            if len(out)>=limit: break
        return (out,None) if out else ([],self._t("rec_failed"))

    # ── download ─────────────────────────────────────────────────────────────

    def _do_download(self, pid, track: Dict, progress=None, expected_account=None):
        svc  = track.get("service", SERVICE_SC)
        dur  = f" [{track['duration']}]" if track.get("duration") else ""
        icon = SERVICE_ICONS.get(svc,"🎵")
        def message(text, is_error=False):
            if progress and isinstance(text,tuple) and text[0]=='percent': progress('percent',text[1])
            elif progress: progress('error' if is_error else 'status',self._ui(text))
            else: send_text(pid,text)
        message(self._ui('Скачиваем трек…') if progress else self._t("downloading", icon=icon, svc=SERVICE_NAMES.get(svc,svc), title=track["title"], artist=track["artist"], dur=dur))

        art_result = [None]
        def _get_art(): art_result[0] = _fetch_art(track.get("artwork_url",""))
        art_th = threading.Thread(target=_get_art, daemon=True)
        art_th.start()

        ok = False; path = ""

        if svc == SERVICE_SC:
            path = "/sdcard/Download/music_dl_sc.mp3"
            try:
                if os.path.exists(path): os.remove(path)
            except: pass
            stream, err = sc_stream(track["id"], custom=self._sc_cid())
            if not stream:
                message(self._t("stream_err", e=err),True); return
            try:
                bitrate_index = self.get_setting("mp3_bitrate", 1)
                bitrate = [128, 192, 256, 320][bitrate_index] if isinstance(bitrate_index, int) and 0 <= bitrate_index < 4 else 192
                _sc_download_mp3(stream, path, bitrate, progress=(lambda stage: message(stage)) if progress else None)
                ok = True
            except Exception as exc:
                try:
                    if os.path.exists(path): os.remove(path)
                except OSError: pass
                message(self._t("stream_err", e=str(exc)[:200]),True); return

        elif svc == SERVICE_SP:
            sp_dc = self._sp_dc()
            if not sp_dc:
                message(self._t("no_sp_dc"),True); return
            dl_path, err = sp_download(track["id"], sp_dc=sp_dc, progress=(lambda value: progress('percent',value)) if progress else None)
            if not dl_path:
                message(self._t("sp_dl_err", e=err),True); return
            path = dl_path; ok = True

        elif svc == SERVICE_TD:
            path = "/sdcard/Download/music_dl_td.mp3"
            try:
                if os.path.exists(path): os.remove(path)
            except: pass
            stream, err = td_stream(track["id"], custom_token=self._td_tok())
            if not stream:
                message(self._t("td_dl_err", e=err),True); return
            ok = _dl_file(stream, path, progress=(lambda value: progress('percent',value)) if progress else None)
            if not ok:
                message(self._t("dl_err"),True); return

        if progress: message(self._ui('Подготавливаем название и обложку…'))
        art_th.join(timeout=12)
        write_id3(path=path, title=track["title"], artist=track["artist"],
                  performer=self._performer(track["artist"]),
                  genre=track.get("genre",""), year=track.get("year",""),
                  artwork=art_result[0], svc=svc)

        if self.get_setting("auto_like_downloads",True):
            self._upsert_fav(track, query=track.get("query",""), delta=1)

        caption  = f"{track['title']} — {track['artist']}{dur}\n"
        caption += SERVICE_NAMES.get(svc,svc)
        if track.get("plays"): caption += self._ui("\nПрослушиваний: ") + f"{int(track['plays']):,}"
        if track.get("likes"): caption += self._ui("  Лайков: ") + f"{int(track['likes']):,}"
        if track.get("genre"): caption += self._ui("\nЖанр: ") + str(track["genre"])
        if expected_account is not None:
            from org.telegram.messenger import UserConfig
            if int(UserConfig.selectedAccount)!=expected_account:
                message(self._ui('Аккаунт изменился; отправка отменена.'),True);return
        if progress: message(self._ui('Передаём файл в Telegram…'))
        send_audio(pid, path, caption=caption)
        if progress: progress('done','')

    # ── info / help ───────────────────────────────────────────────────────────

    def _show_info(self, pid):
        favs = self._get_favs(); svc = self._svc(); cid = self._sc_cid()
        send_text(pid, "\n".join([
            self._t("info_hdr"),
            self._t("info_ver",   v=__version__),
            self._t("info_svc",   svc=SERVICE_NAMES.get(svc,svc), code=svc),
            self._t("info_favs",  n=len(favs)),
            self._t("info_likes", n=sum(int(x.get("like_count",1)) for x in favs)),
            self._t("info_cid",   s=f"custom ({cid[:8]}...)" if cid else "builtin (auto)"),
            "", self._t("info_cmds"),
            self._t("cmd_find"),  self._t("cmd_dlf"),
            self._t("cmd_like"),  self._t("cmd_unlike"),
            self._t("cmd_rec"),   self._t("cmd_liked"),
            self._t("cmd_svc"),
            self._t("cmd_info"),
        ]))

    # ── menu handlers ─────────────────────────────────────────────────────────

    def handle_music_menu(self, ctx: Dict):
        pid = _extract_peer_id(ctx)
        if pid is None: return
        svc = self._svc()
        send_text(pid, "\n".join([
            f"Music Downloader [{SERVICE_NAMES.get(svc,svc)}]","",
            self._t("usage_find"), "dlf [N]",
            ".like [N]", ".unlike [N]", ".rec", ".liked", ".info",
            self._t("usage_service"),
        ]))

    def handle_fav_menu(self, ctx: Dict):
        pid = _extract_peer_id(ctx)
        if pid is None: return
        self._show_favs_page(pid, 1)

    def handle_rec_menu(self, ctx: Dict):
        pid = _extract_peer_id(ctx)
        if pid is None: return
        favs = self._get_favs()
        favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
        recs, err = self._recommend(favs[:5])
        if not recs: send_text(pid, err or self._t("rec_failed")); return
        lines = [self._t("rec_title", svc=SERVICE_NAMES.get(self._svc(),"")), ""]
        for i,t in enumerate(recs,1):
            dur   = f" [{t['duration']}]" if t.get("duration") else ""
            extra = []
            if t.get("genre"):  extra.append(t["genre"])
            if t.get("plays"):  extra.append(f"▶{int(t['plays']):,}")
            ext = f"  ({' • '.join(extra)})" if extra else ""
            lines.append(f"{i}. {t.get('title','')} — {t.get('artist','')}{dur}  · {t.get('_rec_score',0):.2f}{ext}")
        send_text(pid, "\n".join(lines))

    def handle_like_ctx_menu(self, ctx: Dict):
        pid = _extract_peer_id(ctx)
        if pid is None: return
        session = _search_sessions.get(pid)
        chosen = query = None
        kw = self._search_kw()

        text = _safe_text(getattr(ctx.get("message"), "messageText", "") or "")
        parsed = _extract_first_listed_track(text)
        if parsed:
            title, artist = parsed; q = f"{artist} {title}".strip()
            svc = session.get("service", self._svc()) if session else self._svc()
            res, _ = service_search(svc, q, 10, **kw)
            if res: chosen, query = res[0], q
        if chosen is None and session and session.get("results"):
            chosen = session["results"][0]; query = session.get("query","")

        if not chosen: send_text(pid, self._t("no_track_detect")); return
        liked = self._upsert_fav(chosen, query=query or "", delta=1)
        send_text(pid, self._t("fav_added", title=liked.get("title",""), artist=liked.get("artist","")))

    # ── command helpers ───────────────────────────────────────────────────────

    def _like_by_n(self, pid, arg: str):
        session = _search_sessions.get(pid)
        if not session: send_text(pid, self._t("no_search")); return
        if not arg: idx = 0
        elif arg.isdigit(): idx = int(arg)-1
        else: send_text(pid, self._t("usage_like")); return
        results = session["results"]
        if idx<0 or idx>=len(results): send_text(pid, self._t("out_of_range", n=len(results))); return
        liked = self._upsert_fav(results[idx], query=session.get("query",""), delta=1)
        send_text(pid, self._t("fav_added", title=liked.get("title",""), artist=liked.get("artist","")))

    def _unlike_by_n(self, pid, arg: str):
        favs = self._get_favs()
        favs.sort(key=lambda x:(int(x.get("like_count",1)),int(x.get("liked_at",0))),reverse=True)
        if not arg: idx = 0
        elif arg.isdigit(): idx = int(arg)-1
        else: send_text(pid, self._t("usage_unlike")); return
        if idx<0 or idx>=len(favs): send_text(pid, self._t("out_of_range", n=len(favs))); return
        if self._remove_fav(favs[idx].get("id")): send_text(pid, self._t("fav_removed"))
        else: send_text(pid, self._t("fav_not_found"))

    # ── hook ─────────────────────────────────────────────────────────────────

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not isinstance(params.message, str): return HookResult()
        msg = params.message.strip(); pid = params.peer

        if msg.lower() == ".search":
            from android_utils import run_on_ui_thread
            run_on_ui_thread(lambda: self._open_search_ui(pid))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .service
        if msg.lower().startswith(".service"):
            arg = msg[8:].strip().lower()
            if arg not in (SERVICE_SC,SERVICE_SP,SERVICE_TD):
                params.message = self._t("usage_service") + f"\n({SERVICE_NAMES.get(self._svc())})"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            self.set_setting("service", {SERVICE_SC:0,SERVICE_SP:1,SERVICE_TD:2}[arg], reload_settings=False)
            params.message = self._t("svc_changed", svc=SERVICE_NAMES[arg])
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        # .find
        if msg.startswith(".find"):
            query = msg[5:].strip()
            if not query:
                params.message = self._t("usage_find")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            svc=self._svc(); per_page=self._per_page(); limit=self._limit()
            show_stats=self.get_setting("show_stats",True); show_genre=self.get_setting("show_genre",False)
            lang=self._lang(); kw=self._search_kw()
            def task():
                # Проверка наличия нужных токенов
                if svc==SERVICE_SP and not self._sp_dc():
                    send_text(pid, self._t("no_sp_dc")); return
                results, err = service_search(svc, query, limit, **kw)
                if err == "no_cid": send_text(pid, self._t("no_cid")); return
                if err and err.startswith("sp_token_err"):
                    send_text(pid, self._t("sp_token_err", e=err.split(":",1)[-1])); return
                if not results: send_text(pid, self._t("not_found", q=query)); return
                _search_sessions[pid] = {
                    "mode":"search","service":svc,"query":query,"results":results,
                    "page":1,"per_page":per_page,
                    "show_stats":show_stats,"show_genre":show_genre,"lang":lang,
                }
                send_text(pid, build_page(results,1,per_page,query,show_stats,show_genre,svc,lang))
            run_on_queue(task)
            return HookResult(strategy=HookStrategy.CANCEL)

        # .fc next/prev
        if msg.startswith(".fc"):
            arg     = msg[3:].strip().lower()
            session = _search_sessions.get(pid)
            if not session:
                params.message = self._t("no_search")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if arg not in ("next","prev","previous"):
                params.message = "Usage: .fc next / .fc prev"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            results=session["results"]; per_page=session["per_page"]
            total=max(1,(len(results)+per_page-1)//per_page)
            new_page=session["page"]+(1 if arg=="next" else -1)
            if new_page<1:
                params.message=self._t("first_page")
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            if new_page>total:
                params.message=self._t("no_more")
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            session["page"]=new_page
            if session.get("mode") == "favs":
                text=build_favs_page(results,new_page,per_page,session.get("lang","ru"))
            else:
                text=build_page(results,new_page,per_page,session["query"],
                                session["show_stats"],session["show_genre"],
                                session.get("service",SERVICE_SC),session.get("lang","ru"))
            run_on_queue(lambda: send_text(pid,text))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .like
        if msg.lower().startswith(".like") and not msg.lower().startswith(".liked"):
            arg=msg[5:].strip()
            run_on_queue(lambda: self._like_by_n(pid,arg))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .unlike
        if msg.lower().startswith(".unlike"):
            arg=msg[7:].strip()
            run_on_queue(lambda: self._unlike_by_n(pid,arg))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .rec
        if msg.startswith(".rec"):
            run_on_queue(lambda: self.handle_rec_menu({"dialog_id":pid}))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .liked
        if msg.lower().startswith(".liked"):
            run_on_queue(lambda: self._show_favs_page(pid, 1))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .info
        if msg.startswith(".info"):
            run_on_queue(lambda: self._show_info(pid))
            return HookResult(strategy=HookStrategy.CANCEL)

        # dlf [N]
        if msg.lower().startswith("dlf"):
            arg=msg[3:].strip()
            if not arg: arg = "1"
            if not arg.isdigit():
                params.message=self._t("usage_dlf")
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            session=_search_sessions.get(pid)
            if not session:
                params.message=self._t("no_search")
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            idx=int(arg)-1
            if idx<0 or idx>=len(session["results"]):
                params.message=self._t("out_of_range",n=len(session["results"]))
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            track=dict(session["results"][idx]); track["query"]=session.get("query","")
            run_on_queue(lambda: self._do_download(pid,track))
            return HookResult(strategy=HookStrategy.CANCEL)

        # .download
        if msg.startswith(".download"):
            query=msg[9:].strip()
            if not query:
                params.message=self._t("usage_find")
                return HookResult(strategy=HookStrategy.MODIFY,params=params)
            svc=self._svc(); kw=self._search_kw()
            def qtask():
                if svc==SERVICE_SP and not self._sp_dc():
                    send_text(pid,self._t("no_sp_dc")); return
                send_text(pid,self._t("searching",svc=SERVICE_NAMES.get(svc,svc),q=query))
                results,err=service_search(svc,query,1,**kw)
                if not results: send_text(pid,err or self._t("not_found",q=query)); return
                t=dict(results[0]); t["query"]=query
                self._do_download(pid,t)
            run_on_queue(qtask)
            return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult()