_sc_client_id:    Optional[str]   = None
_sc_builtin_idx:  int             = 0
_sp_access_token: Optional[str]   = None
_sp_token_expiry: float           = 0.0
_search_sessions: Dict[Any, Dict] = {}
_locks = {
    "likes":  threading.Lock(),
    "cid":    threading.Lock(),
    "sp_tok": threading.Lock(),
}

# ─────────────────────────────────────────────────────────────────────────────
# Мелкие утилиты
# ─────────────────────────────────────────────────────────────────────────────

def _now_ts() -> int: return int(time.time())
def _safe_text(v: Any) -> str: return "" if v is None else str(v)

def _normalize(text: str) -> str:
    text = _safe_text(text).lower()
    text = re.sub(r"[\[\]()<>{}_~`*!?.,:;\"'\\/|+=\-]", " ", text)
    return re.sub(r"\s+", " ", text).strip()

def _tokens(text: str) -> List[str]:
    return [t for t in _normalize(text).split() if t and t not in STOP_WORDS and len(t) > 1]

def _dedupe(tracks: List[Dict]) -> List[Dict]:
    seen, out = set(), []
    for t in tracks:
        k = t.get("id") or t.get("urn")
        if k not in seen:
            seen.add(k); out.append(t)
    return out

def _safe_get(url: str, **kw):
    try:
        return requests.get(url, **kw)
    except SSLError:
        kw = dict(kw); kw["verify"] = False
        return requests.get(url, **kw)

def _extract_peer_id(ctx: Dict) -> Any:
    for k in ("dialog_id","chatId","userId","peer","dialogId"):
        if ctx.get(k) is not None: return ctx[k]
    return None

def _extract_first_listed_track(text: str) -> Optional[Tuple[str, str]]:
    if not text: return None
    for line in text.splitlines():
        m = re.match(r"^\s*\d+\.\s*(.+?)\s+—\s+(.+?)(?:\s+\[.*?\])?(?:\s+\(.*?\))?\s*$", line)
        if m: return m.group(1).strip(), m.group(2).strip()
    return None

# ─────────────────────────────────────────────────────────────────────────────
# Скоринг
# ─────────────────────────────────────────────────────────────────────────────

def _blob(t: Dict) -> str:
    return " | ".join(x for x in [t.get("title",""), t.get("artist",""), t.get("genre",""), t.get("year","")] if x)

def _base_score(query: str, t: Dict) -> float:
    q = _normalize(query)
    if not q: return 0.0
    title  = _normalize(t.get("title",""))
    artist = _normalize(t.get("artist",""))
    combo  = " ".join(x for x in [title, artist, _normalize(t.get("genre",""))] if x)
    qt = set(_tokens(query)); ct = set(_tokens(combo))
    overlap = len(qt & ct) / max(1, len(qt))
    s = 0.0
    if q == combo:  s += 10.0
    if q in title:  s += 4.0
    if q in artist: s += 2.5
    if q in combo:  s += 1.5
    s += overlap * 4.0
    s += SequenceMatcher(None, q, combo).ratio()  * 3.5
    s += SequenceMatcher(None, q, title).ratio()  * 1.6
    s += SequenceMatcher(None, q, artist).ratio() * 1.2
    s += min(int(t.get("plays",0) or 0), 250000) / 250000.0
    s += min(int(t.get("likes",0) or 0), 100000) /  50000.0
    return s

def _profile_score(t: Dict, liked: List[Dict]) -> float:
    if not liked: return 0.0
    tb = _blob(t); tt = set(_tokens(tb)); best = 0.0
    for l in liked:
        lb = _blob(l); lt = set(_tokens(lb))
        if not lt: continue
        ov  = len(tt & lt) / max(1, len(tt | lt))
        sim = SequenceMatcher(None, _normalize(tb), _normalize(lb)).ratio()
        s   = ov * 6.0 + sim * 4.0
        if l.get("genre") and t.get("genre") and _normalize(l["genre"]) == _normalize(t["genre"]):
            s += 1.25
        best = max(best, s)
    return best

# ─────────────────────────────────────────────────────────────────────────────
# ════════════════  SOUNDCLOUD  ════════════════════════════════════════════════
# ─────────────────────────────────────────────────────────────────────────────

def _sc_validate(cid: str) -> bool:
    try:
        r = _safe_get(f"{SC_API}/search/tracks",
                      params={"q":"test","limit":1,"client_id":cid},
                      headers=SC_HEADERS, timeout=8)
        return r.status_code == 200
    except Exception:
        return False

def _sc_parse_web() -> Optional[str]:
    try:
        resp = _safe_get("https://soundcloud.com", headers=SC_HEADERS, timeout=12)
        urls = re.findall(r'<script[^>]+crossorigin[^>]+src="(https://a-v2\.sndcdn\.com/assets/[^"]+\.js)"', resp.text)
        if not urls:
            urls = re.findall(r'"(https://a-v2\.sndcdn\.com/assets/[^"]+\.js)"', resp.text)
        for url in reversed(urls):
            try:
                js = _safe_get(url, headers=SC_HEADERS, timeout=10)
                for pat in [
                    r'client_id\s*:\s*"([a-zA-Z0-9]{32})"',
                    r'"client_id"\s*,\s*"([a-zA-Z0-9]{32})"',
                    r',client_id:"([a-zA-Z0-9]{32})"',
                    r'client_id:"([a-zA-Z0-9]{32})"',
                ]:
                    m = re.search(pat, js.text)
                    if m: return m.group(1)
            except Exception:
                continue
    except Exception:
        pass
    return None

def _sc_get_cid(custom: str = "") -> Optional[str]:
    global _sc_client_id, _sc_builtin_idx
    with _locks["cid"]:
        if custom:
            if _sc_validate(custom):
                _sc_client_id = custom
            return custom
        if _sc_client_id:
            return _sc_client_id
        parsed = _sc_parse_web()
        if parsed and _sc_validate(parsed):
            _sc_client_id = parsed
            return _sc_client_id
        for i in range(len(_SC_BUILTIN_IDS)):
            idx = (_sc_builtin_idx + i) % len(_SC_BUILTIN_IDS)
            cid = _SC_BUILTIN_IDS[idx]
            if _sc_validate(cid):
                _sc_client_id = cid; _sc_builtin_idx = idx
                return _sc_client_id
    return None

def _sc_invalidate():
    global _sc_client_id, _sc_builtin_idx
    _sc_client_id   = None
    _sc_builtin_idx = (_sc_builtin_idx + 1) % len(_SC_BUILTIN_IDS)

def _sc_track(t: dict) -> Dict:
    dur = t.get("duration", 0)
    tid = t.get("id") or _safe_text(t.get("urn","")).split(":")[-1]
    return {
        "service":     SERVICE_SC,
        "title":       t.get("title",""),
        "artist":      t.get("user",{}).get("username",""),
        "duration":    f"{dur//60000}:{(dur%60000)//1000:02d}" if dur else "",
        "id":          tid,
        "urn":         t.get("urn", f"soundcloud:tracks:{tid}"),
        "artwork_url": (t.get("artwork_url") or "").replace("large","t500x500"),
        "genre":       t.get("genre",""),
        "year":        (t.get("created_at") or "")[:4],
        "plays":       t.get("playback_count", 0),
        "likes":       t.get("likes_count", 0),
        "_query_score":0.0,
    }

def sc_search(query: str, limit: int = 20, custom: str = "") -> Tuple[List[Dict], Optional[str]]:
    cid = _sc_get_cid(custom)
    if not cid: return [], "no_cid"
    try:
        limit = max(1, min(int(limit), 50))
        resp = _safe_get(f"{SC_API}/search/tracks",
                         params={"q":query,"limit":limit,"client_id":cid,"app_version":"1735820463"},
                         headers=SC_HEADERS, timeout=12)
        if resp.status_code == 401:
            _sc_invalidate(); return [], "no_cid"
        results = []
        for t in resp.json().get("collection",[]):
            if not t.get("streamable") or t.get("policy") == "BLOCK": continue
            results.append(_sc_track(t))
        results = _dedupe(results)
        for t in results: t["_query_score"] = _base_score(query, t)
        results.sort(key=lambda x: x["_query_score"], reverse=True)
        return results, None
    except Exception as e:
        return [], str(e)

def _sc_get_retry(url: str, **kwargs):
    """Повторяем только временные ошибки SoundCloud, не показывая токены."""
    kwargs["timeout"] = (10, 25)
    for attempt in range(3):
        try:
            response = _safe_get(url, **kwargs)
            if response.status_code not in (429, 500, 502, 503, 504) or attempt == 2:
                return response
        except (requests.exceptions.Timeout, requests.exceptions.ConnectionError):
            if attempt == 2:
                raise
        time.sleep(attempt + 1)

def sc_stream(track_id, custom: str = ""):
    """Выбираем исключительно MP3, не выдаём Opus/AAC за MP3."""
    cid = _sc_get_cid(custom)
    if not cid:
        return None, "нет SC client_id"
    try:
        resp = _sc_get_retry(f"{SC_API}/tracks/{track_id}", params={"client_id": cid}, headers=SC_HEADERS)
        if resp.status_code == 401:
            _sc_invalidate()
            return None, "client_id устарел; повтори поиск"
        resp.raise_for_status()
        data = resp.json()
        choices = []
        track_auth = data.get("track_authorization")
        for tc in (data.get("media") or {}).get("transcodings", []):
            fmt = tc.get("format") or {}
            proto = (fmt.get("protocol") or "").lower()
            mime = (fmt.get("mime_type") or "").lower()
            preset = (tc.get("preset") or "").lower()
            url = tc.get("url") or ""
            if tc.get("snipped") or "/preview/" in url:
                continue
            is_mp3 = preset.startswith("mp3") or "audio/mpeg" in mime or "audio/mp3" in mime
            is_aac = preset.startswith("aac") or "audio/aac" in mime or "mp4a" in mime
            if not (is_mp3 or is_aac):
                continue
            if proto not in ("progressive", "hls") or not url:
                continue
            choices.append((0 if is_mp3 and proto == "progressive" else 1 if is_mp3 else 2, proto, url, "mp3" if is_mp3 else "aac"))
        choices.sort()
        errors = []
        for _, proto, endpoint, codec in choices:
            try:
                query = {"client_id": cid}
                if track_auth: query["track_authorization"] = track_auth
                response = _sc_get_retry(endpoint, params=query, headers=SC_HEADERS)
                response.raise_for_status()
                url = response.json().get("url")
                if url:
                    return {"url": url, "protocol": proto, "codec": codec}, None
            except Exception as exc:
                if isinstance(exc, requests.exceptions.Timeout): errors.append("SoundCloud долго не отвечает (тайм-аут)")
                elif isinstance(exc, requests.exceptions.ConnectionError): errors.append("нет соединения с SoundCloud")
                elif getattr(getattr(exc, "response", None), "status_code", None): errors.append("HTTP " + str(exc.response.status_code))
                else: errors.append(type(exc).__name__)
        if errors:
            return None, "SoundCloud не отдал поток: " + errors[-1]
        return None, "полный MP3/AAC-поток недоступен для этого трека (возможно, ограничение SoundCloud)"
    except requests.exceptions.Timeout:
        return None, "SoundCloud долго не отвечает после нескольких попыток. Попробуй позже или через другую сеть/VPN."
    except requests.exceptions.ConnectionError:
        return None, "нет соединения с SoundCloud. Проверь сеть или VPN."
    except Exception as exc:
        status = getattr(getattr(exc, "response", None), "status_code", None)
        return None, ("SoundCloud HTTP " + str(status)) if status else type(exc).__name__


def _mp3_payload(data: bytes) -> bytes:
    # HLS-сегменты иногда содержат собственный ID3-тег с временной меткой.
    while data.startswith(b"ID3") and len(data) >= 10:
        size = ((data[6] & 127) << 21) | ((data[7] & 127) << 14) | ((data[8] & 127) << 7) | (data[9] & 127)
        end = 10 + size + (10 if data[5] & 16 else 0)
        if end > len(data):
            raise ValueError("повреждён ID3 сегмента")
        data = data[end:]
    if len(data) < 4 or data[0] != 0xff or data[1] & 0xe0 != 0xe0:
        raise ValueError("поток не является обычным MP3; конвертер недоступен")
    return data


# lamejs 1.2.1, LGPL-3.0: https://github.com/zhuker/lamejs
# Source and licence: https://github.com/zhuker/lamejs/tree/master
_LAMEJS_ZLIB_B64 = ''

def _fetch_hls_audio(url, progress=None):
    """Загружаем HLS только в пределах ограничений; DRM не обходим."""
    for _ in range(4):
        r = _sc_get_retry(url, headers=SC_HEADERS)
        r.raise_for_status()
        lines = [x.strip() for x in r.text.splitlines() if x.strip()]
        if not lines or lines[0] != "#EXTM3U": raise ValueError("неверный HLS-плейлист")
        variants = [lines[i+1] for i, x in enumerate(lines[:-1]) if x.startswith("#EXT-X-STREAM-INF:") and not lines[i+1].startswith("#")]
        if variants:
            url = urllib.parse.urljoin(url, variants[0]); continue
        if any(x.startswith("#EXT-X-KEY:") and "METHOD=NONE" not in x for x in lines):
            raise ValueError("SoundCloud вернул зашифрованный поток — этот тип пока не поддерживается")
        if any(x.startswith("#EXT-X-BYTERANGE") for x in lines):
            raise ValueError("HLS с диапазонами байтов пока не поддерживается")
        if "#EXT-X-ENDLIST" not in lines: raise ValueError("неполный HLS-плейлист")
        items = []
        for x in lines:
            if x.startswith("#EXT-X-MAP:"):
                m = re.search(r'URI="([^"]+)"', x)
                if not m: raise ValueError("неверная инициализация HLS")
                items.append(m.group(1))
            elif not x.startswith("#"): items.append(x)
        if not items or len(items) > 3000: raise ValueError("некорректное количество сегментов")
        out = bytearray()
        for index, item in enumerate(items):
            segment = _sc_get_retry(urllib.parse.urljoin(url,item), headers=SC_HEADERS)
            segment.raise_for_status(); out.extend(segment.content)
            if len(out) > 25 * 1024 * 1024: raise ValueError("трек слишком большой для встроенного конвертера (25 МБ)")
            if progress: progress((index+1)*100//len(items))
        return bytes(out)
    raise ValueError("слишком много вложенных плейлистов")


def _webview_encode_mp3(audio: bytes, path: str, bitrate: int = 192):
    """Экспериментальный WebView: AAC -> PCM -> MP3, без сети в WebView."""
    from java import jclass, dynamic_proxy
    from android_utils import run_on_ui_thread
    ValueCallback = jclass("android.webkit.ValueCallback")
    WebView = jclass("android.webkit.WebView")
    ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
    encoder = zlib.decompress(base64.b64decode(_LAMEJS_ZLIB_B64)).decode("utf-8")
    js = """<html><head><meta name="viewport" content="width=device-width"></head><body><script>
""" + encoder + """
window.parts=[];window.out='';window.status='waiting';
window.startEncode=async function(){try{
let b=atob(window.parts.join('')); window.parts=[];let raw=new Uint8Array(b.length);for(let i=0;i<b.length;i++)raw[i]=b.charCodeAt(i); b=null;
let ctx=new (window.AudioContext||window.webkitAudioContext)();let decoded=await ctx.decodeAudioData(raw.buffer);raw=null;
let n=Math.min(2,decoded.numberOfChannels);let rate=decoded.sampleRate;
let enc=new lamejs.Mp3Encoder(n,rate,""" + str(bitrate if bitrate in (128, 192, 256, 320) else 192) + """), left=decoded.getChannelData(0),right=n===2?decoded.getChannelData(1):null,out=[];
for(let i=0;i<left.length;i+=1152){let len=Math.min(1152,left.length-i),l=new Int16Array(len),r=n===2?new Int16Array(len):null;
for(let j=0;j<len;j++){let v=Math.max(-1,Math.min(1,left[i+j]));l[j]=v<0?v*32768:v*32767;if(r){v=Math.max(-1,Math.min(1,right[i+j]));r[j]=v<0?v*32768:v*32767;}}
let chunk=r?enc.encodeBuffer(l,r):enc.encodeBuffer(l);if(chunk.length)out.push(new Uint8Array(chunk));}
let end=enc.flush();if(end.length)out.push(new Uint8Array(end)); let size=out.reduce((a,c)=>a+c.length,0), bytes=new Uint8Array(size),off=0;
for(let c of out){bytes.set(c,off);off+=c.length;}out=[];let segments=[];for(let i=0;i<bytes.length;i+=8192)segments.push(String.fromCharCode.apply(null,bytes.subarray(i,i+8192)));
window.out=btoa(segments.join(''));window.status='done';await ctx.close();
}catch(e){window.status='error:'+String(e);}};
</script></body></html>"""
    state = {"view":None, "callback":None}
    def ui_call(fn, timeout=30):
        event=threading.Event(); box={}
        def action():
            try: box["value"]=fn()
            except Exception as exc: box["error"]=exc
            finally: event.set()
        run_on_ui_thread(action)
        if not event.wait(timeout): raise ValueError("WebView не ответил")
        if "error" in box: raise box["error"]
        return box.get("value")
    def setup():
        view=WebView(ApplicationLoader.applicationContext); settings=view.getSettings()
        settings.setJavaScriptEnabled(True); settings.setAllowFileAccess(False); settings.setAllowContentAccess(False); settings.setBlockNetworkLoads(True)
        view.loadDataWithBaseURL("https://localhost/", js, "text/html", "UTF-8", None); state["view"]=view
    def evaluate(code):
        done=threading.Event(); result={}
        class Callback(dynamic_proxy(ValueCallback)):
            def onReceiveValue(self, value):
                result["value"]=str(value); done.set()
        cb=Callback(); state["callback"]=cb
        ui_call(lambda:state["view"].evaluateJavascript(code,cb))
        if not done.wait(30): raise ValueError("WebView не ответил на запрос")
        return json.loads(result.get("value","null"))
    try:
        ui_call(setup)
        for _ in range(100):
            if evaluate("typeof window.startEncode") == "function": break
            time.sleep(0.1)
        else: raise ValueError("WebView не загрузил кодировщик")
        data=base64.b64encode(audio).decode("ascii")
        for offset in range(0,len(data),49152):
            evaluate("window.parts.push("+json.dumps(data[offset:offset+49152])+");true")
        evaluate("window.status='encoding';window.startEncode();true")
        deadline=time.time()+240
        while time.time()<deadline:
            status=evaluate("window.status")
            if status=="done": break
            if status and status.startswith("error:"): raise ValueError("не удалось декодировать поток: "+status[6:150])
            time.sleep(0.5)
        else: raise ValueError("конвертация заняла слишком много времени")
        length=evaluate("window.out.length"); parts=[]
        for offset in range(0,int(length),49152):
            parts.append(evaluate("window.out.slice(%d,%d)" % (offset,offset+49152)))
        result=base64.b64decode("".join(parts),validate=True)
        if not result.startswith((b"ID3",b"\xff")): raise ValueError("кодировщик не создал MP3")
        with open(path,"wb") as output: output.write(result)
    finally:
        if state["view"] is not None:
            try: ui_call(lambda:state["view"].destroy())
            except Exception: pass

def _read_stream_bytes(response, progress=None, limit=None):
    response.raise_for_status()
    total_text=response.headers.get('Content-Length', '')
    try: total=int(total_text)
    except (TypeError, ValueError): total=0
    if response.headers.get('Content-Encoding', 'identity').lower() not in ('', 'identity'): total=0
    if limit and total > limit: raise ValueError('трек слишком большой (25 МБ)')
    out=bytearray(); last=-1
    for chunk in response.iter_content(chunk_size=65536):
        if not chunk: continue
        out.extend(chunk)
        if limit and len(out)>limit: raise ValueError('трек слишком большой (25 МБ)')
        if progress and total>0:
            value=min(100, len(out)*100//total)
            if value!=last: progress(value);last=value
    return bytes(out)

def _sc_download_mp3(stream: Dict, path: str, bitrate: int = 192, progress=None) -> None:
    url = stream["url"]
    if stream.get("codec") == "aac":
        if stream["protocol"] == "hls":
            audio = _fetch_hls_audio(url, progress=(lambda value: progress(('percent',value))) if progress else None)
        else:
            with _sc_get_retry(url, headers=SC_HEADERS, stream=True) as r:
                audio = _read_stream_bytes(r, (lambda value: progress(('percent',value))) if progress else None, 25*1024*1024)
        if progress: progress("Конвертируем в MP3…")
        _webview_encode_mp3(audio, path, bitrate)
        return
    if stream["protocol"] == "progressive":
        with _safe_get(url, headers=SC_HEADERS, timeout=60, stream=True) as r:
            audio = _mp3_payload(_read_stream_bytes(r, (lambda value: progress(('percent',value))) if progress else None))
        with open(path, "wb") as out:
            out.write(audio)
        return
    # Поддерживаем незашифрованный VOD HLS с MP3-сегментами.
    for depth in range(3):
        r = _safe_get(url, headers=SC_HEADERS, timeout=20)
        r.raise_for_status()
        lines = [line.strip() for line in r.text.splitlines() if line.strip()]
        if not lines or lines[0] != "#EXTM3U":
            raise ValueError("SoundCloud вернул неверный HLS-плейлист")
        if any(line.startswith("#EXT-X-STREAM-INF:") for line in lines):
            variants = [lines[i+1] for i, line in enumerate(lines[:-1]) if line.startswith("#EXT-X-STREAM-INF:") and not lines[i+1].startswith("#")]
            if not variants:
                raise ValueError("в HLS нет аудиопотока")
            url = urllib.parse.urljoin(url, variants[0])
            continue
        if any(line.startswith("#EXT-X-KEY:") and "METHOD=NONE" not in line for line in lines):
            raise ValueError("зашифрованный поток не поддерживается")
        if any(line.startswith(("#EXT-X-BYTERANGE", "#EXT-X-MAP")) for line in lines):
            raise ValueError("этот формат HLS пока не поддерживается")
        if "#EXT-X-ENDLIST" not in lines:
            raise ValueError("SoundCloud вернул неполный поток")
        segments = [line for line in lines if not line.startswith("#")]
        if not segments or len(segments) > 5000:
            raise ValueError("неверное число сегментов")
        with open(path, "wb") as out:
            for index, segment in enumerate(segments):
                part = _safe_get(urllib.parse.urljoin(url, segment), headers=SC_HEADERS, timeout=30)
                part.raise_for_status()
                out.write(_mp3_payload(part.content))
                if progress: progress(('percent',(index+1)*100//len(segments)))
        return
    raise ValueError("слишком много вложенных HLS-плейлистов")

# ─────────────────────────────────────────────────────────────────────────────
# ════════════════  SPOTIFY  ═══════════════════════════════════════════════════
# ─────────────────────────────────────────────────────────────────────────────
# Поиск: client_credentials (публичный client_id, без аккаунта)
# Скачивание: sp_dc → accessToken → unofficial download API
# ─────────────────────────────────────────────────────────────────────────────

def _sp_anon_token() -> Optional[str]:
    """Client credentials flow через публичный client_id — только для поиска."""
    global _sp_access_token, _sp_token_expiry
    with _locks["sp_tok"]:
        if _sp_access_token and time.time() < _sp_token_expiry - 60:
            return _sp_access_token
        try:
            r = requests.post(
                SP_TOKEN_URL,
                data={"grant_type":"client_credentials"},
                auth=(SP_PUBLIC_CID, ""),
                timeout=10,
            )
            d = r.json()
            tok = d.get("access_token")
            if tok:
                _sp_access_token = tok
                _sp_token_expiry = time.time() + d.get("expires_in", 3600)
                return tok
        except Exception:
            pass
        return None

def _sp_user_token(sp_dc: str) -> Tuple[Optional[str], Optional[str]]:
    """
    Получить accessToken через sp_dc куку.
    Нужен для скачивания (дает выше уровень доступа).
    sp_dc — значение куки sp_dc из браузера.
    """
    try:
        r = requests.get(
            "https://open.spotify.com/get_access_token",
            params={"reason":"transport","productType":"web_player"},
            headers={
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
                "Cookie":     f"sp_dc={sp_dc}",
                "Referer":    "https://open.spotify.com/",
            },
            timeout=10,
        )
        d = r.json()
        if d.get("isAnonymous"):
            return None, "sp_dc невалидный или устарел"
        tok = d.get("accessToken")
        return (tok, None) if tok else (None, "нет токена в ответе")
    except Exception as e:
        return None, str(e)

def _sp_headers(token: Optional[str]) -> Dict:
    h = {"User-Agent":"Mozilla/5.0","Accept":"application/json"}
    if token: h["Authorization"] = f"Bearer {token}"
    return h

def sp_search(query: str, limit: int = 20, sp_dc: str = "") -> Tuple[List[Dict], Optional[str]]:
    # Для поиска используем анонимный токен (не нужен sp_dc)
    tok = _sp_anon_token()
    if not tok:
        # fallback: если есть sp_dc — пробуем через него
        if sp_dc:
            tok, err = _sp_user_token(sp_dc)
            if not tok:
                return [], f"sp_token_err:{err}"
        else:
            return [], "sp_token_err:нет токена"
    try:
        limit = max(1, min(limit, 50))
        resp = requests.get(f"{SP_API}/search",
                            params={"q":query,"type":"track","limit":limit},
                            headers=_sp_headers(tok), timeout=12)
        if resp.status_code == 401:
            global _sp_access_token
            _sp_access_token = None
            return [], "sp_token_err:токен истёк, повтори"
        items = resp.json().get("tracks",{}).get("items",[])
        results = []
        for t in items:
            dur = t.get("duration_ms",0)
            artists = ", ".join(a["name"] for a in t.get("artists",[]))
            imgs = t.get("album",{}).get("images",[])
            art = sorted(imgs, key=lambda x: x.get("width",0), reverse=True)[0].get("url","") if imgs else ""
            results.append({
                "service":     SERVICE_SP,
                "title":       t.get("name",""),
                "artist":      artists,
                "duration":    f"{dur//60000}:{(dur%60000)//1000:02d}" if dur else "",
                "id":          t.get("id",""),
                "sp_url":      t.get("external_urls",{}).get("spotify",""),
                "preview_url": t.get("preview_url") or "",
                "artwork_url": art,
                "genre":       "",
                "year":        (t.get("album",{}).get("release_date") or "")[:4],
                "plays":       t.get("popularity",0) * 1000,
                "likes":       0,
                "_query_score":0.0,
            })
        results = _dedupe(results)
        for t in results: t["_query_score"] = _base_score(query, t)
        results.sort(key=lambda x: x["_query_score"], reverse=True)
        return results, None
    except Exception as e:
        return [], str(e)

def sp_download(track_id: str, sp_dc: str = "", progress=None) -> Tuple[Optional[str], Optional[str]]:
    """
    Скачивание через spotifydown.com API.
    Если есть sp_dc — отправляем для лучшего качества.
    """
    try:
        hdrs = dict(SP_DL_HEADERS)
        r = requests.get(f"{SP_DL_BASE}/download/{track_id}", headers=hdrs, timeout=25)
        d = r.json()
        if not d.get("success"):
            return None, d.get("message","spotifydown ошибка")
        url = d.get("link")
        if not url: return None, "нет ссылки на файл"
        path = "/sdcard/Download/music_dl_sp.mp3"
        if _dl_file(url, path, headers=hdrs, progress=progress): return path, None
        return None, "ошибка загрузки"
    except Exception as e:
        return None, str(e)

# ─────────────────────────────────────────────────────────────────────────────
# ════════════════  TIDAL  ═════════════════════════════════════════════════════
# ─────────────────────────────────────────────────────────────────────────────

def _td_headers(custom_token: str = "") -> Dict:
    h = dict(TD_HEADERS)
    if custom_token:
        h["X-Tidal-Token"] = custom_token
    return h

def td_search(query: str, limit: int = 20, custom_token: str = "") -> Tuple[List[Dict], Optional[str]]:
    try:
        limit = max(1, min(limit, 50))
        resp = _safe_get(f"{TD_API}/search",
                         params={"query":query,"limit":limit,"countryCode":TD_COUNTRY,"types":"TRACKS"},
                         headers=_td_headers(custom_token), timeout=12)
        if resp.status_code in (401, 403):
            return [], "Tidal токен заблокирован. Укажи свой в настройках."
        items = resp.json().get("tracks",{}).get("items",[])
        results = []
        for t in items:
            dur = t.get("duration",0)
            artists = ", ".join(a.get("name","") for a in t.get("artists",[]))
            cover = (t.get("album",{}).get("cover") or "").replace("-","/")
            art = f"https://resources.tidal.com/images/{cover}/1280x1280.jpg" if cover else ""
            results.append({
                "service":     SERVICE_TD,
                "title":       t.get("title",""),
                "artist":      artists,
                "duration":    f"{dur//60}:{dur%60:02d}" if dur else "",
                "id":          t.get("id"),
                "artwork_url": art,
                "genre":       "",
                "year":        _safe_text(t.get("streamStartDate",""))[:4],
                "plays":       t.get("popularity",0) * 1000,
                "likes":       0,
                "_query_score":0.0,
            })
        results = _dedupe(results)
        for t in results: t["_query_score"] = _base_score(query, t)
        results.sort(key=lambda x: x["_query_score"], reverse=True)
        return results, None
    except Exception as e:
        return [], str(e)

def td_stream(track_id, custom_token: str = "") -> Tuple[Optional[str], Optional[str]]:
    """LOSSLESS → HIGH → LOW приоритет качества."""
    for quality in ("LOSSLESS","HIGH","LOW"):
        try:
            resp = _safe_get(f"{TD_API}/tracks/{track_id}/streamUrl",
                             params={"soundQuality":quality,"countryCode":TD_COUNTRY},
                             headers=_td_headers(custom_token), timeout=12)
            if resp.status_code == 200:
                url = resp.json().get("url")
                if url: return url, None
        except Exception:
            continue
    return None, "нет доступного потока"

# ─────────────────────────────────────────────────────────────────────────────
# Диспетч поиска
# ─────────────────────────────────────────────────────────────────────────────

def service_search(svc: str, query: str, limit: int = 20, **kw) -> Tuple[List[Dict], Optional[str]]:
    if svc == SERVICE_SC: return sc_search(query, limit, custom=kw.get("sc_cid",""))
    if svc == SERVICE_SP: return sp_search(query, limit, sp_dc=kw.get("sp_dc",""))
    if svc == SERVICE_TD: return td_search(query, limit, custom_token=kw.get("td_token",""))
    return [], f"неизвестный сервис: {svc}"

# ─────────────────────────────────────────────────────────────────────────────
# Файлы / обложки
# ─────────────────────────────────────────────────────────────────────────────

def _dl_file(url: str, path: str, headers: Optional[Dict] = None, progress=None) -> bool:
    try:
        with _safe_get(url, headers=headers or SC_HEADERS, stream=True, timeout=300) as r:
            r.raise_for_status()
            try: total=int(r.headers.get('Content-Length',0))
            except (ValueError, TypeError): total=0
            if r.headers.get('Content-Encoding','identity').lower() not in ('','identity'): total=0
            written=0;last=-1
            with open(path, "wb") as f:
                for chunk in r.iter_content(chunk_size=131072):
                    if chunk:
                        f.write(chunk);written+=len(chunk)
                        if progress and total>0:
                            value=min(100,written*100//total)
                            if value!=last: progress(value);last=value
        return True
    except Exception:
        return False

def _fetch_art(url: str) -> Optional[bytes]:
    # Без Pillow обложку не обрабатываем — просто пропускаем.
    if not _PIL_OK or not url: return None
    try:
        r = _safe_get(url, timeout=10); r.raise_for_status()
        img = Image.open(io.BytesIO(r.content)).convert("RGB")
        buf = io.BytesIO(); img.save(buf, format="JPEG", quality=95)
        return buf.getvalue()
    except Exception:
        return None

# ─────────────────────────────────────────────────────────────────────────────
# ID3 (pure Python)
# ─────────────────────────────────────────────────────────────────────────────

def _syncsafe(n: int) -> bytes:
    r = bytearray(4)
    for i in range(3,-1,-1): r[i] = n & 0x7F; n >>= 7
    return bytes(r)

def _frame(fid: str, data: bytes) -> bytes:
    return fid.encode() + struct.pack(">I",len(data)) + b"\x00\x00" + data

def _tf(fid: str, text: str) -> bytes:
    return _frame(fid, b"\x03" + text.encode("utf-8"))

def _apic(jpeg: bytes) -> bytes:
    return _frame("APIC", b"\x03image/jpeg\x00\x03\x00" + jpeg)

def write_id3(path: str, title: str, artist: str, performer: str,
              genre: str, year: str, artwork: Optional[bytes], svc: str = "") -> None:
    try:
        frames  = _tf("TIT2", title)
        frames += _tf("TPE1", performer)
        frames += _tf("TPE2", artist)
        if genre:   frames += _tf("TCON", genre)
        if year:    frames += _tf("TDRC", year)
        if artwork: frames += _apic(artwork)
        header = b"ID3\x03\x00\x00" + _syncsafe(len(frames))
        with open(path,"rb") as f: mp3 = f.read()
        if mp3[:3] == b"ID3":
            old = ((mp3[6]&0x7F)<<21|(mp3[7]&0x7F)<<14|(mp3[8]&0x7F)<<7|(mp3[9]&0x7F))
            mp3 = mp3[10+old:]
        with open(path,"wb") as f: f.write(header+frames+mp3)
    except Exception:
        pass

# ─────────────────────────────────────────────────────────────────────────────
# UI
# ─────────────────────────────────────────────────────────────────────────────

def build_page(results, page, per_page, query, show_stats, show_genre, svc, lang="ru") -> str:
    total = max(1, (len(results)+per_page-1)//per_page)
    page  = max(1, min(page, total))
    start = (page-1)*per_page
    chunk = results[start:start+per_page]
    tx    = TEXTS.get(lang, TEXTS["ru"])
    def t(k, **kw):
        s = tx.get(k, k)
        try: return s.format(**kw)
        except: return s
    icon = SERVICE_ICONS.get(svc,"🎵")
    lines = [
        t("page_hdr", icon=icon, svc=SERVICE_NAMES.get(svc,svc)),
        t("page_q",   q=query, p=page, t=total), "",
    ]
    for i, tr in enumerate(chunk, start+1):
        dur   = f" [{tr['duration']}]" if tr.get("duration") else ""
        extra = []
        if show_stats:
            if tr.get("plays"): extra.append(f"▶{int(tr['plays']):,}")
            if tr.get("likes"): extra.append(f"♥{int(tr['likes']):,}")
        if show_genre and tr.get("genre"): extra.append(tr["genre"])
        ext = f"  ({' • '.join(extra)})" if extra else ""
        lines.append(f"{i}. {tr['title']} — {tr['artist']}{dur}{ext}")
    lines += ["", t("page_hint", n=start+len(chunk))]
    if total > 1: lines.append(t("page_nav"))
    lines.append(t("page_svc"))
    return "\n".join(lines)

def build_favs_page(favs, page, per_page, lang="ru") -> str:
    total = max(1, (len(favs)+per_page-1)//per_page)
    page  = max(1, min(page, total))
    start = (page-1)*per_page
    chunk = favs[start:start+per_page]
    tx    = TEXTS.get(lang, TEXTS["ru"])
    def t(k, **kw):
        s = tx.get(k, k)
        try: return s.format(**kw)
        except: return s
    lines = [t("fav_title"), t("favs_page_q", p=page, t=total), ""]
    if not chunk:
        lines.append(t("fav_empty"))
        return "\n".join(lines)
    for i, tr in enumerate(chunk, start+1):
        cnt   = int(tr.get("like_count",1))
        dur   = f" [{tr.get('duration')}]" if tr.get("duration") else ""
        icon  = SERVICE_ICONS.get(tr.get("service","sc"),"")
        extra = []
        if tr.get("genre"): extra.append(tr["genre"])
        if tr.get("year"):  extra.append(tr["year"])
        ext = f"  ({' • '.join(extra)})" if extra else ""
        lines.append(f"{i}. {icon}{tr.get('title','')} — {tr.get('artist','')}{dur}  ×{cnt}{ext}")
    lines += ["", t("favs_page_hint")]
    if total > 1: lines.append(t("page_nav"))
    return "\n".join(lines)

