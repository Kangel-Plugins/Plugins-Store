_CREATOR_SUPPORT_SOURCE = '# -*- coding: utf-8 -*-\n"""Creator-support bottom sheet for ExteraGram / Elyx SDK."""\nfrom base_plugin import MethodHook\nfrom android_utils import run_on_ui_thread, OnClickListener\nfrom client_utils import get_last_fragment, send_request\nfrom hook_utils import find_class\nfrom ui.settings import Header, Text, Switch\nfrom org.telegram.tgnet import TLRPC\nfrom org.telegram.messenger import AndroidUtilities, UserConfig, MessagesController\nfrom org.telegram.ui.ActionBar import BottomSheet, Theme\nfrom org.telegram.ui.Components import BackupImageView, AvatarDrawable\nfrom android.widget import LinearLayout, TextView\nfrom android.view import Gravity\nfrom android.os import Bundle\nfrom android.graphics.drawable import GradientDrawable, RippleDrawable\nfrom android.content.res import ColorStateList\nfrom java import jclass, dynamic_proxy\nimport threading\n\nCHANNEL = "plugns1m"\n\n\ndef dp(n):\n    return AndroidUtilities.dp(n)\n\n\ndef rounded(color, radius):\n    shape = GradientDrawable()\n    shape.setColor(int(color))\n    shape.setCornerRadius(float(dp(radius)))\n    return shape\n\n\nclass ChannelSupportPlugin:\n    def __init__(self, owner):\n        self.logger = owner.logger\n        self.hook_all_methods = owner.hook_all_methods\n        self.get_setting = lambda key, default=True: True\n        self._tr = owner._tr\n\n    def on_plugin_load(self):\n        self._alive = True\n        self._already_offered = set()  # once per account per client process\n        self._checking = set()\n        self._sheet = None\n        self._chat_by_account = {}\n        plugin = self\n        try:\n            launch = find_class(\'org.telegram.ui.LaunchActivity\')\n            if launch is not None:\n                class ResumeHook(MethodHook):\n                    def after_hooked_method(self, param):\n                        run_on_ui_thread(lambda: plugin._check(), 1000)\n                self._resume_hook = ResumeHook()\n                self.hook_all_methods(launch, \'onResume\', self._resume_hook)\n        except Exception as exc:\n            self.logger.error(\'Support sheet resume hook: %s\', exc)\n        run_on_ui_thread(self._check, 1400)\n\n    def on_plugin_unload(self):\n        self._alive = False\n        def close():\n            sheet, self._sheet = self._sheet, None\n            if sheet is not None:\n                try: sheet.dismiss()\n                except Exception: pass\n        run_on_ui_thread(close)\n\n\n    def _account(self):\n        return int(UserConfig.selectedAccount)\n\n    def _schedule_manual_check(self):\n        self._already_offered.discard(self._account())\n        run_on_ui_thread(self._check, 150)\n\n    def _check(self):\n        if not self._alive or not self.get_setting(\'offer_enabled\', True):\n            return\n        account = self._account()\n        if account in self._already_offered or account in self._checking:\n            return\n        fragment = get_last_fragment()\n        if fragment is None or fragment.getParentActivity() is None:\n            return\n        self._checking.add(account)\n        try:\n            request = TLRPC.TL_contacts_resolveUsername()\n            request.username = CHANNEL\n            def resolved(result, error):\n                if not self._alive:\n                    self._checking.discard(account)\n                    return\n                if error is not None or result is None or result.chats is None or result.chats.size() == 0:\n                    self._checking.discard(account)\n                    self.logger.info(\'Cannot resolve @%s; skipping sheet\', CHANNEL)\n                    return\n                chat = result.chats.get(0)\n                self._chat_by_account[account] = chat\n                try:\n                    MessagesController.getInstance(account).putChats(result.chats, False)\n                except Exception: pass\n                try:\n                    input_channel = TLRPC.TL_inputChannel()\n                    input_channel.channel_id = chat.id\n                    input_channel.access_hash = chat.access_hash\n                    membership = TLRPC.TL_channels_getParticipant()\n                    membership.channel = input_channel\n                    membership.participant = TLRPC.TL_inputPeerSelf()\n                except Exception as exc:\n                    self._checking.discard(account)\n                    self.logger.error(\'Membership request could not be built: %s\', exc)\n                    return\n                def checked(response, check_error):\n                    self._checking.discard(account)\n                    if not self._alive: return\n                    if check_error is None and response is not None:\n                        # Server verified this Telegram account is in the channel.\n                        self._already_offered.add(account)\n                        return\n                    message = str(getattr(check_error, \'text\', \'\') or \'\')\n                    if \'USER_NOT_PARTICIPANT\' in message or \'CHANNEL_PRIVATE\' in message:\n                        self._already_offered.add(account)\n                        run_on_ui_thread(lambda: self._show(CHANNEL, chat) if self._account() == account and self._alive else None)\n                    else:\n                        # Network failures are not interpreted as unsubscribed.\n                        self.logger.info(\'Channel membership uncertain: %s\', message)\n                send_request(membership, checked, account=account)\n            send_request(request, resolved, account=account)\n        except Exception as exc:\n            self._checking.discard(account)\n            self.logger.error(\'Subscription check failed: %s\', exc)\n\n    def _open_channel(self, account, chat):\n        """Use Telegram\'s own username navigation, not an external browser."""\n        if not self._alive or self._account() != account:\n            return\n        fragment = get_last_fragment()\n        if fragment is None:\n            self.logger.error(\'Channel navigation: no active fragment\')\n            return\n        controller = MessagesController.getInstance(account)\n\n        # Telegram resolves usernames itself, even if our earlier TL resolve\n        # failed or the user pressed the button before it completed.\n        try:\n            controller.openByUserName(CHANNEL, fragment, 1)\n            self.logger.info(\'Opened channel via native username navigation\')\n            return\n        except Exception as exc:\n            self.logger.error(\'openByUserName unavailable: %s\', exc)\n\n        # Older forks can have a different openByUserName overload.\n        try:\n            controller.openByUserName(CHANNEL, fragment, 1, True)\n            self.logger.info(\'Opened channel via alternative native overload\')\n            return\n        except Exception as exc:\n            self.logger.error(\'Alternative username navigation unavailable: %s\', exc)\n\n        try:\n            chat = chat or self._chat_by_account.get(account)\n            if chat is None:\n                raise ValueError(\'Channel is not yet resolved\')\n            controller.putChat(chat, False)\n            args = Bundle()\n            args.putInt(\'chat_id\', int(chat.id))\n            screen = jclass(\'org.telegram.ui.ChatActivity\')(args)\n            opened = fragment.presentFragment(screen)\n            if opened is False:\n                raise RuntimeError(\'Fragment navigation rejected\')\n            self.logger.info(\'Opened channel via ChatActivity\')\n            return\n        except Exception as exc:\n            self.logger.error(\'Direct ChatActivity failed: %s\', exc)\n\n        # Final fallback goes through Telegram\'s own link router. This should\n        # route tg://resolve inside Telegram rather than launching a browser.\n        try:\n            Uri = jclass(\'android.net.Uri\')\n            Browser = jclass(\'org.telegram.messenger.browser.Browser\')\n            activity = fragment.getParentActivity()\n            if activity is None:\n                raise RuntimeError(\'No activity\')\n            Browser.openUrl(activity, Uri.parse(\'tg://resolve?domain=\' + CHANNEL))\n        except Exception as exc:\n            self.logger.error(\'Telegram deep link navigation failed: %s\', exc)\n            try:\n                from ui.bulletin import BulletinHelper\n                BulletinHelper.show_error(\'Не удалось открыть @\' + CHANNEL + \' · см. логи плагина\')\n            except Exception:\n                pass\n\n    def _show(self, channel, chat):\n        if not self._alive: return\n        if self._sheet is not None:\n            try:\n                if self._sheet.isShowing(): return\n            except Exception: pass\n            self._sheet = None\n        fragment = get_last_fragment()\n        activity = fragment.getParentActivity() if fragment else None\n        if activity is None or activity.isFinishing(): return\n        try:\n            surface = Theme.getColor(Theme.key_dialogBackground)\n            primary = Theme.getColor(Theme.key_dialogTextBlack)\n            secondary = Theme.getColor(Theme.key_dialogTextGray2)\n            accent = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)\n            selector = Theme.getColor(Theme.key_listSelector)\n\n            root = LinearLayout(activity)\n            root.setOrientation(1)\n            root.setGravity(Gravity.CENTER_HORIZONTAL)\n            root.setPadding(dp(24), dp(10), dp(24), dp(24))\n            root.setBackgroundColor(surface)\n            handle = TextView(activity)\n            handle.setBackground(rounded(secondary, 3))\n            handle_lp = LinearLayout.LayoutParams(dp(34), dp(4))\n            handle_lp.bottomMargin = dp(20)\n            root.addView(handle, handle_lp)\n\n            try:\n                avatar = BackupImageView(activity)\n                avatar.setRoundRadius(dp(36))\n                if chat is None: raise ValueError(\'Channel avatar unavailable\')\n                avatar.setForUserOrChat(chat, AvatarDrawable(chat))\n                root.addView(avatar, LinearLayout.LayoutParams(dp(72), dp(72)))\n            except Exception:\n                avatar = TextView(activity)\n                avatar.setText(\'S1\')\n                avatar.setTextSize(23)\n                avatar.setTextColor(-1)\n                avatar.setGravity(Gravity.CENTER)\n                avatar.setBackground(rounded(accent, 36))\n                root.addView(avatar, LinearLayout.LayoutParams(dp(72), dp(72)))\n\n            title = TextView(activity)\n            title.setText(self._tr(\'Подпишитесь на создателя плагина\\n(пожалуйста)\'))\n            title.setTextSize(20)\n            title.setTextColor(primary)\n            title.setGravity(Gravity.CENTER)\n            title.setPadding(0, dp(18), 0, dp(6))\n            root.addView(title, LinearLayout.LayoutParams(-1, -2))\n            username = TextView(activity)\n            username.setText(\'@\' + channel)\n            username.setTextSize(14)\n            username.setTextColor(secondary)\n            username.setGravity(Gravity.CENTER)\n            root.addView(username, LinearLayout.LayoutParams(-1, -2))\n\n            builder = BottomSheet.Builder(activity)\n            builder.setCustomView(root)\n            sheet = builder.create()\n            sheet.setFocusable(True)\n            self._sheet = sheet\n\n            def button(label, filled, callback):\n                view = TextView(activity)\n                view.setText(label)\n                view.setTextSize(15)\n                view.setGravity(Gravity.CENTER)\n                view.setTextColor(-1 if filled else accent)\n                background = rounded(accent if filled else surface, 16)\n                view.setBackground(RippleDrawable(ColorStateList.valueOf(selector), background, None))\n                view.setOnClickListener(OnClickListener(lambda _: callback()))\n                lp = LinearLayout.LayoutParams(-1, dp(50))\n                lp.topMargin = dp(18 if filled else 4)\n                root.addView(view, lp)\n\n            account = self._account()\n            def subscribe():\n                sheet.dismiss()\n                run_on_ui_thread(lambda: self._open_channel(account, chat), 400)\n            button(self._tr(\'Подписаться\'), True, subscribe)\n            button(self._tr(\'Пока что нет\'), False, lambda: sheet.dismiss())\n            sheet.show()\n        except Exception as exc:\n            self._sheet = None\n            self.logger.error(\'Could not create native bottom sheet: %s\', exc)\n'

_SERVICE_EN.update({'Трек найден, но аудиосессия пока недоступна. Попробуй приостановить и продолжить воспроизведение.': "Track found, but its audio session is not available yet. Pause and resume playback."})

_SERVICE_EN.update({'1. Открой developer.spotify.com/dashboard и создай приложение с Web API. Скопируй Client ID в настройки плагина. Client Secret не нужен.\n\n2. В Spotify Dashboard добавь Redirect URI и укажи точно такой же URI в плагине. Можно использовать https://example.com/callback.\n\n3. Нажми «Открыть вход Spotify», разреши доступ. После перенаправления скопируй полный URL страницы, даже если она показывает ошибку, в поле Callback URL.\n\n4. Нажми «Завершить подключение». Токен будет обновляться автоматически. В режиме разработки Spotify аккаунт должен иметь доступ к приложению.\n\nМожно вставить готовый access_token в поле Bearer. Он временный. sp_dc — старая cookie браузера, это другой вид данных.\n\nSpotify Web API даёт поиск и доступные preview. Загрузка полных файлов использует отдельный сервис и может быть недоступна независимо от токена.': '1. Open developer.spotify.com/dashboard and create an app with Web API. Copy its Client ID into the plugin settings. A Client Secret is not required.\n\n2. Add an HTTPS Redirect URI in Spotify Dashboard and use the exact same URI in the plugin. For example: https://example.com/callback.\n\n3. Tap “Sign in to Spotify” and grant access. After the redirect, copy the full URL from the address bar into the Callback URL field, even if the page shows an error.\n\n4. Tap “Complete connection”. The access token will refresh automatically. In development mode, your Spotify account must be allowed to access the app.\n\nYou can also paste an existing temporary access_token into the Bearer field. sp_dc is a legacy browser cookie, not an access token.\n\nSpotify Web API provides search and available previews. Full-file downloads use a separate service and may fail independently of authentication.', 'Получи токен по инструкции проекта yandex-music-api. Вставь только значение access_token в поле OAuth token. Полные треки доступны в рамках прав аккаунта и региона.\n\nhttps://github.com/MarshalX/yandex-music-api/blob/main/docs/source/token.md': "Tap “Sign in to Yandex Music”, open Yandex's sign-in page, and approve the device code. The plugin saves the token automatically. You can also paste an existing access_token into the OAuth token field. Playback and downloads depend on your account and region.\n\nhttps://github.com/MarshalX/yandex-music-api/blob/main/docs/source/token.md", 'Яндекс Музыка\n\nКод входа: ': 'Yandex Music\n\nSign-in code: ', '\n\nВойди в свой аккаунт на странице Яндекса и подтверди код. Плагин получит и сохранит токен автоматически.': "\n\nSign in to your account on Yandex's page and approve the code. The plugin will obtain and save the token automatically.", 'Редактировать метаданные': 'Edit current track metadata', 'Шаблон музыкального статуса': 'Use as music status template', 'Music Downloader · 6.0 Beta': 'Music Downloader · 6.0.3 Beta'})

_SERVICE_EN.update({
    "Кривая звука": "Sound curve",
    "Сбросить": "Reset",
    "Тяни точки вверх и вниз. Изменения слышны сразу. Кривую можно настроить до запуска музыки.": "Drag the points up or down. Changes are applied in real time. You can edit the curve before playing music.",
    "Пять точек кривой соответствуют частотам 60 Hz, 230 Hz, 910 Hz, 3.6 kHz и 14 kHz. Усиление пересчитывается под полосы устройства.": "The five control points are 60 Hz, 230 Hz, 910 Hz, 3.6 kHz and 14 kHz. Gains are mapped to your device's frequency bands.",
})

_EQ_HTML = '<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><style>\nhtml,body{margin:0;background:transparent;color:var(--text);font-family:system-ui,sans-serif;overflow:hidden}svg{width:100%;height:300px;display:block;background:var(--surface);border-radius:18px;touch-action:none;user-select:none}text{fill:var(--muted);font-size:12px;text-anchor:middle}.grid{stroke:var(--muted);opacity:.22;stroke-width:1}.curve{stroke:var(--accent);stroke-width:3;fill:none}.point{stroke:var(--accent);stroke-width:4;fill:var(--text)}.halo{fill:var(--accent);opacity:.18;pointer-events:none}\n</style></head><body><svg id="chart" viewBox="0 0 360 300" role="group" aria-label="Equalizer"></svg><script>\nconst frequencies=[60000,230000,910000,3600000,14000000],labels=[\'60 Hz\',\'230 Hz\',\'910 Hz\',\'3.6 kHz\',\'14 kHz\'];\nconst chart=document.getElementById(\'chart\');let values=[0,0,0,0,0],before=[],active=-1,low=-1500,high=1500;\nconst xs=[36,108,180,252,324],yTop=42,yBottom=258;\nfunction y(value){return yTop+(high-value)/(high-low)*(yBottom-yTop)}\nfunction render(){\n let h=\'<line class="grid" x1="8" y1="\'+y(0)+\'" x2="352" y2="\'+y(0)+\'"/>\';\n for(let i=0;i<5;i++)h+=\'<line class="grid" x1="\'+xs[i]+\'" y1="\'+yTop+\'" x2="\'+xs[i]+\'" y2="\'+yBottom+\'"/><text x="\'+xs[i]+\'" y="24">\'+(values[i]/100).toFixed(1)+\'</text><text x="\'+xs[i]+\'" y="285">\'+labels[i]+\'</text>\';\n let d=\'M8 \'+y(values[0])+\' L\'+xs[0]+\' \'+y(values[0]);\n for(let i=1;i<5;i++){let m=(xs[i-1]+xs[i])/2;d+=\' C\'+m+\' \'+y(values[i-1])+\' \'+m+\' \'+y(values[i])+\' \'+xs[i]+\' \'+y(values[i])}\n h+=\'<path class="curve" d="\'+d+\' L352 \'+y(values[4])+\'"/>\';\n for(let i=0;i<5;i++)h+=(active===i?\'<circle class="halo" cx="\'+xs[i]+\'" cy="\'+y(values[i])+\'" r="16"/>\':\'\')+\'<circle class="point" tabindex="0" role="slider" aria-label="\'+labels[i]+\'" aria-valuemin="\'+low/100+\'" aria-valuemax="\'+high/100+\'" aria-valuenow="\'+values[i]/100+\'" data-band="\'+i+\'" cx="\'+xs[i]+\'" cy="\'+y(values[i])+\'" r="7"/>\';\n chart.innerHTML=h;\n}\nfunction emit(final){console.log(\'MUSIC_EQ:\'+JSON.stringify({values:values,final:final}))}\nfunction update(event){\n let point=chart.createSVGPoint();point.x=event.clientX;point.y=event.clientY;let py=point.matrixTransform(chart.getScreenCTM().inverse()).y;\n values[active]=Math.max(low,Math.min(high,Math.round((high-Math.max(0,Math.min(1,(py-yTop)/(yBottom-yTop)))*(high-low))/10)*10));\n render();emit(false);\n}\nchart.addEventListener(\'pointerdown\',e=>{if(active>=0)return;let point=chart.createSVGPoint();point.x=e.clientX;point.y=e.clientY;let px=point.matrixTransform(chart.getScreenCTM().inverse()).x;active=xs.reduce((best,x,i)=>Math.abs(x-px)<Math.abs(xs[best]-px)?i:best,0);before=values.slice();chart.setPointerCapture(e.pointerId);update(e);e.preventDefault()});\nchart.addEventListener(\'pointermove\',e=>{if(active>=0){update(e);e.preventDefault()}});\nchart.addEventListener(\'pointerup\',e=>{if(active>=0){update(e);active=-1;emit(true);render()}});\nchart.addEventListener(\'pointercancel\',()=>{if(active>=0){values=before;active=-1;emit(true);render()}});\nchart.addEventListener(\'keydown\',e=>{let band=Number(e.target.getAttribute(\'data-band\'));if(!Number.isInteger(band)||![\'ArrowUp\',\'ArrowDown\'].includes(e.key))return;values[band]=Math.max(low,Math.min(high,values[band]+(e.key===\'ArrowUp\'?100:-100)));render();emit(true);e.preventDefault();chart.querySelector(\'[data-band="\'+band+\'"]\').focus()});\nwindow.eqSet=function(config){low=config.low;high=config.high;values=config.values.map(v=>Math.max(low,Math.min(high,v)));render()};\nwindow.eqSet(INITIAL_CONFIG);\n</script></body></html>\n'

