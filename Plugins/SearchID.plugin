import traceback

from java import jclass
from base_plugin import BasePlugin, MethodHook
from android_utils import copy_to_clipboard
from hook_utils import find_class, get_private_field
from ui.bulletin import BulletinHelper


__id__ = "SearchID"
__name__ = "SearchID"
__description__ = "Теперь можно искать плагины и по их ID"
__version__ = "1.0.1"
__author__ = "@jaxbastard"
__icon__ = "DendziDzheksJaxbastard/4"
__min_version__ = "12.5.1"


def _show_error(message, exc):
    try:
        trace = "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))
        BulletinHelper.show_with_button(
            message,
            jclass("org.telegram.messenger.R").raw.error,
            "Copy",
            on_click=lambda: copy_to_clipboard(trace),
        )
    except Exception:
        pass


class FillItemsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.searching = True

            query = get_private_field(param.thisObject, "query")
            self.plugin.query = "" if query is None else str(query).strip().lower()
        except Exception as e:
            self.plugin.searching = False
            _show_error("SearchID: ошибка чтения поиска", e)

    def after_hooked_method(self, param):
        self.plugin.searching = False
        self.plugin.query = ""


class GetNameHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.searching or not self.plugin.query:
                return

            plugin_id = param.thisObject.getId()

            if plugin_id is None:
                return

            name = param.getResult()

            if name is None: #куда же без сыкс сэвэн
                return

            if self.plugin.query in str(plugin_id).lower():
                param.setResult("{} {}".format(name, plugin_id))
        except Exception as e:
            _show_error("SearchID: ошибка поиска", e)


class SearchIDPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.hooks = []
        self.searching = False
        self.query = ""

    def on_plugin_load(self):
        try:
            activity_class = find_class(
                "com.exteragram.messenger.plugins.ui.PluginsActivity"
            )
            plugin_class = find_class(
                "com.exteragram.messenger.plugins.Plugin"
            )

            if not activity_class or not plugin_class:
                raise RuntimeError("Не найден класс менеджера или Plugin")

            activity_reflector = activity_class._chaquopy_reflector
            plugin_reflector = plugin_class._chaquopy_reflector

            fill_methods = activity_reflector.getMethods("fillItems")
            if not fill_methods or len(fill_methods) == 0:
                raise RuntimeError("Не найден fillItems")

            get_name_methods = plugin_reflector.getMethods("getName")
            if not get_name_methods or len(get_name_methods) == 0:
                raise RuntimeError("Не найден Plugin.getName")

            fill_hook = self.hook_method(
                fill_methods[0],
                FillItemsHook(self),
                priority=100,
            )

            if not fill_hook:
                fill_hook = self.hook_all_methods(
                    activity_class,
                    "fillItems",
                    FillItemsHook(self),
                )

            if not fill_hook:
                raise RuntimeError(
                    "Не удалось установить хук fillItems после повторной загрузки"
                )

            self.hooks.append(fill_hook)

            name_hook = self.hook_method(
                get_name_methods[0],
                GetNameHook(self),
                priority=5,
            )

            if not name_hook:
                raise RuntimeError("Не удалось установить хук Plugin.getName")

            self.hooks.append(name_hook)

        except Exception as e:
            _show_error("SearchID: ошибка загрузки", e)

    def on_plugin_unload(self):
        for hook in self.hooks:
            try:
                self.unhook_method(hook)
            except Exception:
                pass

        self.hooks = []
        self.searching = False
        self.query = ""