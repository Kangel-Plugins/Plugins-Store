__id__ = "setliquid_glass"
__name__ = "𝖲𝖾𝗍𝗍𝗂𝗇𝗀𝗌 𝖫𝗂𝗊𝗎𝗂𝖽 𝖦𝗅𝖺𝗌𝗌"
__description__ = "**Настройка параметров эффекта Liquid Glass на шапке чата**\n**Adjusting Liquid Glass Effect on Chat ActionBar**"
__author__ = "@ka1Plugins"
__version__ = "1.5"
__min_version__ = "12.5.1"
__icon__ = "Capoo_Static2/2"

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field, set_private_field
from android_utils import log, run_on_ui_thread
from ui.settings import Header, Switch, Divider, Input, Text
from android.os import Build
from android.graphics import Color
from org.telegram.messenger import LocaleController, AndroidUtilities, SharedConfig
from org.telegram.ui.ActionBar import Theme
from java.lang import Float, Integer, Boolean
from weakref import WeakSet

try:
    BlurredBackgroundColorProviderThemed = find_class("org.telegram.ui.Components.blur3.drawable.color.BlurredBackgroundColorProviderThemed")
except Exception as e:
    log(f"[setliquid_glass] import error: {e}")

class SettingsLiquidGlass(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hook_chat_create = None
        self._hook_chat_resume = None
        self._active_chats = WeakSet()
        self._applied = {}

    def _get_strings(self):
        try:
            lang = LocaleController.getInstance().getCurrentLocale().getLanguage()
        except:
            lang = "en"
        if lang.startswith("ru"):
            return {
                "header": "Liquid Glass (шапка чата)",
                "enabled": "Включить эффект",
                "enabled_sub": "Жидкое стекло на ActionBar",
                "thickness": "Толщина (dp)",
                "thickness_sub": "рекомендуется 10–50",
                "intensity": "Интенсивность",
                "intensity_sub": "рекомендуется 0.0–1.0",
                "radius": "Радиус углов (dp)",
                "radius_sub": "скругление шапки",
                "apply": "Применить сейчас",
                "apply_sub": "переприменить эффект",
                "defaults": {
                    "thickness": "25.0",
                    "intensity": "0.5",
                    "radius": "0"
                }
            }
        else:
            return {
                "header": "Liquid Glass (Chat Header)",
                "enabled": "Enable effect",
                "enabled_sub": "Liquid Glass on ActionBar",
                "thickness": "Thickness (dp)",
                "thickness_sub": "recommended 10–50",
                "intensity": "Intensity",
                "intensity_sub": "recommended 0.0–1.0",
                "radius": "Corner radius (dp)",
                "radius_sub": "rounding of the header",
                "apply": "Apply now",
                "apply_sub": "reapply effect",
                "defaults": {
                    "thickness": "25.0",
                    "intensity": "0.5",
                    "radius": "0"
                }
            }

    def on_plugin_load(self):
        if Build.VERSION.SDK_INT < 33:
            log("[setliquid_glass] Android 13+ required, plugin disabled")
            return
        if not SharedConfig.chatBlurEnabled():
            log("[setliquid_glass] Chat blur is disabled, effect may not work")
        try:
            chat_cls = find_class("org.telegram.ui.ChatActivity")
            ctx_cls = find_class("android.content.Context")
            create_view = chat_cls.getClass().getDeclaredMethod("createView", ctx_cls)
            create_view.setAccessible(True)
            self._hook_chat_create = self.hook_method(create_view, self._ChatCreateHook(self))
            log("[setliquid_glass] createView hook installed")

            on_resume = chat_cls.getClass().getDeclaredMethod("onResume")
            on_resume.setAccessible(True)
            self._hook_chat_resume = self.hook_method(on_resume, self._ChatResumeHook(self))
            log("[setliquid_glass] onResume hook installed")
        except Exception as e:
            log(f"[setliquid_glass] hook error: {e}")

    def on_plugin_unload(self):
        for ref in (self._hook_chat_create, self._hook_chat_resume):
            if ref:
                try:
                    self.unhook_method(ref)
                except:
                    pass
        self._restore_all_chats()
        self._active_chats.clear()
        self._applied.clear()

    def create_settings(self):
        s = self._get_strings()
        def on_change(_):
            self._apply_to_all_chats()

        return [
            Header(text=s["header"]),
            Switch(
                key="lg_enabled",
                text=s["enabled"],
                subtext=s["enabled_sub"],
                default=True,
                on_change=on_change
            ),
            Divider(),
            Input(
                key="lg_thickness",
                text=s["thickness"],
                default=s["defaults"]["thickness"],
                subtext=s["thickness_sub"],
                on_change=on_change
            ),
            Input(
                key="lg_intensity",
                text=s["intensity"],
                default=s["defaults"]["intensity"],
                subtext=s["intensity_sub"],
                on_change=on_change
            ),
            Input(
                key="lg_radius",
                text=s["radius"],
                default=s["defaults"]["radius"],
                subtext=s["radius_sub"],
                on_change=on_change
            ),
            Divider(),
            Text(
                text=s["apply"],
                icon="msg_retry",
                subtext=s["apply_sub"],
                on_click=lambda v: self._apply_to_all_chats()
            )
        ]

    def _apply_to_all_chats(self):
        for chat in list(self._active_chats):
            try:
                self._apply_liquid_glass_to_chat(chat)
            except Exception as e:
                log(f"[setliquid_glass] reapply error: {e}")

    def _get_float_setting(self, key, default):
        try:
            val = self.get_setting(key, default)
            return float(str(val).replace(',', '.'))
        except:
            return float(default)

    def _resolve_factory(self, chat_activity):
        return get_private_field(chat_activity, "glassBackgroundDrawableFactory")

    def _get_action_bar_container(self, chat_activity):
        """Пытается найти контейнер, который реально рисует фон шапки"""
        action_bar = chat_activity.getActionBar()
        if action_bar is None:
            return None
        # Пробуем получить поле container или actionBarContainer
        for name in ("container", "actionBarContainer", "mContainer"):
            try:
                container = get_private_field(action_bar, name)
                if container is not None:
                    log(f"[setliquid_glass] found container: {name}")
                    return container
            except:
                pass
        # Если не нашли, возвращаем сам action_bar
        return action_bar

    def _set_liquid_glass_allowed(self, factory, allowed):
        if not factory:
            return
        try:
            method = factory.getClass().getMethod("setLiquidGlassEffectAllowed", Boolean.TYPE)
            method.invoke(factory, Boolean(allowed))
            log(f"[setliquid_glass] setLiquidGlassEffectAllowed({allowed}) called")
        except Exception as e:
            log(f"[setliquid_glass] setLiquidGlassEffectAllowed error: {e}")

    def _apply_liquid_glass_to_chat(self, chat_activity):
        if not self.get_setting("lg_enabled", True):
            self._restore_chat(chat_activity)
            return
        if not chat_activity:
            return
        try:
            if not chat_activity.isResumed():
                log("[setliquid_glass] chat not resumed, skip")
                return
        except:
            pass

        try:
            # Получаем целевой View (контейнер или сам ActionBar)
            target_view = self._get_action_bar_container(chat_activity)
            if target_view is None:
                log("[setliquid_glass] target_view is None")
                return

            factory = self._resolve_factory(chat_activity)
            if factory is None:
                log("[setliquid_glass] factory is None")
                return

            # Сброс и включение Liquid Glass
            self._set_liquid_glass_allowed(factory, False)
            self._set_liquid_glass_allowed(factory, True)

            s = self._get_strings()
            thickness_dp = self._get_float_setting("lg_thickness", s["defaults"]["thickness"])
            intensity = self._get_float_setting("lg_intensity", s["defaults"]["intensity"])
            radius_dp = self._get_float_setting("lg_radius", s["defaults"]["radius"])

            try:
                theme_delegate = get_private_field(chat_activity, "themeDelegate")
            except:
                theme_delegate = None

            alpha = 0.82
            provider = BlurredBackgroundColorProviderThemed(theme_delegate, Theme.key_actionBarDefault, alpha)

            drawable = factory.create(target_view, provider)
            if drawable is None:
                log("[setliquid_glass] drawable is None")
                return

            thickness_px = AndroidUtilities.dp(thickness_dp)
            radius_px = AndroidUtilities.dp(radius_dp)
            if hasattr(drawable, 'setThickness'):
                drawable.setThickness(thickness_px)
            if hasattr(drawable, 'setIntensity'):
                drawable.setIntensity(intensity)
            if hasattr(drawable, 'setRadius'):
                drawable.setRadius(radius_px)

            # Сохраняем оригинальный фон
            key = id(chat_activity)
            if key not in self._applied:
                self._applied[key] = {
                    "view": target_view,
                    "background": target_view.getBackground()
                }

            target_view.setBackground(drawable)
            target_view.invalidate()

            # Отключаем лишние эффекты
            if hasattr(target_view, 'setBlurredBackground'):
                target_view.setBlurredBackground(False)
            if hasattr(target_view, 'setCastShadows'):
                target_view.setCastShadows(False)

            self._active_chats.add(chat_activity)
            log("[setliquid_glass] SUCCESS: Liquid Glass applied to container!")

        except Exception as e:
            log(f"[setliquid_glass] apply error: {e}")

    def _restore_chat(self, chat_activity):
        key = id(chat_activity)
        if key in self._applied:
            data = self._applied[key]
            view = data.get("view")
            if view and data.get("background"):
                try:
                    view.setBackground(data["background"])
                    view.invalidate()
                except:
                    pass
            del self._applied[key]
        try:
            self._active_chats.discard(chat_activity)
        except:
            pass

    def _restore_all_chats(self):
        for key, data in list(self._applied.items()):
            view = data.get("view")
            if view and data.get("background"):
                try:
                    view.setBackground(data["background"])
                    view.invalidate()
                except:
                    pass
        self._applied.clear()
        self._active_chats.clear()

    class _ChatCreateHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin
        def after_hooked_method(self, param):
            try:
                chat = param.thisObject
                run_on_ui_thread(lambda: self.plugin._apply_liquid_glass_to_chat(chat), 500)
            except Exception as e:
                log(f"[setliquid_glass] create hook error: {e}")

    class _ChatResumeHook(MethodHook):
        def __init__(self, plugin):
            self.plugin = plugin
        def after_hooked_method(self, param):
            try:
                chat = param.thisObject
                run_on_ui_thread(lambda: self.plugin._apply_liquid_glass_to_chat(chat), 200)
            except Exception as e:
                log(f"[setliquid_glass] resume hook error: {e}")