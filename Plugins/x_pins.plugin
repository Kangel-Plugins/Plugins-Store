    def try_load_sticker(self, img, sticker_name, sticker_index=0, size="110_110"):
        try:
            mdc_cls = find_class("org.telegram.messenger.MediaDataController")
            loc_cls = find_class("org.telegram.messenger.ImageLocation")
            if not mdc_cls or not loc_cls:
                return False
            set_name = sticker_name.split("/")[0] if isinstance(sticker_name, str) and "/" in sticker_name else sticker_name
            idx = int(sticker_name.split("/")[1]) if isinstance(sticker_name, str) and "/" in sticker_name else int(sticker_index)
            mdc = mdc_cls.getInstance(jint(self._account()))
            ss = mdc.getStickerSetByName(set_name) or mdc.getStickerSetByEmojiOrName(set_name)
            if ss and ss.documents and int(ss.documents.size()) > idx:
                img.setImage(loc_cls.getForDocument(ss.documents.get(jint(idx))), size, None, None, jint(0), jint(1))
                img.setAlpha(1.0)
                return True
        except Exception:
            pass
        return False

    def load_sticker_with_fallback(self, img, sticker_name, sticker_index=0, size="110_110", delay=800):
        if self.try_load_sticker(img, sticker_name, sticker_index, size):
            return
        try:
            mdc_cls = find_class("org.telegram.messenger.MediaDataController")
            tl_cls = find_class("org.telegram.tgnet.TLRPC$TL_inputStickerSetShortName")
            if not mdc_cls or not tl_cls:
                return
            set_name = sticker_name.split("/")[0] if isinstance(sticker_name, str) and "/" in sticker_name else sticker_name
            mdc = mdc_cls.getInstance(jint(self._account()))
            input_set = tl_cls()
            input_set.short_name = set_name
            mdc.getStickerSet(input_set, None, False, None)
            run_on_ui_thread(lambda: self.try_load_sticker(img, sticker_name, sticker_index, size), delay)
            run_on_ui_thread(lambda: self.try_load_sticker(img, sticker_name, sticker_index, size), delay + 1200)
        except Exception:
            pass

    def create_settings(self):
        return [
            Header(text="X-Pins"),
            Text(text="Открыть редактор закрепов", icon="msg_pin", accent=True,
                 on_click=self.on_open_editor),
            Divider(),
            Header(text="О плагине"),
            Text(text="💬 Связь с автором", icon="msg_contacts", accent=True,
                 on_click=lambda _v: self._open_url("https://t.me/Somewhat_empty")),
            Text(text="📢 Канал", icon="msg_channel", accent=True,
                 on_click=lambda _v: self._open_url("https://t.me/XDevelopments")),
            Text(text="⭐ Поддержать проект", icon="menu_feature_reactions", accent=True,
                 on_click=lambda ctx: run_on_ui_thread(lambda: self._show_support_me_menu(ctx))),
            Text(text="📌 О плагине", icon="msg_settings", accent=True,
                 on_click=lambda ctx: run_on_ui_thread(lambda: self._show_version_dialog(ctx))),
        ]

    def _name(self, did):
        did = int(did)
        try:
            for _did, (tt, _mm) in (self._cell_texts() or {}).items():
                if _did == did and tt.strip():
                    return tt.strip()
        except Exception:
            pass
        for v in variants(did):
            info = (self._dialog_index() or {}).get(v)
            if info:
                el = info.get("el")
                t = ""
                for f in ("title", "dialog_name", "name"):
                    try:
                        t = str(getattr(el, f, "") or "")
                    except Exception:
                        t = ""
                    if t.strip():
                        break
                if t.strip():
                    return t.strip()
                break
        try:
            mc = self._mc()
            if mc is None:
                return ""
            obj = None
            if did < 0:
                for arg in (-did, did):
                    try:
                        obj = mc.getChat(jlong(int(arg)))
                    except Exception:
                        obj = None
                    if obj is not None:
                        break
                if obj is not None:
                    return str(getattr(obj, "title", "") or "").strip()
                return ""
            obj = mc.getUser(jlong(did))
            if obj is None:
                return ""
            first = str(getattr(obj, "first_name", "") or "")
            last = str(getattr(obj, "last_name", "") or "")
            return (first + " " + last).strip()
        except Exception:
            return ""

    def _describe(self, did):
        if not did:
            return "не понял - открой чат и вернись"
        nm = self._name(did)
        return nm if nm else str(did)

    def _when(self, ts):
        try:
            ts = int(ts or 0)
        except Exception:
            return ""
        if ts <= 0:
            return ""
        lt = time.localtime(ts)
        now = time.localtime()
        if (lt.tm_year, lt.tm_yday) == (now.tm_year, now.tm_yday):
            return time.strftime("%H:%M", lt)

        yesterday = time.localtime(time.time() - 86400)
        if (lt.tm_year, lt.tm_yday) == (yesterday.tm_year, yesterday.tm_yday):
            return "вчера"
        if lt.tm_year == now.tm_year:
            return time.strftime("%d %b", lt)
        return time.strftime("%d.%m.%y", lt)

    def _preview(self, did):
        did = int(did)
        bits = []
        txt = ""
        try:
            for _did, (_tt, mm) in (self._cell_texts() or {}).items():
                if _did == did and mm.strip():
                    txt = mm.strip()
                    break
        except Exception:
            txt = ""
        info = (self._dialog_index() or {}).get(did) or {}
        if not txt:
            label = ""
            try:
                top = int(info.get("top") or 0)
                if top and info.get("el") is not None:
                    arr = None
                    try:
                        arr = self._mc().dialogMessage.get(did)
                    except Exception:
                        arr = None
                    n = 0
                    try:
                        n = int(arr.size()) if arr is not None else 0
                    except Exception:
                        n = 0
                    if n:
                        try:
                            m = arr.get(n - 1)
                        except Exception:
                            m = None
                        if m is not None:
                            try:
                                mtype = int(m.getMediaType())
                            except Exception:
                                mtype = 0
                            nm = ""
                            if mtype in (7, 10):
                                try:
                                    nm = str(m.getMusicTitle() or m.getDocumentName() or
                                             m.getFileNameFast() or "")
                                except Exception:
                                    nm = ""
                            if not nm.strip():
                                try:
                                    label = self.MEDIA_LABELS.get(mtype, "")
                                except Exception:
                                    label = ""
                            if nm.strip():
                                txt = nm.strip()
                            elif label:
                                txt = "вложение: " + label
            except Exception:
                pass
            if not txt and label:
                txt = "вложение: " + label
        if txt:
            bits.append(txt[:44])
        when = self._when(info.get("date") or 0)
        if when:
            bits.append(when)
        return " · ".join(bits)[:96]

    def _cell_texts(self):
        out = {}
        try:
            frag = get_last_fragment()
            a = frag.getParentActivity() if frag is not None else None
        except Exception:
            a = None
        if a is None:
            return out
        try:
            root = a.getWindow().getDecorView()
        except Exception:
            return out

        def walk(v, depth=0):
            if v is None or depth > 16 or len(out) > 60:
                return
            try:
                cn = str(v.getClass().getSimpleName())
            except Exception:
                cn = ""
            if "DialogCell" in cn:
                try:
                    did = None
                    for m in ("getDialogId", "getPeerIdUnsafe"):
                        try:
                            did = int(getattr(v, m)())
                            break
                        except Exception:
                            continue
                    tt = ""
                    mm = ""
                    for get in ("getTextTitle", "titleTextView"):
                        try:
                            t = getattr(v, get)()
                            if t is not None:
                                tt = str(t.getText())
                                break
                        except Exception:
                            continue
                    for get in ("getTextMessage", "textTextView"):
                        try:
                            t = getattr(v, get)()
                            if t is not None:
                                mm = str(t.getText())
                                break
                        except Exception:
                            continue
                    if did and (tt or mm):
                        out[did] = (tt, mm)
                except Exception:
                    pass
            try:
                n = int(v.getChildCount())
            except Exception:
                n = 0
            for i in range(min(n, 40)):
                try:
                    walk(v.getChildAt(i), depth + 1)
                except Exception:
                    pass

        try:
            walk(root)
        except Exception as exc:
            self.l("cell texts err: %r" % (exc,))
        return out

    def _row_info(self, el):
        out = {"did": None, "date": 0, "top": 0, "pinned": False, "pin": 0}
        if el is None:
            return out
        for f, k in (("id", "did"), ("last_message_date", "date"),
                     ("top_message", "top"), ("pinned", "pinned"),
                     ("pinnedNum", "pin")):
            try:
                v = getattr(el, f)
            except Exception:
                continue
            if v is None:
                continue
            try:
                out[k] = bool(v) if k == "pinned" else int(v)
            except Exception:
                pass
        return out

    def _dialog_index(self, fid=0):
        fid = int(fid or 0)
        cache = getattr(self, "_idx_cache", None)
        if cache is None:
            cache = {}
            self._idx_cache = cache
        key = (self._account(), fid)
        now = time.time()
        ent = cache.get(key)
        if ent is not None and now - ent[0] < 5:
            return ent[1]
        idx = {}
        try:
            lst = self._dialogs_list(fid)
            if lst is not None:
                n = int(lst.size())
                for i in range(n):
                    try:
                        el = lst.get(i)
                    except Exception:
                        break
                    info = self._row_info(el)
                    if info["did"]:
                        idx[info["did"]] = info
                        try:
                            idx[info["did"]]["el"] = el
                        except Exception:
                            pass
        except Exception as exc:
            self.l("dialog index err: %r" % (exc,))
        cache[key] = (now, idx)
        return idx

    def _get_obj_field(self, obj, names):
        if obj is None:
            return None
        try:
            cls = obj.getClass()
        except Exception:
            return None
        depth = 0
        while cls is not None and depth < 6:
            for n in names:
                try:
                    f = cls.getDeclaredField(n)
                    f.setAccessible(True)
                    val = f.get(obj)
                    if val is not None:
                        return val
                except Exception:
                    continue
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
            depth += 1
        return None

    def _field(self, obj, names):
        cls = None
        try:
            cls = obj.getClass()
        except Exception:
            return 0
        depth = 0
        while cls is not None and depth < 6:
            for n in names:
                try:
                    f = cls.getDeclaredField(n)
                    f.setAccessible(True)
                    try:
                        v = _as_int(f.get(obj))
                        if v:
                            return v
                    except Exception:
                        pass
                    try:
                        v = f.getLong(obj)
                        if v:
                            return int(v)
                    except Exception:
                        pass
                except Exception:
                    continue
            cls = cls.getSuperclass()
            depth += 1
        return 0

    def l(self, msg):
        try:
            self.log_lines.append(str(msg)[:160])
            if len(self.log_lines) > 30:
                self.log_lines = self.log_lines[-30:]
            try:
                self.set_setting("diag", " | ".join(self.log_lines[-6:])[-700:])
            except Exception:
                pass
        except Exception:
            pass

    def toast(self, text):
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_info(str(text)))
        except Exception:
            pass


class PinOrderEditor:
    ROW_DP = 72
    LONG_PRESS_MS = 180
    _J = {}
    _CELL_CTOR_IDX = None

    @classmethod
    def _j(cls, name):
        c = cls._J.get(name)
        if c is None:
            c = jclass(name)
            cls._J[name] = c
        return c

    def __init__(self, plugin):
        self.plugin = plugin
        self.dialog = None
        self.order = []
        self.views = {}
        self.drag_idx = -1
        self.drag_did = None
        self.drag_view = None
        self.drag_start_raw_y = 0.0
        self.drag_start_ty = 0.0
        self.drag_start_scroll = 0
        self.press_idx = -1
        self.press_raw_y = 0.0
        self.press_token = 0
        self.row_h = 0
        self.touch_slop = 0
        self.scroll = None
        self.list_box = None
        self.handler = None
        self.folders = []
        self.current_fid = 0
        self.orders_by_folder = {}
        self.initial_orders = {}
        self.tab_views = {}
        self.tabs_scroll = None
        self.max_list_h = 0
        self._tab_colors = {}
        self.row_cache = {}
        self._mc_ref = None
        self._acc = 0
        self._dialogs_frag = None
        self._dialog_cell_cls = None
        self._render_token = 0
        self._lp_runnable = None
        self._render_runnable = None
        self._proxies = []

    def _dp(self, ctx, val):
        return int(round(val * float(ctx.getResources().getDisplayMetrics().density)))

    @staticmethod
    def _argb(val):
        return val - (1 << 32) if val >= (1 << 31) else val

    @staticmethod
    def _is_dark(color_int):
        r = (color_int >> 16) & 0xFF
        g = (color_int >> 8) & 0xFF
        b = color_int & 0xFF
        return (0.299 * r + 0.587 * g + 0.114 * b) < 128.0

    def _theme_color(self, key_name, fallback):
        try:
            Theme = self._j("org.telegram.ui.ActionBar.Theme")
            key = getattr(Theme, key_name, None)
            if key is not None:
                return int(Theme.getColor(key))
        except Exception:
            pass
        return fallback

    def _find_dialogs_activity(self):
        return self.plugin._find_dialogs_fragment()

    def _make_native_cell(self, ctx, did, tl_dialog, dialogs_frag):
        try:
            DialogCell = self._dialog_cell_cls or self._j("org.telegram.ui.Cells.DialogCell")
            acc = self._acc
            ctors = (
                (dialogs_frag, ctx, False, False, jint(acc), None),
                (dialogs_frag, ctx, False, False),
                (None, ctx, False, False, jint(acc), None),
                (None, ctx, False, False),
            )
            cell = None
            if PinOrderEditor._CELL_CTOR_IDX is not None:
                try:
                    cell = DialogCell(*ctors[PinOrderEditor._CELL_CTOR_IDX])
                except Exception:
                    PinOrderEditor._CELL_CTOR_IDX = None
            if cell is None:
                for idx, args in enumerate(ctors):
                    try:
                        cell = DialogCell(*args)
                        PinOrderEditor._CELL_CTOR_IDX = idx
                        break
                    except Exception:
                        continue
            if cell is None:
                return None

            cell.setClickable(False)
            cell.setFocusable(False)
            if tl_dialog is not None:
                try:
                    cell.setDialog(tl_dialog, 0, 0)
                except Exception:
                    cell.setDialog(jlong(int(did)), None, 0, False, False)
            else:
                cell.setDialog(jlong(int(did)), None, 0, False, False)
            return cell
        except Exception as exc:
            self.plugin.l("DialogCell err: %r" % (exc,))
            return None

    def _make_fallback_row(self, ctx, did):
        LinearLayout = self._j("android.widget.LinearLayout")
        TextView = self._j("android.widget.TextView")
        Gravity = self._j("android.view.Gravity")
        TruncateAt = self._j("android.text.TextUtils$TruncateAt")
        LP = self._j("android.widget.LinearLayout$LayoutParams")

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        pad_x = self._dp(ctx, 14)
        row.setPadding(pad_x, 0, pad_x, 0)

        try:
            BackupImageView = self._j("org.telegram.ui.Components.BackupImageView")
            AvatarDrawable = self._j("org.telegram.ui.Components.AvatarDrawable")
            ImageLocation = self._j("org.telegram.messenger.ImageLocation")
            mc = self.plugin._mc()
            av = BackupImageView(ctx)
            av.setRoundRadius(self._dp(ctx, 25))
            av_sz = self._dp(ctx, 50)
            av_lp = LP(av_sz, av_sz)
            av_lp.rightMargin = self._dp(ctx, 12)
            av.setLayoutParams(av_lp)

            obj = None
            if mc is not None:
                obj = mc.getChat(jlong(abs(did))) if did < 0 else mc.getUser(jlong(did))
            ad = AvatarDrawable(obj) if obj is not None else AvatarDrawable()
            if obj is not None:
                loc = ImageLocation.getForUserOrChat(obj, ImageLocation.TYPE_SMALL)
                av.setImage(loc, "50_50", ad, obj)
            else:
                av.setImageDrawable(ad)
            row.addView(av)
        except Exception:
            pass

        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setLayoutParams(LP(0, LP.WRAP_CONTENT, 1.0))

        title = TextView(ctx)
        title.setText(self.plugin._describe(did))
        title.setTextSize(16.0)
        title.setSingleLine(True)
        title.setEllipsize(TruncateAt.END)
        title.setTextColor(self._theme_color("key_chats_name", self._argb(0xFFEDEDED)))
        col.addView(title)

        sub = self.plugin._preview(did)
        if sub:
            msg = TextView(ctx)
            msg.setText(sub)
            msg.setTextSize(14.0)
            msg.setSingleLine(True)
            msg.setEllipsize(TruncateAt.END)
            msg.setTextColor(self._theme_color("key_chats_message", self._argb(0xFF8E8E93)))
            col.addView(msg)

        row.addView(col)
        return row

    def _build_row(self, ctx, did, tl_dialog, dialogs_frag):
        FrameLayout = self._j("android.widget.FrameLayout")
        FLP = self._j("android.widget.FrameLayout$LayoutParams")

        wrap = FrameLayout(ctx)
        wrap.setLayoutParams(FLP(FLP.MATCH_PARENT, self.row_h))
        wrap.setClickable(False)
        wrap.setFocusable(False)

        inner = self._make_native_cell(ctx, did, tl_dialog, dialogs_frag)
        if inner is None:
            inner = self._make_fallback_row(ctx, did)
        wrap.addView(inner, FLP(FLP.MATCH_PARENT, self.row_h))
        return wrap

    def _haptic(self, view, const_name):
        try:
            HFC = self._j("android.view.HapticFeedbackConstants")
            code = getattr(HFC, const_name, HFC.LONG_PRESS)
            view.performHapticFeedback(code)
        except Exception:
            pass

    def _start_drag(self, idx, ctx):
        if idx < 0 or idx >= len(self.order):
            return
        self.drag_idx = idx
        self.drag_did = self.order[idx]
        self.drag_view = self.views.get(self.drag_did)
        if self.drag_view is None:
            self.drag_idx = -1
            return

        self.drag_start_ty = float(self.drag_view.getTranslationY())
        self.drag_start_raw_y = self.press_raw_y
        self.drag_start_scroll = int(self.scroll.getScrollY()) if self.scroll is not None else 0

        try:
            self.scroll.requestDisallowInterceptTouchEvent(True)
        except Exception:
            pass

        self._haptic(self.drag_view, "LONG_PRESS")
        self.drag_view.bringToFront()
        try:
            self.drag_view.setElevation(float(self._dp(ctx, 10)))
            self.drag_view.setBackgroundColor(self._theme_color("key_listSelector", self._argb(0x22FFFFFF)))
            self.drag_view.animate().scaleX(1.03).scaleY(1.03).alpha(0.96).setDuration(140).start()
        except Exception:
            pass

    def _move_drag(self, raw_y, ctx):
        if self.drag_idx < 0 or self.drag_view is None:
            return
        cur_scroll = int(self.scroll.getScrollY()) if self.scroll is not None else 0
        dy = (raw_y - self.drag_start_raw_y) + (cur_scroll - self.drag_start_scroll)
        max_ty = float(max(0, (len(self.order) - 1) * self.row_h))
        new_ty = max(0.0, min(max_ty, self.drag_start_ty + dy))
        self.drag_view.setTranslationY(new_ty)

        if self.scroll is not None:
            try:
                jarr = self._j("java.lang.reflect.Array").newInstance(self._j("java.lang.Integer").TYPE, 2)
                self.scroll.getLocationOnScreen(jarr)
                top_y = float(jarr[1])
                bot_y = top_y + float(self.scroll.getHeight())
                edge = float(self._dp(ctx, 44))
                step = self._dp(ctx, 10)
                if raw_y < top_y + edge:
                    self.scroll.smoothScrollBy(0, -step)
                elif raw_y > bot_y - edge:
                    self.scroll.smoothScrollBy(0, step)
            except Exception:
                pass

        target_idx = int(round(new_ty / float(self.row_h)))
        target_idx = max(0, min(len(self.order) - 1, target_idx))
        if target_idx != self.drag_idx:
            item = self.order.pop(self.drag_idx)
            self.order.insert(target_idx, item)
            self.drag_idx = target_idx
            self._haptic(self.drag_view, "CLOCK_TICK")
            self._animate_slots(skip_did=self.drag_did)

    def _animate_slots(self, skip_did=None):
        Decel = self._j("android.view.animation.DecelerateInterpolator")
        interp = Decel()
        for idx, did in enumerate(self.order):
            if did == skip_did:
                continue
            v = self.views.get(did)
            if v is not None:
                v.animate().translationY(float(idx * self.row_h)).setDuration(180).setInterpolator(interp).start()

    def _end_drag(self):
        self.press_token += 1
        self.press_idx = -1
        if self.drag_idx < 0 or self.drag_view is None:
            return
        v = self.drag_view
        idx = self.drag_idx
        self.drag_idx = -1
        self.drag_did = None
        self.drag_view = None
        try:
            self.scroll.requestDisallowInterceptTouchEvent(False)
        except Exception:
            pass
        Decel = self._j("android.view.animation.DecelerateInterpolator")
        try:
            v.setBackgroundColor(0)
            v.setElevation(0.0)
            v.animate().translationY(float(idx * self.row_h)).scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(180).setInterpolator(Decel()).start()
        except Exception:
            pass

    def _ensure_tab_visible(self, ctx, animate=True):
        hsv = self.tabs_scroll
        tv = self.tab_views.get(self.current_fid)
        if hsv is None or tv is None:
            return
        try:
            view_w = int(hsv.getWidth())
            tab_w = int(tv.getWidth())
            if view_w <= 0 or tab_w <= 0:
                return
            child = hsv.getChildAt(0)
            content_w = int(child.getWidth()) if child is not None else 0
            max_scroll = max(0, content_w - view_w)
            if max_scroll <= 0:
                return

            cur_x = int(hsv.getScrollX())
            tab_left = int(tv.getLeft())
            tab_right = int(tv.getRight())
            peek = self._dp(ctx, 32)

            target_x = cur_x
            if tab_left < cur_x + peek:
                target_x = max(0, tab_left - peek)
            elif tab_right > cur_x + view_w - peek:
                target_x = min(max_scroll, tab_right - view_w + peek)

            if target_x != cur_x:
                if animate:
                    hsv.smoothScrollTo(jint(target_x), jint(0))
                else:
                    hsv.scrollTo(jint(target_x), jint(0))
        except Exception:
            pass

    def _update_tab_styles(self, ctx, scroll_to_active=True):
        GradientDrawable = self._j("android.graphics.drawable.GradientDrawable")
        sel_bg = self._tab_colors["sel_bg"]
        sel_text = self._tab_colors["sel_text"]
        unsel_text = self._tab_colors["unsel_text"]
        radius = float(self._dp(ctx, 18))

        for fid, tv in self.tab_views.items():
            if fid == self.current_fid:
                pill = GradientDrawable()
                pill.setColor(sel_bg)
                pill.setCornerRadius(radius)
                tv.setBackground(pill)
                tv.setTextColor(sel_text)
            else:
                tv.setBackground(None)
                tv.setTextColor(unsel_text)

        if scroll_to_active:
            self._ensure_tab_visible(ctx, animate=True)

    def _select_folder(self, fid, ctx):
        if fid == self.current_fid:
            return
        self._end_drag()
        self.orders_by_folder[self.current_fid] = list(self.order)
        self.current_fid = fid
        self._update_tab_styles(ctx, scroll_to_active=True)

        self._render_token += 1
        tok = self._render_token
        editor = self

        def _do_render():
            if tok == editor._render_token:
                if fid not in editor.orders_by_folder:
                    ord_f = list(editor.plugin.desired_order(fid))
                    editor.orders_by_folder[fid] = ord_f
                    editor.initial_orders[fid] = list(ord_f)
                editor._render_folder_list(ctx)

        r = _runnable_proxy(_do_render)
        self._render_runnable = r
        if self.handler is not None:
            self.handler.post(r)
        else:
            _do_render()

    def _render_folder_list(self, ctx):
        TextView = self._j("android.widget.TextView")
        View = self._j("android.view.View")
        Gravity = self._j("android.view.Gravity")
        FLP = self._j("android.widget.FrameLayout$LayoutParams")

        self.list_box.removeAllViews()
        self.views = {}
        self.order = list(self.orders_by_folder.get(self.current_fid, []))

        if not self.order:
            empty_h = self._dp(ctx, 96)
            self.list_box.setMinimumHeight(empty_h)
            self.list_box.setLayoutParams(FLP(FLP.MATCH_PARENT, empty_h))
            tv = TextView(ctx)
            tv.setText("В этой папке нет закреплённых чатов")
            tv.setTextSize(14.0)
            tv.setTextColor(self._theme_color("key_dialogTextGray3", self._argb(0xFF8E8E93)))
            tv.setGravity(Gravity.CENTER)
            tv.setPadding(self._dp(ctx, 18), self._dp(ctx, 32), self._dp(ctx, 18), self._dp(ctx, 32))
            tv.setLayoutParams(FLP(FLP.MATCH_PARENT, empty_h))
            self.list_box.addView(tv)
            try:
                lp = self.scroll.getLayoutParams()
                lp.height = empty_h
                self.scroll.setLayoutParams(lp)
                self.scroll.requestLayout()
            except Exception:
                pass
            return

        total_h = len(self.order) * self.row_h
        self.list_box.setMinimumHeight(total_h)
        self.list_box.setLayoutParams(FLP(FLP.MATCH_PARENT, total_h))

        spacer = View(ctx)
        spacer.setLayoutParams(FLP(1, total_h))
        self.list_box.addView(spacer)

        mc = self._mc_ref or self.plugin._mc()
        for i, did in enumerate(self.order):
            row = self.row_cache.get(did)
            if row is not None:
                try:
                    parent = row.getParent()
                    if parent is not None:
                        parent.removeView(row)
                except Exception:
                    pass
                try:
                    row.setScaleX(1.0)
                    row.setScaleY(1.0)
                    row.setAlpha(1.0)
                    row.setElevation(0.0)
                    row.setBackgroundColor(0)
                except Exception:
                    pass
            else:
                tl_dialog = self.plugin._get_tl_dialog(did, mc)
                row = self._build_row(ctx, did, tl_dialog, self._dialogs_frag)
                self.row_cache[did] = row

            row.setTranslationY(float(i * self.row_h))
            self.list_box.addView(row)
            self.views[did] = row

        try:
            lp = self.scroll.getLayoutParams()
            lp.height = min(total_h, self.max_list_h)
            self.scroll.setLayoutParams(lp)
            self.scroll.requestLayout()
        except Exception:
            pass
        try:
            self.scroll.scrollTo(0, 0)
        except Exception:
            pass

    def open(self):
        ctx = self.plugin._activity()
        if ctx is None:
            self.plugin.toast("Не удалось открыть редактор")
            return

        editor = self

        self._mc_ref = self.plugin._mc()
        self._acc = self.plugin._account()
        self._dialogs_frag = self._find_dialogs_activity()
        try:
            self._dialog_cell_cls = self._j("org.telegram.ui.Cells.DialogCell")
        except Exception:
            self._dialog_cell_cls = None

        self.folders = self.plugin.get_folders()
        valid_fids = [fid for fid, _title, _fobj in self.folders]
        self.orders_by_folder = {}
        self.initial_orders = {}

        active = self.plugin._active_folder_id_fast()
        if active not in valid_fids:
            active = 0

        ord_active = list(self.plugin.desired_order(active))
        self.orders_by_folder[active] = ord_active
        self.initial_orders[active] = list(ord_active)

        if ord_active:
            self.current_fid = active
        else:
            found_fid = None
            for fid in valid_fids:
                if fid == active:
                    continue
                ord_f = list(self.plugin.desired_order(fid))
                self.orders_by_folder[fid] = ord_f
                self.initial_orders[fid] = list(ord_f)
                if ord_f:
                    found_fid = fid
                    break
            if found_fid is None:
                self.plugin.toast("Нет закреплённых чатов")
                return
            self.current_fid = found_fid

        self.order = list(self.orders_by_folder.get(self.current_fid, []))

        Dialog = self._j("android.app.Dialog")
        Window = self._j("android.view.Window")
        LinearLayout = self._j("android.widget.LinearLayout")
        FrameLayout = self._j("android.widget.FrameLayout")
        ScrollView = self._j("android.widget.ScrollView")
        TextView = self._j("android.widget.TextView")
        View = self._j("android.view.View")
        Gravity = self._j("android.view.Gravity")
        MotionEvent = self._j("android.view.MotionEvent")
        GradientDrawable = self._j("android.graphics.drawable.GradientDrawable")
        ColorDrawable = self._j("android.graphics.drawable.ColorDrawable")
        Handler = self._j("android.os.Handler")
        Looper = self._j("android.os.Looper")
        LLP = self._j("android.widget.LinearLayout$LayoutParams")
        FLP = self._j("android.widget.FrameLayout$LayoutParams")

        self.handler = Handler(Looper.getMainLooper())
        self.row_h = self._dp(ctx, self.ROW_DP)
        self.touch_slop = self._dp(ctx, 10)

        bg_color = self._theme_color("key_dialogBackground", self._argb(0xFF18181B))

        if self._is_dark(bg_color):
            self._tab_colors = {
                "bar_bg": self._argb(0xFF212026),
                "bar_stroke": self._argb(0x1EFFFFFF),
                "sel_bg": self._argb(0xFF392B49),
                "sel_text": self._argb(0xFFD59BFF),
                "unsel_text": self._argb(0xFFB5B5BC),
            }
        else:
            self._tab_colors = {
                "bar_bg": self._argb(0xFFF1EFF5),
                "bar_stroke": self._argb(0x14000000),
                "sel_bg": self._argb(0x289B59F6),
                "sel_text": self._argb(0xFF7C3AED),
                "unsel_text": self._argb(0xFF6B6B73),
            }
        title_color = self._theme_color("key_dialogTextBlack", self._argb(0xFFF2F2F7))
        accent_color = self._theme_color("key_dialogTextBlue2", self._argb(0xFFA78BFA))
        muted_color = self._theme_color("key_dialogTextGray3", self._argb(0xFF8E8E93))
        div_color = self._theme_color("key_divider", self._argb(0x22FFFFFF))

        dlg = Dialog(ctx)
        dlg.requestWindowFeature(Window.FEATURE_NO_TITLE)
        dlg.setCancelable(True)
        self.dialog = dlg

        card = LinearLayout(ctx)
        card.setOrientation(LinearLayout.VERTICAL)
        card_bg = GradientDrawable()
        card_bg.setColor(bg_color)
        card_bg.setCornerRadius(float(self._dp(ctx, 18)))
        card.setBackground(card_bg)
        card.setClipToOutline(True)

        hdr = TextView(ctx)
        hdr.setText("Порядок закрепов")
        hdr.setTextSize(17.0)
        hdr.setTextColor(title_color)
        hdr.setPadding(self._dp(ctx, 18), self._dp(ctx, 16), self._dp(ctx, 18), self._dp(ctx, 2))
        card.addView(hdr, LLP(LLP.MATCH_PARENT, LLP.WRAP_CONTENT))

        hint = TextView(ctx)
        hint.setText("Зажмите чат, чтобы перенести...")
        hint.setTextSize(13.0)
        hint.setTextColor(muted_color)
        hint.setPadding(self._dp(ctx, 18), 0, self._dp(ctx, 18), self._dp(ctx, 12))
        card.addView(hint, LLP(LLP.MATCH_PARENT, LLP.WRAP_CONTENT))

        HorizontalScrollView = self._j("android.widget.HorizontalScrollView")
        TypedValue = self._j("android.util.TypedValue")
        AndroidUtilities = self._j("org.telegram.messenger.AndroidUtilities")

        capsule = FrameLayout(ctx)
        cap_bg = GradientDrawable()
        cap_bg.setColor(self._tab_colors["bar_bg"])
        cap_bg.setCornerRadius(float(self._dp(ctx, 22)))
        cap_bg.setStroke(self._dp(ctx, 1), self._tab_colors["bar_stroke"])
        capsule.setBackground(cap_bg)
        capsule.setClipToOutline(True)
        pad_cap = self._dp(ctx, 4)
        capsule.setPadding(pad_cap, pad_cap, pad_cap, pad_cap)

        hsv = HorizontalScrollView(ctx)
        hsv.setHorizontalScrollBarEnabled(False)
        hsv.setOverScrollMode(View.OVER_SCROLL_NEVER)
        hsv.setPadding(0, 0, 0, 0)
        hsv.setSmoothScrollingEnabled(True)
        self.tabs_scroll = hsv

        tabs_row = LinearLayout(ctx)
        tabs_row.setOrientation(LinearLayout.HORIZONTAL)
        tabs_row.setGravity(Gravity.CENTER_VERTICAL)

        self.tab_views = {}
        for fid, title, _fobj in self.folders:
            tv = TextView(ctx)
            tv.setText(title)
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14.0)
            tv.setTypeface(AndroidUtilities.bold())
            tv.setSingleLine(True)
            tv.setGravity(Gravity.CENTER)
            tv.setPadding(self._dp(ctx, 14), self._dp(ctx, 7), self._dp(ctx, 14), self._dp(ctx, 7))
            tv.setClickable(True)
            tv.setTextColor(self._tab_colors["unsel_text"])
            tv.setFocusable(False)
            tv.setFocusableInTouchMode(False)

            tp = OnClickListener(lambda _v, target_fid=fid: editor._select_folder(target_fid, ctx))
            self._proxies.append(tp)
            tv.setOnClickListener(tp)

            tlp = LLP(LLP.WRAP_CONTENT, LLP.WRAP_CONTENT)
            tlp.rightMargin = self._dp(ctx, 2)
            tabs_row.addView(tv, tlp)
            self.tab_views[fid] = tv

        hsv.addView(tabs_row, FLP(FLP.WRAP_CONTENT, FLP.WRAP_CONTENT))
        capsule.addView(hsv, FLP(FLP.MATCH_PARENT, FLP.WRAP_CONTENT))
        cap_lp = LLP(LLP.MATCH_PARENT, LLP.WRAP_CONTENT)
        cap_lp.leftMargin = self._dp(ctx, 14)
        cap_lp.rightMargin = self._dp(ctx, 14)
        cap_lp.bottomMargin = self._dp(ctx, 10)
        card.addView(capsule, cap_lp)

        self._update_tab_styles(ctx, scroll_to_active=False)

        scroll = ScrollView(ctx)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setFillViewport(True)
        scroll.setClipChildren(False)
        self.scroll = scroll

        list_box = FrameLayout(ctx)
        list_box.setClipChildren(False)
        list_box.setClipToPadding(False)
        self.list_box = list_box

        self.max_list_h = int(float(ctx.getResources().getDisplayMetrics().heightPixels) * 0.62)
        init_h = (len(self.order) * self.row_h) if self.order else self._dp(ctx, 96)
        list_box.setMinimumHeight(init_h)
        list_box.setLayoutParams(FLP(FLP.MATCH_PARENT, init_h))

        scroll.addView(list_box)
        card.addView(scroll, LLP(LLP.MATCH_PARENT, min(init_h, self.max_list_h)))

        def _on_list_touch(_v, ev):
            act = int(ev.getActionMasked())
            if act == MotionEvent.ACTION_DOWN:
                if not editor.order:
                    return False
                idx = int(ev.getY() // float(editor.row_h))
                if 0 <= idx < len(editor.order):
                    editor.press_idx = idx
                    editor.press_raw_y = float(ev.getRawY())
                    editor.press_token += 1
                    tok = editor.press_token
                    r = _runnable_proxy(lambda t=tok, i=idx: editor._start_drag(i, ctx) if (t == editor.press_token and editor.drag_idx < 0) else None)
                    editor._lp_runnable = r
                    editor.handler.postDelayed(r, jlong(editor.LONG_PRESS_MS))
                return True

            if act == MotionEvent.ACTION_MOVE:
                raw_y = float(ev.getRawY())
                if editor.drag_idx >= 0:
                    editor._move_drag(raw_y, ctx)
                    return True
                if abs(raw_y - editor.press_raw_y) > editor.touch_slop:
                    editor.press_token += 1
                    editor.press_idx = -1
                return False

            if act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                editor._end_drag()
                return True

            return False

        touch_p = _touch_proxy(_on_list_touch)
        self._proxies.append(touch_p)
        list_box.setOnTouchListener(touch_p)

        div = View(ctx)
        div.setBackgroundColor(div_color)
        card.addView(div, LLP(LLP.MATCH_PARENT, self._dp(ctx, 1)))

        bar = LinearLayout(ctx)
        bar.setOrientation(LinearLayout.HORIZONTAL)
        bar.setGravity(Gravity.END | Gravity.CENTER_VERTICAL)
        bar.setPadding(self._dp(ctx, 12), self._dp(ctx, 8), self._dp(ctx, 12), self._dp(ctx, 8))

        def _make_btn(text, color, cb):
            b = TextView(ctx)
            b.setText(text)
            b.setTextSize(15.0)
            b.setTextColor(color)
            b.setPadding(self._dp(ctx, 16), self._dp(ctx, 10), self._dp(ctx, 16), self._dp(ctx, 10))
            b.setClickable(True)
            p = OnClickListener(lambda _v: cb())
            editor._proxies.append(p)
            b.setOnClickListener(p)
            return b

        def _on_cancel():
            try:
                dlg.dismiss()
            except Exception:
                pass

        def _on_apply():
            editor.orders_by_folder[editor.current_fid] = list(editor.order)
            try:
                dlg.dismiss()
            except Exception:
                pass
            for fid, new_order in editor.orders_by_folder.items():
                if new_order != editor.initial_orders.get(fid):
                    editor.plugin.apply_order(new_order, fid=fid)
            editor.plugin.toast("Порядок закрепов обновлён")

        bar.addView(_make_btn("Отмена", muted_color, _on_cancel))
        bar.addView(_make_btn("Применить", accent_color, _on_apply))
        card.addView(bar, LLP(LLP.MATCH_PARENT, LLP.WRAP_CONTENT))

        dlg.setContentView(card)
        win = dlg.getWindow()
        if win is not None:
            win.setBackgroundDrawable(ColorDrawable(0))
            dm = ctx.getResources().getDisplayMetrics()
            w = int(float(dm.widthPixels) * 0.92)
            win.setLayout(w, LLP.WRAP_CONTENT)
        dlg.show()

        self._render_token += 1
        init_tok = self._render_token

        def _init_render():
            if init_tok == editor._render_token:
                editor._render_folder_list(ctx)
            editor._ensure_tab_visible(ctx, animate=False)

        init_r = _runnable_proxy(_init_render)
        self._proxies.append(init_r)
        self.handler.post(init_r)