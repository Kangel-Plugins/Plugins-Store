# --------------------------------------------------------------------------
# Константы
# --------------------------------------------------------------------------

QUEUE_FILE = "queue.json"
LEGACY_QUEUE_SETTING = "stories_queue"  # хранилище версии 1.0
QUEUE_REVISION_SETTING = "queue_revision"  # счётчик изменений, нужен только для перерисовки настроек

STATUS_PENDING = "pending"
STATUS_FAILED = "failed"

MAX_ATTEMPTS = 3  # сколько раз пробуем опубликовать, прежде чем пометить ошибкой
RETRY_DELAY_S = 60  # пауза между попытками
MAX_TICK_S = 30  # максимальный интервал между проверками очереди
PENDING_TTL_S = 30  # сколько живёт выбранное время до перехвата публикации
MEDIA_KEEP_S = 600  # сколько хранить файл после публикации (Telegram грузит его асинхронно)
ORPHAN_MEDIA_AGE_S = 3600  # возраст «осиротевших» файлов, после которого они удаляются

THUMB_W_DP = 92
THUMB_H_DP = 136

MATCH = ViewGroup.LayoutParams.MATCH_PARENT
WRAP = ViewGroup.LayoutParams.WRAP_CONTENT


