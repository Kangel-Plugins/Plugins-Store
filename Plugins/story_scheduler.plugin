def tr(key: str, **kwargs: Any) -> str:
    try:
        lang = str(LocaleController.getInstance().getCurrentLocale().getLanguage())
    except Exception:
        lang = "en"
    table = _STRINGS["ru"] if lang == "ru" else _STRINGS["en"]
    text = table.get(key) or _STRINGS["en"].get(key, key)
    return text.format(**kwargs) if kwargs else text


def stories_count_text(count: int) -> str:
    if tr("ok") == _STRINGS["ru"]["ok"]:
        if 11 <= count % 100 <= 19:
            word = "историй"
        elif count % 10 == 1:
            word = "история"
        elif 2 <= count % 10 <= 4:
            word = "истории"
        else:
            word = "историй"
        return f"Запланировано: {count} {word}"
    return f"Scheduled: {count} {'story' if count == 1 else 'stories'}"


# --------------------------------------------------------------------------
# UI-хелперы
# --------------------------------------------------------------------------


def _dp(value: float) -> int:
    return AndroidUtilities.dp(value)


def _argb(value: int) -> int:
    """32-битный ARGB в знаковый int, как ожидает Java."""
    return value - 0x100000000 if value > 0x7FFFFFFF else value


def _rounded(color: int, radius_dp: float, stroke_color: Optional[int] = None) -> GradientDrawable:
    drawable = GradientDrawable()
    drawable.setColor(color)
    drawable.setCornerRadius(float(_dp(radius_dp)))
    if stroke_color is not None:
        drawable.setStroke(_dp(1), stroke_color)
    return drawable


def _text_view(context: Any, text: str, size: float, color: int, bold: bool = False) -> TextView:
    view = TextView(context)
    view.setText(text)
    view.setTextSize(size)
    view.setTextColor(color)
    if bold:
        view.setTypeface(Typeface.DEFAULT_BOLD)
    return view


def _get_activity() -> Any:
    try:
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is not None:
            return activity
    except Exception:
        pass
    return LaunchActivity.instance


def _format_datetime(timestamp: int) -> str:
    return datetime.fromtimestamp(timestamp).strftime("%d.%m.%Y, %H:%M")


class _MediaMissingError(Exception):
    """Медиафайл отложенной истории пропал, повторять публикацию бессмысленно."""


# --------------------------------------------------------------------------
# Хуки
# --------------------------------------------------------------------------


class UploadStoryHook(MethodHook):
    """Перехватывает StoriesController.uploadStory, если пользователь выбрал отложку."""

    def __init__(self, plugin: "StorySchedulerPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        if plugin._bypass_hook:
            return
        schedule_time = plugin._take_pending_time()
        if schedule_time is None:
            return
        param.setResult(None)
        plugin._enqueue_story(param.args[0], schedule_time)


class PrivacyPageHook(MethodHook):
    """Добавляет отложку на страницы шторки приватности историй."""

    def __init__(self, plugin: "StorySchedulerPlugin"):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if param.thisObject is not None:
            self.plugin._configure_page(param.thisObject)


# --------------------------------------------------------------------------
# Плагин
# --------------------------------------------------------------------------


class StorySchedulerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._lock = threading.RLock()
        self._queue: List[Dict[str, Any]] = []
        self._queue_revision = 0
        self._entries: Dict[str, Any] = {}  # живые StoryEntry текущей сессии
        self._in_flight = set()
        self._running = False
        self._tick_generation = 0
        self._bypass_hook = False
        self._pending_time: Optional[int] = None
        self._pending_deadline = 0.0
        self._data_dir = ""
        self._sheet = None

    # ----- жизненный цикл -------------------------------------------------

    def on_plugin_load(self):
        self._data_dir = os.path.join(get_plugins_dir(), "story_scheduler")
        ensure_dir_exists(os.path.join(self._data_dir, "media"))

        with self._lock:
            self._queue = self._read_queue()
            self._persist_locked()
        self._sweep_orphan_media()

        self._running = True
        self._install_hooks()
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text=tr("menu_title"),
                on_click=lambda context: self._open_stories_sheet(),
                icon="msg_schedule",
                priority=50,
            )
        )
        self._schedule_tick(5)
        self.logger.info("Loaded, %d stories in queue", len(self._queue))

    def on_plugin_unload(self):
        # Хуки и пункты меню SDK снимает сам.
        self._running = False
        self._tick_generation += 1
        with self._lock:
            self._entries.clear()
            self._in_flight.clear()

    # ----- настройки ------------------------------------------------------

    def create_settings(self) -> List[Any]:
        return [
            Header(text=tr("settings_header")),
            Text(
                text=tr("notes_title"),
                subtext=tr("notes_sub"),
                icon="msg_info",
                on_click=lambda view: self._show_notes_dialog(),
            ),
            Divider(),
            Header(text=tr("list_header")),
            Text(
                text=tr("list_title"),
                subtext=self._queue_summary(),
                icon="msg_schedule",
                on_click=lambda view: self._open_stories_sheet(),
            ),
            Divider(),
            Header(text=tr("queue_header")),
            Text(
                text=tr("clear_title"),
                subtext=tr("clear_sub"),
                icon="msg_delete",
                red=True,
                on_click=lambda view: self._confirm_clear_all(),
            ),
        ]

    def _queue_summary(self) -> str:
        count = len(self._items(STATUS_PENDING))
        return stories_count_text(count) if count else tr("list_empty_sub")

    def _show_notes_dialog(self):
        activity = _get_activity()
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(tr("notes_title"))
        builder.set_message(tr("notes_body"))
        builder.set_positive_button(tr("ok"), lambda bld, which: bld.dismiss())
        builder.show()

    def _confirm_clear_all(self):
        activity = _get_activity()
        if activity is None:
            BulletinHelper.show_error(tr("err_picker"))
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(tr("clear_confirm_title"))
        builder.set_message(tr("clear_confirm_msg"))
        builder.set_positive_button(tr("clear_btn"), lambda bld, which: self._clear_all())
        builder.set_negative_button(tr("cancel"), None)
        builder.show()
        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)

    def _clear_all(self):
        with self._lock:
            removed = list(self._queue)
            self._queue = []
            self._entries.clear()
            self._persist_locked()
        self._notify_queue_changed()
        for item in removed:
            self._delete_media(item.get("media_path"))
        BulletinHelper.show_info(tr("cleared", n=len(removed)))
        self.logger.info("Queue cleared by user (%d items)", len(removed))

    # ----- хранилище очереди ----------------------------------------------

    def _queue_path(self) -> str:
        return os.path.join(self._data_dir, QUEUE_FILE)

    def _media_dir(self) -> str:
        return os.path.join(self._data_dir, "media")

    def _read_queue(self) -> List[Dict[str, Any]]:
        data: Any = None
        try:
            path = self._queue_path()
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8") as file:
                    data = json.load(file)
            else:
                legacy = self.get_setting(LEGACY_QUEUE_SETTING, None)
                if legacy:
                    data = json.loads(legacy)
                    self.set_setting(LEGACY_QUEUE_SETTING, "")
        except (OSError, ValueError) as error:
            self.logger.warning("Could not read queue: %s", error)

        if not isinstance(data, list):
            return []
        queue = []
        for item in data:
            if isinstance(item, dict) and item.get("id"):
                if item.get("status") not in (STATUS_PENDING, STATUS_FAILED):
                    item["status"] = STATUS_PENDING
                queue.append(item)
        return queue

    def _persist_locked(self):
        path = self._queue_path()
        tmp_path = path + ".tmp"
        try:
            with open(tmp_path, "w", encoding="utf-8") as file:
                json.dump(self._queue, file, ensure_ascii=False)
            os.replace(tmp_path, path)
        except OSError:
            self.logger.exception("Could not save queue")

    def _mutate(self, func):
        """Выполняет func(queue) под блокировкой, сохраняет очередь и обновляет настройки."""
        with self._lock:
            result = func(self._queue)
            self._persist_locked()
        self._notify_queue_changed()
        return result

    def _notify_queue_changed(self):
        """Перерисовывает страницу настроек, чтобы счётчик историй был актуальным."""
        self._queue_revision += 1
        revision = self._queue_revision
        run_on_ui_thread(lambda: self.set_setting(QUEUE_REVISION_SETTING, revision, reload_settings=True))

    def _items(self, status: Optional[str] = None) -> List[Dict[str, Any]]:
        with self._lock:
            return [dict(it) for it in self._queue if status is None or it.get("status") == status]

    def _find_item(self, story_id: str) -> Optional[Dict[str, Any]]:
        with self._lock:
            for item in self._queue:
                if item["id"] == story_id:
                    return dict(item)
        return None

    def _delete_media(self, path: Optional[str]):
        """Удаляет файл, только если он лежит в папке плагина."""
        if not path:
            return
        media_dir = os.path.abspath(self._media_dir()) + os.sep
        if not os.path.abspath(path).startswith(media_dir):
            return
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        except OSError as error:
            self.logger.warning("Could not delete %s: %s", path, error)

    def _sweep_orphan_media(self):
        with self._lock:
            used = {os.path.abspath(it["media_path"]) for it in self._queue if it.get("media_path")}
        media_dir = self._media_dir()
        now = time.time()
        try:
            for name in os.listdir(media_dir):
                path = os.path.abspath(os.path.join(media_dir, name))
                if path not in used and now - os.path.getmtime(path) > ORPHAN_MEDIA_AGE_S:
                    self._delete_media(path)
        except OSError as error:
            self.logger.warning("Media sweep failed: %s", error)

    def _remove_story(self, story_id: str, keep_media_s: int = 0):
        def mutate(queue):
            for index, item in enumerate(queue):
                if item["id"] == story_id:
                    return queue.pop(index)
            return None

        removed = self._mutate(mutate)
        self._entries.pop(story_id, None)
        path = removed.get("media_path") if removed else None
        if not path:
            return
        if keep_media_s > 0:
            run_on_queue(lambda: self._delete_media(path), PLUGINS_QUEUE, keep_media_s * 1000)
        else:
            self._delete_media(path)

    # ----- хуки -----------------------------------------------------------

    def _install_hooks(self):
        controller_class = find_class("org.telegram.ui.Stories.StoriesController")
        if controller_class:
            self._hook_methods(controller_class, ("uploadStory",), UploadStoryHook(self))
        else:
            self.logger.warning("StoriesController not found")

        page_class = find_class("org.telegram.ui.Stories.recorder.StoryPrivacyBottomSheet$Page")
        if page_class:
            page_hook = PrivacyPageHook(self)
            try:
                self.hook_all_constructors(page_class, page_hook)
            except Exception:
                self.logger.exception("Could not hook Page constructors")
            self._hook_methods(page_class, ("updateButton", "bind"), page_hook)
        else:
            self.logger.warning("StoryPrivacyBottomSheet.Page not found")

    def _hook_methods(self, java_class: Any, names: Tuple[str, ...], hook: MethodHook):
        for name in names:
            try:
                self.hook_all_methods(java_class, name, hook)
            except Exception:
                self.logger.exception("Could not hook %s", name)

    def _configure_page(self, page: Any):
        try:
            button = get_private_field(page, "button") or self._find_publish_button(page)
            if button is None:
                return

            button.setOnLongClickListener(
                OnLongClickListener(lambda view: self._on_publish_long_click(view, button))
            )
            button.setLongClickable(True)

            schedule_button = get_private_field(page, "button2")
            if schedule_button is not None:
                schedule_button.setVisibility(View.VISIBLE)
                schedule_button.setText(tr("schedule_btn"), False)
                schedule_button.setOnClickListener(
                    OnClickListener(lambda view: self._on_schedule_click(view, button))
                )
        except Exception:
            self.logger.exception("Could not configure privacy page")

    def _find_publish_button(self, root: Any) -> Any:
        try:
            if "ButtonWithCounterView" in root.getClass().getName():
                return root
            if hasattr(root, "getChildCount"):
                for index in range(root.getChildCount()):
                    found = self._find_publish_button(root.getChildAt(index))
                    if found is not None:
                        return found
        except Exception:
            pass
        return None

    def _on_publish_long_click(self, view: Any, button: Any) -> bool:
        view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
        self._show_schedule_picker(button)
        return True

    def _on_schedule_click(self, view: Any, button: Any):
        view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
        self._show_schedule_picker(button)

    # ----- выбор даты и времени -------------------------------------------

    def _show_schedule_picker(self, button: Any):
        activity = _get_activity()
        if activity is None:
            BulletinHelper.show_error(tr("err_picker"))
            return
        try:
            if self._show_native_picker(activity, button):
                return
        except Exception:
            self.logger.debug("Native schedule picker unavailable", exc_info=True)
        self._show_system_picker(activity, button)

    def _show_native_picker(self, activity: Any, button: Any) -> bool:
        """Колёсный выбор даты из самого Telegram."""
        creator = find_class("org.telegram.ui.Components.AlertsCreator")
        delegate_class = find_class("org.telegram.ui.Components.AlertsCreator$ScheduleDatePickerDelegate")
        if not creator or not delegate_class:
            return False

        plugin = self

        class Delegate(dynamic_proxy(delegate_class)):
            # Число аргументов зависит от версии Telegram, лишние игнорируем.
            def didSelectDate(self, notify, schedule_date, *rest):
                plugin._on_date_selected(int(schedule_date), button)

        builder = creator.createScheduleDatePickerDialog(activity, 0, Delegate())
        if builder is None:
            return False
        builder.show()
        return True

    def _show_system_picker(self, activity: Any, button: Any):
        """Запасной вариант: системные диалоги даты и времени."""
        date_listener = find_class("android.app.DatePickerDialog$OnDateSetListener")
        time_listener = find_class("android.app.TimePickerDialog$OnTimeSetListener")
        if not date_listener or not time_listener:
            BulletinHelper.show_error(tr("err_picker"))
            return

        plugin = self
        now = datetime.now()

        class TimeListener(dynamic_proxy(time_listener)):
            def __init__(self, year, month, day):
                super().__init__()
                self.year, self.month, self.day = year, month, day

            def onTimeSet(self, view, hour, minute):
                chosen = datetime(self.year, self.month, self.day, hour, minute)
                plugin._on_date_selected(int(chosen.timestamp()), button)

        class DateListener(dynamic_proxy(date_listener)):
            def onDateSet(self, view, year, month, day):
                dialog = TimePickerDialog(
                    activity, TimeListener(year, month + 1, day), now.hour, now.minute, True
                )
                dialog.setTitle(tr("pick_time"))
                dialog.show()

        dialog = DatePickerDialog(activity, DateListener(), now.year, now.month - 1, now.day)
        dialog.getDatePicker().setMinDate(int(time.time() * 1000) - 1000)
        dialog.setTitle(tr("pick_date"))
        dialog.show()

    def _on_date_selected(self, schedule_time: int, button: Any):
        if schedule_time <= int(time.time()):
            BulletinHelper.show_error(tr("err_future"))
            return
        self._pending_time = schedule_time
        self._pending_deadline = time.time() + PENDING_TTL_S
        # Обычный клик по кнопке запускает штатную публикацию, которую перехватит UploadStoryHook.
        run_on_ui_thread(lambda: button.performClick())

    def _take_pending_time(self) -> Optional[int]:
        schedule_time, deadline = self._pending_time, self._pending_deadline
        self._pending_time = None
        if schedule_time is not None and time.time() <= deadline:
            return schedule_time
        return None

    # ----- постановка в очередь -------------------------------------------

    def _enqueue_story(self, entry: Any, schedule_time: int):
        try:
            story_id = uuid.uuid4().hex
            is_video = bool(getattr(entry, "isVideo", False))
            account = int(getattr(entry, "currentAccount", get_selected_account()))
            peer_id, peer_title = self._describe_peer(entry, account)

            item = {
                "id": story_id,
                "scheduled_at": int(schedule_time),
                "created_at": int(time.time()),
                "account": account,
                "peer_id": peer_id,
                "peer_title": peer_title,
                "media_path": self._copy_media(entry, story_id, is_video),
                "is_video": is_video,
                "caption": str(getattr(entry, "caption", None) or ""),
                "pinned": bool(getattr(entry, "pinned", True)),
                "period": int(getattr(entry, "period", 86400)),
                "status": STATUS_PENDING,
                "attempts": 0,
            }

            try:
                entry.fileDeletable = False
            except Exception:
                pass
            self._entries[story_id] = entry

            self._mutate(lambda queue: queue.append(item))
            self._schedule_tick()
            BulletinHelper.show_info(tr("scheduled_at", dt=_format_datetime(item["scheduled_at"])))
            self.logger.info("Story %s scheduled for %s", story_id, item["scheduled_at"])
        except Exception:
            self.logger.exception("Could not enqueue story")
            BulletinHelper.show_error(tr("err_save"))

    def _copy_media(self, entry: Any, story_id: str, is_video: bool) -> Optional[str]:
        source = getattr(entry, "file", None)
        if source is None or not source.exists():
            return None
        source_path = str(source.getAbsolutePath())
        target = os.path.join(self._media_dir(), story_id + (".mp4" if is_video else ".jpg"))
        try:
            shutil.copy2(source_path, target)
            return target
        except OSError as error:
            self.logger.warning("Could not copy media: %s", error)
            return source_path

    def _describe_peer(self, entry: Any, account: int) -> Tuple[int, str]:
        peer = getattr(entry, "peer", None)
        if peer is None:
            return 0, tr("my_profile")
        peer_id = int(DialogObject.getPeerDialogId(peer))
        if peer_id == 0:
            return 0, tr("my_profile")
        title = None
        if peer_id < 0:
            try:
                chat = get_messages_controller(account).getChat(abs(peer_id))
                title = getattr(chat, "title", None) if chat else None
            except Exception:
                self.logger.debug("Could not resolve chat %s", peer_id, exc_info=True)
        return peer_id, str(title) if title else tr("chat_fallback", id=peer_id)

    # ----- фоновая публикация ---------------------------------------------

    def _schedule_tick(self, delay_s: Optional[float] = None):
        if not self._running:
            return
        with self._lock:
            self._tick_generation += 1
            generation = self._tick_generation
        if delay_s is None:
            delay_s = self._seconds_to_next_due()
        run_on_queue(lambda: self._tick(generation), PLUGINS_QUEUE, int(delay_s * 1000))

    def _seconds_to_next_due(self) -> float:
        with self._lock:
            due_times = [it.get("scheduled_at", 0) for it in self._queue if it.get("status") == STATUS_PENDING]
        if not due_times:
            return MAX_TICK_S
        return min(MAX_TICK_S, max(1.0, min(due_times) - time.time()))

    def _tick(self, generation: int):
        if not self._running or generation != self._tick_generation:
            return
        try:
            now = int(time.time())
            with self._lock:
                due_ids = [
                    it["id"]
                    for it in self._queue
                    if it.get("status") == STATUS_PENDING
                    and it.get("scheduled_at", 0) <= now
                    and it["id"] not in self._in_flight
                ]
            for story_id in due_ids:
                self._publish_story(story_id)
        except Exception:
            self.logger.exception("Queue check failed")
        finally:
            self._schedule_tick()

    def _publish_story(self, story_id: str):
        with self._lock:
            if story_id in self._in_flight:
                return
            self._in_flight.add(story_id)
        run_on_ui_thread(lambda: self._upload_on_ui_thread(story_id))

    def _upload_on_ui_thread(self, story_id: str):
        try:
            item = self._find_item(story_id)
            if item is None:
                return
            self._upload(item)
            self._remove_story(story_id, keep_media_s=MEDIA_KEEP_S)
            BulletinHelper.show_info(tr("published", title=item.get("peer_title", "")))
            self.logger.info("Story %s handed over to Telegram", story_id)
        except _MediaMissingError:
            self.logger.warning("Media for story %s is missing", story_id)
            self._register_failure(story_id, permanent=True)
        except Exception:
            self.logger.exception("Could not publish story %s", story_id)
            self._register_failure(story_id)
        finally:
            with self._lock:
                self._in_flight.discard(story_id)

    def _upload(self, item: Dict[str, Any]):
        account = int(item.get("account", 0))
        controller = get_messages_controller(account).getStoriesController()
        if controller is None:
            raise RuntimeError("StoriesController is not available")

        entry = self._entries.get(item["id"]) or self._restore_entry(item, account)
        self._bypass_hook = True
        try:
            controller.uploadStory(entry, True)
        finally:
            self._bypass_hook = False

    def _restore_entry(self, item: Dict[str, Any], account: int) -> Any:
        """Собирает StoryEntry из сохранённых данных (после перезапуска приложения)."""
        entry_class = find_class("org.telegram.ui.Stories.recorder.StoryEntry")
        file_class = find_class("java.io.File")
        if not entry_class or not file_class:
            raise RuntimeError("StoryEntry is not available")

        path = item.get("media_path")
        if not path or not os.path.exists(path):
            raise _MediaMissingError(path)

        self.logger.warning("Story %s restored without its original editor state", item["id"])
        entry = entry_class()
        entry.file = file_class(path)
        entry.fileDeletable = False
        entry.isVideo = bool(item.get("is_video", False))
        entry.caption = item.get("caption", "")
        entry.pinned = bool(item.get("pinned", True))
        entry.period = int(item.get("period", 86400))
        peer_id = int(item.get("peer_id", 0))
        if peer_id:
            entry.peer = get_messages_controller(account).getInputPeer(peer_id)
        return entry

    def _register_failure(self, story_id: str, permanent: bool = False):
        def mutate(queue):
            for item in queue:
                if item["id"] != story_id:
                    continue
                item["attempts"] = int(item.get("attempts", 0)) + 1
                if permanent or item["attempts"] >= MAX_ATTEMPTS:
                    item["status"] = STATUS_FAILED
                    return True
                item["scheduled_at"] = int(time.time()) + RETRY_DELAY_S
                return False
            return None

        if self._mutate(mutate):
            BulletinHelper.show_error(tr("publish_failed"))

    def _retry_story(self, story_id: str):
        def mutate(queue):
            for item in queue:
                if item["id"] == story_id:
                    item["status"] = STATUS_PENDING
                    item["attempts"] = 0
                    return

        self._mutate(mutate)
        self._publish_story(story_id)

    # ----- шторка со списком историй --------------------------------------

    def _open_stories_sheet(self):
        run_on_ui_thread(self._show_stories_sheet)

    def _dismiss_sheet(self):
        sheet, self._sheet = self._sheet, None
        if sheet is not None:
            try:
                sheet.dismiss()
            except Exception:
                pass

    def _show_stories_sheet(self):
        activity = _get_activity()
        if activity is None:
            BulletinHelper.show_error(tr("err_open_list"))
            return
        try:
            items = sorted(self._items(), key=lambda it: it.get("scheduled_at", 0))
            thumb_jobs: List[Tuple[Any, Optional[str], bool]] = []
            root = self._build_sheet_content(activity, items, thumb_jobs)

            builder_class = find_class("org.telegram.ui.ActionBar.BottomSheet$Builder")
            if builder_class:
                builder = builder_class(activity, False)
                builder.setCustomView(root)
                self._sheet = builder.create()
                self._sheet.show()
            else:
                dialog = AlertDialogBuilder(activity)
                dialog.set_view(root)
                dialog.set_negative_button(tr("close"), None)
                dialog.show()

            if thumb_jobs:
                run_on_queue(lambda: self._load_thumbnails(thumb_jobs), PLUGINS_QUEUE)
        except Exception:
            self.logger.exception("Could not show stories sheet")
            BulletinHelper.show_error(tr("err_open_list"))

    def _build_sheet_content(self, context: Any, items: List[Dict[str, Any]], thumb_jobs: list) -> Any:
        text_color = Theme.getColor(Theme.key_dialogTextBlack)
        hint_color = Theme.getColor(Theme.key_dialogTextGray2)
        pending_count = sum(1 for it in items if it.get("status") == STATUS_PENDING)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setGravity(Gravity.CENTER_HORIZONTAL)
        root.setBackgroundColor(Theme.getColor(Theme.key_dialogBackground))
        root.setPadding(0, _dp(10), 0, _dp(24))

        handle = View(context)
        handle.setBackground(_rounded(_argb(0x33888888), 2))
        handle_params = LinearLayout.LayoutParams(_dp(36), _dp(4))
        handle_params.gravity = Gravity.CENTER_HORIZONTAL
        handle_params.bottomMargin = _dp(14)
        root.addView(handle, handle_params)

        header = LinearLayout(context)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        header.setPadding(_dp(20), 0, _dp(20), _dp(12))
        header.addView(_text_view(context, tr("list_header"), 19.0, text_color, bold=True))
        if pending_count:
            badge = _text_view(context, f"  {pending_count}  ", 12.0, _argb(0xFFFFFFFF), bold=True)
            badge.setBackground(_rounded(Theme.getColor(Theme.key_featuredStickers_addButton), 10))
            badge_params = LinearLayout.LayoutParams(WRAP, _dp(20))
            badge_params.leftMargin = _dp(10)
            header.addView(badge, badge_params)
        root.addView(header, LinearLayout.LayoutParams(MATCH, WRAP))

        if not items:
            empty = LinearLayout(context)
            empty.setOrientation(LinearLayout.VERTICAL)
            empty.setGravity(Gravity.CENTER)
            empty.setPadding(_dp(32), _dp(24), _dp(32), _dp(24))

            title = _text_view(context, tr("sheet_empty_title"), 17.0, text_color, bold=True)
            title.setGravity(Gravity.CENTER)
            title.setPadding(0, 0, 0, _dp(6))
            empty.addView(title, LinearLayout.LayoutParams(MATCH, WRAP))

            description = _text_view(context, tr("sheet_empty_desc"), 14.0, hint_color)
            description.setGravity(Gravity.CENTER)
            empty.addView(description, LinearLayout.LayoutParams(MATCH, WRAP))

            root.addView(empty, LinearLayout.LayoutParams(MATCH, WRAP))
            return root

        container = LinearLayout(context)
        container.setOrientation(LinearLayout.VERTICAL)
        for item in items:
            try:
                container.addView(self._build_card(context, item, thumb_jobs))
            except Exception:
                self.logger.exception("Could not build card for %s", item.get("id"))

        scroll = ScrollView(context)
        scroll.addView(container)
        root.addView(scroll, LinearLayout.LayoutParams(MATCH, WRAP))
        return root

    def _build_card(self, context: Any, item: Dict[str, Any], thumb_jobs: list) -> Any:
        story_id = item["id"]
        failed = item.get("status") == STATUS_FAILED
        text_color = Theme.getColor(Theme.key_dialogTextBlack)
        hint_color = Theme.getColor(Theme.key_dialogTextGray2)
        red_color = Theme.getColor(Theme.key_text_RedBold)

        card = LinearLayout(context)
        card.setOrientation(LinearLayout.HORIZONTAL)
        card.setGravity(Gravity.CENTER_VERTICAL)
        card.setBackground(_rounded(Theme.getColor(Theme.key_windowBackgroundWhite), 14, _argb(0x1A888888)))
        card.setPadding(_dp(10), _dp(10), _dp(10), _dp(10))
        card_params = LinearLayout.LayoutParams(MATCH, WRAP)
        card_params.setMargins(_dp(16), _dp(6), _dp(16), _dp(6))
        card.setLayoutParams(card_params)

        cover = FrameLayout(context)
        cover.setLayoutParams(LinearLayout.LayoutParams(_dp(THUMB_W_DP), _dp(THUMB_H_DP)))
        image = BackupImageView(context)
        image.setRoundRadius(_dp(12))
        image.setBackground(_rounded(_argb(0xFF333333), 12))
        cover.addView(image, FrameLayout.LayoutParams(MATCH, MATCH))
        thumb_jobs.append((image, item.get("media_path"), bool(item.get("is_video"))))

        if item.get("is_video"):
            play = _text_view(context, "\u25B6", 14.0, _argb(0xFFFFFFFF))
            play.setGravity(Gravity.CENTER)
            play.setBackground(_rounded(_argb(0x80000000), 16))
            play_params = FrameLayout.LayoutParams(_dp(32), _dp(32))
            play_params.gravity = Gravity.CENTER
            cover.addView(play, play_params)
        card.addView(cover)

        info = LinearLayout(context)
        info.setOrientation(LinearLayout.VERTICAL)
        info_params = LinearLayout.LayoutParams(0, WRAP, 1.0)
        info_params.leftMargin = _dp(12)
        info.setLayoutParams(info_params)

        target = _text_view(context, item.get("peer_title") or tr("my_profile"), 14.0, text_color, bold=True)
        target.setMaxLines(1)
        target.setEllipsize(TextUtils.TruncateAt.END)
        info.addView(target)

        when_text = tr("status_failed") if failed else _format_datetime(item.get("scheduled_at", 0))
        when_color = red_color if failed else Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4)
        when = _text_view(context, when_text, 14.5, when_color, bold=True)
        when.setPadding(0, _dp(2), 0, _dp(2))
        info.addView(when)

        caption = str(item.get("caption") or "").strip()
        if caption:
            caption_view = _text_view(context, caption, 12.5, hint_color)
            caption_view.setMaxLines(2)
            caption_view.setEllipsize(TextUtils.TruncateAt.END)
            info.addView(caption_view)

        actions = LinearLayout(context)
        actions.setOrientation(LinearLayout.HORIZONTAL)
        actions.setGravity(Gravity.CENTER_VERTICAL)
        actions.setPadding(0, _dp(8), 0, 0)

        publish = _text_view(
            context,
            tr("btn_retry") if failed else tr("btn_publish"),
            12.0,
            Theme.getColor(Theme.key_featuredStickers_buttonText),
            bold=True,
        )
        publish.setBackground(_rounded(Theme.getColor(Theme.key_featuredStickers_addButton), 14))
        publish.setPadding(_dp(12), _dp(6), _dp(12), _dp(6))
        publish.setOnClickListener(OnClickListener(lambda view: self._on_card_publish(story_id, failed)))
        actions.addView(publish)

        delete = _text_view(context, tr("btn_delete"), 12.0, red_color)
        delete.setPadding(_dp(10), _dp(6), _dp(10), _dp(6))
        delete.setOnClickListener(OnClickListener(lambda view: self._on_card_delete(story_id)))
        delete_params = LinearLayout.LayoutParams(WRAP, WRAP)
        delete_params.leftMargin = _dp(8)
        actions.addView(delete, delete_params)

        info.addView(actions)
        card.addView(info)
        return card

    def _on_card_publish(self, story_id: str, failed: bool):
        self._dismiss_sheet()
        if failed:
            self._retry_story(story_id)
        else:
            self._publish_story(story_id)

    def _on_card_delete(self, story_id: str):
        self._remove_story(story_id)
        BulletinHelper.show_info(tr("removed"))
        self._dismiss_sheet()
        self._open_stories_sheet()

    # ----- обложки --------------------------------------------------------

    def _load_thumbnails(self, jobs: List[Tuple[Any, Optional[str], bool]]):
        """Фоновая загрузка обложек, чтобы не блокировать UI."""
        for image_view, path, is_video in jobs:
            bitmap = self._decode_thumbnail(path, is_video)
            if bitmap is not None:
                run_on_ui_thread(lambda v=image_view, b=bitmap: v.setImageBitmap(b))

    def _decode_thumbnail(self, path: Optional[str], is_video: bool) -> Any:
        if not path or not os.path.exists(path):
            return None
        max_height = _dp(THUMB_H_DP) * 2
        try:
            if is_video:
                retriever = MediaMetadataRetriever()
                try:
                    retriever.setDataSource(path)
                    frame = retriever.getFrameAtTime(0)
                finally:
                    retriever.release()
                return self._fit_bitmap(frame, max_height) if frame is not None else None

            bounds = BitmapFactory.Options()
            bounds.inJustDecodeBounds = True
            BitmapFactory.decodeFile(path, bounds)
            sample = 1
            while bounds.outHeight // (sample * 2) >= max_height:
                sample *= 2
            options = BitmapFactory.Options()
            options.inSampleSize = sample
            return BitmapFactory.decodeFile(path, options)
        except Exception:
            self.logger.debug("Could not decode thumbnail for %s", path, exc_info=True)
            return None

    @staticmethod
    def _fit_bitmap(bitmap: Any, max_height: int) -> Any:
        """Уменьшает bitmap до max_height, сохраняя пропорции."""
        height = bitmap.getHeight()
        if height <= max_height:
            return bitmap
        width = max(1, int(bitmap.getWidth() * max_height / height))
        scaled = Bitmap.createScaledBitmap(bitmap, width, max_height, True)
        if scaled is not bitmap:
            bitmap.recycle()
        return scaled
