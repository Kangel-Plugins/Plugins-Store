def _client_lang():
    try:
        lc = find_class("org.telegram.messenger.LocaleController")
        if lc is not None:
            inst = lc.getInstance()
            if inst is not None:
                info = inst.getCurrentLocaleInfo()
                if info is not None and info.shortName:
                    code = str(info.shortName).lower()
                    if code.startswith("ru") or code.startswith("uk") or code.startswith("be"):
                        return "ru"
                    return "en"
    except Exception:
        pass
    try:
        code = str(Locale.getDefault().getLanguage()).lower()
        if code.startswith("ru") or code.startswith("uk") or code.startswith("be"):
            return "ru"
    except Exception:
        pass
    return "en"


def _tr(key):
    lang = _client_lang()
    return _TEXT.get(lang, _TEXT["en"]).get(key, _TEXT["en"].get(key, key))


def _log(msg, err=None):
    try:
        text = msg if err is None else "%s: %s" % (msg, err)
        jclass("android.util.Log").w(_TAG, text)
    except Exception:
        pass


def _get_app_context():
    try:
        al = find_class("org.telegram.messenger.ApplicationLoader")
        if al is not None and al.applicationContext is not None:
            return al.applicationContext
    except Exception:
        pass
    try:
        la = find_class("org.telegram.ui.LaunchActivity")
        if la is not None and la.instance is not None:
            return la.instance
    except Exception:
        pass
    return None


def _get_ui_context():
    try:
        la = find_class("org.telegram.ui.LaunchActivity")
        if la is not None and la.instance is not None:
            return la.instance
    except Exception:
        pass
    return _get_app_context()


def _sanitize_bank_id(raw):
    if not raw:
        return "stock"
    s = str(raw).strip().lower()
    if not s or len(s) > 48:
        return "stock"
    for ch in s:
        if not (("a" <= ch <= "z") or ("0" <= ch <= "9") or ch in ("_", "-")):
            return "stock"
    return s


def _read_config(plugin, overrides=None):
    def get(key, default):
        if overrides is not None and key in overrides:
            return overrides[key]
        return plugin.get_setting(key, default)

    bank_id = _sanitize_bank_id(get("bank_id", "stock"))
    return {
        "enabled": 1 if bool(get("enabled", True)) else 0,
        "bank_id": bank_id,
        "show_change_btn": 1 if bool(get("show_change_btn", True)) else 0,
        "show_payment_logo": 1 if bool(get("show_payment_logo", True)) else 0,
        "show_sparkles": 1 if bool(get("show_sparkles", True)) else 0,
        "show_sheen": 1 if bool(get("show_sheen", True)) else 0,
        "sync_enabled": 1 if bool(get("sync_enabled", True)) else 0,
    }


def _format_cfg_line(cfg):
    parts = []
    for k in sorted(cfg.keys()):
        parts.append("%s=%s" % (k, cfg[k]))
    return "cfg:" + ";".join(parts)


class _DexEngine:
    def __init__(self):
        self.bridge = None
        self.loader = None
        self.running = False
        self._last_cfg = None
        self._listener_ref = None
        self.last_error = ""

    def _err(self, msg, exc=None):
        text = msg if exc is None else "%s: %s" % (msg, exc)
        self.last_error = text
        _log(msg, exc)

    @staticmethod
    def _decode_dex():
        data = zlib.decompress(base64.b64decode(_DEX_DATA))
        if hashlib.sha1(data).hexdigest() != _DEX_SHA1:
            _log("embedded dex sha1 mismatch")
        return data

    @staticmethod
    def _decode_icon_tgs():
        data = base64.b64decode(_ICON_TGS_DATA)
        if hashlib.sha1(data).hexdigest() != _ICON_TGS_SHA1:
            _log("embedded icon sha1 mismatch")
            return None
        return data

    @staticmethod
    def _extract_icon_file(context):
        try:
            data = _DexEngine._decode_icon_tgs()
            if not data:
                return ""
            folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "wallet_bank_cards")
            path = os.path.join(folder, "icon-%s.tgs" % _ICON_TGS_SHA1[:10])
            if not os.path.exists(path) or os.path.getsize(path) != len(data):
                os.makedirs(folder, exist_ok=True)
                tmp = path + ".tmp"
                with open(tmp, "wb") as f:
                    f.write(data)
                os.replace(tmp, path)
            return path
        except Exception as e:
            _log("icon extract failed", e)
            return ""

    def _load_dex(self, ctx):
        dex_bytes = self._decode_dex()
        parent_loader = ctx.getClassLoader()

        try:
            cache_dir = os.path.join(str(ctx.getCodeCacheDir().getAbsolutePath()), "wbc_dex")
            os.makedirs(cache_dir, exist_ok=True)
            dex_path = os.path.join(cache_dir, "wbc_%s.dex" % _DEX_SHA1[:12])
            if not os.path.isfile(dex_path) or os.path.getsize(dex_path) != len(dex_bytes):
                tmp_path = dex_path + ".tmp"
                with open(tmp_path, "wb") as f:
                    f.write(dex_bytes)
                try:
                    os.chmod(tmp_path, 0o444)
                except Exception:
                    pass
                os.replace(tmp_path, dex_path)
            else:
                try:
                    os.chmod(dex_path, 0o444)
                except Exception:
                    pass
            DexClassLoader = jclass("dalvik.system.DexClassLoader")
            loader = DexClassLoader(dex_path, cache_dir, None, parent_loader)
            bridge = loader.loadClass(_ENGINE_CLASS)
            return loader, bridge
        except Exception as e:
            _log("file dex load failed, trying InMemoryDexClassLoader", e)

        ByteBuffer = jclass("java.nio.ByteBuffer")
        InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
        buf = ByteBuffer.wrap(dex_bytes)
        loader = InMemoryDexClassLoader(buf, parent_loader)
        bridge = loader.loadClass(_ENGINE_CLASS)
        return loader, bridge

    def start(self, cfg_line, on_java_change):
        if self.running and self.bridge is not None:
            self.push_config(cfg_line)
            return True

        ctx = _get_app_context()
        if ctx is None:
            self._err("no application context")
            return False

        try:
            self.loader, self.bridge = self._load_dex(ctx)
        except Exception as e:
            self._err("failed to load dex", e)
            return False

        try:
            icon_path = self._extract_icon_file(ctx)
            if icon_path:
                self._call_static("cmd", ["java.lang.String"], ["icon:" + icon_path])
            self._call_static("cmd", ["java.lang.String"], [cfg_line])
            self._last_cfg = cfg_line
            res = self._call_static("init", ["android.content.Context"], [ctx])
            self._attach_listener(on_java_change)
            self.running = True
            self.last_error = ""
            _log("engine started: %s" % res)
            return True
        except Exception as e:
            self._err("failed to init bridge", e)
            return False

    def _call_static(self, name, param_names, args):
        if self.bridge is None:
            return None
        Class = jclass("java.lang.Class")
        types = []
        for p in param_names:
            types.append(Class.forName(p))
        method = self.bridge.getMethod(name, types)
        return method.invoke(None, args)

    def _attach_listener(self, cb):
        if cb is None or _RunnableProxy is None or self.bridge is None:
            return
        try:
            proxy = _RunnableProxy(cb)
            self._listener_ref = proxy
            self._call_static("setChangeListener", ["java.lang.Runnable"], [proxy])
        except Exception as e:
            _log("attach listener failed", e)

    def push_config(self, cfg_line):
        if not self.running or self.bridge is None:
            return
        if cfg_line == self._last_cfg:
            return
        try:
            self._call_static("cmd", ["java.lang.String"], [cfg_line])
            self._last_cfg = cfg_line
        except Exception as e:
            _log("push_config failed", e)

    def dump_config(self):
        if not self.running or self.bridge is None:
            return ""
        try:
            res = self._call_static("cmd", ["java.lang.String"], ["dump"])
            return "" if res is None else str(res)
        except Exception:
            return ""

    def sync_now(self):
        if not self.running or self.bridge is None:
            return ""
        try:
            res = self._call_static("cmd", ["java.lang.String"], ["sync_now"])
            return "" if res is None else str(res)
        except Exception:
            return ""

    def sync_status(self):
        if not self.running or self.bridge is None:
            return {}
        out = {}
        try:
            res = self._call_static("cmd", ["java.lang.String"], ["sync_status"])
            s = "" if res is None else str(res)
            for part in s.split(";"):
                if "=" in part:
                    k, v = part.split("=", 1)
                    out[k.strip()] = v.strip()
        except Exception:
            pass
        return out

    def status_hooks(self):
        if not self.running or self.bridge is None:
            return 0
        try:
            res = self._call_static("cmd", ["java.lang.String"], ["status"])
            s = "" if res is None else str(res)
            for part in s.split(";"):
                if part.startswith("hooks="):
                    return int(part.split("=", 1)[1])
        except Exception:
            pass
        return 0

    def create_view(self, kind):
        if not self.running or self.bridge is None:
            return None
        ctx = _get_ui_context()
        if ctx is None:
            return None
        try:
            return self._call_static(
                "createView",
                ["android.content.Context", "java.lang.String"],
                [ctx, kind],
            )
        except Exception as e:
            _log("create_view failed", e)
            return None

    def refresh_view(self, view):
        if view is None or not self.running or self.bridge is None:
            return
        try:
            self._call_static("refreshView", ["android.view.View"], [view])
        except Exception:
            pass

    def stop(self):
        if self.bridge is not None:
            try:
                self._call_static("unload", [], [])
            except Exception as e:
                _log("unload failed", e)
        self._listener_ref = None
        self.running = False
        self.bridge = None
        self.loader = None
        self._last_cfg = None


class WalletBankCardsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._engine = _DexEngine()
        self._syncing = False
        self._preview_views = []

    def _set_setting_silent(self, key, value):
        try:
            self.set_setting(key, value, reload_settings=False)
        except Exception:
            try:
                self.set_setting(key, value)
            except Exception:
                pass

    def _sync_from_java(self):
        if self._syncing:
            return
        raw = self._engine.dump_config()
        if not raw:
            return
        self._syncing = True
        try:
            parsed = {}
            for item in raw.split(";"):
                if "=" in item:
                    k, v = item.split("=", 1)
                    parsed[k.strip()] = v.strip()
            if "bank_id" in parsed:
                bid = _sanitize_bank_id(parsed["bank_id"])
                self._set_setting_silent("bank_id", bid)
            for k in ("enabled", "show_change_btn", "show_payment_logo", "show_sparkles", "show_sheen", "sync_enabled"):
                if k in parsed:
                    self._set_setting_silent(k, parsed[k] == "1")
            self._engine._last_cfg = _format_cfg_line(_read_config(self))
            self._refresh_previews()
        except Exception as e:
            _log("sync_from_java failed", e)
        finally:
            self._syncing = False

    def _push(self, overrides=None):
        cfg = _read_config(self, overrides)
        self._engine.push_config(_format_cfg_line(cfg))
        self._refresh_previews()

    def _refresh_previews(self):
        alive = []
        for v in self._preview_views:
            if v is not None:
                self._engine.refresh_view(v)
                alive.append(v)
        self._preview_views = alive

    def _on_bool_change(self, key):
        def handler(val):
            self._push({key: bool(val)})
        return handler

    def _on_sync_now(self, *_args):
        self._engine.sync_now()
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_success(_tr("sync_now_toast"))
        except Exception:
            pass

    def _format_sync_subtext(self):
        st = self._engine.sync_status()
        mode = st.get("mode", "local")
        bot = st.get("bot", "exterawalletcardsbot")
        try:
            cached = int(st.get("cached", "0"))
        except Exception:
            cached = 0
        try:
            catalog_n = int(st.get("catalog", "0"))
        except Exception:
            catalog_n = 0
        if mode == "inline":
            label = _tr("sync_mode_inline")
        elif mode == "bot":
            label = _tr("sync_mode_bot")
        elif mode == "ready":
            label = _tr("sync_mode_ready") % bot
        else:
            label = _tr("sync_mode_local")
        return _tr("sync_sub_fmt") % (catalog_n, label, cached)

    def on_plugin_load(self):
        try:
            if _client_lang() == "en":
                self.description = _DESC_EN
        except Exception:
            pass
        cfg_line = _format_cfg_line(_read_config(self))
        self._engine.start(cfg_line, self._sync_from_java)

    def on_plugin_unload(self):
        self._preview_views = []
        self._engine.stop()

    def _make_preview_item(self, kind="preview"):
        if Custom is None:
            return None
        view = self._engine.create_view(kind)
        if view is None:
            return None
        self._preview_views.append(view)
        fields = getattr(Custom, "__dataclass_fields__", None)
        if fields is None or "view" in fields:
            try:
                return Custom(view=view)
            except Exception:
                pass
        if SimpleSettingFactory is not None:
            try:
                return Custom(view=SimpleSettingFactory(view))
            except Exception:
                pass
        try:
            return Custom(view=view)
        except Exception:
            return None

    def _create_design_subpage(self):
        if not self._engine.running:
            self._engine.start(_format_cfg_line(_read_config(self)), self._sync_from_java)
        items = []
        hero_item = self._make_preview_item("hero")
        if hero_item is not None:
            items.append(Header(text=_tr("sec_design_preview")))
            items.append(hero_item)
            items.append(Divider())

        items.extend([
            Header(text=_tr("sec_design_opts")),
            Switch(
                key="show_payment_logo",
                text=_tr("show_payment_logo"),
                subtext=_tr("show_payment_logo_sub"),
                default=True,
                on_change=self._on_bool_change("show_payment_logo"),
            ),
            Switch(
                key="show_sparkles",
                text=_tr("show_sparkles"),
                subtext=_tr("show_sparkles_sub"),
                default=True,
                on_change=self._on_bool_change("show_sparkles"),
            ),
            Switch(
                key="show_sheen",
                text=_tr("show_sheen"),
                subtext=_tr("show_sheen_sub"),
                default=True,
                on_change=self._on_bool_change("show_sheen"),
            ),
            Divider(text=_tr("design_note")),
            Divider(text=_tr("about") % __version__),
        ])
        return items

    def create_settings(self):
        if not self._engine.running:
            self._engine.start(_format_cfg_line(_read_config(self)), self._sync_from_java)

        self._preview_views = []
        items = []

        preview_item = self._make_preview_item("preview")
        if preview_item is not None:
            items.append(Header(text=_tr("sec_preview")))
            items.append(preview_item)
            items.append(Divider())

        items.extend([
            Header(text=_tr("sec_main")),
            Switch(
                key="enabled",
                text=_tr("enabled"),
                subtext=_tr("enabled_sub"),
                default=True,
                on_change=self._on_bool_change("enabled"),
            ),
            Switch(
                key="show_change_btn",
                text=_tr("show_change_btn"),
                subtext=_tr("show_change_btn_sub"),
                default=True,
                on_change=self._on_bool_change("show_change_btn"),
            ),
        ])

        try:
            items.append(
                Text(
                    text=_tr("design_row"),
                    subtext=_tr("design_row_sub"),
                    icon="msg_customize",
                    create_sub_fragment=self._create_design_subpage,
                )
            )
        except Exception:
            items.append(
                Text(
                    text=_tr("design_row"),
                    create_sub_fragment=self._create_design_subpage,
                )
            )

        items.extend([
            Divider(),
            Header(text=_tr("sec_sync")),
            Switch(
                key="sync_enabled",
                text=_tr("sync_enabled"),
                subtext=_tr("sync_enabled_sub"),
                default=True,
                on_change=self._on_bool_change("sync_enabled"),
            ),
        ])
        sync_sub = self._format_sync_subtext()
        try:
            items.append(
                Text(
                    text=_tr("sync_now"),
                    subtext=sync_sub,
                    icon="msg_retry",
                    on_click=self._on_sync_now,
                )
            )
        except Exception:
            try:
                items.append(
                    Text(
                        text=_tr("sync_now"),
                        subtext=sync_sub,
                        on_click=self._on_sync_now,
                    )
                )
            except Exception:
                items.append(
                    Text(
                        text=_tr("sync_now"),
                        subtext=sync_sub,
                    )
                )
        items.append(Divider(text=_tr("note")))

        hooks = self._engine.status_hooks()
        if self._engine.running and hooks > 0:
            status_line = _tr("status_ok") % hooks
        elif self._engine.last_error:
            status_line = "%s: %s" % (_tr("status_err"), self._engine.last_error)
        else:
            status_line = _tr("status_err")
        items.append(Divider(text="%s  •  %s" % (_tr("about") % __version__, status_line)))
        return items


