__id__ = "fish_audio_integration"
__name__ = "Fish Audio Integration"
__description__ = (
    "Озвучка сообщений голосами Fish Audio прямо из поля ввода: напишите «.v текст» — и вместо текста "
    "уйдёт голосовое.\n\n"
    "**Возможности:**\n"
    "• избранные голоса с именами и своими командами (.v, .vm, …);\n"
    "• ИИ-режиссёр через OpenRouter расставляет эмоции и звуки: добавьте «t» к команде (.vt, .vmt);\n"
    "• .v без текста в ответ на сообщение озвучит текст этого сообщения;\n"
    "• префикс, команды и суффикс ИИ настраиваются.\n\n"
    "**Настройка:** вставьте API-ключ Fish Audio и добавьте голос (ID или ссылку с fish.audio)."
)
__author__ = "@kovidoff"
__version__ = "1.1.0"
__icon__ = "fish_audio_integration_by_niko_ocbot/0"
__category__ = ["integrations", "chats"]
__app_version__ = ">=13.1.1"
__sdk_version__ = ">=1.4.3.3"

