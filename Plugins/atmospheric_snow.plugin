def _signed_jint(val: int) -> int:
    val &= 0xFFFFFFFF
    if val >= 0x80000000:
        val -= 0x100000000
    return val


def _argb(a: int, r: int, g: int, b: int) -> int:
    return _signed_jint(((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF))


class Snowflake:
    __slots__ = (
        "x",
        "y",
        "layer",
        "radius",
        "speed_y",
        "sway_amp",
        "sway_freq",
        "phase",
        "phase2",
        "alpha",
        "angle",
        "spin",
        "twinkle_phase",
        "twinkle_speed",
        "variant",
        "is_crystal",
    )

    def __init__(self, width: float, height: float, density_px: float, random_y: bool = True):
        self.reset(width, height, density_px, random_y=random_y)

    def reset(self, width: float, height: float, density_px: float, random_y: bool = False):
        roll = random.random()
        if roll < 0.48:
            self.layer = 0
            self.radius = random.uniform(2.2, 4.0) * density_px
            self.speed_y = random.uniform(20.0, 36.0) * density_px
            self.sway_amp = random.uniform(5.0, 11.0) * density_px
            self.sway_freq = random.uniform(0.6, 1.2)
            self.alpha = random.randint(85, 145)
            self.is_crystal = False
        elif roll < 0.82:
            self.layer = 1
            self.radius = random.uniform(4.2, 6.8) * density_px
            self.speed_y = random.uniform(40.0, 66.0) * density_px
            self.sway_amp = random.uniform(10.0, 19.0) * density_px
            self.sway_freq = random.uniform(0.8, 1.55)
            self.alpha = random.randint(135, 200)
            self.is_crystal = random.random() < 0.50
        else:
            self.layer = 2
            self.radius = random.uniform(7.5, 12.0) * density_px
            self.speed_y = random.uniform(68.0, 102.0) * density_px
            self.sway_amp = random.uniform(15.0, 28.0) * density_px
            self.sway_freq = random.uniform(1.0, 1.8)
            self.alpha = random.randint(170, 235)
            self.is_crystal = True

        self.x = random.uniform(-28.0 * density_px, width + 28.0 * density_px)
        if random_y:
            self.y = random.uniform(0.0, height)
        else:
            self.y = random.uniform(-32.0 * density_px, -6.0 * density_px)

        self.phase = random.uniform(0.0, math.tau)
        self.phase2 = random.uniform(0.0, math.tau)
        self.angle = random.uniform(0.0, 360.0)
        self.spin = random.uniform(-38.0, 38.0)
        self.twinkle_phase = random.uniform(0.0, math.tau)
        self.twinkle_speed = random.uniform(1.5, 3.2)
        self.variant = random.randint(0, 2)


class DispatchDrawHook(MethodHook):
    def __init__(self, plugin: "AtmosphericSnowPlugin"):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._on_dispatch_draw(param.thisObject, param.args[0])
        except Exception as e:
            self.plugin._last_error = f"draw: {e}"
            if not self.plugin._draw_error_logged:
                self.plugin._draw_error_logged = True
                log(f"[NewYearInterface] Draw error: {e}")


class NavbarDispatchDrawHook(MethodHook):
    def __init__(self, plugin: "AtmosphericSnowPlugin"):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin._on_navbar_before_draw(param.thisObject, param.args[0])
        except Exception as e:
            self.plugin._last_error = f"nav_pre: {e}"

    def after_hooked_method(self, param):
        try:
            self.plugin._on_navbar_after_draw(param.thisObject, param.args[0])
        except Exception as e:
            self.plugin._last_error = f"nav_post: {e}"


class BlurredDrawHook(MethodHook):
