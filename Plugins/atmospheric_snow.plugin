            Header(text="Основные настройки"),
            Switch(
                key="snow_enabled",
                text="Включить снег",
                subtext="Отображает падающий снег поверх интерфейса",
                default=True,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="snow_area",
                text="Где показывать",
                items=["Везде", "Только в чатах", "Список чатов и чаты"],
                default=0,
                on_change=self._on_setting_change,
            ),
            Divider(),
            Header(text="Новогоднее оформление интерфейса"),
            Switch(
                key="navbar_festive_enabled",
                text="Нижняя панель",
                subtext="Сугробы, гирлянда и морозное свечение на главной панели",
                default=True,
                on_change=self._on_setting_change,
            ),
            Switch(
                key="glass_pills_enabled",
                text="Кнопки, папки, ввод и шапка",
                subtext="Кнопки (←, поиск, меню), поле сообщения, папки и вкладки профиля",
                default=True,
                on_change=self._on_setting_change,
            ),
            Switch(
                key="profile_festive_enabled",
                text="Профиль: кнопки, аватар и окна",
                subtext="Обводка аватара, 3 больших кнопок и всех карточек профиля",
                default=True,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="navbar_style",
                text="Новогодний стиль кнопок и панели",
                items=[
                    "Снежная шапка + гирлянда",
                    "Морозная (лёд и сосульки)",
                    "Тёплая гирлянда",
                    "Северное сияние и искры",
                ],
                default=0,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="navbar_garland_palette",
                text="Цвета гирлянды",
                items=["Новогоднее ассорти", "Тёплое золото", "Ледяной неон"],
                default=0,
                on_change=self._on_setting_change,
            ),
            Switch(
                key="navbar_active_glow",
                text="Сияние и морозные искры",
                subtext="Подсвечивает активную вкладку и добавляет искры на кнопки",
                default=True,
                on_change=self._on_setting_change,
            ),
            Divider(),
            Header(text="Атмосфера и физика снега"),
            Selector(
                key="snow_density",
                text="Плотность снегопада",
                items=["Лёгкий", "Средний", "Сильный"],
                default=1,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="snow_speed",
                text="Скорость падения",
                items=["Медленно", "Обычно", "Быстро"],
                default=1,
                on_change=self._on_physics_change,
            ),
            Selector(
                key="snow_wind",
                text="Ветер",
                items=["Штиль", "Лёгкий бриз", "Метель"],
                default=1,
                on_change=self._on_physics_change,
            ),
            Divider(),
            Header(text="Внешний вид снега"),
            Selector(
                key="snow_style",
                text="Стиль снежинок",
                items=["Боке (мягкое свечение)", "Снежинки", "Смешанный"],
                default=0,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="snow_size",
                text="Размер частиц и снежинок",
                items=[
                    "Очень мелкий (45%)",
                    "Мелкий (70%)",
                    "Обычный (100%)",
                    "Крупный (135%)",
                    "Очень крупный (175%)",
                ],
                default=2,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="snow_opacity",
                text="Прозрачность снега",
                items=[
                    "Едва заметный (25%)",
                    "Полупрозрачный (50%)",
                    "Мягкий (75%)",
                    "Обычный (100%)",
                    "Яркий (135%)",
                ],
                default=3,
                on_change=self._on_setting_change,
            ),
            Selector(
                key="snow_color",
                text="Цвет снега",
                items=[
                    "Авто (по теме)",
                    "Белый",
                    "Ледяной голубой",
                    "Тёплый новогодний",
                ],
                default=0,
                on_change=self._on_setting_change,
            ),
            Divider(),
            Text(
                text=f"NewYear Interface v{__version__}",
                subtext="Новогоднее оформление интерфейса",
            ),
        ]
        if self._last_error != "нет":
            items.append(
                Text(
                    text="Ошибка",
                    subtext=str(self._last_error)[:120],
                )
            )
        return items
