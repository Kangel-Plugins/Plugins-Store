    def on_plugin_load(self):
        self._draw_error_logged = False
        self._last_error = "нет"
        self._frame_counter = 0
        self._glass_calls = 0
        self._view_calls = 0
        self._cfg_ts = 0.0
        self._last_time = time.monotonic()
        self._clock_last_time = self._last_time
        self._nav_cache_key = None
        self._nav_geom = None
        self._glass_cache.clear()
        self._strip_cache.clear()
        self._avatar_cache.clear()
        self._pa_ava_native_ok = False
        self._glass_last_inval.clear()
        self._tabs_last_draw.clear()
        self._navbar_bg_ids.clear()
        self._handled_bg_ids.clear()
        self._ignored_bg_ids.clear()
        self._pa_handled_ids.clear()
        self._pa_ref_sizes.clear()
        self._layout_draw_ready_ids.clear()
        self._fields_cache.clear()
        self._ab_extra_fields = None
        self._profile_rv_cache.clear()
        self._rv_meta_cache.clear()
        self._rv_child_skip_cache.clear()
        self._backup_views_cache = (0.0, None, None)
        self._backup_frag_cache = (0.0, None)
        self._last_prof_actions_draw_t = 0.0
        self._last_prof_avatar_draw_t = 0.0
        self._last_prof_actions_hook_t = 0.0
        self._last_prof_avatar_hook_t = 0.0
        self._sync_settings_cache(force=True)
        self._init_graphics()
        hooked = self._install_hooks()
        self._install_navbar_hook()
        self._install_view_glass_hooks()
        self._install_glass_pills_hook()
        if not hooked:
            log(f"[NewYearInterface] Hook failed: {self._hook_status}")
            try:
                BulletinHelper.show_error(f"NewYear Interface: {self._hook_status}")
            except Exception:
                pass
        else:
            self._refresh_screen()

    def on_plugin_unload(self):
        for h in self._hooks:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks.clear()
        self._flakes.clear()
        self._recycle_bitmaps()
        self._color_filters.clear()
        self._nav_cache_key = None
        self._nav_geom = None
        self._glass_cache.clear()
        self._strip_cache.clear()
        self._avatar_cache.clear()
        self._pa_ava_native_ok = False
        self._glass_last_inval.clear()
        self._tabs_last_draw.clear()
        self._navbar_bg_ids.clear()
        self._handled_bg_ids.clear()
        self._ignored_bg_ids.clear()
        self._pa_handled_ids.clear()
        self._pa_ref_sizes.clear()
        self._layout_draw_ready_ids.clear()
        self._fields_cache.clear()
        self._ab_extra_fields = None
        self._profile_rv_cache.clear()
        self._rv_meta_cache.clear()
        self._rv_child_skip_cache.clear()
        self._backup_views_cache = (0.0, None, None)
        self._backup_frag_cache = (0.0, None)
        self._last_prof_actions_draw_t = 0.0
        self._last_prof_avatar_draw_t = 0.0
        self._last_prof_actions_hook_t = 0.0
        self._last_prof_avatar_hook_t = 0.0
        self._path_pill_tmp = None
        self._refresh_screen()
        self._last_layout = None
        self._last_navbar = None
        self._hook_status = "выгружен"
        self._navbar_hook_status = "выгружен"
        self._view_glass_status = "выгружен"
        self._glass_hook_status = "выгружен"

    def _recycle_geom_bmps(self, geom: Optional[Dict[str, Any]]):
        if not geom:
            return
        for k in ("static_bmp", "top_bmp", "bot_bmp"):
            bmp = geom.get(k)
            if bmp is not None:
                try:
                    bmp.recycle()
                except Exception:
                    pass
                geom[k] = None

    def _recycle_bitmaps(self):
        self._recycle_geom_bmps(self._nav_geom)
        for g in self._glass_cache.values():
            self._recycle_geom_bmps(g)
        for g in self._avatar_cache.values():
            self._recycle_geom_bmps(g)
        for strip in self._strip_cache.values():
            if strip and len(strip) >= 4:
                for b in (strip[0], strip[3]):
                    if b is not None:
                        try:
                            b.recycle()
                        except Exception:
                            pass
        for bmp in [self._bmp_bokeh, self._bmp_grain, self._bmp_sparkle, *self._bmp_crystals, *self._bulb_sprites.values()]:
            if bmp is not None:
                try:
                    bmp.recycle()
                except Exception:
                    pass
        self._bmp_bokeh = None
        self._bmp_grain = None
        self._bmp_sparkle = None
        self._bmp_crystals = []
        self._bulb_sprites.clear()
        self._glass_cache.clear()
        self._strip_cache.clear()
        self._avatar_cache.clear()
        self._nav_geom = None
        self._nav_cache_key = None

    def _create_radial_sprite(
        self,
        size: int,
        alphas_and_stops: List[Tuple[int, float]],
        Bitmap: Any,
        BitmapConfig: Any,
        Canvas: Any,
        Paint: Any,
        RadialGradient: Any,
        TileMode: Any,
    ) -> Any:
        bmp = Bitmap.createBitmap(size, size, BitmapConfig.ARGB_8888)
        c = Canvas(bmp)
        half = size * 0.5
        colors = jarray(jint)([_argb(a, 255, 255, 255) for a, _ in alphas_and_stops])
        stops = jarray(jfloat)([s for _, s in alphas_and_stops])
        grad = RadialGradient(half, half, half, colors, stops, TileMode.CLAMP)
        p = Paint(1)
        p.setShader(grad)
        c.drawCircle(half, half, half, p)
        return bmp

    def _draw_crystal_arm(self, canvas: Any, cx: float, cy: float, angle_rad: float, arm_len: float, variant: int, paint: Any):
        ca = math.cos(angle_rad)
        sa = math.sin(angle_rad)
        ex = cx + ca * arm_len
        ey = cy + sa * arm_len
        canvas.drawLine(cx, cy, ex, ey, paint)

        if variant == 0:
            branches = ((0.38, 0.24, 0.92), (0.64, 0.21, 0.90), (0.84, 0.11, 0.85))
        elif variant == 1:
            branches = ((0.30, 0.16, 1.00), (0.50, 0.27, 0.92), (0.70, 0.19, 0.88), (0.87, 0.10, 0.82))
        else:
            branches = ((0.44, 0.23, 1.02), (0.76, 0.18, 0.86))

        for pos_ratio, len_ratio, branch_ang in branches:
            bx = cx + ca * (arm_len * pos_ratio)
            by = cy + sa * (arm_len * pos_ratio)
            blen = arm_len * len_ratio
            for sign in (-1.0, 1.0):
                ang = angle_rad + sign * branch_ang
                canvas.drawLine(bx, by, bx + math.cos(ang) * blen, by + math.sin(ang) * blen, paint)

    def _create_crystal_sprite(
        self,
        size: int,
        variant: int,
        Bitmap: Any,
        BitmapConfig: Any,
        Canvas: Any,
        Paint: Any,
        PaintStyle: Any,
        PaintCap: Any,
        RadialGradient: Any,
        TileMode: Any,
    ) -> Any:
        bmp = Bitmap.createBitmap(size, size, BitmapConfig.ARGB_8888)
        c = Canvas(bmp)
        half = size * 0.5

        glow_colors = jarray(jint)([
            _argb(58, 255, 255, 255),
            _argb(26, 255, 255, 255),
            _argb(7, 255, 255, 255),
            _argb(0, 255, 255, 255),
        ])
        glow_stops = jarray(jfloat)([0.0, 0.35, 0.72, 1.0])
        glow_paint = Paint(1)
        glow_paint.setShader(RadialGradient(half, half, half, glow_colors, glow_stops, TileMode.CLAMP))
        c.drawCircle(half, half, half, glow_paint)

        arm_len = size * 0.40

        bloom_paint = Paint(1)
        bloom_paint.setStyle(PaintStyle.STROKE)
        bloom_paint.setStrokeCap(PaintCap.ROUND)
        bloom_paint.setARGB(65, 255, 255, 255)
        bloom_paint.setStrokeWidth(size * 0.062)

        core_paint = Paint(1)
        core_paint.setStyle(PaintStyle.STROKE)
        core_paint.setStrokeCap(PaintCap.ROUND)
        core_paint.setARGB(245, 255, 255, 255)
        core_paint.setStrokeWidth(size * 0.025)

        for paint in (bloom_paint, core_paint):
            for i in range(6):
                ang = i * (math.pi / 3.0)
                self._draw_crystal_arm(c, half, half, ang, arm_len, variant, paint)

            ring_r = arm_len * (0.26 if variant != 2 else 0.34)
            for i in range(6):
                a1 = i * (math.pi / 3.0)
                a2 = (i + 1) * (math.pi / 3.0)
                c.drawLine(
                    half + math.cos(a1) * ring_r,
                    half + math.sin(a1) * ring_r,
                    half + math.cos(a2) * ring_r,
                    half + math.sin(a2) * ring_r,
                    paint,
                )

        center_paint = Paint(1)
        center_paint.setStyle(PaintStyle.FILL)
        center_paint.setARGB(255, 255, 255, 255)
        c.drawCircle(half, half, size * 0.026, center_paint)
        return bmp

    def _init_graphics(self):
        try:
            self._recycle_bitmaps()
            self._color_filters.clear()

            Paint = jclass("android.graphics.Paint")
            Bitmap = jclass("android.graphics.Bitmap")
            Canvas = jclass("android.graphics.Canvas")
            RadialGradient = jclass("android.graphics.RadialGradient")
            RectF = jclass("android.graphics.RectF")
            self._bmp_cls = Bitmap
            self._canvas_cls = Canvas
            self._path_cls = jclass("android.graphics.Path")
            self._path_pill_tmp = self._path_cls()
            self._loc_layout = jarray(jint)([0, 0])
            self._loc_target = jarray(jint)([0, 0])
            self._linear_gradient_cls = jclass("android.graphics.LinearGradient")
            self._lighting_filter_cls = jclass("android.graphics.LightingColorFilter")

            try:
                PaintStyle = Paint.Style
                PaintCap = Paint.Cap
            except Exception:
                PaintStyle = jclass("android.graphics.Paint$Style")
                PaintCap = jclass("android.graphics.Paint$Cap")

            try:
                BitmapConfig = Bitmap.Config
            except Exception:
                BitmapConfig = jclass("android.graphics.Bitmap$Config")
            self._bmp_cfg_argb = BitmapConfig.ARGB_8888

            try:
                TileMode = jclass("android.graphics.Shader$TileMode")
            except Exception:
                TileMode = jclass("android.graphics.Shader").TileMode
            self._tile_clamp = TileMode.CLAMP

            self._paint_bmp = Paint(3)  # ANTI_ALIAS_FLAG | FILTER_BITMAP_FLAG
            self._paint_fill = Paint(1)
            self._paint_fill.setStyle(PaintStyle.FILL)
            self._paint_stroke = Paint(1)
            self._paint_stroke.setStyle(PaintStyle.STROKE)
            self._paint_stroke.setStrokeCap(PaintCap.ROUND)

            self._rect_dst = RectF()
            self._rect_crystal = RectF()
            self._rect_pill = RectF()
            self._rect_glass = RectF()
            self._rect_tab = RectF()
            self._rect_avatar = RectF()

            self._bmp_bokeh = self._create_radial_sprite(
                96,
                [
                    (255, 0.00),
                    (230, 0.14),
                    (155, 0.30),
                    (78, 0.50),
                    (28, 0.70),
                    (7, 0.87),
                    (0, 1.00),
                ],
                Bitmap, BitmapConfig, Canvas, Paint, RadialGradient, TileMode,
            )

            self._bmp_grain = self._create_radial_sprite(
                64,
                [
                    (255, 0.00),
                    (245, 0.24),
                    (180, 0.44),
                    (72, 0.66),
                    (16, 0.84),
                    (0, 1.00),
                ],
                Bitmap, BitmapConfig, Canvas, Paint, RadialGradient, TileMode,
            )

            self._bmp_crystals = [
                self._create_crystal_sprite(
                    128, v, Bitmap, BitmapConfig, Canvas, Paint, PaintStyle, PaintCap, RadialGradient, TileMode
                )
                for v in range(3)
            ]

            if self._bmp_bokeh is not None:
                sz = 64
                half = sz * 0.5
                core_r = half * 0.275
                dst_r = RectF(0.0, 0.0, float(sz), float(sz))
                p_b = Paint(3)
                p_f = Paint(1)
                p_f.setStyle(PaintStyle.FILL)
                for pal in GARLAND_PALETTES:
                    for rgb in pal:
                        if rgb in self._bulb_sprites:
                            continue
                        r, g, b = rgb
                        sbmp = Bitmap.createBitmap(sz, sz, BitmapConfig.ARGB_8888)
                        scnv = Canvas(sbmp)
                        p_b.setColorFilter(self._get_color_filter(rgb))
                        p_b.setAlpha(185)
                        scnv.drawBitmap(self._bmp_bokeh, None, dst_r, p_b)
                        p_f.setARGB(235, r, g, b)
                        scnv.drawCircle(half, half, core_r, p_f)
                        p_f.setARGB(220, 255, 255, 255)
                        scnv.drawCircle(half, half, core_r * 0.45, p_f)
                        self._bulb_sprites[rgb] = sbmp

            try:
                sp_sz = 32
                sp_half = sp_sz * 0.5
                sp_arm = sp_sz * 0.42
                sp_d = sp_arm * 0.55
                sp_bmp = Bitmap.createBitmap(sp_sz, sp_sz, BitmapConfig.ARGB_8888)
                sp_cnv = Canvas(sp_bmp)
                sp_p = Paint(1)
                sp_p.setStyle(PaintStyle.STROKE)
                sp_p.setStrokeCap(PaintCap.ROUND)
                sp_p.setARGB(255, 255, 255, 255)
                sp_p.setStrokeWidth(max(1.0, sp_arm * 0.22))
                sp_cnv.drawLine(sp_half - sp_arm, sp_half, sp_half + sp_arm, sp_half, sp_p)
                sp_cnv.drawLine(sp_half, sp_half - sp_arm, sp_half, sp_half + sp_arm, sp_p)
                sp_p.setARGB(166, 255, 255, 255)
                sp_cnv.drawLine(sp_half - sp_d, sp_half - sp_d, sp_half + sp_d, sp_half + sp_d, sp_p)
                sp_cnv.drawLine(sp_half - sp_d, sp_half + sp_d, sp_half + sp_d, sp_half - sp_d, sp_p)
                self._bmp_sparkle = sp_bmp
            except Exception:
                self._bmp_sparkle = None

            try:
                self._theme_jcls = jclass("org.telegram.ui.ActionBar.Theme")
                self._update_theme_state()
            except Exception:
                self._theme_jcls = None

            try:
                self._system_jcls = jclass("java.lang.System")
                self._view_jcls = jclass("android.view.View")
                self._vg_jcls = jclass("android.view.ViewGroup")
                self._main_tabs_jcls = find_class("org.telegram.ui.MainTabsLayout")
            except Exception:
                pass

            try:
                Resources = jclass("android.content.res.Resources")
                metrics = Resources.getSystem().getDisplayMetrics()
                if metrics is not None and metrics.density > 0:
                    self._density_px = float(metrics.density)
            except Exception:
                pass
        except Exception as e:
            self._last_error = f"gfx: {e}"
            log(f"[NewYearInterface] Failed to init graphics objects: {e}")

    def _try_hook_dispatch_draw(self, target_cls: Any, canvas_cls: Any, hook: MethodHook) -> str:
        if target_cls is None:
            return "class=None"

        errors = []
        cls_candidates = [target_cls]
        try:
            cls_candidates.append(target_cls.getClass())
        except Exception:
            pass

        arg_candidates = []
        if canvas_cls is not None:
            arg_candidates.append(canvas_cls)
            try:
                arg_candidates.append(canvas_cls.getClass())
            except Exception:
                pass

        for cls_obj in cls_candidates:
            for arg_obj in arg_candidates:
                try:
                    method = cls_obj.getDeclaredMethod("dispatchDraw", arg_obj)
                    method.setAccessible(True)
                    unhook = self.hook_method(method, hook)
                    if unhook is not None:
                        self._hooks.append(unhook)
                        return "OK"
                except Exception as e:
                    errors.append(str(e))

        try:
            for m in target_cls.getDeclaredMethods():
                if str(m.getName()) == "dispatchDraw":
                    m.setAccessible(True)
                    unhook = self.hook_method(m, hook)
                    if unhook is not None:
                        self._hooks.append(unhook)
                        return "OK"
        except Exception as e:
            errors.append(f"scan:{e}")

        try:
            unhooks = self.hook_all_methods(target_cls, "dispatchDraw", hook)
            if unhooks:
                self._hooks.extend(unhooks)
                return "OK"
        except Exception as e:
            errors.append(f"all:{e}")

        return errors[-1] if errors else "no method"

    def _install_hooks(self) -> bool:
        hook = DispatchDrawHook(self)
        canvas_cls = find_class("android.graphics.Canvas")

        last_err = "не найдено"
        for class_name in (
            "org.telegram.ui.ActionBar.DrawerLayoutContainer",
            "org.telegram.ui.ActionBar.ActionBarLayout",
        ):
            try:
                target_cls = find_class(class_name)
                res = self._try_hook_dispatch_draw(target_cls, canvas_cls, hook)
                if res.startswith("OK"):
                    self._hook_status = f"{class_name.split('.')[-1]} {res}"
                    return True
                last_err = f"{class_name.split('.')[-1]}: {res}"
            except Exception as e:
                last_err = f"{class_name.split('.')[-1]}: {e}"

        self._hook_status = last_err
        return False

    def _install_navbar_hook(self):
        try:
            canvas_cls = find_class("android.graphics.Canvas")
            nav_cls = self._main_tabs_jcls or find_class("org.telegram.ui.MainTabsLayout")
            if nav_cls is None:
                self._navbar_hook_status = "MainTabsLayout не найден"
                return
            res = self._try_hook_dispatch_draw(nav_cls, canvas_cls, NavbarDispatchDrawHook(self))
            self._navbar_hook_status = f"MainTabsLayout {res}"
        except Exception as e:
            self._navbar_hook_status = f"err: {e}"

    def _install_view_glass_hooks(self):
        try:
            canvas_cls = find_class("android.graphics.Canvas")
            ok_labels: List[str] = []

            for label, cls_name, mode in (
                ("AB", "org.telegram.ui.ActionBar.ActionBar", "actionbar"),
                ("Tab", "org.telegram.ui.Components.FilterTabsView", "filters"),
                ("Src", "org.telegram.ui.Components.FragmentSearchField", "search"),
                ("In", "org.telegram.ui.Components.chat.ChatInputViewsContainer", "chatinput"),
            ):
                try:
                    cls_obj = find_class(cls_name)
                    if cls_obj is None:
                        continue
                    res = self._try_hook_dispatch_draw(cls_obj, canvas_cls, ViewPillHook(self, mode))
                    if res.startswith("OK"):
                        ok_labels.append(label)
                except Exception:
                    pass

            try:
                tabs_cls = find_class("org.telegram.ui.Components.ViewPagerFixed$TabsView")
                view_cls = self._view_jcls or find_class("android.view.View")
                long_cls = jclass("java.lang.Long").TYPE
                if tabs_cls is not None:
                    hook = TabsDrawChildHook(self)
                    hooked_tabs = False
                    if canvas_cls is not None and view_cls is not None:
                        try:
                            m = tabs_cls.getDeclaredMethod("drawChild", canvas_cls, view_cls, long_cls)
                            m.setAccessible(True)
                            u = self.hook_method(m, hook)
                            if u is not None:
                                self._hooks.append(u)
                                hooked_tabs = True
                        except Exception:
                            pass
                    if not hooked_tabs:
                        try:
                            for m in tabs_cls.getDeclaredMethods():
                                if str(m.getName()) == "drawChild":
                                    m.setAccessible(True)
                                    u = self.hook_method(m, hook)
                                    if u is not None:
                                        self._hooks.append(u)
                                        hooked_tabs = True
                                        break
                        except Exception:
                            pass
                    if not hooked_tabs:
                        try:
                            unhooks = self.hook_all_methods(tabs_cls, "drawChild", hook)
                            if unhooks:
                                self._hooks.extend(unhooks)
                                hooked_tabs = True
                        except Exception:
                            pass
                    if hooked_tabs:
                        ok_labels.append("PT")
            except Exception:
                pass

            # Кнопки профиля (Выбрать фото / Изменить / Настройки)
            try:
                pa_cls = find_class("org.telegram.ui.Components.ProfileActionsView")
                self._pa_jcls = pa_cls
                res = self._try_hook_declared_draw(pa_cls, canvas_cls, ViewPillHook(self, "profile_actions"), "onDraw")
                if res == "OK":
                    ok_labels.append("Prf")
            except Exception:
                pass

            # Круглая аватарка профиля
            try:
                ava_cls = find_class("org.telegram.ui.ProfileActivity$AvatarImageView")
                self._ava_jcls = ava_cls
                res = self._try_hook_declared_draw(ava_cls, canvas_cls, ViewPillHook(self, "profile_avatar"), "onDraw")
                if res == "OK":
                    ok_labels.append("Ava")
            except Exception:
                pass

            # Окна-секции профиля (через dispatchDraw RecyclerListView — как у остальных кнопок)
            try:
                rlv_cls = find_class("org.telegram.ui.Components.RecyclerListView")
                self._rlv_jcls = rlv_cls
                if rlv_cls is not None:
                    res = self._try_hook_dispatch_draw(rlv_cls, canvas_cls, ViewPillHook(self, "recycler"))
                    if res.startswith("OK"):
                        ok_labels.append("Sec")
            except Exception:
                pass

            self._pa_ava_native_ok = ("Prf" in ok_labels and "Ava" in ok_labels)
            self._view_glass_status = "+".join(ok_labels) if ok_labels else "нет"
        except Exception as e:
            self._view_glass_status = f"err:{e}"

    def _try_hook_declared_draw(
        self,
        target_cls: Any,
        canvas_cls: Any,
        hook: MethodHook,
        method_name: str = "draw",
    ) -> Optional[str]:
        if target_cls is None:
            return None
        last_err = None
        if canvas_cls is not None:
            try:
                method = target_cls.getDeclaredMethod(method_name, canvas_cls)
                method.setAccessible(True)
                unhook = self.hook_method(method, hook)
                if unhook is not None:
                    self._hooks.append(unhook)
                    return "OK"
            except Exception as e:
                last_err = str(e)
        try:
            for m in target_cls.getDeclaredMethods():
                if str(m.getName()) == method_name and len(m.getParameterTypes()) == 1:
                    m.setAccessible(True)
                    unhook = self.hook_method(m, hook)
                    if unhook is not None:
                        self._hooks.append(unhook)
                        return "OK"
        except Exception as e:
            last_err = str(e)
        try:
            unhooks = self.hook_all_methods(target_cls, method_name, hook)
            if unhooks:
                self._hooks.extend(unhooks)
                return "OK"
        except Exception as e:
            last_err = str(e)
        return f"err:{last_err}" if last_err else None

    def _install_glass_pills_hook(self):
        try:
            canvas_cls = find_class("android.graphics.Canvas")
            hook = BlurredDrawHook(self)
            targets = (
                ("RN", "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawableRenderNode"),
                ("Src", "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawableSource"),
                ("Base", "org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable"),
            )
            hooked_names: List[str] = []
            errors: List[str] = []

            for label, cls_name in targets:
                cls_obj = find_class(cls_name)
                if cls_obj is None:
                    continue
                res = self._try_hook_declared_draw(cls_obj, canvas_cls, hook)
                if res == "OK":
                    hooked_names.append(label)
                elif res:
                    errors.append(f"{label}:{res}")

            if hooked_names:
                self._glass_hook_status = "+".join(hooked_names) + " OK"
            elif errors:
                self._glass_hook_status = errors[-1]
            else:
                self._glass_hook_status = "нет"
        except Exception as e:
            self._glass_hook_status = f"err: {e}"

    def _sync_settings_cache(self, force: bool = False):
        now = time.monotonic()
        if not force and (now - self._cfg_ts) < 0.25:
            return
        self._cfg_ts = now
        self._cfg_snow_enabled = bool(self.get_setting("snow_enabled", True))
        self._cfg_snow_area = self._get_int_setting("snow_area", 0, 3)
        self._cfg_navbar_enabled = bool(self.get_setting("navbar_festive_enabled", True))
        self._cfg_glass_enabled = bool(self.get_setting("glass_pills_enabled", True))
        self._cfg_profile_enabled = bool(self.get_setting("profile_festive_enabled", True))
        self._cfg_navbar_style = self._get_int_setting("navbar_style", 0, 4)
        self._cfg_palette_idx = self._get_int_setting("navbar_garland_palette", 0, len(GARLAND_PALETTES))
        self._cfg_glow_on = bool(self.get_setting("navbar_active_glow", True))
        self._cfg_density_idx = self._get_int_setting("snow_density", 1, len(DENSITY_COUNTS))
        self._cfg_speed_idx = self._get_int_setting("snow_speed", 1, len(SPEED_MULTIPLIERS))
        self._cfg_wind_idx = self._get_int_setting("snow_wind", 1, len(WIND_STRENGTHS))
        self._cfg_snow_style = self._get_int_setting("snow_style", 0, 3)
        self._cfg_snow_size = self._get_int_setting("snow_size", 2, len(SIZE_MULTIPLIERS))
        self._cfg_snow_opacity = self._get_int_setting("snow_opacity", 3, len(OPACITY_MULTIPLIERS))
        self._cfg_snow_color = self._get_int_setting("snow_color", 0, len(COLOR_PRESETS))

    def _get_int_setting(self, key: str, default: int, max_len: int) -> int:
        val = self.get_setting(key, default)
        try:
            idx = int(val)
        except (TypeError, ValueError):
            idx = default
        if idx < 0 or idx >= max_len:
            return default
        return idx

    def _update_theme_state(self):
        if self._theme_jcls is None:
            return
        try:
            self._is_dark_theme = bool(self._theme_jcls.isCurrentThemeDark())
        except Exception:
            pass

    def _should_draw_now(self) -> bool:
        area_mode = self._cfg_snow_area
        if area_mode == 0:
            return True

        try:
            fragment = get_last_fragment()
            if fragment is None:
                return False
            name = str(fragment.getClass().getSimpleName())
            if area_mode == 1:
                return name == "ChatActivity"
            if area_mode == 2:
                return name in ("ChatActivity", "DialogsActivity")
        except Exception:
            return True
        return False

    def _sync_flake_count(self, target_count: int, width: float, height: float):
        current = len(self._flakes)
        if current < target_count:
            for _ in range(target_count - current):
                self._flakes.append(Snowflake(width, height, self._density_px, random_y=True))
        elif current > target_count:
            del self._flakes[target_count:]

    def _resolve_color_rgb(self) -> Tuple[int, int, int]:
        preset = COLOR_PRESETS[self._cfg_snow_color]
        if preset is not None:
            return preset
        return COLOR_DARK_AUTO if self._is_dark_theme else COLOR_LIGHT_AUTO

    def _get_color_filter(self, rgb: Tuple[int, int, int]) -> Any:
        if rgb == (255, 255, 255):
            return None
        flt = self._color_filters.get(rgb)
        if flt is None and self._lighting_filter_cls is not None:
            r, g, b = rgb
            mul = ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
            flt = self._lighting_filter_cls(mul, 0)
            self._color_filters[rgb] = flt
        return flt

    def _advance_shared_clock(self) -> float:
        now = time.monotonic()
        if self._clock_last_time <= 0.0:
            self._clock_last_time = now
            return self._elapsed
        dt = now - self._clock_last_time
        if dt >= 0.004:
            self._clock_last_time = now
            if dt > 0.05:
                dt = 0.05
            self._elapsed += dt
            self._frame_counter += 1
            if self._frame_counter % 30 == 0:
                self._update_theme_state()
        return self._elapsed

    def _on_dispatch_draw(self, layout: Any, canvas: Any):
        if canvas is None or layout is None:
            return
        self._last_layout = layout
        self._sync_settings_cache()

        # Резервная отрисовка элементов профиля, если onDraw не вызвался
        if self._cfg_profile_enabled:
            try:
                self._draw_profile_backup_if_needed(layout, canvas)
            except Exception as e:
                self._last_error = f"prof_bk: {e}"

        if not self._cfg_snow_enabled:
            return
        if self._paint_bmp is None or self._bmp_bokeh is None or self._bmp_grain is None:
            return
        if not self._should_draw_now():
            return

        lid = int(self._system_jcls.identityHashCode(layout)) if self._system_jcls is not None else id(layout)
        if lid not in self._layout_draw_ready_ids:
            try:
                if layout.willNotDraw():
                    layout.setWillNotDraw(False)
                if len(self._layout_draw_ready_ids) > 16:
                    self._layout_draw_ready_ids.clear()
                self._layout_draw_ready_ids.add(lid)
            except Exception:
                pass

        width = float(layout.getWidth())
        height = float(layout.getHeight())
        if width <= 10.0 or height <= 10.0:
            return

        now = time.monotonic()
        dt = now - self._last_time
        self._last_time = now
        if dt < 0.0:
            dt = 0.0
        elif dt > 0.05:
            dt = 0.05
        self._clock_last_time = now
        self._elapsed += dt

        self._frame_counter += 1
        if self._frame_counter % 30 == 0:
            self._update_theme_state()

        style_idx = self._cfg_snow_style
        size_mul = SIZE_MULTIPLIERS[self._cfg_snow_size]
        opacity_mul = OPACITY_MULTIPLIERS[self._cfg_snow_opacity]
        target_count = DENSITY_COUNTS[self._cfg_density_idx]
        speed_mul = SPEED_MULTIPLIERS[self._cfg_speed_idx]
        wind_base = WIND_STRENGTHS[self._cfg_wind_idx] * self._density_px

        if not self._flakes or abs(width - self._last_w) > 80.0 or abs(height - self._last_h) > 80.0:
            self._last_w = width
            self._last_h = height
            self._flakes = [
                Snowflake(width, height, self._density_px, random_y=True)
                for _ in range(target_count)
            ]
        else:
            self._last_w = width
            self._last_h = height
            self._sync_flake_count(target_count, width, height)

        t = self._elapsed
        m_sin = math.sin
        wind_gust = 0.0
        if wind_base > 0.0:
            wind_gust = wind_base * (0.65 + 0.35 * m_sin(t * 0.45) + 0.15 * m_sin(t * 1.15))

        paint_bmp = self._paint_bmp
        paint_bmp.setColorFilter(self._get_color_filter(self._resolve_color_rgb()))

        top_fade = height * 0.07
        bottom_fade_start = height * 0.88
        bottom_fade_len = max(1.0, height - bottom_fade_start)
        dp = self._density_px
        margin = 30.0 * dp

        bmp_bokeh = self._bmp_bokeh
        bmp_grain = self._bmp_grain
        bmp_crystals = self._bmp_crystals
        has_crystals = bool(bmp_crystals) and style_idx in (1, 2)
        rect_dst = self._rect_dst
        rect_crystal = self._rect_crystal
        draw_bmp = canvas.drawBitmap

        for flake in self._flakes:
            layer_wind = wind_gust * (0.42 + 0.34 * flake.layer)
            sway = (
                m_sin(t * flake.sway_freq + flake.phase)
                + 0.42 * m_sin(t * flake.sway_freq * 1.7 + flake.phase2)
            ) * flake.sway_amp

            flake.y += flake.speed_y * speed_mul * dt
            flake.x += (layer_wind + sway * 0.45) * dt
            if has_crystals:
                flake.angle = (flake.angle + flake.spin * dt) % 360.0

            if flake.y > height + margin:
                flake.reset(width, height, dp, random_y=False)
            elif flake.x > width + margin:
                flake.x = -margin
            elif flake.x < -margin:
                flake.x = width + margin

            edge_factor = 1.0
            if flake.y < top_fade:
                edge_factor = max(0.0, flake.y / top_fade)
            elif flake.y > bottom_fade_start:
                edge_factor = max(0.0, 1.0 - (flake.y - bottom_fade_start) / bottom_fade_len)

            shimmer = 0.86 + 0.14 * m_sin(t * flake.twinkle_speed + flake.twinkle_phase)
            alpha = min(255, int(flake.alpha * edge_factor * shimmer * opacity_mul))
            if alpha <= 3:
                continue

            paint_bmp.setAlpha(alpha)

            draw_crystal = has_crystals and (
                (style_idx == 1 and flake.layer >= 1) or (style_idx == 2 and flake.is_crystal)
            )

            if draw_crystal:
                r_draw = flake.radius * 1.35 * size_mul
                rect_crystal.set(-r_draw, -r_draw, r_draw, r_draw)
                canvas.save()
                canvas.translate(flake.x, flake.y)
                canvas.rotate(flake.angle)
                draw_bmp(bmp_crystals[flake.variant], None, rect_crystal, paint_bmp)
                canvas.restore()
            else:
                if style_idx == 0 and flake.layer >= 1:
                    bmp = bmp_bokeh
                    r_draw = flake.radius * 1.25 * size_mul
                else:
                    bmp = bmp_grain
                    r_draw = flake.radius * 0.95 * size_mul
                rect_dst.set(flake.x - r_draw, flake.y - r_draw, flake.x + r_draw, flake.y + r_draw)
                draw_bmp(bmp, None, rect_dst, paint_bmp)

        layout.postInvalidateOnAnimation()

    def _pill_top_y(self, x: float, pl: float, pt: float, pr: float, rad: float) -> float:
        if x < pl + rad:
            dx = (pl + rad) - x
            dy = math.sqrt(max(0.0, rad * rad - dx * dx))
            return pt + rad - dy
        if x > pr - rad:
            dx = x - (pr - rad)
            dy = math.sqrt(max(0.0, rad * rad - dx * dx))
            return pt + rad - dy
        return pt

    def _build_pill_geometry(
        self,
        pl: float,
        pt: float,
        pr: float,
        pb: float,
        *,
        is_navbar: bool = False,
        clamp_top_edge: bool = False,
        corner_rad: Optional[float] = None,
        thin_decor: bool = False,
    ) -> Dict[str, Any]:
        dp = self._density_px
        pw = max(10.0, pr - pl)
        ph = max(10.0, pb - pt)
        if corner_rad is not None:
            rad = max(0.0, min(pw * 0.5, ph * 0.5, float(corner_rad)))
        else:
            rad = min(pw, ph) * 0.5
            if (not is_navbar) and ph > 58.0 * dp:
                rad = min(rad, 24.0 * dp)
        is_circle = (not is_navbar) and (corner_rad is None) and (pw <= ph * 1.28) and (pw < 110.0 * dp)
        is_compact = (not is_navbar) and (not is_circle) and (pw < 145.0 * dp)

        if is_navbar:
            edge_inset = 0.22
            steps = 44
            puff_scale = 1.0
            thick_scale = 1.0
            bulb_count = 11
            gx_inset = 0.36
            sag_dp = 2.3
            wire_y_dp = 0.6
            bulb_y_dp = 1.4
            core_r = 1.9 * dp
            aura_r = 7.2 * dp
            icicle_specs = (0.04, 0.12, 0.21, 0.31, 0.40, 0.50, 0.60, 0.69, 0.78, 0.87, 0.96)
            icicle_lens = (4.2, 6.8, 3.6, 7.6, 4.8, 8.2, 4.4, 7.2, 3.9, 6.4, 4.5)
            icicle_inset = 0.65
            icicle_hw_base = 1.35
        elif is_circle:
            edge_inset = 0.22
            steps = 24
            puff_scale = 0.50
            thick_scale = 0.58
            bulb_count = 3
            gx_inset = 0.30
            sag_dp = 1.0
            wire_y_dp = 0.8
            bulb_y_dp = 1.25
            core_r = 1.35 * dp
            aura_r = 4.6 * dp
            icicle_specs = (0.28, 0.50, 0.72)
            icicle_lens = (2.2, 3.0, 2.2)
            icicle_inset = 0.62
            icicle_hw_base = 0.95
        elif is_compact:
            edge_inset = 0.24
            steps = 28
            puff_scale = 0.65
            thick_scale = 0.68
            bulb_count = max(3, min(5, int((pw / dp) // 26)))
            gx_inset = 0.34
            sag_dp = 1.45
            wire_y_dp = 0.75
            bulb_y_dp = 1.3
            core_r = 1.45 * dp
            aura_r = 5.2 * dp
            icicle_specs = (0.14, 0.38, 0.62, 0.86)
            icicle_lens = (2.6, 3.9, 3.2, 2.7)
            icicle_inset = 0.60
            icicle_hw_base = 1.05
        else:
            edge_inset = 0.24
            steps = 40
            puff_scale = 0.74
            thick_scale = 0.74
            bulb_count = max(5, min(10, int((pw / dp) // 36) + 1))
            gx_inset = 0.34
            sag_dp = 1.75
            wire_y_dp = 0.75
            bulb_y_dp = 1.35
            core_r = 1.50 * dp
            aura_r = 5.4 * dp
            count = max(5, min(11, int((pw / dp) // 24)))
            icicle_specs = tuple((i + 0.5) / float(count) for i in range(count))
            base_lens = (2.8, 4.4, 3.1, 4.9, 3.4, 4.1)
            icicle_lens = tuple(base_lens[i % len(base_lens)] for i in range(count))
            icicle_inset = 0.65
            icicle_hw_base = 1.10

        if thin_decor and not is_navbar:
            puff_scale *= 0.62
            thick_scale *= 0.56
            sag_dp *= 0.72
            bulb_y_dp = 1.05
            core_r = min(core_r, 1.30 * dp)
            aura_r = min(aura_r, 4.35 * dp)
            icicle_lens = tuple(length_dp * 0.76 for length_dp in icicle_lens)

        # 1. Путь снежной шапки и блестящего гребня
        snow_path = self._path_cls()
        crest_path = self._path_cls()
        x0 = pl + rad * edge_inset
        x1 = pr - rad * edge_inset
        if x1 <= x0 + 4.0 * dp:
            x0 = pl + rad * 0.15
            x1 = pr - rad * 0.15

        top_pts = []
        bot_pts = []
        min_ty = max(0.0, pt - 0.5 * dp) if clamp_top_edge else -1e9
        for i in range(steps + 1):
            u = i / float(steps)
            x = x0 + (x1 - x0) * u
            base_y = self._pill_top_y(x, pl, pt, pr, rad)
            taper = math.pow(math.sin(math.pi * u), 0.55)
            puff = (0.75 + 0.55 * math.sin(u * math.pi * 5.0 + 0.4) + 0.30 * math.cos(u * math.pi * 9.0)) * dp * taper * puff_scale
            thick = (3.1 + 1.35 * math.sin(u * math.pi * 6.0 - 0.3) + 0.65 * math.cos(u * math.pi * 11.0)) * dp * taper * thick_scale
            ty = max(min_ty, base_y - puff * 0.55)
            by = base_y + thick
            top_pts.append((x, ty))
            bot_pts.append((x, by))

        snow_path.moveTo(top_pts[0][0], top_pts[0][1])
        crest_path.moveTo(top_pts[0][0], top_pts[0][1])
        for x, ty in top_pts[1:]:
            snow_path.lineTo(x, ty)
            crest_path.lineTo(x, ty)
        for x, by in reversed(bot_pts):
            snow_path.lineTo(x, by)
        snow_path.close()

        # 2. Путь провода и координаты лампочек гирлянды
        wire_path = self._path_cls()
        bulbs: List[Tuple[float, float]] = []
        gx0 = pl + rad * gx_inset
        gx1 = pr - rad * gx_inset
        if gx1 > gx0 + 4.0 * dp:
            wire_steps = 54 if pw > 120.0 * dp else 28
            for i in range(wire_steps + 1):
                u = i / float(wire_steps)
                x = gx0 + (gx1 - gx0) * u
                base_y = self._pill_top_y(x, pl, pt, pr, rad)
                sag = abs(math.sin(u * math.pi * max(1, bulb_count - 1) * 0.5)) * (sag_dp * dp)
                wy = base_y + wire_y_dp * dp + sag
                if i == 0:
                    wire_path.moveTo(x, wy)
                else:
                    wire_path.lineTo(x, wy)

            denom = float(max(1, bulb_count - 1))
            for i in range(bulb_count):
                u = 0.5 if bulb_count == 1 else i / denom
                x = gx0 + (gx1 - gx0) * u
                base_y = self._pill_top_y(x, pl, pt, pr, rad)
                sag = abs(math.sin(u * math.pi * max(1, bulb_count - 1) * 0.5)) * (sag_dp * dp)
                bulbs.append((x, base_y + bulb_y_dp * dp + sag))

        # 3. Путь сосулек по нижней кромке
        icicles_path = self._path_cls()
        icicles_hi = self._path_cls()
        ix0 = pl + rad * icicle_inset
        ix1 = pr - rad * icicle_inset
        max_len_dp = 0.0
        if ix1 > ix0 + 4.0 * dp:
            for pos, length_dp in zip(icicle_specs, icicle_lens):
                if length_dp > max_len_dp:
                    max_len_dp = length_dp
                cx = ix0 + (ix1 - ix0) * pos
                top_y = pb - 0.8 * dp
                tip_y = pb + length_dp * dp
                hw = (icicle_hw_base + length_dp * 0.09) * dp
                icicles_path.moveTo(cx - hw, top_y)
                icicles_path.quadTo(cx - hw * 0.35, (top_y + tip_y) * 0.55, cx, tip_y)
                icicles_path.quadTo(cx + hw * 0.35, (top_y + tip_y) * 0.55, cx + hw, top_y)
                icicles_path.close()

                icicles_hi.moveTo(cx - hw * 0.35, top_y + 0.7 * dp)
                icicles_hi.lineTo(cx - hw * 0.08, tip_y - 1.0 * dp)

        # 4. Градиенты (все цвета через jarray(jint), без long-перегрузки)
        LG = self._linear_gradient_cls
        tm = self._tile_clamp
        snow_shader = LG(
            0.0, pt - 1.8 * dp, 0.0, pt + 5.8 * dp * thick_scale,
            jarray(jint)([_argb(242, 255, 255, 255), _argb(215, 232, 245, 255), _argb(145, 185, 218, 250)]),
            jarray(jfloat)([0.0, 0.58, 1.0]),
            tm,
        )
        wash_alpha_top = (30 if self._is_dark_theme else 38) if is_navbar else (22 if self._is_dark_theme else 30)
        wash_top = _argb(wash_alpha_top, 165, 218, 255)
        frost_wash_shader = LG(
            0.0, pt, 0.0, pt + ph * 0.65,
            jarray(jint)([wash_top, _argb(0, 180, 225, 255)]),
            jarray(jfloat)([0.0, 1.0]),
            tm,
        )
        rim_top = _argb(145, 210, 236, 255) if self._is_dark_theme else _argb(170, 130, 195, 245)
        rim_bot = _argb(45, 130, 185, 235) if self._is_dark_theme else _argb(60, 100, 165, 225)
        frost_rim_shader = LG(
            0.0, pt, 0.0, pb,
            jarray(jint)([rim_top, rim_bot]),
            jarray(jfloat)([0.0, 1.0]),
            tm,
        )
        icicle_shader = LG(
            0.0, pb - dp, 0.0, pb + (max_len_dp + 0.5) * dp,
            jarray(jint)([_argb(195, 235, 248, 255), _argb(115, 175, 220, 255)]),
            jarray(jfloat)([0.0, 1.0]),
            tm,
        )

        # Позиции декоративных искр
        if is_circle:
            sparkles = (
                (pr - pw * 0.20, pt + ph * 0.22, 2.3 * dp),
                (pl + pw * 0.20, pb - ph * 0.22, 1.9 * dp),
            )
        elif thin_decor:
            inset_x = max(rad, 12.0 * dp) * 0.65
            sparkles = (
                (pl + inset_x, pt + 6.5 * dp, 2.0 * dp),
                (pr - inset_x, pt + 6.5 * dp, 2.0 * dp),
            )
        else:
            sparkles = (
                (pl + rad * 0.62, pt + 7.5 * dp, 2.8 * dp if is_navbar else 2.2 * dp),
                (pr - rad * 0.62, pt + 8.0 * dp, 2.8 * dp if is_navbar else 2.2 * dp),
                ((pl + pr) * 0.5, pb - (5.5 if is_navbar else 4.2) * dp, 2.9 * dp if is_navbar else 2.1 * dp),
            )

        return {
            "pl": pl,
            "pt": pt,
            "pr": pr,
            "pb": pb,
            "rad": rad,
            "is_circle": is_circle,
            "snow_path": snow_path,
            "crest_path": crest_path,
            "wire_path": wire_path,
            "icicles_path": icicles_path,
            "icicles_hi_path": icicles_hi,
            "max_icicle_dp": max_len_dp,
            "bulbs": bulbs,
            "core_r": core_r,
            "aura_r": aura_r,
            "snow_shader": snow_shader,
            "frost_wash_shader": frost_wash_shader,
            "frost_rim_shader": frost_rim_shader,
            "icicle_shader": icicle_shader,
            "sparkles": sparkles,
        }

    def _draw_pill_festive_overlay(
        self,
        canvas: Any,
        rect_pill: Any,
        pill_path: Optional[Any],
        geom: Dict[str, Any],
        style_idx: int,
        palette: List[Tuple[int, int, int]],
        alpha_f: float,
        t: float,
        *,
        draw_wash: bool = False,
        draw_sparkles: bool = False,
        rim_width_dp: float = 1.15,
    ):
        if alpha_f <= 0.02:
            return
        dp = self._density_px
        rad = geom["rad"]
        paint_a = max(1, min(255, int(255 * alpha_f)))

        wire_baked = False
        used_baked = False
        if pill_path is None:
            static_bmp = geom.get("static_bmp")
            if static_bmp is not None:
                paint_bmp = self._paint_bmp
                paint_bmp.setColorFilter(None)
                paint_bmp.setAlpha(paint_a)
                canvas.drawBitmap(static_bmp, -geom["pad_x"], -geom["pad_top"], paint_bmp)
                wire_baked = bool(geom.get("wire_baked", False))
                used_baked = True
            elif geom.get("top_bmp_s") is not None:
                if style_idx in (0, 1, 3) and geom.get("frost_rim_shader") is not None:
                    self._paint_stroke.setShader(geom["frost_rim_shader"])
                    self._paint_stroke.setARGB(paint_a, 255, 255, 255)
                    self._paint_stroke.setStrokeWidth(rim_width_dp * dp)
                    canvas.drawRoundRect(rect_pill, rad, rad, self._paint_stroke)
                    self._paint_stroke.setShader(None)

                paint_bmp = self._paint_bmp
                paint_bmp.setColorFilter(None)
                paint_bmp.setAlpha(paint_a)
                canvas.drawBitmap(geom["top_bmp_s"], -geom["top_pad_x"], -geom["top_pad_top"], paint_bmp)
                if style_idx == 1 and geom.get("bot_bmp_s") is not None:
                    canvas.drawBitmap(geom["bot_bmp_s"], -geom["bot_pad_x"], rect_pill.height() - geom["bot_off_y"], paint_bmp)
                wire_baked = bool(geom.get("wire_baked", False))
                used_baked = True

        if not used_baked:
            # 0. Мягкая морозная вуаль внутри пилюли (когда рисуем до текста/иконок)
            if draw_wash and geom.get("frost_wash_shader") is not None:
                self._paint_fill.setShader(geom["frost_wash_shader"])
                self._paint_fill.setARGB(paint_a, 255, 255, 255)
                if pill_path is not None:
                    canvas.drawPath(pill_path, self._paint_fill)
                else:
                    canvas.drawRoundRect(rect_pill, rad, rad, self._paint_fill)
                self._paint_fill.setShader(None)

            # 1. Морозный контур по краю пилюли (стили 0, 1, 3)
            if style_idx in (0, 1, 3) and geom.get("frost_rim_shader") is not None:
                self._paint_stroke.setShader(geom["frost_rim_shader"])
                self._paint_stroke.setARGB(paint_a, 255, 255, 255)
                self._paint_stroke.setStrokeWidth(rim_width_dp * dp)
                if pill_path is not None:
                    canvas.drawPath(pill_path, self._paint_stroke)
                else:
                    canvas.drawRoundRect(rect_pill, rad, rad, self._paint_stroke)
                self._paint_stroke.setShader(None)

            # 2. Сосульки по нижнему краю (стиль 1: Морозная)
            if style_idx == 1 and geom.get("icicles_path") is not None and geom.get("icicle_shader") is not None:
                self._paint_fill.setShader(geom["icicle_shader"])
                self._paint_fill.setARGB(paint_a, 255, 255, 255)
                canvas.drawPath(geom["icicles_path"], self._paint_fill)
                self._paint_fill.setShader(None)

                self._paint_stroke.setShader(None)
                self._paint_stroke.setARGB(int(145 * alpha_f), 255, 255, 255)
                self._paint_stroke.setStrokeWidth(0.70 * dp)
                canvas.drawPath(geom["icicles_hi_path"], self._paint_stroke)

            # 3. Пушистая снежная шапка сверху (стили 0 и 1)
            if style_idx in (0, 1) and geom.get("snow_path") is not None and geom.get("snow_shader") is not None:
                self._paint_fill.setShader(geom["snow_shader"])
                self._paint_fill.setARGB(paint_a, 255, 255, 255)
                canvas.drawPath(geom["snow_path"], self._paint_fill)
                self._paint_fill.setShader(None)

                self._paint_stroke.setShader(None)
                self._paint_stroke.setARGB(int(190 * alpha_f), 255, 255, 255)
                self._paint_stroke.setStrokeWidth(0.85 * dp)
                canvas.drawPath(geom["crest_path"], self._paint_stroke)

        # 4. Новогодняя гирлянда с мягким свечением огоньков (стили 0 и 2)
        if style_idx in (0, 2) and geom.get("bulbs") and self._bmp_bokeh is not None:
            self._draw_garland_bulbs(
                canvas,
                geom["wire_path"],
                geom["bulbs"],
                geom["aura_r"],
                geom["core_r"],
                palette,
                alpha_f,
                t,
                draw_wire=(not wire_baked),
            )

        # 5. Искры (стиль 3: Северное сияние или декоративные блики на стеклянных кнопках)
        if style_idx == 3 or draw_sparkles:
            for idx, (sx, sy, s_sz) in enumerate(geom["sparkles"]):
                sp = 0.35 + 0.65 * (0.5 + 0.5 * math.sin(t * 2.5 + idx * 2.1))
                base_a = 215 if style_idx == 3 else 155
                self._draw_sparkle(canvas, sx, sy, s_sz, int(base_a * sp * alpha_f), 220, 244, 255)

    def _draw_garland_bulbs(
        self,
        canvas: Any,
        wire_path: Any,
        bulbs: List[Tuple[float, float]],
        aura_r: float,
        core_r: float,
        palette: List[Tuple[int, int, int]],
        alpha_f: float,
        t: float,
        *,
        wire_width_dp: float = 0.95,
        aura_alpha: int = 185,
        draw_wire: bool = True,
    ):
        dp = self._density_px
        if draw_wire and wire_path is not None:
            paint_stroke = self._paint_stroke
            paint_stroke.setShader(None)
            paint_stroke.setARGB(int(120 * alpha_f), 62, 92, 118)
            paint_stroke.setStrokeWidth(wire_width_dp * dp)
            canvas.drawPath(wire_path, paint_stroke)

        paint_bmp = self._paint_bmp
        rect_dst = self._rect_dst
        m_sin = math.sin
        draw_bmp = canvas.drawBitmap
        sprites = self._bulb_sprites
        pal_len = len(palette)

        if len(sprites) >= pal_len:
            paint_bmp.setColorFilter(None)
            for idx, (bx, by) in enumerate(bulbs):
                rgb = palette[idx % pal_len]
                wave = 0.5 + 0.5 * m_sin(t * 2.6 - idx * 0.72)
                glow = 0.42 + 0.58 * wave
                paint_bmp.setAlpha(int(255 * glow * alpha_f))
                rect_dst.set(bx - aura_r, by - aura_r, bx + aura_r, by + aura_r)
                draw_bmp(sprites[rgb], None, rect_dst, paint_bmp)
        else:
            paint_fill = self._paint_fill
            paint_fill.setShader(None)
            bmp_bokeh = self._bmp_bokeh
            draw_circle = canvas.drawCircle
            get_cf = self._get_color_filter
            for idx, (bx, by) in enumerate(bulbs):
                rgb = palette[idx % pal_len]
                r, g, b = rgb
                wave = 0.5 + 0.5 * m_sin(t * 2.6 - idx * 0.72)
                glow = 0.42 + 0.58 * wave

                paint_bmp.setColorFilter(get_cf(rgb))
                paint_bmp.setAlpha(int(aura_alpha * glow * alpha_f))
                rect_dst.set(bx - aura_r, by - aura_r, bx + aura_r, by + aura_r)
                draw_bmp(bmp_bokeh, None, rect_dst, paint_bmp)

                paint_fill.setARGB(int(235 * glow * alpha_f), r, g, b)
                draw_circle(bx, by, core_r, paint_fill)

                paint_fill.setARGB(int(220 * glow * alpha_f), 255, 255, 255)
                draw_circle(bx, by, core_r * 0.45, paint_fill)

            paint_bmp.setColorFilter(None)

    def _get_avatar_geometry(self, w: float, h: float, inset: float, style_idx: int) -> Dict[str, Any]:
        key = (int(round(w)), int(round(h)), int(round(inset)), self._is_dark_theme, style_idx)
        geom = self._avatar_cache.get(key)
        if geom is not None:
            return geom
        if len(self._avatar_cache) >= 12:
            oldest = next(iter(self._avatar_cache), None)
            if oldest is not None:
                self._recycle_geom_bmps(self._avatar_cache.pop(oldest, None))

        dp = self._density_px
        cx = w * 0.5
        cy = h * 0.5
        outer_r = min(w, h) * 0.5 - inset
        rim_r = max(12.0 * dp, outer_r - 1.35 * dp)

        # Путь снежного полумесяца по верхней дуге (-142° .. -38°) внутри clipPath
        snow_path = self._path_cls()
        crest_path = self._path_cls()
        start_deg = -142.0
        end_deg = -38.0
        steps = 28
        outer_pts = []
        inner_pts = []
        r_snow_outer = outer_r - 0.5 * dp
        for i in range(steps + 1):
            u = i / float(steps)
            ang = math.radians(start_deg + (end_deg - start_deg) * u)
            taper = math.pow(math.sin(math.pi * u), 0.55)
            thick = (2.1 + 0.85 * math.sin(u * math.pi * 5.0 + 0.3)) * dp * taper
            ca = math.cos(ang)
            sa = math.sin(ang)
            outer_pts.append((cx + ca * r_snow_outer, cy + sa * r_snow_outer))
            r_in = max(8.0 * dp, r_snow_outer - thick)
            inner_pts.append((cx + ca * r_in, cy + sa * r_in))

        snow_path.moveTo(outer_pts[0][0], outer_pts[0][1])
        crest_path.moveTo(outer_pts[0][0], outer_pts[0][1])
        for px, py in outer_pts[1:]:
            snow_path.lineTo(px, py)
            crest_path.lineTo(px, py)
        for px, py in reversed(inner_pts):
            snow_path.lineTo(px, py)
        snow_path.close()

        # Провод и огоньки по всему кругу рамки аватара
        wire_path = self._path_cls()
        bulbs: List[Tuple[float, float]] = []
        bulb_count = 14 if outer_r >= 44.0 * dp else 10
        wire_r = rim_r - 2.3 * dp
        full_steps = bulb_count * 5
        for i in range(full_steps):
            u = i / float(full_steps)
            ang = math.tau * u - math.pi * 0.5
            sag = abs(math.sin(u * math.pi * bulb_count)) * (1.25 * dp)
            rr = wire_r - sag
            wx = cx + math.cos(ang) * rr
            wy = cy + math.sin(ang) * rr
            if i == 0:
                wire_path.moveTo(wx, wy)
            else:
                wire_path.lineTo(wx, wy)
        wire_path.close()

        for i in range(bulb_count):
            u = (i + 0.5) / float(bulb_count)
            ang = math.tau * u - math.pi * 0.5
            rr = wire_r - 1.25 * dp - 0.55 * dp
            bulbs.append((cx + math.cos(ang) * rr, cy + math.sin(ang) * rr))

        LG = self._linear_gradient_cls
        tm = self._tile_clamp
        rim_top = _argb(235, 224, 244, 255)
        rim_bot = _argb(120, 145, 206, 250)
        rim_shader = LG(
            0.0, cy - rim_r, 0.0, cy + rim_r,
            jarray(jint)([rim_top, rim_bot]),
            jarray(jfloat)([0.0, 1.0]),
            tm,
        )
        snow_shader = LG(
            0.0, cy - outer_r, 0.0, cy - outer_r * 0.45,
            jarray(jint)([_argb(245, 255, 255, 255), _argb(175, 214, 238, 255)]),
            jarray(jfloat)([0.0, 1.0]),
            tm,
        )

        sp_r = rim_r - 1.6 * dp
        sparkles = (
            (cx + math.cos(math.radians(-138.0)) * sp_r, cy + math.sin(math.radians(-138.0)) * sp_r, 2.3 * dp),
            (cx + math.cos(math.radians(-42.0)) * sp_r, cy + math.sin(math.radians(-42.0)) * sp_r, 2.3 * dp),
            (cx + math.cos(math.radians(48.0)) * sp_r, cy + math.sin(math.radians(48.0)) * sp_r, 2.1 * dp),
            (cx + math.cos(math.radians(138.0)) * sp_r, cy + math.sin(math.radians(138.0)) * sp_r, 2.1 * dp),
        )

        static_bmp = None
        pad = max(2, int(math.ceil(2.5 * dp)))
        if self._bmp_cls is not None and self._bmp_cfg_argb is not None and self._canvas_cls is not None:
            bw = int(math.ceil(w)) + pad * 2
            bh = int(math.ceil(h)) + pad * 2
            if 4 <= bw <= 2048 and 4 <= bh <= 2048:
                try:
                    bmp = self._bmp_cls.createBitmap(bw, bh, self._bmp_cfg_argb)
                    cnv = self._canvas_cls(bmp)
                    cnv.translate(float(pad), float(pad))
                    ps = self._paint_stroke
                    pf = self._paint_fill

                    ps.setShader(None)
                    ps.setARGB(85, 170, 224, 255)
                    ps.setStrokeWidth(3.4 * dp)
                    cnv.drawCircle(cx, cy, rim_r, ps)

                    ps.setShader(rim_shader)
                    ps.setARGB(255, 255, 255, 255)
                    ps.setStrokeWidth(1.65 * dp)
                    cnv.drawCircle(cx, cy, rim_r, ps)
                    ps.setShader(None)

                    if style_idx in (0, 1, 3):
                        arc_r = rim_r - 1.2 * dp
                        self._rect_avatar.set(cx - arc_r, cy - arc_r, cx + arc_r, cy + arc_r)
                        ps.setARGB(175, 245, 252, 255)
                        ps.setStrokeWidth(0.9 * dp)
                        cnv.drawArc(self._rect_avatar, -162.0, 144.0, False, ps)

                    if style_idx in (0, 1):
                        pf.setShader(snow_shader)
                        pf.setARGB(255, 255, 255, 255)
                        cnv.drawPath(snow_path, pf)
                        pf.setShader(None)

                        ps.setARGB(195, 255, 255, 255)
                        ps.setStrokeWidth(0.75 * dp)
                        cnv.drawPath(crest_path, ps)

                    if style_idx in (0, 2):
                        ps.setShader(None)
                        ps.setARGB(120, 62, 92, 118)
                        ps.setStrokeWidth(0.85 * dp)
                        cnv.drawPath(wire_path, ps)

                    static_bmp = bmp
                except Exception:
                    static_bmp = None

        geom = {
            "cx": cx,
            "cy": cy,
            "rim_r": rim_r,
            "snow_path": snow_path,
            "crest_path": crest_path,
            "wire_path": wire_path,
            "bulbs": bulbs,
            "rim_shader": rim_shader,
            "snow_shader": snow_shader,
            "sparkles": sparkles,
            "static_bmp": static_bmp,
            "pad": float(pad),
        }
        self._avatar_cache[key] = geom
        return geom

    def _draw_avatar_festive_ring(self, canvas: Any, w: float, h: float, inset: float, alpha_f: float) -> bool:
        if alpha_f <= 0.04 or self._rect_avatar is None:
            return False
        dp = self._density_px
        outer_r = min(w, h) * 0.5 - inset
        if outer_r < 18.0 * dp:
            return False

        style_idx = self._cfg_navbar_style
        geom = self._get_avatar_geometry(w, h, inset, style_idx)
        cx = geom["cx"]
        cy = geom["cy"]
        rim_r = geom["rim_r"]
        palette = GARLAND_PALETTES[self._cfg_palette_idx]
        glow_on = self._cfg_glow_on
        t = self._advance_shared_clock()
        paint_a = max(1, min(255, int(255 * alpha_f)))

        static_bmp = geom.get("static_bmp")
        wire_drawn = False
        if static_bmp is not None:
            pad = geom["pad"]
            paint_bmp = self._paint_bmp
            paint_bmp.setColorFilter(None)
            paint_bmp.setAlpha(paint_a)
            canvas.drawBitmap(static_bmp, -pad, -pad, paint_bmp)
            wire_drawn = True
        else:
            # 1. Мягкое внешнее/внутреннее морозное кольцо вокруг аватара
            self._paint_stroke.setShader(None)
            self._paint_stroke.setARGB(int(85 * alpha_f), 170, 224, 255)
            self._paint_stroke.setStrokeWidth(3.4 * dp)
            canvas.drawCircle(cx, cy, rim_r, self._paint_stroke)

            self._paint_stroke.setShader(geom["rim_shader"])
            self._paint_stroke.setARGB(paint_a, 255, 255, 255)
            self._paint_stroke.setStrokeWidth(1.65 * dp)
            canvas.drawCircle(cx, cy, rim_r, self._paint_stroke)
            self._paint_stroke.setShader(None)

            # Верхний ледяной блик по дуге (стили 0, 1, 3)
            if style_idx in (0, 1, 3):
                arc_r = rim_r - 1.2 * dp
                self._rect_avatar.set(cx - arc_r, cy - arc_r, cx + arc_r, cy + arc_r)
                self._paint_stroke.setARGB(int(175 * alpha_f), 245, 252, 255)
                self._paint_stroke.setStrokeWidth(0.9 * dp)
                canvas.drawArc(self._rect_avatar, -162.0, 144.0, False, self._paint_stroke)

            # 2. Снежная шапочка по верхней дуге аватара (стили 0 и 1)
            if style_idx in (0, 1):
                self._paint_fill.setShader(geom["snow_shader"])
                self._paint_fill.setARGB(paint_a, 255, 255, 255)
                canvas.drawPath(geom["snow_path"], self._paint_fill)
                self._paint_fill.setShader(None)

                self._paint_stroke.setARGB(int(195 * alpha_f), 255, 255, 255)
                self._paint_stroke.setStrokeWidth(0.75 * dp)
                canvas.drawPath(geom["crest_path"], self._paint_stroke)

        # 3. Огоньки гирлянды (стили 0 и 2)
        if style_idx in (0, 2) and self._bmp_bokeh is not None:
            self._draw_garland_bulbs(
                canvas,
                geom["wire_path"],
                geom["bulbs"],
                4.2 * dp,
                1.25 * dp,
                palette,
                alpha_f,
                t,
                wire_width_dp=0.85,
                aura_alpha=180,
                draw_wire=(not wire_drawn),
            )

        # 4. Искры (стиль 3 или при включённом сиянии)
        if style_idx == 3 or glow_on:
            for idx, (sx, sy, s_sz) in enumerate(geom["sparkles"]):
                sp = 0.35 + 0.65 * (0.5 + 0.5 * math.sin(t * 2.5 + idx * 2.1))
                base_a = 225 if style_idx == 3 else 170
                self._draw_sparkle(canvas, sx, sy, s_sz, int(base_a * sp * alpha_f), 225, 246, 255)

        return True

    def _ensure_navbar_cache(self, w: float, h: float):
        key = (int(w), int(h), self._is_dark_theme)
        if self._nav_cache_key == key and self._nav_geom is not None:
            return
        self._nav_cache_key = key

        dp = self._density_px
        pad = 7.67 * dp
        pl = pad
        pt = pad
        pr = max(pl + 40.0, w - pad)
        pb = max(pt + 20.0, h - pad)
        self._rect_pill.set(pl, pt, pr, pb)
        self._nav_geom = self._build_pill_geometry(pl, pt, pr, pb, is_navbar=True, clamp_top_edge=False)

    def _track_navbar_bg(self, layout: Any):
        if self._system_jcls is None:
            return
        try:
            bg = layout.getBackground()
            if bg is not None:
                bg_id = int(self._system_jcls.identityHashCode(bg))
                if len(self._navbar_bg_ids) > 16:
                    self._navbar_bg_ids.clear()
                self._navbar_bg_ids.add(bg_id)
        except Exception:
            pass

    def _is_navbar_background(self, drawable: Any) -> bool:
        try:
            if self._system_jcls is not None:
                if int(self._system_jcls.identityHashCode(drawable)) in self._navbar_bg_ids:
                    return True
            cb = drawable.getCallback()
            if cb is not None:
                if self._main_tabs_jcls is not None and self._main_tabs_jcls.isInstance(cb):
                    return True
                if str(cb.getClass().getSimpleName()) == "MainTabsLayout":
                    return True
        except Exception:
            pass
        return False

    def _draw_sparkle(self, canvas: Any, cx: float, cy: float, size: float, alpha: int, r: int, g: int, b: int):
        if alpha <= 4:
            return
        if self._bmp_sparkle is not None:
            paint_bmp = self._paint_bmp
            half = size * 1.19
            self._rect_dst.set(cx - half, cy - half, cx + half, cy + half)
            paint_bmp.setColorFilter(None if (r == 255 and g == 255 and b == 255) else self._get_color_filter((r, g, b)))
            paint_bmp.setAlpha(alpha)
            canvas.drawBitmap(self._bmp_sparkle, None, self._rect_dst, paint_bmp)
            paint_bmp.setColorFilter(None)
            return
        self._paint_stroke.setShader(None)
        self._paint_stroke.setARGB(alpha, r, g, b)
        self._paint_stroke.setStrokeWidth(max(1.0, size * 0.22))
        canvas.drawLine(cx - size, cy, cx + size, cy, self._paint_stroke)
        canvas.drawLine(cx, cy - size, cx, cy + size, self._paint_stroke)
        d = size * 0.55
        self._paint_stroke.setARGB(int(alpha * 0.65), r, g, b)
        canvas.drawLine(cx - d, cy - d, cx + d, cy + d, self._paint_stroke)
        canvas.drawLine(cx - d, cy + d, cx + d, cy - d, self._paint_stroke)

    def _find_selected_tab_rect(self, layout: Any) -> Optional[Tuple[float, float, float, float]]:
        try:
            count = layout.getChildCount()
            for i in range(count):
                child = layout.getChildAt(i)
                if child is None or child.getVisibility() != 0:
                    continue
                try:
                    if not child.isTabSelected():
                        continue
                except Exception:
                    continue
                tx = float(child.getTranslationX())
                ty = float(child.getTranslationY())
                l = float(child.getLeft()) + tx
                t = float(child.getTop()) + ty
                r = float(child.getRight()) + tx
                b = float(child.getBottom()) + ty
                if r > l and b > t:
                    return (l, t, r, b)
        except Exception:
            pass
        return None

    def _on_navbar_before_draw(self, layout: Any, canvas: Any):
        if canvas is None or layout is None:
            return
        self._sync_settings_cache()
        self._track_navbar_bg(layout)
        if not self._cfg_navbar_enabled:
            return
        if self._paint_fill is None or self._linear_gradient_cls is None:
            return

        w = float(layout.getWidth())
        h = float(layout.getHeight())
        if w <= 20.0 or h <= 20.0:
            return

        self._last_navbar = layout
        self._ensure_navbar_cache(w, h)
        geom = self._nav_geom
        if geom is None:
            return
        rad = geom["rad"]

        if geom.get("frost_wash_shader") is not None:
            self._paint_fill.setShader(geom["frost_wash_shader"])
            self._paint_fill.setARGB(255, 255, 255, 255)
            canvas.drawRoundRect(self._rect_pill, rad, rad, self._paint_fill)
            self._paint_fill.setShader(None)

        if self._cfg_glow_on:
            tab_rect = self._find_selected_tab_rect(layout)
            if tab_rect is not None:
                tl, tt, tr, tb = tab_rect
                self._rect_tab.set(tl, tt, tr, tb)
                t_rad = min(tr - tl, tb - tt) * 0.5
                pulse = 0.72 + 0.28 * math.sin(self._elapsed * 2.3)
                glow_a = int(34 * pulse) if self._is_dark_theme else int(42 * pulse)
                self._paint_fill.setARGB(glow_a, 130, 210, 255)
                canvas.drawRoundRect(self._rect_tab, t_rad, t_rad, self._paint_fill)

    def _on_navbar_after_draw(self, layout: Any, canvas: Any):
        if canvas is None or layout is None:
            return
        self._sync_settings_cache()
        if not self._cfg_navbar_enabled:
            return
        if self._paint_fill is None or self._paint_stroke is None or self._linear_gradient_cls is None:
            return

        w = float(layout.getWidth())
        h = float(layout.getHeight())
        if w <= 20.0 or h <= 20.0:
            return

        self._last_navbar = layout
        lid = int(self._system_jcls.identityHashCode(layout)) if self._system_jcls is not None else id(layout)
        if lid not in self._layout_draw_ready_ids:
            try:
                if layout.willNotDraw():
                    layout.setWillNotDraw(False)
                self._layout_draw_ready_ids.add(lid)
            except Exception:
                pass
        self._ensure_navbar_cache(w, h)
        geom = self._nav_geom
        if geom is None:
            return

        dp = self._density_px
        nav_style = self._cfg_navbar_style
        palette = GARLAND_PALETTES[self._cfg_palette_idx]
        t = self._advance_shared_clock()

        self._draw_pill_festive_overlay(
            canvas,
            self._rect_pill,
            None,
            geom,
            nav_style,
            palette,
            1.0,
            t,
            draw_wash=False,
            draw_sparkles=False,
            rim_width_dp=1.15,
        )

        if self._cfg_glow_on:
            tab_rect = self._find_selected_tab_rect(layout)
            if tab_rect is not None:
                tl, tt, tr, tb = tab_rect
                self._rect_tab.set(tl + 0.6 * dp, tt + 0.6 * dp, tr - 0.6 * dp, tb - 0.6 * dp)
                t_rad = min(self._rect_tab.width(), self._rect_tab.height()) * 0.5
                pulse = 0.65 + 0.35 * math.sin(t * 2.3)

                self._paint_stroke.setShader(None)
                self._paint_stroke.setARGB(int(115 * pulse), 175, 226, 255)
                self._paint_stroke.setStrokeWidth(1.05 * dp)
                canvas.drawRoundRect(self._rect_tab, t_rad, t_rad, self._paint_stroke)

                s1 = 0.45 + 0.55 * (0.5 + 0.5 * math.sin(t * 3.1))
                s2 = 0.45 + 0.55 * (0.5 + 0.5 * math.sin(t * 2.7 + 1.9))
                self._draw_sparkle(canvas, tr - 7.0 * dp, tt + 7.0 * dp, 3.0 * dp, int(210 * s1), 235, 248, 255)
                self._draw_sparkle(canvas, tl + 8.0 * dp, tb - 7.0 * dp, 2.2 * dp, int(170 * s2), 255, 232, 170)

        self._throttle_view_inval(layout, 0.032)

    def _bake_pill_strip(
        self,
        geom: Dict[str, Any],
        pw: float,
        ph: float,
        cr_key: int,
        thin_decor: bool,
        clamp_top: bool,
        style_idx: int,
    ) -> Optional[Tuple[Any, ...]]:
        skey = (int(round(pw)), cr_key, thin_decor, clamp_top, style_idx)
        strip = self._strip_cache.get(skey)
        if strip is not None:
            return strip
        if self._bmp_cls is None or self._bmp_cfg_argb is None or self._canvas_cls is None:
            return None

        dp = self._density_px
        rad = geom["rad"]
        pad_x = max(2, int(math.ceil(2.5 * dp)))
        pad_top = max(2, int(math.ceil(2.5 * dp)))
        bw = int(math.ceil(pw)) + pad_x * 2
        if bw < 4 or bw > 2048:
            return None

        top_body_h = max(18.0 * dp, rad * 0.55 + 9.0 * dp)
        top_h = min(int(math.ceil(ph)) + pad_top, int(math.ceil(top_body_h)) + pad_top)
        top_bmp = None
        bot_bmp = None
        bot_off_y = 1.5 * dp

        try:
            pf = self._paint_fill
            ps = self._paint_stroke
            top_bmp = self._bmp_cls.createBitmap(bw, top_h, self._bmp_cfg_argb)
            cnv = self._canvas_cls(top_bmp)
            cnv.translate(float(pad_x), float(pad_top))

            if style_idx in (0, 1) and geom.get("snow_path") is not None and geom.get("snow_shader") is not None:
                pf.setShader(geom["snow_shader"])
                pf.setARGB(255, 255, 255, 255)
                cnv.drawPath(geom["snow_path"], pf)
                pf.setShader(None)

                ps.setShader(None)
                ps.setARGB(190, 255, 255, 255)
                ps.setStrokeWidth(0.85 * dp)
                cnv.drawPath(geom["crest_path"], ps)

            if style_idx in (0, 2) and geom.get("wire_path") is not None:
                ps.setShader(None)
                ps.setARGB(120, 62, 92, 118)
                ps.setStrokeWidth(0.95 * dp)
                cnv.drawPath(geom["wire_path"], ps)

            max_ic = geom.get("max_icicle_dp", 0.0)
            if style_idx == 1 and max_ic > 0.0 and geom.get("icicles_path") is not None:
                bot_h = max(6, int(math.ceil((max_ic + 3.0) * dp)))
                if bot_h <= 256:
                    bot_bmp = self._bmp_cls.createBitmap(bw, bot_h, self._bmp_cfg_argb)
                    bcnv = self._canvas_cls(bot_bmp)
                    bcnv.translate(float(pad_x), -(ph - bot_off_y))
                    if geom.get("icicle_shader") is not None:
                        pf.setShader(geom["icicle_shader"])
                        pf.setARGB(255, 255, 255, 255)
                        bcnv.drawPath(geom["icicles_path"], pf)
                        pf.setShader(None)
                    ps.setShader(None)
                    ps.setARGB(145, 255, 255, 255)
                    ps.setStrokeWidth(0.70 * dp)
                    bcnv.drawPath(geom["icicles_hi_path"], ps)
        except Exception:
            for b in (top_bmp, bot_bmp):
                if b is not None:
                    try:
                        b.recycle()
                    except Exception:
                        pass
            return None

        if len(self._strip_cache) >= 24:
            oldest = next(iter(self._strip_cache), None)
            if oldest is not None:
                old_s = self._strip_cache.pop(oldest, None)
                if old_s and len(old_s) >= 4:
                    for b in (old_s[0], old_s[3]):
                        if b is not None:
                            try:
                                b.recycle()
                            except Exception:
                                pass

        strip = (top_bmp, float(pad_x), float(pad_top), bot_bmp, float(pad_x), float(bot_off_y))
        self._strip_cache[skey] = strip
        return strip

    def _get_glass_geometry(
        self,
        pw: float,
        ph: float,
        *,
        clamp_top: bool = False,
        corner_rad: Optional[float] = None,
        thin_decor: bool = False,
        style_idx: int = 0,
        draw_wash: bool = False,
        rim_width_dp: float = 1.05,
        allow_bake: bool = True,
    ) -> Dict[str, Any]:
        dp = self._density_px
        is_tall = ph > 120.0 * dp
        cr_key = int(round(corner_rad)) if corner_rad is not None else -1
        if is_tall or not allow_bake:
            key = (int(round(pw)), int(round(ph)), cr_key, thin_decor, clamp_top, self._is_dark_theme, style_idx if allow_bake else -1)
        else:
            key = (
                int(round(pw)),
                int(round(ph)),
                cr_key,
                thin_decor,
                clamp_top,
                self._is_dark_theme,
                style_idx,
                draw_wash,
                int(round(rim_width_dp * 20)),
            )

        geom = self._glass_cache.get(key)
        if geom is None:
            if len(self._glass_cache) >= 64:
                oldest = next(iter(self._glass_cache), None)
                if oldest is not None:
                    self._recycle_geom_bmps(self._glass_cache.pop(oldest, None))
            geom = self._build_pill_geometry(
                0.0,
                0.0,
                pw,
                ph,
                is_navbar=False,
                clamp_top_edge=clamp_top,
                corner_rad=corner_rad,
                thin_decor=thin_decor,
            )
            if allow_bake and self._bmp_cls is not None and self._bmp_cfg_argb is not None and self._canvas_cls is not None:
                if (not is_tall) and pw <= 600.0 * dp:
                    pad_x = max(2, int(math.ceil(2.5 * dp)))
                    pad_top = max(2, int(math.ceil(2.5 * dp)))
                    max_ic = geom.get("max_icicle_dp", 0.0)
                    pad_bot = max(pad_top, int(math.ceil((max_ic + 1.5) * dp))) if (style_idx == 1 and max_ic > 0.0) else pad_top
                    bw = int(math.ceil(pw)) + pad_x * 2
                    bh = int(math.ceil(ph)) + pad_top + pad_bot
                    if 4 <= bw <= 2048 and 4 <= bh <= 1024:
                        try:
                            bmp = self._bmp_cls.createBitmap(bw, bh, self._bmp_cfg_argb)
                            cnv = self._canvas_cls(bmp)
                            cnv.translate(float(pad_x), float(pad_top))
                            pf = self._paint_fill
                            ps = self._paint_stroke
                            rad = geom["rad"]
                            self._rect_glass.set(0.0, 0.0, pw, ph)

                            if draw_wash and geom.get("frost_wash_shader") is not None:
                                pf.setShader(geom["frost_wash_shader"])
                                pf.setARGB(255, 255, 255, 255)
                                cnv.drawRoundRect(self._rect_glass, rad, rad, pf)
                                pf.setShader(None)

                            if style_idx in (0, 1, 3) and geom.get("frost_rim_shader") is not None:
                                ps.setShader(geom["frost_rim_shader"])
                                ps.setARGB(255, 255, 255, 255)
                                ps.setStrokeWidth(rim_width_dp * dp)
                                cnv.drawRoundRect(self._rect_glass, rad, rad, ps)
                                ps.setShader(None)

                            if style_idx == 1 and geom.get("icicles_path") is not None and geom.get("icicle_shader") is not None:
                                pf.setShader(geom["icicle_shader"])
                                pf.setARGB(255, 255, 255, 255)
                                cnv.drawPath(geom["icicles_path"], pf)
                                pf.setShader(None)

                                ps.setShader(None)
                                ps.setARGB(145, 255, 255, 255)
                                ps.setStrokeWidth(0.70 * dp)
                                cnv.drawPath(geom["icicles_hi_path"], ps)

                            if style_idx in (0, 1) and geom.get("snow_path") is not None and geom.get("snow_shader") is not None:
                                pf.setShader(geom["snow_shader"])
                                pf.setARGB(255, 255, 255, 255)
                                cnv.drawPath(geom["snow_path"], pf)
                                pf.setShader(None)

                                ps.setShader(None)
                                ps.setARGB(190, 255, 255, 255)
                                ps.setStrokeWidth(0.85 * dp)
                                cnv.drawPath(geom["crest_path"], ps)

                            if style_idx in (0, 2) and geom.get("wire_path") is not None:
                                ps.setShader(None)
                                ps.setARGB(120, 62, 92, 118)
                                ps.setStrokeWidth(0.95 * dp)
                                cnv.drawPath(geom["wire_path"], ps)

                            geom["static_bmp"] = bmp
                            geom["pad_x"] = float(pad_x)
                            geom["pad_top"] = float(pad_top)
                            geom["wire_baked"] = True
                        except Exception:
                            geom["static_bmp"] = None
                elif is_tall and pw <= 600.0 * dp:
                    strip = self._bake_pill_strip(geom, pw, ph, cr_key, thin_decor, clamp_top, style_idx)
                    if strip is not None:
                        geom["top_bmp_s"] = strip[0]
                        geom["top_pad_x"] = strip[1]
                        geom["top_pad_top"] = strip[2]
                        geom["bot_bmp_s"] = strip[3]
                        geom["bot_pad_x"] = strip[4]
                        geom["bot_off_y"] = strip[5]
                        geom["wire_baked"] = True
            self._glass_cache[key] = geom
        return geom

    def _on_glass_pill_after_draw(self, drawable: Any, canvas: Any):
        if drawable is None or canvas is None:
            return
        self._sync_settings_cache()
        if not self._cfg_glass_enabled:
            return
        if self._paint_fill is None or self._paint_stroke is None or self._linear_gradient_cls is None:
            return

        did = int(self._system_jcls.identityHashCode(drawable)) if self._system_jcls is not None else id(drawable)
        if did in self._handled_bg_ids or did in self._ignored_bg_ids:
            return
        if self._navbar_hook_status.endswith("OK") and (did in self._navbar_bg_ids or self._is_navbar_background(drawable)):
            if len(self._ignored_bg_ids) > 128:
                self._ignored_bg_ids.clear()
            self._ignored_bg_ids.add(did)
            return

        cb = None
        if self._pa_jcls is not None:
            try:
                cb = drawable.getCallback()
                if cb is not None and isinstance(cb, self._pa_jcls):
                    if len(self._ignored_bg_ids) > 128:
                        self._ignored_bg_ids.clear()
                    self._ignored_bg_ids.add(did)
                    return
            except Exception:
                pass

        try:
            alpha = int(drawable.getAlpha())
        except Exception:
            alpha = 255
        if alpha <= 5:
            return

        bounds = None
        try:
            bounds = drawable.getPaddedBounds()
        except Exception:
            pass
        if bounds is None:
            try:
                bounds = drawable.getBounds()
            except Exception:
                return
        if bounds is None:
            return

        pl = float(bounds.left)
        pt = float(bounds.top)
        pr = float(bounds.right)
        pb = float(bounds.bottom)
        pw = pr - pl
        ph = pb - pt
        dp = self._density_px

        if pw < 24.0 * dp or ph < 22.0 * dp or ph > 88.0 * dp or pw > 650.0 * dp:
            return

        pill_path = None
        try:
            p = drawable.getPath()
            if p is not None and not p.isEmpty():
                pill_path = p
        except Exception:
            pill_path = None

        self._glass_calls += 1
        alpha_f = min(1.0, max(0.0, alpha / 255.0))
        self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, alpha_f, draw_wash=True)

        if (self._cfg_navbar_style in (0, 2, 3) or self._cfg_glow_on) and alpha > 12:
            try:
                if cb is None:
                    cb = drawable.getCallback()
                if cb is not None and self._view_jcls is not None and self._view_jcls.isInstance(cb):
                    self._throttle_view_inval(cb, 0.070)
            except Exception:
                pass

    def _get_field_val(self, obj: Any, declaring_cls: Optional[Any], field_name: str, default: Any = None) -> Any:
        if obj is None:
            return default
        if declaring_cls is not None and hasattr(declaring_cls, "getDeclaredField"):
            cls_obj = declaring_cls
        else:
            cls_obj = obj.getClass()
        key = (int(self._system_jcls.identityHashCode(cls_obj)) if self._system_jcls is not None else id(cls_obj), field_name)
        fld = self._fields_cache.get(key)
        if fld is False:
            return default
        if fld is None:
            cur = cls_obj
            found = None
            while cur is not None:
                try:
                    found = cur.getDeclaredField(field_name)
                    found.setAccessible(True)
                    break
                except Exception:
                    try:
                        cur = cur.getSuperclass()
                    except Exception:
                        cur = None
            self._fields_cache[key] = found if found is not None else False
            fld = found
        if fld is None or fld is False:
            return default
        try:
            return fld.get(obj)
        except Exception:
            return default

    def _remember_handled_drawable(self, drawable: Any):
        if drawable is None or self._system_jcls is None:
            return
        try:
            if len(self._handled_bg_ids) > 64:
                self._handled_bg_ids.clear()
            self._handled_bg_ids.add(int(self._system_jcls.identityHashCode(drawable)))
        except Exception:
            pass

    def _extract_drawable_info(self, drawable: Any) -> Optional[Tuple[float, float, float, float, Optional[Any], float]]:
        if drawable is None:
            return None
        try:
            alpha = int(drawable.getAlpha())
        except Exception:
            alpha = 255
        if alpha <= 5:
            return None

        bounds = None
        try:
            b = drawable.getPaddedBounds()
            if b is not None and not b.isEmpty():
                bounds = b
        except Exception:
            pass
        if bounds is None:
            try:
                b = drawable.getBounds()
                if b is not None and not b.isEmpty():
                    bounds = b
            except Exception:
                return None
        if bounds is None:
            return None

        pill_path = None
        try:
            p = drawable.getPath()
            if p is not None and not p.isEmpty():
                pill_path = p
        except Exception:
            pill_path = None

        return (
            float(bounds.left),
            float(bounds.top),
            float(bounds.right),
            float(bounds.bottom),
            pill_path,
            min(1.0, max(0.0, alpha / 255.0)),
        )

    def _draw_glass_pill_rect(
        self,
        canvas: Any,
        pl: float,
        pt: float,
        pr: float,
        pb: float,
        pill_path: Optional[Any],
        alpha_f: float,
        *,
        draw_wash: bool = False,
        max_ph_dp: float = 88.0,
        corner_rad: Optional[float] = None,
        thin_decor: bool = False,
        rim_width_dp: float = 1.05,
        clamp_top_edge: Optional[bool] = None,
    ) -> bool:
        if alpha_f <= 0.02:
            return False
        pw = pr - pl
        ph = pb - pt
        dp = self._density_px
        if pw < 24.0 * dp or ph < 22.0 * dp or ph > max_ph_dp * dp or pw > 1200.0 * dp:
            return False

        clamp_top = clamp_top_edge if clamp_top_edge is not None else (pt <= 1.8 * dp)
        style_idx = self._cfg_navbar_style
        geom = self._get_glass_geometry(
            pw,
            ph,
            clamp_top=clamp_top,
            corner_rad=corner_rad,
            thin_decor=thin_decor,
            style_idx=style_idx,
            draw_wash=draw_wash,
            rim_width_dp=rim_width_dp,
            allow_bake=(pill_path is None),
        )
        palette = GARLAND_PALETTES[self._cfg_palette_idx]
        glow_on = self._cfg_glow_on
        t = self._advance_shared_clock()

        self._rect_glass.set(0.0, 0.0, pw, ph)
        local_path = None
        if pill_path is not None:
            if pl == 0.0 and pt == 0.0:
                local_path = pill_path
            elif self._path_pill_tmp is not None:
                try:
                    self._path_pill_tmp.reset()
                    pill_path.offset(-pl, -pt, self._path_pill_tmp)
                    local_path = self._path_pill_tmp
                except Exception:
                    local_path = None

        need_trans = pl != 0.0 or pt != 0.0
        if need_trans:
            canvas.save()
            canvas.translate(pl, pt)
        try:
            self._draw_pill_festive_overlay(
                canvas,
                self._rect_glass,
                local_path,
                geom,
                style_idx,
                palette,
                alpha_f,
                t,
                draw_wash=draw_wash,
                draw_sparkles=glow_on,
                rim_width_dp=rim_width_dp,
            )
        finally:
            if need_trans:
                canvas.restore()
        return True

    def _throttle_view_inval(self, view: Any, min_interval: float = 0.045):
        if not (self._cfg_navbar_style in (0, 2, 3) or self._cfg_glow_on):
            return
        try:
            if view.getVisibility() != 0 or not view.isAttachedToWindow() or not view.isShown():
                return
            vid = int(self._system_jcls.identityHashCode(view)) if self._system_jcls is not None else id(view)
            now = time.monotonic()
            if (now - self._glass_last_inval.get(vid, 0.0)) >= min_interval:
                if len(self._glass_last_inval) > 64:
                    self._glass_last_inval.clear()
                self._glass_last_inval[vid] = now
                view.postInvalidateOnAnimation()
        except Exception:
            pass

    def _on_view_pill_after_draw(self, mode: str, view: Any, canvas: Any):
        if view is None or canvas is None:
            return
        self._sync_settings_cache()
        if mode in ("profile_actions", "profile_avatar", "recycler"):
            if not self._cfg_profile_enabled:
                return
        elif not self._cfg_glass_enabled:
            return
        if self._paint_fill is None or self._paint_stroke is None or self._linear_gradient_cls is None:
            return

        if mode == "profile_actions":
            self._last_prof_actions_hook_t = time.monotonic()
        elif mode == "profile_avatar":
            self._last_prof_avatar_hook_t = time.monotonic()
        elif mode == "tabs":
            tid = int(self._system_jcls.identityHashCode(view)) if self._system_jcls is not None else id(view)
            now = time.monotonic()
            if (now - self._tabs_last_draw.get(tid, 0.0)) < 0.005:
                return
            if len(self._tabs_last_draw) > 32:
                self._tabs_last_draw.clear()
            self._tabs_last_draw[tid] = now

        try:
            if view.getVisibility() != 0:
                return
            view_alpha = float(view.getAlpha())
        except Exception:
            view_alpha = 1.0
        if view_alpha <= 0.05:
            return

        drew_any = False
        dp = self._density_px

        if mode == "actionbar":
            ab_cls = None
            try:
                ab_cls = view.getClass()
            except Exception:
                pass
            glass_only_back = bool(self._get_field_val(view, ab_cls, "glassOnlyBack", False))
            do_not_draw_menu = bool(self._get_field_val(view, ab_cls, "doNotDrawGlassMenu", False))
            back_btn = self._get_field_val(view, ab_cls, "backButtonImageView", None)
            has_back = False
            if back_btn is not None:
                try:
                    has_back = back_btn.getVisibility() == 0
                except Exception:
                    has_back = True

            candidates = []
            d_main = self._get_field_val(view, ab_cls, "glassDrawable", None)
            if d_main is not None and not glass_only_back:
                candidates.append(d_main)
            d_back = self._get_field_val(view, ab_cls, "glassDrawableBack", None)
            if d_back is not None and has_back:
                candidates.append(d_back)
            d_menu = self._get_field_val(view, ab_cls, "glassDrawableMenu", None)
            if d_menu is not None and not glass_only_back and not do_not_draw_menu:
                candidates.append(d_menu)

            if not candidates:
                if self._ab_extra_fields is None:
                    found_flds = []
                    try:
                        cur = ab_cls
                        while cur is not None and str(cur.getSimpleName()) not in ("FrameLayout", "ViewGroup", "View", "Object"):
                            for f in cur.getDeclaredFields():
                                try:
                                    f.setAccessible(True)
                                    val = f.get(view)
                                    if val is not None:
                                        cname = str(val.getClass().getSimpleName())
                                        if "Blurred" in cname or "GlassDrawable" in cname:
                                            found_flds.append(f)
                                except Exception:
                                    pass
                            cur = cur.getSuperclass()
                    except Exception:
                        pass
                    self._ab_extra_fields = found_flds
                for f in self._ab_extra_fields:
                    try:
                        val = f.get(view)
                        if val is not None:
                            candidates.append(val)
                    except Exception:
                        pass

            for d in candidates:
                self._remember_handled_drawable(d)
                info = self._extract_drawable_info(d)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    if self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, d_alpha * view_alpha, draw_wash=False):
                        drew_any = True

            if drew_any:
                self._view_calls += 1
                self._throttle_view_inval(view, 0.055)
            return

        if mode == "filters":
            d = None
            try:
                d = view.getBackground()
            except Exception:
                pass
            if d is None:
                d = self._get_field_val(view, None, "blurredBackgroundDrawable", None)
            if d is not None:
                self._remember_handled_drawable(d)
                info = self._extract_drawable_info(d)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    drew_any = self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, d_alpha * view_alpha, draw_wash=False)
            else:
                w = float(view.getWidth())
                h = float(view.getHeight())
                pad = 9.0 * dp
                if w > pad * 2.0 + 40.0 * dp and 22.0 * dp <= (h - pad * 2.0) <= 88.0 * dp:
                    drew_any = self._draw_glass_pill_rect(canvas, pad, pad, w - pad, h - pad, None, view_alpha, draw_wash=False)

            if drew_any:
                self._view_calls += 1
                self._throttle_view_inval(view, 0.048)
            return

        if mode == "search":
            d_blur = self._get_field_val(view, None, "blurredBackgroundDrawable", None)
            d_bg = self._get_field_val(view, None, "bg", None)
            drew = False
            if d_blur is not None:
                self._remember_handled_drawable(d_blur)
                info = self._extract_drawable_info(d_blur)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    drew = self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, d_alpha * view_alpha, draw_wash=False)
            if not drew and d_bg is not None:
                info = self._extract_drawable_info(d_bg)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    drew = self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, d_alpha * view_alpha, draw_wash=False)
                else:
                    w = float(view.getWidth())
                    h = float(view.getHeight())
                    pl = float(view.getPaddingLeft())
                    pt = float(view.getPaddingTop())
                    pr = w - float(view.getPaddingRight())
                    pb = h - float(view.getPaddingBottom())
                    drew = self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, None, view_alpha, draw_wash=False)

            if drew:
                self._view_calls += 1
                self._throttle_view_inval(view, 0.048)
            return

        if mode == "tabs":
            d = None
            try:
                d = view.getBackground()
            except Exception:
                pass
            if d is None:
                d = self._get_field_val(view, None, "blurredBackgroundDrawable", None)
            if d is not None:
                self._remember_handled_drawable(d)
                info = self._extract_drawable_info(d)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    if self._draw_glass_pill_rect(canvas, pl, pt, pr, pb, pill_path, d_alpha * view_alpha, draw_wash=False):
                        self._view_calls += 1
                        self._throttle_view_inval(view, 0.048)
            return

        if mode == "chatinput":
            draw_bg = bool(self._get_field_val(view, None, "drawInputBackground", True))
            if not draw_bg:
                return
            d = self._get_field_val(view, None, "blurredBackgroundDrawable", None)
            if d is not None:
                self._remember_handled_drawable(d)
                info = self._extract_drawable_info(d)
                if info is not None:
                    pl, pt, pr, pb, pill_path, d_alpha = info
                    if self._draw_glass_pill_rect(
                        canvas,
                        pl,
                        pt,
                        pr,
                        pb,
                        pill_path,
                        d_alpha * view_alpha,
                        draw_wash=False,
                        max_ph_dp=120.0,
                    ):
                        self._view_calls += 1
                        self._throttle_view_inval(view, 0.050)
            return

        if mode == "profile_actions":
            if self._draw_profile_actions_view(view, canvas, view_alpha, apply_clip=False):
                self._last_prof_actions_draw_t = time.monotonic()
                self._view_calls += 1
                self._throttle_view_inval(view, 0.095)
            return

        if mode == "profile_avatar":
            if self._draw_profile_avatar_view(view, canvas, view_alpha):
                self._last_prof_avatar_draw_t = time.monotonic()
                self._view_calls += 1
                self._throttle_view_inval(view, 0.095)
            return

        if mode == "recycler":
            if self._draw_profile_section_cards(view, canvas, view_alpha):
                self._view_calls += 1
                self._throttle_view_inval(view, 0.180)

    def _draw_profile_actions_view(self, view: Any, canvas: Any, view_alpha: float, *, apply_clip: bool) -> bool:
        if view is None or canvas is None or view_alpha <= 0.05:
            return False
        dp = self._density_px
        pa_cls = None
        try:
            pa_cls = view.getClass()
        except Exception:
            pass

        pa_id = int(self._system_jcls.identityHashCode(view)) if self._system_jcls is not None else id(view)
        if pa_id not in self._pa_handled_ids:
            glass_list = self._get_field_val(view, pa_cls, "glass", None)
            if glass_list is not None:
                try:
                    for gi in range(int(glass_list.size())):
                        self._remember_handled_drawable(glass_list.get(gi))
                    if len(self._pa_handled_ids) > 32:
                        self._pa_handled_ids.clear()
                    self._pa_handled_ids.add(pa_id)
                except Exception:
                    pass

        clip_h = float(self._get_field_val(view, pa_cls, "clipHeight", -1.0))
        ypadding = float(self._get_field_val(view, pa_cls, "ypadding", 0.0))
        top_pad = float(self._get_field_val(view, pa_cls, "top", 0.0))
        clip_bottom = -1.0
        if clip_h >= 0.0:
            try:
                clip_bottom = clip_h - float(view.getY())
            except Exception:
                clip_bottom = clip_h
            if clip_bottom <= 0.0:
                return False

        cur_h = float(self._get_field_val(view, pa_cls, "currentHeight", 0.0))
        if cur_h <= 0.0:
            try:
                cur_h = float(view.getHeight())
            except Exception:
                cur_h = 0.0
        tgt_h = float(self._get_field_val(view, pa_cls, "targetHeight", 1.0))
        height = max(0.0, cur_h - ypadding - top_pad)
        if height <= 0.0 or tgt_h <= 0.0:
            return False
        fraction = min(1.0, max(0.0, height / tgt_h))
        alpha_frac = min(1.0, max(0.0, (fraction - 0.2) / 0.8))
        if alpha_frac <= 0.05:
            return False

        try:
            corner_r = float(view.getRoundRadius())
        except Exception:
            corner_r = 16.0 * dp

        actions = self._get_field_val(view, pa_cls, "actions", None)
        if actions is None:
            return False

        did_save = False
        if apply_clip and clip_bottom > 0.0:
            try:
                canvas.save()
                canvas.clipRect(0.0, 0.0, float(view.getWidth()), clip_bottom)
                did_save = True
            except Exception:
                did_save = False

        drew_any = False
        try:
            count = int(actions.size())
            for i in range(count):
                act = actions.get(i)
                if act is None or bool(self._get_field_val(act, None, "isDeleted", False)):
                    continue
                rect = self._get_field_val(act, None, "rect", None)
                if rect is None:
                    continue
                pl = float(rect.left)
                pt = float(rect.top)
                pr = float(rect.right)
                pb = float(rect.bottom)
                pw = pr - pl
                ph = pb - pt
                if pw < 24.0 * dp or ph < 22.0 * dp:
                    continue
                try:
                    sc = float(act.getScale())
                except Exception:
                    sc = 1.0
                try:
                    act_a = float(act.getAlpha())
                except Exception:
                    act_a = 1.0

                ref_key = (pa_id << 8) | (i & 0xFF)
                ref = self._pa_ref_sizes.get(ref_key)
                if fraction > 0.97:
                    if ref is None or abs(ref[0] - pw) > 2.0 or abs(ref[1] - ph) > 2.0:
                        if len(self._pa_ref_sizes) > 48:
                            self._pa_ref_sizes.clear()
                        self._pa_ref_sizes[ref_key] = (pw, ph)
                        ref = (pw, ph)

                if ref is not None and (sc < 0.999 or ph < ref[1] * 0.98 or pw < ref[0] * 0.98):
                    rw, rh = ref
                    sx = (pw / rw) * sc
                    sy = (ph / rh) * sc
                    cx_btn = (pl + pr) * 0.5
                    cy_btn = (pt + pb) * 0.5
                    tx = cx_btn - rw * 0.5 * sx
                    ty = cy_btn - rh * 0.5 * sy
                    canvas.save()
                    canvas.translate(tx, ty)
                    canvas.scale(sx, sy)
                    try:
                        if self._draw_glass_pill_rect(
                            canvas,
                            0.0,
                            0.0,
                            rw,
                            rh,
                            None,
                            act_a * alpha_frac * view_alpha,
                            draw_wash=False,
                            max_ph_dp=120.0,
                            corner_rad=corner_r,
                            thin_decor=True,
                            rim_width_dp=1.15,
                            clamp_top_edge=(pt <= 1.8 * dp),
                        ):
                            drew_any = True
                    finally:
                        canvas.restore()
                else:
                    if self._draw_glass_pill_rect(
                        canvas,
                        pl,
                        pt,
                        pr,
                        pb,
                        None,
                        act_a * alpha_frac * view_alpha,
                        draw_wash=False,
                        max_ph_dp=120.0,
                        corner_rad=corner_r,
                        thin_decor=True,
                        rim_width_dp=1.15,
                    ):
                        drew_any = True
        finally:
            if did_save:
                canvas.restore()
        return drew_any

    def _draw_profile_avatar_view(self, view: Any, canvas: Any, view_alpha: float) -> bool:
        if view is None or canvas is None or view_alpha <= 0.05:
            return False
        dp = self._density_px
        try:
            w = float(view.getWidth())
            h = float(view.getHeight())
            if w <= 0.0 or h <= 0.0:
                w = float(view.getMeasuredWidth())
                h = float(view.getMeasuredHeight())
        except Exception:
            return False
        if w < 38.0 * dp or h < 38.0 * dp or abs(w - h) > 12.0 * dp:
            return False

        ava_cls = None
        try:
            ava_cls = view.getClass()
        except Exception:
            pass
        p_expand = float(self._get_field_val(view, ava_cls, "progressToExpand", 0.0))
        if p_expand >= 0.55:
            return False

        fade = min(1.0, max(0.0, (0.55 - p_expand) / 0.35)) * view_alpha
        has_stories = bool(self._get_field_val(view, ava_cls, "hasStories", False))
        p_insets = float(self._get_field_val(view, ava_cls, "progressToInsets", 1.0))
        fg_alpha = float(self._get_field_val(view, ava_cls, "foregroundAlpha", 0.0))
        inset = (int(3.5 * dp) if has_stories else 0.0) * (1.0 - p_expand) * p_insets * (1.0 - fg_alpha)
        return self._draw_avatar_festive_ring(canvas, w, h, inset, fade)

    def _get_active_profile_fragment(self) -> Optional[Any]:
        try:
            frag = get_last_fragment()
            if frag is None:
                return None
            if str(frag.getClass().getSimpleName()) == "ProfileActivity":
                return frag
            try:
                sub = frag.getCurrentVisibleFragment()
                if sub is not None and str(sub.getClass().getSimpleName()) == "ProfileActivity":
                    return sub
            except Exception:
                pass
            arr = self._get_field_val(frag, None, "fragmentsArr", None)
            if arr is not None:
                try:
                    sz = int(arr.size())
                    for idx in range(sz):
                        st = arr.valueAt(idx)
                        f = self._get_field_val(st, None, "fragment", None) if st is not None else None
                        if f is not None and str(f.getClass().getSimpleName()) == "ProfileActivity":
                            fv = f.getFragmentView()
                            if fv is not None and fv.isShown():
                                return f
                except Exception:
                    pass
        except Exception:
            pass
        return None

    def _classify_profile_view(self, view: Any) -> Optional[str]:
        if view is None:
            return None
        try:
            if self._pa_jcls is not None and isinstance(view, self._pa_jcls):
                return "actions"
            if self._ava_jcls is not None and isinstance(view, self._ava_jcls):
                return "avatar"
            cur = view.getClass()
            depth = 0
            while cur is not None and depth < 3:
                sname = str(cur.getSimpleName())
                if sname == "ProfileActionsView":
                    return "actions"
                if sname == "AvatarImageView":
                    return "avatar"
                cur = cur.getSuperclass()
                depth += 1
        except Exception:
            pass
        return None

    def _scan_profile_views_in_root(
        self,
        root: Any,
        *,
        require_shown: bool = True,
        max_depth: int = 8,
        max_nodes: int = 80,
    ) -> Tuple[Optional[Any], Optional[Any]]:
        if root is None:
            return (None, None)
        found_actions = None
        found_avatar = None
        vg_cls = self._vg_jcls
        rlv_cls = self._rlv_jcls
        queue = [(root, 0)]
        idx = 0
        while idx < len(queue) and idx < max_nodes:
            node, depth = queue[idx]
            idx += 1
            if node is None:
                continue
            try:
                if int(node.getVisibility()) != 0 or float(node.getAlpha()) <= 0.05:
                    continue
                if require_shown and (not node.isAttachedToWindow() or not node.isShown()):
                    continue
            except Exception:
                continue

            kind = self._classify_profile_view(node)
            if kind == "actions" and found_actions is None:
                found_actions = node
            elif kind == "avatar" and found_avatar is None:
                found_avatar = node
            if found_actions is not None and found_avatar is not None:
                break

            if depth >= max_depth:
                continue
            if rlv_cls is not None and node is not root:
                try:
                    if isinstance(node, rlv_cls):
                        continue
                except Exception:
                    pass
            is_vg = False
            try:
                is_vg = vg_cls.isInstance(node) if vg_cls is not None else hasattr(node, "getChildCount")
            except Exception:
                is_vg = False
            if not is_vg:
                continue
            try:
                cnt = int(node.getChildCount())
                for ci in range(cnt):
                    ch = node.getChildAt(ci)
                    if ch is not None:
                        queue.append((ch, depth + 1))
            except Exception:
                pass
        return (found_actions, found_avatar)

    def _draw_profile_backup_if_needed(self, layout: Any, canvas: Any):
        if not self._cfg_profile_enabled or self._pa_ava_native_ok:
            return
        if self._paint_fill is None or self._paint_stroke is None or self._linear_gradient_cls is None:
            return
        if self._loc_layout is None or self._loc_target is None or self._view_jcls is None:
            return

        now = time.monotonic()
        need_actions = (now - self._last_prof_actions_hook_t) > 0.35
        need_avatar = (now - self._last_prof_avatar_hook_t) > 0.35
        if not (need_actions or need_avatar):
            return

        frag_t, cached_frag = self._backup_frag_cache
        if (now - frag_t) > 0.35:
            cached_frag = self._get_active_profile_fragment()
            self._backup_frag_cache = (now, cached_frag)
        frag = cached_frag
        if frag is None:
            return

        if self._get_field_val(frag, None, "avatarBig", None) is not None:
            return
        ava_v = self._get_field_val(frag, None, "avatarImage", None) if need_avatar else None
        act_v = self._get_field_val(frag, None, "actionsView", None) if need_actions else None

        targets = []
        if need_avatar and ava_v is not None:
            targets.append(("avatar", ava_v))
        if need_actions and act_v is not None:
            targets.append(("actions", act_v))
        if not targets:
            return

        layout.getLocationInWindow(self._loc_layout)
        lx = float(self._loc_layout[0])
        ly = float(self._loc_layout[1])

        any_drew = False
        for kind, view in targets:
            try:
                if int(view.getVisibility()) != 0 or not view.isAttachedToWindow() or not view.isShown():
                    continue
                eff_a = 1.0
                eff_sx = 1.0
                eff_sy = 1.0
                cur = view
                steps = 0
                ok = True
                while cur is not None and cur != layout and steps < 16:
                    if int(cur.getVisibility()) != 0:
                        ok = False
                        break
                    eff_a *= float(cur.getAlpha())
                    eff_sx *= float(cur.getScaleX())
                    eff_sy *= float(cur.getScaleY())
                    if eff_a <= 0.05 or eff_sx <= 0.15 or eff_sy <= 0.15:
                        ok = False
                        break
                    p = cur.getParent()
                    cur = p if (p is not None and self._view_jcls.isInstance(p)) else None
                    steps += 1
                if not ok:
                    continue
                if kind == "avatar" and eff_sx < 0.60:
                    continue

                view.getLocationInWindow(self._loc_target)
                dx = float(self._loc_target[0]) - lx
                dy = float(self._loc_target[1]) - ly

                canvas.save()
                canvas.translate(dx, dy)
                if abs(eff_sx - 1.0) > 0.005 or abs(eff_sy - 1.0) > 0.005:
                    canvas.scale(eff_sx, eff_sy)
                drew = False
                try:
                    if kind == "avatar":
                        drew = self._draw_profile_avatar_view(view, canvas, eff_a)
                    else:
                        drew = self._draw_profile_actions_view(view, canvas, eff_a, apply_clip=True)
                finally:
                    canvas.restore()

                if drew:
                    self._view_calls += 1
                    any_drew = True
            except Exception:
                pass
        if any_drew and not self._cfg_snow_enabled:
            self._throttle_view_inval(layout, 0.055)

    def _is_profile_section_rv(self, rv: Any) -> bool:
        if rv is None or not self._cfg_profile_enabled:
            return False
        rv_id = int(self._system_jcls.identityHashCode(rv)) if self._system_jcls is not None else id(rv)
        now = time.monotonic()
        cached = self._profile_rv_cache.get(rv_id)
        if cached is not None:
            is_prof, ts = cached
            if is_prof or (now - ts) < 3.0:
                return is_prof
        if len(self._profile_rv_cache) > 64:
            self._profile_rv_cache.clear()

        # Отсекаем все списки без секционных декораторов (внутренние вкладки медиа, чаты и т.д.)
        has_sections = (
            self._get_field_val(rv, None, "isSectionView", None) is not None
            or self._get_field_val(rv, None, "bitmapSectionsItemDecoration", None) is not None
            or self._get_field_val(rv, None, "sectionsItemDecoration", None) is not None
        )
        if not has_sections:
            self._profile_rv_cache[rv_id] = (False, now)
            return False

        matched = False
        try:
            frag = self._get_active_profile_fragment()
            if frag is not None:
                fv = frag.getFragmentView()
                if fv is not None:
                    cur = rv.getParent()
                    steps = 0
                    while cur is not None and steps < 8:
                        if cur == fv:
                            matched = True
                            break
                        cur = cur.getParent()
                        steps += 1
            if not matched:
                p1 = rv.getParent()
                if p1 is not None:
                    act_v, ava_v = self._scan_profile_views_in_root(p1, require_shown=False, max_depth=6, max_nodes=48)
                    if act_v is not None or ava_v is not None:
                        matched = True
        except Exception:
            pass
        self._profile_rv_cache[rv_id] = (matched, now)
        return matched

    def _draw_profile_section_cards(self, rv: Any, canvas: Any, view_alpha: float) -> bool:
        if rv is None or canvas is None:
            return False
        if not self._is_profile_section_rv(rv):
            return False

        is_sec_cb = self._get_field_val(rv, None, "isSectionView", None)
        decor = None
        if is_sec_cb is None:
            decor = (
                self._get_field_val(rv, None, "bitmapSectionsItemDecoration", None)
                or self._get_field_val(rv, None, "sectionsItemDecoration", None)
            )
            if decor is not None:
                is_sec_cb = (
                    self._get_field_val(decor, None, "isSectionView", None)
                    or self._get_field_val(decor, None, "isSectionItem", None)
                )
        if is_sec_cb is None and decor is None:
            return False

        dp = self._density_px
        rv_id = int(self._system_jcls.identityHashCode(rv)) if self._system_jcls is not None else id(rv)
        meta = self._rv_meta_cache.get(rv_id)
        if meta is None:
            sec_rad = float(self._get_field_val(rv, None, "sectionRadius", 16.0 * dp))
            if sec_rad <= 0.0:
                sec_rad = 16.0 * dp
            empty_view = self._get_field_val(rv, None, "emptyView", None)
            if len(self._rv_meta_cache) > 32:
                self._rv_meta_cache.clear()
            self._rv_meta_cache[rv_id] = (sec_rad, empty_view)
        else:
            sec_rad, empty_view = meta
        rv_w = float(rv.getWidth())
        rv_h = float(rv.getHeight())
        if rv_w <= 0.0 or rv_h <= 0.0:
            return False

        drew_any = False
        grp_start = None
        grp_top = 0.0
        grp_bot = 0.0
        grp_alpha = 1.0

        def _flush():
            nonlocal drew_any, grp_start
            if grp_start is None:
                return
            try:
                pl = float(grp_start.getLeft()) + float(grp_start.getTranslationX())
                pr = float(grp_start.getRight()) + float(grp_start.getTranslationX())
                if (
                    pl >= 4.0 * dp
                    and (rv_w - pr) >= 4.0 * dp
                    and pr - pl >= 120.0 * dp
                    and grp_bot - grp_top >= 28.0 * dp
                    and grp_bot > 0.0
                    and grp_top < rv_h
                ):
                    if self._draw_glass_pill_rect(
                        canvas,
                        pl,
                        grp_top,
                        pr,
                        grp_bot,
                        None,
                        min(1.0, grp_alpha) * view_alpha,
                        draw_wash=False,
                        max_ph_dp=1800.0,
                        corner_rad=sec_rad,
                        thin_decor=True,
                        rim_width_dp=1.20,
                    ):
                        drew_any = True
            except Exception:
                pass
            grp_start = None

        sys_cls = self._system_jcls
        skip_cache = self._rv_child_skip_cache
        min_inset = 4.0 * dp
        n = int(rv.getChildCount())
        for i in range(n):
            child = rv.getChildAt(i)
            if child is None or child == empty_view:
                _flush()
                continue
            try:
                if int(child.getVisibility()) != 0:
                    _flush()
                    continue
                ca = float(child.getAlpha())
                if ca <= 0.05:
                    _flush()
                    continue
                cl = float(child.getLeft())
                cr = float(child.getRight())
                if cl < min_inset or (rv_w - cr) < min_inset:
                    _flush()
                    continue
                c_cls = child.getClass()
                c_cid = int(sys_cls.identityHashCode(c_cls)) if sys_cls is not None else id(c_cls)
                skip = skip_cache.get(c_cid)
                if skip is None:
                    cfull = str(c_cls.getName())
                    cname = str(c_cls.getSimpleName())
                    skip = (
                        "SharedMedia" in cfull
                        or "ViewPagerFixed" in cname
                        or cname in ("ShadowSectionCell", "HeaderCell", "TextInfoPrivacyCell", "DividerCell", "TabsView", "EmptyCell")
                    )
                    if len(skip_cache) > 64:
                        skip_cache.clear()
                    skip_cache[c_cid] = skip
                if skip:
                    _flush()
                    continue
                if is_sec_cb is not None:
                    res = is_sec_cb.run(child)
                    is_sec = bool(res.booleanValue()) if hasattr(res, "booleanValue") else bool(res)
                else:
                    is_sec = child.getTag() is None
            except Exception:
                _flush()
                continue
            if not is_sec:
                _flush()
                continue

            cy = float(child.getY())
            cb = cy + float(child.getHeight())
            if grp_start is not None:
                if abs(grp_alpha - ca) > 0.10 or cy > grp_bot + 10.0 * dp or cb < grp_top - 10.0 * dp:
                    _flush()
            if grp_start is None:
                grp_start = child
                grp_top = cy
                grp_bot = cb
                grp_alpha = ca
            else:
                grp_top = min(grp_top, cy)
                grp_bot = max(grp_bot, cb)

        _flush()
        return drew_any

    def _invalidate_target(self, target: Any):
        try:
            target.setWillNotDraw(False)
        except Exception:
            pass
        try:
            target.invalidate()
        except Exception:
            pass

    def _refresh_screen(self, *_args):
        def _invalidate():
            try:
                if self._last_navbar is not None:
                    self._invalidate_target(self._last_navbar)
                fragment = get_last_fragment()
                if fragment is not None:
                    try:
                        ab = fragment.getActionBar()
                        if ab is not None:
                            ab.invalidate()
                    except Exception:
                        pass
                    try:
                        fv = fragment.getFragmentView()
                        if fv is not None:
                            fv.invalidate()
                    except Exception:
                        pass
                prof = self._get_active_profile_fragment()
                if prof is not None and prof != fragment:
                    try:
                        pfv = prof.getFragmentView()
                        if pfv is not None:
                            pfv.invalidate()
                    except Exception:
                        pass
                if self._last_layout is not None:
                    self._invalidate_target(self._last_layout)
                    return
                if fragment is not None:
                    parent = fragment.getParentLayout()
                    if parent is not None:
                        dlc = parent.getDrawerLayoutContainer()
                        if dlc is not None:
                            self._invalidate_target(dlc)
                            return
                        view = parent.getView()
                        if view is not None:
                            p = view.getParent()
                            self._invalidate_target(p if p is not None else view)
            except Exception:
                pass

        run_on_ui_thread(_invalidate)

    def _on_setting_change(self, *_args):
        self._sync_settings_cache(force=True)
        self._refresh_screen()

    def _on_physics_change(self, *_args):
        self._sync_settings_cache(force=True)

