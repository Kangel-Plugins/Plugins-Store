    def depth_dialog(self):
        try:
            activity = get_last_fragment().getParentActivity()
            if not activity:
                return
            layout = LinearLayout(activity)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(16), AndroidUtilities.dp(24), AndroidUtilities.dp(16))
            edit = EditText(activity)
            edit.setText(str(self.get_depth()))
            edit.setHint("Глубина контекста (10-100)")
            edit.setInputType(InputType.TYPE_CLASS_NUMBER)
            layout.addView(edit, -1, -2)

            def save(builder, which):
                try:
                    val = int(str(edit.getText()).strip())
                    val = max(10, min(100, val))
                    self.set_setting("context_depth", str(val), reload_settings=True)
                    with self.lock:
                        self.context_cache.clear()
                except:
                    pass
                builder.dismiss()
                self.show_toast("Сохранено")

            builder = AlertDialogBuilder(activity)
            builder.set_title("Глубина контекста")
            builder.set_view(layout)
            builder.set_positive_button("Сохранить", save)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
        except:
            pass

    def add_chat(self):
        try:
            activity = get_last_fragment().getParentActivity()
            if not activity:
                return
            layout = LinearLayout(activity)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(16), AndroidUtilities.dp(24), AndroidUtilities.dp(16))
            edit = EditText(activity)
            edit.setInputType(InputType.TYPE_CLASS_NUMBER)
            edit.setHint("ID чата (123456789)")
            layout.addView(edit, -1, -2)

            def save(builder, which):
                target = str(edit.getText()).strip()
                if target and target.lstrip("-").isdigit():
                    chat_list = self.get_chats()
                    if not any(str(chat.get("id")) == target for chat in chat_list):
                        chat_list.append({
                            "id": target, "enabled": True,
                            "min_delay": 20, "max_delay": 300,
                            "reply_chance": 100, "initiate_chance": 15,
                            "initiate_interval": 45, "system_prompt": "",
                            "custom_personality": "",
                            "last_ai_activity": 0
                        })
                        self.save_chats(chat_list)
                        self.set_setting("_chat_ts", int(now()), reload_settings=True)
                builder.dismiss()

            builder = AlertDialogBuilder(activity)
            builder.set_title("Добавить чат")
            builder.set_view(layout)
            builder.set_positive_button("Добавить", save)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
        except:
            pass

    def open_url(self, url):
        try:
            context = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        except:
            pass

    def open_telegram(self, username):
        try:
            context = ApplicationLoader.applicationContext
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(f"tg://resolve?domain={username}"))
            intent.setPackage(context.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        except:
            pass

    def show_docs(self):
        try:
            activity = get_last_fragment().getParentActivity()
            if not activity:
                return
            scroll = ScrollView(activity)
            textview = TextView(activity)
            doc_text = (
                "ДОКУМЕНТАЦИЯ\n\n"
                "1. Как работает:\n"
                "   Плагин является клоном тебя, он перехватывает входящие сообщения, может писать первым и вызываться принудительно. Тобиш все делает от твоего лица (читает сообщения собеседника, показывает статус typing и тд). Для чего это нужно? В основном чтобы поугорать, но применений достаточно много, например, автоматизировать рутинную работу с клиентами или пикапить девочек\n\n"
                "2. Управление чатами:\n"
                "   Для начала добавь ID чата через кнопку 'Добавить новый ID'. Ии работает только в введенных чатах и только если статус 'AI: вкл'\n\n"
                "3. API и какие ии используются:\n"
                "   Основная модель: nvidia/nemotron-3-ultra-550b-a55b, 550 млрд параметров эт мощно для фри плана, к слову, используется цепочка моделей с фоллбеком, т.к. модели на опенроутер часто удаляются/не работают\n\n"
                "4. Настройки:\n"
                "   В основных настройках можно добавить пожелания к стилю общения ии, которые уйдут в глобальный промпт и изменить колво сообщений контекста на чат, не ставь слишком большой параметр, т.к. будет лагать. Для расширенных настроек: нажми на чат в настройках плагина, который хочешь настроить -> «Настройки чата» -> там много разных параметров, если не разбираешься лучше закинь ии и спроси\n"
            )
            textview.setText(doc_text)
            textview.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(16), AndroidUtilities.dp(16), AndroidUtilities.dp(16))
            textview.setTextSize(1, 14)
            textview.setTextIsSelectable(True)
            scroll.addView(textview)

            builder = AlertDialogBuilder(activity)
            builder.set_title("Документация")
            builder.set_view(scroll)
            builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
            builder.show()
        except:
            pass

    def show_welcome(self):
        try:
            if self.get_setting("welcome_shown", False):
                return
            activity = get_last_fragment().getParentActivity()
            if not activity:
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("AiClone")
            builder.set_message("Подпишись плиз там беты и тд")

            def on_hide(builder, which):
                self.set_setting("welcome_shown", True)
                builder.dismiss()

            def on_channel(builder, which):
                self.set_setting("welcome_shown", True)
                self.open_telegram("HzzzPlugins")
                builder.dismiss()

            builder.set_positive_button("Перейти в канал 💅", on_channel)
            builder.set_negative_button("Скрыть", on_hide)
            builder.show()
        except:
            pass

    def create_settings(self):
        key = self.get_setting("api_key", "")
        if not key:
            settings = [Header(text="AiClone")]
            settings.append(Divider(text="Что тебе делать? Есть сервис openrouter,который бесплатно дает апи для ии. Перейди туда по кнопке «Получить API key», зарегестрируйся через гугл и создай апи ключ (не забудь скопировать). Затем вставь его по кнопке «Вставить API key» и тебе откроется полный интерфейс плагина"))
            settings.append(Divider(text="Если ваще не понимаешь шо да как,то скинь код плагина ии и попроси обьяснить"))
            settings.append(Divider(text="ᅠ"))
            settings.append(Text(text="Вставить API Key", subtext="Введи свой ключ от OpenRouter", on_click=lambda v: self.api_dialog()))
            settings.append(Text(text="Получить API Key", subtext="Перейти на openrouter.ai", on_click=lambda v: self.open_url("https://openrouter.ai/keys")))
            settings.append(Divider(text="ᅠ"))
            settings.append(Text(text="Канал: @HzzzPlugins", on_click=lambda v: self.open_telegram("HzzzPlugins")))
            settings.append(Text(text="Создатель: @exoseo", on_click=lambda v: self.open_telegram("exoseo")))
            return settings

        settings = [Header(text="AiClone by @exoseo | 0.3.6-public beta")]

        settings.append(Text(text="Документация", subtext="описание функций и логики работы", on_click=lambda v: self.show_docs()))

        settings.append(Text(text="API Key", subtext="••••••" + key[-4:], on_click=lambda v: self.api_dialog()))
        settings.append(Text(text="Получить API", subtext="openrouter.ai", on_click=lambda v: self.open_url("https://openrouter.ai/keys")))

        settings.append(Divider(text="ᅠ"))
        settings.append(Header(text="Список активных чатов"))

        chats = self.get_chats()
        if chats:
            for chat in chats:
                cid = chat.get("id", "")
                status = "вкл | ai работает" if chat.get("enabled") else "выкл | ai не работает"
                settings.append(Text(text=f"{cid} - {status}", subtext="Нажми для управления", on_click=lambda v, item=chat: self.chat_menu(item)))
        else:
            settings.append(Text(text="Нет активных чатов", icon="msg_info"))

        settings.append(Text(text="Добавить новый ID", on_click=lambda v: self.add_chat()))
        settings.append(Divider(text="Важно: не используй плагин в переписках с важными и конфиденциальными данными. OpenRouter популярный сервис,но кто знает,что может произойти"))
        settings.append(Header(text="Настройки"))
        settings.append(Text(text="Глубина контекста", subtext=f"{self.get_depth()} сообщений", on_click=lambda v: self.depth_dialog()))
        settings.append(Text(text="Кастомная личность", subtext="добавь пожелания к поведению ии", on_click=lambda v: self.personality_dialog()))

        settings.append(Divider(text="ᅠ"))
        settings.append(Header(text="Последние логи (нажимай шоб смотреть)"))

        logs = self.fetch_logs(5)
        if logs:
            for entry in logs:
                full = f"{entry['time']} [{entry['tag']}] - {entry['dialog_id']} - {entry['message']}"
                settings.append(Text(text=full, on_click=lambda v, msg=entry['message']: self.log_dialog(msg)))
        else:
            settings.append(Text(text="Логи пусты"))

        settings.append(Divider(text="ᅠ"))
        settings.append(Text(text="Канал: @HzzzPlugins", on_click=lambda v: self.open_telegram("HzzzPlugins")))
        settings.append(Text(text="Создатель: @exoseo", on_click=lambda v: self.open_telegram("exoseo")))
        return settings

    def log_dialog(self, message):
        try:
            activity = get_last_fragment().getParentActivity()
            if not activity:
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("Лог")
            builder.set_message(message)
            builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
            builder.show()
        except:
            pass


plugin = AiClonePlugin()