def file_property_rows(result, lang, file_size=0):
    """Source facts only: decoded PCM depth is not the original file's bit depth."""
    copy, info = UI_COPY[lang], result.info
    rate = localized_number(info.rate / 1000, lang).removesuffix(',0' if lang == 'ru' else '.0')
    channels = copy['mono'] if info.channels == 1 else copy['stereo'] if info.channels == 2 else str(info.channels)
    rows = [(copy['format'], audio_format_name(info.mime)),
            (copy['rate'], rate + ' ' + STRINGS[lang]['khz'])]
    if info.source_bits:
        rows.append((copy['depth'], '%d %s' % (info.source_bits, STRINGS[lang]['bit'])))
    rows.extend(((copy['channel_label'], channels), (copy['duration'], duration_label(result.duration))))
    if file_size > 0:
        rows.append((copy['size'], localized_number(file_size / (1024 * 1024), lang) + ' ' + copy['mb']))
    return rows


def sheet_text(owner, parent, value, size, key, strong=False, top=4, bottom=4):
    AU = jclass('org.telegram.messenger.AndroidUtilities')
    view = jclass('android.widget.TextView')(owner.activity)
    view.setText(value); view.setTextSize(float(size)); view.setTextColor(owner.text_color(key))
    view.setPadding(AU.dp(21), AU.dp(top), AU.dp(21), AU.dp(bottom))
    if strong:
        view.setTypeface(AU.bold())
    view.setLineSpacing(float(AU.dp(2)), 1.0)
    parent.addView(view, jclass('android.widget.LinearLayout$LayoutParams')(-1, -2))
    owner.labels.append((view, key))
    return view


def clear_sheet_dismiss_listener(sheet):
    # BottomSheet overloads this method with Runnable. Plain None is ambiguous.
    sheet.setOnDismissListener(cast(jclass('android.content.DialogInterface$OnDismissListener'), None))


def sheet_button(owner, parent, value, method):
    AU = jclass('org.telegram.messenger.AndroidUtilities')
    button = jclass('org.telegram.ui.Stories.recorder.ButtonWithCounterView')(owner.activity, owner.provider).setRound()
    button.setText(value); button.setContentDescription(value)
    button.setOnClickListener(session_click(owner, method))
    params = jclass('android.widget.LinearLayout$LayoutParams')(-1, AU.dp(48))
    params.setMargins(AU.dp(16), AU.dp(8), AU.dp(16), AU.dp(8))
    parent.addView(button, params)
    owner.click_views.append(button)
    return button


def sheet_container(owner, viewport_height=None):
    Layout = jclass('android.widget.LinearLayout')
    owner.container = Layout(owner.activity); owner.container.setOrientation(1)
    owner.root = Layout(owner.activity); owner.root.setOrientation(1)
    owner.scroll = sheet_scroll_class().new_instance(owner.activity)
    owner.scroll.session = owner
    owner.scroll.java.setFillViewport(False)
    owner.scroll.java.setClipToPadding(False)
    owner.scroll.java.addView(owner.root)
    height = -2 if viewport_height is None else jclass('org.telegram.messenger.AndroidUtilities').dp(viewport_height)
    owner.container.addView(owner.scroll.java, Layout.LayoutParams(-1, height, 1.0))


class FileInfoSheet:
    """Native properties sheet with mutually exclusive disclosure sections."""
    def __init__(self, session):
        self.owner = weakref.ref(session)
        self.plugin, self.activity, self.provider = session.plugin, session.activity, session.provider
        self.lang, self.strings = session.lang, session.strings
        self.cancel = threading.Event()
        self.sheet = self.graph = self.scroll = None
        self.labels, self.cells, self.click_views, self.disclosures = [], [], [], []
        self.button = None
        self.expanded_index = None
        self.animation_generation = 0
        self.animations_started = False

    def color(self, key):
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        return Theme.getColor(key, self.provider) if self.provider is not None else Theme.getColor(key)

    def text_color(self, key):
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        return readable_color(self.color(key), self.color(Theme.key_dialogBackground))

    def header(self, value):
        cell = jclass('org.telegram.ui.Cells.HeaderCell')(self.activity, self.provider)
        cell.setText(value)
        self.root.addView(cell, jclass('android.widget.LinearLayout$LayoutParams')(-1, -2))
        self.labels.append((cell, jclass('org.telegram.ui.ActionBar.Theme').key_dialogTextBlue2))
        return cell

    def property_row(self, parent, label, value, divider):
        cell = jclass('org.telegram.ui.Cells.TextSettingsCell')(self.activity, self.provider)
        cell.setTextAndValue(label, value, divider)
        parent.addView(cell, jclass('android.widget.LinearLayout$LayoutParams')(-1, -2))
        self.cells.append(cell)
        return cell

    def disclosure(self, title, paragraphs=None, rows=None):
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        Layout = jclass('android.widget.LinearLayout')
        row = self.property_row(self.root, title, UI_COPY[self.lang]['expand'], False)
        index = len(self.disclosures)
        row.setOnClickListener(session_click(self, 'toggle', index)); self.click_views.append(row)
        content = Layout(self.activity); content.setOrientation(1)
        self.root.addView(content, Layout.LayoutParams(-1, -2))
        for paragraph in paragraphs or []:
            sheet_text(self, content, paragraph, 14, Theme.key_dialogTextGray, top=2, bottom=10)
        for i, (label, value) in enumerate(rows or []):
            self.property_row(content, label, value, i < len(rows)-1)
        content.setLayoutParams(Layout.LayoutParams(-1, 0))
        content.setImportantForAccessibility(4)  # NO_HIDE_DESCENDANTS while collapsed.
        self.disclosures.append((row, content, title))

    def toggle(self, index):
        if self.cancel.is_set(): return
        self.expanded_index = None if self.expanded_index == index else index
        self.animation_generation += 1
        try: animate = bool(jclass('android.animation.ValueAnimator').areAnimatorsEnabled())
        except AttributeError: animate = False
        if animate:
            # Native bounds/clip animation: no Python code is called on each frame.
            transition = jclass('android.transition.ChangeBounds')()
            transition.setResizeClip(True)
            transition.addTarget(self.root)
            for child_index in range(self.root.getChildCount()):
                transition.addTarget(self.root.getChildAt(child_index))
            transition.setDuration(240)
            transition.setInterpolator(jclass('org.telegram.ui.Components.CubicBezierInterpolator').EASE_OUT_QUINT)
            jclass('android.transition.TransitionManager').beginDelayedTransition(self.root, transition)
            self.animations_started = True
        for i, (row, content, title) in enumerate(self.disclosures):
            visible = self.expanded_index == i
            content.setClipBounds(None)  # Let an interrupted transition capture a fresh final clip.
            params = content.getLayoutParams(); params.height = -2 if visible else 0
            content.setLayoutParams(params)
            content.setImportantForAccessibility(0 if visible else 4)
            row.setTextAndValue(title, UI_COPY[self.lang]['collapse' if visible else 'expand'], animate, False)
            row.setContentDescription(title + ', ' + UI_COPY[self.lang]['collapse' if visible else 'expand'])
        self.schedule_reveal(animate)

    def schedule_reveal(self, animate):
        reference = weakref.ref(self)
        generation = self.animation_generation
        def reveal(attempt=0):
            owner = reference()
            if owner is None or owner.cancel.is_set() or owner.animation_generation != generation: return
            if owner.root.isLayoutRequested() and attempt < 3:
                run_on_ui_thread(lambda: reveal(attempt+1), 16)
                return
            scroll = owner.scroll.java
            maximum = max(0, owner.root.getMeasuredHeight() - scroll.getHeight())
            target = min(int(scroll.getScrollY()), maximum)
            if owner.expanded_index is not None:
                row, content, _ = owner.disclosures[owner.expanded_index]
                # Use final measured positions, independent of animated child bounds.
                bottom = int(owner.root.getPaddingTop())
                for i in range(owner.root.indexOfChild(row)+1):
                    child = owner.root.getChildAt(i); params = child.getLayoutParams()
                    bottom += int(child.getMeasuredHeight() + params.topMargin + params.bottomMargin)
                reveal_height = min(int(content.getMeasuredHeight()), jclass('org.telegram.messenger.AndroidUtilities').dp(144))
                target = max(target, bottom + reveal_height - scroll.getHeight())
            target = max(0, min(target, maximum))
            if animate: scroll.smoothScrollTo(0, target)
            else: scroll.scrollTo(0, target)
        run_on_ui_thread(reveal, 16)

    def show(self):
        owner = self.owner()
        if owner is None or owner.cancel.is_set(): return
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        copy = UI_COPY[self.lang]
        AU = jclass('org.telegram.messenger.AndroidUtilities')
        # Keep the sheet and footer still while sections expand inside its viewport.
        viewport_height = max(180, min(688, int(AU.displaySize.y / AU.density) - 160))
        sheet_container(self, viewport_height)
        sheet_text(self, self.root, self.strings['help'], 20, Theme.key_dialogTextBlack, True, 16, 4)
        subtitle = sheet_text(self, self.root, owner.track_name, 14, Theme.key_dialogTextGray, bottom=8)
        subtitle.setMaxLines(2); subtitle.setEllipsize(jclass('android.text.TextUtils$TruncateAt').END)
        self.header(copy['assessment'])
        sheet_text(self, self.root, owner.summary_title.getText(), 16, Theme.key_dialogTextBlack, True, 2, 6)
        sheet_text(self, self.root, owner.summary_detail.getText(), 14, Theme.key_dialogTextGray, top=0, bottom=10)
        result = owner.graph.result
        self.header(copy['file'])
        rows = file_property_rows(result, self.lang, getattr(owner, 'file_size', 0))
        for i, (label, value) in enumerate(rows): self.property_row(self.root, label, value, i < len(rows)-1)
        self.disclosure(copy['interpretation'], [owner.assessment_detail, owner.assessment_action,
                                                owner.assessment_format, self.strings['origin']])
        self.disclosure(copy['guide'], [self.strings['graph_guide'], self.strings['inspect'], copy['graph_limit']])
        info = result.info
        pcm = self.strings['float_pcm'] if info.encoding == 4 else '%d %s' % ({2:16, 3:8, 21:24, 22:32}[info.encoding], self.strings['bit'])
        technical = [(copy['method'], 'Hann · FFT 2048'), (copy['range'], '−100…0 dBFS'), ('PCM', pcm)]
        if info.bitrate: technical.append((copy['bitrate'], '%d %s' % (info.bitrate // 1000, self.strings['kbps'])))
        technical.append((copy['mode'], self.strings['cached'] if getattr(result,'cache_hit',False) else self.strings['fast'] if info.decoder == 'SpekGram JVM FLAC' else self.strings['compat']))
        self.disclosure(copy['analysis'], [self.strings['sampling']], technical)
        self.button = sheet_button(self, self.container, copy['done'], 'dismiss')
        self.sheet = jclass('org.telegram.ui.ActionBar.BottomSheet').Builder(self.activity, False, self.provider).setCustomView(self.container).create()
        self.sheet.setCanDismissWithSwipe(True)
        self.dismiss_listener = DismissListener(self.close)
        self.hide_listener = DismissListener(self.stop_animations)
        self.sheet.setOnHideListener(self.hide_listener)
        self.sheet.setOnDismissListener(self.dismiss_listener)
        self.apply_theme()
        self.sheet.show()

    def apply_theme(self):
        if self.cancel.is_set() or self.sheet is None: return
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        self.container.setBackgroundColor(self.color(Theme.key_dialogBackground))
        self.sheet.setBackgroundColor(self.color(Theme.key_dialogBackground))
        for view, key in self.labels: view.setTextColor(self.text_color(key))
        for cell in self.cells:
            cell.setTextColor(self.text_color(Theme.key_dialogTextBlack))
            cell.setTextValueColor(self.text_color(Theme.key_dialogTextGray))
        for row, _, _ in self.disclosures:
            row.setBackground(Theme.createSelectorDrawable(self.color(Theme.key_listSelector), 2))
        self.button.setColor(self.color(Theme.key_featuredStickers_addButton)); self.button.updateColors()
        self.button.setTextColor(jint(readable_color(self.color(Theme.key_featuredStickers_buttonText), self.color(Theme.key_featuredStickers_addButton))))

    def stop_animations(self):
        self.animation_generation = getattr(self, 'animation_generation', 0) + 1
        if getattr(self, 'animations_started', False) and self.root is not None:
            # End transitions while the native window still has its WindowId.
            jclass('android.transition.TransitionManager').endTransitions(self.root)
            self.animations_started = False
        for cell in getattr(self, 'cells', []):
            cell.getValueTextView().cancelAnimation()

    def dismiss(self):
        self.stop_animations()
        if self.sheet is not None: self.sheet.dismiss()
        else: self.close()

    def close(self):
        if self.cancel.is_set(): return
        self.cancel.set()
        self.stop_animations()
        for view in self.click_views: view.setOnClickListener(None)
        self.click_views = []; self._click_listeners = []
        if self.sheet is not None:
            self.sheet.setOnHideListener(None)
            clear_sheet_dismiss_listener(self.sheet)
        if self.scroll is not None:
            scroll, self.scroll = self.scroll, None
            dispose_sheet_scroll(scroll)
        owner = self.owner()
        if owner is not None and owner.help_dialog is self: owner.help_dialog = None
        self.labels = []; self.cells = []; self.disclosures = []
        self.root = self.container = self.sheet = self.button = self.activity = self.dismiss_listener = self.hide_listener = None


class Cancelled(Exception):
    pass

class AudioError(Exception):
    pass

class PcmFormatError(AudioError):
    pass

def check_cancel(event):
    if event.is_set():
        raise Cancelled()

class Fft:
    """Radix-2 FFT, symmetric Hann, coherent gain, one-sided power (Spek Mobile)."""
    def __init__(self, size=FFT_SIZE):
        if size < 4 or size & (size - 1):
            raise ValueError("FFT size must be a power of two")
        self.size = size
        self.window = [0.5 - 0.5 * math.cos(2 * math.pi * i / (size - 1)) for i in range(size)]
        self.gain = sum(self.window)
        self.twiddles = [complex(math.cos(-2 * math.pi * i / size), math.sin(-2 * math.pi * i / size))
                         for i in range(size // 2)]
        bits = size.bit_length() - 1
        self.reverse = [int(format(i, "0%db" % bits)[::-1], 2) for i in range(size)]

    def power(self, samples):
        if len(samples) != self.size:
            raise ValueError("Wrong window length")
        values = [complex(samples[i] * self.window[i]) for i in self.reverse]
        length = 2
        while length <= self.size:
            half, stride = length // 2, self.size // length
            for start in range(0, self.size, length):
                for k in range(half):
                    a, b = start + k, start + k + half
                    t = self.twiddles[k * stride] * values[b]
                    values[b] = values[a] - t
                    values[a] += t
            length *= 2
        scale = self.gain * self.gain
        return [(z.real * z.real + z.imag * z.imag) * (1 if k in (0, self.size // 2) else 4) / scale
                for k, z in enumerate(values[:self.size // 2 + 1])]

def pcm_values(data, encoding):
    """Little-endian PCM, Android encoding tags 2/3/4/21/22."""
    if encoding == 3:
        return [(b - 128) / 128 for b in data]
    if encoding == 21:
        return [int.from_bytes(data[i:i+3], "little", signed=True) / 8388608
                for i in range(0, len(data), 3)]
    tag, scale = {2: ("h", 32768), 4: ("f", 1), 22: ("i", 2147483648)}[encoding]
    return [v[0] / scale if math.isfinite(v[0]) else 0.0 for v in struct.iter_unpack("<" + tag, data)]

@dataclass
class AudioInfo:
    rate: int
    channels: int
    encoding: int
    duration: float
    mime: str
    bitrate: int = 0
    decoder: str = ""
    retry_reason: str = ""
    source_bits: int = 0

    def validate(self):
        if not 1 <= self.channels <= 8 or not 8000 <= self.rate <= 384000:
            raise AudioError("Unsupported sample rate/channel count")
        if self.encoding not in (2, 3, 4, 21, 22):
            raise AudioError("Unsupported PCM encoding: %s" % self.encoding)

class StreamingAnalysis:
    """Bounded PCM tail + sampled overlapping STFT windows; never stores whole PCM."""
    def __init__(self, info, cancel, fft_size=FFT_SIZE, max_columns=MAX_COLUMNS):
        info.validate()
        self.info, self.cancel = info, cancel
        self.fft = Fft(fft_size)
        self.n, self.max_columns = fft_size, max_columns
        self.stride = {2: 2, 3: 1, 4: 4, 21: 3, 22: 4}[info.encoding] * info.channels
        self.hop = max(fft_size // 2, math.ceil(max(0, info.duration * info.rate - fft_size) / max(1, max_columns - 1)))
        self.next_start = 0
        self.frames = 0
        self.tail = b""
        self.columns = []
        self.times = []
        self.weights = []

    def accept(self, data):
        check_cancel(self.cancel)
        if len(data) % self.stride:
            raise AudioError("Incomplete PCM frame")
        start = self.frames - len(self.tail) // self.stride
        block = self.tail + data
        self.frames += len(data) // self.stride
        while self.next_start + self.n <= self.frames:
            check_cancel(self.cancel)
            offset = (self.next_start - start) * self.stride
            if offset < 0:
                raise AudioError("Invalid streaming window")
            self._transform(block[offset:offset + self.n * self.stride], self.next_start)
            self.next_start += self.hop
        self.tail = block[-self.n * self.stride:]

    def _transform(self, data, start):
        values = pcm_values(data, self.info.encoding)
        powers = [0.0] * (self.n // 2 + 1)
        for c in range(self.info.channels):
            check_cancel(self.cancel)
            channel = values[c::self.info.channels]
            channel += [0.0] * (self.n - len(channel))
            p = self.fft.power(channel)
            for k, v in enumerate(p):
                if not math.isfinite(v):
                    raise PcmFormatError("Non-finite spectral power")
                powers[k] += v / self.info.channels
        # Max-pool frequency bins for overview; do not average opposite-phase PCM.
        rows = min(PLOT_ROWS, len(powers))
        reduced = array("f", (max(powers[y * len(powers) // rows:(y+1) * len(powers) // rows])
                              for y in range(rows)))
        self.columns.append(reduced)
        self.times.append((start + min(self.n, self.frames) / 2) / self.info.rate)
        self.weights.append(1)
        if len(self.columns) > self.max_columns:
            merged, times, weights = [], [], []
            for i in range(0, len(self.columns), 2):
                if i + 1 == len(self.columns):
                    merged.append(self.columns[i]); times.append(self.times[i]); weights.append(self.weights[i])
                else:
                    a, b = self.weights[i:i+2]
                    merged.append(array("f", ((x*a + y*b) / (a+b) for x, y in zip(self.columns[i], self.columns[i+1]))))
                    times.append((self.times[i]*a + self.times[i+1]*b) / (a+b)); weights.append(a+b)
            self.columns, self.times, self.weights = merged, times, weights
            self.hop *= 2

    def finish(self):
        check_cancel(self.cancel)
        if self.frames == 0:
            raise AudioError("empty")
        if not self.columns:
            self._transform(self.tail, 0)
        self.duration = self.frames / self.info.rate
        return self

    def raster(self):
        """Bounded ARGB heatmap. Actual sampled center times mapped to total duration."""
        width, height = min(MAX_COLUMNS, max(1, len(self.columns))), len(self.columns[0])
        pixels = [0] * (width * height)
        column = 0
        for x in range(width):
            check_cancel(self.cancel)
            t = (x + 0.5) * self.duration / width
            while column + 1 < len(self.columns) and t > (self.times[column] + self.times[column+1]) / 2:
                column += 1
            for y, power in enumerate(self.columns[column]):
                if not math.isfinite(power) or power < 0:
                    raise PcmFormatError("Invalid spectral power in raster")
                level = min(1.0, max(0.0, (10 * math.log10(max(power, 1e-16)) + 100) / 100))
                pixels[(height - 1 - y) * width + x] = palette(level)
        return width, height, pixels

@dataclass
class SpectrumReport:
    """Observations only; never a classifier of authenticity or audible quality."""
    state: str = "unknown"
    reason: str = "insufficient"
    cutoff_hz: float = 0.0
    upper_hz: float = 0.0
    persistence: float = 0.0
    windows: int = 0

    def validate(self):
        if self.state not in ("unknown", "wide", "limited", "cutoff"):
            raise ValueError("Invalid spectrum report")
        if self.reason not in ("insufficient", "quiet", "tonal", "low_rate", "observed"):
            raise ValueError("Invalid spectrum reason")
        if (self.state == "unknown") == (self.reason == "observed"):
            raise ValueError("Inconsistent spectrum report")
        if any(not math.isfinite(v) or v < 0 for v in (self.cutoff_hz, self.upper_hz, self.persistence)):
            raise ValueError("Invalid spectrum evidence")
        if self.cutoff_hz > 192000 or self.upper_hz > 192000 or self.persistence > 1:
            raise ValueError("Spectrum evidence exceeds range")
        if not isinstance(self.windows, int) or not 0 <= self.windows <= MAX_COLUMNS:
            raise ValueError("Invalid window count")


def assess_spectrum(columns, rate, duration, cancel):
    """Conservative, versioned heuristic on sampled max-pooled STFT power.

    Reject silence/short/tonal input. An edge needs broadband energy before it,
    >=24 dB drop in 600 Hz, a quiet upper tail and >=75% temporal agreement.
    No codec/bitrate guess, probability, or proof of a lossy source is produced.
    """
    check_cancel(cancel)
    report = SpectrumReport()
    if duration < 3 or len(columns) < 8:
        return report
    height = len(columns[0])
    if height < 32:
        return report
    if rate < 32000:
        return SpectrumReport(reason="low_rate")
    nyquist, step = rate / 2, rate / (2 * height)
    low, high = max(1, int(2000/step)), min(height, int(8000/step))
    active = []
    for index, column in enumerate(columns):
        check_cancel(cancel)
        if len(column) != height or any(not math.isfinite(p) or p < 0 for p in column):
            raise PcmFormatError("Invalid assessment power")
        peak = max(column)
        if peak < 1e-9:  # Below -90 dBFS: avoid interpreting the floor as a cutoff.
            continue
        # Reject isolated tones; need content across at least 25% of 2–8 kHz.
        occupied = sum(p >= peak*10**(-45/10) for p in column[low:high])
        if occupied < max(4, (high-low)*0.25):
            continue
        active.append((index, column, peak))
    report.windows = len(active)
    if len(active) < max(8, len(columns)*0.15):
        report.reason = "quiet" if all(max(c) < 1e-9 for c in columns) else "tonal"
        return report
    # 80th percentile relative power ignores silence and rare, isolated HF events.
    envelope = []
    for y in range(height):
        check_cancel(cancel)
        values = sorted(float(c[y])/peak for _, c, peak in active)
        envelope.append(values[min(len(values)-1, int(len(values)*0.8))])
    audible_rows = [y for y, p in enumerate(envelope) if p >= 10**(-55/10)]
    report.upper_hz = min(nyquist, (max(audible_rows)+1)*step) if audible_rows else 0
    band = max(2, math.ceil(600/step))
    edges = []
    # Stay away from the normal anti-alias boundary and don't label >18.5 kHz
    # filtering suspicious. A master can legitimately contain such a filter.
    for y in range(max(band, math.ceil(8000/step)), min(height-band, int(min(18500, nyquist-2000)/step))):
        before = sum(envelope[y-band:y])/band
        after = sum(envelope[y:y+band])/band
        if before < 10**(-45/10) or after > before*10**(-24/10):
            continue
        if max(envelope[y+band:]) > before*10**(-20/10):
            continue  # A spectral notch with HF content above it is not a cutoff.
        supported, eligible, quarters = 0, 0, set()
        for index, c, peak in active:
            left = sum(c[y-band:y])/band
            right = sum(c[y:y+band])/band
            if left < max(1e-9, peak*10**(-45/10)):
                continue
            eligible += 1
            if right <= left*10**(-22/10) and max(c[y+band:]) <= left*10**(-18/10):
                supported += 1
                quarters.add(min(3, index*4//len(columns)))
        fraction = supported/max(1, eligible)
        if eligible >= max(8, len(active)*0.5) and fraction >= 0.75 and len(quarters) >= 3:
            edges.append((10*math.log10(before/max(after, 1e-30)), y, fraction))
    if edges:
        _, y, fraction = max(edges)
        reference = max(envelope[y-band:y])
        edge = next((i for i in range(y-band, y+band) if envelope[i] <= reference*10**(-12/10)), y)
        report.state, report.reason = "cutoff", "observed"
        report.cutoff_hz, report.persistence = edge*step, fraction
    else:
        # Broad means persistent content into the upper music band, not "original".
        report.state = "wide" if report.upper_hz >= min(18000, nyquist*0.82) else "limited"
        report.reason = "observed"
    return report


def assessment_text(report, info, lang="ru", voice=False):
    """Localize measured evidence separately from format facts and provenance."""
    report = report or SpectrumReport()
    ru = lang == "ru"
    lossless = info.mime in ("audio/flac", "audio/wav", "audio/x-flac", "audio/alac")
    lossy = info.mime in ("audio/mpeg", "audio/mp3", "audio/mp4a-latm", "audio/aac",
                         "audio/vorbis", "audio/opus", "audio/3gpp", "audio/amr-wb")
    if voice:
        title = "Голосовое сообщение" if ru else "Voice message"
        detail = ("Для речи ограниченный диапазон частот обычен. По нему нельзя оценивать качество музыкального FLAC."
                  if ru else "A limited frequency range is normal for speech. It cannot be used to judge a music FLAC.")
        action = "Оцените, насколько хорошо слышна речь." if ru else "Check how clearly you can hear the speech."
    elif report.state == "cutoff":
        title = "Есть повод проверить источник" if ru else "Worth checking the source"
        frequency = ("%.1f" % (report.cutoff_hz/1000)).replace(".", ",") if ru else "%.1f" % (report.cutoff_hz/1000)
        detail = (("Около %s кГц частоты резко обрываются в большинстве проверенных участков. Так бывает после сжатия с потерями, но и у исходного мастера с фильтром." % frequency)
                  if ru else ("Frequencies drop sharply near %s kHz in most checked sections. Lossy compression can cause this, but so can a filter in the original master." % frequency))
        action = (("Если нужен архивный FLAC, сравните с файлом из официального источника." if lossless else "Для прослушивания такой файл может звучать хорошо. Для архива лучше исходник без потерь.")
                  if ru else ("For an archival FLAC, compare with a file from an official source." if lossless else "This file may still sound good. For archiving, prefer the lossless source."))
    elif report.state == "wide":
        title = "Явного ограничения частот не видно" if ru else "No obvious frequency restriction"
        detail = ("В записи есть высокие частоты, устойчивого резкого среза не найдено. Это хороший признак широкого диапазона, но не доказательство оригинальности."
                  if ru else "The recording has high-frequency content with no persistent sharp cutoff found. This suggests a broad range, but does not prove authenticity.")
        action = "Для прослушивания ориентируйтесь также на звук: шум, искажения и баланс." if ru else "Also listen for noise, distortion and balance."
    elif report.state == "limited":
        title = "Высоких частот немного" if ru else "Little high-frequency content"
        detail = ("Диапазон выглядит ограниченным, но убедительного резкого среза нет. Причиной могут быть инструменты, старая запись или обработка."
                  if ru else "The range looks limited, with no convincing sharp cutoff. Instruments, an old recording or processing can explain it.")
        action = "Не считайте файл плохим или поддельным только по этому признаку." if ru else "This alone does not mean the file sounds bad or is fake."
    else:
        title = "Надёжно оценить не получилось" if ru else "Not enough evidence to assess"
        explanations = {
            "quiet": ("Запись слишком тихая для этой проверки.", "The recording is too quiet for this check."),
            "tonal": ("Недостаточно участков с широким спектром: например, в записи отдельные тоны или мало высоких частот.", "There are too few broad-spectrum sections, for example isolated tones or little high-frequency content."),
            "low_rate": ("Частота записи изначально ограничивает верхний диапазон. Это не доказывает перекодирование.", "The sample rate already limits the upper range. This does not prove transcoding."),
            "insufficient": ("Запись слишком короткая или данных для проверки недостаточно.", "The recording is too short or has insufficient data for this check."),
        }
        detail = explanations[report.reason][0 if ru else 1]
        action = "Проверьте более длинную запись или сравните с известным исходником." if ru else "Check a longer recording or compare with a known source."
    if lossless:
        format_note = ("Формат без потерь: сохраняет полученный звук, включая возможные потери прежнего источника."
                       if ru else "Lossless format: preserves the supplied audio, including any losses from an earlier source.")
    elif lossy:
        format_note = ("Формат с потерями: часть данных отброшена при сжатии. Это само по себе не означает плохое звучание."
                       if ru else "Lossy format: compression discards some data. This alone does not mean poor sound.")
    else:
        format_note = "Тип сжатия не определён." if ru else "Compression type is unknown."
    return title, detail, action, format_note


def quality_help(lang):
    if lang == "ru":
        return ("Оригинальный ли FLAC?\nFLAC сохраняет звук без новых потерь. Но MP3, сохранённый в FLAC, не вернёт уже потерянные детали. Подтвердить оригинал можно сравнением с известным исходником.\n\n"
                "Хорошо ли звучит?\nСпектр показывает частоты, а не качество звучания. Высокий битрейт, 24 бита и много высоких частот сами по себе не делают звук лучше. Шум и искажения стоит проверить на слух.\n\n"
                "Что означает срез?\nРезкая граница в большей части трека — повод проверить источник. Она бывает и после сжатия, и у оригинальной записи с фильтром. SpekGram не называет такой файл поддельным.\n\n"
                "Как проводится проверка?\nАнализируются участки по всей записи. Очень короткие, тихие и тональные записи могут не дать вывода. Краткие дефекты между участками могут быть пропущены. Цвета показывают громкость частот: ярче — громче, чёрное — очень тихо или нет сигнала.")
    return ("Is this an original FLAC?\nFLAC preserves audio without further loss. Saving an MP3 as FLAC cannot restore lost detail. Confirming the original requires comparison with a known source.\n\n"
            "Does it sound good?\nA spectrum shows frequencies, not sound quality. A high bitrate, 24 bits and lots of high frequencies do not by themselves make audio better. Listen for noise and distortion.\n\n"
            "What does a cutoff mean?\nA sharp boundary across most of the track is a reason to check the source. Both lossy compression and a filter in the original recording can cause it. SpekGram does not call such a file fake.\n\n"
            "How is it checked?\nSections throughout the recording are sampled. Short, quiet or tonal recordings may be inconclusive. Brief defects between sections may be missed. Brighter colors mean louder frequencies; black means very quiet or no signal.")


def palette(value):
    stops = ((0, 0, 0), (0, 0, 80), (40, 0, 210), (150, 25, 170), (255, 105, 0), (255, 255, 70))
    pos = min(5.0, max(0.0, value) * 5)
    i = min(4, int(pos)); f = pos - i
    r, g, b = [round(a + (z-a)*f) for a, z in zip(stops[i], stops[i+1])]
    return (255 << 24) | (r << 16) | (g << 8) | b


def signed_argb(color):
    value = int(color) & 0xffffffff
    return value if value < 0x80000000 else value - 0x100000000


def readable_color(foreground, background, minimum=4.5):
    """Preserve the theme color when readable; composite alpha and raise contrast if needed."""
    bg = [(int(background) >> shift) & 255 for shift in (16, 8, 0)]
    alpha = ((int(foreground) >> 24) & 255) / 255
    rgb = [round(((int(foreground) >> shift) & 255) * alpha + b * (1-alpha))
           for shift, b in zip((16, 8, 0), bg)]
    def luminance(values):
        values = [v / 255 for v in values]
        values = [v / 12.92 if v <= 0.04045 else ((v+0.055) / 1.055)**2.4 for v in values]
        return sum(v*w for v, w in zip(values, (0.2126, 0.7152, 0.0722)))
    bg_luma = luminance(bg)
    def contrast(values):
        luma = luminance(values)
        return (max(luma, bg_luma)+0.05) / (min(luma, bg_luma)+0.05)
    if contrast(rgb) < minimum:
        target = [255]*3 if contrast([255]*3) >= contrast([0]*3) else [0]*3
        for step in range(1, 101):
            candidate = [round(v + (t-v)*step/100) for v, t in zip(rgb, target)]
            if contrast(candidate) >= minimum:
                rgb = candidate
                break
        else:
            rgb = target
    return signed_argb(0xff000000 | (rgb[0] << 16) | (rgb[1] << 8) | rgb[2])

def read_wave(path, cancel, on_format, on_pcm):
    """PCM/float RIFF WAV including WAVE_FORMAT_EXTENSIBLE, streamed in small blocks."""
    with open(path, "rb") as stream:
        size = os.fstat(stream.fileno()).st_size
        def exact(n):
            data = stream.read(n)
            if len(data) != n:
                raise AudioError("Truncated WAV")
            return data
        header = exact(12)
        if header[:4] != b"RIFF" or header[8:] != b"WAVE":
            raise AudioError("Not RIFF WAV")
        end = struct.unpack_from("<I", header, 4)[0] + 8
        if end > size or end < 12:
            raise AudioError("Invalid RIFF length")
        info = None
        while stream.tell() + 8 <= end:
            check_cancel(cancel)
            kind, length = struct.unpack("<4sI", exact(8))
            if stream.tell() + length > end:
                raise AudioError("Truncated WAV chunk")
            if kind == b"fmt ":
                if not 16 <= length <= 65536:
                    raise AudioError("Invalid WAV format length")
                fmt = exact(length)
                tag, channels, rate, bitrate_bytes, align, bits = struct.unpack_from("<HHIIHH", fmt)
                if tag == 65534:
                    if len(fmt) < 40 or struct.unpack_from("<H", fmt, 16)[0] < 22:
                        raise AudioError("Invalid extensible WAV")
                    if fmt[26:40] != b"\x00\x00\x00\x00\x10\x00\x80\x00\x00\xaa\x00\x38\x9b\x71":
                        raise AudioError("Unsupported WAV GUID")
                    tag = struct.unpack_from("<H", fmt, 24)[0]
                if tag == 1 and bits in (8, 16, 24, 32):
                    enc = {8: 3, 16: 2, 24: 21, 32: 22}[bits]
                elif tag == 3 and bits == 32:
                    enc = 4
                else:
                    raise AudioError("Unsupported WAV compression")
                info = AudioInfo(rate, channels, enc, 0, "audio/wav", bitrate_bytes * 8)
                info.validate()
                if align != channels * bits // 8 or bitrate_bytes != rate * align:
                    raise AudioError("Invalid WAV alignment")
            elif kind == b"data":
                if info is None or length % align:
                    raise AudioError("Missing WAV format/incomplete PCM")
                info.duration = length / align / info.rate
                on_format(info)
                left = length
                while left:
                    check_cancel(cancel)
                    n = min(left, align * 4096)
                    on_pcm(exact(n)); left -= n
                return
            else:
                stream.seek(length, 1)
            if length & 1:
                exact(1)
        raise AudioError("Missing WAV data")

# Android / SDK adapter. Core above this line is also exercised on the desktop.
from base_plugin import AppEvent, BasePlugin, MenuItemData, MenuItemType
from android_utils import run_on_ui_thread, OnClickListener
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from java import jclass, jarray, jbyte, jint, dynamic_proxy, cast


def java_bytes(buffer, offset, count):
    buffer = buffer.duplicate()
    buffer.position(offset); buffer.limit(offset + count)
    data = jarray(jbyte)(count)
    buffer.get(data)
    return bytes(data)  # Chaquopy byte[] -> bytes uses unsigned bit patterns.


def flac_stream_info(path):
    """Read native FLAC STREAMINFO only; exact frame count independent of codec format hints."""
    with open(path, "rb") as stream:
        if stream.read(4) != b"fLaC":
            return None
        header = stream.read(4)
        if len(header) != 4 or header[0] & 127 != 0 or int.from_bytes(header[1:], "big") != 34:
            raise AudioError("Invalid FLAC STREAMINFO")
        data = stream.read(34)
        if len(data) != 34:
            raise AudioError("Truncated FLAC STREAMINFO")
        packed = int.from_bytes(data[10:18], "big")
        rate = (packed >> 44) & 0xfffff
        channels = ((packed >> 41) & 7) + 1
        bits = ((packed >> 36) & 31) + 1
        frames = packed & ((1 << 36) - 1)
        if not 8000 <= rate <= 384000 or not 4 <= bits <= 32:
            raise AudioError("Unsupported FLAC STREAMINFO")
        return rate, channels, bits, frames


# Independent streaming FLAC implementation from RFC 9639; no Java/native decoder dependency.
def _crc_table(bits, polynomial):
    table = []
    for value in range(256):
        crc = value << (bits - 8)
        for _ in range(8):
            crc = (crc << 1) ^ (polynomial if crc & (1 << (bits - 1)) else 0)
        table.append(crc & ((1 << bits) - 1))
    return table

_FLAC_CRC8 = _crc_table(8, 0x07)
_FLAC_CRC16 = _crc_table(16, 0x8005)

class FlacBits:
    """64 KiB input buffer, bit accumulator and incremental frame CRC."""
    def __init__(self, stream, cancel):
        self.stream, self.cancel = stream, cancel
        self.buffer = b""; self.position = 0
        self.value = 0; self.count = 0
        self.crc = 0; self.tracking = False; self.header = None

    def byte(self):
        if self.position == len(self.buffer):
            check_cancel(self.cancel)
            self.buffer = self.stream.read(65536); self.position = 0
            if not self.buffer:
                raise EOFError("Truncated FLAC frame")
        value = self.buffer[self.position]; self.position += 1
        if self.tracking:
            self.crc = ((self.crc << 8) ^ _FLAC_CRC16[(self.crc >> 8) ^ value]) & 65535
        if self.header is not None:
            self.header.append(value)
        return value

    def read(self, size):
        if not 0 <= size <= 64:
            raise AudioError("Invalid FLAC bit width")
        while self.count < size:
            self.value = (self.value << 8) | self.byte(); self.count += 8
        self.count -= size
        result = self.value >> self.count
        self.value &= (1 << self.count) - 1
        return result

    def signed(self, size):
        if size == 0:
            return 0
        value = self.read(size)
        return value - (1 << size) if value & (1 << (size - 1)) else value

    def unary(self, limit=1 << 24):
        zeros = 0
        while True:
            if not self.count:
                self.value = self.byte(); self.count = 8
            if not self.value:
                zeros += self.count; self.count = 0
                if zeros > limit:
                    raise AudioError("Excessive FLAC unary code")
                continue
            prefix = self.count - self.value.bit_length()
            self.read(prefix + 1)
            zeros += prefix
            if zeros > limit:
                raise AudioError("Invalid FLAC unary code")
            return zeros

    def start_frame(self):
        if self.count:
            raise AudioError("Unaligned FLAC frame")
        self.crc = 0; self.tracking = True; self.header = []
        try:
            return self.read(8)
        except EOFError:
            return None


def _flac_number(reader):
    first = reader.read(8)
    if first < 128:
        return first
    length = 0
    for bit in range(7, -1, -1):
        if first & (1 << bit): length += 1
        else: break
    if not 2 <= length <= 7:
        raise AudioError("Invalid FLAC frame number")
    value = first & ((1 << (7-length)) - 1)
    for _ in range(length-1):
        byte = reader.read(8)
        if byte & 192 != 128:
            raise AudioError("Invalid FLAC frame number continuation")
        value = (value << 6) | (byte & 63)
    if value > (1 << 36)-1:
        raise AudioError("FLAC frame number exceeds range")
    return value


def _flac_residual(reader, size, order):
    method = reader.read(2)
    if method not in (0, 1):
        raise AudioError("Unsupported FLAC residual coding")
    parameter_bits = 4 + method
    partition_order = reader.read(4)
    partitions = 1 << partition_order
    if size % partitions or size // partitions < order:
        raise AudioError("Invalid FLAC residual partitions")
    result = [0] * (size - order)
    offset = 0
    for partition in range(partitions):
        check_cancel(reader.cancel)
        parameter = reader.read(parameter_bits)
        count = size // partitions - (order if partition == 0 else 0)
        if parameter == (1 << parameter_bits)-1:
            width = reader.read(5)
            for i in range(count):
                result[offset+i] = reader.signed(width)
        else:
            for i in range(count):
                if i & 1023 == 0: check_cancel(reader.cancel)
                unsigned = (reader.unary() << parameter) | reader.read(parameter)
                if unsigned > 0xfffffffe:
                    raise AudioError("FLAC residual exceeds 32-bit range")
                result[offset+i] = (unsigned >> 1) ^ -(unsigned & 1)
        offset += count
    return result


def _flac_subframe(reader, size, depth):
    if reader.read(1):
        raise AudioError("Invalid FLAC subframe padding")
    kind = reader.read(6)
    wasted = reader.unary(depth) + 1 if reader.read(1) else 0
    width = depth - wasted
    if width <= 0:
        raise AudioError("Invalid FLAC wasted bits")
    if kind == 0:
        samples = [reader.signed(width)] * size
    elif kind == 1:
        samples = [reader.signed(width) for _ in range(size)]
    elif 8 <= kind <= 12 or 32 <= kind <= 63:
        order = kind-8 if kind < 32 else kind-31
        if order > size:
            raise AudioError("FLAC predictor larger than block")
        samples = [reader.signed(width) for _ in range(order)]
        if kind >= 32:
            precision = reader.read(4) + 1
            if precision == 16:
                raise AudioError("Invalid FLAC LPC precision")
            shift = reader.signed(5)
            if shift < 0:
                raise AudioError("Unsupported negative FLAC LPC shift")
            coefficients = [reader.signed(precision) for _ in range(order)]
        residual = _flac_residual(reader, size, order)
        samples.extend(residual)
        if kind >= 32:
            for i in range(order, size):
                if i & 1023 == 0: check_cancel(reader.cancel)
                prediction = sum(coefficients[j]*samples[i-j-1] for j in range(order))
                samples[i] += prediction >> shift
        elif order:
            coefficients = ((1,), (2, -1), (3, -3, 1), (4, -6, 4, -1))[order-1]
            for i in range(order, size):
                samples[i] += sum(coefficients[j]*samples[i-j-1] for j in range(order))
    else:
        raise AudioError("Reserved FLAC subframe type")
    if wasted:
        samples = [v << wasted for v in samples]
    return samples


def flac_blocks(path, cancel):
    try:
        yield from _flac_blocks(path, cancel)
    except EOFError as exc:
        raise AudioError("Truncated FLAC frame") from exc


def _flac_blocks(path, cancel):
    """Yield (rate, channels, depth, total_frames, integer channel blocks), validating CRCs."""
    metadata = flac_stream_info(path)
    if metadata is None:
        raise AudioError("Not a native FLAC stream")
    rate, channels, depth, total = metadata
    with open(path, "rb") as stream:
        stream.seek(4)
        first = True
        while True:
            check_cancel(cancel)
            header = stream.read(4)
            if len(header) != 4:
                raise AudioError("Truncated FLAC metadata")
            kind, length = header[0] & 127, int.from_bytes(header[1:], "big")
            if kind == 127 or (kind == 0 and not first):
                raise AudioError("Invalid FLAC metadata block")
            if stream.tell() + length > os.fstat(stream.fileno()).st_size:
                raise AudioError("Truncated FLAC metadata payload")
            stream.seek(length, 1)
            first = False
            if header[0] & 128:
                break
        reader = FlacBits(stream, cancel)
        decoded = 0; frame_index = 0
        while True:
            check_cancel(cancel)
            first_byte = reader.start_frame()
            if first_byte is None:
                break
            if first_byte != 255 or reader.read(6) != 62 or reader.read(1):
                raise AudioError("Invalid FLAC frame sync")
            variable = reader.read(1)
            block_code, rate_code = reader.read(4), reader.read(4)
            assignment, depth_code = reader.read(4), reader.read(3)
            if reader.read(1):
                raise AudioError("Invalid FLAC frame reserved bit")
            number = _flac_number(reader)
            if number != (decoded if variable else frame_index):
                raise AudioError("Nonsequential FLAC frame/sample number")
            if block_code == 0:
                raise AudioError("Reserved FLAC block size")
            size = (192 if block_code == 1 else 576 << (block_code-2) if block_code <= 5 else
                    reader.read(8)+1 if block_code == 6 else reader.read(16)+1 if block_code == 7 else
                    256 << (block_code-8))
            if not 1 <= size <= 65535:
                raise AudioError("Unsupported FLAC block size")
            frame_rate = (rate if rate_code == 0 else
                          (88200,176400,192000,8000,16000,22050,24000,32000,44100,48000,96000)[rate_code-1]
                          if rate_code <= 11 else reader.read(8)*1000 if rate_code == 12 else
                          reader.read(16) if rate_code == 13 else reader.read(16)*10 if rate_code == 14 else 0)
            frame_depth = (depth,8,12,0,16,20,24,32)[depth_code]
            frame_channels = assignment+1 if assignment <= 7 else 2 if assignment <= 10 else 0
            if (frame_rate, frame_channels, frame_depth) != (rate, channels, depth):
                raise AudioError("FLAC frame format differs from STREAMINFO")
            crc8 = 0
            for value in reader.header:
                crc8 = _FLAC_CRC8[crc8 ^ value]
            reader.header = None
            if reader.read(8) != crc8:
                raise AudioError("FLAC header CRC mismatch")
            blocks = []
            for c in range(channels):
                extra = 1 if (assignment in (8,10) and c == 1) or (assignment == 9 and c == 0) else 0
                blocks.append(_flac_subframe(reader, size, depth+extra))
            if reader.count and reader.read(reader.count):
                raise AudioError("Nonzero FLAC frame padding")
            actual_crc = reader.crc
            reader.tracking = False
            if reader.read(16) != actual_crc:
                raise AudioError("FLAC frame CRC mismatch")
            if assignment == 8:
                blocks[1] = [a-b for a,b in zip(blocks[0],blocks[1])]
            elif assignment == 9:
                blocks[0] = [a+b for a,b in zip(blocks[0],blocks[1])]
            elif assignment == 10:
                mid, side = blocks
                doubled = [(m << 1) | (s & 1) for m,s in zip(mid,side)]
                blocks = [[(m+s) >> 1 for m,s in zip(doubled,side)],
                          [(m-s) >> 1 for m,s in zip(doubled,side)]]
            lower, upper = -(1 << (depth-1)), (1 << (depth-1))-1
            if any(v < lower or v > upper for block in blocks for v in block):
                raise AudioError("Decoded FLAC sample outside declared range")
            decoded += size; frame_index += 1
            if total and decoded > total:
                raise AudioError("FLAC exceeds declared frame count")
            yield metadata, blocks
        if total and decoded != total:
            raise AudioError("Truncated FLAC: decoded %d of %d frames" % (decoded,total))


def read_flac(path, cancel, on_format, on_pcm):
    rate, channels, depth, total = flac_stream_info(path)
    with open(path, "rb") as stream:
        stream.seek(26)
        expected_md5 = stream.read(16)
    digest = hashlib.md5()
    # Original integer precision is retained; unlike MediaCodec this format is under our control.
    encoding = 2 if depth <= 16 else 21 if depth <= 24 else 22
    storage_bits = {2:16,21:24,22:32}[encoding]
    info = AudioInfo(rate, channels, encoding, total/rate if total else 0, "audio/flac",
                     decoder="SpekGram FLAC (RFC 9639)", source_bits=depth)
    on_format(info)
    for metadata, blocks in flac_blocks(path,cancel):
        check_cancel(cancel)
        # Left-align uncommon depths into the byte-aligned PCM container before normalizing.
        shift = storage_bits-depth
        if encoding in (2,22):
            fmt = "<%d%s" % (len(blocks[0])*channels,"h" if encoding==2 else "i")
            data = struct.pack(fmt, *(v << shift for frame in zip(*blocks) for v in frame))
        else:
            data = b"".join((v << shift).to_bytes(3,"little",signed=True) for frame in zip(*blocks) for v in frame)
        if not shift:
            digest.update(data)
        else:
            width = (depth+7)//8
            digest.update(b"".join(v.to_bytes(width,"little",signed=True) for frame in zip(*blocks) for v in frame))
        on_pcm(data)
    if expected_md5 != bytes(16) and digest.digest() != expected_md5:
        raise AudioError("FLAC decoded PCM MD5 mismatch")


def validate_codec_pcm(data, info):
    """Do not turn mislabelled integer bytes into enormous float spectral power."""
    stride = {2: 2, 3: 1, 4: 4, 21: 3, 22: 4}[info.encoding] * info.channels
    if len(data) % stride:
        raise PcmFormatError("Incomplete decoded PCM frame")
    if info.encoding == 4:
        for (value,) in struct.iter_unpack("<f", data):
            # Allow modest float overshoot, but never NaN/Inf or absurd decoded amplitude.
            if not math.isfinite(value) or abs(value) > 4:
                raise PcmFormatError("Invalid float PCM amplitude (possible PCM16/float32 mismatch)")


_DECODER_LOCK = threading.Lock()

def decode_android(path, cancel, on_format, on_pcm, requested_encoding=4):
    # Cancellation stays non-blocking for the UI. A new codec waits until the old one releases.
    while not _DECODER_LOCK.acquire(timeout=0.1):
        check_cancel(cancel)
    try:
        check_cancel(cancel)
        return _decode_android_once(path, cancel, on_format, on_pcm, requested_encoding)
    finally:
        _DECODER_LOCK.release()


def _decode_android_once(path, cancel, on_format, on_pcm, requested_encoding):
    Extractor = jclass("android.media.MediaExtractor")
    Codec = jclass("android.media.MediaCodec")
    extractor, codec = Extractor(), None
    started = False
    try:
        extractor.setDataSource(path)
        track = next((i for i in range(extractor.getTrackCount())
                      if str(extractor.getTrackFormat(i).getString("mime")).startswith("audio/")), None)
        if track is None:
            raise AudioError("No audio track")
        extractor.selectTrack(track)
        source = extractor.getTrackFormat(track)
        mime = str(source.getString("mime"))
        rate, channels = source.getInteger("sample-rate"), source.getInteger("channel-count")
        duration = source.getLong("durationUs") / 1000000 if source.containsKey("durationUs") else 0
        bitrate = source.getInteger("bitrate") if source.containsKey("bitrate") else 0
        codec = Codec.createDecoderByType(mime)
        try:
            decoder_name = str(codec.getName())
        except Exception:
            decoder_name = "MediaCodec"
        # Float preserves quiet lossless content when output bytes really are float.
        source.setInteger("pcm-encoding", requested_encoding)
        try:
            codec.configure(source, None, None, 0)
        except Exception:
            codec.reset()
            # Do not restore a possibly inherited float hint into the default fallback.
            source.removeKey("pcm-encoding")
            codec.configure(source, None, None, 0)
        codec.start(); started = True
        buffer_info = Codec.BufferInfo()
        info = None
        decoded_frames = 0
        pcm_bytes = 0
        first_pts = None
        last_pts = None
        last_frames = 0
        input_done, output_done = False, False
        last_progress = time.monotonic()
        while not output_done:
            check_cancel(cancel)
            if not input_done:
                index = codec.dequeueInputBuffer(10000)
                if index >= 0:
                    buf = codec.getInputBuffer(index); buf.clear()
                    count = extractor.readSampleData(buf, 0)
                    if count < 0:
                        codec.queueInputBuffer(index, 0, 0, 0, Codec.BUFFER_FLAG_END_OF_STREAM)
                        input_done = True
                    else:
                        codec.queueInputBuffer(index, 0, count, extractor.getSampleTime(), 0)
                        extractor.advance()
            index = codec.dequeueOutputBuffer(buffer_info, 10000)
            if index == Codec.INFO_OUTPUT_FORMAT_CHANGED:
                output = codec.getOutputFormat()
                new_info = AudioInfo(output.getInteger("sample-rate"), output.getInteger("channel-count"),
                                     output.getInteger("pcm-encoding") if output.containsKey("pcm-encoding") else 2,
                                     duration, mime, bitrate, decoder_name)
                new_info.validate()
                if info and (info.rate, info.channels, info.encoding) != (new_info.rate, new_info.channels, new_info.encoding):
                    raise AudioError("Mid-stream PCM format change")
                if info is None:
                    info = new_info; on_format(info)
                last_progress = time.monotonic()
            elif index >= 0:
                try:
                    if info is None:
                        current_output = codec.getOutputFormat()
                        info = AudioInfo(current_output.getInteger("sample-rate"), current_output.getInteger("channel-count"),
                                         current_output.getInteger("pcm-encoding") if current_output.containsKey("pcm-encoding") else 2,
                                         duration, mime, bitrate, decoder_name)
                        info.validate(); on_format(info)
                    if buffer_info.size > 0 and not buffer_info.flags & Codec.BUFFER_FLAG_CODEC_CONFIG:
                        data = java_bytes(codec.getOutputBuffer(index), buffer_info.offset, buffer_info.size)
                        validate_codec_pcm(data, info)
                        bytes_per_frame = {2: 2, 3: 1, 4: 4, 21: 3, 22: 4}[info.encoding] * info.channels
                        frames_in_buffer = len(data) // bytes_per_frame
                        pts = int(buffer_info.presentationTimeUs)
                        if first_pts is None:
                            first_pts = pts
                        last_pts, last_frames = pts, frames_in_buffer
                        decoded_frames += frames_in_buffer
                        pcm_bytes += len(data)
                        on_pcm(data)
                    output_done = bool(buffer_info.flags & Codec.BUFFER_FLAG_END_OF_STREAM)
                    last_progress = time.monotonic()
                finally:
                    codec.releaseOutputBuffer(index, False)
            if time.monotonic() - last_progress > 30:
                raise AudioError("Decoder stalled")
        # Timestamp span catches gross stride mistakes even when float values look plausible.
        if info and first_pts is not None and last_pts > first_pts:
            timestamp_seconds = (last_pts - first_pts) / 1000000 + last_frames / info.rate
            pcm_seconds = decoded_frames / info.rate
            if timestamp_seconds >= 1 and abs(pcm_seconds - timestamp_seconds) > max(0.25, timestamp_seconds * 0.05):
                raise PcmFormatError("PCM bytes/timestamps disagree: %.3fs vs %.3fs (%d bytes, encoding %d)" %
                                     (pcm_seconds, timestamp_seconds, pcm_bytes, info.encoding))
    finally:
        if codec is not None:
            if started:
                try:
                    codec.stop()
                except Exception:
                    pass
            try:
                codec.release()
            finally:
                extractor.release()
        else:
            extractor.release()


def analyze_file(path, cancel, progress=lambda fraction: None, on_retry=lambda reason: None):
    result = None
    last_notice = 0
    flac = flac_stream_info(path)
    def on_format(info):
        nonlocal result
        if flac:
            rate, channels, bits, frames = flac
            if (info.rate, info.channels) != (rate, channels):
                raise PcmFormatError("FLAC STREAMINFO and decoded format disagree")
            if frames:
                info.duration = frames / rate
        result = StreamingAnalysis(info, cancel)
    def on_pcm(data):
        nonlocal last_notice
        result.accept(data)
        now = time.monotonic()
        if now - last_notice > 0.4:
            last_notice = now
            progress(min(0.99, result.frames / result.info.rate / result.info.duration) if result.info.duration > 0 else None)
    with open(path, "rb") as f:
        head = f.read(12)
    if flac:
        read_flac(path, cancel, on_format, on_pcm)
    elif head[:4] == b"RIFF" and head[8:] == b"WAVE":
        read_wave(path, cancel, on_format, on_pcm)
    else:
        retry_reason = ""
        for requested in (4, 2):
            check_cancel(cancel)
            result = None
            last_notice = 0
            try:
                decode_android(path, cancel, on_format, on_pcm, requested)
                if result is not None:
                    result.info.retry_reason = retry_reason
                break
            except PcmFormatError as exc:
                if requested == 2:
                    raise
                retry_reason = str(exc)
                on_retry(retry_reason)
    if result is None:
        raise AudioError("empty")
    return result.finish()


def supported_message(message):
    if message is None or message.getDocument() is None:
        return False
    doc = message.getDocument()
    name = str(message.getDocumentName() or "").lower()
    return bool(message.isMusic() or message.isVoice() or str(doc.mime_type or "").startswith("audio/")
                or name.rsplit(".", 1)[-1] in EXTENSIONS)


def local_audio(message, loader):
    candidates = []
    attached = str(message.messageOwner.attachPath or "")
    if attached:
        candidates.append(attached)
    candidates.append(str(loader.getPathToMessage(message.messageOwner).getAbsolutePath()))
    doc = message.getDocument()
    for cache in (False, True):
        candidates.append(str(loader.getPathToAttach(doc, cache).getAbsolutePath()))
    for path in candidates:
        if os.path.isfile(path) and os.access(path, os.R_OK) and os.path.getsize(path) > 0:
            return path
    return None


def _supported_language(locale):
    tag = str(locale.getLanguage() or "").strip().lower().replace("_", "-")
    if not tag or tag == "und":
        return None
    return "ru" if tag.split("-", 1)[0] == "ru" else "en"


def language():
    """Device language, independent of client language packs or app overrides."""
    try:
        config = jclass("android.content.res.Resources").getSystem().getConfiguration()
        try:
            locales = config.getLocales()  # Public Android API 24+; first = device's primary language.
            locale = locales.get(0) if not locales.isEmpty() else None
        except Exception:
            locale = config.locale  # Public legacy Android API, before LocaleList.
        if locale is not None:
            selected = _supported_language(locale)
            if selected is not None:
                return selected
    except Exception:
        pass
    try:
        selected = _supported_language(jclass("java.util.Locale").getDefault())
        if selected is not None:
            return selected
    except Exception:
        pass
    return "ru"


def localized_number(value, lang):
    text = "%.1f" % value
    return text.replace(".", ",") if lang == "ru" else text


def audio_format_name(mime):
    return {"audio/mpeg": "MP3", "audio/mp3": "MP3", "audio/mp4a-latm": "AAC",
            "audio/aac": "AAC", "audio/flac": "FLAC", "audio/x-flac": "FLAC",
            "audio/wav": "WAV", "audio/x-wav": "WAV", "audio/alac": "ALAC",
            "audio/opus": "Opus", "audio/vorbis": "Vorbis", "audio/3gpp": "AMR",
            "audio/amr-wb": "AMR-WB"}.get(mime, mime.replace("audio/", "").upper())


def duration_label(seconds):
    minutes, seconds = divmod(max(0, int(seconds)), 60)
    hours, minutes = divmod(minutes, 60)
    return "%d:%02d:%02d" % (hours, minutes, seconds) if hours else "%d:%02d" % (minutes, seconds)


def session_click(session, method, *args):
    reference = weakref.ref(session)
    def invoke(view):
        owner = reference()
        if owner is not None and not owner.cancel.is_set():
            getattr(owner, method)(*args)
    scope = getattr(getattr(session,"plugin",None),"_ui_scope",None)
    if scope is not None:
        from extera_utils.lifecycle import bind_task
        invoke = bind_task(invoke,scope=scope)
    listener = OnClickListener(invoke)
    # Keep the Python proxy alive for as long as the native view is interactive.
    if not hasattr(session,"_click_listeners"): session._click_listeners = []
    session._click_listeners.append(listener)
    return listener


class DownloadObserver(dynamic_proxy(jclass("org.telegram.messenger.NotificationCenter$NotificationCenterDelegate"))):
    def __init__(self, session):
        super().__init__()
        self.session = session
    def didReceivedNotification(self, event, account, args):
        try:
            self.session.on_notification(event, account, args)
        except Exception as exc:
            self.session.fail("failed", exc)


class DismissListener(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = weakref.WeakMethod(fn) if getattr(fn,"__self__",None) is not None else fn
        self.weak = isinstance(self.fn,weakref.WeakMethod)
    def onDismiss(self, dialog):
        fn = self.fn() if self.weak else self.fn
        if fn is not None:
            try:
                fn()
            except Exception as exc:
                # Exceptions crossing a JNI lifecycle callback terminate the app.
                owner = getattr(fn, '__self__', None)
                plugin = getattr(owner, 'plugin', None)
                if plugin is not None: plugin.log('SpekGram dismiss cleanup: %s' % exc)


# Bind lazily when an analyzer is opened, so load only needs the public menu SDK.
_GRAPH_CLASS = None

def dispose_graph(graph):
    """Release each managed View peer and bitmap after the native dismissal detaches it."""
    bitmap = graph.bitmap
    graph.result = None
    graph.bitmap = None
    graph.session = None
    finished = False
    def release():
        nonlocal finished
        if finished:
            return
        try:
            if graph.java.isAttachedToWindow():
                run_on_ui_thread(release, 100)
                return
        except Exception:
            pass
        finished = True
        if bitmap is not None:
            try:
                bitmap.recycle()
            except Exception:
                pass
        try:
            graph.jrelease()
        except Exception:
            pass
    release()

# A ScrollView must leave downward drags to the client's native sheet gesture.
_SHEET_SCROLL_CLASS = None


def sheet_scroll_class():
    global _SHEET_SCROLL_CLASS
    if _SHEET_SCROLL_CLASS is not None:
        return _SHEET_SCROLL_CLASS
    from extera_utils.classes import Base, java_subclass, joverride
    @java_subclass(jclass("android.widget.ScrollView"))
    class SheetScrollView(Base):
        def __init__(self, context):
            self.session = None
            self.allow_sheet_swipe = False
        @joverride()
        def dispatchTouchEvent(self, event):
            owner = self.session
            action = int(event.getActionMasked())
            try:
                if owner is not None and owner.sheet is not None:
                    if action == 0:
                        # Freeze the exclusion for the whole gesture, even if a finger leaves the graph.
                        over_graph = False
                        graph = owner.graph
                        if graph is not None and graph.java.getVisibility() == 0:
                            location = jarray(jint)([0, 0])
                            graph.java.getLocationOnScreen(location)
                            x, y = float(event.getRawX()), float(event.getRawY())
                            over_graph = (location[0] <= x < location[0] + graph.java.getWidth() and
                                          location[1] <= y < location[1] + graph.java.getHeight())
                        self.allow_sheet_swipe = not over_graph and not self.java.canScrollVertically(-1)
                        owner.sheet.setCanDismissWithSwipe(self.allow_sheet_swipe)
                    elif int(event.getPointerCount()) > 1:
                        self.allow_sheet_swipe = False
                        owner.sheet.setCanDismissWithSwipe(False)
                        self.java.getParent().requestDisallowInterceptTouchEvent(True)
            except Exception as exc:
                self.allow_sheet_swipe = False
                if owner is not None:
                    if owner.sheet is not None: owner.sheet.setCanDismissWithSwipe(False)
                    owner.plugin.log("SpekGram sheet gesture: %s" % type(exc).__name__)
            handled = super().dispatchTouchEvent(event)
            if action in (1, 3):
                self.allow_sheet_swipe = False
                if owner is not None and owner.sheet is not None:
                    owner.sheet.setCanDismissWithSwipe(True)
            return handled
        @joverride()
        def requestDisallowInterceptTouchEvent(self, disallow):
            # ScrollView otherwise cancels the sheet's tracking before it can take the drag.
            if disallow and self.allow_sheet_swipe:
                return
            super().requestDisallowInterceptTouchEvent(disallow)
    _SHEET_SCROLL_CLASS = SheetScrollView
    return _SHEET_SCROLL_CLASS


def dispose_sheet_scroll(scroll):
    scroll.session = None
    def release():
        try:
            if scroll.java.isAttachedToWindow():
                run_on_ui_thread(release, 100)
                return
            scroll.jrelease()
        except Exception:
            pass
    release()


