def material_icon(context, action):
    # Draw the original vector path directly with antialiasing at the view bounds.
    path = jclass("androidx.core.graphics.PathParser").createPathFromPathData(MATERIAL_ICON_PATHS[action])
    matrix = jclass("android.graphics.Matrix")(); matrix.setTranslate(0.0, 960.0)
    path.transform(matrix)
    shape = jclass("android.graphics.drawable.shapes.PathShape")(path, 960.0, 960.0)
    drawable = jclass("android.graphics.drawable.ShapeDrawable")(shape)
    drawable.setIntrinsicWidth(960); drawable.setIntrinsicHeight(960)
    paint = drawable.getPaint(); paint.setAntiAlias(True); paint.setColor(jint(-1))
    return drawable


class GraphViewport:
    def __init__(self):
        self.start, self.span, self.cursor = 0.0, 1.0, None
    def zoom(self, factor):
        center = self.cursor[0] if self.cursor else self.start + self.span/2
        self.span = max(1/16, min(1.0, self.span/factor))
        self.start = max(0.0, min(1-self.span, center-self.span/2))
    def pan(self, direction):
        self.start = max(0.0, min(1-self.span, self.start+direction*self.span/2))
    def reset(self):
        self.start, self.span, self.cursor = 0.0, 1.0, None


def graph_class():
    global _GRAPH_CLASS
    if _GRAPH_CLASS is not None:
        return _GRAPH_CLASS
    from extera_utils.classes import Base, java_subclass, joverride
    View = jclass("android.view.View")
    Paint = jclass("android.graphics.Paint")
    RectF = jclass("android.graphics.RectF")
    @java_subclass(View)
    class SpectrogramView(Base):
        def __init__(self, context):
            self.result = None
            self.bitmap = None
            self.session = None
            self.viewport = GraphViewport()
            self.plot_bounds = None
            # Bitmap paint must never inherit text color/alpha or border style.
            self.bitmap_paint = Paint(3)
            self.bitmap_paint.setAlpha(jint(255))
            self.paint = Paint(1)
            self.border_paint = Paint(1)
            self.border_paint.setStyle(Paint.Style.STROKE)
            self.rect = RectF()
        @joverride()
        def onDraw(self, canvas):
            # Never let a Python exception escape through an Android draw callback.
            try:
                self.draw_graph(canvas)
            except Exception as exc:
                if self.session:
                    self.session.plugin.log("SpekGram draw failed: %s" % exc)
        @joverride()
        def onTouchEvent(self, event):
            if self.result is None or self.plot_bounds is None or self.session is None:
                return False
            action = int(event.getActionMasked())
            left, top, right, bottom = self.plot_bounds
            x, y = float(event.getX()), float(event.getY())
            if action == 0 and not (left <= x <= right and top <= y <= bottom):
                return False
            parent = self.java.getParent()
            if parent is not None: parent.requestDisallowInterceptTouchEvent(action not in (1,3))
            v = self.viewport
            if action == 0:
                self.touch_origin = (x,y,v.start)
                self.pinching = False
            if int(event.getPointerCount()) >= 2:
                x2,y2 = float(event.getX(1)),float(event.getY(1))
                distance = max(1.0, math.hypot(x2-x,y2-y))
                focus = max(0.0,min(1.0,((x+x2)/2-left)/(right-left)))
                if not getattr(self,"pinching",False):
                    self.pinch_origin = (distance,v.span,v.start+focus*v.span)
                    self.pinching = True
                else:
                    d,span,center = self.pinch_origin
                    v.span = max(1/16,min(1.0,span*d/distance))
                    v.start = max(0.0,min(1-v.span,center-focus*v.span))
                self.session.show_cursor();self.java.invalidate();return True
            if getattr(self,"pinching",False):
                if action in (1,3): self.pinching = False
                return True
            if action in (0,1,2):
                tx = max(0.0,min(1.0,(x-left)/(right-left)))
                fy = max(0.0,min(1.0,1-(y-top)/(bottom-top)))
                origin = getattr(self,"touch_origin",(x,y,v.start))
                if action == 2 and v.span < 1 and abs(x-origin[0]) > 16:
                    v.start = max(0.0,min(1-v.span,origin[2]-(x-origin[0])/(right-left)*v.span))
                    v.cursor = None
                elif action != 1 or math.hypot(x-origin[0],y-origin[1]) < 16:
                    v.cursor = (v.start+tx*v.span,fy)
                self.session.show_cursor();self.java.invalidate()
                if action == 1: self.java.performClick()
            return True
        def draw_graph(self, canvas):
            if self.bitmap is None or self.result is None:
                return
            Theme = jclass("org.telegram.ui.ActionBar.Theme")
            AU = jclass("org.telegram.messenger.AndroidUtilities")
            width, height = self.java.getWidth(), self.java.getHeight()
            sp = self.java.getResources().getDisplayMetrics().scaledDensity
            self.paint.setTextSize(13 * sp)
            left = max(AU.dp(44), self.paint.measureText("192.0") + AU.dp(8))
            top, right, bottom = AU.dp(20), width - AU.dp(8), height - AU.dp(32)
            if right <= left or bottom <= top:
                return
            self.rect.set(float(left), float(top), float(right), float(bottom))
            self.plot_bounds = (left, top, right, bottom)
            viewport = getattr(self, "viewport", None)
            start, span = (viewport.start, viewport.span) if viewport else (0.0, 1.0)
            source = None
            if span < 1:
                Rect = jclass("android.graphics.Rect")
                bw, bh = self.bitmap.getWidth(), self.bitmap.getHeight()
                sx = min(bw-1, int(start*bw))
                source = Rect(sx, 0, max(sx+1, min(bw, int((start+span)*bw))), bh)
            canvas.drawBitmap(self.bitmap, source, self.rect, self.bitmap_paint)
            # Chaquopy otherwise chooses setColor(long ColorLong), not ARGB int.
            self.paint.setColor(jint(self.session.text_color(Theme.key_dialogTextGray)))
            lang = getattr(self.session, "lang", "ru")
            strings = STRINGS[lang]
            for i in range(5):
                hz = self.result.info.rate / 2 * (1 - i / 4)
                y = top + (bottom - top) * i / 4
                label = localized_number(hz / 1000, lang)
                canvas.drawText(label, float(left - self.paint.measureText(label) - AU.dp(6)), float(y + AU.dp(4)), self.paint)
            canvas.drawText(strings["khz"], float(left), float(top - AU.dp(5)), self.paint)
            for i in range(5):
                seconds = self.result.duration * (start+span*i/4)
                label = "%d:%02d" % (int(seconds) // 60, int(seconds) % 60) if self.result.duration >= 60 else localized_number(seconds, lang)
                x = left + (right - left) * i / 4
                x = max(left, min(right - self.paint.measureText(label), x - self.paint.measureText(label) / 2))
                canvas.drawText(label, float(x), float(bottom + AU.dp(18)), self.paint)
            self.border_paint.setStrokeWidth(float(AU.dp(1)))
            border = readable_color(self.session.color(Theme.key_divider),
                                    self.session.color(Theme.key_dialogBackground), 1.5)
            self.border_paint.setColor(jint(border))
            canvas.drawRect(self.rect, self.border_paint)
            if viewport and viewport.cursor:
                tx, fy = viewport.cursor
                if start <= tx <= start+span:
                    cx, cy = left+(tx-start)/span*(right-left), bottom-fy*(bottom-top)
                    self.border_paint.setColor(jint(self.session.text_color(Theme.key_dialogTextGray)))
                    canvas.drawLine(float(cx), float(top), float(cx), float(bottom), self.border_paint)
                    canvas.drawLine(float(left), float(cy), float(right), float(cy), self.border_paint)
    _GRAPH_CLASS = SpectrogramView
    return _GRAPH_CLASS


_FAST_KERNEL = None
_FAST_KERNEL_ERROR = None
_FAST_KERNEL_LOCK = threading.Lock()

@dataclass
class RasterResult:
    info: AudioInfo
    frames: int
    width: int
    height: int
    pixels: object
    native_pixels: bool = False
    cache_hit: bool = False
    report: object = None

    @property
    def duration(self):
        return self.frames / self.info.rate

    def raster(self):
        return self.width, self.height, self.pixels


def load_fast_kernel():
    global _FAST_KERNEL, _FAST_KERNEL_ERROR
    with _FAST_KERNEL_LOCK:
        if _FAST_KERNEL is not None:
            return _FAST_KERNEL
        if _FAST_KERNEL_ERROR is not None:
            return None
        try:
            if int(jclass("android.os.Build$VERSION").SDK_INT) < 26:
                raise RuntimeError("JVM acceleration requires Android API 26+")
            data = jclass("android.util.Base64").decode(_FAST_DEX_B64, 0)
            if hashlib.sha256(bytes(data)).hexdigest() != _FAST_DEX_SHA256:
                raise RuntimeError("Embedded DEX integrity mismatch")
            buffer = jclass("java.nio.ByteBuffer").wrap(data)
            parent = jclass("java.lang.ClassLoader").getSystemClassLoader()
            loader = jclass("dalvik.system.InMemoryDexClassLoader")(buffer, parent)
            clazz = loader.loadClass("org.spekgram.fast.FastFlac")
            Class = jclass("java.lang.Class")
            method = clazz.getMethod("analyze", Class.forName("java.lang.String"),
                                     Class.forName("java.util.concurrent.atomic.AtomicBoolean"),
                                     Class.forName("java.util.concurrent.atomic.AtomicLong"))
            _FAST_KERNEL = (loader, method)  # keep the class loader alive
        except Exception as exc:
            _FAST_KERNEL_ERROR = str(exc)
        return _FAST_KERNEL


def analyze_fast_flac(path, cancel_event, native_cancel, native_progress):
    kernel = load_fast_kernel()
    if kernel is None:
        return None
    check_cancel(cancel_event)
    while not _DECODER_LOCK.acquire(timeout=0.1):
        check_cancel(cancel_event)
    try:
        check_cancel(cancel_event)
        try:
            payload = kernel[1].invoke(None, path, native_cancel, native_progress)
        except Exception as exc:
            if cancel_event.is_set() or native_cancel.get():
                raise Cancelled() from exc
            try:
                cause = exc.getCause()
                detail = str(cause.getMessage()) if cause is not None else type(exc).__name__
            except Exception:
                detail = type(exc).__name__
            raise AudioError("JVM FLAC: " + detail) from exc
        check_cancel(cancel_event)
        rate, channels, depth, frames, width, height = [int(v) for v in payload[0]]
        info = AudioInfo(rate, channels, 2 if depth <= 16 else 21 if depth <= 24 else 22,
                         frames / rate, "audio/flac", decoder="SpekGram JVM FLAC", source_bits=depth)
        info.validate()
        if not 1 <= width <= MAX_COLUMNS or height != PLOT_ROWS or len(payload[1]) != width*height:
            raise AudioError("Invalid JVM spectrogram dimensions")
        # Convert the bounded Java float array once. Do not retain raw spectra in cache.
        grid = list(payload[2])
        if len(grid) != width*height:
            raise AudioError("Invalid JVM assessment dimensions")
        report = assess_spectrum([grid[x*height:(x+1)*height] for x in range(width)],
                                 rate, frames/rate, cancel_event)
        return RasterResult(info, frames, width, height, payload[1], native_pixels=True, report=report)
    finally:
        _DECODER_LOCK.release()


_CACHE_LOCK = threading.Lock()
_MEMORY_CACHE = OrderedDict()
_CACHE_LIMIT = 16 * 1024 * 1024
_CACHE_ALGORITHM = b"spekgram-0.2.0-hann2048-rows256-cols640-db100-assessment1"
_CACHE_MAGIC = b"SGCACHE5"


def cache_key(path, cancel):
    digest = hashlib.sha256(_CACHE_ALGORITHM)
    with open(path, "rb") as stream:
        while True:
            check_cancel(cancel)
            data = stream.read(262144)
            if not data:
                break
            digest.update(data)
    return digest.hexdigest()


def cache_root():
    try:
        from file_utils import get_cache_dir
        root = os.path.join(str(get_cache_dir()), "spekgram")
        os.makedirs(root, exist_ok=True)
        return root
    except Exception:
        return None


def _cache_name(name):
    return name.endswith(".sgc") and len(name) == 68 and all(c in "0123456789abcdef" for c in name[:64])


def cache_load(key, root):
    with _CACHE_LOCK:
        if key in _MEMORY_CACHE:
            result = _MEMORY_CACHE[key]
            _MEMORY_CACHE.move_to_end(key)
            result.cache_hit = True
            return result
        if root is None:
            return None
        path = os.path.join(root, key + ".sgc")
        try:
            with open(path, "rb") as stream:
                data = stream.read(MAX_COLUMNS*PLOT_ROWS*4 + 8192)
            if not data.startswith(_CACHE_MAGIC) or len(data) < 44:
                return None
            if hashlib.sha256(data[:-32]).digest() != data[-32:]:
                return None
            size = struct.unpack_from("<I", data, 8)[0]
            if size > 4096:
                return None
            metadata = json.loads(data[12:12+size])
            width, height = metadata["width"], metadata["height"]
            if not isinstance(width, int) or not 1 <= width <= MAX_COLUMNS or height != PLOT_ROWS:
                return None
            raw = data[12+size:-32]
            if len(raw) != width*height*4:
                return None
            info = AudioInfo(**metadata["info"]); info.validate()
            frames = metadata["frames"]
            if not isinstance(frames, int) or frames <= 0:
                return None
            pixels = struct.unpack("<%dI" % (width*height), raw)
            report = SpectrumReport(**metadata["report"]); report.validate()
            result = RasterResult(info, frames, width, height, pixels, cache_hit=True, report=report)
            _MEMORY_CACHE[key] = result
            while len(_MEMORY_CACHE) > 4:
                _MEMORY_CACHE.popitem(last=False)
            os.utime(path, None)
            return result
        except Exception:
            return None


def cache_store(key, result, root):
    width, height, pixels = result.raster()
    if not 1 <= width <= MAX_COLUMNS or height != PLOT_ROWS:
        return
    # Cache only verified immutable spectral data; never View, Bitmap, codec or PCM.
    cached = RasterResult(result.info, result.frames, width, height, pixels,
                          native_pixels=isinstance(result, RasterResult) and result.native_pixels,
                          report=getattr(result, "report", None) or SpectrumReport())
    cached.report.validate()
    with _CACHE_LOCK:
        _MEMORY_CACHE[key] = cached
        _MEMORY_CACHE.move_to_end(key)
        while len(_MEMORY_CACHE) > 4:
            _MEMORY_CACHE.popitem(last=False)
        if root is None:
            return
        path = os.path.join(root, key + ".sgc")
        temporary = path + ".tmp"
        try:
            metadata = json.dumps({"info": vars(result.info), "frames": result.frames,
                                   "width": width, "height": height,
                                   "report": vars(cached.report)}, allow_nan=False).encode()
            raw = struct.pack("<%dI" % len(pixels), *(int(v) & 0xffffffff for v in pixels))
            data = _CACHE_MAGIC + struct.pack("<I", len(metadata)) + metadata + raw
            with open(temporary, "wb") as stream:
                stream.write(data); stream.write(hashlib.sha256(data).digest())
            os.replace(temporary, path)
            files = [(os.stat(os.path.join(root,n)).st_mtime, os.path.join(root,n), os.path.getsize(os.path.join(root,n)))
                     for n in os.listdir(root) if _cache_name(n)]
            total = sum(size for _, _, size in files)
            for _, old, size in sorted(files):
                if total <= _CACHE_LIMIT:
                    break
                os.remove(old); total -= size
        except Exception:
            try:
                os.remove(temporary)
            except OSError:
                pass


def clear_result_cache():
    complete = True
    with _CACHE_LOCK:
        _MEMORY_CACHE.clear()
        root = cache_root()
        if root:
            for name in os.listdir(root):
                if _cache_name(name):
                    try:
                        os.remove(os.path.join(root, name))
                    except OSError:
                        complete = False
        else:
            complete = False
    return complete


class AnalysisSession:
    """One selected message/account; UI lifecycle and download observer run on UI thread."""
    def __init__(self, plugin, context):
        self.plugin, self.message = plugin, context.get("message")
        self.fragment = context.get("fragment") or get_last_fragment()
        if self.fragment is None or self.fragment.getParentActivity() is None:
            raise AudioError("No foreground activity")
        self.activity = self.fragment.getParentActivity()
        # MessageObject.currentAccount is the authoritative account for this file.
        self.account = int(self.message.currentAccount)
        self.loader = jclass("org.telegram.messenger.FileLoader").getInstance(self.account)
        self.NC = jclass("org.telegram.messenger.NotificationCenter")
        self.center = self.NC.getInstance(self.account)
        self.cancel = threading.Event()
        self.observer = None
        self.sheet = None
        self.graph = None
        self.worker = None
        self.lang = language()
        self.strings = STRINGS[self.lang]
        self.status_text = self.strings["working"]
        self.progress = None
        self.native_cancel = None
        self.native_progress = None
        self.native_total = 0
        self.state = "new"
        self.graph_expanded = True
        self.help_dialog = None
        self.error_detail = ""
        self._theme_signature = None
        self.provider = None
        try:
            self.provider = self.fragment.getResourceProvider()
        except Exception:
            pass

    def color(self, key):
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        return Theme.getColor(key, self.provider) if self.provider is not None else Theme.getColor(key)

    def text_color(self, key):
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        return readable_color(self.color(key), self.color(Theme.key_dialogBackground))

    def show(self):
        Theme = jclass('org.telegram.ui.ActionBar.Theme')
        AU = jclass('org.telegram.messenger.AndroidUtilities')
        Layout = jclass('android.widget.LinearLayout')
        self.labels, self.click_views = [], []
        sheet_container(self)
        self.track_name = str(self.message.getDocumentName() or 'SpekGram')
        artist = ''
        try:
            attrs = self.message.getDocument().attributes
            for i in range(attrs.size()):
                attr = attrs.get(i)
                if hasattr(attr, 'title') and attr.title:
                    self.track_name, artist = str(attr.title), str(attr.performer or '')
                    break
        except Exception: pass
        def text(value, size, key, strong=False, top=4, bottom=4):
            return sheet_text(self, self.root, value, size, key, strong, top, bottom)
        self.title = text(self.track_name, 20, Theme.key_dialogTextBlack, True, 16, 2)
        self.title.setMaxLines(2); self.title.setEllipsize(jclass('android.text.TextUtils$TruncateAt').END)
        self.artist = text(artist, 14, Theme.key_dialogTextGray, top=0, bottom=4)
        self.artist.setMaxLines(1); self.artist.setEllipsize(jclass('android.text.TextUtils$TruncateAt').END)
        if not artist: self.artist.setVisibility(8)
        self.status = text(self.status_text, 14, Theme.key_dialogTextGray, top=0, bottom=10)
        self.progress_view = jclass('android.widget.ProgressBar')(self.activity)
        self.root.addView(self.progress_view, Layout.LayoutParams(-1, AU.dp(40)))
        self.summary_title = text('', 16, Theme.key_dialogTextBlack, True, 8, 4)
        self.summary_detail = text('', 14, Theme.key_dialogTextGray, top=0, bottom=8)
        self.summary_action = text('', 14, Theme.key_dialogTextGray)
        self.format_note = text('', 14, Theme.key_dialogTextGray)
        self.origin_note = text(self.strings['origin'], 13, Theme.key_dialogTextGray)
        self.graph_toggle = text(self.strings['show_graph'], 16, Theme.key_dialogButton)
        self.graph_toggle.setOnClickListener(session_click(self, 'toggle_graph'))
        self.summary_views = (self.summary_title, self.summary_detail, self.summary_action,
                              self.format_note, self.origin_note, self.graph_toggle)
        for view in self.summary_views: view.setVisibility(8)
        self.graph = graph_class().new_instance(self.activity); self.graph.session = self
        graph_height = max(180, min(320, int(AU.displaySize.y / AU.density * .32)))
        graph_params = Layout.LayoutParams(-1, AU.dp(graph_height))
        graph_params.setMargins(AU.dp(12), AU.dp(4), AU.dp(12), 0)
        self.root.addView(self.graph.java, graph_params); self.graph.java.setVisibility(8)
        self.cursor_label = text(self.strings['inspect'], 13, Theme.key_dialogTextGray, top=0, bottom=4)
        self.cursor_label.setGravity(17); self.cursor_label.setVisibility(8)
        self.graph_controls = Layout(self.activity); self.graph_controls.setOrientation(0); self.graph_controls.setGravity(17)
        self.root.addView(self.graph_controls, Layout.LayoutParams(-1, -2))
        self.touch_buttons = []
        for action in ('in', 'out', 'left', 'right', 'reset'):
            control = jclass('android.widget.ImageButton')(self.activity)
            control.setImageDrawable(material_icon(self.activity, action))
            control.setScaleType(jclass('android.widget.ImageView$ScaleType').FIT_CENTER)
            control.setPadding(AU.dp(11), AU.dp(11), AU.dp(11), AU.dp(11))
            description = self.strings[{'in':'zoom_in','out':'zoom_out','left':'move_left','right':'move_right','reset':'reset_zoom'}[action]]
            control.setContentDescription(description)
            try: control.setTooltipText(description)
            except Exception: pass
            control.setOnClickListener(session_click(self, 'graph_action', action))
            self.touch_buttons.append(control)
            params = Layout.LayoutParams(AU.dp(48), AU.dp(48)); params.setMargins(AU.dp(4), AU.dp(4), AU.dp(4), AU.dp(4))
            self.graph_controls.addView(control, params)
        self.graph_controls.setVisibility(8)
        self.caption = text(self.strings['inspect'], 13, Theme.key_dialogTextGray, top=4, bottom=8)
        self.caption.setGravity(17); self.caption.setVisibility(8)
        self.help_button = jclass('org.telegram.ui.Cells.TextCell')(self.activity, self.provider)
        self.help_button.setTextAndIcon(self.strings['help'], jclass('org.telegram.messenger.R$drawable').msg_info, True)
        self.help_button.setOffsetFromImage(57)  # 12 dp between the 24 dp icon and label.
        self.help_button.setOnClickListener(session_click(self, 'show_help'))
        self.help_button.setVisibility(8); self.root.addView(self.help_button, Layout.LayoutParams(-1, -2))
        self.click_views.append(self.help_button)
        self.retry_button = text(self.strings['try_again'], 16, Theme.key_dialogButton)
        self.retry_button.setMinHeight(AU.dp(48)); self.retry_button.setGravity(17)
        self.retry_button.setOnClickListener(session_click(self, 'retry_analysis')); self.retry_button.setVisibility(8)
        self.button = sheet_button(self, self.container, self.strings['cancel'], 'dismiss_sheet')
        self.sheet = jclass('org.telegram.ui.ActionBar.BottomSheet').Builder(self.activity, False, self.provider).setCustomView(self.container).create()
        self.sheet.setCanDismissWithSwipe(True)
        self.dismiss_listener = DismissListener(self.close); self.sheet.setOnDismissListener(self.dismiss_listener)
        self.sheet.show(); self.refresh_theme()
        self.worker = threading.Thread(target=self._resolve, name='SpekGram-file', daemon=True); self.worker.start()

    def refresh_theme(self):
        if self.cancel.is_set() or self.sheet is None: return
        try:
            Theme = jclass('org.telegram.ui.ActionBar.Theme')
            keys = sorted({key for _, key in self.labels} | {Theme.key_dialogBackground, Theme.key_listSelector,
                          Theme.key_divider, Theme.key_dialogIcon, Theme.key_dialogTextBlack, Theme.key_dialogTextGray,
                          Theme.key_featuredStickers_addButton, Theme.key_featuredStickers_buttonText, Theme.key_dialogTextBlue2})
            signature = tuple(self.color(key) for key in keys)
            if signature != self._theme_signature:
                self.container.setBackgroundColor(self.color(Theme.key_dialogBackground))
                self.sheet.setBackgroundColor(self.color(Theme.key_dialogBackground))
                for view, key in self.labels: view.setTextColor(self.text_color(key))
                self.button.setColor(self.color(Theme.key_featuredStickers_addButton)); self.button.updateColors()
                self.button.setTextColor(jint(readable_color(self.color(Theme.key_featuredStickers_buttonText),self.color(Theme.key_featuredStickers_addButton))))
                self.help_button.setColors(Theme.key_dialogIcon, Theme.key_dialogTextBlack)
                self.help_button.setBackground(Theme.createSelectorDrawable(self.color(Theme.key_listSelector), 2))
                for view in (self.graph_toggle, self.retry_button):
                    view.setBackground(Theme.createSelectorDrawable(self.color(Theme.key_listSelector), 2))
                AU = jclass('org.telegram.messenger.AndroidUtilities')
                for view in self.touch_buttons:
                    shape = jclass('android.graphics.drawable.GradientDrawable')()
                    bg = int(self.color(Theme.key_dialogBackground)) & 0xffffffff
                    fg = int(self.text_color(Theme.key_dialogButton)) & 0xffffffff
                    blended = 0xff000000
                    for shift in (16,8,0): blended |= round(((bg>>shift)&255)*.92 + ((fg>>shift)&255)*.08) << shift
                    shape.setColor(jint(signed_argb(blended))); shape.setCornerRadius(float(AU.dp(24)))
                    tint = jclass('android.content.res.ColorStateList').valueOf(jint(signed_argb(int(self.color(Theme.key_listSelector)))))
                    view.setBackground(jclass('android.graphics.drawable.RippleDrawable')(tint, shape, None))
                    drawable = view.getDrawable(); drawable.getPaint().setColor(jint(signed_argb(fg))); drawable.invalidateSelf()
                self.graph.java.invalidate()
                if isinstance(self.help_dialog, FileInfoSheet): self.help_dialog.apply_theme()
                self._theme_signature = signature
        except Exception as exc: self.plugin.log('SpekGram theme refresh: %s' % exc)
        run_on_ui_thread(self.refresh_theme, 750)

    def _resolve(self):
        try:
            path = local_audio(self.message, self.loader)
            check_cancel(self.cancel)
            if path:
                self._analyze(path)
            else:
                run_on_ui_thread(self.start_download)
        except Cancelled:
            pass
        except Exception as exc:
            self.fail("codec", exc)

    def start_download(self):
        if self.cancel.is_set():
            return
        try:
            self.state = "downloading"
            self.status.setText(self.strings["download"])
            self.filename = str(jclass("org.telegram.messenger.FileLoader").getAttachFileName(self.message.getDocument()))
            self.observer = DownloadObserver(self)
            for event in (self.NC.fileLoaded, self.NC.fileLoadFailed, self.NC.fileLoadProgressChanged):
                self.center.addObserver(self.observer, event)
            # Observe before checking/loading, avoiding completion between those steps.
            self.worker = threading.Thread(target=self._recheck_download, name="SpekGram-download", daemon=True)
            self.worker.start()
            self.deadline = time.monotonic() + 600
            run_on_ui_thread(self.download_timeout, 1000)
        except Exception as exc:
            self.fail("failed", exc)

    def _recheck_download(self):
        try:
            path = local_audio(self.message, self.loader)
            check_cancel(self.cancel)
            if path:
                run_on_ui_thread(lambda: self.download_ready(path))
            elif not self.loader.isLoadingFile(self.filename):
                check_cancel(self.cancel)
                # Telegram parent MessageObject retains file-reference refresh context.
                self.loader.loadFile(self.message.getDocument(), self.message, self.loader.PRIORITY_NORMAL, 0)
        except Cancelled:
            pass
        except Exception as exc:
            self.fail("failed", exc)

    def download_timeout(self):
        if self.cancel.is_set() or self.state != "downloading":
            return
        if time.monotonic() >= self.deadline:
            self.fail("timeout")
        else:
            run_on_ui_thread(self.download_timeout, 1000)

    def on_notification(self, event, account, args):
        if self.cancel.is_set() or self.state != "downloading" or int(account) != self.account:
            return
        if not args or str(args[0]) != self.filename:
            return
        if event == self.NC.fileLoaded:
            self.remove_observer()
            self.state = "resolving"
            self.worker = threading.Thread(target=self._after_download, name="SpekGram-file", daemon=True)
            self.worker.start()
        elif event == self.NC.fileLoadFailed:
            self.fail("failed")
        elif event == self.NC.fileLoadProgressChanged and len(args) >= 3:
            total = float(args[2])
            if total > 0:
                self.status.setText(self.strings["download"] + " %d%%" % min(100, int(float(args[1]) * 100 / total)))

    def _after_download(self):
        try:
            path = local_audio(self.message, self.loader)
            check_cancel(self.cancel)
            if path is None:
                self.fail("missing")
            else:
                run_on_ui_thread(lambda: self.download_ready(path))
        except Cancelled:
            pass
        except Exception as exc:
            self.fail("missing", exc)

    def download_ready(self, path):
        if self.cancel.is_set() or self.state not in ("downloading", "resolving"):
            return
        self.remove_observer()
        self.state = "analyzing"
        self.status.setText(self.strings["working"])
        self.worker = threading.Thread(target=lambda: self._analyze(path), name="SpekGram-DSP", daemon=True)
        self.worker.start()

    def _analyze(self, path):
        try:
            check_cancel(self.cancel)
            self.state = "analyzing"
            def progress(value):
                label = self.strings["working"] + (" %d%%" % int(value * 100) if value is not None else "")
                run_on_ui_thread(lambda: self.update_progress(label))
            def retry(reason):
                self.plugin.log("SpekGram retry PCM16: %s" % reason)
                run_on_ui_thread(lambda: self.update_progress(self.strings["retry"]))
            started = time.monotonic()
            original_stat = os.stat(path)
            self.file_size = original_stat.st_size
            original_stamp = (original_stat.st_dev, original_stat.st_ino, original_stat.st_size, original_stat.st_mtime_ns)
            key = cache_key(path, self.cancel)
            root = cache_root()
            result = cache_load(key, root)
            cache_hit = result is not None
            if result is None:
                native = flac_stream_info(path)
                if native and load_fast_kernel() is not None:
                    self.native_cancel = jclass("java.util.concurrent.atomic.AtomicBoolean")(False)
                    self.native_progress = jclass("java.util.concurrent.atomic.AtomicLong")(0)
                    self.native_total = native[3]
                    check_cancel(self.cancel)
                    run_on_ui_thread(self.poll_native_progress)
                    result = analyze_fast_flac(path, self.cancel, self.native_cancel, self.native_progress)
                if result is None:
                    if native:
                        self.plugin.log("SpekGram Python fallback: %s" % _FAST_KERNEL_ERROR)
                    result = analyze_file(path, self.cancel, progress, retry)
                    result.report = assess_spectrum(result.columns, result.info.rate, result.duration, self.cancel)
            self.native_progress = None
            self.plugin.log("SpekGram decoded: codec=%s PCM=%d rate=%d channels=%d frames=%d duration=%.3fs cached=%s elapsed=%.3fs" %
                            (result.info.decoder, result.info.encoding, result.info.rate, result.info.channels,
                             result.frames, result.duration, cache_hit, time.monotonic()-started))
            width, height, pixels = result.raster()
            check_cancel(self.cancel)
            Bitmap = jclass("android.graphics.Bitmap")
            colors = pixels if isinstance(result, RasterResult) and result.native_pixels else jarray(jint)([signed_argb(c) for c in pixels])
            bitmap = Bitmap.createBitmap(colors, width, height, Bitmap.Config.ARGB_8888)
            run_on_ui_thread(lambda: self.present_result(result, bitmap))
            if not cache_hit and not self.cancel.is_set():
                try:
                    current_stat = os.stat(path)
                    current_stamp = (current_stat.st_dev, current_stat.st_ino, current_stat.st_size, current_stat.st_mtime_ns)
                    if current_stamp == original_stamp:
                        cache_store(key, result, root)
                except OSError:
                    pass  # Telegram may remove its audio cache after decoding has completed.
        except Cancelled:
            pass
        except Exception as exc:
            self.fail("pcm" if isinstance(exc, PcmFormatError) else "empty" if str(exc) == "empty" else "codec", exc)

    def update_progress(self, label):
        if not self.cancel.is_set() and self.state == "analyzing":
            self.status.setText(label)

    def poll_native_progress(self):
        if self.cancel.is_set() or self.native_progress is None or self.state != "analyzing":
            return
        value = int(self.native_progress.get())
        label = self.strings["working"]
        if self.native_total:
            label += " %d%%" % min(99, value*100//self.native_total)
        self.status.setText(label)
        run_on_ui_thread(self.poll_native_progress, 400)

    def present_result(self, result, bitmap):
        if self.cancel.is_set():
            bitmap.recycle()
            return
        self.state = "ready"
        self.graph.result, self.graph.bitmap = result, bitmap
        self.graph.java.setVisibility(0 if self.graph_expanded else 8)
        self.graph.java.setContentDescription(self.strings["menu"] + " • %.1f %s • %d %s" %
                                               (result.duration, self.strings["seconds"], result.info.rate // 2, self.strings["hz"]))
        self.graph.java.invalidate()
        self.progress_view.setVisibility(8)
        info = result.info
        parts = [audio_format_name(info.mime), "%d %s" % (info.rate, self.strings["hz"]),
                 "%d %s" % (info.channels, self.strings["channels"])]
        pcm = self.strings["float_pcm"] if info.encoding == 4 else "%d %s" % ({2:16, 3:8, 21:24, 22:32}[info.encoding], self.strings["bit"])
        parts.append("PCM " + pcm)
        if info.bitrate:
            parts.append("%d %s" % (info.bitrate // 1000, self.strings["kbps"]))
        technical = " • ".join(parts)
        channel_label = (("моно" if info.channels == 1 else "стерео" if info.channels == 2 else "%d каналов" % info.channels)
                         if self.lang == "ru" else ("mono" if info.channels == 1 else "stereo" if info.channels == 2 else "%d channels" % info.channels))
        duration = duration_label(result.duration)
        simple = [audio_format_name(info.mime), channel_label, duration]
        if info.source_bits:
            simple.insert(1, "%d %s" % (info.source_bits, self.strings["bit"]))
        self.status.setText(" • ".join(simple))
        voice = False
        try:
            voice = bool(self.message.isVoice())
        except Exception:
            pass
        title, detail, action, note = assessment_text(getattr(result, "report", None), info, self.lang, voice)
        for view, value in ((self.summary_title, title), (self.summary_detail, detail),
                            (self.summary_action, action), (self.format_note, note)):
            view.setText(value)
        self.assessment_detail, self.assessment_action, self.assessment_format = detail, action, note
        state = 'voice' if voice else getattr(getattr(result, 'report', None), 'state', 'unknown')
        self.summary_detail.setText(UI_COPY[self.lang].get(state, UI_COPY[self.lang]['unknown']))
        self.result_details = "\n\n".join((title, detail, action, note, self.strings["origin"]))
        for view in self.summary_views:
            view.setVisibility(0 if view in (self.summary_title, self.summary_detail) else 8)
        self.graph_toggle.setText(self.strings["hide_graph"] if self.graph_expanded else self.strings["show_graph"])
        self.help_button.setVisibility(0)
        self.retry_button.setVisibility(8)
        self.caption.setVisibility(0 if self.graph_expanded else 8)
        for view in (self.graph_controls, self.cursor_label):
            view.setVisibility(0 if self.graph_expanded else 8)
        detail = self.strings["sampling"]
        if isinstance(result, RasterResult) and result.cache_hit:
            detail += " • " + self.strings["cached"]
        elif info.mime == "audio/flac":
            fast = info.decoder == "SpekGram JVM FLAC"
            detail += " • " + self.strings["fast" if fast else "compat"]
        self.caption.setText(self.strings["inspect"])
        self.technical_details = technical + "\n" + self.strings["overview"] + "\n" + detail
        self.show_cursor()
        self.button.setText(self.strings["close"])
        self.button.setContentDescription(self.strings["close"])

    def toggle_graph(self):
        if self.cancel.is_set() or self.state != "ready":
            return
        self.graph_expanded = not self.graph_expanded
        self.graph.java.setVisibility(0 if self.graph_expanded else 8)
        self.caption.setVisibility(0 if self.graph_expanded else 8)
        for view in (self.graph_controls, self.cursor_label):
            view.setVisibility(0 if self.graph_expanded else 8)
        self.graph_toggle.setText(self.strings["hide_graph"] if self.graph_expanded else self.strings["show_graph"])
        try:
            self.plugin.set_setting("show_graph", self.graph_expanded)
        except Exception:
            pass  # A settings-write failure must not block showing the graph.

    def graph_action(self, action):
        if self.cancel.is_set() or self.state != "ready":
            return
        viewport = self.graph.viewport
        if action == "reset": viewport.reset()
        elif action in ("in", "out"): viewport.zoom(2 if action == "in" else 0.5)
        else: viewport.pan(-1 if action == "left" else 1)
        self.show_cursor()
        self.graph.java.invalidate()

    def show_cursor(self):
        cursor = self.graph.viewport.cursor
        if cursor:
            tx, fy = cursor
            value = localized_number(tx*self.graph.result.duration, self.lang)
            self.cursor_label.setText(value+" "+self.strings["seconds"]+" • "+localized_number(fy*self.graph.result.info.rate/2000, self.lang)+" "+self.strings["khz"])
        else:
            viewport = self.graph.viewport
            duration = self.graph.result.duration
            self.cursor_label.setText(duration_label(duration*viewport.start)+" — "+duration_label(duration*(viewport.start+viewport.span))+"  ·  "+localized_number(1/viewport.span,self.lang)+"×")

    def dismiss_sheet(self):
        if self.sheet is not None: self.sheet.dismiss()

    def retry_analysis(self):
        if self.cancel.is_set() or self.state != "error":
            return
        self.state = "retrying"  # Ignore double taps before the UI callback runs.
        self.plugin.open_analyzer({"message": self.message, "fragment": self.fragment})

    def show_help(self):
        if self.cancel.is_set() or self.state not in ('ready', 'error'): return
        if self.help_dialog is not None: self.help_dialog.dismiss()
        if self.state == 'error':
            self.help_dialog = AlertDialogBuilder(self.activity, resources_provider=self.provider)
            self.help_dialog.set_title(self.strings['error_details'])
            self.help_dialog.set_message(self.error_detail)
            self.help_dialog.set_positive_button(self.strings['close']); self.help_dialog.show()
            return
        info = FileInfoSheet(self); self.help_dialog = info
        try: info.show()
        except Exception:
            info.dismiss(); raise

    def fail(self, key, exc=None):
        if exc:
            self.plugin.log("SpekGram %s: %s" % (key, exc))
        def display():
            if self.cancel.is_set() or self.state == "retrying":
                return
            self.state = "error"
            self.remove_observer()
            self.progress_view.setVisibility(8)
            for view in getattr(self, "summary_views", ()):
                view.setVisibility(8)
            if self.graph is not None:
                self.graph.java.setVisibility(8)
            self.caption.setVisibility(8)
            message = self.strings.get(key, self.strings["codec"])
            self.error_detail = ""
            if exc is not None:
                # Exact reason without file paths or message contents, usable from a screenshot.
                detail = str(exc).replace("\n", " ")
                if isinstance(exc, AudioError) and detail:
                    self.error_detail = self.strings["technical_reason"] + "\n" + detail[:320]
                elif detail:
                    self.error_detail = self.strings["technical_reason"] + "\n" + type(exc).__name__
            self.help_button.setTextAndIcon(self.strings["error_details"], jclass("org.telegram.messenger.R$drawable").msg_info, True)
            self.help_button.setOffsetFromImage(57)
            self.help_button.setVisibility(0 if self.error_detail else 8)
            self.retry_button.setVisibility(0)
            self.status.setText(message)
            self.button.setText(self.strings["close"])
            self.button.setContentDescription(self.strings["close"])
        run_on_ui_thread(display)

    def remove_observer(self):
        if self.observer is not None:
            observer, self.observer = self.observer, None
            for event in (self.NC.fileLoaded, self.NC.fileLoadFailed, self.NC.fileLoadProgressChanged):
                self.center.removeObserver(observer, event)

    def close(self):
        self.cancel.set()
        if getattr(self, "help_dialog", None) is not None:
            dialog = self.help_dialog
            self.help_dialog = None
            try:
                dialog.dismiss()
            except Exception as exc:
                self.plugin.log("SpekGram help dismiss: %s" % type(exc).__name__)
        if self.native_cancel is not None:
            self.native_cancel.set(True)
        self.native_progress = None
        self.remove_observer()
        for view, _ in list(getattr(self, "labels", [])) + [(v,None) for v in getattr(self,"touch_buttons",[]) + getattr(self,"click_views",[])]:
            try: view.setOnClickListener(None)
            except Exception: pass
        self.labels = []
        self._click_listeners = []
        if getattr(self,"sheet",None) is not None:
            try: clear_sheet_dismiss_listener(self.sheet)
            except Exception: pass
        if self.graph:
            graph, self.graph = self.graph, None
            dispose_graph(graph)
        if getattr(self, "scroll", None) is not None:
            scroll, self.scroll = self.scroll, None
            dispose_sheet_scroll(scroll)
        self.sheet = None
        self.dismiss_listener = None
        self.root = self.container = None
        self.click_views = []
        self.touch_buttons = []
        self.fragment = None
        self.activity = None
        if self.plugin.session is self:
            self.plugin.session = None
        # Shared Telegram downloads may have other consumers; closing detaches only.


class SpekGramPlugin(BasePlugin):
    def install_list_icon(self):
        self.icon_hook = None
        self.icon_bitmap = None
        try:
            Class = jclass("java.lang.Class")
            loader = jclass("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
            cls = Class.forName("com.exteragram.messenger.plugins.ui.components.PluginCell",False,loader)
            method = cls.getDeclaredMethod("set",Class.forName("com.exteragram.messenger.plugins.Plugin",False,loader),
                        Class.forName("com.exteragram.messenger.plugins.ui.components.PluginCellDelegate",False,loader))
            self.icon_field = cls.getDeclaredField("imageView"); self.icon_field.setAccessible(True)
            self.icon_hook = self.hook_method(method,after=self.bind_list_icon)
        except Exception as exc:
            self.log("SpekGram list icon: %s" % type(exc).__name__)

    def bind_list_icon(self,param):
        if param.args[0] is None or str(param.args[0].getId()) != "spekgram": return
        try:
            if self.icon_bitmap is None:
                Bitmap = jclass("android.graphics.Bitmap")
                self.icon_bitmap = Bitmap.createBitmap(256,256,Bitmap.Config.ARGB_8888)
                canvas = jclass("android.graphics.Canvas")(self.icon_bitmap)
                paint = jclass("android.graphics.Paint")(3)
                paint.setColor(jint(signed_argb(0xff111827)))
                canvas.drawRoundRect(0.0,0.0,256.0,256.0,52.0,52.0,paint)
                heights = [42,68,98,150,110,70,124,174,146,78,110,52]
                for i,height in enumerate(heights):
                    paint.setColor(jint(signed_argb(palette(0.35+i/20))))
                    x = float(26+i*17)
                    canvas.drawRoundRect(x,float(128-height/2),x+11.0,float(128+height/2),5.5,5.5,paint)
            view = self.icon_field.get(param.thisObject)
            view.setVisibility(0); view.setImageBitmap(self.icon_bitmap)
        except Exception as exc:
            self.log("SpekGram icon bind: %s" % type(exc).__name__)

    def remove_list_icon(self):
        hook = getattr(self,"icon_hook",None)
        if hook is not None:
            try: self.unhook_method(hook)
            except Exception: pass
        self.icon_hook = None
        self.icon_bitmap = None  # Visible cells may retain it; do not recycle under a live view.

    DIRECT_ACTION = 0x534750

    def install_direct_menu(self):
        self.direct_hooks = []
        self.direct_contexts = OrderedDict()
        try:
            Class = jclass("java.lang.Class")
            loader = jclass("org.telegram.messenger.ApplicationLoader").applicationContext.getClassLoader()
            chat = Class.forName("org.telegram.ui.ChatActivity", False, loader)
            # Album menu arguments may point at the first item. Match native Details.
            self.selected_message_field = chat.getDeclaredField("selectedObject")
            self.selected_message_field.setAccessible(True)
            fill = chat.getDeclaredMethod("fillMessageMenu", Class.forName("org.telegram.messenger.MessageObject", False, loader),
                       Class.forName("java.util.ArrayList"), Class.forName("java.util.ArrayList"), Class.forName("java.util.ArrayList"))
            click = chat.getDeclaredMethod("processSelectedOption", jclass("java.lang.Integer").TYPE)
            fill.setAccessible(True); click.setAccessible(True)
            first = self.hook_method(fill, after=self.direct_menu_fill)
            if first is None: return False
            self.direct_hooks.append(first)
            second = self.hook_method(click, before=self.direct_menu_click)
            if second is None: raise RuntimeError("Menu click hook unavailable")
            self.direct_hooks.append(second)
            return True
        except Exception as exc:
            self.direct_error = str(exc)
            self.log("SpekGram direct menu fallback: %s" % str(exc))
            self.remove_direct_menu()
            return False

    def remove_direct_menu(self):
        for hook in getattr(self, "direct_hooks", []):
            try: self.unhook_method(hook)
            except Exception: pass
        self.direct_hooks = []
        self.direct_contexts = OrderedDict()
        self.selected_message_field = None

    def selected_context_message(self, fragment, fallback):
        field = getattr(self, "selected_message_field", None)
        if field is None:
            return fallback
        try:
            selected = field.get(fragment)
            return selected if selected is not None else fallback
        except Exception as exc:
            self.log("SpekGram selected message: %s" % type(exc).__name__)
            return None  # Never silently analyze the group's first track on read failure.

    def direct_menu_fill(self, param):
        try:
            fallback, icons, labels, actions = param.args
            identity = int(param.thisObject.hashCode())
            self.direct_contexts.pop(identity, None)
            message = self.selected_context_message(param.thisObject, fallback)
            if not supported_message(message): return
            if not (icons.size() == labels.size() == actions.size()): return
            self.direct_contexts[identity] = message
            self.direct_contexts.move_to_end(identity)
            while len(self.direct_contexts) > 4: self.direct_contexts.popitem(last=False)
            Integer = jclass("java.lang.Integer")
            if actions.contains(Integer(self.DIRECT_ACTION)): return
            icon = jclass("org.telegram.messenger.R$drawable").msg_photo_curve
            icons.add(Integer(icon)); labels.add(STRINGS[language()]["menu"]); actions.add(Integer(self.DIRECT_ACTION))
        except Exception as exc:
            self.log("SpekGram direct menu: %s" % type(exc).__name__)

    def direct_menu_click(self, param):
        if int(param.args[0]) != self.DIRECT_ACTION: return
        param.setResult(None)
        fragment = param.thisObject
        cached = self.direct_contexts.pop(int(fragment.hashCode()), None)
        if cached is not None:
            message = self.selected_context_message(fragment, cached)
            if not supported_message(message): return
            fragment.closeMenu()
            self.open_analyzer({"message": message, "fragment": fragment})

    def graph_preference(self):
        try:
            return self.get_setting("show_graph", False) is True
        except Exception:
            return False

    def create_settings(self):
        from ui.settings import Header, Text
        strings = STRINGS[language()]
        return [Header(text="SpekGram"), Text(text=strings["clear_cache"], subtext=strings["cache_limit"], on_click=self.clear_cache)]

    def clear_cache(self, view=None):
        strings = STRINGS[language()]
        def clear():
            try:
                complete = clear_result_cache()
            except Exception:
                complete = False
            def notify():
                try:
                    from ui.bulletin import BulletinHelper
                    if complete:
                        BulletinHelper.show_success(strings["cache_cleared"])
                    else:
                        BulletinHelper.show_error(strings["cache_clear_failed"])
                except Exception as exc:
                    self.log("SpekGram cache notification: %s" % type(exc).__name__)
            run_on_ui_thread(notify)
        threading.Thread(target=clear, name="SpekGram-cache", daemon=True).start()

    def on_plugin_load(self):
        try:
            from extera_utils.lifecycle import capture_scope
            self._ui_scope = capture_scope()
        except Exception:
            self._ui_scope = None
        if getattr(self, "menu_id", None):
            self.remove_menu_item(self.menu_id)
            self.menu_id = None
        previous = getattr(self, "session", None)
        if previous is not None:
            previous.cancel.set()
            def cleanup_previous():
                if previous.sheet is not None:
                    previous.sheet.dismiss()
                previous.close()
            run_on_ui_thread(cleanup_previous)
        self.session = None
        self.remove_direct_menu()
        self.remove_list_icon()
        self.install_list_icon()
        self.direct_menu = self.install_direct_menu()
        if not self.direct_menu:
            self.register_menu(language())

    def register_menu(self, lang):
        if getattr(self, "menu_id", None):
            self.remove_menu_item(self.menu_id)
        self.menu_lang = lang
        self.menu_id = self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text=STRINGS[lang]["menu"], on_click=self.open_analyzer,
            item_id="spekgram_spectrogram", icon="msg_photo_curve", condition=MENU_CONDITION,
        ))

    def on_app_event(self, event_type):
        if event_type == AppEvent.RESUME:
            def refresh():
                lang = language()
                if getattr(self, "menu_id", None) and lang != self.menu_lang:
                    self.register_menu(lang)
            run_on_ui_thread(refresh)

    def open_analyzer(self, context):
        # SDK callbacks normally run on UI thread; enforce this for Java UI mutations.
        def show():
            try:
                message = context.get("message")
                if not supported_message(message):
                    self.show_error(STRINGS[language()]["unsupported"])
                    return
                if self.session is not None:
                    previous = self.session
                    if previous.sheet is not None:
                        previous.sheet.dismiss()
                    previous.close()
                self.session = AnalysisSession(self, context)
                self.session.show()
            except Exception as exc:
                self.log("SpekGram UI: %s" % exc)
                if self.session is not None:
                    previous = self.session
                    if previous.sheet is not None:
                        previous.sheet.dismiss()
                    previous.close()
                self.show_error(STRINGS[language()]["error"] + "\n" + str(exc)[:240])
        if getattr(self,"_ui_scope",None) is not None:
            from extera_utils.lifecycle import bind_task
            show = bind_task(show,scope=self._ui_scope)
        run_on_ui_thread(show)

    def show_error(self, text):
        fragment = get_last_fragment()
        if fragment and fragment.getParentActivity():
            dialog = AlertDialogBuilder(fragment.getParentActivity())
            dialog.set_title("SpekGram").set_message(text)
            dialog.set_positive_button(STRINGS[language()]["close"])
            dialog.show()

    def on_plugin_unload(self):
        self.remove_list_icon()
        self.remove_direct_menu()
        if getattr(self, "menu_id", None):
            self.remove_menu_item(self.menu_id)
            self.menu_id = None
        session = getattr(self, "session", None)
        if session:
            # Set cancellation immediately; observer removal and dismissal need UI.
            session.cancel.set()
            if session.native_cancel is not None:
                session.native_cancel.set(True)
            def cleanup():
                if session.sheet:
                    session.sheet.dismiss()
                session.close()
            run_on_ui_thread(cleanup)
