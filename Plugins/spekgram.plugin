FFT_SIZE = 2048
MAX_COLUMNS = 640
PLOT_ROWS = 256
EXTENSIONS = ("mp3", "flac", "wav", "aac", "m4a", "ogg", "opus")
# MVEL is evaluated by the client's public menu mechanism, not a Python callback.
MENU_CONDITION = (
    'message != null && message.getDocument() != null && '
    '(message.isMusic() || message.isVoice() || '
    '(message.getDocument().mime_type != null && '
    'message.getDocument().mime_type.startsWith("audio/")) || '
    'message.getDocumentName().toLowerCase().matches(".*\\\\.(mp3|flac|wav|aac|m4a|ogg|opus)$"))'
)

