    "ru": {
        "file": "Свойства файла", "assessment": "Что показал анализ", "format": "Формат",
        "rate": "Частота дискретизации", "depth": "Разрядность", "channel_label": "Каналы",
        "duration": "Длительность", "size": "Размер", "bitrate": "Битрейт",
