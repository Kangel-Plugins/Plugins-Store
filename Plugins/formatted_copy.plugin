# Native clipboard results sometimes include generic labels that the plugin
# already renders itself. Keep this lookup immutable and build it only once.
GENERIC_MEDIA_LABELS = {
    '[фотография]': frozenset((
        'фото', 'фотография', 'фотография загружена', 'изображение',
        'photo', 'picture', 'image', 'image file', 'photo file',
    )),
    '[гиф]': frozenset((
        'гиф', 'гифка', 'анимация', 'gif', 'animation', 'animated gif',
    )),
    '[видео]': frozenset((
        'видео', 'видеозапись', 'video', 'video file',
    )),
    '[аудио]': frozenset((
        'аудио', 'аудиофайл', 'музыка', 'audio', 'audio file', 'music',
    )),
    '[голосовое сообщение]': frozenset((
        'голосовое сообщение', 'аудиосообщение', 'voice message', 'audio message',
    )),
    '[видеосообщение]': frozenset((
        'видеосообщение', 'круглое видео', 'video message', 'round video message',
    )),
    '[документ]': frozenset((
        'документ', 'файл', 'document', 'file', 'file attachment',
    )),
