class PanelScaleListener(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self.value = int(plugin.get_setting("panel_scale", 97))

    def onProgressChanged(self, seek_bar, progress, from_user):
        self.value = 75 + int(progress)
        self.plugin.update_panel_scale(self.value, False)

    def onStartTrackingTouch(self, seek_bar):
        pass

    def onStopTrackingTouch(self, seek_bar):
        self.plugin.update_panel_scale(self.value, True)


class FabScaleListener(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self.value = int(plugin.get_setting("fab_scale", 90))

    def onProgressChanged(self, seek_bar, progress, from_user):
        self.value = 75 + int(progress)
        self.plugin.update_fab_scale(self.value, False)

    def onStartTrackingTouch(self, seek_bar):
        pass

    def onStopTrackingTouch(self, seek_bar):
        self.plugin.update_fab_scale(self.value, True)


class ShapeClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, plugin, shape):
        super().__init__()
        self.plugin = plugin
        self.shape = shape

    def onClick(self, view):
        self.plugin.select_fab_shape(self.shape)


class SectionsChangedListener(dynamic_proxy(Runnable)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self.editor = None

    def run(self):
        if self.editor is not None:
            self.plugin.on_sections_changed(str(self.editor.getTag()))


class ExpressiveTabPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex_loader = None
        self.bridge = None
        self.watchdog_active = False
        self.settings_preview = None
        self.settings_scale_label = None
        self.settings_fab_scale_label = None
        self.scale_listener = None
        self.fab_scale_listener = None
        self.shape_click_listeners = []
        self.sections_listener = None
        self.sections_editor = None
        self.language = "en"
        self.last_applied_language = None
        self.shape_names = SHAPE_NAMES["en"]

    def on_plugin_load(self):
        try:
            if self.bridge is None:
                self.load_bridge()
        except Exception as error:
            self.log("Expressive Tab load failed: " + str(error))
            return
        self.bridge.startHooks()
        self.apply_localization()
        self.apply_configuration(False)
        self.watchdog_active = True
        run_on_ui_thread(self.repair_current)
        run_on_ui_thread(self.repair_current, 160)
        run_on_ui_thread(self.watchdog_tick, 3000)

    def on_plugin_unload(self):
        self.watchdog_active = False
        if self.bridge is not None:
            try:
                self.bridge.uninstallAll()
            except Exception:
                pass

    def load_bridge(self):
        global DEX_BASE64
        encoded_dex = DEX_BASE64
        DEX_BASE64 = None
        dex_bytes = base64.b64decode(encoded_dex)
        encoded_dex = None
        digest = hashlib.sha256(dex_bytes).hexdigest()
        if digest != DEX_SHA256:
            raise RuntimeError("DEX checksum mismatch")
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if int(Build.VERSION.SDK_INT) >= 26:
            self.dex_loader = InMemoryDexClassLoader(ByteBuffer.wrap(dex_bytes), parent)
        else:
            dex_file = os.path.join(str(context.getCodeCacheDir().getAbsolutePath()), "flux_expressive_tab.dex")
            with open(dex_file, "wb") as output:
                output.write(dex_bytes)
            os.chmod(dex_file, 0o444)
            self.dex_loader = DexClassLoader(dex_file, str(context.getCodeCacheDir().getAbsolutePath()), None, parent)
        bridge_class = self.dex_loader.loadClass("dev.flux.expressivetab.ExpressiveTabBridge")
        self.bridge = bridge_class.newInstance()

    def apply_configuration(self, refresh=True):
        if self.bridge is None:
            return
        scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
        fab = bool(self.get_setting("show_fab", True))
        haptic = bool(self.get_setting("haptic_feedback", True))
        shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
        fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
        fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
        sections = str(self.get_setting("sections", "chats,settings,profile|feed"))
        self.bridge.configureSections(sections)
        self.bridge.configure(scale, fab, shape, haptic, fab_scale, fab_action)
        if refresh:
            self.repair_current()

    def apply_localization(self):
        mode = max(0, min(2, int(self.get_setting("language_mode", 0))))
        language = "en"
        if mode == 1:
            language = "ru"
        elif mode == 0:
            try:
                current = str(LocaleController.getInstance().getCurrentLocale().getLanguage()).lower()
                language = "ru" if current.startswith("ru") else "en"
            except Exception:
                language = "en"
        self.language = language
        self.shape_names = SHAPE_NAMES[language]
        if self.bridge is None or self.last_applied_language == language:
            return
        self.last_applied_language = language
        self.bridge.configureLabels(
            self.tr("chats"),
            self.tr("settings"),
            self.tr("profile"),
            self.tr("feed"),
            self.tr("add"),
            self.tr("remove"),
        )

    def tr(self, key):
        return STRINGS[self.language][key]

    def on_language_change(self, value):
        self.set_setting("language_mode", max(0, min(2, int(value))), reload_settings=True)
        self.apply_localization()
        self.apply_configuration(False)

    def on_fab_action_change(self, value):
        self.set_setting("fab_action", max(0, min(2, int(value))), reload_settings=False)
        self.apply_configuration(False)
        if self.settings_preview is not None and self.bridge is not None:
            scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
            fab = bool(self.get_setting("show_fab", True))
            shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
            fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
            self.bridge.updatePreview(self.settings_preview, scale, fab, shape, fab_scale, max(0, min(2, int(value))))

    def update_panel_scale(self, scale, persist=True):
        value = max(75, min(125, int(scale)))
        if persist:
            self.set_setting("panel_scale", value, reload_settings=False)
        if self.settings_scale_label is not None:
            self.settings_scale_label.setText(str(value) + "%")
        if self.bridge is not None:
            fab = bool(self.get_setting("show_fab", True))
            haptic = bool(self.get_setting("haptic_feedback", True))
            shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
            fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
            fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
            self.bridge.configure(value, fab, shape, haptic, fab_scale, fab_action)
            if self.settings_preview is not None:
                self.bridge.updatePreview(self.settings_preview, value, fab, shape, fab_scale, fab_action)

    def on_fab_change(self, value):
        enabled = bool(value)
        self.set_setting("show_fab", enabled, reload_settings=False)
        scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
        haptic = bool(self.get_setting("haptic_feedback", True))
        shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
        fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
        fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
        if self.bridge is not None:
            self.bridge.configure(scale, enabled, shape, haptic, fab_scale, fab_action)
            if self.settings_preview is not None:
                self.bridge.updatePreview(self.settings_preview, scale, enabled, shape, fab_scale, fab_action)
        self.repair_current()

    def select_fab_shape(self, shape):
        value = max(0, min(34, int(shape)))
        self.set_setting("fab_shape", value, reload_settings=True)
        self.apply_configuration(False)
        if self.settings_preview is not None and self.bridge is not None:
            scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
            fab = bool(self.get_setting("show_fab", True))
            fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
            fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
            self.bridge.updatePreview(self.settings_preview, scale, fab, value, fab_scale, fab_action)

    def create_shape_settings(self) -> List[Any]:
        self.apply_localization()
        selected = max(0, min(34, int(self.get_setting("fab_shape", 0))))
        self.shape_click_listeners = []
        items = [Header(text="Material 3 Expressive · " + self.tr("shapes"))]
        for index, name in enumerate(self.shape_names):
            items.append(Custom(view=self.create_shape_row(index, name, index == selected)))
        return items

    def create_shape_row(self, index, name, selected):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        row = LinearLayout(context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        padding = AndroidUtilities.dp(14)
        row.setPadding(padding, AndroidUtilities.dp(8), padding, AndroidUtilities.dp(8))
        background = GradientDrawable()
        background.setCornerRadius(float(AndroidUtilities.dp(20)))
        background.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
        background.setStroke(AndroidUtilities.dp(2 if selected else 1), Theme.getColor(Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_divider))
        row.setBackground(background)
        preview = self.bridge.createShapePreview(context, index, selected)
        preview_params = LinearLayout.LayoutParams(AndroidUtilities.dp(48), AndroidUtilities.dp(48))
        preview_params.setMargins(0, 0, AndroidUtilities.dp(14), 0)
        row.addView(preview, preview_params)
        text_column = LinearLayout(context)
        text_column.setOrientation(LinearLayout.VERTICAL)
        title = TextView(context)
        title.setText(name)
        title.setTextSize(16)
        title.setTypeface(Typeface.DEFAULT_BOLD if selected else Typeface.DEFAULT)
        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        text_column.addView(title, LinearLayout.LayoutParams(-1, -2))
        subtitle = TextView(context)
        subtitle.setText("✓ Material 3 Expressive" if selected else "Material 3 Expressive")
        subtitle.setTextSize(13)
        subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText if selected else Theme.key_windowBackgroundWhiteGrayText2))
        text_column.addView(subtitle, LinearLayout.LayoutParams(-1, -2))
        row.addView(text_column, LinearLayout.LayoutParams(0, -2, 1.0))
        listener = ShapeClickListener(self, index)
        self.shape_click_listeners.append(listener)
        row.setOnClickListener(listener)
        row.setClickable(True)
        return row

    def create_preview_settings_view(self):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
        fab = bool(self.get_setting("show_fab", True))
        shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
        fab_scale = max(75, min(125, int(self.get_setting("fab_scale", 90))))
        fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        padding = AndroidUtilities.dp(18)
        root.setPadding(padding, padding, padding, padding)
        background = GradientDrawable()
        background.setCornerRadius(float(AndroidUtilities.dp(30)))
        background.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
        background.setStroke(AndroidUtilities.dp(1), Theme.getColor(Theme.key_divider))
        root.setBackground(background)
        title = TextView(context)
        title.setText(self.tr("preview"))
        title.setTextSize(13)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        root.addView(title, LinearLayout.LayoutParams(-1, -2))
        self.settings_preview = self.bridge.createPreview(context, scale, fab, shape, fab_scale, fab_action)
        preview_params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(128))
        preview_params.setMargins(0, AndroidUtilities.dp(4), 0, AndroidUtilities.dp(8))
        root.addView(self.settings_preview, preview_params)
        row = LinearLayout(context)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        label = TextView(context)
        label.setText(self.tr("panel_size"))
        label.setTextSize(16)
        label.setTypeface(Typeface.DEFAULT_BOLD)
        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        row.addView(label, LinearLayout.LayoutParams(0, -2, 1.0))
        self.settings_scale_label = TextView(context)
        self.settings_scale_label.setText(str(scale) + "%")
        self.settings_scale_label.setTextSize(14)
        self.settings_scale_label.setTypeface(Typeface.DEFAULT_BOLD)
        self.settings_scale_label.setGravity(Gravity.CENTER)
        self.settings_scale_label.setTextColor(Color.WHITE)
        value_background = GradientDrawable()
        value_background.setCornerRadius(float(AndroidUtilities.dp(18)))
        value_background.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        self.settings_scale_label.setBackground(value_background)
        value_params = LinearLayout.LayoutParams(AndroidUtilities.dp(64), AndroidUtilities.dp(36))
        row.addView(self.settings_scale_label, value_params)
        root.addView(row, LinearLayout.LayoutParams(-1, -2))
        slider = SeekBar(context)
        slider.setMax(50)
        slider.setProgress(scale - 75)
        slider.setSplitTrack(False)
        accent = ColorStateList.valueOf(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        inactive = ColorStateList.valueOf(Theme.getColor(Theme.key_switchTrack))
        slider.setProgressTintList(accent)
        slider.setThumbTintList(accent)
        slider.setProgressBackgroundTintList(inactive)
        self.scale_listener = PanelScaleListener(self)
        slider.setOnSeekBarChangeListener(self.scale_listener)
        slider_params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48))
        slider_params.setMargins(0, AndroidUtilities.dp(6), 0, 0)
        root.addView(slider, slider_params)
        fab_row = LinearLayout(context)
        fab_row.setOrientation(LinearLayout.HORIZONTAL)
        fab_row.setGravity(Gravity.CENTER_VERTICAL)
        fab_label = TextView(context)
        fab_label.setText(self.tr("fab_size"))
        fab_label.setTextSize(16)
        fab_label.setTypeface(Typeface.DEFAULT_BOLD)
        fab_label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        fab_row.addView(fab_label, LinearLayout.LayoutParams(0, -2, 1.0))
        self.settings_fab_scale_label = TextView(context)
        self.settings_fab_scale_label.setText(str(fab_scale) + "%")
        self.settings_fab_scale_label.setTextSize(14)
        self.settings_fab_scale_label.setTypeface(Typeface.DEFAULT_BOLD)
        self.settings_fab_scale_label.setGravity(Gravity.CENTER)
        self.settings_fab_scale_label.setTextColor(Color.WHITE)
        fab_value_background = GradientDrawable()
        fab_value_background.setCornerRadius(float(AndroidUtilities.dp(18)))
        fab_value_background.setColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        self.settings_fab_scale_label.setBackground(fab_value_background)
        fab_row.addView(self.settings_fab_scale_label, LinearLayout.LayoutParams(AndroidUtilities.dp(64), AndroidUtilities.dp(36)))
        root.addView(fab_row, LinearLayout.LayoutParams(-1, -2))
        fab_slider = SeekBar(context)
        fab_slider.setMax(50)
        fab_slider.setProgress(fab_scale - 75)
        fab_slider.setSplitTrack(False)
        fab_slider.setProgressTintList(accent)
        fab_slider.setThumbTintList(accent)
        fab_slider.setProgressBackgroundTintList(inactive)
        self.fab_scale_listener = FabScaleListener(self)
        fab_slider.setOnSeekBarChangeListener(self.fab_scale_listener)
        fab_slider_params = LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48))
        fab_slider_params.setMargins(0, AndroidUtilities.dp(6), 0, 0)
        root.addView(fab_slider, fab_slider_params)
        return root

    def open_author_channel(self, view):
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        Browser.openUrl(context, "https://t.me/Plus_Plugins")

    def create_sections_settings_view(self):
        self.apply_localization()
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment else ApplicationLoader.applicationContext
        sections = str(self.get_setting("sections", "chats,settings,profile|feed"))
        self.sections_listener = SectionsChangedListener(self)
        self.sections_editor = self.bridge.createSectionsEditor(
            context,
            sections,
            self.sections_listener,
            Theme.getColor(Theme.key_windowBackgroundWhite),
            Theme.getColor(Theme.key_windowBackgroundWhiteBlackText),
            Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2),
            Theme.getColor(Theme.key_windowBackgroundWhiteBlueText),
            Theme.getColor(Theme.key_divider),
        )
        self.sections_listener.editor = self.sections_editor
        return self.sections_editor

    def on_sections_changed(self, configuration):
        value = str(configuration)
        self.set_setting("sections", value, reload_settings=False)
        if self.bridge is not None:
            self.bridge.configureSections(value)
            if self.settings_preview is not None:
                self.bridge.updatePreviewSections(self.settings_preview, value)
        self.repair_current()

    def on_haptic_change(self, value):
        self.set_setting("haptic_feedback", bool(value), reload_settings=False)
        self.apply_configuration(False)

    def update_fab_scale(self, scale, persist=True):
        value = max(75, min(125, int(scale)))
        if persist:
            self.set_setting("fab_scale", value, reload_settings=False)
        if self.settings_fab_scale_label is not None:
            self.settings_fab_scale_label.setText(str(value) + "%")
        if self.bridge is not None:
            panel_scale = max(75, min(125, int(self.get_setting("panel_scale", 97))))
            fab = bool(self.get_setting("show_fab", True))
            haptic = bool(self.get_setting("haptic_feedback", True))
            shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
            fab_action = max(0, min(2, int(self.get_setting("fab_action", 0))))
            self.bridge.configure(panel_scale, fab, shape, haptic, value, fab_action)
            if self.settings_preview is not None:
                self.bridge.updatePreview(self.settings_preview, panel_scale, fab, shape, value, fab_action)

    def create_settings(self) -> List[Any]:
        self.apply_localization()
        items = []
        selected_shape = max(0, min(34, int(self.get_setting("fab_shape", 0))))
        try:
            items.append(Custom(view=self.create_preview_settings_view()))
        except Exception as error:
            self.log("Expressive Tab preview failed: " + str(error))
            items.append(Text(text="Expressive Tab", subtext="Material 3 Expressive", accent=True))
        items.extend([
            Selector(
                key="language_mode",
                text=self.tr("language"),
                default=0,
                items=[self.tr("auto"), self.tr("russian"), self.tr("english")],
                icon="msg_language",
                on_change=self.on_language_change,
            ),
            Header(text=self.tr("sections")),
            Custom(view=self.create_sections_settings_view()),
            Header(text=self.tr("panel_elements")),
            Switch(
                key="show_fab",
                text=self.tr("show_fab"),
                default=True,
                subtext=self.tr("show_fab_info"),
                icon="filled_fab_compose_32",
                on_change=self.on_fab_change,
            ),
            Switch(
                key="haptic_feedback",
                text=self.tr("haptic"),
                default=True,
                subtext=self.tr("haptic_info"),
                icon="msg_notifications",
                on_change=self.on_haptic_change,
            ),
            Text(
                text=self.tr("fab_shape"),
                subtext=self.shape_names[selected_shape],
                icon="msg_customize",
                create_sub_fragment=self.create_shape_settings,
            ),
            Selector(
                key="fab_action",
                text=self.tr("fab_action"),
                default=0,
                items=[self.tr("new_chat"), self.tr("plugins"), self.tr("proxy_settings")],
                icon="filled_fab_compose_32",
                on_change=self.on_fab_action_change,
            ),
            Text(
                text="@Plus_Plugins",
                subtext=self.tr("open_channel"),
                icon="msg_channel",
                accent=True,
                on_click=self.open_author_channel,
            ),
        ])
        return items

    def repair_current(self):
        if self.bridge is None:
            return
        try:
            self.bridge.repairCurrent()
        except Exception as error:
            self.log("Expressive Tab recovery failed: " + str(error))

    def watchdog_tick(self):
        if not self.watchdog_active or self.bridge is None:
            return
        self.apply_localization()
        self.repair_current()
