__id__ = "GWS"
__name__ = "GIF with Sound"
__description__ = "Отправляет видео гифкой со звуком"
__author__ = "@la_cringe | @dmkrjplug"
__version__ = "1.0"
__icon__ = "ZkrXOVX_by_sticbot/105"
__app_version__ = ">=12.10.6"
__category__ = ["media", "tools", "fun"]
__sdk_version__ = ">=1.4.5.3"

import os
import time
import base64
import zlib

from base_plugin import BasePlugin
from hook_utils import find_class, get_private_field
from ui.settings import Switch
from org.telegram.tgnet import TLRPC

from android.os import Build
from dalvik.system import InMemoryDexClassLoader
from java import jarray, jbyte
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader

MARK_BEGIN = "# " + "__DEX_BEGIN__"
MARK_END = "# " + "__DEX_END__"


class Dex:
    ENTRY = "com.dmkrj.gws.Gws"

    def __init__(self):
        self.loader = None
        self.entry = None

    @staticmethod
    def _read_payload():
        with open(__file__, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
        chunks = []
        inside = False
        for line in lines:
            s = line.strip()
            if s == MARK_BEGIN:
                inside = True
            elif s == MARK_END:
                break
            elif inside and s.startswith("#"):
                chunks.append(s[1:].strip())
        return zlib.decompress(base64.b64decode("".join(chunks)))

    @staticmethod
    def _buffer(data):
        try:
            return ByteBuffer.wrap(data)
        except Exception:
            signed = [b - 256 if b > 127 else b for b in data]
            return ByteBuffer.wrap(jarray(jbyte)(signed))

    def _method(self, name, argc):
        found = []
        for m in self.entry.getDeclaredMethods():
            if m.getName() == name and len(m.getParameterTypes()) == argc:
                found.append(m)
        if len(found) != 1:
            raise RuntimeError("%s.%s/%d: found %d" % (self.ENTRY, name, argc, len(found)))
        found[0].setAccessible(True)
        return found[0]

    def load(self, plugin_id):
        if Build.VERSION.SDK_INT < 26:
            raise RuntimeError("DEX requires Android 8.0+")
        context = ApplicationLoader.applicationContext
        buffer = self._buffer(self._read_payload())
        self.loader = InMemoryDexClassLoader(buffer, context.getClassLoader())
        self.entry = self.loader.loadClass(self.ENTRY)
        self._method("load", 1).invoke(None, plugin_id)

    def unload(self, plugin_id):
        if self.entry is None:
            return
        try:
            self._method("unload", 1).invoke(None, plugin_id)
        finally:
            self.entry = None
            self.loader = None


class GifWithSound(BasePlugin):
    dex = None

    def on_plugin_load(self):
        self.dex = Dex()
        try:
            self.dex.load(__id__)
        except Exception:
            self.logger.exception("dex load failed")

    def on_plugin_unload(self):
        if self.dex is None:
            return
        try:
            self.dex.unload(__id__)
        except Exception:
            self.logger.exception("dex unload failed")
        self.dex = None

    def create_settings(self):
        return [
            Switch(
                key="send_as_gif",
                text="Auto",
                subtext="Пассивный аналог Toggle",
                icon="msg_voice_headphones",
                default=False,
            ),
            Switch(
                key="show_button",
                text="Toggle",
                subtext="Кнопка в редакторе видео",
                icon="msg_edit",
                default=True,
            ),
            Switch(
                key="gif_meta",
                text="Old Meta",
                subtext="image/gif вместо video/mp4",
                icon="msg_download",
                default=False,
            ),
        ]


