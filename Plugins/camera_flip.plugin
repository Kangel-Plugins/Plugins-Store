__id__ = "camera_flip"
__name__ = "Camera Flip"
__description__ = "Переключение камеры в видеосообщении (кружке) свайпом или двойным тапом"
__author__ = "@its240hz"
__version__ = "0.2.0"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.3.3"

import time
from base_plugin import BasePlugin, MethodHook
from ui.settings import Header, Selector, Switch
from android_utils import run_on_ui_thread
from org.telegram.messenger import ApplicationLoader

VIEW_CLASS = "org.telegram.ui.Components.InstantCameraView"
# Какие из этих методов объявлены в классе, те и перехватываем
TOUCH_METHODS = ("onInterceptTouchEvent", "onTouchEvent", "dispatchTouchEvent")

SWIPE_DP = 60        # минимальная длина свайпа
TAP_SLOP_DP = 12     # допустимый сдвиг пальца для тапа
TAP_MAX_MS = 250     # максимальная длительность тапа
DOUBLE_TAP_MS = 350  # окно между двумя тапами
COOLDOWN_SEC = 0.8   # защита от повторных срабатываний

ACTION_DOWN = 0
ACTION_UP = 1
ACTION_MOVE = 2
ACTION_CANCEL = 3

# trigger: 0 = свайп вверх/вниз, 1 = только вверх, 2 = только вниз, 3 = двойной тап


class TouchHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.handle_touch(param.thisObject, param.args[0])
        except Exception as e:
            self.plugin.log(f"touch error: {e}")


class CameraFlipPlugin(BasePlugin):
    def on_plugin_load(self):
        self._last_key = None
        self._last_flip = 0.0
        self._x0 = None
        self._y0 = None
        self._t0 = 0
        self._fired = False
        self._last_tap = 0
        try:
            loader = ApplicationLoader.applicationContext.getClassLoader()
            cls = loader.loadClass(VIEW_CLASS)
            hook = TouchHook(self)
            hooked = []
            for m in cls.getDeclaredMethods():
                if m.getName() in TOUCH_METHODS and len(m.getParameterTypes()) == 1:
                    self.hook_method(m, hook)
                    hooked.append(m.getName())
            if hooked:
                self.log("hooked: " + ", ".join(hooked))
            else:
                self.log("no touch methods found in " + VIEW_CLASS)
        except Exception as e:
            self.log(f"load failed: {e}")

    def handle_touch(self, view, ev):
        action = ev.getActionMasked()
        # одно и то же событие может пройти через несколько перехваченных методов
        key = (ev.getEventTime(), action)
        if key == self._last_key:
            return
        self._last_key = key

        if action == ACTION_CANCEL or ev.getPointerCount() > 1:
            self._x0 = None  # мультитач (щипок-зум) игнорируем
            return

        mode = int(self.get_setting("trigger", 0))
        density = view.getResources().getDisplayMetrics().density

        if action == ACTION_DOWN:
            self._x0 = ev.getX()
            self._y0 = ev.getY()
            self._t0 = ev.getEventTime()
            self._fired = False
            return

        if self._x0 is None:
            return

        dx = ev.getX() - self._x0
        dy = ev.getY() - self._y0

        if action == ACTION_MOVE:
            if mode == 3 or self._fired:
                return
            if abs(dy) > SWIPE_DP * density and abs(dy) > 1.5 * abs(dx):
                if mode == 0 or (mode == 1 and dy < 0) or (mode == 2 and dy > 0):
                    self._fired = True
                    self.flip(view)
        elif action == ACTION_UP:
            if mode == 3:
                t = ev.getEventTime()
                is_tap = (
                    abs(dx) < TAP_SLOP_DP * density
                    and abs(dy) < TAP_SLOP_DP * density
                    and t - self._t0 < TAP_MAX_MS
                )
                if is_tap:
                    if t - self._last_tap < DOUBLE_TAP_MS:
                        self._last_tap = 0
                        self.flip(view)
                    else:
                        self._last_tap = t
            self._x0 = None

    def flip(self, view):
        now = time.time()
        if now - self._last_flip < COOLDOWN_SEC:
            return
        self._last_flip = now
        haptic = bool(self.get_setting("haptic", True))

        def _do():
            try:
                cls = view.getClass()
                btn = None
                while cls is not None and btn is None:
                    try:
                        f = cls.getDeclaredField("switchCameraButton")
                        f.setAccessible(True)
                        btn = f.get(view)
                    except Exception:
                        cls = cls.getSuperclass()
                if btn is not None:
                    # полный путь как при нажатии на кнопку: проверки готовности + анимация переворота
                    btn.performClick()
                else:
                    m = view.getClass().getDeclaredMethod("switchCamera")
                    m.setAccessible(True)
                    m.invoke(view)
                if haptic:
                    view.performHapticFeedback(3)
            except Exception as e:
                self.log(f"flip failed: {e}")

        run_on_ui_thread(_do)

    def create_settings(self):
        return [
            Header(text="Жест"),
            Selector(
                key="trigger",
                text="Как переключать камеру",
                default=int(self.get_setting("trigger", 0)),
                items=[
                    "Свайп вверх или вниз",
                    "Свайп вверх",
                    "Свайп вниз",
                    "Двойной тап",
                ],
                icon="msg_retry",
                on_change=lambda val: self.set_setting("trigger", int(val)),
            ),
            Switch(
                key="haptic",
                text="Вибрация",
                subtext="Короткий отклик при переключении",
                default=bool(self.get_setting("haptic", True)),
                on_change=lambda val: self.set_setting("haptic", bool(val)),
            ),
        ]
