__id__ = "hide_proxy_sponsor"
__name__ = "Hide Proxy Sponsor"
__description__ = """Скрывает спонсора прокси в начале списка чатов.

Hides MTProto proxy sponsor channel at the top of the chat list."""
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__icon__ = "RnDev/22"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback

from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from android_utils import run_on_ui_thread

DEX_B64 = """"""

class HideProxySponsorPlugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_class = None
        self.dex_loader = None
        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.hideproxysponsor.HideProxySponsor")
            for method in self.dex_class.getMethods():
                if method.getName() == "start":
                    method.invoke(None)
                    break
            run_on_ui_thread(self._deferred_cleanup, delay=150)
            run_on_ui_thread(self._deferred_cleanup, delay=500)
        except Exception as e:
            self.log("Load error: %s\n%s" % (e, traceback.format_exc()))

    def _deferred_cleanup(self):
        if self.dex_class is not None:
            try:
                for method in self.dex_class.getMethods():
                    if method.getName() == "cleanup":
                        method.invoke(None)
                        break
            except Exception:
                pass

    def on_plugin_unload(self):
        try:
            if self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "stop":
                        method.invoke(None)
                        break
        except Exception as e:
            self.log("Unload error: %s" % e)
        finally:
            self.dex_class = None
            self.dex_loader = None
