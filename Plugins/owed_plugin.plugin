}
EXPORT_PREFIX = "OWED1:"
MAX_IMPORT_LENGTH = 20000


def make_seek_listener(callback):
    """Слушатель ползунка SeekBar. Возвращает None, если динамические прокси недоступны."""
    try:
        from java import dynamic_proxy, jclass
        interface = jclass("android.widget.SeekBar$OnSeekBarChangeListener")

        class Listener(dynamic_proxy(interface)):
            def onProgressChanged(self, seek_bar, progress, from_user):
                if from_user:
                    callback(int(progress))

            def onStartTrackingTouch(self, seek_bar):
                pass

            def onStopTrackingTouch(self, seek_bar):
                pass

        return Listener()
    except Exception:
        return None


