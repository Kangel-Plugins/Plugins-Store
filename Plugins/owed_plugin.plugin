def lerp(a, b, t):
    return int(a + (b - a) * t)


def parse_hex(text, fallback):
    """'#RRGGBB' или 'RGB' -> (r, g, b); при ошибке возвращает fallback."""
    try:
        t = str(text).strip().lstrip("#")
        if len(t) == 3:
            t = "".join(ch * 2 for ch in t)
        if len(t) != 6:
            return fallback
        return int(t[0:2], 16), int(t[2:4], 16), int(t[4:6], 16)
    except ValueError:
        return fallback


def deepen(rgb):
    """Тёмный оттенок цвета: им кольцо становится, когда человек ждёт совсем давно."""
    r, g, b = rgb
    return int(r * 0.55), int(g * 0.38), int(b * 0.62)


def build_stops(start, mid, end, colors, long_end=None, deep=None):
    """Точки (минуты, цвет); минуты всегда идут по возрастанию.

    Дальше красного идут необязательные этапы «очень давно»: тёмно-красный (deep) и почти
    чёрно-бордовый (long_end). Благодаря им кольцо различает 2, 3, 5 дней, неделю, две недели и месяц.
    """
    start = max(start, 0.0)
    mid = max(mid, start + 1.0)
    end = max(end, mid + 1.0)
    stops = [(start, colors[0]), (mid, colors[1]), (end, colors[2])]
    if long_end is not None:
        long_end = max(long_end, end + 1.0)
        dark = deepen(colors[2])
        if deep is not None and end + 1.0 <= deep <= long_end - 1.0:
            stops += [(deep, dark), (long_end, deepen(dark))]
        else:
            stops.append((long_end, dark))
    return stops


def debt_color(minutes, stops):
    """(r, g, b) для данного числа минут: плавный переход между точками."""
    if minutes <= stops[0][0]:
        return stops[0][1]
    if minutes >= stops[-1][0]:
        return stops[-1][1]
    for i in range(len(stops) - 1):
        (m1, c1), (m2, c2) = stops[i], stops[i + 1]
        if m1 <= minutes < m2:
            if i >= 2 and m1 > 0:
                # отрезки дальше красного идут по логарифму: на них дни и недели различимы
                t = math.log(minutes / m1) / math.log(m2 / m1)
            else:
                t = (minutes - m1) / float(m2 - m1)
            return lerp(c1[0], c2[0], t), lerp(c1[1], c2[1], t), lerp(c1[2], c2[2], t)
    return stops[-1][1]


def to_argb_int(a, r, g, b):
    """Подписанный 32-битный ARGB для Paint.setColor(int)."""
    value = (a << 24) | (r << 16) | (g << 8) | b
    if value >= 0x80000000:
        value -= 0x100000000
    return value


def dp(value):
    try:
        return int(AndroidUtilities.dp(float(value)))
    except Exception:
        return int(round(float(value) * 3))


def ring_progress(minutes, stops):
    """Доля пути по шкале от 0 до 1. Каждый этап шкалы занимает равную долю,
    внутри этапа время идёт по логарифму: минуты, часы, дни и недели хорошо различимы."""
    if minutes <= stops[0][0]:
        return 0.0
    if minutes >= stops[-1][0]:
        return 1.0
    stages = len(stops) - 1
    for i in range(stages):
        m1, m2 = stops[i][0], stops[i + 1][0]
        if m1 <= minutes < m2:
            if m1 >= 1:
                t = math.log(minutes / m1) / math.log(m2 / m1)
            else:
                t = (minutes - m1) / float(m2 - m1)
            return (i + t) / stages
    return 1.0


def arc_fraction(minutes, stops):
    """Доля круга, которую занимает дуга: от 10% в начале до полного круга на последнем этапе."""
    return ring_progress(minutes, stops) * 0.9 + 0.1


def format_wait(minutes):
    """Короткая подпись времени ожидания: 15м, 3ч, 2д, 2н (недели), 1мес, 1г."""
    m = int(minutes)
    if m < 1:
        return "1м"
    if m < 60:
        return "%dм" % m
    hours = m // 60
    if hours < 24:
        return "%dч" % hours
    days = hours // 24
    if days < 7:
        return "%dд" % days
    if days < 30:
        return "%dн" % (days // 7)
    if days < 365:
        return "%dмес" % (days // 30)
    return "%dг" % (days // 365)


def text_color_for(rgb):
    """Тёмный текст на светлом фоне значка и белый на тёмном."""
    r, g, b = rgb
    luminance = 0.299 * r + 0.587 * g + 0.114 * b
    return (34, 34, 34) if luminance > 160 else (255, 255, 255)


def tomorrow_morning(now_ts, hour=9):
    """Unix-время завтрашнего утра (по умолчанию 9:00) по локальному времени."""
    t = time.localtime(now_ts)
    return time.mktime((t.tm_year, t.tm_mon, t.tm_mday + 1, hour, 0, 0, 0, 0, -1))


def next_morning(now_ts, hour=9):
    """Ближайшие 9:00: сегодня, если ещё не наступили, иначе завтра."""
    t = time.localtime(now_ts)
    today = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, hour, 0, 0, 0, 0, -1))
    return today if today > now_ts else tomorrow_morning(now_ts, hour)


