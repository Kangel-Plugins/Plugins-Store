def slider_progress(value, minimum, step, count):
    """Положение ползунка для значения: с округлением до шага и ограничением диапазоном."""
    return min(max(int(round((value - minimum) / step)), 0), count)


def slider_value(progress, minimum, step):
    return minimum + progress * step


def sanitize_setting(spec, value):
    """Проверяет значение из буфера обмена. Возвращает значение в том виде, как его хранят настройки,
    или None, если оно не подходит."""
    kind = spec[0]
    if kind == "bool":
        return value if isinstance(value, bool) else None
    if kind == "int":
        if isinstance(value, bool) or not isinstance(value, int):
            return None
        return value if spec[2] <= value <= spec[3] else None
    if kind == "num":
        if isinstance(value, bool):
            return None
        try:
            number = float(str(value).replace(",", "."))
        except ValueError:
            return None
        if math.isnan(number) or math.isinf(number) or not (spec[2] <= number <= spec[3]):
            return None
        return "%g" % number
    if kind == "hex":
        rgb = parse_hex(str(value), None)
        return None if rgb is None else "#%02X%02X%02X" % rgb
    if kind == "clock":
        text = str(value).strip()
        return text if parse_clock(text, None) is not None else None
    if kind == "text":
        text = str(value)
        return text if len(text) <= spec[2] else None
    return None


def build_export(read):
    """Строка с настройками для копирования. read(ключ, по умолчанию) отдаёт текущее значение."""
    data = {}
    for key, spec in SHARED_SETTINGS.items():
        default = spec[1]
        clean = sanitize_setting(spec, read(key, default))
        data[key] = default if clean is None else clean
    return EXPORT_PREFIX + json.dumps(data, ensure_ascii=False, separators=(",", ":"))


def parse_import(text):
    """Разбирает строку из буфера. Возвращает (настройки, пропущено, ошибка)."""
    text = (text or "").strip()
    if not text.startswith(EXPORT_PREFIX):
        return {}, 0, "В буфере обмена нет настроек owed"
    if len(text) > MAX_IMPORT_LENGTH:
        return {}, 0, "Слишком длинный текст в буфере"
    try:
        raw = json.loads(text[len(EXPORT_PREFIX):])
    except ValueError:
        return {}, 0, "Настройки повреждены: не получилось прочитать"
    if not isinstance(raw, dict):
        return {}, 0, "Настройки повреждены: неверный формат"
    accepted, skipped = {}, 0
    for key, value in raw.items():
        spec = SHARED_SETTINGS.get(key)
        clean = None if spec is None else sanitize_setting(spec, value)
        if clean is None:
            skipped += 1
        else:
            accepted[key] = clean
    if not accepted:
        return {}, skipped, "В буфере нет подходящих настроек"
    return accepted, skipped, None


def parse_clock(text, default):
    """'23:30', '23.30' или '23' -> минуты от полуночи. Некорректный ввод -> default."""
    try:
        parts = str(text).strip().replace(".", ":").split(":")
        hours = int(parts[0])
        minutes = int(parts[1]) if len(parts) > 1 and parts[1] else 0
    except (ValueError, IndexError):
        return default
    if not (0 <= hours <= 24 and 0 <= minutes < 60):
        return default
    return (hours % 24) * 60 + minutes


def quiet_overlap_minutes(start_ts, end_ts, from_min, to_min):
    """Сколько минут между start_ts и end_ts приходится на тихие часы (каждый день с from_min до to_min)."""
    if end_ts <= start_ts or from_min == to_min:
        return 0.0
    first = time.localtime(start_ts)
    length = ((to_min - from_min) % 1440) * 60   # окно может переходить через полночь
    total = 0.0
    for day in range(0, 400):
        midnight = time.mktime((first.tm_year, first.tm_mon, first.tm_mday - 1 + day, 0, 0, 0, 0, 0, -1))
        window_start = midnight + from_min * 60
        if window_start >= end_ts:
            break
        overlap = min(window_start + length, end_ts) - max(window_start, start_ts)
        if overlap > 0:
            total += overlap
    return total / 60.0


def step_value(value, delta, low, high):
    """Сдвигает значение на delta и держит его в границах."""
    return min(max(round(value + delta, 2), low), high)


def next_index(index, count):
    """Следующий по кругу индекс: 0, 1, ..., count-1, снова 0."""
    return (int(index) + 1) % count


def dkey(account, dialog_id):
    return "%d:%d" % (account, dialog_id)


def parse_words(text) -> List[str]:
    """'срочно, помоги; asap' -> ['срочно', 'помоги', 'asap']."""
    parts = str(text).replace(";", ",").replace("\n", ",").split(",")
    return [p.strip().lower() for p in parts if p.strip()]


def message_factor(text, kind, urgent_words, calm_words, urgent_factor, calm_factor) -> float:
    """Множитель срочности для одного входящего сообщения.

    1.0 = обычное. Вопрос и слова срочности ускоряют кольцо, стикеры, эмодзи и «лол» замедляют.
    """
    if kind == "sticker":
        return calm_factor
    t = (text or "").strip().lower()
    if t:
        if not any(ch.isalnum() for ch in t):   # только эмодзи и знаки
            return calm_factor
        if len(t) <= 12 and any(t.startswith(w) for w in calm_words):
            return calm_factor
    score = 0
    if "?" in t:
        score += 1
    if any(w in t for w in urgent_words):
        score += 1
    if score == 0:
        return 1.0
    factor = urgent_factor if score == 1 else urgent_factor * 1.5
    return min(factor, MAX_FACTOR)


def accumulate_factor(previous: float, new_factor: float) -> float:
    """Следующее сообщение подряд без ответа: берём большее значение и добавляем шаг."""
    return round(min(MAX_FACTOR, max(previous, new_factor) + BURST_STEP), 2)


class DialogCellDrawHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.draw_ring(param.thisObject, param.args[0])
        except Exception:
            self.plugin.logger.exception("draw_ring failed")


class OwedPlugin(BasePlugin):

    def on_plugin_load(self):
        self.debts = self._load(KEY_DEBTS)
        self.urgency = self._load(KEY_URGENCY)
        self.snooze = self._load(KEY_SNOOZE)
        self.vip = self._load(KEY_VIP)
        self.ignored = self._load(KEY_IGNORED)
        self.dismissed = self._load(KEY_DISMISSED)
        self.cleared = self._load(KEY_CLEARED)
        self._no_date = 0       # чатов с непрочитанным, у которых не нашлась дата сообщения
        self._repaired = 0      # исправленных неверных времён
        self._draft = None   # черновик окна «Предпросмотр и настройка», только на время рисования
        self._dash_cache = {}
        self._paint = None
        self._text_paint = None
        self._fill_paint = None
        self._oval = None
        self._badge_rect = None
        self._foreground = True     # приложение на экране?
        self._sound_cache = {}      # key -> (время проверки, звук включён)
        self._draw_calls = 0        # для диагностики
        self._rings_drawn = 0
        self._skips = {}            # причина -> сколько раз кольцо не нарисовано
        self._seen = []             # какие чаты видела отрисовка (до 8)
        self._last_error = "нет"
        self._cfg = None            # (время, настройки) — кэш на 2 секунды
        self._last_reason = "ничего ещё не происходило"
        self._hook_info = "перехват не запускался"

        # входящие сообщения (update) и твои исходящие
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_messages_sendReaction")   # реакция тоже считается ответом
        self.add_on_send_message_hook()

        # перехват отрисовки ячейки списка чатов
        self._install_draw_hook()

        # пункт «Ответ: действия» в меню чата (если не получится, кольцо всё равно работает)
        self._register_menu()

        # один раз после загрузки подхватить уже непрочитанные чаты
        run_on_ui_thread(self._startup, 3000)

    def _install_draw_hook(self):
        cell_cls = find_class("org.telegram.ui.Cells.DialogCell")
        if not cell_cls:
            self._hook_info = "класс DialogCell не найден"
            self.logger.error(self._hook_info)
            return

        errors = []
        # пробуем по очереди: onDraw, затем dispatchDraw, затем draw
        for name in ("onDraw", "dispatchDraw", "draw"):
            try:
                unhooks = self.hook_all_methods(cell_cls, name, DialogCellDrawHook(self))
                count = len(unhooks) if unhooks else 0
            except Exception as e:
                errors.append("%s: %s" % (name, e))
                self.logger.exception("hook_all_methods(%s) failed" % name)
                continue
            if count:
                self._hook_info = "перехват: %s (%d)" % (name, count)
                self.logger.info(self._hook_info)
                return
            errors.append("%s: метода нет" % name)

        # ничего не сработало: покажем, какие draw-методы вообще есть
        names = []
        try:
            for m in cell_cls.getDeclaredMethods():
                n = str(m.getName())
                if "draw" in n.lower() and n not in names:
                    names.append(n)
        except Exception as e:
            names.append("не прочитать: %s" % e)
        self._hook_info = "перехват не удался (%s). draw-методы: %s" % (
            "; ".join(errors), ", ".join(names[:10]) or "нет")
        self.logger.error(self._hook_info)

    def on_app_event(self, event_type: AppEvent):
        if event_type in (AppEvent.PAUSE, AppEvent.STOP):
            # в фоне долги продолжают считаться, но список не перерисовываем
            self._foreground = False
        elif event_type in (AppEvent.RESUME, AppEvent.START):
            self._foreground = True
            try:
                account = UserConfig.selectedAccount
                self._seed_from_dialogs(account)   # подхватить то, что пришло в фоне
                self._refresh(account)             # сразу обновить цвета колец
            except Exception:
                self.logger.exception("on resume failed")

    # ---------- настройки ----------

