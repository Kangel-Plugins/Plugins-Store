__id__ = "chat_colors"
__name__ = "Chat Colors"
__description__ = "**Свой цвет для выбранных чатов** в списке чатов."
__author__ = "@lerowc & @lerowplug"
__version__ = "1.0"
__icon__ = "voodoo/5"
__min_version__ = "12.10.6"

import json
from typing import Any, Dict, List, Optional

from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from hook_utils import find_class
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Header, Selector, Switch, Text

try:
    from java import jint
except Exception:  # pragma: no cover
    jint = None

try:
    from android_utils import run_on_ui_thread
except Exception:  # pragma: no cover
    run_on_ui_thread = None

try:
    from client_utils import get_last_fragment, get_messages_controller
except Exception:  # pragma: no cover
    get_last_fragment = None
    get_messages_controller = None

AUTHOR_URL = "https://t.me/lerowplug"
PICKER_URL = "https://htmlcolorcodes.com/color-picker/"

COLORS = [
    ("Оранжевый", "FF8A00"),
    ("Синий", "2F80ED"),
    ("Зелёный", "27AE60"),
    ("Фиолетовый", "9B51E0"),
    ("Красный", "EB5757"),
    ("Жёлтый", "F2C94C"),
    ("Розовый", "FF5FA2"),
    ("Бирюзовый", "1ABC9C"),
    ("Белый", "FFFFFF"),
]
BRIGHTNESS_ITEMS = ["%d%%" % p for p in range(10, 101, 10)]  # 10% ... 100%
BRIGHTNESS_DEFAULT = 2  # 30%


def _as_int(value: Any) -> int:
    try:
        return int(value or 0)
    except Exception:
        return 0


def parse_hex(text: str) -> Optional[str]:
    """'#fff', 'FFAA00', '#ffaa00' -> 'FFAA00'; иначе None."""
    value = (text or "").strip().lstrip("#").upper()
    if len(value) == 3:
        value = "".join(ch * 2 for ch in value)
    if len(value) == 6 and all(ch in "0123456789ABCDEF" for ch in value):
        return value
    return None


class DrawHook(MethodHook):
    """Перед отрисовкой строки чата рисует цветной фон, если для этого чата задан цвет."""

    def __init__(self, plugin: "ChatColorsPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            plugin = self.plugin
            if not plugin.colors or not plugin.get_setting("enabled", True):
                return
            cell = param.thisObject
            rgb = plugin.colors.get(str(_as_int(cell.getDialogId())))
            if not rgb:
                return
            if plugin.paint is None:
                from android.graphics import Paint
                plugin.paint = Paint()
            plugin.paint.setColor(jint(plugin.argb(rgb)))
            param.args[0].drawRect(
                0.0, 0.0, float(cell.getMeasuredWidth()), float(cell.getMeasuredHeight()), plugin.paint
            )
        except Exception:
            pass  # вызывается на каждый кадр — не шумим


class ChatColorsPlugin(BasePlugin):
    # ------------------------------------------------------------ lifecycle
    def on_plugin_load(self):
        self.paint = None
        self.colors: Dict[str, str] = self._load()

        try:
            cell_cls = find_class("org.telegram.ui.Cells.DialogCell")
            self.hook_all_methods(cell_cls, "onDraw", DrawHook(self))
        except Exception:
            self.logger.exception("hook failed")

        for menu_name, handler in (
            ("CHAT_ACTION_MENU", self._on_chat_menu),
            ("PROFILE_ACTION_MENU", self._on_profile_menu),
        ):
            try:
                self.add_menu_item(
                    MenuItemData(
                        menu_type=getattr(MenuItemType, menu_name),
                        text="Цвет чата",
                        on_click=handler,
                        icon="msg_theme",
                        priority=5,
                    )
                )
            except Exception:
                self.logger.exception("menu item failed: %s", menu_name)

    # ------------------------------------------------------------ storage
    def _load(self) -> Dict[str, str]:
        try:
            data = json.loads(self.get_setting("colors", "{}") or "{}")
            return {str(k): str(v) for k, v in data.items()} if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save(self):
        payload = json.dumps(self.colors)
        try:
            self.set_setting("colors", payload, reload_settings=True)  # обновит список в настройках
        except TypeError:
            self.set_setting("colors", payload)
        except Exception:
            self.logger.exception("save failed")

    def _set_color(self, dialog_id: int, rgb: Optional[str]):
        if rgb:
            self.colors[str(dialog_id)] = rgb
        else:
            self.colors.pop(str(dialog_id), None)
        self._save()
        self._refresh_ui()
        self._notify("Цвет сохранён" if rgb else "Цвет убран")

    # ------------------------------------------------------------ helpers
    def argb(self, rgb: str) -> int:
        step = _as_int(self.get_setting("bright", BRIGHTNESS_DEFAULT))
        step = max(0, min(step, len(BRIGHTNESS_ITEMS) - 1))
        alpha = min(255, round((step + 1) * 10 * 2.55))
        from android.graphics import Color
        value = int(Color.parseColor("#%02X%s" % (alpha, rgb)))
        return value - (1 << 32) if value > 0x7FFFFFFF else value  # знаковое int для Java

    def _notify(self, text: str):
        def show():
            try:
                BulletinHelper.show_info(text)
            except Exception:
                self.logger.exception("bulletin failed")

        try:
            if run_on_ui_thread:
                run_on_ui_thread(show)
            else:
                show()
        except Exception:
            self.logger.exception("notify failed")

    def _refresh_ui(self, *_):
        try:
            nc = find_class("org.telegram.messenger.NotificationCenter")
            account = int(find_class("org.telegram.messenger.UserConfig").selectedAccount)
            nc.getInstance(account).postNotificationName(int(nc.dialogsNeedReload))
        except Exception:
            self.logger.exception("refresh failed")

    def _activity(self, context: Any = None) -> Any:
        try:
            if isinstance(context, dict):
                fragment = context.get("fragment")
                if fragment:
                    return fragment.getParentActivity()
                ctx = context.get("context")
                if ctx is not None:
                    return ctx
            elif context is not None:
                return context.getContext()
        except Exception:
            pass
        try:
            return get_last_fragment().getParentActivity()
        except Exception:
            return None

    def _open_url(self, context: Any, url: str):
        act = self._activity(context)
        try:
            from org.telegram.messenger import Browser
            Browser.openUrl(act, url)
            return
        except Exception:
            self.logger.exception("Browser.openUrl failed, trying Intent")
        try:
            from android.content import Intent
            from android.net import Uri
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            act.startActivity(intent)
        except Exception:
            self._notify(url)

    def _title(self, dialog_id: int) -> str:
        try:
            controller = get_messages_controller(0)
            try:
                from java import jlong
                key = jlong(abs(dialog_id))
            except Exception:
                key = abs(dialog_id)
            if dialog_id > 0:
                user = controller.getUser(key)
                if user is not None:
                    full = ("%s %s" % (user.first_name or "", user.last_name or "")).strip()
                    if full:
                        return full
            else:
                chat = controller.getChat(key)
                if chat is not None and chat.title:
                    return str(chat.title)
        except Exception:
            pass
        return "Чат %d" % dialog_id

    # ------------------------------------------------------------ menus
    def _on_chat_menu(self, context: Dict[str, Any]):
        self._open_picker(context, _as_int(context.get("dialog_id")))

    def _on_profile_menu(self, context: Dict[str, Any]):
        dialog_id = _as_int(context.get("dialog_id")) or _as_int(context.get("userId"))
        if not dialog_id:
            user = context.get("user")
            dialog_id = _as_int(getattr(user, "id", 0)) if user is not None else 0
        self._open_picker(context, dialog_id)

    def _open_picker(self, context: Any, dialog_id: int):
        if not dialog_id:
            self._notify("Не удалось определить чат")
            return
        act = self._activity(context)
        if act is None:
            self._notify("Не удалось открыть окно")
            return

        count = len(COLORS)

        def on_pick(bld: AlertDialogBuilder, which: int):
            bld.dismiss()
            if which < count:
                self._set_color(dialog_id, COLORS[which][1])
            elif which == count:
                self._input_hex(act, dialog_id)
            elif which == count + 1:
                self._open_url(context, PICKER_URL)
            else:
                self._set_color(dialog_id, None)

        try:
            current = self.colors.get(str(dialog_id))
            builder = AlertDialogBuilder(act)
            builder.set_title("Цвет чата: %s" % (("#" + current) if current else "не задан"))
            builder.set_items(
                [n for n, _ in COLORS] + ["Свой цвет (#HEX)", "Подобрать цвет на сайте", "Убрать цвет"],
                on_pick,
            )
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
        except Exception:
            self.logger.exception("picker failed")

    def _input_hex(self, act: Any, dialog_id: int):
        try:
            from android.widget import EditText
            edit = EditText(act)
            edit.setHint("#FFFFFF")
            edit.setText("#" + self.colors.get(str(dialog_id), COLORS[0][1]))

            def on_save(bld: AlertDialogBuilder, which: int):
                try:
                    raw = str(edit.getText().toString())
                except Exception:
                    raw = ""
                value = parse_hex(raw)
                bld.dismiss()
                if value is None:
                    self._notify("Неверный цвет. Пример: #FF8A00")
                    return
                self._set_color(dialog_id, value)

            builder = AlertDialogBuilder(act)
            builder.set_title("Свой цвет")
            builder.set_message("Формат #RRGGBB, например #FFFFFF")
            builder.set_view(edit)
            builder.set_positive_button("Сохранить", on_save)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
        except Exception:
            self.logger.exception("hex dialog failed")
            self._notify("Не удалось открыть поле ввода, выбери из списка")

    # ------------------------------------------------------------ settings actions
    def _reset_all(self, view: Any = None):
        self.colors = {}
        self._save()
        self._refresh_ui()
        self._notify("Все цвета сброшены")

    def _open_author(self, view: Any = None):
        self._open_url(view, AUTHOR_URL)

    def _open_picker_site(self, view: Any = None):
        self._open_url(view, PICKER_URL)

    # ------------------------------------------------------------ settings
    @staticmethod
    def _row(factory: Any, **kw: Any) -> Any:
        """Строит элемент настроек с иконкой и подписью; если версия не принимает параметр — упрощает."""
        for drop in ((), ("subtext",), ("subtext", "icon")):
            try:
                return factory(**{k: v for k, v in kw.items() if k not in drop})
            except Exception:
                continue
        return None

    def create_settings(self) -> List[Any]:
        row = self._row
        items: List[Any] = [
            Header(text="Основное"),
            row(Switch, key="enabled", text="Включить цвета", default=True,
                icon="msg_theme", subtext="Красить выбранные чаты в списке"),
            row(Selector, key="bright", text="Яркость цвета", default=BRIGHTNESS_DEFAULT,
                items=BRIGHTNESS_ITEMS, icon="msg_brightness", on_change=self._refresh_ui),
            row(Text, text="Подобрать цвет на сайте", icon="msg_link",
                subtext="Выбрать цвет на градиенте и скопировать #HEX",
                on_click=self._open_picker_site),
            Header(text="Покрашенные чаты"),
        ]
        if self.colors:
            for key, rgb in list(self.colors.items()):
                dialog_id = _as_int(key)
                items.append(row(
                    Text,
                    text=self._title(dialog_id),
                    icon="msg_edit",
                    subtext="Цвет #%s. Нажми, чтобы изменить" % rgb,
                    on_click=lambda view, d=dialog_id: self._open_picker(view, d),
                ))
            items.append(row(Text, text="Сбросить все цвета", icon="msg_delete", red=True,
                             subtext="Убрать цвет у всех чатов", on_click=self._reset_all))
        else:
            items.append(row(Text, text="Пока ни одного чата", icon="msg_info",
                             subtext="Открой чат, нажми на три точки и выбери «Цвет чата»"))
        items.append(Header(text="Автор"))
        items.append(row(Text, text="Канал автора", icon="msg_channel",
                         subtext="@lerowplug", on_click=self._open_author))
        return [i for i in items if i is not None]
