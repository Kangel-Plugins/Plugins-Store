SEP = "\x1f"
PAGE_LIMIT = 100
PAGE_DELAY_MS = 400
BATCH_SIZE_OPTIONS = (100, 200, 300, 400, 500, 600, 700, 800, 900)
TG_REQUEST_LIMIT = 100
MAX_ATTEMPTS = 5
MIN_ATTEMPTS_LIMIT = 3
MAX_ATTEMPTS_LIMIT = 40
ATTEMPT_PAUSE_MS = 200
RESCAN_DELAY_MS = 1000
MENU_PRIORITY = 8
BANNER_THROTTLE_MS = 250
STALL_TIMEOUT_S = 90
AYU_CFG = "com.radolyn.ayugram.AyuConfig"
AYU_FLAG = "saveDeletedMessages"
AYU_PENDING_KEY = "ayu_restore_pending"

FATAL_HOOK = None


def log(msg):
    try:
        android_log(f"[{TAG}] {msg}")
    except BaseException:
        pass


def elog(msg):
    log(f"{msg}\n{traceback.format_exc()}")


def guard(default=None, msg=None):
    def deco(fn):
        @wraps(fn)
        def wrapper(*args, **kwargs):
            try:
                return fn(*args, **kwargs)
            except Exception:
                elog(msg or f"{fn.__name__} failed")
                return default
        return wrapper
    return deco


def wrap(fn, where, fatal):
    def run():
        try:
            return fn()
        except BaseException as ex:
            elog(f"UNHANDLED in {where}: {ex!r}")
            if fatal and FATAL_HOOK is not None:
                try:
                    FATAL_HOOK(ex)
                except BaseException as ex2:
                    elog(f"fatal hook failed: {ex2!r}")
            raise
    return run


class Dex:
    def __init__(self):
        self._lock = threading.Lock()
        self._loader = None
        self._method = None
        self.error = None

    def _load(self):
        data = base64.b64decode("".join(DEX_B64))
        digest = hashlib.sha256(data).hexdigest()
        if digest != DEX_SHA256:
            raise ValueError(f"dex sha256 mismatch: {digest}")
        buf = jclass("java.nio.ByteBuffer").wrap(jarray(jbyte)(data))
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = jclass("dalvik.system.InMemoryDexClassLoader")(buf, parent)
        cls = loader.loadClass(DEX_CLASS)
        str_cls = jclass("java.lang.Class").forName("java.lang.String")
        method = cls.getMethod("call", str_cls, str_cls)
        if str(self._invoke(method, "api", "")) != DEX_API:
            raise ValueError("dex api mismatch")
        self._loader = loader
        self._method = method

    @staticmethod
    def _invoke(method, name, payload):
        try:
            return method.invoke(None, name, payload)
        except TypeError:
            arr = jarray(jclass("java.lang.Object"))([name, payload])
            return method.invoke(None, arr)

    def ensure(self):
        if self._method is not None:
            return True
        with self._lock:
            if self._method is not None:
                return True
            try:
                self._load()
                self.error = None
            except Exception:
                self.error = traceback.format_exc()
                self._loader = self._method = None
                log(f"dex load failed: {self.error}")
        return self._method is not None

    def call(self, name, *args):
        if not self.ensure():
            raise RuntimeError("dex not loaded")
        payload = SEP.join("" if a is None else str(a).replace(SEP, " ") for a in args)
        raw = str(self._invoke(self._method, name, payload))
        if raw.startswith("\x00"):
            raise RuntimeError(raw[1:])
        return raw

    def close(self):
        with self._lock:
            self._loader = self._method = None


DEX = Dex()


def dex(name, *args):
    return DEX.call(name, *args)


@guard(default="en", msg="Language detect failed")
def lang():
    try:
        return str(LocaleController.getInstance().getCurrentLocale().getLanguage()).lower()
    except Exception:
        return str(Locale.getDefault().getLanguage()).lower()


def tr(key, *args):
    return dex("loc", lang(), key, *args)


def to_bool(value):
    if isinstance(value, bool):
        return value
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return value != 0
    res = dex("tobool", value)
    return None if res == "" else res == "1"


def clamp_attempts(raw):
    return int(dex("clamp", raw).split(SEP)[0])


def banner_text(st):
    return dex("banner", lang(), st["phase"], st["found"], st["deleted"], st["unverified"], st["failed"], st["note"])


def csv(ids):
    return ",".join(str(i) for i in ids)


def parse_csv(text):
    return [int(x) for x in text.split(",")] if text else []


def queue(fn, delay_ms=0):
    run_on_queue(wrap(fn, "queue", True), client_utils.PLUGINS_QUEUE, delay_ms)


def ui(fn, delay_ms=0):
    if delay_ms:
        run_on_ui_thread(wrap(fn, "ui", False), delay_ms)
    else:
        run_on_ui_thread(wrap(fn, "ui", False))


def error_bulletin_icon(kind="error"):
    names = ("error", "chats_infotip", "info") if kind == "error" else ("info", "chats_infotip", "error")
    raw = getattr(R_tg, "raw", None)
    for name in names:
        icon = getattr(raw, name, None)
        if icon:
            return icon
    return 0


@guard(default=None, msg="Ayu state lookup failed")
def get_ayu_state():
    try:
        from com.radolyn.ayugram import AyuState
    except ImportError:
        return None
    return AyuState


def is_empty_message(m):
    try:
        if isinstance(m, TLRPC.TL_messageEmpty):
            return True
    except Exception:
        elog("is_empty_message")
    try:
        return "messageEmpty" in str(m.getClass().getSimpleName())
    except Exception:
        elog("is_empty_message")
        return False


def is_service_message(m):
    try:
        if isinstance(m, TLRPC.TL_messageService):
            return True
    except Exception:
        elog("is_service_message")
    try:
        return getattr(m, "action", None) is not None
    except Exception:
        elog("is_service_message")
        return False


def is_mine(st, m):
    if m is None or is_empty_message(m) or is_service_message(m):
        return False
    if m.date >= st["before"]:
        return False
    if st["secret"]:
        return True
    return bool(m.out) and not m.post


def is_secret_dialog(dialog_id):
    try:
        return bool(DialogObject.isEncryptedDialog(dialog_id))
    except Exception:
        elog("is_secret_dialog")
        return (dialog_id & 0x4000000000000000) != 0 and dialog_id > 0


def secret_chat_id(dialog_id):
    try:
        return int(DialogObject.getEncryptedChatId(dialog_id))
    except Exception:
        elog("secret_chat_id")
        return int(dialog_id & 0xFFFFFFFF)


class StorageTask(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        self._fn()


def storage_run(account, fn, cb):
    def task():
        try:
            res, err = fn(), None
        except Exception as e:
            elog("storage task error")
            res, err = None, str(e)
        queue(lambda: cb(res, err))

    MessagesStorage.getInstance(account).getStorageQueue().postRunnable(StorageTask(task))


def read_secret_rows(st):
    db = MessagesStorage.getInstance(st["account"]).getDatabase()
    rows = []
    cur = db.queryFinalized(
        "SELECT m.mid, m.data, r.random_id FROM messages_v2 AS m "
        "LEFT JOIN randoms_v2 AS r ON r.mid = m.mid AND r.uid = m.uid "
        "WHERE m.uid = %d AND m.out = 1 AND m.date < %d"
        % (int(st["dialog_id"]), int(st["before"])))
    seen = {}
    try:
        while cur.next():
            mid = cur.intValue(0)
            rnd = int(cur.longValue(2))
            if mid in seen:
                if rnd != 0 and seen[mid] == 0:
                    seen[mid] = rnd
                continue
            data = cur.byteBufferValue(1)
            if data is None:
                continue
            try:
                m = TLRPC.Message.TLdeserialize(data, data.readInt32(False), False)
            finally:
                data.reuse()
            if m is None:
                continue
            m.id = mid
            if is_mine(st, m):
                seen[mid] = rnd
                rows.append(mid)
    finally:
        cur.dispose()
    no_rnd = sum(1 for mid in rows if seen[mid] == 0)
    if no_rnd:
        log(f"secret chat: {no_rnd} of {len(rows)} own messages have no random_id in randoms_v2 -> deleted locally only")
    return [(mid, seen[mid]) for mid in rows]


def secret_existing(st, ids):
    db = MessagesStorage.getInstance(st["account"]).getDatabase()
    found = []
    cur = db.queryFinalized(
        "SELECT mid FROM messages_v2 WHERE uid = %d AND mid IN (%s)"
        % (int(st["dialog_id"]), ",".join(str(int(i)) for i in ids)))
    try:
        while cur.next():
            found.append(cur.intValue(0))
    finally:
        cur.dispose()
    return found


def detect_topic(fragment, dialog_id):
    try:
        if fragment is None or int(fragment.getDialogId()) != int(dialog_id):
            return 0
    except Exception:
        elog("detect_topic")
        return 0
    for name in ("getTopicId", "getThreadMessageId"):
        try:
            v = int(getattr(fragment, name)())
            if v > 0:
                return v
        except Exception:
            elog("detect_topic")
    try:
        tm = fragment.getThreadMessage()
        if tm is not None:
            return int(tm.getId())
    except Exception:
        elog("detect_topic")
    return 0


def get_activity():
    try:
        f = client_utils.get_last_fragment()
        act = f.getParentActivity() if f else None
        if act is not None:
            return act
    except Exception:
        elog("get_activity")
    return LaunchActivity.instance


class AyuHack:
    def __init__(self, plugin):
        self._plugin = plugin
        self._lock = threading.RLock()
        self._old = None
        self._engaged = False

    @staticmethod
    def _cfg():
        return jclass(AYU_CFG)

    def _set_pending(self, value):
        try:
            self._plugin.set_setting(AYU_PENDING_KEY, value)
        except Exception:
            elog("ayu: cannot persist pending marker")

    def engage(self):
        with self._lock:
            if self._engaged:
                return True
            try:
                cfg = self._cfg()
                old = bool(getattr(cfg, AYU_FLAG))
                self._old = old
                self._engaged = True
                self._set_pending("1" if old else "0")
                setattr(cfg, AYU_FLAG, False)
                if bool(getattr(cfg, AYU_FLAG)):
                    raise RuntimeError(f"AyuConfig.{AYU_FLAG} did not change")
                log(f"AyuConfig.{AYU_FLAG} {old} -> False")
                return True
            except Exception:
                elog("ayu engage failed")
                self.release("engage error")
                return False

    def release(self, reason=""):
        with self._lock:
            if not self._engaged:
                return True
            try:
                cfg = self._cfg()
                setattr(cfg, AYU_FLAG, self._old)
                if bool(getattr(cfg, AYU_FLAG)) != self._old:
                    raise RuntimeError(f"AyuConfig.{AYU_FLAG} was not restored")
                self._engaged = False
                self._set_pending("")
                log(f"AyuConfig.{AYU_FLAG} restored to {self._old} ({reason})")
                return True
            except Exception:
                elog(f"ayu RESTORE FAILED ({reason})")
                ui(lambda: BulletinHelper.show_error(tr("AYU_RESTORE_FAILED")))
                return False

    def recover(self):
        try:
            val = self._plugin.get_setting(AYU_PENDING_KEY, "")
            if val not in ("0", "1"):
                return
            setattr(self._cfg(), AYU_FLAG, val == "1")
            self._set_pending("")
            log(f"AyuConfig.{AYU_FLAG} recovered to {val == '1'} after interrupted run")
        except Exception:
            elog("ayu recover failed")


class Banner:
    def __init__(self, on_stop):
        self._on_stop = on_stop
        self._tv = None
        self._text = ""
        self._last = 0.0
        self._pending = False
        self._want = False

    def show(self, text):
        self._text = text
        self._want = True
        ui(lambda: self._show_ui(0))

    def update(self, text, force=False):
        self._text = text
        if self._want:
            ui(lambda: self._tick(force))

    def hide(self):
        self._want = False
        ui(self._hide_ui)

    def _tick(self, force):
        if self._tv is None:
            return
        now = time.time()
        if force or (now - self._last) * 1000 >= BANNER_THROTTLE_MS:
            self._last = now
            self._tv.setText(self._text)
        elif not self._pending:
            self._pending = True
            ui(self._flush, BANNER_THROTTLE_MS)

    def _flush(self):
        self._pending = False
        self._tick(True)

    def _show_ui(self, tries):
        if not self._want:
            return
        try:
            if self._tv is not None:
                self._tv.setText(self._text)
                return
            act = get_activity()
            root = act.findViewById(16908290) if act is not None else None
            if root is None:
                if tries < 10:
                    ui(lambda: self._show_ui(tries + 1), 300)
                return
            tv = TextView(act)
            tv.setTextColor(Color.WHITE)
            tv.setTextSize(2, 14.0)
            tv.setGravity(Gravity.CENTER)
            tv.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(10),
                          AndroidUtilities.dp(16), AndroidUtilities.dp(10))
            bg = GradientDrawable()
            bg.setColor(Color.argb(230, 32, 32, 32))
            bg.setCornerRadius(float(AndroidUtilities.dp(14)))
            tv.setBackground(bg)
            tv.setElevation(float(AndroidUtilities.dp(6)))
            tv.setOnLongClickListener(OnLongClickListener(lambda v: (self._on_stop(), True)[1]))
            tv.setText(self._text)
            lp = FrameLayout.LayoutParams(-2, -2, Gravity.TOP | Gravity.CENTER_HORIZONTAL)
            lp.topMargin = AndroidUtilities.statusBarHeight + AndroidUtilities.dp(12)
            root.addView(tv, lp)
            self._tv = tv
        except Exception:
            elog("banner error")

    def _hide_ui(self):
        try:
            if self._tv is not None:
                parent = self._tv.getParent()
                if parent is not None:
                    parent.removeView(self._tv)
        except Exception:
            elog("banner hide error")
        self._tv = None
        self._pending = False


class QPSwipe(BasePlugin):
    def __init__(self):
        super().__init__()
        self._st = None
        self._lock = threading.Lock()
        self._banner = Banner(lambda: self.stop_deletion())
        self._flag_cache = {}
        self._ayu = AyuHack(self)
        self._unloaded = False
        self._menu_item = None

    def on_plugin_load(self):
        global FATAL_HOOK
        self._unloaded = False
        self._flag_cache.clear()
        if not DEX.ensure():
            ui(lambda: BulletinHelper.show_error("QPSwipe: dex integrity check failed"))
            return
        FATAL_HOOK = self._on_fatal
        self._ayu.recover()
        self._menu_item = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text=tr("MENU_ITEM_DELETE"),
                on_click=self._on_menu_click,
                icon="msg_delete_solar",
                priority=MENU_PRIORITY,
            )
        )

    def on_plugin_unload(self):
        global FATAL_HOOK
        self._unloaded = True
        self._ayu.release("plugin unload")
        st = self._st
        if st is not None:
            def fin():
                st["stop"] = True
                self._finish(st, silent=True)
            queue(fin)
        self._banner.hide()
        FATAL_HOOK = None
        DEX.close()

    def create_settings(self):
        if not DEX.ensure():
            return [
                Header(text=TAG),
                Divider(text="Integrity check failed or dex did not load: plugin disabled."),
            ]
        return [
            Header(text=tr("HEADER_WIPE")),
            Switch(
                key="show_banner",
                text=tr("SWITCH_SHOW_BANNER"),
                default=True,
                subtext=tr("SHOW_BANNER_SUBTEXT"),
                on_change=lambda value: self._on_flag_change("show_banner", value),
            ),
            Switch(
                key="confirm_count",
                text=tr("SWITCH_CONFIRM_COUNT"),
                default=True,
                subtext=tr("CONFIRM_COUNT_SUBTEXT"),
                on_change=lambda value: self._on_flag_change("confirm_count", value),
            ),
            Selector(
                key="batch_size_idx",
                text=tr("SELECTOR_BATCH_SIZE"),
                default=0,
                items=[str(x) for x in BATCH_SIZE_OPTIONS],
            ),
            Input(
                key="max_attempts",
                text=tr("INPUT_MAX_ATTEMPTS"),
                default=str(MAX_ATTEMPTS),
                subtext=tr("MAX_ATTEMPTS_SUBTEXT", MIN_ATTEMPTS_LIMIT, MAX_ATTEMPTS_LIMIT,
                           MIN_ATTEMPTS_LIMIT, MAX_ATTEMPTS_LIMIT, MAX_ATTEMPTS),
                on_change=self._on_attempts_change,
            ),
            Divider(),
        ]

    def _on_fatal(self, exc):
        self._ayu.release("fatal error")
        st = self._st
        if st is not None:
            self._finish(st, error=repr(exc))

    @guard(default=BATCH_SIZE_OPTIONS[0], msg="Batch size read failed")
    def _get_batch_size(self):
        idx = int(self.get_setting("batch_size_idx", 0))
        if idx < 0 or idx >= len(BATCH_SIZE_OPTIONS):
            idx = 0
        return BATCH_SIZE_OPTIONS[idx]

    @guard(default=MAX_ATTEMPTS, msg="Max attempts read failed")
    def _get_max_attempts(self):
        return clamp_attempts(self.get_setting("max_attempts", str(MAX_ATTEMPTS)))

    def _flag(self, key, default=True):
        try:
            cached = self._flag_cache.get(key)
            if cached is not None:
                return cached
            parsed = to_bool(self.get_setting(key, default))
            return default if parsed is None else parsed
        except Exception:
            elog(f"Flag read failed: {key}")
            return default

    @guard(msg="Flag change handler failed")
    def _on_flag_change(self, key, new_value):
        parsed = to_bool(new_value)
        if parsed is not None:
            self._flag_cache[key] = parsed

    @guard(msg="Attempts change handler failed")
    def _on_attempts_change(self, new_value):
        v, num = dex("clamp", str(new_value)).split(SEP)
        if num != "" and int(num) != int(v):
            self.set_setting("max_attempts", v)
            BulletinHelper.show_info(tr("ATTEMPTS_CLAMPED", v, MIN_ATTEMPTS_LIMIT, MAX_ATTEMPTS_LIMIT))

    def _refresh(self, st, force=False):
        self._banner.update(banner_text(st), force)

    @guard(default=False, msg="Clipboard copy failed")
    def _copy_to_clipboard(self, label, text):
        context = ApplicationLoader.applicationContext
        if not context:
            return False
        clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)
        if not clipboard:
            return False
        clipboard.setPrimaryClip(ClipData.newPlainText(label, text))
        return True

    def _show_copy_bulletin(self, text, payload, button_text, copied_text, kind="error"):
        def copy_action():
            if self._copy_to_clipboard(f"{TAG} {kind}", payload):
                BulletinHelper.show_info(copied_text)

        def show():
            try:
                BulletinHelper.show_with_button(
                    text, error_bulletin_icon(kind), button_text, copy_action, client_utils.get_last_fragment())
            except Exception:
                elog("show_with_button unavailable")
                (BulletinHelper.show_error if kind == "error" else BulletinHelper.show_info)(text)

        ui(show)

    def _send(self, st, req, handler):
        def cb(response, error):
            queue(lambda: handler(response, error))

        send_request(req, cb, account=st["account"])

    def _on_error(self, st, error, retry, retry_fn, fail_fn):
        text = str(error.text)
        code = getattr(error, "code", 0)
        log(f"request error: code={code} text={text}")
        plan = dex("errplan", text, code, retry).split(SEP)
        if plan[0] == "flood":
            wait = int(plan[1])
            st["note"] = tr("NOTE_FLOOD_WAIT", wait)
            self._touch(st, extra=wait)
            self._refresh(st, force=True)

            def go():
                st["note"] = ""
                retry_fn()

            queue(go, int(plan[2]))
        elif plan[0] == "retry":
            queue(retry_fn, int(plan[1]))
        else:
            fail_fn(text)

    def _build_search(self, st, offset_id):
        req = TLRPC.TL_messages_search()
        req.peer = st["peer"]
        req.limit = PAGE_LIMIT
        req.q = ""
        req.offset_id = offset_id
        req.from_id = st["from_id"]
        req.flags |= 1
        req.filter = TLRPC.TL_inputMessagesFilterEmpty()
        if st["topic_id"] != 0:
            req.top_msg_id = st["topic_id"]
            req.flags |= 2
        req.hash = 0
        return req

    def _search(self, st, on_new, done):
        if st["secret"]:
            self._search_secret(st, on_new, done)
            return
        seen = set()

        def page(offset_id=0, retry=0):
            if self._dead(st):
                return
            try:
                req = self._build_search(st, offset_id)

                def on_response(response, error):
                    if self._dead(st):
                        return
                    try:
                        if error:
                            self._on_error(st, error, retry,
                                           lambda: page(offset_id, retry + 1),
                                           lambda text: done(text))
                            return
                        self._touch(st)
                        raw = getattr(response, "messages", None)
                        msgs = list(raw.toArray()) if raw is not None else []
                        if not msgs:
                            done(None)
                            return
                        min_id = min(m.id for m in msgs)
                        if offset_id != 0 and min_id >= offset_id:
                            done(None)
                            return
                        for m in msgs:
                            if m.id in seen or not is_mine(st, m):
                                continue
                            seen.add(m.id)
                            on_new(m.id)
                        queue(lambda: page(min_id, 0), PAGE_DELAY_MS)
                    except Exception as e:
                        elog("search callback error")
                        done(str(e))

                self._send(st, req, on_response)
            except Exception as e:
                elog("search error")
                done(str(e))

        page()

    def _search_secret(self, st, on_new, done):
        def cb(rows, err):
            if self._dead(st):
                return
            if err:
                log(f"secret search error: {err}")
                done(err)
                return
            self._touch(st)
            for mid, rnd in rows:
                st["rand"][mid] = rnd
                on_new(mid)
            done(None)

        storage_run(st["account"], lambda: read_secret_rows(st), cb)

    def _scan(self, st):
        def on_new(msg_id):
            st["ids"].append(msg_id)
            st["found"] += 1
            self._refresh(st)

        def done(err):
            st["scan_error"] = err
            if st["confirm"]:
                self._ask_confirm(st)
                return
            self._start_batches(st)

        self._search(st, on_new, done)

    def _rescan(self, st):
        if self._dead(st):
            return
        st["left"] = 0

        def on_new(msg_id):
            st["left"] += 1

        def done(err):
            st["left_err"] = err
            st["rescan_done"] = err is None
            if err is None and st["scan_error"] is None:
                left = min(st["left"], st["found"])
                st["deleted"] = st["found"] - left
                st["failed"] = left
                st["unverified"] = 0
            self._finish(st)

        self._search(st, on_new, done)

    def _ask_confirm(self, st):
        if self._dead(st):
            return
        if st["found"] == 0:
            self._finish(st)
            return
        st["phase"] = "confirm"
        st["deadline"] = float("inf")
        self._banner.hide()
        ui(lambda: self._show_confirm_dialog(st))

    def _show_confirm_dialog(self, st):
        try:
            if st["done"]:
                return
            fragment = client_utils.get_last_fragment()
            ctx = fragment.getContext() if fragment else ApplicationLoader.applicationContext

            def answer(no_local_save):
                def cb(dialog, which):
                    st["confirm_answered"] = True
                    queue(lambda: self._confirm_yes(st, no_local_save))
                return cb

            def on_cancel(dialog, which):
                st["confirm_answered"] = True
                queue(lambda: self._confirm_no(st))

            def on_dismiss(bld):
                if not st["confirm_answered"]:
                    st["confirm_answered"] = True
                    queue(lambda: self._confirm_no(st))

            msg = dex("confirm", lang(), st["found"], 1 if st["topic_id"] else 0, st["scan_error"] or "")
            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(tr("DIALOG_DELETE_TITLE"))
            builder.set_message(msg)
            builder.set_positive_button(tr("BUTTON_DELETE"), answer(False))
            if get_ayu_state() is not None:
                builder.set_neutral_button(tr("BUTTON_DELETE_NO_LOCAL"), answer(True))
            builder.set_negative_button(tr("BUTTON_CANCEL"), on_cancel)
            builder.set_on_dismiss_listener(on_dismiss)
            st["dialog"] = builder
            builder.show()
        except Exception as e:
            elog("confirm dialog error")
            reason = str(e)
            queue(lambda: self._finish(st, error=reason))

    def _confirm_yes(self, st, no_local_save):
        if self._dead(st) or st["phase"] != "confirm":
            return
        st["dialog"] = None
        st["confirm"] = False
        if no_local_save:
            st["ayu_req"] = True
            st["ayu_warn"] = get_ayu_state() is None
        st["phase"] = "delete"
        self._touch(st)
        if st["banner"]:
            self._banner.show(banner_text(st))
        self._start_batches(st)

    def _confirm_no(self, st):
        if self._dead(st) or st["phase"] != "confirm":
            return
        st["stop"] = True
        self._finish(st, silent=True)

    def _start_batches(self, st):
        if self._dead(st):
            return
        ids = st["ids"]
        bounds = parse_csv(dex("split", len(ids), st["batch_size"]))
        st["batches"] = [ids[bounds[i]:bounds[i + 1]] for i in range(len(bounds) - 1)]
        st["batch_idx"] = 0
        if st["ayu_req"] and not st["ayu_warn"] and ids:
            if not self._ayu.engage():
                st["ayu_warn"] = True
        st["phase"] = "delete"
        self._refresh(st, force=True)
        self._next_batch(st)

    def _next_batch(self, st):
        if self._dead(st):
            return
        if st["batch_idx"] >= len(st["batches"]):
            self._after_batches(st)
            return
        st["remaining"] = list(st["batches"][st["batch_idx"]])
        st["attempt"] = 0
        self._attempt(st)

    def _advance(self, st):
        st["batch_idx"] += 1
        queue(lambda: self._next_batch(st), ATTEMPT_PAUSE_MS)

    def _attempt(self, st):
        if self._dead(st):
            return
        st["attempt"] += 1
        self._touch(st)
        ids = list(st["remaining"])

        def action():
            try:
                for i in range(0, len(ids), TG_REQUEST_LIMIT):
                    java_list = ArrayList()
                    randoms = ArrayList() if st["secret"] else None
                    for msg_id in ids[i:i + TG_REQUEST_LIMIT]:
                        java_list.add(jint(msg_id))
                        if randoms is not None:
                            randoms.add(jlong(st["rand"].get(msg_id, 0)))
                    st["mc"].deleteMessages(java_list, randoms, st["enc_chat"],
                                            st["dialog_id"], st["topic_id"], True, 0)
            except Exception:
                elog("delete error")
                if st["ayu_req"]:
                    st["ayu_warn"] = True
                    self._ayu.release("delete error")

        ui(action)

        chunks = (len(ids) + TG_REQUEST_LIMIT - 1) // TG_REQUEST_LIMIT
        delay = int(dex("vdelay", st["attempt"], chunks))
        log(f"batch {st['batch_idx'] + 1}/{len(st['batches'])} attempt {st['attempt']}/{st['max_attempts']}: "
            f"deleting {len(ids)} msgs, verify in {delay}ms")
        queue(lambda: self._verify(st, ids), delay)

    def _verify(self, st, ids):
        if self._dead(st):
            return
        if st["secret"]:
            def cb(found, err):
                if self._dead(st):
                    return
                if err:
                    log(f"secret verify error: {err}")
                    self._verify_failed(st, ids)
                    return
                self._touch(st)
                self._after_attempt(st, found)

            storage_run(st["account"], lambda: secret_existing(st, ids), cb)
            return
        self._verify_chunk(st, ids, 0, [], 0)

    def _verify_chunk(self, st, ids, pos, still, retry):
        if self._dead(st):
            return
        try:
            chunk = ids[pos:pos + TG_REQUEST_LIMIT]
            if st["input_channel"] is not None:
                req = TLRPC.TL_channels_getMessages()
                req.channel = st["input_channel"]
            else:
                req = TLRPC.TL_messages_getMessages()
            for msg_id in chunk:
                im = TLRPC.TL_inputMessageID()
                im.id = msg_id
                req.id.add(im)

            def on_response(response, error):
                if self._dead(st):
                    return
                try:
                    if error:
                        self._on_error(st, error, retry,
                                       lambda: self._verify_chunk(st, ids, pos, still, retry + 1),
                                       lambda text: self._verify_failed(st, ids))
                        return
                    self._touch(st)
                    found = list(still)
                    raw = getattr(response, "messages", None)
                    if raw is not None:
                        for m in raw.toArray():
                            if not is_empty_message(m):
                                found.append(m.id)
                    nxt = pos + TG_REQUEST_LIMIT
                    if nxt < len(ids):
                        self._verify_chunk(st, ids, nxt, found, 0)
                    else:
                        self._after_attempt(st, found)
                except Exception:
                    elog("verify callback error")
                    self._verify_failed(st, ids)

            self._send(st, req, on_response)
        except Exception:
            elog("verify error")
            self._verify_failed(st, ids)

    def _verify_failed(self, st, ids):
        if self._dead(st):
            return
        log(f"verify failed, {len(ids)} ids unverified")
        st["unverified"] += len(ids)
        st["remaining"] = []
        self._refresh(st, force=True)
        self._advance(st)

    def _after_attempt(self, st, still_exist):
        if self._dead(st):
            return
        before = len(st["remaining"])
        st["remaining"] = parse_csv(dex("remain", csv(st["remaining"]), csv(still_exist)))
        st["deleted"] += before - len(st["remaining"])
        log(f"attempt {st['attempt']} result: still_exist={len(st['remaining'])} of {before}")

        if not st["remaining"]:
            self._refresh(st)
            self._advance(st)
        elif st["attempt"] < st["max_attempts"]:
            self._refresh(st)
            queue(lambda: self._attempt(st), ATTEMPT_PAUSE_MS)
        else:
            st["failed"] += len(st["remaining"])
            st["remaining"] = []
            self._refresh(st, force=True)
            self._advance(st)

    def _after_batches(self, st):
        self._ayu.release("batches done")
        if st["found"] == 0:
            self._finish(st)
            return
        st["phase"] = "recheck"
        self._refresh(st, force=True)
        queue(lambda: self._rescan(st), RESCAN_DELAY_MS)

    def start_deletion(self, account, dialog_id, topic_id, no_local_save=False, confirm=False):
        st = {
            "account": account, "dialog_id": dialog_id, "topic_id": topic_id,
            "mc": None, "peer": None, "from_id": None, "input_channel": None, "before": 0,
            "ayu_req": False, "ayu_warn": False,
            "batch_size": self._get_batch_size(), "max_attempts": self._get_max_attempts(),
            "banner": self._flag("show_banner", True),
            "confirm": confirm, "confirm_answered": False, "dialog": None,
            "phase": "scan", "note": "", "stop": False, "done": False, "deadline": 0.0,
            "ids": [], "scan_error": None, "rescan_done": False,
            "secret": False, "enc_chat": None, "rand": {},
            "batches": [], "batch_idx": 0, "remaining": [], "attempt": 0,
            "found": 0, "deleted": 0, "unverified": 0, "failed": 0,
            "left": None, "left_err": None,
        }
        with self._lock:
            if self._st is not None:
                ui(lambda: BulletinHelper.show_info(tr("INFO_ALREADY_RUNNING")))
                return
            self._st = st

        try:
            mc = client_utils.get_messages_controller(account)
            uc = client_utils.get_user_config(account)
            st["mc"] = mc
            st["before"] = client_utils.get_connections_manager(account).getCurrentTime()

            if is_secret_dialog(dialog_id):
                st["secret"] = True
                st["topic_id"] = 0
                enc = mc.getEncryptedChat(jint(secret_chat_id(dialog_id)))
                if enc is None:
                    raise Exception(tr("ERR_SECRET_UNAVAILABLE"))
                st["enc_chat"] = enc
            else:
                st["peer"] = mc.getInputPeer(dialog_id)
                st["from_id"] = mc.getInputPeer(uc.getCurrentUser())
                if dialog_id < 0:
                    chat = mc.getChat(jlong(-dialog_id))
                    if chat is None:
                        raise Exception(tr("ERR_CHAT_NOT_LOADED"))
                    if ChatObject.isChannel(chat):
                        st["input_channel"] = MessagesController.getInputChannel(chat)

            if no_local_save:
                st["ayu_req"] = True
                st["ayu_warn"] = get_ayu_state() is None
        except Exception as e:
            elog("start error")
            self._finish(st, error=str(e))
            return

        log(f"start secret={st['secret']} topic={bool(topic_id)} confirm={confirm} "
            f"batch_size={st['batch_size']} max_attempts={st['max_attempts']} no_local_save={no_local_save}")
        self._touch(st)
        if st["banner"]:
            self._banner.show(banner_text(st))
        elif not confirm:
            ui(lambda: BulletinHelper.show_info(tr("INFO_DELETION_STARTED")))
        self._watchdog(st)
        self._scan(st)

    def stop_deletion(self):
        st = self._st
        if st is None:
            return

        def fin():
            st["stop"] = True
            self._finish(st)

        queue(fin)

    @staticmethod
    def _dead(st):
        return st["done"]

    @staticmethod
    def _touch(st, extra=0):
        st["deadline"] = time.time() + STALL_TIMEOUT_S + extra

    def _watchdog(self, st):
        if self._dead(st):
            return
        if time.time() > st["deadline"]:
            log("stalled, finishing")
            self._finish(st, error=tr("ERR_NO_RESPONSE"))
            return
        queue(lambda: self._watchdog(st), 5000)

    def _finish(self, st, error=None, silent=False):
        with self._lock:
            if st["done"]:
                return
            st["done"] = True
            if self._st is st:
                self._st = None

        dlg = st.get("dialog")
        if dlg is not None:
            st["confirm_answered"] = True
            st["dialog"] = None
            ui(lambda: dlg.dismiss())

        self._ayu.release("finish")

        if st["remaining"]:
            st["unverified"] += len(st["remaining"])
            st["remaining"] = []

        self._banner.hide()

        log(f"finished found={st['found']} deleted={st['deleted']} unverified={st['unverified']} "
            f"failed={st['failed']} left={st['left']} scan_error={st['scan_error']} error={error} stopped={st['stop']}")
        if silent:
            return

        flag = lambda v: 1 if v else 0
        kind, text = dex(
            "result", lang(), flag(st["stop"]), st["found"], st["deleted"], st["unverified"], st["failed"],
            flag(st["phase"] == "recheck"), flag(st["rescan_done"]), st["left"] or 0,
            st["scan_error"] or "", error or "", flag(st["ayu_warn"]),
        ).split(SEP, 1)

        if kind == "none":
            BulletinHelper.show_info(text)
        elif kind == "error":
            self._show_copy_bulletin(text, f"[{TAG} {__version__}]\n{text}",
                                     tr("BULLETIN_ACTION_COPY_DETAILS"), tr("ERROR_DETAILS_COPIED"), "error")
        elif kind == "success":
            BulletinHelper.show_success(text)
        else:
            self._show_copy_bulletin(text, f"[{TAG} {__version__}]\n{text}",
                                     tr("BULLETIN_ACTION_COPY"), tr("RESULT_COPIED"), "info")

    def _on_menu_click(self, context):
        try:
            if self._st is not None:
                self.stop_deletion()
                return

            dialog_id = context.get("dialog_id")
            if not dialog_id:
                BulletinHelper.show_error(tr("ERROR_NO_CHAT"))
                return
            dialog_id = int(dialog_id)
            account = context.get("account")
            if account is None:
                account = client_utils.get_selected_account()

            fragment = client_utils.get_last_fragment()
            ctx = fragment.getContext() if fragment else ApplicationLoader.applicationContext
            topic_id = detect_topic(fragment, dialog_id)
            if self._flag("confirm_count", True):
                queue(lambda: self.start_deletion(account, dialog_id, topic_id, False, True))
                return

            def make_start(no_local_save):
                return lambda dialog, which: queue(
                    lambda: self.start_deletion(account, dialog_id, topic_id, no_local_save)
                )

            builder = AlertDialogBuilder(ctx, AlertDialogBuilder.ALERT_TYPE_MESSAGE)
            builder.set_title(tr("DIALOG_DELETE_TITLE"))
            builder.set_message(tr("DIALOG_QUICK_MESSAGE_TOPIC" if topic_id else "DIALOG_QUICK_MESSAGE_ALL"))
            builder.set_positive_button(tr("BUTTON_YES"), make_start(False))
            if get_ayu_state() is not None:
                builder.set_neutral_button(tr("BUTTON_YES_NO_LOCAL"), make_start(True))
            builder.set_negative_button(tr("BUTTON_CANCEL"), None)
            builder.show()
        except Exception:
            elog("menu click error")