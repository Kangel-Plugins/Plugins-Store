__id__ = "swipe_status_bar"
__name__ = "Swipe Status Bar"
__category__ = ["appearance"]
__description__ = "Скрывает и возвращает статусбар свайпом по шапке"
__author__ = "@RnPlugins"
__version__ = "1.0.0"
__build__ = 20
__icon__ = "RnDev/34"
__app_version__ = ">=12.10.1"
__sdk_version__ = ">=1.4.3.3"

import base64
import traceback
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, LocaleController
from android_utils import run_on_ui_thread
from ui.settings import Header, Switch, Text, Divider, Selector

DEX_B64 = """"""

STRINGS = {
    "ru": {
        "header_settings": "Настройки",
        "startup_title": "При запуске",
        "startup_last": "Как было",
        "startup_show": "Показан",
        "startup_hide": "Скрыт",
        "haptics_title": "Вибрация",
        "haptics_desc": "Отклик при скрытии и показе",
        "hint": "Свайп вверх по шапке прячет статусбар, свайп вниз возвращает",
        "header_author": "Об авторе",
        "author_title": "Автор",
        "author_desc": "Подробнее о разработчике",
    },
    "en": {
        "header_settings": "Settings",
        "startup_title": "On launch",
        "startup_last": "As it was",
        "startup_show": "Shown",
        "startup_hide": "Hidden",
        "haptics_title": "Vibration",
        "haptics_desc": "Feedback on hide and show",
        "hint": "Swipe up on the header to hide the status bar, swipe down to bring it back",
        "header_author": "About author",
        "author_title": "Author",
        "author_desc": "About the developer",
    },
}


def tr(key):
    try:
        lang = str(LocaleController.getInstance().getCurrentLocale().getLanguage()).lower()
        strings = STRINGS["ru"] if lang in ("ru", "uk", "be", "kk") else STRINGS["en"]
        return strings.get(key, STRINGS["en"].get(key, ""))
    except Exception:
        return STRINGS["en"].get(key, "")


class SwipeStatusBarPlugin(BasePlugin):
    def on_plugin_load(self):
        self.dex_loader = None
        self.dex_class = None
        self.author_sheet_class = None

        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            # держим ссылку на лоадер, иначе классы может собрать GC
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.swipestatusbar.SwipeStatusBar")
            self.author_sheet_class = self.dex_loader.loadClass("dev.rooni.author.AuthorBottomSheet")

            self._invoke(self.dex_class, "start")
            self.apply_settings()
            # состояние на старте: как было / показан / скрыт
            self._invoke(self.dex_class, "applyStartupMode", int(self.get_setting("startup_mode", 1)))
            run_on_ui_thread(self.check_author_promo, delay=800)
        except Exception as e:
            self.log(f"[SwipeStatusBar] Load error: {e}\n{traceback.format_exc()}")

    def on_plugin_unload(self):
        try:
            self._invoke(self.dex_class, "stop")
        except Exception as e:
            self.log(f"[SwipeStatusBar] Unload error: {e}")
        self.dex_class = None
        self.author_sheet_class = None
        self.dex_loader = None

    # статик-метод по имени и числу аргументов, без getMethod с варargs
    def _invoke(self, clazz, name, *args):
        if clazz is None:
            return None
        for m in clazz.getMethods():
            if m.getName() == name and len(m.getParameterTypes()) == len(args):
                return m.invoke(None, *args)
        return None

    def apply_settings(self, *_):
        try:
            self._invoke(self.dex_class, "updateSettings", bool(self.get_setting("enable_haptics", True)))
        except Exception as e:
            self.log(f"[SwipeStatusBar] Settings error: {e}")

    def check_author_promo(self):
        try:
            if self.get_setting("author_promo_shown", False):
                return
            if self.author_sheet_class is None:
                return
            if self._invoke(self.author_sheet_class, "isSubscribedToAuthor"):
                self.set_setting("author_promo_shown", True)
                return
            if self._invoke(self.author_sheet_class, "showFromCurrentActivity"):
                self.set_setting("author_promo_shown", True)
        except Exception as e:
            self.log(f"[SwipeStatusBar] Promo error: {e}")

    def show_author_sheet(self):
        try:
            self._invoke(self.author_sheet_class, "showFromCurrentActivity")
        except Exception as e:
            self.log(f"[SwipeStatusBar] Sheet error: {e}")

    def create_settings(self):
        return [
            Header(text=tr("header_settings")),
            Selector(
                key="startup_mode",
                text=tr("startup_title"),
                default=1,
                items=[tr("startup_last"), tr("startup_show"), tr("startup_hide")],
                icon="msg_recent",
            ),
            Switch(
                key="enable_haptics",
                text=tr("haptics_title"),
                subtext=tr("haptics_desc"),
                default=True,
                icon="msg_vibrate",
                on_change=self.apply_settings
            ),
            Divider(text=tr("hint")),
            Header(text=tr("header_author")),
            Text(
                text=tr("author_title"),
                subtext=tr("author_desc"),
                icon="msg_openprofile",
                on_click=lambda _: self.show_author_sheet()
            ),
        ]
