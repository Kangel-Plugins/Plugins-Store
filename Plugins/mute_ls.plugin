# Chaquopy requires dynamic_proxy(...) to be the first base of a class. The
# SDK's client_utils.NotificationCenterDelegate fails that check on 12.10.6
# ("dynamic_proxy must be used first in class bases"), so build it directly.
try:
    from java.chaquopy import dynamic_proxy
    NotificationCenterDelegate = dynamic_proxy(NotificationCenter.NotificationCenterDelegate)
except Exception:
    try:
        from client_utils import NotificationCenterDelegate
    except Exception:
        NotificationCenterDelegate = object


def _boxed_int(value):
    """A real java.lang.Integer for ArrayList<Integer>.

    Integer.valueOf(...) comes back to Python as a plain int, and a plain int
    added to an untyped ArrayList is boxed as java.lang.Long, which makes
    MessagesController.deleteMessages fail with
    "java.lang.Long cannot be cast to java.lang.Integer".
    """
    value = int(value)
    try:
        boxed = Integer(value)
        if not isinstance(boxed, int):
            return boxed
    except Exception:
        pass
    if jint is not None:
        return jint(value)
    return Integer(value)

