TAG = "[CDP]"
ROW_TITLE = "CollapseDrawerPlugins"
MARKER = "cdp_expand_btn"
MARKER_ROW = "cdp_icons_row"
MARKER_ICON = "cdp_icon_btn"
MARKERS = (MARKER, MARKER_ROW, MARKER_ICON)

PLUGINS_TITLES = {
    "плагины", "plugins", "плагін", "плагіни", "плагіны", "плагини", "плагиндер", "плъгини",
    "plugin", "plug-ins", "pluginy", "pluginuri", "pluginlar", "plugin-uri",
    "wtyczki", "eklentiler", "complementos", "extensões", "extensoes",
    "bővítmények", "dodaci", "įskiepiai", "spraudņi", "pistikprogrammid", "liitännäiset",
    "プラグイン", "插件", "外掛", "플러그인", "प्लगइन्स", "الإضافات", "افزونه‌ها", "תוספים",
}
STOP_TITLES = {
    "настройки", "settings", "браузер", "browser",
    "мой профиль", "my profile", "контакты", "contacts",
    "лента", "сканировать qr-код", "scan qr code",
    "создать канал", "создать группу", "избранное",
    "new channel", "new group", "saved messages",
    "налаштування", "мій профіль", "контакти", "стрічка", "відскануйте qr-код",
    "створити канал", "створити групу", "нова група", "новий канал", "збережене",
    "архів чатів", "архив чатов", "archived chats", "archive",
}
_RUNTIME_TITLES = set()

CLASS_NAMES = [
    "com.exteragram.messenger.drawer.DrawerContainer",
    "com.exteragram.messenger.drawer.DrawerMenuView",
    "com.exteragram.messenger.drawer.DrawerMenuItemView",
    "org.telegram.ui.ActionBar.DrawerLayoutContainer",
]
ITEM_TOKENS = ("DrawerMenuItemView", "DrawerActionCell")
DRAWER_TOKENS = ("DrawerContainer", "DrawerMenuView")
HOOK_METHODS = {
    "onAttachedToWindow", "addView", "onLayout", "bind",
    "setText", "setTitle", "openDrawer", "onDrawerOpened",
}

TEXT_FIELDS = ("textView", "titleView", "nameView", "text", "title", "textView1", "valueTextView")
GRAY = -7829368
LABEL_BG_FALLBACK = -232380890
BTN_DP = 40
HIDE_KEY = 0x7e00cd01
TICK_MS = 2500

_FIELD_CACHE = {}
_MISSING = object()
_LABEL = {"popup": None}


def _field(obj, name):
    try:
        cls = obj.getClass()
        key = (str(cls.getName()), name)
    except Exception:
        return None
    f = _FIELD_CACHE.get(key, _MISSING)
    if f is _MISSING:
        f = None
        c = cls
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                break
            except Exception:
                f = None
            try:
                c = c.getSuperclass()
            except Exception:
                break
        _FIELD_CACHE[key] = f
    if f is None:
        return None
    try:
        return f.get(obj)
    except Exception:
        return None


def _cid(obj) -> int:
    return int(System.identityHashCode(obj))


def _now() -> int:
    try:
        return int(System.currentTimeMillis())
    except Exception:
        return 0


def _class_name(obj) -> str:
    try:
        return str(obj.getClass().getName())
    except Exception:
        return ""


def _res(name: str) -> int:
    try:
        return int(getattr(R.drawable, name))
    except Exception:
        return 0


def _ease():
    try:
        return CubicBezierInterpolator.EASE_OUT_QUINT
    except Exception:
        return DecelerateInterpolator(1.8)


def _icon_color() -> int:
    for key in ("key_chats_menuItemIcon", "key_windowBackgroundWhiteGrayIcon"):
        try:
            return int(Theme.getColor(getattr(Theme, key)))
        except Exception:
            continue
    return GRAY


def _tint(iv):
    try:
        iv.setColorFilter(PorterDuffColorFilter(_icon_color(), PorterDuff.Mode.SRC_IN))
    except Exception:
        pass


def _set_shown(view, shown):
    try:
        view.setVisibility(View.VISIBLE if shown else View.GONE)
        view.setTag(HIDE_KEY, None if shown else "1")
    except Exception:
        pass


def _tv_text(tv) -> str:
    try:
        t = tv.getText()
        if t:
            return str(t).strip()
    except Exception:
        pass
    return ""


def _text_of(view, depth=0) -> str:
    if view is None or depth > 4:
        return ""
    try:
        if isinstance(view, TextView):
            return _tv_text(view)
        for name in TEXT_FIELDS:
            v = _field(view, name)
            if v is not None:
                s = _tv_text(v)
                if s:
                    return s
        if isinstance(view, ViewGroup):
            for i in range(min(view.getChildCount(), 20)):
                s = _text_of(view.getChildAt(i), depth + 1)
                if s:
                    return s
    except Exception:
        pass
    return ""


def _is_item_view(view) -> bool:
    cn = _class_name(view)
    return any(t in cn for t in ITEM_TOKENS)


def _is_plugins_header(text: str) -> bool:
    t = (text or "").strip().lower()
    return t in PLUGINS_TITLES or t in _RUNTIME_TITLES


def _load_runtime_titles():
    try:
        res = ApplicationLoader.applicationContext.getResources()
        cls = Class.forName("org.telegram.messenger.R$string")
        found = set()
        for f in cls.getFields():
            try:
                if "plugin" not in str(f.getName()).lower():
                    continue
                t = str(res.getString(int(f.getInt(None)))).strip().lower()
                if t and len(t) <= 24 and len(t.split()) <= 2:
                    found.add(t)
            except Exception:
                continue
        _RUNTIME_TITLES.update(found)
    except Exception as e:
        log(TAG + " titles: %s" % e)


def _is_stop_title(text: str) -> bool:
    return (text or "").strip().lower() in STOP_TITLES


def _find_ancestor(view, tokens, limit=14):
    try:
        p = view.getParent()
        for _ in range(limit):
            if p is None:
                return None
            if any(t in _class_name(p) for t in tokens):
                return p
            p = p.getParent()
    except Exception:
        pass
    return None


def _methods_of(jcls):
    for getter in ("getDeclaredMethods", "getMethods"):
        try:
            arr = getattr(jcls, getter)()
            if arr is not None:
                return list(arr)
        except Exception:
            continue
    return []


def _child_with_tag(parent, tag):
    try:
        for i in range(parent.getChildCount()):
            ch = parent.getChildAt(i)
            try:
                if ch.getTag() == tag:
                    return ch
            except Exception:
                pass
    except Exception:
        pass
    return None


def _remove_child_with_tag(parent, tag):
    if not isinstance(parent, ViewGroup):
        return
    ch = _child_with_tag(parent, tag)
    if ch is not None:
        try:
            parent.removeView(ch)
        except Exception:
            pass


def _find_icon_view(item):
    try:
        for name in ("imageView", "iconView", "icon", "image"):
            v = _field(item, name)
            if v is not None and isinstance(v, ImageView):
                return v
        found = []

        def walk(v, depth=0):
            if found or depth > 8 or v is None:
                return
            try:
                if v.getTag() in MARKERS:
                    return
            except Exception:
                pass
            if isinstance(v, ImageView):
                found.append(v)
                return
            if isinstance(v, ViewGroup):
                for i in range(v.getChildCount()):
                    walk(v.getChildAt(i), depth + 1)

        walk(item)
        return found[0] if found else None
    except Exception:
        return None


def _text_views(item):
    out = []

    def walk(v, depth=0):
        if depth > 8 or v is None:
            return
        try:
            if v.getTag() in MARKERS:
                return
        except Exception:
            pass
        if isinstance(v, TextView):
            out.append(v)
            return
        if isinstance(v, ViewGroup):
            for i in range(v.getChildCount()):
                walk(v.getChildAt(i), depth + 1)

    try:
        walk(item)
    except Exception:
        pass
    return out


def _find_icon_drawable(item):
    try:
        iv = _find_icon_view(item)
        if iv is not None:
            d = iv.getDrawable()
            if d is not None:
                return d
        for tv in _text_views(item):
            arr = tv.getCompoundDrawables()
            if arr is not None:
                for d in arr:
                    if d is not None:
                        return d
    except Exception as e:
        log(TAG + " find icon: %s" % e)
    return None


def _clone_drawable(d, ctx):
    if d is None:
        return None
    try:
        cs = d.getConstantState()
        if cs is not None:
            return cs.newDrawable(ctx.getResources()).mutate()
    except Exception:
        pass
    try:
        w = int(d.getIntrinsicWidth())
        h = int(d.getIntrinsicHeight())
        if w <= 0 or h <= 0:
            w = h = AndroidUtilities.dp(24)
        bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        old = d.copyBounds()
        d.setBounds(0, 0, w, h)
        d.draw(Canvas(bmp))
        d.setBounds(old)
        return BitmapDrawable(ctx.getResources(), bmp)
    except Exception as e:
        log(TAG + " clone drawable: %s" % e)
    return None


def _center_x_in(host, view):
    try:
        x = view.getWidth() / 2.0
        v = view
        hid = _cid(host)
        for _ in range(10):
            x += v.getLeft()
            p = v.getParent()
            if p is None:
                return None
            if _cid(p) == hid:
                return x
            v = p
    except Exception:
        pass
    return None


def _align_padding(host, icon):
    cx = _center_x_in(host, icon)
    if cx is None:
        return None
    return max(0, int(cx - AndroidUtilities.dp(BTN_DP) // 2))


def _shape_leaves(view):
    out = []

    def walk(d, depth=0):
        if d is None or depth > 6:
            return
        try:
            if isinstance(d, GradientDrawable):
                out.append(d)
            elif hasattr(d, "getNumberOfLayers"):
                for i in range(int(d.getNumberOfLayers())):
                    walk(d.getDrawable(i), depth + 1)
            elif isinstance(d, StateListDrawable):
                walk(d.getCurrent(), depth + 1)
            elif hasattr(d, "getDrawable"):
                walk(d.getDrawable(), depth + 1)
        except Exception:
            pass

    try:
        walk(view.getBackground())
        walk(view.getForeground())
    except Exception:
        pass
    return out


def _read_radii(g):
    try:
        r = g.getCornerRadii()
        if r is not None:
            return [float(x) for x in r]
    except Exception:
        pass
    return None


def _write_radii(g, radii):
    try:
        g.mutate()
        g.setCornerRadii(jarray(jfloat)(radii))
    except Exception as e:
        log(TAG + " corners: %s" % e)


def _top_radius(view):
    for g in _shape_leaves(view):
        r = _read_radii(g)
        if r is not None:
            top = max(r[0], r[2])
            if top > 0:
                return top
    return None


def _bottom_is_round(view, radius=None):
    try:
        for g in _shape_leaves(view):
            r = _read_radii(g)
            if r is None:
                continue
            want = radius if radius is not None else max(r[0], r[2])
            if min(r[4], r[6]) < want - 0.5:
                return False
    except Exception:
        pass
    return True


def _fill_params(host):
    m = ViewGroup.LayoutParams.MATCH_PARENT
    if isinstance(host, FrameLayout):
        return FrameLayout.LayoutParams(m, m)
    if isinstance(host, LinearLayout):
        return LinearLayout.LayoutParams(m, m)
    return ViewGroup.LayoutParams(m, m)


def _unstyle_host(host):
    _remove_child_with_tag(host, MARKER_ROW)
    views = _text_views(host)
    icon = _find_icon_view(host)
    if icon is not None:
        views.append(icon)
    for v in views:
        try:
            if v.getVisibility() == View.INVISIBLE:
                v.setVisibility(View.VISIBLE)
        except Exception:
            pass


def _click_item(item):
    if item is None:
        return
    try:
        if item.hasOnClickListeners():
            item.performClick()
            return
    except Exception:
        pass
    try:
        parent = item.getParent()
        pos = int(parent.getChildAdapterPosition(item))
        listener = parent.getOnItemClickListener()
        if listener is not None and pos >= 0:
            listener.onItemClick(item, pos)
            return
    except Exception:
        pass
    try:
        item.performClick()
    except Exception as e:
        log(TAG + " item click: %s" % e)


def _dismiss_label():
    p = _LABEL.get("popup")
    _LABEL["popup"] = None
    if p is not None:
        try:
            p.dismiss()
        except Exception:
            pass


def _show_label(anchor, text):
    try:
        _dismiss_label()
        ctx = anchor.getContext()
        try:
            bg_color = int(Theme.getColor(Theme.key_undo_background))
        except Exception:
            bg_color = LABEL_BG_FALLBACK
        try:
            fg_color = int(Theme.getColor(Theme.key_undo_infoColor))
        except Exception:
            fg_color = -1

        dp = AndroidUtilities.dp
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(13.0)
        tv.setTextColor(fg_color)
        tv.setSingleLine(True)
        tv.setEllipsize(TextUtils.TruncateAt.END)
        tv.setMaxWidth(dp(220))
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(dp(12), dp(7), dp(12), dp(7))
        bg = GradientDrawable()
        bg.setColor(bg_color)
        bg.setCornerRadius(float(dp(10)))
        tv.setBackground(bg)
        tv.setAlpha(0.0)

        spec = View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED)
        tv.measure(spec, spec)
        w, h = int(tv.getMeasuredWidth()), int(tv.getMeasuredHeight())

        popup = PopupWindow(tv, w, h)
        popup.setTouchable(False)
        popup.setFocusable(False)
        popup.showAsDropDown(anchor, (int(anchor.getWidth()) - w) // 2, -(int(anchor.getHeight()) + h + dp(6)))
        _LABEL["popup"] = popup
        tv.animate().alpha(1.0).setDuration(140).start()

        def hide():
            try:
                if _LABEL.get("popup") is popup:
                    tv.animate().alpha(0.0).setDuration(140).withEndAction(_Run(_dismiss_label)).start()
            except Exception:
                _dismiss_label()

        AndroidUtilities.runOnUIThread(_Run(hide), 1300)
    except Exception as e:
        log(TAG + " label: %s" % e)


class _Run(dynamic_proxy(JRunnable)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception as e:
            log(TAG + " run: %s" % e)


class _LongClick(dynamic_proxy(View.OnLongClickListener)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onLongClick(self, v):
        try:
            self._fn(v)
        except Exception as e:
            log(TAG + " long click: %s" % e)
        return True


class _Watcher(dynamic_proxy(View.OnLayoutChangeListener, ViewTreeObserver.OnPreDrawListener)):
    def __init__(self, plugin, container):
        super().__init__()
        self.plugin = plugin
        self.ref = WeakReference(container)
        self.vto = container.getViewTreeObserver()

    def onLayoutChange(self, v, left, top, right, bottom, old_left, old_top, old_right, old_bottom):
        plugin = self.plugin
        if plugin is not None:
            plugin._mark_dirty(v)

    def onPreDraw(self):
        try:
            plugin = self.plugin
            if plugin is None or not plugin._on_pre_draw(self.ref):
                self.detach()
        except Exception as e:
            log(TAG + " watcher: %s" % e)
        return True

    def detach(self):
        self.plugin = None
        try:
            container = self.ref.get()
            if container is not None:
                container.removeOnLayoutChangeListener(self)
        except Exception:
            pass
        try:
            self.vto.removeOnPreDrawListener(self)
        except Exception:
            pass


class _BindHook(MethodHook):
    def __init__(self, plugin, tag=""):
        self.plugin = plugin
        self.tag = tag

    def after_hooked_method(self, param):
        try:
            this = param.thisObject
            if this is not None:
                self.plugin._on_any_view(this, self.tag)
        except Exception as e:
            log(TAG + " hook (%s): %s" % (self.tag, e))


class _MeasureHook(MethodHook):
    def before_hooked_method(self, param):
        try:
            v = param.thisObject
            if v is not None and v.getTag(HIDE_KEY) is not None:
                v.setMeasuredDimension(View.MeasureSpec.getSize(int(param.args[0])), 0)
                param.setResult(None)
        except Exception:
            pass


class CollapseDrawerPluginsPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._active = False
        self._busy = False
        self._expanded = True
        self._icon_down = 0
        self._icon_up = 0
        self._pending = set()
        self._retrying = set()
        self._dirty = set()
        self._drawers = {}
        self._sigs = {}
        self._watchers = {}
        self._corners = {}
        self._anim_until = 0
        self._last_scan = 0
        self._trailing = False
        self._trailing_obj = None
        self.menu_item_id = None

    def on_plugin_load(self):
        self._active = True
        self.update_menu_item()
        self._expanded = bool(self.get_setting("expanded", True))
        self._icon_down = _res("msg_go_down") or _res("page_down")
        self._icon_up = _res("msg_go_up") or _res("msg_to_beginning") or self._icon_down
        self._discover_and_hook()
        threading.Thread(target=_load_runtime_titles, daemon=True).start()
        self._post(self._scan_hierarchy, 600)
        self._post(self._scan_hierarchy, 2000)
        self._post(self._tick, TICK_MS)

    def on_plugin_unload(self):
        self._active = False
        self.update_menu_item()
        drawers = [d for d in (r.get() for r in self._drawers.values()) if d is not None]
        for w in list(self._watchers.values()):
            w.detach()
        self._watchers.clear()
        self._drawers.clear()
        self._sigs.clear()
        self._pending.clear()
        self._retrying.clear()
        self._dirty.clear()
        self._trailing_obj = None
        _FIELD_CACHE.clear()
        _dismiss_label()
        if not drawers:
            self._corners.clear()
        if drawers:
            run_on_ui_thread(lambda: [self._release(d) for d in drawers])

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Режим"),
            self._switch(
                key="icons_mode",
                text="Ряд иконок",
                default=False,
                subtext="Свой пункт под «Плагины» с иконками всех плагинов",
                icon="msg_folders",
            ),
            Header(text="Сворачивание"),
            self._switch(
                key="animate",
                text="Анимация",
                default=True,
                subtext="Плавное раскрытие и сворачивание",
                icon="msg_photo_settings",
            ),
            self._switch(
                key="expanded",
                text="Открыто по умолчанию",
                default=True,
                subtext="Состояние списка при запуске приложения",
                icon="msg_expand",
                on_change=self._on_expanded_changed,
            ),
        ]

    def _switch(self, **kw):
        kw.setdefault("on_change", self._on_setting_changed)
        try:
            return Switch(**kw)
        except TypeError:
            kw.pop("on_change", None)
            return Switch(**kw)

    def _on_setting_changed(self, *args):
        def apply():
            self.update_menu_item()
            self._scan_hierarchy()

        self._post(apply, 150)
        self._post(self._scan_hierarchy, 700)

    def _on_expanded_changed(self, *args):
        value = args[0] if args and isinstance(args[0], bool) else None

        def apply():
            self._expanded = value if value is not None else bool(self.get_setting("expanded", True))
            self._scan_hierarchy()

        self._post(apply, 150)

    def _icons_mode(self) -> bool:
        return bool(self.get_setting("icons_mode", False))

    def update_menu_item(self):
        want = self._active and self._icons_mode()
        if want and self.menu_item_id is None:
            try:
                self.menu_item_id = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text=ROW_TITLE,
                    on_click=lambda _: None,
                    icon="msg_folders",
                ))
            except Exception as e:
                log(TAG + " add menu item: %s" % e)
        elif not want and self.menu_item_id is not None:
            try:
                self.remove_menu_item(self.menu_item_id)
            except Exception as e:
                log(TAG + " remove menu item: %s" % e)
            self.menu_item_id = None

    def _post(self, fn, delay_ms=0):
        def safe():
            if not self._active:
                return
            try:
                fn()
            except Exception as e:
                log(TAG + " task: %s" % e)

        try:
            ApplicationLoader.applicationHandler.postDelayed(_Run(safe), delay_ms)
        except Exception:
            run_on_ui_thread(safe)

    def _discover_and_hook(self):
        for name in CLASS_NAMES:
            short = name.split(".")[-1]
            try:
                jcls = Class.forName(name)
            except Exception:
                try:
                    jcls = find_class(name)
                except Exception:
                    continue
            for m in _methods_of(jcls):
                try:
                    mname = str(m.getName())
                    if mname == "onMeasure":
                        if short == "DrawerMenuItemView":
                            m.setAccessible(True)
                            self.hook_method(m, _MeasureHook())
                        continue
                    if mname not in HOOK_METHODS:
                        continue
                    if mname == "onLayout" and short == "DrawerLayoutContainer":
                        continue
                    m.setAccessible(True)
                    self.hook_method(m, _BindHook(self, tag=short + "#" + mname))
                except Exception:
                    pass

    def _on_any_view(self, obj, tag=""):
        if not self._active or self._busy:
            return
        cid = _cid(obj)
        if cid in self._pending:
            return
        is_drawer = "Drawer" in (tag or "") or "Drawer" in _class_name(obj)
        throttle = 60 if is_drawer else 120
        now = _now()
        if now and (now - self._last_scan) < throttle:
            self._trailing_obj = WeakReference(obj)
            if not self._trailing:
                self._trailing = True
                self._post(self._run_trailing, throttle + 30)
            return
        self._pending.add(cid)

        def ui():
            try:
                if self._active:
                    self._last_scan = _now()
                    self._try_process_from(obj)
            except Exception as e:
                log(TAG + " process: %s" % e)
            finally:
                self._pending.discard(cid)

        run_on_ui_thread(ui)

    def _run_trailing(self):
        self._trailing = False
        ref, self._trailing_obj = self._trailing_obj, None
        obj = ref.get() if ref is not None else None
        if obj is not None:
            self._last_scan = _now()
            self._try_process_from(obj)

    def _try_process_from(self, obj):
        cn = _class_name(obj)
        if any(t in cn for t in DRAWER_TOKENS):
            self._process_drawer_root(obj)
        elif "DrawerMenuItemView" in cn:
            parent = _find_ancestor(obj, DRAWER_TOKENS)
            if parent is not None:
                self._process_drawer_root(parent)
        elif "DrawerLayoutContainer" in cn:
            found = []
            self._walk_drawers(obj, found, 0, 8)
            for d in found:
                self._process_drawer_root(d)

    def _walk_drawers(self, view, out, depth, limit):
        if depth > limit or view is None:
            return
        try:
            if any(t in _class_name(view) for t in DRAWER_TOKENS):
                out.append(view)
                return
            if isinstance(view, ViewGroup):
                for i in range(view.getChildCount()):
                    self._walk_drawers(view.getChildAt(i), out, depth + 1, limit)
        except Exception:
            pass

    def _scan_hierarchy(self):
        if not self._active:
            return
        try:
            frag = get_last_fragment()
            activity = frag.getParentActivity() if frag is not None else None
            if activity is None:
                return
            root = activity.getWindow().getDecorView()
            if root is None:
                return
            drawers = []
            self._walk_drawers(root, drawers, 0, 22)
            for d in drawers:
                self._process_drawer_root(d)
        except Exception as e:
            log(TAG + " scan: %s" % e)

    def _container_has_plugins(self, container):
        try:
            for i in range(min(container.getChildCount(), 50)):
                ch = container.getChildAt(i)
                if _is_item_view(ch) and _is_plugins_header(_text_of(ch)):
                    return True
        except Exception:
            pass
        return False

    def _process_drawer_root(self, root):
        if not isinstance(root, ViewGroup):
            return
        found = []

        def walk(v, depth=0):
            if depth > 12 or not isinstance(v, ViewGroup):
                return
            try:
                if self._container_has_plugins(v):
                    found.append(v)
                    return
                for i in range(v.getChildCount()):
                    walk(v.getChildAt(i), depth + 1)
            except Exception:
                pass

        walk(root)
        for c in found:
            self._process_list_container(c)
        if not found:
            self._retry_soon(root)

    def _retry_soon(self, root, attempt=0):
        delays = (50, 100, 200, 400, 800)
        cid = _cid(root)
        if attempt >= len(delays) or (attempt == 0 and cid in self._retrying):
            self._retrying.discard(cid)
            return
        self._retrying.add(cid)
        ref = WeakReference(root)

        def again():
            target = ref.get()
            if target is None or not self._active:
                self._retrying.discard(cid)
                return
            found = []

            def walk(v, depth=0):
                if depth > 12 or not isinstance(v, ViewGroup):
                    return
                if self._container_has_plugins(v):
                    found.append(v)
                    return
                for i in range(v.getChildCount()):
                    walk(v.getChildAt(i), depth + 1)

            try:
                walk(target)
            except Exception:
                pass
            if found:
                self._retrying.discard(cid)
                for c in found:
                    self._process_list_container(c)
            else:
                self._retry_soon(target, attempt + 1)

        self._post(again, delays[attempt])

    def _tick(self):
        try:
            if not self._busy and _now() >= self._anim_until:
                attached = False
                for ref in list(self._drawers.values()):
                    c = ref.get()
                    if c is None:
                        continue
                    try:
                        if not c.isAttachedToWindow():
                            continue
                    except Exception:
                        continue
                    attached = True
                    if not self._is_consistent(c):
                        self._process_list_container(c)
                if not attached:
                    self._scan_hierarchy()
        except Exception as e:
            log(TAG + " tick: %s" % e)
        self._post(self._tick, TICK_MS)

    def _prune(self):
        alive = {k for k, r in self._drawers.items() if r.get() is not None}
        for k in list(self._watchers):
            if k not in alive:
                self._watchers.pop(k).detach()
        self._drawers = {k: r for k, r in self._drawers.items() if k in alive}
        self._sigs = {k: v for k, v in self._sigs.items() if k in alive}
        self._dirty &= alive

    def _track(self, container):
        cid = _cid(container)
        ref = self._drawers.get(cid)
        if ref is not None and ref.get() is not None:
            return
        self._prune()
        old = self._watchers.pop(cid, None)
        if old is not None:
            old.detach()
        self._drawers[cid] = WeakReference(container)
        try:
            watcher = _Watcher(self, container)
            container.addOnLayoutChangeListener(watcher)
            watcher.vto.addOnPreDrawListener(watcher)
            self._watchers[cid] = watcher
        except Exception as e:
            log(TAG + " watcher: %s" % e)

    def _mark_dirty(self, container):
        if self._active:
            self._dirty.add(_cid(container))

    def _on_pre_draw(self, ref) -> bool:
        container = ref.get()
        if container is None or not self._active:
            return False
        cid = _cid(container)
        if cid not in self._dirty:
            return True
        if self._busy:
            return True
        now = _now()
        if now and now < self._anim_until:
            return True
        self._dirty.discard(cid)
        try:
            if not self._is_consistent(container):
                self._process_list_container(container)
        except Exception as e:
            log(TAG + " fix: %s" % e)
        return True

    def _is_consistent(self, container) -> bool:
        info = self._collect(container)
        if info is None:
            return True
        header, _, items, real, host = info
        if self._icons_mode():
            if host is None or not isinstance(host, ViewGroup):
                return True
            if not real:
                return host.getVisibility() == View.GONE and _bottom_is_round(header)
            for v in items:
                if v.getVisibility() != View.GONE:
                    return False
            if host.getVisibility() != View.VISIBLE:
                return False
            holder = _child_with_tag(host, MARKER_ROW)
            if holder is None:
                return False
            if self._sigs.get(_cid(container)) != tuple(_text_of(v) for v in real):
                return False
            return (
                self._host_ok(host, holder)
                and _cid(header) not in self._corners
                and _bottom_is_round(host, _top_radius(header))
            )
        if host is not None:
            if host.getVisibility() != View.GONE or _child_with_tag(host, MARKER_ROW) is not None:
                return False
        want = View.VISIBLE if self._expanded else View.GONE
        for v in items:
            if v.getVisibility() != want:
                return False
        if isinstance(header, ViewGroup) and _child_with_tag(header, MARKER) is None:
            return False
        if self._expanded:
            return _cid(header) not in self._corners
        return _bottom_is_round(header)

    def _round_bottom(self, view, radius=None):
        try:
            leaves = _shape_leaves(view)
            if not leaves:
                return
            cid = _cid(view)
            saved = self._corners.get(cid)
            if saved is None or len(saved) != len(leaves):
                if len(self._corners) > 64:
                    self._corners.clear()
                self._corners[cid] = [_read_radii(g) for g in leaves]
            for g in leaves:
                cur = _read_radii(g)
                if cur is None:
                    continue
                r = radius if radius is not None else max(cur[0], cur[2])
                new = cur[:4] + [r, r, r, r]
                if new != cur:
                    _write_radii(g, new)
        except Exception as e:
            log(TAG + " round bottom: %s" % e)

    def _restore_corners(self, view):
        try:
            saved = self._corners.pop(_cid(view), None)
            if not saved:
                return
            leaves = _shape_leaves(view)
            if len(leaves) != len(saved):
                return
            for g, orig in zip(leaves, saved):
                if orig is not None and _read_radii(g) != orig:
                    _write_radii(g, orig)
        except Exception as e:
            log(TAG + " restore corners: %s" % e)

    def _host_ok(self, host, holder) -> bool:
        icon = _find_icon_view(host)
        if icon is None:
            return True
        if icon.getVisibility() != View.INVISIBLE:
            return False
        if int(icon.getWidth()) > 0:
            row = holder.getChildAt(0)
            want = _align_padding(host, icon)
            if row is not None and want is not None and int(row.getPaddingLeft()) != want:
                return False
        return True

    def _style_host(self, host, holder):
        icon = _find_icon_view(host)
        natives = _text_views(host)
        if icon is not None:
            natives.append(icon)
        for v in natives:
            try:
                if v.getVisibility() != View.INVISIBLE:
                    v.setVisibility(View.INVISIBLE)
            except Exception:
                pass
        if not natives:
            try:
                holder.setBackgroundColor(Theme.getColor(Theme.key_chats_menuBackground))
            except Exception:
                pass
        try:
            row = holder.getChildAt(0)
            if icon is not None and row is not None and int(icon.getWidth()) > 0:
                want = _align_padding(host, icon)
                if want is not None and int(row.getPaddingLeft()) != want:
                    row.setPadding(want, 0, int(row.getPaddingRight()), 0)
        except Exception as e:
            log(TAG + " align: %s" % e)

    def _collect(self, container):
        header = None
        header_idx = -1
        items = []
        real = []
        host = None
        try:
            for i in range(container.getChildCount()):
                ch = container.getChildAt(i)
                if ch is None:
                    continue
                try:
                    if ch.getTag() in MARKERS:
                        continue
                except Exception:
                    pass
                if header is None:
                    if _is_item_view(ch) and _is_plugins_header(_text_of(ch)):
                        header, header_idx = ch, i
                    continue
                text = _text_of(ch)
                if _is_stop_title(text):
                    break
                if _is_item_view(ch):
                    if text == ROW_TITLE:
                        host = ch
                        continue
                    items.append(ch)
                    real.append(ch)
                elif not text and _class_name(ch) == "android.view.View":
                    items.append(ch)
                    if real or host is not None:
                        break
                elif text:
                    items.append(ch)
        except Exception as e:
            log(TAG + " collect: %s" % e)
            return None
        if header is None or (not items and host is None):
            return None
        return header, header_idx, items, real, host

    def _process_list_container(self, container):
        if not isinstance(container, ViewGroup):
            return
        self._track(container)
        info = self._collect(container)
        if info is None:
            return
        header, _, items, real, host = info
        self._busy = True
        try:
            self._clear_stale_flags(container, header, items, host)
            if self._icons_mode():
                self._apply_icons_mode(container, header, items, real, host)
            else:
                self._apply_collapse_mode(container, header, items, host)
        finally:
            self._busy = False

    def _clear_stale_flags(self, container, header, items, host):
        try:
            keep = {_cid(v) for v in items}
            keep.add(_cid(header))
            if host is not None:
                keep.add(_cid(host))
            for i in range(container.getChildCount()):
                ch = container.getChildAt(i)
                if ch is not None and _cid(ch) not in keep and ch.getTag(HIDE_KEY) is not None:
                    _set_shown(ch, True)
        except Exception:
            pass

    def _apply_collapse_mode(self, container, header, items, host, animate=False):
        self._sigs.pop(_cid(container), None)
        if host is not None:
            _unstyle_host(host)
            _set_shown(host, False)
            self._restore_corners(host)
        for v in items:
            _set_shown(v, self._expanded)
        _set_shown(header, True)
        self._ensure_chevron(header, container, animate)
        if self._expanded:
            self._restore_corners(header)
        else:
            self._round_bottom(header)

    def _ensure_chevron(self, header, container, animate=False):
        if not isinstance(header, ViewGroup):
            return
        existing = _child_with_tag(header, MARKER)
        if existing is not None:
            self._apply_icon(existing, self._expanded, animate)
            return

        btn = ImageView(header.getContext())
        btn.setScaleType(ImageView.ScaleType.CENTER)
        btn.setTag(MARKER)
        self._apply_icon(btn, self._expanded)
        try:
            btn.setBackground(Theme.createSelectorDrawable(
                Theme.getColor(Theme.key_listSelector), 1, AndroidUtilities.dp(14)
            ))
        except Exception:
            pass
        btn.setClickable(True)
        btn.setFocusable(True)
        ref = WeakReference(container)
        btn.setOnClickListener(OnClickListener(lambda v, r=ref: self._on_chevron_click(v, r.get())))

        try:
            size = AndroidUtilities.dp(28)
            if isinstance(header, FrameLayout):
                lp = FrameLayout.LayoutParams(size, size)
                lp.gravity = Gravity.CENTER_VERTICAL | Gravity.END
                lp.rightMargin = AndroidUtilities.dp(12)
            else:
                lp = LinearLayout.LayoutParams(size, size)
                lp.gravity = Gravity.CENTER_VERTICAL
                lp.leftMargin = AndroidUtilities.dp(4)
                lp.rightMargin = AndroidUtilities.dp(8)
            header.addView(btn, lp)
        except Exception as e:
            log(TAG + " add chevron: %s" % e)

    def _on_chevron_click(self, v, container):
        if container is None:
            return
        try:
            info = self._collect(container)
            if info is None:
                return
            header, _, items, _real, host = info
            animate = bool(self.get_setting("animate", True))
            self._expanded = not self._expanded
            self._busy = True
            try:
                if animate:
                    self._anim_until = _now() + 450
                    self._begin_transition(
                        container,
                        items if self._expanded else [],
                        [] if self._expanded else items,
                    )
                self._apply_collapse_mode(container, header, items, host, animate)
            finally:
                self._busy = False
            ref = WeakReference(container)
            self._post(lambda: self._settle(ref), 520)
        except Exception as e:
            log(TAG + " chevron click: %s" % e)

    def _settle(self, ref):
        container = ref.get()
        if container is None:
            return
        if not self._is_consistent(container):
            self._process_list_container(container)

    def _apply_icons_mode(self, container, header, items, real, host):
        _remove_child_with_tag(header, MARKER)
        _set_shown(header, True)

        if host is None or not isinstance(host, ViewGroup):
            for v in items:
                _set_shown(v, True)
            self._restore_corners(header)
            self.update_menu_item()
            return

        cid = _cid(container)
        if not real:
            _remove_child_with_tag(host, MARKER_ROW)
            self._sigs.pop(cid, None)
            _set_shown(host, False)
            self._restore_corners(host)
            self._round_bottom(header)
            return

        for v in items:
            _set_shown(v, False)
        _set_shown(host, True)
        self._restore_corners(header)
        self._round_bottom(host, _top_radius(header))

        sig = tuple(_text_of(v) for v in real)
        existing = _child_with_tag(host, MARKER_ROW)
        if existing is not None:
            if self._sigs.get(cid) == sig:
                self._style_host(host, existing)
                return
            try:
                host.removeView(existing)
            except Exception:
                pass

        ctx = container.getContext()
        btn_size = AndroidUtilities.dp(BTN_DP)
        glyph_pad = AndroidUtilities.dp(8)
        gap = AndroidUtilities.dp(4)

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(AndroidUtilities.dp(11), 0, AndroidUtilities.dp(11), 0)

        for item, title in zip(real, sig):
            btn = ImageView(ctx)
            btn.setTag(MARKER_ICON)
            btn.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            btn.setPadding(glyph_pad, glyph_pad, glyph_pad, glyph_pad)
            btn.setClickable(True)
            btn.setFocusable(True)
            try:
                btn.setBackground(Theme.createSelectorDrawable(
                    Theme.getColor(Theme.key_listSelector), 1, AndroidUtilities.dp(20)
                ))
            except Exception:
                pass

            drawable = _clone_drawable(_find_icon_drawable(item), ctx)
            try:
                if drawable is not None:
                    btn.setImageDrawable(drawable)
                else:
                    fallback = _res("msg_info") or _res("ic_ab_other")
                    if fallback:
                        btn.setImageResource(fallback)
                _tint(btn)
            except Exception as e:
                log(TAG + " set icon: %s" % e)

            if title:
                try:
                    btn.setContentDescription(title)
                except Exception:
                    pass
                btn.setOnLongClickListener(_LongClick(lambda v, t=title: _show_label(v, t)))

            ref = WeakReference(item)
            btn.setOnClickListener(OnClickListener(lambda v, r=ref: _click_item(r.get())))
            lp = LinearLayout.LayoutParams(btn_size, btn_size)
            lp.rightMargin = gap
            row.addView(btn, lp)

        holder = HorizontalScrollView(ctx)
        holder.setTag(MARKER_ROW)
        holder.setHorizontalScrollBarEnabled(False)
        holder.setOverScrollMode(View.OVER_SCROLL_NEVER)
        holder.addView(row, FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.WRAP_CONTENT,
            FrameLayout.LayoutParams.MATCH_PARENT,
        ))
        try:
            host.addView(holder, _fill_params(host))
            self._sigs[cid] = sig
            self._style_host(host, holder)
            host.requestLayout()
        except Exception as e:
            log(TAG + " add icons row: %s" % e)

    def _set_icon(self, iv, expanded):
        res = self._icon_up if expanded else self._icon_down
        if not res:
            return
        try:
            iv.setImageResource(res)
            iv.setSelected(expanded)
            _tint(iv)
        except Exception as e:
            log(TAG + " icon: %s" % e)

    def _apply_icon(self, iv, expanded, animate=False):
        try:
            if iv.isSelected() == expanded and iv.getDrawable() is not None:
                if iv.getAlpha() < 1.0 or iv.getScaleX() < 1.0:
                    iv.animate().cancel()
                    iv.setScaleX(1.0)
                    iv.setScaleY(1.0)
                    iv.setAlpha(1.0)
                return
            iv.animate().cancel()
            iv.setSelected(expanded)
            if not animate:
                iv.setScaleX(1.0)
                iv.setScaleY(1.0)
                iv.setAlpha(1.0)
                self._set_icon(iv, expanded)
                return

            ref = WeakReference(iv)

            def swap():
                view = ref.get()
                if view is None:
                    return
                self._set_icon(view, expanded)
                view.animate().scaleX(1.0).scaleY(1.0).alpha(1.0).setDuration(170).setInterpolator(_ease()).start()

            iv.animate().scaleX(0.65).scaleY(0.65).alpha(0.45).setDuration(110).withEndAction(_Run(swap)).start()
        except Exception as e:
            log(TAG + " icon anim: %s" % e)

    def _begin_transition(self, container, show, hide):
        try:
            ease = _ease()
            ts = TransitionSet()
            ts.setOrdering(TransitionSet.ORDERING_TOGETHER)
            try:
                ts.excludeTarget(ImageView, True)
            except Exception:
                pass
            bounds = ChangeBounds()
            bounds.setDuration(320)
            bounds.setInterpolator(ease)
            ts.addTransition(bounds)
            if show:
                fade_in = Fade(Fade.IN)
                fade_in.setDuration(240)
                fade_in.setStartDelay(90)
                fade_in.setInterpolator(ease)
                for v in show:
                    fade_in.addTarget(v)
                ts.addTransition(fade_in)
            if hide:
                fade_out = Fade(Fade.OUT)
                fade_out.setDuration(140)
                fade_out.setInterpolator(ease)
                for v in hide:
                    fade_out.addTarget(v)
                ts.addTransition(fade_out)
            TransitionManager.beginDelayedTransition(container, ts)
        except Exception:
            try:
                t = AutoTransition()
                t.setDuration(280)
                TransitionManager.beginDelayedTransition(container, t)
            except Exception as e:
                log(TAG + " transition: %s" % e)

    def _release(self, container):
        try:
            info = self._collect(container)
            if info is not None:
                header, _, items, _real, host = info
                for v in items:
                    _set_shown(v, True)
                _set_shown(header, True)
                _remove_child_with_tag(header, MARKER)
                self._restore_corners(header)
                if host is not None:
                    _unstyle_host(host)
                    _set_shown(host, False)
                    self._restore_corners(host)
        except Exception as e:
            log(TAG + " release: %s" % e)
