import base64
import json
import traceback
import zlib

from java import jclass

from org.telegram.messenger import ApplicationLoader, LocaleController

from base_plugin import BasePlugin
from android_utils import run_on_ui_thread
from ui.settings import Divider, Header, Switch, Text

__id__ = "custom_recent_reactions"
__name__ = "Custom Recent Reactions"
__description__ = "Replace the recent reactions in the message reaction panel with your own set."
__author__ = "@itNotMax - @MaxExteraPlugins"
__version__ = "3.0"
__icon__ = "MaxExteraPluginsStickers/25"
__min_version__ = "12.10.6"
__app_version__ = ">=12.10.6"

DEFAULT_EMOJI = "\U0001F44D \U0001F44E \u2764 \U0001F525 \U0001F389 \U0001F631 \U0001F622"
PREFS_NAME = "custom_recent_reactions_prefs"
ENTRY_CLASS = "com.exteraplugins.custom_recent_reactions.Main"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"


def _prefs():
    return ApplicationLoader.applicationContext.getSharedPreferences(PREFS_NAME, 0)


def _load_reactions():
    try:
        raw = _prefs().getString("reactions", None)
        if raw:
            items = json.loads(raw)
            if isinstance(items, list) and items:
                return [str(x) for x in items]
    except Exception:
        pass
    return list(DEFAULT_EMOJI.split())


def _save_reactions(items):
    try:
        _prefs().edit().putString("reactions", json.dumps(items)).apply()
    except Exception:
        pass


def _is_ru():
    """App language is Russian (falls back to the system locale)."""
    try:
        loc = LocaleController.getInstance().getCurrentLocale()
        if loc is not None and str(loc.getLanguage()) == "ru":
            return True
    except Exception:
        pass
    try:
        from java.util import Locale
        loc = Locale.getDefault()
        return loc is not None and str(loc.getLanguage()) == "ru"
    except Exception:
        return False


def _make_tr(ru):
    def t(en, ru_text):
        return ru_text if ru else en
    return t


class Dex:
    """Loads the embedded DEX module and exposes its static methods.

    Methods are keyed by (name, argc) so overloads like load() /
    load(Context) never collide.
    """

    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False
        self._m = {}

    def load(self):
        if self.loaded:
            return True
        if self.clazz is None:
            ctx = ApplicationLoader.applicationContext
            if not ctx:
                raise RuntimeError("no application context")
            data = self._read_payload()
            loader_cls = jclass("dalvik.system.InMemoryDexClassLoader")
            buf = jclass("java.nio.ByteBuffer").wrap(data)
            self.clazz = loader_cls(buf, ctx.getClassLoader()).loadClass(self.entry_class)
            for m in self.clazz.getDeclaredMethods():
                m.setAccessible(True)
                self._m[(str(m.getName()), len(m.getParameterTypes()))] = m
        method = self._m.get(("load", 0))
        if method is None:
            raise RuntimeError("load() not found in dex module")
        method.invoke(None)
        self.loaded = True
        return True

    def unload(self):
        try:
            if self.loaded:
                method = self._m.get(("unload", 0))
                if method is not None:
                    method.invoke(None)
        except Exception:
            pass
        self.loaded = False

    def call(self, name, *args):
        if not self.loaded:
            return None
        method = self._m.get((name, len(args)))
        if method is None:
            return None
        return method.invoke(None, *args)

    def _read_payload(self):
        with open(__file__, "r", encoding="utf-8") as f:
            text = f.read()
        body = text.split("# " + DEX_BEGIN, 1)[1].split("# " + DEX_END, 1)[0]
        payload = "".join(
            line.strip()[1:].strip()
            for line in body.splitlines()
            if line.strip().startswith("#")
        )
        if not payload:
            raise RuntimeError("embedded dex payload is empty")
        return zlib.decompress(base64.b64decode(payload))


class CustomRecentReactions(BasePlugin):

    def on_plugin_load(self):
        self.dex = Dex(ENTRY_CLASS)
        # The dex module guards itself against a second copy (engine
        # auto-load) via a system property; either way load() is safe.
        try:
            self.dex.load()
        except Exception:
            self.log("dex load failed:\n" + traceback.format_exc())
        self._push_config()

    def on_plugin_unload(self):
        try:
            if getattr(self, "dex", None):
                self.dex.unload()
        except Exception:
            pass

    # ------------------------------------------------------------------
    # config bridge
    # ------------------------------------------------------------------

    def _setting(self, key, default):
        try:
            return bool(self.get_setting(key, default))
        except Exception:
            pass
        try:
            return bool(_prefs().getBoolean(key, default))
        except Exception:
            return default

    def _push_config(self):
        if not getattr(self, "dex", None) or not self.dex.loaded:
            return
        try:
            cfg = {
                "enabled": self._setting("enabled", True),
                "extra_row": self._setting("extra_row", False),
                "show_standard": self._setting("show_standard", True),
                "reactions": _load_reactions(),
            }
            self.dex.call("pyUpdateConfig", json.dumps(cfg))
        except Exception:
            self.log("push config failed:\n" + traceback.format_exc())

    # ------------------------------------------------------------------
    # settings callbacks
    # ------------------------------------------------------------------

    def _on_enabled_change(self, value):
        _prefs().edit().putBoolean("enabled", bool(value)).apply()
        self._push_config()

    def _on_extra_row_change(self, value):
        _prefs().edit().putBoolean("extra_row", bool(value)).apply()
        self._push_config()

    def _on_show_standard_change(self, value):
        _prefs().edit().putBoolean("show_standard", bool(value)).apply()
        self._push_config()

    def _on_pick_click(self, view):
        try:
            ctx = view.getContext()
            run_on_ui_thread(lambda: self._open_picker(ctx))
        except Exception:
            self.log("pick click failed:\n" + traceback.format_exc())

    def _open_picker(self, ctx):
        if not getattr(self, "dex", None) or not self.dex.loaded:
            self.log("dex module is not loaded, cannot open picker")
            return
        try:
            self.dex.call("pyShowPicker", ctx)
        except Exception:
            self.log("open picker failed:\n" + traceback.format_exc())

    def _on_reset_click(self, view):
        _save_reactions(list(DEFAULT_EMOJI.split()))
        self._push_config()

    def create_settings(self):
        ru = _is_ru()
        t = _make_tr(ru)
        return [
            Header(text=t("Custom Recent Reactions",
                          "Свои недавние реакции")),
            Switch(
                key="enabled",
                text=t("Enable Custom Reactions",
                       "Включить свои реакции"),
                default=True,
                subtext=t("Replace the recent reactions in the quick panel with your custom set",
                          "Заменяет недавние реакции в быстрой панели вашим набором"),
                on_change=self._on_enabled_change,
            ),
            Divider(),
            Text(
                text=t("Choose reactions",
                       "Выбрать реакции"),
                icon="msg_emoji_smiles",
                on_click=self._on_pick_click,
            ),
            Divider(),
            Switch(
                key="extra_row",
                text=t("Show one more row of reactions",
                       "Показать ещё один ряд реакций"),
                default=False,
                subtext=t("Show up to 14 reactions in the panel instead of 7",
                          "До 14 реакций в панели вместо 7"),
                on_change=self._on_extra_row_change,
            ),
            Divider(),
            Switch(
                key="show_standard",
                text=t("Show standard reactions in the recent list",
                       "Показывать стандартные реакции в списке"),
                default=True,
                subtext=t("Append all standard reactions after your custom set",
                          "Добавляет все стандартные реакции после вашего набора"),
                on_change=self._on_show_standard_change,
            ),
            Divider(),
            Text(
                text=t("Reset to defaults",
                       "Сбросить к стандартным"),
                icon="msg_reset",
                red=True,
                on_click=self._on_reset_click,
            ),
            Divider(text=t("Tap an emoji to insert it at the cursor. Tap a preview item to move the cursor, long-press it to remove.",
                           "Нажмите на эмодзи, чтобы вставить его в позицию курсора. Нажмите на элемент превью, чтобы переместить курсор; удерживайте, чтобы удалить.")),
        ]


