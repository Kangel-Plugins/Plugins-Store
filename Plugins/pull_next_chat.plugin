                subtext=tr("Очистить временный список недавно посещённых чатов", "Clear recently visited chats list"),
                on_click=self._reset_chain,
            ),
            Text(
                text=tr("Проверить состояние", "Check status"),
                subtext=tr("Показать подключённые хуки, память и ошибки", "Show hooks, memory tracking and recent errors"),
                on_click=self._show_status,
            ),
        ]

    def _reset_chain(self, *_):
        self._cfg_cache = (0.0, None)
        with self._lock:
            self._jump_chain.clear()
        if BulletinHelper is not None:
            try:
                BulletinHelper.show_success(tr("История переходов очищена", "Jump history cleared"))
            except Exception:
                pass

    def _show_status(self, *_):
        self._cfg_cache = (0.0, None)
        cfg = self._cfg()
        self._prune_refs()
        sens_str = _format_mult(cfg["sensitivity_mult"])
        if cfg["anti_accidental"]:
            sens_str += tr(" + защита 32dp", " + 32dp guard")
        with self._lock:
            hooks = ", ".join(("✓ " if ok else "✗ ") + name for name, ok in self._status.items()) or "—"
            live_frags = sum(len(b) for b in self._managers.values())
            live_picks = sum(len(b) for b in self._picks.values())
            jumps = self._jump_count
            chain_sz = sum(len(v) for v in self._jump_chain.values())
            errs = list(self._errors[-4:])

        lines = [
            f"Pull to Next Chat v{__version__} ({__author__})",
            tr(f"Хуки: {hooks}", f"Hooks: {hooks}"),
            tr(f"Чувствительность: {sens_str}", f"Sensitivity: {sens_str}"),
            tr(
                f"Активных чатов в памяти: {live_frags} | Кэш drawable: {live_picks}",
                f"Tracked active chats: {live_frags} | Drawable cache: {live_picks}",
            ),
            tr(
                f"Переходов за сессию: {jumps} | В анти-цикле: {chain_sz}",
                f"Jumps this session: {jumps} | Anti-loop entries: {chain_sz}",
            ),
            tr(
                "Ошибки: " + ("нет" if not errs else "\n" + "\n".join(errs)),
                "Errors: " + ("none" if not errs else "\n" + "\n".join(errs)),
            ),
        ]
        msg = "\n\n".join(lines)

        try:
            if AlertDialogBuilder is not None:
                from client_utils import get_last_fragment
                frag = get_last_fragment()
                act = frag.getParentActivity() if frag is not None else None
                if act is not None:
                    AlertDialogBuilder(act).set_title("Pull to Next Chat v" + __version__).set_message(msg).set_positive_button("OK", lambda b, _: b.dismiss()).show()
                    return
        except Exception:
            pass

        if BulletinHelper is not None:
            for name in ("show_info", "show_success"):
                fn = getattr(BulletinHelper, name, None)
                if fn is not None:
                    try:
                        fn(hooks + ("\n" + errs[-1] if errs else ""))
                        return
                    except Exception:
                        pass
        self._log("status: " + hooks)

    # ------------------------------------------------------------------ reflection & collision-safe weak caches

    @staticmethod
    def _evict_quarter(cache_dict):
        if len(cache_dict) >= MAX_REFLECT_CACHE:
            drop_n = max(1, MAX_REFLECT_CACHE // 4)
            for k in list(cache_dict.keys())[:drop_n]:
                cache_dict.pop(k, None)

    def _field_opt(self, owner_class, name):
        """Bounded cached reflection lookup (caches misses via _MISSING; evicts oldest quarter on cap)."""
        key = (str(owner_class.getName()), name)
        with self._lock:
            field = self._fields.get(key)
        if field is _MISSING:
            return None
        if field is None:
            cls = owner_class
            while cls is not None:
                try:
                    field = cls.getDeclaredField(name)
                    break
                except Exception:
                    cls = cls.getSuperclass()
            with self._lock:
                self._evict_quarter(self._fields)
                if field is None:
                    self._fields[key] = _MISSING
                    return None
                field.setAccessible(True)
                self._fields[key] = field
        return field

    def _field(self, owner_class, name):
        field = self._field_opt(owner_class, name)
        if field is None:
            raise AttributeError(name)
        return field

    def _method(self, owner_class, name, *arg_types):
        key = (str(owner_class.getName()), name, tuple(str(t.getName()) for t in arg_types))
        with self._lock:
            method = self._methods.get(key)
        if method is None:
            cls = owner_class
            while cls is not None:
                try:
                    method = cls.getDeclaredMethod(name, *arg_types)
                    break
                except Exception:
                    cls = cls.getSuperclass()
            if method is None:
                raise AttributeError(name)
            method.setAccessible(True)
            with self._lock:
                self._evict_quarter(self._methods)
                self._methods[key] = method
        return method

    def _get(self, obj, name):
        return self._field(obj.getClass(), name).get(obj)

    def _get_opt(self, obj, name):
        field = self._field_opt(obj.getClass(), name)
        return field.get(obj) if field is not None else None

    def _chat_field(self, fragment, cached_field, name):
        if cached_field is not None:
            return cached_field
        return self._field(fragment.getClass(), name)

    def _chat_field_opt(self, fragment, cached_field, name):
        if cached_field is not None:
            return cached_field
        return self._field_opt(fragment.getClass(), name)

    def _hash(self, obj):
        return int(self._System.identityHashCode(obj))

    @staticmethod
    def _same(a, b):
        """Real identity check (safe against 32-bit identityHashCode collisions)."""
        if a is None or b is None:
            return False
        try:
            return bool(a.equals(b))
        except Exception:
            return a is b

    def _weak(self, obj):
        return self._WeakRef(obj)

    def _prune_refs(self):
        now = time.monotonic()
        with self._lock:
            for k in list(self._managers.keys()):
                alive = [e for e in self._managers[k] if e[_E_MGR].get() is not None and e[_E_FRAG].get() is not None]
                if alive:
                    self._managers[k] = alive
                else:
                    self._managers.pop(k, None)
            for k in list(self._picks.keys()):
                alive = [e for e in self._picks[k] if e[0].get() is not None]
                if alive:
                    self._picks[k] = alive
                else:
                    self._picks.pop(k, None)
            for k in list(self._suppressed.keys()):
                alive = [e for e in self._suppressed[k] if e[0].get() is not None and e[1] > now]
                if alive:
                    self._suppressed[k] = alive
                else:
                    self._suppressed.pop(k, None)

    def _mark_drawable_suppressed(self, drawable, ttl=UPDATE_SUPPRESS_TTL_SEC):
        if drawable is None:
            return
        dh = self._hash(drawable)
        exp = time.monotonic() + ttl
        with self._lock:
            bucket = self._suppressed.get(dh, [])
            kept = []
            for dr, ts in bucket:
                obj = dr.get()
                if obj is not None and not self._same(obj, drawable):
                    kept.append((dr, ts))
            kept.append((self._weak(drawable), exp))
            self._suppressed[dh] = kept

    def _clear_drawable_suppressed(self, drawable):
        if drawable is None:
            return
        dh = self._hash(drawable)
        with self._lock:
            bucket = self._suppressed.get(dh)
            if not bucket:
                return
            kept = []
            for dr, ts in bucket:
                obj = dr.get()
                if obj is not None and not self._same(obj, drawable):
                    kept.append((dr, ts))
            if kept:
                self._suppressed[dh] = kept
            else:
                self._suppressed.pop(dh, None)

    def _is_drawable_suppressed(self, drawable, refresh=True):
        if drawable is None:
            return False
        dh = self._hash(drawable)
        now = time.monotonic()
        with self._lock:
            bucket = self._suppressed.get(dh)
            if not bucket:
                return False
            matched = False
            kept = []
            for dr, exp in bucket:
                obj = dr.get()
                if obj is None or exp <= now:
                    continue
                if self._same(obj, drawable):
                    matched = True
                    kept.append((dr, (now + UPDATE_SUPPRESS_TTL_SEC) if refresh else exp))
                else:
                    kept.append((dr, exp))
            if kept:
                self._suppressed[dh] = kept
            else:
                self._suppressed.pop(dh, None)
            return matched

    def _set_pick(self, drawable, pick_data):
        if drawable is None:
            with self._lock:
                self._last_pick_fallback = pick_data
            return
        dh = self._hash(drawable)
        with self._lock:
            bucket = self._picks.get(dh, [])
            kept = []
            for dr, data in bucket:
                obj = dr.get()
                if obj is not None and not self._same(obj, drawable):
                    kept.append((dr, data))
            if pick_data is not None:
                kept.append((self._weak(drawable), pick_data))
            if kept:
                self._picks[dh] = kept
            else:
                self._picks.pop(dh, None)
            if len(self._picks) > 12:
                for k in list(self._picks.keys()):
                    alive = [e for e in self._picks[k] if e[0].get() is not None]
                    if alive:
                        self._picks[k] = alive
                    else:
                        self._picks.pop(k, None)

    def _get_pick(self, drawable):
        if drawable is None:
            return None
        dh = self._hash(drawable)
        with self._lock:
            bucket = self._picks.get(dh)
            if not bucket:
                return None
            if len(bucket) == 1:
                dr, data = bucket[0]
                ref_obj = dr.get()
                return data if (ref_obj is not None and self._same(ref_obj, drawable)) else None
            snapshot = list(bucket)
        for dr, data in snapshot:
            ref_obj = dr.get()
            if ref_obj is not None and self._same(ref_obj, drawable):
                return data
        return None

    def _begin_update(self, param):
        if not self._cfg()["enabled"]:
            return
        drawable = param.thisObject
        if drawable is not None and self._is_drawable_suppressed(drawable, refresh=True):
            # Prevent 60-120Hz updateDialog() storm while suppressed (channel deadzone or src_channel=False)
            param.setResult(None)
            return
        with self._lock:
            self._updating_until = time.monotonic() + 1.5
            self._updating_drawable_ref = self._weak(drawable) if drawable is not None else None
            self._last_pick_fallback = None
        if drawable is not None:
            self._set_pick(drawable, None)

    def _end_update(self, drawable):
        with self._lock:
            self._updating_until = 0.0
            self._updating_drawable_ref = None

    # ------------------------------------------------------------------ anti-ping-pong jump chain

    def _record_jump(self, account, did, anti_ping_pong):
        now = time.monotonic()
        with self._lock:
            self._jump_count += 1
            if not anti_ping_pong or did == 0:
                return
            bucket = self._jump_chain.setdefault(account, {})
            bucket[int(did)] = now
            expired = [k for k, ts in bucket.items() if now - ts > CHAIN_TTL_SEC]
            for k in expired:
                bucket.pop(k, None)
            if len(bucket) > MAX_CHAIN_SIZE:
                oldest = sorted(bucket.items(), key=lambda kv: kv[1])[: len(bucket) - MAX_CHAIN_SIZE]
                for k, _ in oldest:
                    bucket.pop(k, None)

    def _visited_set(self, account):
        now = time.monotonic()
        with self._lock:
            bucket = self._jump_chain.get(account)
            if not bucket:
                return set()
            expired = [k for k, ts in bucket.items() if now - ts > CHAIN_TTL_SEC]
            for k in expired:
                bucket.pop(k, None)
            return set(bucket.keys())

    # ------------------------------------------------------------------ account resolution

    def _account_of(self, obj=None):
        """Read exact currentAccount from ChatActivity or ChatPullingDownDrawable (multi-account safe)."""
        if obj is not None:
            try:
                if hasattr(obj, "getCurrentAccount"):
                    return int(obj.getCurrentAccount())
            except Exception:
                pass
            try:
                f = self._field_opt(obj.getClass(), "currentAccount")
                if f is not None:
                    return int(f.getInt(obj))
            except Exception:
                pass
        return int(self._UserConfig.selectedAccount)

    def _controller(self, account=None):
        acc = self._account_of() if account is None else int(account)
        return self._MessagesController.getInstance(acc)

    # ------------------------------------------------------------------ fragments and scrolling

    def _scan_open_fragments(self):
        if not self._active:
            return
        try:
            from client_utils import get_last_fragment
            last = get_last_fragment()
            if last is None:
                return
            candidates = []

            def add_unique(frag):
                if frag is None:
                    return
                for existing in candidates:
                    if self._same(existing, frag):
                        return
                candidates.append(frag)

            try:
                layout = last.getParentLayout()
                stack = layout.getFragmentStack() if layout is not None else None
                if stack is not None:
                    for frag in JavaList(stack):
                        add_unique(frag)
            except Exception:
                pass
            add_unique(last)
            for fragment in candidates:
                if self._chat_activity is not None and self._chat_activity.isInstance(fragment):
                    self._register(fragment)
        except Exception as error:
            self._log("scan: " + type(error).__name__)

    def _after_create(self, param):
        self._register(param.thisObject)

    def _before_destroy(self, fragment):
        if fragment is None:
            return
        try:
            df = self._chat_field_opt(fragment, self._f_drawable, "pullingDownDrawable")
            drawable = df.get(fragment) if df is not None else None
            if drawable is not None:
                self._set_pick(drawable, None)
                self._clear_drawable_suppressed(drawable)
        except Exception:
            pass
        with self._lock:
            for k in list(self._managers.keys()):
                kept = []
                for entry in self._managers[k]:
                    m_obj, f_obj = entry[_E_MGR].get(), entry[_E_FRAG].get()
                    if m_obj is not None and f_obj is not None and not self._same(f_obj, fragment):
                        kept.append(entry)
                if kept:
                    self._managers[k] = kept
                else:
                    self._managers.pop(k, None)

    def _compute_static_pull_ok(self, fragment):
        try:
            mf = self._chat_field(fragment, self._f_chat_mode, "chatMode")
            if int(mf.getInt(fragment)) != 0:
                return False
            tf = self._chat_field(fragment, self._f_thread_id, "threadMessageId")
            if int(tf.getLong(fragment)) != 0:
                return False
            return True
        except Exception:
            return False

    def _register(self, fragment):
        manager = self._get_opt(fragment, "chatLayoutManager")
        if manager is None:
            return
        self._prune_refs()
        mh = self._hash(manager)
        cached_kind = self._fragment_kind_cached_init(fragment)
        static_ok = self._compute_static_pull_ok(fragment) if cached_kind is not _UNSET else _UNSET
        with self._lock:
            # Remove any stale entry for EITHER the same manager OR the same fragment (e.g. recreated View!)
            for k in list(self._managers.keys()):
                kept = []
                for entry in self._managers[k]:
                    m_obj, f_obj = entry[_E_MGR].get(), entry[_E_FRAG].get()
                    if m_obj is None or f_obj is None:
                        continue
                    if self._same(m_obj, manager) or self._same(f_obj, fragment):
                        continue
                    kept.append(entry)
                if kept:
                    self._managers[k] = kept
                else:
                    self._managers.pop(k, None)

            new_entry = [self._weak(manager), self._weak(fragment), cached_kind, 0.0, 0.0, 0.0, False, False, static_ok]
            self._managers.setdefault(mh, []).append(new_entry)
        self._hook_scroll(manager.getClass())

    def _hook_scroll(self, cls):
        name = str(cls.getName())
        with self._lock:
            if name in self._scroll_hooked or name in self._scroll_failed:
                return
        for method in cls.getDeclaredMethods():
            if str(method.getName()) == "scrollVerticallyBy" and len(method.getParameterTypes()) == 3:
                try:
                    self._install(method, "scroll", "scrollVerticallyBy")
                except Exception as error:
                    with self._lock:
                        self._scroll_failed.add(name)
                        self._status["scrollVerticallyBy"] = False
                    self._log("scroll hook failed: " + type(error).__name__ + ": " + str(error))
                    return
                with self._lock:
                    self._scroll_hooked.add(name)
                return
        with self._lock:
            self._scroll_failed.add(name)
            self._status["scrollVerticallyBy"] = False
        self._log("scrollVerticallyBy is not declared by " + name)

    def _entry_for(self, manager):
        """Returns (fragment, kind, entry_list) with zero list-copy allocation on the common 1-item bucket."""
        key = self._hash(manager)
        with self._lock:
            bucket = self._managers.get(key)
            if not bucket:
                return None, None, None
            if len(bucket) == 1:
                entry = bucket[0]
                mgr_obj = entry[_E_MGR].get()
                if mgr_obj is None or not self._same(mgr_obj, manager):
                    return None, None, None
                frag = entry[_E_FRAG].get()
                if frag is None:
                    self._managers.pop(key, None)
                    return None, None, None
            else:
                entry = None
                frag = None
                for e in bucket:
                    mgr_obj = e[_E_MGR].get()
                    if mgr_obj is not None and self._same(mgr_obj, manager):
                        entry = e
                        frag = e[_E_FRAG].get()
                        break
                if entry is None:
                    return None, None, None
                if frag is None:
                    self._prune_refs()
                    return None, None, None

        kind = entry[_E_KIND]
        if kind is _UNSET:
            kind = self._fragment_kind_cached_init(frag)
            entry[_E_KIND] = kind
            if kind is not _UNSET and entry[_E_STATIC_OK] is _UNSET:
                entry[_E_STATIC_OK] = self._compute_static_pull_ok(frag)
        return frag, (None if kind is _UNSET else kind), entry

    def _fragment_for(self, manager):
        frag, _, _ = self._entry_for(manager)
        return frag

    def _fragment_kind_cached_init(self, fragment):
        """Returns chat kind, None (permanently unsupported like Saved/Secret/777000), or _UNSET if not yet bound."""
        try:
            if bool(fragment.isTopic):
                return "forum"
        except Exception:
            pass
        ef = self._chat_field_opt(fragment, self._f_cur_enc_chat, "currentEncryptedChat")
        if ef is not None and ef.get(fragment) is not None:
            return None
        uf = self._chat_field_opt(fragment, self._f_cur_user, "currentUser")
        cf = self._chat_field_opt(fragment, self._f_cur_chat, "currentChat")
        user = uf.get(fragment) if uf is not None else None
        chat = cf.get(fragment) if cf is not None else None
        if user is not None:
            if int(user.id) == 777000 or self._is_self(user):
                return None
            return "bot" if bool(user.bot) else "private"
        if chat is not None:
            if bool(getattr(chat, "forum", False)):
                return "forum"
            return "channel" if bool(self._ChatObject.isChannelAndNotMegaGroup(chat)) else "group"
        return _UNSET

    def _fragment_kind(self, fragment):
        kind = self._fragment_kind_cached_init(fragment)
        return None if kind is _UNSET else kind

    def _is_self(self, user):
        try:
            return bool(self._UserObject.isUserSelf(user))
        except Exception:
            return False

    def _pull_k(self, offset, dp110, dp160):
        if offset < dp110:
            progress = offset / dp110
            return 0.65 * (1.0 - progress) + 0.45 * progress
        if offset < dp160:
            progress = (offset - dp110) / (dp160 - dp110)
            return 0.45 * (1.0 - progress) + 0.05 * progress
        return 0.05

    def _after_scroll(self, param):
        args = param.args
        dy = int(args[0])
        result = param.getResult()
        if result is None:
            return

        # Fast-path reverse drag tracking: keeps channel in_pull & offset in sync if user drags slightly back down!
        if dy <= 0:
            if dy < 0 and int(result) == 0:
                fragment, kind, entry = self._entry_for(param.thisObject)
                if fragment is not None and entry is not None and entry[_E_IN_PULL]:
                    offset_field = self._chat_field(fragment, self._f_pull_offset, "pullingDownOffset")
                    cur_off = float(offset_field.getFloat(fragment))
                    entry[_E_CH_OFF] = cur_off
                    entry[_E_TS] = time.monotonic()
                    if cur_off <= 0.0:
                        entry[_E_IN_PULL] = False
                        entry[_E_VIS] = False
                        entry[_E_DZ] = 0.0
            return

        if int(result) != 0:
            return
        cfg = self._cfg()
        if not cfg["enabled"]:
            return
        fragment, kind, entry = self._entry_for(param.thisObject)
        if fragment is None or kind is None or kind == "forum":
            return
        offset_field = self._chat_field(fragment, self._f_pull_offset, "pullingDownOffset")
        enabled = cfg["src"][kind]
        if kind == "channel":
            if not enabled:
                if float(offset_field.getFloat(fragment)) != 0.0:
                    df = self._chat_field_opt(fragment, self._f_drawable, "pullingDownDrawable")
                    dr = df.get(fragment) if df is not None else None
                    if dr is not None:
                        self._mark_drawable_suppressed(dr)
                    self._cancel_pull(fragment, offset_field, entry)
                return
            self._adjust_channel_pull(fragment, offset_field, dy, cfg["sensitivity_mult"], cfg["anti_accidental"], entry)
            return
        if not enabled or not self._can_pull(fragment, entry):
            return
        self._pull(fragment, offset_field, dy, cfg["sensitivity_mult"], cfg["anti_accidental"], entry)

    def _adjust_channel_pull(self, fragment, offset_field, dy, sens, anti_accidental, entry):
        """Apply calibrated 6-step sensitivity & optional 32dp accidental-swipe guard to native channel pulls."""
        if sens == 1.0 and not anti_accidental:
            return
        cur_off = float(offset_field.getFloat(fragment))
        if cur_off <= 0.0:
            entry[_E_IN_PULL] = False
            entry[_E_CH_OFF] = 0.0
            return

        dp110, dp160, _, dp32, dp220 = self._dp_metrics()
        now = time.monotonic()
        stale_gesture = (now - entry[_E_TS]) > PULL_GESTURE_GAP_SEC
        if stale_gesture:
            entry[_E_IN_PULL] = False
            entry[_E_CH_OFF] = 0.0
            entry[_E_DZ] = 0.0

        prev_off = entry[_E_CH_OFF] if (entry[_E_IN_PULL] and cur_off > entry[_E_CH_OFF]) else 0.0

        # Optional 32dp deadzone: only before a gesture enters active pull (NEVER snaps mid-gesture!)
        if anti_accidental and not entry[_E_IN_PULL]:
            entry[_E_DZ] += float(dy)
            entry[_E_TS] = now
            df = self._chat_field_opt(fragment, self._f_drawable, "pullingDownDrawable")
            dr = df.get(fragment) if df is not None else None
            if entry[_E_DZ] < dp32:
                # Suppress repeated updateDialog() calls while offset stays at 0.0 inside deadzone!
                if dr is not None:
                    self._mark_drawable_suppressed(dr)
                entry[_E_CH_OFF] = 0.0
                self._cancel_pull(fragment, offset_field, entry)
                return
            if dr is not None:
                self._clear_drawable_suppressed(dr)
            eff_dy = min(float(dy), entry[_E_DZ] - dp32)
            entry[_E_IN_PULL] = True
            new_off = min(dp220, max(0.0, eff_dy * 0.65 * sens))
            entry[_E_CH_OFF] = new_off
            if new_off <= 0.0:
                entry[_E_IN_PULL] = False
                self._cancel_pull(fragment, offset_field, entry)
                return
            offset_field.setFloat(fragment, jfloat(new_off))
            vf = self._chat_field_opt(fragment, self._f_list_view, "chatListView")
            view = vf.get(fragment) if vf is not None else None
            if view is not None:
                view.invalidate()
                self._pulling_container(fragment, int(view.getScrollState()) == 1, entry)
            return

        entry[_E_IN_PULL] = True
        entry[_E_TS] = now
        if sens == 1.0:
            entry[_E_CH_OFF] = cur_off
            return

        est_old = max(0.0, cur_off - dy * self._pull_k(cur_off, dp110, dp160))
        delta_est = min(cur_off, dy * self._pull_k(est_old, dp110, dp160))
        if prev_off > 0.0 and cur_off > prev_off:
            delta_native = min(delta_est, cur_off - prev_off)
        else:
            delta_native = delta_est

        new_off = min(dp220, cur_off + delta_native * (sens - 1.0))
        if new_off <= 0.0:
            entry[_E_IN_PULL] = False
            entry[_E_CH_OFF] = 0.0
            self._cancel_pull(fragment, offset_field, entry)
            return

        entry[_E_CH_OFF] = new_off
        offset_field.setFloat(fragment, jfloat(new_off))
        vf = self._chat_field_opt(fragment, self._f_list_view, "chatListView")
        view = vf.get(fragment) if vf is not None else None
        if view is not None:
            view.invalidate()
            self._pulling_container(fragment, int(view.getScrollState()) == 1, entry)

    def _can_pull(self, fragment, entry=None):
        if entry is not None:
            static_ok = entry[_E_STATIC_OK]
            if static_ok is _UNSET:
                static_ok = self._compute_static_pull_ok(fragment)
                entry[_E_STATIC_OK] = static_ok
            if not static_ok:
                return False
        else:
            if not self._compute_static_pull_ok(fragment):
                return False

        vf = self._chat_field(fragment, self._f_list_view, "chatListView")
        view = vf.get(fragment)
        if view is None or int(view.getScrollState()) != 1:
            return False
        try:
            if bool(fragment.hasSelectedMessages()) or bool(fragment.isReport()):
                return False
        except Exception:
            pass
        for name in ("isFastScrollAnimationRunning", "isMultiselect"):
            try:
                if bool(getattr(view, name)()):
                    return False
            except Exception:
                pass
        try:
            if bool(fragment.isInPreviewMode()):
                return False
        except Exception:
            pass
        return True

    def _pull(self, fragment, offset_field, dy, sens=1.0, anti_accidental=False, entry=None):
        """Elastic pull matching Telegram's channel pull-up with 6-step sensitivity & optional 32dp guard."""
        vf = self._chat_field(fragment, self._f_list_view, "chatListView")
        view = vf.get(fragment)
        if view is None:
            return
        dp110, dp160, _, dp32, dp220 = self._dp_metrics()
        offset = float(offset_field.getFloat(fragment))
        eff_dy = float(dy)
        now = time.monotonic()

        if entry is not None:
            if offset == 0.0:
                entry[_E_IN_PULL] = False
                entry[_E_VIS] = False
            if anti_accidental and offset == 0.0:
                if entry[_E_DZ] >= dp32 or (now - entry[_E_TS]) > PULL_GESTURE_GAP_SEC:
                    entry[_E_DZ] = 0.0
                entry[_E_DZ] += eff_dy
                entry[_E_TS] = now
                if entry[_E_DZ] < dp32:
                    return
                eff_dy = min(eff_dy, entry[_E_DZ] - dp32)
                if eff_dy <= 0.0:
                    return
            else:
                entry[_E_TS] = now
                if offset == 0.0:
                    entry[_E_DZ] = 0.0
            entry[_E_IN_PULL] = True

        df = self._chat_field_opt(fragment, self._f_drawable, "pullingDownDrawable")
        drawable = df.get(fragment) if df is not None else None
        if offset == 0.0 and drawable is not None:
            self._clear_drawable_suppressed(drawable)
            drawable.updateDialog()
        af = self._chat_field_opt(fragment, self._f_back_anim, "pullingDownBackAnimator")
        animator = af.get(fragment) if af is not None else None
        if animator is not None:
            animator.removeAllListeners()
            animator.cancel()

        k = self._pull_k(offset, dp110, dp160) * sens
        offset = min(dp220, offset + eff_dy * k)
        offset_field.setFloat(fragment, jfloat(offset))
        view.invalidate()
        view.setOverScrollMode(2)
        self._pulling_container(fragment, offset > 0 and int(view.getScrollState()) == 1, entry)

    def _cancel_pull(self, fragment, offset_field, entry=None):
        offset_field.setFloat(fragment, jfloat(0.0))
        vf = self._chat_field_opt(fragment, self._f_list_view, "chatListView")
        view = vf.get(fragment) if vf is not None else None
        if view is not None:
            view.setOverScrollMode(0)
            view.invalidate()
        self._pulling_container(fragment, False, entry)

    def _pulling_container(self, fragment, visible, entry=None):
        want = bool(visible)
        if entry is not None:
            if entry[_E_VIS] is want:
                return
            entry[_E_VIS] = want
        try:
            af = self._chat_field_opt(fragment, self._f_vis_anim, "animatorPullingDownContainerVisibility")
            animator = af.get(fragment) if af is not None else None
            if animator is not None:
                animator.setValue(want, True)
        except Exception:
            pass

    # ------------------------------------------------------------------ choosing the next chat

    def _kind_of_dialog(self, mc, did):
        if bool(self._DialogObject.isEncryptedDialog(did)):
            return None
        if did < 0:
            chat = mc.getChat(self._Long.valueOf(-did))
            if chat is None or bool(getattr(chat, "forum", False)):
                return None
            return "channel" if bool(self._ChatObject.isChannelAndNotMegaGroup(chat)) else "group"
        if did == 777000:
            return None
        user = mc.getUser(self._Long.valueOf(did))
        if user is None or self._is_self(user):
            return None
        try:
            if bool(self._UserObject.isDeleted(user)):
                return None
        except Exception:
            pass
        return "bot" if bool(user.bot) else "private"

    def _is_muted(self, mc, did):
        for count in (self._muted_args, 3 - self._muted_args):
            try:
                value = bool(mc.isDialogMuted(did, 0)) if count == 2 else bool(mc.isDialogMuted(did))
                self._muted_args = count
                return value
            except Exception:
                continue
        return False

    def _passes(self, mc, folder, filter_id, folder_scope):
        def lookup(folder_id, fid):
            try:
                if fid != 0:
                    by_id = getattr(mc, "dialogFiltersById", None)
                    entry = by_id.get(fid) if by_id is not None else None
                    return JavaList(entry.dialogs) if (entry is not None and entry.dialogs is not None) else None
                lst = mc.getDialogs(folder_id)
                return JavaList(lst) if lst is not None else None
            except Exception:
                return None

        # Pass 1: Current folder/filter
        yield (folder, filter_id, False), lookup(folder, filter_id)
        if folder_scope == SCOPE_CURRENT_ONLY:
            return

        # Pass 2: Other custom folders ONLY when currently inside a custom folder (filter_id != 0)
        if filter_id != 0:
            filters = getattr(mc, "dialogFilters", None)
            if filters is not None:
                for fobj in JavaList(filters):
                    if fobj is None:
                        continue
                    try:
                        fid = int(fobj.id)
                    except Exception:
                        continue
                    if fid != 0 and fid != filter_id:
                        yield (folder, fid, True), lookup(folder, fid)

        # Pass 3: Other folders (main list if we were in a filter; archive only if enabled)
        include_archive = (folder_scope == SCOPE_FOLDERS_AND_ARCHIVE)
        seen_folders = {folder} if filter_id == 0 else set()
        by_folder = getattr(mc, "dialogsByFolder", None)
        if by_folder is not None:
            idx = 0
            while True:
                try:
                    if idx >= int(by_folder.size()):
                        break
                    key = int(by_folder.keyAt(idx))
                except Exception:
                    break
                idx += 1
                if key in seen_folders:
                    continue
                if key == 1 and not include_archive:
                    continue
                seen_folders.add(key)
                yield (key, 0, True), lookup(key, 0)

    def _select(self, account, current_id, folder, filter_id, source_kind, cfg, targets):
        mc = self._controller(account)

        def unread(dialog):
            if int(dialog.unread_count) > 0:
                return True
            if cfg["prioritize_mentions"] and int(getattr(dialog, "unread_mentions_count", 0) or 0) > 0:
                return True
            return cfg["mark_unread"] and bool(dialog.unread_mark)

        def qualifies(dialog):
            did = int(dialog.id)
            if did == current_id or not unread(dialog):
                return False
            if cfg["skip_pinned"] and bool(dialog.pinned):
                return False
            kind = self._kind_of_dialog(mc, did)
            if kind is None or kind not in targets:
                return False
            if cfg["skip_muted"] and self._is_muted(mc, did):
                return False
            try:
                if bool(mc.isPromoDialog(did, False)):
                    return False
            except Exception:
                pass
            if did < 0:
                chat = mc.getChat(self._Long.valueOf(-did))
                if chat is not None:
                    rr = getattr(chat, "restriction_reason", None)
                    if rr is not None and mc.getRestrictionReason(rr) is not None:
                        return False
            return True

        def weight(dialog):
            cnt = int(dialog.unread_count)
            return cnt if cnt > 0 else 1

        mention_fn = (
            (lambda d: int(getattr(d, "unread_mentions_count", 0) or 0) > 0)
            if cfg["prioritize_mentions"]
            else None
        )
        visited = self._visited_set(account) if cfg["anti_ping_pong"] else None

        dialog, info = pick_dialog(
            self._passes(mc, folder, filter_id, cfg["folder_scope"]),
            qualifies,
            weight,
            cfg["strategy"],
            has_mention=mention_fn,
            visited_ids=visited,
        )
        kind = self._kind_of_dialog(mc, int(dialog.id)) if dialog is not None else None
        return dialog, info, kind

    def _kind_of_id(self, account, did):
        try:
            return self._kind_of_dialog(self._controller(account), int(did))
        except Exception:
            return None

    def _before_next_dialog(self, param):
        with self._lock:
            if time.monotonic() > self._updating_until:
                return
            dref = self._updating_drawable_ref
        drawable = dref.get() if dref is not None else None
        cfg = self._cfg()
        if not cfg["enabled"]:
            return
        args = param.args
        current = int(args[0])
        folder, filter_id = int(args[1]), int(args[2])
        params = args[4] if len(args) > 4 else None
        account = self._account_of(drawable)
        source = self._kind_of_id(account, current)
        if source is None:
            self._set_pick(drawable, None)
            return
        if not cfg["src"].get(source, False):
            self._set_pick(drawable, None)
            if source == "channel":
                self._mark_drawable_suppressed(drawable)
                param.setResult(None)
            return
        targets = target_kinds(source, cfg["mode"], cfg["selected"])
        if not targets or self._native_equivalent(cfg, targets):
            self._set_pick(drawable, None)
            return

        dialog, info, kind = self._select(account, current, folder, filter_id, source, cfg, targets)
        if dialog is not None and params is not None:
            try:
                if len(params) >= 3:
                    params[0] = 1 if info[2] else 0
                    params[1] = info[0]
                    params[2] = info[1]
            except Exception:
                pass
        pick_data = {
            "did": int(dialog.id) if dialog is not None else 0,
            "kind": kind,
            "source": source,
            "targets": targets,
            "account": account,
            "folder": info[0] if info is not None else folder,
            "filter": info[1] if info is not None else filter_id,
        }
        self._set_pick(drawable, pick_data)
        param.setResult(dialog)

    # ------------------------------------------------------------------ drawable tweaks

    def _after_update(self, param):
        if not self._cfg()["enabled"]:
            return
        drawable = param.thisObject
        pick = self._get_pick(drawable)
        if pick is None:
            with self._lock:
                pick = self._last_pick_fallback
                self._last_pick_fallback = None
            if pick is not None:
                self._set_pick(drawable, pick)
        if pick is None:
            return
        cls = drawable.getClass()
        self._field(cls, "lastWidth").setInt(drawable, 0)
        did = pick["did"]
        if did > 0:
            self._show_user_target(drawable, cls, pick, did)

    def _show_user_target(self, drawable, cls, pick, user_id):
        account = pick["account"]
        mc = self._controller(account)
        user = mc.getUser(self._Long.valueOf(user_id))
        if user is None:
            try:
                self._field(cls, "nextDialogId").setLong(drawable, 0)
                self._field(cls, "emptyStub").setBoolean(drawable, True)
            except Exception:
                pass
            return

        try:
            self._field(cls, "nextDialogId").setLong(drawable, user_id)
            self._field(cls, "dialogFolderId").setInt(drawable, int(pick["folder"]))
            self._field(cls, "dialogFilterId").setInt(drawable, int(pick["filter"]))
            self._field(cls, "emptyStub").setBoolean(drawable, False)
        except Exception:
            pass

        tl_chat_cls = self._TLChat or jclass("org.telegram.tgnet.TLRPC$TL_chat")
        fake = tl_chat_cls()
        fake.id = user_id
        fake.title = str(self._UserObject.getUserName(user))
        self._field(cls, "nextChat").set(drawable, fake)

        try:
            av_cls = self._AvatarDrawable or jclass("org.telegram.ui.Components.AvatarDrawable")
            avatar = av_cls()
            avatar.setInfo(account, user)
            receiver = self._get(drawable, "imageReceiver")
            if receiver is not None:
                try:
                    receiver.setForUserOrChat(user, avatar)
                except Exception:
                    ImageLocation = self._ImageLocation or jclass("org.telegram.messenger.ImageLocation")
                    location = ImageLocation.getForUser(user, ImageLocation.TYPE_SMALL)
                    try:
                        # Unambiguous 5-arg overload
                        receiver.setImage(location, "50_50", avatar, user, 0)
                    except Exception:
                        # Use empty string "" instead of None to avoid ambiguous Java overload resolution
                        current_user = self._UserConfig.getInstance(account).getCurrentUser()
                        receiver.setImage(location, "50_50", avatar, "", current_user, 0)
        except Exception as error:
            self._log("avatar: " + type(error).__name__)

    def _after_set_width(self, param):
        if not self._cfg()["enabled"]:
            return
        drawable = param.thisObject
        pick = self._get_pick(drawable)
        if pick is None:
            return
        cls = drawable.getClass()
        kind = pick["kind"]
        empty = bool(self._field(cls, "emptyStub").getBoolean(drawable))
        layout_class = self._StaticLayout or jclass("android.text.StaticLayout")
        alignment = self._LayoutAlignment or jclass("android.text.Layout$Alignment")
        width = int(self._field(cls, "lastWidth").getInt(drawable))
        _, _, dp60, _, _ = self._dp_metrics()
        limit = width - int(dp60)
        if limit <= 0:
            return
        if empty:
            if pick["targets"] == {"channel"}:
                return
            self._set_layout(
                drawable, cls, layout_class,
                phrase(label_kind(pick["targets"]), 2),
                "textPaint", "chatNameLayout", "chatNameWidth",
                alignment.ALIGN_NORMAL, limit,
            )
            return
        if kind is None or kind == "channel" or int(drawable.nextDialogId) != pick["did"]:
            return
        center = alignment.ALIGN_CENTER
        self._set_layout(drawable, cls, layout_class, phrase(kind, 0), "textPaint2", "layout1", "layout1Width", center, limit)
        self._set_layout(drawable, cls, layout_class, phrase(kind, 1), "textPaint2", "layout2", "layout2Width", center, limit)

    def _set_layout(self, drawable, cls, layout_class, text, paint_name, layout_name, width_name, align, limit):
        paint = self._get(drawable, paint_name)
        if paint is None:
            return
        display = text
        try:
            TextUtils = self._TextUtils or jclass("android.text.TextUtils")
            TruncateAt = self._TruncateAt or jclass("android.text.TextUtils$TruncateAt")
            display = str(TextUtils.ellipsize(text, paint, jfloat(limit), TruncateAt.END))
        except Exception:
            display = text
        measured = max(1, min(int(math.ceil(float(paint.measureText(display)))), int(limit)))
        layout = layout_class(display, paint, jint(measured), align, jfloat(1.0), jfloat(0.0), False)
        self._field(cls, layout_name).set(drawable, layout)
        self._field(cls, width_name).setInt(drawable, measured)

    # ------------------------------------------------------------------ opening the next chat

    def _current_dialog_id(self, fragment):
        try:
            return int(fragment.getDialogId())
        except Exception:
            pass
        try:
            f = self._chat_field_opt(fragment, self._f_dialog_id, "dialog_id")
            if f is not None:
                return int(f.getLong(fragment))
        except Exception:
            pass
        return 0

    def _pulled_dialogs_size(self, fragment):
        """Returns >=0 if list exists, -1 if field exists and is None, -2 on lookup failure."""
        try:
            f = self._chat_field_opt(fragment, self._f_pulled_dialogs, "pulledDialogs")
            if f is None:
                return -2
            lst = f.get(fragment)
            return int(lst.size()) if lst is not None else -1
        except Exception:
            return -2

    def _rollback_pulled_dialogs(self, fragment, prev_size):
        if prev_size < -1:
            return
        try:
            f = self._chat_field_opt(fragment, self._f_pulled_dialogs, "pulledDialogs")
            if f is None:
                return
            if prev_size == -1:
                try:
                    f.set(fragment, None)
                    return
                except Exception:
                    lst = f.get(fragment)
                    if lst is not None:
                        lst.clear()
                    return
            lst = f.get(fragment)
            if lst is not None:
                while int(lst.size()) > prev_size:
                    lst.remove(int(lst.size()) - 1)
        except Exception:
            pass

    def _copy_pulled_dialogs(self, src_frag, dst_frag):
        try:
            f = self._chat_field_opt(src_frag, self._f_pulled_dialogs, "pulledDialogs")
            if f is not None:
                lst = f.get(src_frag)
                if lst is not None:
                    ArrayList = self._ArrayList or jclass("java.util.ArrayList")
                    f.set(dst_frag, ArrayList(lst))
        except Exception:
            pass

    def _is_top_fragment(self, fragment):
        try:
            layout = fragment.getParentLayout()
            stack = layout.getFragmentStack() if layout is not None else None
            if stack is None:
                return False
            sz = int(stack.size())
            if sz <= 0:
                return False
            top = stack.get(sz - 1)
            return top is not None and self._same(top, fragment)
        except Exception:
            return False

    def _before_animate(self, param):
        self._pending_native_jump = None
        cfg = self._cfg()
        if not cfg["enabled"]:
            return
        fragment = param.thisObject
        src_kind = self._fragment_kind(fragment)
        if src_kind is None or src_kind == "forum" or not cfg["src"].get(src_kind, False):
            return
        df = self._chat_field_opt(fragment, self._f_drawable, "pullingDownDrawable")
        drawable = df.get(fragment) if df is not None else None
        if drawable is None or bool(self._field(drawable.getClass(), "emptyStub").getBoolean(drawable)):
            return
        next_did = int(drawable.nextDialogId)
        if next_did == 0:
            return

        account = self._account_of(fragment)
        cur_did = self._current_dialog_id(fragment)

        # Channels & groups with standard back behavior: defer jump recording to _after_animate so
        # aborted native transitions are never counted!
        native = next_did < 0 and not cfg["keep_back_stack"]
        if native:
            self._pending_native_jump = (self._weak(fragment), account, cur_did, cfg["anti_ping_pong"])
            return

        try:
            if fragment.getParentLayout() is None:
                return
        except Exception:
            pass

        # From here on the stock animation is replaced: record jump ONLY if presentFragment succeeds!
        param.setResult(None)
        prev_pulled_size = self._pulled_dialogs_size(fragment)
        opened = False
        try:
            opened = self._open_next(fragment, drawable, next_did, cfg, prev_pulled_size)
        except Exception as error:
            self._log("jump failed: " + type(error).__name__ + ": " + str(error))
            self._abort_jump(fragment, prev_pulled_size)
        if opened:
            self._record_jump(account, cur_did, cfg["anti_ping_pong"])

    def _after_animate(self, param):
        pending = self._pending_native_jump
        self._pending_native_jump = None
        if pending is None:
            return
        fref, account, cur_did, anti_ping_pong = pending
        fragment = fref.get()
        if fragment is None or not self._same(fragment, param.thisObject):
            return
        # Confirm native transition actually happened (replacingChatActivity=True or no longer top of stack)
        succeeded = False
        try:
            rf = self._chat_field_opt(fragment, self._f_replacing, "replacingChatActivity")
            if rf is not None and bool(rf.getBoolean(fragment)):
                succeeded = True
        except Exception:
            pass
        if not succeeded and not self._is_top_fragment(fragment):
            succeeded = True
        if succeeded:
            self._record_jump(account, cur_did, anti_ping_pong)

    def _open_next(self, fragment, drawable, next_did, cfg, prev_pulled_size):
        folder, filter_id = int(drawable.dialogFolderId), int(drawable.dialogFilterId)

        Bundle = self._Bundle or jclass("android.os.Bundle")
        bundle = Bundle()
        if next_did > 0:
            bundle.putLong("user_id", next_did)
        else:
            bundle.putLong("chat_id", -next_did)
        bundle.putInt("dialog_folder_id", folder)
        bundle.putInt("dialog_filter_id", filter_id)
        bundle.putBoolean("pulled", True)

        chat_ctor = self._chat_activity_ctor or jclass("org.telegram.ui.ChatActivity")
        activity = chat_ctor(bundle)
        try:
            method = self._method(fragment.getClass(), "addToPulledDialogsMyself")
            method.invoke(fragment)
        except Exception:
            pass
        self._copy_pulled_dialogs(fragment, activity)

        remove_last = not cfg["keep_back_stack"]
        try:
            set_trans = self._method(self._chat_activity, "setPullingDownTransition", self._Boolean.TYPE)
            set_trans.invoke(activity, self._Boolean.TRUE)
        except Exception as error:
            self._log("transition: " + type(error).__name__)

        if remove_last:
            try:
                rf = self._chat_field(fragment, self._f_replacing, "replacingChatActivity")
                rf.setBoolean(fragment, True)
            except Exception as error:
                self._log("replacing: " + type(error).__name__)

        opened = fragment.presentFragment(activity, remove_last)
        if not opened:
            self._abort_jump(fragment, prev_pulled_size)
            return False

        if not remove_last:
            src_ref = self._weak(fragment)
            dst_ref = self._weak(activity)
            _run_ui_delayed(lambda: self._post_kept_jump(src_ref.get(), dst_ref.get(), True), POST_JUMP_DELAY_MS)
        return True

    def _abort_jump(self, fragment, prev_pulled_size=-2):
        """Undo what the custom jump did to the source chat so it is not left half-pulled / marked as replaced."""
        self._rollback_pulled_dialogs(fragment, prev_pulled_size)
        try:
            rf = self._chat_field_opt(fragment, self._f_replacing, "replacingChatActivity")
            if rf is not None:
                rf.setBoolean(fragment, False)
        except Exception:
            pass
        try:
            off_f = self._chat_field_opt(fragment, self._f_pull_offset, "pullingDownOffset")
            if off_f is not None:
                self._cancel_pull(fragment, off_f)
        except Exception:
            pass

    def _post_kept_jump(self, src_fragment, dst_fragment, allow_retry=True):
        """Runs after the transition animation finishes when keep_back_stack=True:
        - If layout is still mid-transition, retries once after POST_JUMP_RETRY_MS.
        - Never resets pull offset on src_fragment if the user already pressed Back and returned to it.
        - Trims excess ChatActivity instances via the new top fragment."""
        if not self._active:
            return
        anchor = dst_fragment if dst_fragment is not None else src_fragment
        if allow_retry and anchor is not None:
            try:
                layout = anchor.getParentLayout()
                if layout is not None and hasattr(layout, "isInTransition") and bool(layout.isInTransition()):
                    s_ref = self._weak(src_fragment) if src_fragment is not None else None
                    d_ref = self._weak(dst_fragment) if dst_fragment is not None else None
                    _run_ui_delayed(
                        lambda: self._post_kept_jump(s_ref.get() if s_ref else None, d_ref.get() if d_ref else None, False),
                        POST_JUMP_RETRY_MS,
                    )
                    return
            except Exception:
                pass

        if src_fragment is not None and not self._is_top_fragment(src_fragment):
            try:
                off_f = self._chat_field_opt(src_fragment, self._f_pull_offset, "pullingDownOffset")
                if off_f is not None and float(off_f.getFloat(src_fragment)) != 0.0:
                    self._cancel_pull(src_fragment, off_f)
            except Exception:
                pass
        if anchor is not None:
            self._trim_back_stack(anchor)

    def _trim_back_stack(self, fragment):
        if not self._active or fragment is None or self._chat_activity is None:
            return
        try:
            layout = fragment.getParentLayout()
            stack = layout.getFragmentStack() if layout is not None else None
            if stack is None:
                return
            count = int(stack.size())
            chats = []
            for i in range(count - 1):  # everything except the top fragment
                try:
                    frag = stack.get(i)
                except Exception:
                    break
                if frag is not None and self._chat_activity.isInstance(frag):
                    chats.append(frag)
            surplus = len(chats) - MAX_KEPT_CHATS
            for frag in chats[:max(0, surplus)]:
                try:
                    frag.removeSelfFromStack()
                except Exception:
                    try:
                        layout.removeFragmentFromStack(frag)
                    except Exception as inner_err:
                        self._log("trim item: " + type(inner_err).__name__)
        except Exception as error:
            self._log("trim: " + type(error).__name__ + ": " + str(error))


class JavaList:
    """Snapshot-tolerant iteration over a java.util.List (safe against concurrent shrink)."""

    def __init__(self, items):
        self.items = items

    def __iter__(self):
        items = self.items
        if items is None:
            return
        index = 0
        while True:
            try:
                if index >= int(items.size()):
                    break
                item = items.get(index)
            except Exception:
                break
            yield item
            index += 1
