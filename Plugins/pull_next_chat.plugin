            Switch(key="src_channel", text=tr("Каналы", "Channels"), default=True, subtext=tr("Как в Telegram.", "Like stock Telegram."), on_change=on_chg),
            Switch(key="src_group", text=tr("Группы", "Groups"), default=True, on_change=on_chg),
            Switch(key="src_private", text=tr("Личные чаты", "Private chats"), default=False, on_change=on_chg),
