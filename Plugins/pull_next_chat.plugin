                    tr("×0.5 (очень длинный свайп)", "×0.5 (very long pull)"),
                    tr("×0.75 (длиннее обычного)", "×0.75 (longer pull)"),
                    tr("×1 (стандартная, как в Telegram)", "×1 (standard, like Telegram)"),
                    tr("×1.5 (быстрее обычного)", "×1.5 (faster pull)"),
                    tr("×2 (короткий свайп)", "×2 (short pull)"),
                    tr("×2.5 (очень короткий свайп)", "×2.5 (very short pull)"),
