__id__ = "higal"
__name__ = "Hide Gallery"
__description__ = "Скрывает всю галерею под размытием\nBlurs the whole gallery"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "animated_boykisser_by_fStikBot/31"
__min_version__ = "12.9.0"


from base_plugin import BasePlugin, MethodHook
from android_utils import log, run_on_ui_thread
from hook_utils import get_private_field
from java.lang import Class, Boolean as B


CELL = "org.telegram.ui.Cells.PhotoAttachPhotoCell"
LAYOUT = "org.telegram.ui.Components.ChatAttachAlertPhotoLayout"
VIEWER = "org.telegram.ui.PhotoViewer"


class HideGalleryPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.revealed = set()
        self.grid = None
        self.orig = None
        self.orig_set = False
        self.blur = None
        self.blur_tried = False
        self.filt = None
        self.filt_tried = False
        self.active = False

    def on_plugin_load(self):
        self.active = True
        try:
            self._install()
        except Exception as e:
            log(f"load: {e}")

    def on_plugin_unload(self):
        self.active = False
        gv = self.grid
        if gv is not None:
            try:
                for i in range(gv.getChildCount()):
                    c = gv.getChildAt(i)
                    try:
                        if "PhotoAttachPhotoCell" not in c.getClass().getName():
                            continue
                        iv = c.getImageView()
                        iv.setRenderEffect(None)
                        iv.setColorFilter(None)
                    except Exception:
                        pass
            except Exception:
                pass
        self.revealed = set()
        self.grid = None
        self.orig = None
        self.orig_set = False
        self.blur = None
        self.blur_tried = False
        self.filt = None
        self.filt_tried = False

    def _blur_effect(self):
        if not self.blur_tried:
            self.blur_tried = True
            try:
                from android.os import Build
                if Build.VERSION.SDK_INT >= 31:
                    from android.graphics import RenderEffect, Shader
                    from org.telegram.messenger import AndroidUtilities
                    r = float(AndroidUtilities.dp(25))
                    self.blur = RenderEffect.createBlurEffect(r, r, Shader.TileMode.CLAMP)
            except Exception as e:
                log(f"blur: {e}")
        return self.blur

    def _fallback(self):
        if not self.filt_tried:
            self.filt_tried = True
            try:
                from android.graphics import ColorMatrix, ColorMatrixColorFilter
                m = ColorMatrix()
                m.setScale(0.15, 0.15, 0.15, 1.0)
                self.filt = ColorMatrixColorFilter(m)
            except Exception as e:
                log(f"filt: {e}")
        return self.filt

    def _visual(self, iv, spoil):
        if iv is None:
            return
        try:
            b = self._blur_effect()
            if b is not None:
                iv.setRenderEffect(b if spoil else None)
                iv.setColorFilter(None)
            else:
                iv.setColorFilter(self._fallback() if spoil else None)
        except Exception:
            pass

    def _spoil(self, entry, cell):
        if entry is None:
            return True
        try:
            if cell is not None and cell.isChecked():
                return False
        except Exception:
            pass
        try:
            if entry.hasSpoiler:
                return True
        except Exception:
            pass
        try:
            return entry.imageId not in self.revealed
        except Exception:
            return True

    def _apply(self, cell):
        if not self.active:
            return
        try:
            self._visual(cell.getImageView(), self._spoil(cell.getPhotoEntry(), cell))
        except Exception:
            pass

    def _refresh(self):
        if not self.active or self.grid is None:
            return
        try:
            for i in range(self.grid.getChildCount()):
                c = self.grid.getChildAt(i)
                try:
                    if "PhotoAttachPhotoCell" in c.getClass().getName():
                        self._apply(c)
                except Exception:
                    pass
        except Exception:
            pass

    def _reset(self):
        if not self.active:
            return
        self.revealed = set()
        self._refresh()

    def _install(self):
        p = self

        class H1(MethodHook):
            def before_hooked_method(self, param):
                if p.active and param.args and len(param.args) >= 1:
                    param.args[0] = False

        class H2(MethodHook):
            def after_hooked_method(self, param):
                if p.active and param.thisObject is not None:
                    p._apply(param.thisObject)

        class HInit(MethodHook):
            def after_hooked_method(self, param):
                if not p.active:
                    return
                p.revealed = set()
                try:
                    p.grid = get_private_field(param.thisObject, "gridView")
                    if p.grid is not None:
                        p._click(p.grid)
                except Exception as e:
                    log(f"onInit: {e}")

        class HReset(MethodHook):
            def after_hooked_method(self, param):
                if p.active:
                    p.revealed = set()

        class HClose(MethodHook):
            def before_hooked_method(self, param):
                if p.active:
                    run_on_ui_thread(p._reset, 350)

        try:
            for m in Class.forName(CELL).getDeclaredMethods():
                n = m.getName()
                if n == "setHasSpoiler":
                    m.setAccessible(True)
                    self.hook_method(m, H1())
                elif n in ("setPhotoEntry", "setChecked"):
                    m.setAccessible(True)
                    self.hook_method(m, H2())
        except Exception as e:
            log(f"cell: {e}")

        try:
            cls = Class.forName(LAYOUT)
            try:
                m = cls.getMethod("onInit", B.TYPE, B.TYPE, B.TYPE)
            except Exception:
                m = cls.getDeclaredMethod("onInit", B.TYPE, B.TYPE, B.TYPE)
            m.setAccessible(True)
            self.hook_method(m, HInit())
            try:
                m2 = cls.getMethod("onHidden")
                m2.setAccessible(True)
                self.hook_method(m2, HReset())
            except Exception:
                pass
        except Exception as e:
            log(f"layout: {e}")

        try:
            for m in Class.forName(VIEWER).getDeclaredMethods():
                if m.getName() == "closePhoto":
                    m.setAccessible(True)
                    self.hook_method(m, HClose())
        except Exception as e:
            log(f"viewer: {e}")

    def _click(self, gv):
        p = self
        if not self.orig_set:
            for f in ("onItemClickListenerExtended", "onItemClickListener"):
                try:
                    l = get_private_field(gv, f)
                    if l is not None:
                        self.orig = l
                        break
                except Exception:
                    continue
            self.orig_set = True
        orig = self.orig

        try:
            from java import dynamic_proxy
            from org.telegram.ui.Components import RecyclerListView
            IFC = RecyclerListView.OnItemClickListenerExtended

            class CL(dynamic_proxy(IFC)):
                def onItemClick(this, view, position, x, y):
                    try:
                        if p.active and "PhotoAttachPhotoCell" in view.getClass().getName():
                            try:
                                e = view.getPhotoEntry()
                                if e is not None:
                                    p.revealed.add(e.imageId)
                                    p._visual(view.getImageView(), False)
                            except Exception:
                                pass
                        if orig is not None:
                            orig.onItemClick(view, position, x, y)
                    except Exception as ex:
                        log(f"click: {ex}")

            gv.setOnItemClickListener(CL())
        except Exception as e:
            log(f"listener: {e}")