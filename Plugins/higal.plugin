__id__ = "higal"
__name__ = "Hide Gallery"
__description__ = "Скрывает всю галерею под размытием\nBlurs the whole gallery\n\nСпс за оптимизацию/Thx for optimization: @dekma0091"
__author__ = "@ka1Plugins"
__version__ = "1.2"
__icon__ = "animated_boykisser_by_fStikBot/31"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.7"

import base64
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader


DEX_B64 = """"""


class HideGalleryPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self.log("Loading HideGallery DEX...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("by.ka1Plugins.higal.HideGallery")
            for method in self.dex_class.getMethods():
                if method.getName() == "start":
                    result = method.invoke(None)
                    self.log("HideGallery Load!")
                    break
        except Exception as e:
            self.log(f"Failed to load HideGallery DEX: {e}")

    def on_plugin_unload(self):
        try:
            if hasattr(self, "dex_class") and self.dex_class is not None:
                for method in self.dex_class.getMethods():
                    if method.getName() == "stop":
                        result = method.invoke(None)
                        self.log(f"HideGallery Unload!")
                        break
        except Exception as e:
            self.log(f"Failed to unload HideGallery DEX: {e}")