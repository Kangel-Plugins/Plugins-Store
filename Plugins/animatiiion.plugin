btn_hide = "скрыть и показывать еще больше"

ui_handler = Handler(Looper.getMainLooper())

blocked_names = [
    "TL_messageEntityCustomEmoji",
    "TL_messageEntityCode",
    "TL_messageEntityPre",
    "TL_messageEntityFormattedDate",
    "TL_messageEntityUrl",
    "TL_messageEntityEmail",
    "TL_messageEntityPhone",
    "TL_messageEntityBotCommand",
    "TL_messageEntityMention",
    "TL_messageEntityHashtag",
    "TL_messageEntityCashtag",
    "TL_messageEntityBankCard",
]

blocked_types = tuple(c for c in (getattr(TLRPC, n, None) for n in blocked_names) if c is not None)
custom_emoji_cls = getattr(TLRPC, "TL_messageEntityCustomEmoji", None)
custom_attr_cls = getattr(TLRPC, "TL_documentAttributeCustomEmoji", None)
sticker_attr_cls = getattr(TLRPC, "TL_documentAttributeSticker", None)

extra_emoji = {
    0x00A9, 0x00AE, 0x203C, 0x2049, 0x20E3, 0x2122, 0x2139,
    0x2194, 0x2195, 0x2196, 0x2197, 0x2198, 0x2199, 0x21A9, 0x21AA,
    0x25AA, 0x25AB, 0x25B6, 0x25C0, 0x25FB, 0x25FC, 0x25FD, 0x25FE,
    0x2934, 0x2935, 0x2B05, 0x2B06, 0x2B07, 0x2B1B, 0x2B1C, 0x2B50,
    0x2B55, 0x3030, 0x303D, 0x3297, 0x3299,
}


class UiTask(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super(UiTask, self).__init__()
        self.fn = fn

    def run(self):
        if self.fn is not None:
            try:
                self.fn()
            except Exception:
                pass


def to_list(col):
    if col is None:
        return []
    if isinstance(col, list):
        return list(col)
    if hasattr(col, "size") and hasattr(col, "get"):
        return [col.get(i) for i in range(col.size())]
    try:
        return list(col)
    except Exception:
        return []


def u16_len(s):
    return sum(2 if ord(c) > 0xFFFF else 1 for c in s)


def u16_offsets(s):
    res = [0] * (len(s) + 1)
    acc = 0
    for i, c in enumerate(s):
        acc += 2 if ord(c) > 0xFFFF else 1
        res[i + 1] = acc
    return res


def is_ri(c):
    return 0x1F1E6 <= ord(c) <= 0x1F1FF


def bad_boundary(text, start, end):
    if start > 0:
        prev = text[start - 1]
        if prev == "\u200d":
            return True
        if is_ri(text[start]) and is_ri(prev):
            cnt = 0
            i = start - 1
            while i >= 0 and is_ri(text[i]):
                cnt += 1
                i -= 1
            if cnt % 2 == 1:
                return True
    if end < len(text):
        nxt = text[end]
        cp = ord(nxt)
        if nxt in ("\u200d", "\ufe0f", "\ufe0e", "\u20e3") or 0x1F3FB <= cp <= 0x1F3FF or 0xE0020 <= cp <= 0xE007F:
            return True
        if is_ri(nxt) and is_ri(text[end - 1]):
            cnt = 0
            i = end - 1
            while i >= 0 and is_ri(text[i]):
                cnt += 1
                i -= 1
            if cnt % 2 == 1:
                return True
    return False


def has_emoji(text):
    for c in text:
        cp = ord(c)
        if 0x1F000 <= cp <= 0x1FAFF or 0x2600 <= cp <= 0x27BF or 0x2300 <= cp <= 0x23FF or cp in extra_emoji:
            return True
    return False


def get_blocked(ents):
    ranges = []
    if not blocked_types:
        return ranges
    for e in ents:
        if isinstance(e, blocked_types):
            off = int(getattr(e, "offset", 0))
            ln = int(getattr(e, "length", 0))
            if ln > 0:
                ranges.append((off, off + ln))
    return ranges


def extract_pack(sset):
    raw = {}
    for doc in to_list(getattr(sset, "documents", None)):
        doc_id = getattr(doc, "id", 0)
        if not doc_id:
            continue
        alt = None
        fallback = None
        for attr in to_list(getattr(doc, "attributes", None)):
            if custom_attr_cls is not None and isinstance(attr, custom_attr_cls):
                val = getattr(attr, "alt", None)
                if isinstance(val, str) and val:
                    alt = val
                    break
            elif sticker_attr_cls is not None and isinstance(attr, sticker_attr_cls) and fallback is None:
                val = getattr(attr, "alt", None)
                if isinstance(val, str) and val:
                    fallback = val
        chosen = alt or fallback
        if not chosen:
            continue
        stripped = chosen.replace("\ufe0f", "")
        if not stripped or (len(stripped) == 1 and ord(stripped) < 0x80):
            continue
        raw.setdefault(chosen, int(doc_id))
    return raw


def build_lookup(raw):
    lookup = {}
    for alt, doc_id in raw.items():
        if not isinstance(alt, str) or not alt:
            continue
        stripped = alt.replace("\ufe0f", "")
        if not stripped or (len(stripped) == 1 and ord(stripped) < 0x80):
            continue
        lookup.setdefault(stripped, (int(doc_id), alt))
    if not lookup:
        return {}, None
    keys = sorted(lookup.keys(), key=len, reverse=True)
    parts = ["".join(re.escape(c) + ("" if c == "\u200d" else "\ufe0f?") for c in k) for k in keys]
    return lookup, re.compile("|".join(parts))


def set_entities(params, ents):
    ents.sort(key=lambda e: (int(getattr(e, "offset", 0)), -int(getattr(e, "length", 0))))
    orig = getattr(params, "entities", None)
    if isinstance(orig, list):
        orig.clear()
        orig.extend(ents)
        return
    if orig is not None and hasattr(orig, "clear") and hasattr(orig, "add"):
        orig.clear()
        for e in ents:
            orig.add(e)
        return
    arr = ArrayList()
    for e in ents:
        arr.add(e)
    try:
        params.entities = arr
    except TypeError:
        params.entities = ents


class RestrictedEmojiPlugin(BasePlugin):

    def on_plugin_load(self):
        self.lock = threading.RLock()
        self.lookup = {}
        self.pattern = None
        self.loading = False
        self.unloaded = False
        self.last_refresh = 0.0
        self.last_try = 0.0
        self.warned = set()
        self.welcome_done = False
        self.welcome_cb = None
        self.add_on_send_message_hook()
        run_on_queue(self.init_pack)
        if not self.get_cfg("welcome_shown", False):
            self.schedule_welcome(0)

    def on_plugin_unload(self):
        self.unloaded = True
        try:
            if self.welcome_cb is not None:
                ui_handler.removeCallbacks(self.welcome_cb)
        except Exception:
            pass
        self.welcome_cb = None

    def open_tg(self, username, view=None):
        url = "https://t.me/" + username
        ctx = None
        try:
            frag = get_last_fragment()
            if frag is not None:
                ctx = frag.getParentActivity()
            if ctx is None and view is not None:
                ctx = view.getContext()
            if ctx is None:
                return
            browser = jclass("org.telegram.messenger.browser.Browser")
            browser.openUrl(ctx, url)
        except Exception:
            try:
                if ctx is None:
                    return
                intent = jclass("android.content.Intent")
                uri = jclass("android.net.Uri")
                ctx.startActivity(intent(intent.ACTION_VIEW, uri.parse(url)))
            except Exception:
                pass

    def schedule_welcome(self, attempt=0):
        if self.unloaded or self.welcome_done or self.get_cfg("welcome_shown", False):
            return
        if attempt > 20:
            return

        def try_show():
            if self.unloaded or self.welcome_done or self.get_cfg("welcome_shown", False):
                return
            if not self.show_welcome():
                self.schedule_welcome(attempt + 1)

        try:
            if self.welcome_cb is not None:
                ui_handler.removeCallbacks(self.welcome_cb)
        except Exception:
            pass
        self.welcome_cb = UiTask(try_show)
        delay = 300 if attempt == 0 else 500
        try:
            ui_handler.postDelayed(self.welcome_cb, delay)
        except Exception:
            run_on_ui_thread(try_show)

    def show_welcome(self):
        if self.unloaded or self.welcome_done or self.get_cfg("welcome_shown", False):
            return True
        try:
            frag = get_last_fragment()
            if not frag:
                return False
            act = frag.getParentActivity()
            if not act:
                return False
            try:
                if act.isFinishing():
                    return False
            except Exception:
                pass

            acc = self.get_acc()
            if acc is None:
                return False

            msg = welcome_prem if self.is_prem(acc) else welcome_no_prem

            dlg = AlertDialogBuilder(act)
            dlg.set_title(__name__)
            dlg.set_message(msg)

            def on_channel(b, w):
                self.set_cfg("welcome_shown", True)
                self.open_tg(channel_user)
                b.dismiss()

            def on_hide(b, w):
                self.set_cfg("welcome_shown", True)
                b.dismiss()

            dlg.set_positive_button(btn_channel, on_channel)
            dlg.set_negative_button(btn_hide, on_hide)
            dlg.show()
            self.welcome_done = True
            return True
        except Exception:
            return False

    def cache_path(self):
        try:
            d = get_cache_dir()
            if d:
                return os.path.join(d, cache_file)
        except Exception:
            pass
        return None

    def load_cache(self):
        path = self.cache_path()
        if not path or not os.path.exists(path):
            return False
        try:
            data = read_file(path)
            if not data:
                return False
            obj = json.loads(data)
            raw = obj.get("map") if isinstance(obj, dict) else None
            ts = float(obj.get("updated_at", 0.0)) if isinstance(obj, dict) else 0.0
            if isinstance(raw, dict) and raw:
                self.apply_map(raw, ts)
                return True
        except Exception:
            pass
        return False

    def save_cache(self, raw, ts):
        path = self.cache_path()
        if not path:
            return
        try:
            write_file(path, json.dumps({"updated_at": ts, "map": raw}, ensure_ascii=False))
        except Exception:
            pass

    def apply_map(self, raw, ts):
        lookup, pattern = build_lookup(raw)
        if pattern is None:
            return
        with self.lock:
            self.lookup = lookup
            self.pattern = pattern
            if ts > self.last_refresh:
                self.last_refresh = ts

    def put_in_ctrl(self, acc, sset):
        try:
            ctrl = MediaDataController.getInstance(acc)
            if ctrl is not None:
                ctrl.putStickerSet(sset, False)
        except Exception:
            pass

    def load_from_ctrl(self, acc):
        try:
            ctrl = MediaDataController.getInstance(acc)
            if ctrl is None:
                return False
            sset = ctrl.getStickerSetByName(pack_name)
            if sset is None:
                return False
            raw = extract_pack(sset)
            if not raw:
                return False
            now = time.time()
            self.apply_map(raw, now)
            run_on_queue(lambda: self.save_cache(raw, now))
            return True
        except Exception:
            return False

    def get_acc(self):
        try:
            sel = int(getattr(UserConfig, "selectedAccount", 0))
            if UserConfig.isValidAccount(sel):
                return sel
            for acc in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                if UserConfig.isValidAccount(acc):
                    return acc
        except Exception:
            return 0
        return None

    def init_pack(self):
        if self.unloaded:
            return
        self.load_cache()
        acc = self.get_acc()
        if acc is None:
            return
        with self.lock:
            has_pat = self.pattern is not None
            stale = (time.time() - self.last_refresh) >= refresh_sec
        if not has_pat:
            has_pat = self.load_from_ctrl(acc)
        if not has_pat or stale:
            self.fetch_pack(acc)

    def fetch_pack(self, acc):
        if self.unloaded:
            return
        now = time.time()
        with self.lock:
            if self.loading and (now - self.last_try) < timeout_sec:
                return
            if not self.loading and (now - self.last_try) < retry_sec:
                return
            self.loading = True
            self.last_try = now

        def on_res(res, err):
            def done():
                try:
                    if self.unloaded:
                        return
                    if err is None and res is not None and isinstance(res, TLRPC.TL_messages_stickerSet):
                        raw = extract_pack(res)
                        if raw:
                            ts = time.time()
                            self.apply_map(raw, ts)
                            self.save_cache(raw, ts)
                            run_on_ui_thread(lambda: self.put_in_ctrl(acc, res))
                finally:
                    with self.lock:
                        self.loading = False
            try:
                run_on_queue(done)
            except Exception:
                with self.lock:
                    self.loading = False

        try:
            req = TLRPC.TL_messages_getStickerSet()
            inp = TLRPC.TL_inputStickerSetShortName()
            inp.short_name = pack_name
            req.stickerset = inp
            req.hash = 0
            try:
                ConnectionsManager.getInstance(acc).sendRequest(req, RequestCallback(on_res))
            except Exception:
                send_request(req, on_res)
        except Exception:
            with self.lock:
                self.loading = False

    def is_prem(self, acc):
        try:
            cfg = UserConfig.getInstance(acc)
            return bool(cfg is not None and cfg.isPremium())
        except Exception:
            return False

    def get_cfg(self, key, default=None):
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def set_cfg(self, key, val):
        try:
            self.set_setting(key, val)
        except Exception:
            pass

    def warn_no_prem(self, acc):
        key = f"no_premium_notified_{acc}"
        with self.lock:
            if acc in self.warned:
                return
            if self.get_cfg(key, False):
                self.warned.add(acc)
                return
            self.warned.add(acc)
        self.set_cfg(key, True)
        try:
            BulletinHelper.show_error(no_prem_text)
        except Exception:
            pass

    def clear_no_prem(self, acc):
        key = f"no_premium_notified_{acc}"
        with self.lock:
            had = acc in self.warned
            self.warned.discard(acc)
        if had or self.get_cfg(key, False):
            self.set_cfg(key, False)

    def has_replaceable(self, text, params, pattern):
        if pattern is None:
            return has_emoji(text)
        blocked = get_blocked(to_list(getattr(params, "entities", None)))
        u16 = u16_offsets(text)
        for m in pattern.finditer(text):
            ps, pe = m.start(), m.end()
            if bad_boundary(text, ps, pe):
                continue
            us, ue = u16[ps], u16[pe]
            if any(us < e and ue > s for s, e in blocked):
                continue
            return True
        return False

    def on_send_message_hook(self, account, params):
        try:
            if self.unloaded or custom_emoji_cls is None:
                return HookResult()

            msg = getattr(params, "message", None)
            cap = getattr(params, "caption", None)
            if isinstance(msg, str) and msg:
                field = "message"
                text = msg
            elif isinstance(cap, str) and cap:
                field = "caption"
                text = cap
            else:
                return HookResult()

            with self.lock:
                lookup = self.lookup
                pattern = self.pattern
                last_ref = self.last_refresh

            if pattern is None:
                if self.load_from_ctrl(account):
                    with self.lock:
                        lookup = self.lookup
                        pattern = self.pattern
                        last_ref = self.last_refresh
                else:
                    self.fetch_pack(account)

            if not self.is_prem(account):
                if self.has_replaceable(text, params, pattern):
                    self.warn_no_prem(account)
                return HookResult()

            self.clear_no_prem(account)

            if pattern is None:
                return HookResult()

            if (time.time() - last_ref) >= refresh_sec:
                self.fetch_pack(account)

            existing = to_list(getattr(params, "entities", None))
            blocked = get_blocked(existing)
            custom_cnt = sum(1 for e in existing if isinstance(e, custom_emoji_cls))
            max_slots = min(max_entities - len(existing), max_entities - custom_cnt)
            if max_slots <= 0:
                return HookResult()

            max_len = 4096 if field == "message" else 2048
            u16 = u16_offsets(text)
            reps = []
            extra = 0

            for m in pattern.finditer(text):
                ps, pe = m.start(), m.end()
                if bad_boundary(text, ps, pe):
                    continue
                us, ue = u16[ps], u16[pe]
                if any(us < e and ue > s for s, e in blocked):
                    continue
                entry = lookup.get(m.group(0).replace("\ufe0f", ""))
                if entry is None:
                    continue
                doc_id, calt = entry
                delta = len(calt) - (pe - ps)
                if delta > 0 and (len(text) + extra + delta) > max_len:
                    continue
                extra += delta
                reps.append((ps, pe, us, ue, doc_id, calt))
                if len(reps) >= max_slots:
                    break

            if not reps:
                return HookResult()

            need_text_edit = any(text[ps:pe] != calt for ps, pe, _, _, _, calt in reps)
            new_ents = []

            if not need_text_edit:
                for _, _, us, ue, doc_id, _ in reps:
                    ent = custom_emoji_cls()
                    ent.offset = int(us)
                    ent.length = int(ue - us)
                    ent.document_id = int(doc_id)
                    new_ents.append(ent)
            else:
                old_total = u16[-1]
                pos_map = [0] * (old_total + 1)
                parts = []
                prev_py = 0
                prev_u16 = 0
                cur_u16 = 0

                for ps, pe, us, ue, doc_id, calt in reps:
                    for u in range(prev_u16, us + 1):
                        pos_map[u] = cur_u16 + (u - prev_u16)
                    cur_u16 += us - prev_u16
                    parts.append(text[prev_py:ps])

                    calt_len = u16_len(calt)
                    ent_start = cur_u16
                    ent_end = cur_u16 + calt_len
                    pos_map[us] = ent_start
                    for u in range(us + 1, ue + 1):
                        pos_map[u] = ent_end

                    ent = custom_emoji_cls()
                    ent.offset = int(ent_start)
                    ent.length = int(calt_len)
                    ent.document_id = int(doc_id)
                    new_ents.append(ent)

                    parts.append(calt)
                    cur_u16 = ent_end
                    prev_py = pe
                    prev_u16 = ue

                for u in range(prev_u16, old_total + 1):
                    pos_map[u] = cur_u16 + (u - prev_u16)
                parts.append(text[prev_py:])

                for ent in existing:
                    old_off = int(getattr(ent, "offset", 0))
                    old_len = max(0, int(getattr(ent, "length", 0)))
                    old_s = max(0, min(old_off, old_total))
                    old_e = max(old_s, min(old_s + old_len, old_total))
                    new_s = pos_map[old_s]
                    new_e = pos_map[old_e]
                    ent.offset = int(new_s)
                    ent.length = int(max(0, new_e - new_s))

                setattr(params, field, "".join(parts))

            set_entities(params, existing + new_ents)
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception:
            return HookResult()
