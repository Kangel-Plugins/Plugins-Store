__id__ = "account_hider"
__name__ = "AccountHider"
__category__ = ["privacy"]
__description__ = "Скрывает аккаунты из списков. Зажми «Аккаунт» в настройках, 2 раза тапни по профилю в навигации или зажми стрелку в боковом меню."
__author__ = "@RnPlugins"
__version__ = "1.0.3"
__icon__ = "RnDev/37"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.3.3"

import base64
from base_plugin import BasePlugin
from ui.settings import Header, Switch, Divider
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader

DEX_B64 = """"""

class Plugin(BasePlugin):
    PREF_DEFAULTS = {
        "mute_hidden": False,
        "sub_phone": False,
        "sub_id": True,
        "sub_username": False,
    }

    def _put_pref(self, key, value):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("account_hider_settings", 0)
            prefs.edit().putBoolean(key, bool(value)).commit()
        except Exception as e:
            self.log(f"Failed to sync pref {key}: {e}")

    def _sync_prefs(self):
        for key, default in self.PREF_DEFAULTS.items():
            self._put_pref(key, self.get_setting(key, default))

    def _on_mute_change(self, value):
        self._put_pref("mute_hidden", value)
        try:
            if getattr(self, "dex_class", None) is not None:
                self.dex_class.getMethod("applyNotifications").invoke(None)
        except Exception as e:
            self.log(f"Failed to apply notifications: {e}")

    def _on_pref_change(self, key):
        return lambda value: self._put_pref(key, value)

    def create_settings(self):
        return [
            Header(text="Уведомления"),
            Switch(
                key="mute_hidden",
                text="Заглушить скрытые",
                default=False,
                icon="msg_mute",
                on_change=self._on_mute_change,
            ),
            Divider(text="Без уведомлений от скрытых аккаунтов"),
            Header(text="Подпись аккаунта"),
            Switch(
                key="sub_phone",
                text="Номер",
                default=False,
                icon="msg_calls",
                on_change=self._on_pref_change("sub_phone"),
            ),
            Switch(
                key="sub_id",
                text="ID",
                default=True,
                icon="msg_info",
                on_change=self._on_pref_change("sub_id"),
            ),
            Switch(
                key="sub_username",
                text="Юзернейм",
                default=False,
                icon="msg_mention",
                on_change=self._on_pref_change("sub_username"),
            ),
        ]

    def on_plugin_load(self):
        try:
            self._sync_prefs()
            self.log("Loading Java AccountHider module...")
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)
            self.dex_class = self.dex_loader.loadClass("dev.rooni.accounthider.AccountHider")

            start_method = self.dex_class.getMethod("start")
            start_method.invoke(None)
            self.dex_class.getMethod("applyNotifications").invoke(None)
            self.log("Java AccountHider module loaded and started successfully.")
        except Exception as e:
            self.log(f"Failed to load Java AccountHider module: {e}")

    def on_plugin_unload(self):
        try:
            self.log("Unloading Java AccountHider module...")
            if hasattr(self, "dex_class") and self.dex_class is not None:
                stop_method = self.dex_class.getMethod("stop")
                stop_method.invoke(None)
                self.dex_class.getMethod("applyNotifications").invoke(None)
                self.log("Java AccountHider module stopped successfully.")
            self.dex_class = None
            self.dex_loader = None
        except Exception as e:
            self.log(f"Failed to unload Java AccountHider module: {e}")
