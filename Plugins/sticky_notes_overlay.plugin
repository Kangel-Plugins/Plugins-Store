    def _build_voice_content(self, note, ctx):
        layout = LinearLayout(ctx)
        layout.setOrientation(LinearLayout.VERTICAL)
        layout.setGravity(Gravity.CENTER)
        layout.setPadding(_dp(12), _dp(8), _dp(12), _dp(12))
        status_tv = TextView(ctx)
        status_tv.setText("Нажмите для записи")
        status_tv.setTextColor(_sub())
        status_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
        status_tv.setGravity(Gravity.CENTER)
        status_tv.setPadding(0, _dp(4), 0, _dp(8))
        b_record = self._create_main_button(ctx, "⏺  ЗАПИСЬ", None, bg_color=_tc("key_text_RedRegular", Color.parseColor("#F44336")))
        note["recording"] = False

        def record_click(v):
            try:
                if not note.get("recording"):
                    from android.media import MediaRecorder
                    rec = MediaRecorder()
                    rec.setAudioSource(MediaRecorder.AudioSource.MIC)
                    rec.setOutputFormat(MediaRecorder.OutputFormat.THREE_GPP)
                    path = os.path.join(self._plugin_dir_path, f"voice_{int(time.time())}.3gp")
                    rec.setOutputFile(path)
                    rec.setAudioEncoder(MediaRecorder.AudioEncoder.AMR_NB)
                    rec.prepare()
                    rec.start()
                    note["media_recorder"] = rec
                    note["recording"] = True
                    note["record_tv"].setText("⏹  СТОП")
                    b_record.getBackground().setColor(Color.parseColor("#757575"))
                    status_tv.setText("Запись...")
                else:
                    rec = note.get("media_recorder")
                    if rec:
                        rec.stop()
                        rec.release()
                        note["media_recorder"] = None
                    note["recording"] = False
                    note["record_tv"].setText("⏺  ЗАПИСЬ")
                    b_record.getBackground().setColor(_tc("key_text_RedRegular", Color.parseColor("#F44336")))
                    status_tv.setText("Сохранено!")
            except Exception as e:
                status_tv.setText(f"Ошибка: {e}")
        b_record.setOnClickListener(OnClickListener(record_click))
        try:
            note["record_tv"] = b_record.getChildAt(0)
        except Exception:
            note["record_tv"] = b_record
        layout.addView(status_tv)
        layout.addView(b_record, _llp(-1, -2))
        note["content"].addView(layout)

    def add_reminder_note(self, text="", delay=60):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(230), WindowManager.LayoutParams.WRAP_CONTENT,
                                          allow_resize=False, note_type="reminder")
            note["saved_data"] = {"text": text, "delay": delay}
            note["active"] = True
            self._build_reminder_content(note, ctx, text, delay)
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка напоминания: {e}")

    def _build_reminder_content(self, note, ctx, text, delay):
        layout = LinearLayout(ctx)
        layout.setOrientation(LinearLayout.VERTICAL)
        layout.setPadding(_dp(12), _dp(8), _dp(12), _dp(12))
        text_input = EditText(ctx)
        text_input.setText(text)
        text_input.setHint("Текст напоминания...")
        text_input.setHintTextColor(_hint())
        text_input.setTextColor(_ink())
        text_input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        text_input.setBackgroundColor(Color.TRANSPARENT)

        class TextInpHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, nd, et):
                super().__init__()
                self.plugin, self.nd, self.et = plugin, nd, et
            def onTouch(self, v, event):
                if event.getAction() == MotionEvent.ACTION_UP:
                    self.plugin._set_note_focusable(self.nd, True)
                    self.et.requestFocus()
                return False
        text_input.setOnTouchListener(TextInpHandler(self, note, text_input))

        delay_row = LinearLayout(ctx)
        delay_row.setOrientation(LinearLayout.HORIZONTAL)
        delay_row.setGravity(Gravity.CENTER_VERTICAL)
        delay_label = TextView(ctx)
        delay_label.setText("Через:")
        delay_label.setTextColor(_sub())
        delay_label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        delay_input = EditText(ctx)
        delay_input.setText(str(delay // 60))
        delay_input.setTextColor(_acc())
        delay_input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        delay_input.setBackgroundColor(Color.TRANSPARENT)
        delay_input.setInputType(InputType.TYPE_CLASS_NUMBER)
        delay_input.setFilters([InputFilter.LengthFilter(3)])
        mins = TextView(ctx)
        mins.setText("мин")
        mins.setTextColor(_sub())
        mins.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        delay_row.addView(delay_label)
        delay_row.addView(delay_input, _llp(_dp(50), -2))
        delay_row.addView(mins)

        status_tv = TextView(ctx)
        status_tv.setTextColor(_acc())
        status_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
        status_tv.setPadding(0, _dp(6), 0, _dp(6))

        b_set = self._create_main_button(ctx, "⏰  Установить", None)
        def set_click(v):
            try:
                txt = str(text_input.getText().toString()).strip()
                try: mm = int(str(delay_input.getText().toString()).strip() or "1")
                except ValueError: mm = 1
                secs = mm * 60
                status_tv.setText(f"Напомнит через {mm} мин")
                RunnableClass = find_class("java.lang.Runnable")
                class ReminderTask(dynamic_proxy(RunnableClass)):
                    def __init__(self, plugin, n, msg):
                        super().__init__()
                        self.plugin, self.n, self.msg = plugin, n, msg
                    def run(self):
                        if not self.n.get("active", True): return
                        BulletinHelper.show_success(f"📅 {self.msg}", get_last_fragment())
                        try:
                            c2 = self.n["container"].getContext()
                            vib = c2.getSystemService(c2.VIBRATOR_SERVICE)
                            if vib: vib.vibrate(500)
                        except Exception: pass
                task = ReminderTask(self, note, txt)
                Handler(Looper.getMainLooper()).postDelayed(task, secs * 1000)
                note["saved_data"] = {"text": txt, "delay": secs}
                self._save_state()
            except Exception: pass
        b_set.setOnClickListener(OnClickListener(set_click))

        layout.addView(text_input, _llp(-1, -2))
        layout.addView(View(ctx), _llp(-1, _dp(4)))
        layout.addView(delay_row)
        layout.addView(status_tv)
        layout.addView(b_set, _llp(-1, -2))
        note["content"].addView(layout)

