    def _build_link_content(self, note, ctx, url, title):
        layout = LinearLayout(ctx)
        layout.setOrientation(LinearLayout.VERTICAL)
        layout.setPadding(_dp(12), _dp(8), _dp(12), _dp(12))
        title_tv = TextView(ctx)
        title_tv.setText(title)
        title_tv.setTextColor(_ink())
        title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        url_input = EditText(ctx)
        url_input.setText(url)
        url_input.setHint("https://...")
        url_input.setHintTextColor(_hint())
        url_input.setTextColor(_acc())
        url_input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        url_input.setBackgroundColor(Color.TRANSPARENT)
        url_input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI)

        class UrlInputHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, nd, et):
                super().__init__()
                self.plugin, self.nd, self.et = plugin, nd, et
            def onTouch(self, v, event):
                if event.getAction() == MotionEvent.ACTION_UP:
                    self.plugin._set_note_focusable(self.nd, True)
                    self.et.requestFocus()
                return False
        url_input.setOnTouchListener(UrlInputHandler(self, note, url_input))

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        b_open = self._create_pill(ctx, "Открыть", ['msg_openin', 'msg_open'], None)
        b_copy = self._create_pill(ctx, None, ['msg_copy'], None)

        def open_url(v):
            try:
                u = str(url_input.getText().toString()).strip()
                if not u: return
                if not u.startswith("http"): u = "https://" + u
                Intent = find_class("android.content.Intent")
                Uri = find_class("android.net.Uri")
                intent = Intent(Intent.ACTION_VIEW, Uri.parse(u))
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                url_input.getContext().startActivity(intent)
                note["saved_data"] = {"url": u, "title": title}
                self._save_state()
            except Exception: pass
        def copy_url(v):
            try:
                ClipboardManager = find_class("android.content.ClipboardManager")
                ClipData = find_class("android.content.ClipData")
                cm = url_input.getContext().getSystemService(url_input.getContext().CLIPBOARD_SERVICE)
                cm.setPrimaryClip(ClipData.newPlainText("URL", str(url_input.getText().toString())))
            except Exception: pass
        b_open.setOnClickListener(OnClickListener(open_url))
        b_copy.setOnClickListener(OnClickListener(copy_url))
        row.addView(b_open, _llp(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, _dp(8), 0))
        row.addView(b_copy, _llp(-2, -2))
        layout.addView(title_tv)
        layout.addView(View(ctx), _llp(-1, _dp(4)))
        layout.addView(url_input, _llp(-1, -2))
        layout.addView(View(ctx), _llp(-1, _dp(6)))
        layout.addView(row)
        note["content"].addView(layout)

