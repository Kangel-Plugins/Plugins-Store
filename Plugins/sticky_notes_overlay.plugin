    def clear_all(self):
        if not self.wm:
            return
        for note in list(self.notes):
            self._destroy_note_content(note)
            try:
                if note["container"].isAttachedToWindow():
                    self.wm.removeView(note["container"])
            except Exception: pass
        self.notes.clear()
        try:
            if os.path.exists(self._state_path):
                os.remove(self._state_path)
        except Exception: pass

    def _clear_all_data(self):
        try:
            if os.path.exists(self._state_path):
                os.remove(self._state_path)
            settings_path = os.path.join(self._plugin_dir_path, "settings.json")
            if os.path.exists(settings_path):
                os.remove(settings_path)
            for f in os.listdir(self._plugin_dir_path):
                if f.startswith("photo_") or f.startswith("voice_"):
                    try: os.remove(os.path.join(self._plugin_dir_path, f))
                    except Exception: pass
            run_on_ui_thread(self.clear_all)
            BulletinHelper.show_success("Данные очищены", get_last_fragment())
        except Exception as e:
            self.log(f"Clear data: {e}")

    def _save_settings(self):
        try:
            settings_path = os.path.join(self._plugin_dir_path, "settings.json")
            with open(settings_path, "w", encoding="utf-8") as f:
                json.dump(self.settings, f, ensure_ascii=False, indent=2)
        except Exception: pass

    def _save_state(self):
        if not self.settings.get("auto_save"):
            return
        try:
            data = [s for s in (self._serialize_note(n) for n in self.notes) if s]
            with open(self._state_path, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except Exception as e:
            self.log(f"Save state: {e}")

    def _serialize_note(self, note):
        try:
            return {
                "type": note["type"], "x": note["p"].x, "y": note["p"].y,
                "width": note["p"].width, "height": note["p"].height,
                "theme": note.get("theme"), "opacity": note.get("opacity"),
                "locked": note.get("locked", False), "collapsed": note.get("collapsed", False),
                "orig_w": note.get("orig_w"), "orig_h": note.get("orig_h"),
                "saved_data": note.get("saved_data", {}),
            }
        except Exception:
            return None

    def _restore_notes(self):
        try:
            if not os.path.exists(self._state_path):
                return
            with open(self._state_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            for item in data:
                self._restore_single_note(item)
        except Exception as e:
            self.log(f"Restore notes: {e}")

    def _restore_single_note(self, item):
        try:
            t = item.get("type")
            sd = item.get("saved_data", {})
            theme = item.get("theme")
            if t == "text": self.add_text_note(text=sd.get("text", ""), theme=theme)
            elif t == "photo":
                path = sd.get("photo_path")
                if path and os.path.exists(path):
                    with open(path, "rb") as f:
                        b64 = base64.b64encode(f.read()).decode('utf-8')
                    self.add_photo_note(f"data:image/png;base64,{b64}", path)
                elif sd.get("photo_b64"):
                    self.add_photo_note(sd["photo_b64"], None)
            elif t == "todo": self.add_todo_note(tasks=sd.get("tasks", []))
            elif t == "timer": self.add_timer_note(seconds=sd.get("seconds", 60))
            elif t == "counter": self.add_counter_note(count=sd.get("count", 0))
            elif t == "canvas": self.add_canvas_note()
            elif t == "link": self.add_link_note(url=sd.get("url", ""), title=sd.get("title", ""))
            elif t == "clipboard": self.add_clipboard_note()
            elif t == "voice": self.add_voice_note()
            elif t == "reminder": self.add_reminder_note(text=sd.get("text", ""), delay=sd.get("delay", 60))
            elif t == "randomizer": self.add_randomizer_note(items=sd.get("items", []))
            else: return
            if self.notes:
                note = self.notes[-1]
                note["p"].x = item.get("x", note["p"].x)
                note["p"].y = item.get("y", note["p"].y)
                if item.get("width"): note["p"].width = item["width"]
                if item.get("height"): note["p"].height = item["height"]
                if item.get("locked"): note["locked"] = True
                if item.get("orig_w"): note["orig_w"] = item["orig_w"]
                if item.get("orig_h"): note["orig_h"] = item["orig_h"]
                if item.get("collapsed"): self._toggle_collapse(note)
                try:
                    if note["container"].isAttachedToWindow():
                        self.wm.updateViewLayout(note["container"], note["p"])
                except Exception: pass
        except Exception as e:
            self.log(f"Restore single note: {e}")