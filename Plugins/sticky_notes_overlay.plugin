try:
    from android_utils import OnClickListener
except Exception:
    class OnClickListener(dynamic_proxy(View.OnClickListener)):
        def __init__(self, fn):
            super().__init__()
            self._fn = fn
        def onClick(self, v):
            self._fn(v)


class _DismissListener(dynamic_proxy(DialogInterface.OnDismissListener)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn
    def onDismiss(self, d):
        try:
            self._fn(d)
        except Exception:
            pass


def _dp(v):
    if AndroidUtilities is not None:
        try:
            return int(AndroidUtilities.dp(v))
        except Exception:
            pass
    return int(v * 3)

def _tc(key, fallback):
    if Theme is not None:
        try:
            return Theme.getColor(getattr(Theme, key))
        except Exception:
            pass
    return fallback

def _ink():
    return _tc("key_dialogTextBlack", Color.WHITE)

def _sub():
    return _tc("key_dialogTextGray", Color.parseColor("#99FFFFFF"))

def _acc():
    return _tc("key_dialogTextBlue", Color.parseColor("#2196F3"))

def _hint():
    return _tc("key_inputTextHint", _tc("key_dialogTextGray3", Color.parseColor("#66FFFFFF")))

def _alpha_color(color_int, alpha):
    c = color_int & 0xFFFFFFFF
    c = (c & 0x00FFFFFF) | ((alpha & 0xFF) << 24)
    if c > 0x7FFFFFFF:
        c -= 0x100000000
    return int(c)

def _llp(w, h, gravity=None, ml=0, mt=0, mr=0, mb=0, weight=None):
    if weight is not None:
        lp = LinearLayout.LayoutParams(w, h, weight)
    else:
        lp = LinearLayout.LayoutParams(w, h)
    if gravity:
        lp.gravity = gravity
    if ml or mt or mr or mb:
        lp.setMargins(ml, mt, mr, mb)
    return lp

def _flp(w, h, gravity=None, ml=0, mt=0, mr=0, mb=0):
    lp = FrameLayout.LayoutParams(w, h)
    if gravity:
        lp.gravity = gravity
    if ml or mt or mr or mb:
        lp.setMargins(ml, mt, mr, mb)
    return lp



NOTE_THEMES = {
    "dark":   "#9E9E9E",
    "yellow": "#F5C518",
    "blue":   "#2196F3",
    "green":  "#4CAF50",
    "pink":   "#E91E63",
    "purple": "#9C27B0",
}

OPACITY_LEVELS = [("100%", 255), ("80%", 204), ("60%", 153), ("40%", 102), ("20%", 51)]
TIMER_PRESETS = [("1", 60), ("5", 300), ("15", 900), ("25", 1500)]

NOTE_META = {
    "text":      (['msg_photo_text2', 'input_keyboard_solar'], "Текст", "📝"),
    "photo":     (['msg_photo', 'msg_image', 'msg_media'], "Фото", "🖼"),
    "todo":      (['msg_check', 'msg_list_solar'], "Чек-лист", "✅"),
    "timer":     (['msg_clock', 'msg_timer', 'msg_history'], "Таймер", "⏳"),
    "counter":   (['msg_data', 'msg_list_solar'], "Счётчик", "🔢"),
    "canvas":    (['msg_draw', 'msg_paint', 'ai_chat'], "Рисовалка", "🎨"),
    "link":      (['msg_link', 'msg_url', 'msg_openin'], "Ссылка", "🔗"),
    "clipboard": (['msg_copy', 'msg_log'], "Буфер", "📋"),
    "voice":     (['msg_mic', 'msg_voice'], "Голосовая", "🎙"),
    "reminder":  (['msg_bell', 'msg_pin'], "Напоминание", "📅"),
    "randomizer":(['msg_dice', 'msg_shuffle'], "Рандомайзер", "🎲"),
}

NOTE_TYPES = [(k, v[1], v[0], v[2]) for k, v in NOTE_META.items()]


class ActivityResultHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        req_code, res_code, data = param.args
        if req_code == self.plugin.FILE_PICKER_REQUEST_CODE:
            param.setResult(None)
            self.plugin._handle_file_picker_result(res_code, data)


class StickyNotesPlugin(BasePlugin):
    FILE_PICKER_REQUEST_CODE = 4843

    def __init__(self):
        super().__init__()
        self.wm = None
        self.notes = []
        self.active = False
        self.hidden_all = False
        self.w = 1080
        self.h = 2400
        self.activity_hook = None
        self._plugin_dir_path = ""
        self._state_path = ""
        self.is_processing_file = False
        self._ui_lock = False
        self._needs_reattach = False
        self.settings = {
            "auto_save": True,
            "vibrate": True,
            "sound": True,
            "default_theme": "blue",
            "default_opacity": "100%",
        }

    def on_plugin_load(self):
        try:
            base_dir = ApplicationLoader.getFilesDirFixed()
            FileClass = find_class("java.io.File")
            plugin_folder = FileClass(base_dir, self.id)
            if not plugin_folder.exists():
                plugin_folder.mkdirs()
            self._plugin_dir_path = plugin_folder.getAbsolutePath()
            self._state_path = os.path.join(self._plugin_dir_path, "notes_state.json")
            settings_path = os.path.join(self._plugin_dir_path, "settings.json")
            if os.path.exists(settings_path):
                with open(settings_path, "r", encoding="utf-8") as f:
                    self.settings.update(json.load(f))
        except Exception as e:
            self.log(f"Ошибка инициализации: {e}")

        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Sticky Notes",
            icon="menu_sticker",
            item_id="start_sticky_notes_btn",
            on_click=self.on_menu_click
        ))
        self.log(f"StickyNotes: загружен, NATIVE_OK={NATIVE_OK}")
        run_on_ui_thread(self._restore_notes)

    def on_plugin_unload(self):
        self.active = False
        self._save_state()
        self._save_settings()
        if self.activity_hook:
            self.unhook_method(self.activity_hook)
        run_on_ui_thread(self.clear_all)

    def on_menu_click(self, context: Any):
        def _open():
            try:
                self.show_control_sheet()
            except Exception as e:
                self.log(f"StickyNotes: крах шторки:\n{traceback.format_exc()}")
                try:
                    BulletinHelper.show_error(f"Ошибка шторки: {e}", get_last_fragment())
                except Exception:
                    pass
                try:
                    self._show_fallback_dialog()
                except Exception as e2:
                    try:
                        BulletinHelper.show_error(f"Ошибка fallback: {e2}", get_last_fragment())
                    except Exception:
                        pass
        run_on_ui_thread(_open)


    def _get_activity(self):
        try:
            fragment = get_last_fragment()
            if fragment and fragment.getParentActivity():
                return fragment.getParentActivity()
        except Exception:
            pass
        try:
            if LaunchActivity is not None and LaunchActivity.instance is not None:
                return LaunchActivity.instance
        except Exception:
            pass
        return None

    def _get_ctx(self):
        act = self._get_activity()
        if act is not None:
            return act
        return ApplicationLoader.applicationContext

    def _ensure_wm(self):
        if self.wm is None:
            ctx = ApplicationLoader.applicationContext
            self.wm = ctx.getSystemService(Context.WINDOW_SERVICE)
            try:
                metrics = ctx.getResources().getDisplayMetrics()
                self.w = int(metrics.widthPixels)
                self.h = int(metrics.heightPixels)
            except Exception:
                pass

    def _fail(self, msg):
        self.log(msg)
        try:
            BulletinHelper.show_error(msg, get_last_fragment())
        except Exception:
            pass


    def _accent_of(self, note):
        return NOTE_THEMES.get(note.get("theme", "blue"), NOTE_THEMES["blue"])

    def _note_bg(self, opacity):
        base = _tc("key_dialogBackground", Color.parseColor("#FF2C2C2C"))
        alpha = 255
        for lbl, a in OPACITY_LEVELS:
            if lbl == opacity:
                alpha = a
                break
        return _alpha_color(base, alpha)


    def _attach_note(self, note, animate=True):
        if self._ui_lock:
            note["pending_add"] = True
            self._needs_reattach = True
            return
        try:
            self.wm.addView(note["container"], note["p"])
            if animate:
                c = note["container"]
                try:
                    c.setAlpha(0.0)
                    c.setScaleX(0.85)
                    c.setScaleY(0.85)
                    anim = c.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(250)
                    if AndroidUtilities is not None:
                        anim = anim.setInterpolator(AndroidUtilities.decelerateInterpolator)
                    anim.start()
                except Exception:
                    pass
        except Exception:
            pass

    def _on_sheet_dismiss(self, d=None):
        self._ui_lock = False
        if self._needs_reattach:
            self._needs_reattach = False
            self._reattach_all_notes()
        else:
            for note in list(self.notes):
                if note.pop("pending_add", False):
                    self._attach_note(note, animate=False)

    def _reattach_all_notes(self):
        if not self.wm:
            return
        for note in list(self.notes):
            note.pop("pending_add", None)
            try:
                if note["container"].isAttachedToWindow():
                    self.wm.removeView(note["container"])
            except Exception:
                pass
        if self.hidden_all:
            return
        for note in list(self.notes):
            self._attach_note(note, animate=False)

    def _restyle_all_notes(self):
        for note in list(self.notes):
            try:
                self._refresh_note_appearance(note)
                if not note.get("collapsed"):
                    self._rebuild_note_content(note)
            except Exception:
                pass
        BulletinHelper.show_success("Стиль обновлён", get_last_fragment())

    
    def _apply_press_scale(self, view):
        try:
            class _TouchListener(dynamic_proxy(View.OnTouchListener)):
                def __init__(self, fn):
                    super().__init__()
                    self._fn = fn
                def onTouch(self, v, event):
                    return self._fn(v, event)
            def _on_touch(v, event):
                try:
                    action = event.getActionMasked()
                    if action == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(0.94).scaleY(0.94).setDuration(100).start()
                    elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(200).start()
                except Exception:
                    pass
                return False
            view.setOnTouchListener(_TouchListener(_on_touch))
        except Exception:
            pass

    def _drawable(self, names):
        if R_tg is None:
            return 0
        for n in names:
            res = getattr(R_tg.drawable, n, 0)
            if res:
                return int(res)
        return 0

    def _pill_bg_color(self):
        return _tc("key_chat_inLoader", Color.parseColor("#80808080")) & 0x20FFFFFF | 0x10000000

    def _ripple(self, bg_drawable):
        try:
            return RippleDrawable(ColorStateList.valueOf(Color.parseColor("#40000000")), bg_drawable, None)
        except Exception:
            return bg_drawable

    def _type_icon(self, ctx, ntype, color, size=22):
        names, _, emoji = NOTE_META.get(ntype, (['msg_settings'], "", "📌"))
        res = self._drawable(names)
        if res:
            iv = ImageView(ctx)
            iv.setImageResource(res)
            iv.setScaleType(ImageView.ScaleType.CENTER)
            iv.setColorFilter(color)
            return iv
        ev = TextView(ctx)
        ev.setText(emoji)
        ev.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        ev.setGravity(Gravity.CENTER)
        return ev

    def _icon_btn(self, ctx, names, fallback, color, on_click):
        res = self._drawable(names)
        if res:
            v = ImageView(ctx)
            v.setImageResource(res)
            v.setScaleType(ImageView.ScaleType.CENTER)
            v.setColorFilter(color)
            v.setPadding(_dp(4), _dp(4), _dp(4), _dp(4))
        else:
            v = TextView(ctx)
            v.setText(fallback)
            v.setTextColor(color)
            v.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            v.setGravity(Gravity.CENTER)
            v.setPadding(_dp(6), _dp(4), _dp(6), _dp(4))
        v.setOnClickListener(OnClickListener(on_click))
        self._apply_press_scale(v)
        return v


    def _new_sheet(self):
        if not NATIVE_OK:
            raise RuntimeError("BottomSheet/Theme недоступны")
        act = self._get_activity()
        if act is None:
            raise RuntimeError("Нет активности для BottomSheet")
        fragment = get_last_fragment()
        try:
            sheet = BottomSheet(act, True, fragment.getResourceProvider())
        except Exception:
            sheet = BottomSheet(act, True)
        try: sheet.setAllowNestedScroll(True)
        except Exception: pass
        try: sheet.setCanDismissWithSwipe(True)
        except Exception: pass
        try: sheet.setBackgroundColor(_tc("key_dialogBackground", Color.parseColor("#FF2C2C2C")))
        except Exception: pass
        try:
            win = sheet.getWindow()
            if win is not None:
                win.setType(WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY if Build.VERSION.SDK_INT >= 26 else WindowManager.LayoutParams.TYPE_PHONE)
        except Exception:
            pass

        root = FrameLayout(act)
        try:
            bg = GradientDrawable()
            bg.setShape(GradientDrawable.RECTANGLE)
            bg.setCornerRadii([_dp(20), _dp(20), _dp(20), _dp(20), 0, 0, 0, 0])
            bg.setColor(_tc("key_dialogBackground", Color.parseColor("#FF2C2C2C")))
            root.setBackground(bg)
        except Exception:
            pass

        content = LinearLayout(act)
        content.setOrientation(LinearLayout.VERTICAL)
        content.setPadding(_dp(16), _dp(10), _dp(16), _dp(10))
        root.addView(content, _flp(-1, -2))

        cross = TextView(act)
        cross.setText("✕")
        cross.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        cross.setGravity(Gravity.CENTER)
        cross.setPadding(_dp(12), _dp(8), _dp(12), _dp(8))
        cross.setTextColor(_tc("key_dialogTextGray", Color.parseColor("#88FFFFFF")))
        cross.setOnClickListener(OnClickListener(lambda v: sheet.dismiss()))
        self._apply_press_scale(cross)
        root.addView(cross, _flp(-2, -2, Gravity.TOP | Gravity.RIGHT))

        try:
            root.setAlpha(0.0)
            root.setScaleX(0.3)
            root.setScaleY(0.3)
            root.setTranslationY(_dp(100))
        except Exception:
            pass
        return sheet, root, content

    def _show_sheet(self, sheet, root, animated_views=None):
        self._ui_lock = True
        try:
            sheet.setOnDismissListener(_DismissListener(self._on_sheet_dismiss))
        except Exception:
            pass
        sheet.setCustomView(root)
        sheet.show()
        def animate_elements():
            try:
                anim = root.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).translationY(0).setDuration(300)
                if AndroidUtilities is not None:
                    anim = anim.setInterpolator(AndroidUtilities.decelerateInterpolator)
                anim.start()
            except Exception:
                try:
                    root.setAlpha(1.0); root.setScaleX(1.0); root.setScaleY(1.0); root.setTranslationY(0)
                except Exception: pass
            if animated_views:
                def show_elements():
                    delay = 50
                    for v in animated_views:
                        try:
                            v.animate().alpha(1.0).translationY(0).scaleX(1.0).scaleY(1.0).setDuration(350).setStartDelay(delay).start()
                        except Exception: pass
                        delay += 50
                run_on_ui_thread(show_elements)
        run_on_ui_thread(animate_elements)

    def _prepare_anim(self, view):
        try:
            view.setAlpha(0.0)
            view.setTranslationY(_dp(40))
            view.setScaleX(0.85)
            view.setScaleY(0.85)
        except Exception:
            pass
        return view


    def _create_title(self, ctx, text):
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
        tv.setGravity(Gravity.CENTER)
        try:
            if AndroidUtilities:
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass
        tv.setTextColor(_ink())
        return tv

    def _create_info_tab(self, ctx, text):
        tab = TextView(ctx)
        tab.setText(text)
        tab.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        tab.setGravity(Gravity.CENTER)
        tab.setPadding(_dp(10), _dp(4), _dp(10), _dp(4))
        try:
            bg = GradientDrawable()
            bg.setCornerRadius(_dp(10))
            bg.setColor(self._pill_bg_color() | 0x20000000)
            tab.setBackground(bg)
        except Exception:
            pass
        tab.setTextColor(_acc())
        return tab

    def _create_pill(self, ctx, text, icon_names, on_click, text_color=None):
        frame = FrameLayout(ctx)
        bg = GradientDrawable()
        bg.setCornerRadius(_dp(18))
        bg.setColor(self._pill_bg_color())
        frame.setBackground(self._ripple(bg))
        frame.setPadding(_dp(12), _dp(8), _dp(12), _dp(8))
        inner = LinearLayout(ctx)
        inner.setOrientation(LinearLayout.HORIZONTAL)
        inner.setGravity(Gravity.CENTER_VERTICAL)
        res = self._drawable(icon_names) if icon_names else 0
        if res:
            iv = ImageView(ctx)
            iv.setImageResource(res)
            iv.setScaleType(ImageView.ScaleType.CENTER)
            iv.setColorFilter(text_color or _acc())
            inner.addView(iv, _llp(_dp(24), _dp(24), Gravity.CENTER_VERTICAL, 0, 0, (_dp(8) if text else 0), 0))
        if text:
            tv = TextView(ctx)
            tv.setText(text)
            tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            tv.setTextColor(text_color or _acc())
            tv.setGravity(Gravity.CENTER_VERTICAL)
            inner.addView(tv, _llp(-2, -2, Gravity.CENTER_VERTICAL))
        frame.addView(inner, _flp(-2, -2, Gravity.CENTER))
        if on_click:
            frame.setOnClickListener(OnClickListener(on_click))
        self._apply_press_scale(frame)
        return frame

    def _create_main_button(self, ctx, text, on_click, bg_color=None):
        frame = FrameLayout(ctx)
        bg = GradientDrawable()
        bg.setShape(GradientDrawable.RECTANGLE)
        bg.setCornerRadius(_dp(28))
        bg.setColor(bg_color or _tc("key_featuredStickers_addButton", Color.parseColor("#2196F3")))
        frame.setBackground(bg)
        frame.setPadding(0, _dp(12), 0, _dp(12))
        frame.setClickable(True)
        frame.setFocusable(True)
        tv = TextView(ctx)
        tv.setText(text)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        tv.setGravity(Gravity.CENTER)
        try:
            if AndroidUtilities:
                tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass
        tv.setTextColor(_tc("key_featuredStickers_buttonText", Color.WHITE))
        frame.addView(tv, _flp(-2, -2, Gravity.CENTER))
        frame.setOnClickListener(OnClickListener(on_click))
        self._apply_press_scale(frame)
        return frame

    def _create_row(self, ctx, icon_names, emoji, label, on_click, label_color=None):
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(_dp(14), _dp(11), _dp(14), _dp(11))
        bg = GradientDrawable()
        bg.setCornerRadius(_dp(14))
        bg.setColor(Color.TRANSPARENT)
        try:
            ripple_color = ColorStateList.valueOf(_tc("key_listSelector", Color.parseColor("#30808080")))
            row.setBackground(RippleDrawable(ripple_color, bg, None))
        except Exception:
            row.setBackground(self._ripple(bg))
        res = self._drawable(icon_names) if icon_names else 0
        if res:
            iv = ImageView(ctx)
            iv.setImageResource(res)
            iv.setScaleType(ImageView.ScaleType.CENTER)
            iv.setColorFilter(_acc())
            row.addView(iv, _llp(_dp(26), _dp(26), Gravity.CENTER_VERTICAL, 0, 0, _dp(12), 0))
        else:
            ev = TextView(ctx)
            ev.setText(emoji)
            ev.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
            row.addView(ev, _llp(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, _dp(12), 0))
        tv = TextView(ctx)
        tv.setText(label)
        tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
        tv.setTextColor(label_color or _ink())
        row.addView(tv, _llp(0, -2, Gravity.CENTER_VERTICAL, weight=1.0))
        row.setClickable(True)
        row.setFocusable(True)
        if on_click:
            row.setOnClickListener(OnClickListener(on_click))
        return row


    def show_control_sheet(self):
        sheet, root, content = self._new_sheet()
        ctx = root.getContext()
        animated = []

        title = self._create_title(ctx, "Sticky Notes")
        content.addView(title, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(6)))
        animated.append(self._prepare_anim(title))

        info_row = LinearLayout(ctx)
        info_row.setOrientation(LinearLayout.HORIZONTAL)
        info_row.setGravity(Gravity.CENTER)
        info_row.addView(self._create_info_tab(ctx, f"Заметок: {len(self.notes)}"), _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(8), 0))
        if self.hidden_all:
            info_row.addView(self._create_info_tab(ctx, "Скрыты"), _llp(-2, -2, Gravity.CENTER))
        content.addView(info_row, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(10)))
        animated.append(self._prepare_anim(info_row))

        scroll = NestedScrollView(ctx)
        try:
            scroll.setVerticalScrollBarEnabled(False)
            scroll.setNestedScrollingEnabled(True)
        except Exception:
            pass
        types_lin = LinearLayout(ctx)
        types_lin.setOrientation(LinearLayout.VERTICAL)

        actions_map = {
            "text": lambda: self.add_text_note(),
            "photo": lambda: self._launch_file_picker(),
            "todo": lambda: self.add_todo_note(),
            "timer": lambda: self.add_timer_note(),
            "counter": lambda: self.add_counter_note(),
            "canvas": lambda: self.add_canvas_note(),
            "link": lambda: self.add_link_note(),
            "clipboard": lambda: self.add_clipboard_note(),
            "voice": lambda: self.add_voice_note(),
            "reminder": lambda: self.add_reminder_note(),
            "randomizer": lambda: self.add_randomizer_note(),
        }
        for ntype, label, icons, emoji in NOTE_TYPES:
            cb = actions_map[ntype]
            def make_click(action):
                def click(v):
                    try: sheet.dismiss()
                    except Exception: pass
                    run_on_ui_thread(action)
                return click
            types_lin.addView(self._create_row(ctx, icons, emoji, label, make_click(cb)), _llp(-1, -2))
        scroll.addView(types_lin, _flp(-1, -2))
        content.addView(scroll, _llp(-1, -2, None, 0, 0, 0, _dp(10)))
        animated.append(self._prepare_anim(scroll))

        toolbar_scroll = HorizontalScrollView(ctx)
        toolbar_scroll.setHorizontalScrollBarEnabled(False)
        toolbar_scroll.setFillViewport(True)
        toolbar_scroll.setHorizontalFadingEdgeEnabled(True)
        try: toolbar_scroll.setFadingEdgeLength(_dp(16))
        except Exception: pass
        toolbar = LinearLayout(ctx)
        toolbar.setOrientation(LinearLayout.HORIZONTAL)
        toolbar.setGravity(Gravity.CENTER)
        hide_text = "Показать" if self.hidden_all else "Скрыть"
        toolbar.addView(self._create_pill(ctx, hide_text, ['msg_hide', 'msg_eye'], lambda v: self.toggle_hide_all()), _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(8), 0))
        toolbar.addView(self._create_pill(ctx, "Стиль", ['msg_paint', 'msg_draw', 'msg_settings'], lambda v: self._restyle_all_notes()), _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(8), 0))
        toolbar.addView(self._create_pill(ctx, "Очистить", ['msg_delete', 'msg_clear'], lambda v: self.clear_all()), _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(8), 0))
        toolbar.addView(self._create_pill(ctx, "Сохранить", ['msg_save', 'msg_download_solar'], lambda v: self._save_state()), _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(8), 0))
        toolbar.addView(self._create_pill(ctx, "Настройки", ['msg_settings'], lambda v: self.open_plugin_settings()), _llp(-2, -2, Gravity.CENTER))
        toolbar_scroll.addView(toolbar, _flp(-2, -2))
        content.addView(toolbar_scroll, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(12)))
        animated.append(self._prepare_anim(toolbar_scroll))

        close_btn = self._create_main_button(ctx, "Закрыть", lambda v: sheet.dismiss())
        content.addView(close_btn, _llp(-1, -2))
        animated.append(self._prepare_anim(close_btn))

        self._show_sheet(sheet, root, animated)

    def _show_fallback_dialog(self):
        act = self._get_activity()
        if act is None:
            raise RuntimeError("Нет активности даже для fallback-диалога")
        options = [f"{e}  {label}" for _, label, _, e in NOTE_TYPES]
        options += ["👁  Скрыть/показать все", "🧹  Очистить всё", "💾  Сохранить"]
        actions = [
            lambda: self.add_text_note(), lambda: self._launch_file_picker(),
            lambda: self.add_todo_note(), lambda: self.add_timer_note(),
            lambda: self.add_counter_note(), lambda: self.add_canvas_note(),
            lambda: self.add_link_note(), lambda: self.add_clipboard_note(),
            lambda: self.add_voice_note(), lambda: self.add_reminder_note(),
            lambda: self.add_randomizer_note(),
            lambda: self.toggle_hide_all(), lambda: self.clear_all(), lambda: self._save_state(),
        ]
        def handle_click(dialog, which):
            dialog.dismiss()
            run_on_ui_thread(actions[which])
        class DialogClickListener(dynamic_proxy(DialogInterface.OnClickListener)):
            def onClick(self, dialog, which):
                handle_click(dialog, which)
        builder = AlertDialog.Builder(act)
        builder.setTitle("Sticky Notes")
        builder.setItems(options, DialogClickListener())
        dialog = builder.create()
        window = dialog.getWindow()
        if window:
            t = WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY if Build.VERSION.SDK_INT >= 26 else WindowManager.LayoutParams.TYPE_PHONE
            window.setType(t)
        dialog.show()

    def open_plugin_settings(self):
        try:
            from com.exteragram.messenger.plugins import PluginsController
            from com.exteragram.messenger.plugins.ui import PluginSettingsActivity
            fragment = get_last_fragment()
            plugin = PluginsController.getInstance().plugins.get(self.id)
            if plugin and fragment:
                fragment.presentFragment(PluginSettingsActivity(plugin))
        except Exception as e:
            self.log(f"Open settings error: {e}")

    def create_settings(self):
        if not Header:
            return []
        theme_names = list(NOTE_THEMES.keys())
        opacity_names = [l for l, _ in OPACITY_LEVELS]
        items = [Header(text="Sticky Notes")]
        items.append(Switch(key='auto_save', text="Автосохранение заметок",
                            default=self.settings.get('auto_save', True),
                            on_change=lambda v: self._set_opt('auto_save', v)))
        items.append(Switch(key='vibrate', text="Вибрация по таймеру",
                            default=self.settings.get('vibrate', True),
                            on_change=lambda v: self._set_opt('vibrate', v)))
        items.append(Switch(key='sound', text="Уведомление по таймеру",
                            default=self.settings.get('sound', True),
                            on_change=lambda v: self._set_opt('sound', v)))
        items.append(Divider())
        items.append(Header(text="Новые заметки"))
        items.append(Selector(key='default_theme', text="Акцентный цвет",
                              items=[n.capitalize() for n in theme_names],
                              default=theme_names.index(self.settings.get('default_theme', 'blue')) if self.settings.get('default_theme', 'blue') in theme_names else 2,
                              on_change=lambda idx: self._set_opt('default_theme', theme_names[max(0, min(int(idx), len(theme_names)-1))])))
        items.append(Selector(key='default_opacity', text="Прозрачность по умолчанию",
                              items=opacity_names,
                              default=opacity_names.index(self.settings.get('default_opacity', '100%')) if self.settings.get('default_opacity', '100%') in opacity_names else 0,
                              on_change=lambda idx: self._set_opt('default_opacity', opacity_names[max(0, min(int(idx), len(opacity_names)-1))])))
        items.append(Divider())
        items.append(Text(text="Очистить все данные плагина", icon='msg_delete',
                          on_click=lambda ctx: run_on_ui_thread(self._clear_all_data)))
        items.append(Divider())
        return items

    def _set_opt(self, key, value):
        self.settings[key] = value
        self._save_settings()


    def _set_note_focusable(self, note, focusable):
        try:
            p = note["p"]
            if focusable:
                p.flags &= ~WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
            else:
                p.flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                ctx = note["container"].getContext()
                imm = ctx.getSystemService(ctx.INPUT_METHOD_SERVICE)
                if imm:
                    imm.hideSoftInputFromWindow(note["container"].getWindowToken(), 0)
            if note["container"].isAttachedToWindow():
                self.wm.updateViewLayout(note["container"], p)
        except Exception:
            pass

    def _launch_file_picker(self):
        if self.is_processing_file:
            return
        self.is_processing_file = True
        try:
            activity = self._get_activity()
            if not activity:
                raise RuntimeError("Нет активности")
            if self.activity_hook:
                self.unhook_method(self.activity_hook)
            IntegerClass = find_class("java.lang.Integer")
            IntentClass = find_class("android.content.Intent")
            method = activity.getClass().getDeclaredMethod(
                "onActivityResult", IntegerClass.TYPE, IntegerClass.TYPE, IntentClass)
            self.activity_hook = self.hook_method(method, ActivityResultHook(self))
            from android.content import Intent
            intent = Intent(Intent.ACTION_GET_CONTENT).setType("image/*")
            activity.startActivityForResult(Intent.createChooser(intent, "Выберите фото"),
                                            self.FILE_PICKER_REQUEST_CODE)
        except Exception as e:
            if self.activity_hook:
                self.unhook_method(self.activity_hook)
                self.activity_hook = None
            self.is_processing_file = False
            self._fail(f"Ошибка галереи: {e}")

    def _handle_file_picker_result(self, res_code, data):
        if self.activity_hook:
            self.unhook_method(self.activity_hook)
            self.activity_hook = None
        if res_code == -1 and data and data.getData():
            run_on_queue(lambda: self._handle_file_uri(data.getData()))
        else:
            self.is_processing_file = False

    def _handle_file_uri(self, uri):
        istream = None
        try:
            istream = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri)
            if not istream:
                raise IOError("Не удалось открыть файл.")
            from android.graphics import BitmapFactory
            from java.io import ByteArrayOutputStream
            options = find_class("android.graphics.BitmapFactory$Options")()
            options.inSampleSize = 2
            bitmap = BitmapFactory.decodeStream(istream, None, options)
            if bitmap:
                out_stream = ByteArrayOutputStream()
                bitmap.compress(find_class("android.graphics.Bitmap$CompressFormat").PNG, 90, out_stream)
                bytes_data = out_stream.toByteArray()
                out_stream.close()
                bitmap.recycle()
                b64 = base64.b64encode(bytes(bytes_data)).decode('utf-8')
                photo_b64 = f"data:image/png;base64,{b64}"
                photo_path = os.path.join(self._plugin_dir_path, f"photo_{int(time.time())}.png")
                with open(photo_path, "wb") as f:
                    f.write(bytes_data)
                run_on_ui_thread(lambda: self.add_photo_note(photo_b64, photo_path))
        except Exception as e:
            self._fail(f"Ошибка фото: {e}")
        finally:
            try:
                if istream: istream.close()
            except Exception: pass
            self.is_processing_file = False

    def toggle_hide_all(self):
        self.hidden_all = not self.hidden_all
        if self.hidden_all:
            for note in list(self.notes):
                try:
                    if note["container"].isAttachedToWindow():
                        self.wm.removeView(note["container"])
                except Exception: pass
        else:
            if self._ui_lock:
                self._needs_reattach = True
            else:
                for note in list(self.notes):
                    self._attach_note(note, animate=False)


    def _create_note_base(self, ctx, width, height, allow_resize=True,
                          note_type="text", theme=None, opacity=None):
        self._ensure_wm()
        theme = theme or self.settings.get("default_theme", "blue")
        opacity = opacity or self.settings.get("default_opacity", "100%")
        accent = NOTE_THEMES.get(theme, NOTE_THEMES["blue"])
        accent_int = Color.parseColor(accent)

        root_container = FrameLayout(ctx)
        main_body = LinearLayout(ctx)
        main_body.setOrientation(LinearLayout.VERTICAL)

        bg = GradientDrawable()
        bg.setColor(self._note_bg(opacity))
        bg.setCornerRadius(_dp(16))
        main_body.setBackground(bg)
        main_body.setClipToOutline(True)

        # Шапка в стиле меню: иконка типа + заголовок rmedium + нативные иконки
        header = LinearLayout(ctx)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        header.setPadding(_dp(10), _dp(8), _dp(6), _dp(8))
        header.setBackgroundColor(_alpha_color(accent_int, 0x26))

        type_icon = self._type_icon(ctx, note_type, accent_int)
        header.addView(type_icon, _llp(_dp(22), _dp(22), Gravity.CENTER_VERTICAL, 0, 0, _dp(8), 0))

        _, type_title, _ = NOTE_META.get(note_type, ([], "Заметка", "📌"))
        title_tv = TextView(ctx)
        title_tv.setText(type_title)
        title_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        try:
            if AndroidUtilities:
                title_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass
        title_tv.setTextColor(_ink())
        title_tv.setSingleLine(True)
        header.addView(title_tv, _llp(0, -2, Gravity.CENTER_VERTICAL, weight=1.0))

        btn_menu = self._icon_btn(ctx, ['msg_more', 'menu_more', 'msg_menu', 'ic_ab_other'], "⋮", _sub(), lambda v: self._show_note_menu(note_data))
        btn_close = self._icon_btn(ctx, ['msg_close', 'livelocation_close', 'cross'], "✕", _sub(), lambda v: self._cleanup_and_remove(note_data))
        header.addView(btn_menu, _llp(-2, -2, Gravity.CENTER_VERTICAL))
        header.addView(btn_close, _llp(-2, -2, Gravity.CENTER_VERTICAL))
        main_body.addView(header, _llp(-1, -2))

        divider = View(ctx)
        divider.setBackgroundColor(_tc("key_divider", Color.parseColor("#30808080")))
        main_body.addView(divider, _llp(-1, _dp(1)))

        content_frame = FrameLayout(ctx)
        main_body.addView(content_frame, _llp(-1, -1, weight=1.0))

        body_h = -1 if height != WindowManager.LayoutParams.WRAP_CONTENT else -2
        root_container.addView(main_body, _flp(-1, body_h))

        p = WindowManager.LayoutParams()
        p.width, p.height = width, height
        p.flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
        p.format = PixelFormat.TRANSLUCENT
        p.gravity = Gravity.TOP | Gravity.LEFT
        p.x, p.y = self.w // 2 - (width // 2 if width > 0 else 200), self.h // 2 - 200
        p.type = WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY if Build.VERSION.SDK_INT >= 26 else WindowManager.LayoutParams.TYPE_PHONE

        note_data = {
            "container": root_container, "p": p, "content": content_frame,
            "header": header, "type": note_type, "theme": theme, "opacity": opacity,
            "locked": False, "collapsed": False, "main_body": main_body, "saved_data": {},
            "header_icon": type_icon, "header_bg_view": header, "accent": accent_int,
        }
        self.notes.append(note_data)

        if allow_resize:
            resize_handle = TextView(ctx)
            resize_handle.setText("◢")
            resize_handle.setTextColor(_sub())
            resize_handle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11)
            resize_handle.setGravity(Gravity.BOTTOM | Gravity.RIGHT)
            root_container.addView(resize_handle, _flp(_dp(32), _dp(32), Gravity.BOTTOM | Gravity.RIGHT))

            class ResizeTouchHandler(dynamic_proxy(View.OnTouchListener)):
                def __init__(self, plugin, n_data):
                    super().__init__()
                    self.plugin, self.nd = plugin, n_data
                    self.startX, self.startY, self.startW, self.startH = 0, 0, 0, 0
                    self.minW = _dp(160)
                    self.minH = _dp(120)
                def onTouch(self, v, event):
                    if self.nd.get("locked"): return True
                    act = event.getAction()
                    if act == MotionEvent.ACTION_DOWN:
                        self.startX, self.startY = event.getRawX(), event.getRawY()
                        self.startW = self.nd["container"].getWidth()
                        self.startH = self.nd["container"].getHeight()
                        v.setTextColor(_acc())
                        return True
                    elif act == MotionEvent.ACTION_MOVE:
                        self.nd["p"].width = max(self.minW, self.startW + int(event.getRawX() - self.startX))
                        self.nd["p"].height = max(self.minH, self.startH + int(event.getRawY() - self.startY))
                        try: self.plugin.wm.updateViewLayout(self.nd["container"], self.nd["p"])
                        except Exception: pass
                        return True
                    elif act in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                        v.setTextColor(_sub())
                        self.plugin._save_state()
                        return True
                    return False
            resize_handle.setOnTouchListener(ResizeTouchHandler(self, note_data))

        class DragTouchHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, n_data):
                super().__init__()
                self.plugin, self.nd = plugin, n_data
                self.startX, self.startY, self.startViewX, self.startViewY = 0, 0, 0, 0
            def onTouch(self, v, event):
                if self.nd.get("locked"): return True
                act = event.getAction()
                if act == MotionEvent.ACTION_DOWN:
                    self.plugin._set_note_focusable(self.nd, False)
                    self.startX, self.startY = event.getRawX(), event.getRawY()
                    self.startViewX, self.startViewY = self.nd["p"].x, self.nd["p"].y
                    return True
                elif act == MotionEvent.ACTION_MOVE:
                    self.nd["p"].x = self.startViewX + int(event.getRawX() - self.startX)
                    self.nd["p"].y = self.startViewY + int(event.getRawY() - self.startY)
                    try: self.plugin.wm.updateViewLayout(self.nd["container"], self.nd["p"])
                    except Exception: pass
                    return True
                elif act == MotionEvent.ACTION_UP:
                    self.plugin._save_state()
                    return True
                return False
        header.setOnTouchListener(DragTouchHandler(self, note_data))
        return note_data

    def _destroy_note_content(self, note):
        try:
            if note.get("type") == "timer": note["running"] = False
            if note.get("type") == "reminder": note["active"] = False
            content = note.get("content")
            if content:
                for i in range(content.getChildCount()):
                    child = content.getChildAt(i)
                    if child and "WebView" in str(type(child)):
                        try:
                            child.loadUrl("about:blank")
                            child.destroy()
                        except Exception: pass
            if note.get("media_recorder"):
                try:
                    note["media_recorder"].stop()
                    note["media_recorder"].release()
                except Exception: pass
        except Exception:
            pass

    def _cleanup_and_remove(self, note):
        self._destroy_note_content(note)
        try:
            c = note["container"]
            if c.isAttachedToWindow():
                try:
                    c.animate().alpha(0.0).scaleX(0.8).scaleY(0.8).setDuration(150).start()
                except Exception: pass
                self.wm.removeView(c)
        except Exception: pass
        if note in self.notes:
            self.notes.remove(note)
        self._save_state()


    def _show_note_menu(self, note):
        try:
            sheet, root, content = self._new_sheet()
            ctx = root.getContext()
            animated = []

            title = self._create_title(ctx, "Меню заметки")
            content.addView(title, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(10)))
            animated.append(self._prepare_anim(title))

            colors_row = LinearLayout(ctx)
            colors_row.setOrientation(LinearLayout.HORIZONTAL)
            colors_row.setGravity(Gravity.CENTER)
            for name, hexc in NOTE_THEMES.items():
                dot = View(ctx)
                dbg = GradientDrawable()
                dbg.setShape(GradientDrawable.OVAL)
                dbg.setColor(Color.parseColor(hexc))
                if note.get("theme") == name:
                    dbg.setStroke(_dp(2), _ink())
                dot.setBackground(dbg)
                def make_color(n):
                    def click(v):
                        self._apply_theme(note, n)
                    return click
                dot.setOnClickListener(OnClickListener(make_color(name)))
                self._apply_press_scale(dot)
                colors_row.addView(dot, _llp(_dp(30), _dp(30), Gravity.CENTER_VERTICAL, 0, 0, _dp(10), 0))
            content.addView(colors_row, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(10)))
            animated.append(self._prepare_anim(colors_row))

            opacity_row = LinearLayout(ctx)
            opacity_row.setOrientation(LinearLayout.HORIZONTAL)
            opacity_row.setGravity(Gravity.CENTER)
            for lbl, _ in OPACITY_LEVELS:
                tab = self._create_info_tab(ctx, lbl)
                if note.get("opacity") == lbl:
                    try:
                        abg = GradientDrawable()
                        abg.setCornerRadius(_dp(10))
                        abg.setColor(_acc())
                        tab.setBackground(abg)
                        tab.setTextColor(Color.WHITE)
                    except Exception: pass
                def make_op(l):
                    def click(v):
                        self._apply_opacity(note, l)
                    return click
                tab.setOnClickListener(OnClickListener(make_op(lbl)))
                opacity_row.addView(tab, _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(6), 0))
            content.addView(opacity_row, _llp(-1, -2, Gravity.CENTER, 0, 0, 0, _dp(12)))
            animated.append(self._prepare_anim(opacity_row))

            divider = View(ctx)
            divider.setBackgroundColor(_tc("key_divider", Color.parseColor("#30808080")))
            content.addView(divider, _llp(-1, _dp(1), None, 0, 0, _dp(10)))

            def row_action(fn, close_after=False):
                def click(v):
                    def _run():
                        fn()
                        if close_after:
                            try: sheet.dismiss()
                            except Exception: pass
                    run_on_ui_thread(_run)
                return click

            rows_def = [
                (['msg_pin'], "🔒", "Закрепить" if not note.get("locked") else "Открепить", lambda: self._toggle_lock(note), False, False),
                (['msg_down'], "📌", "Развернуть" if note.get("collapsed") else "Свернуть", lambda: self._toggle_collapse(note), False, False),
                (['msg_top'], "⬆", "На передний план", lambda: self._bring_to_front(note), False, False),
                (['msg_bottom'], "⬇", "На задний план", lambda: self._send_to_back(note), False, False),
                (['msg_copy'], "📋", "Дублировать", lambda: self._duplicate_note(note), False, False),
            ]
            if note.get("type") == "text":
                rows_def.append((['msg_copy'], "📎", "Скопировать текст", lambda: self._copy_text_note(note), False, False))
            rows_def.append((['msg_delete'], "🗑", "Удалить", lambda: self._cleanup_and_remove(note), True, True))

            for icons, emoji, label, fn, is_red, close_after in rows_def:
                lcolor = _tc("key_text_RedRegular", Color.RED) if is_red else None
                row = self._create_row(ctx, icons, emoji, label, row_action(fn, close_after), label_color=lcolor)
                content.addView(row, _llp(-1, -2))
                animated.append(self._prepare_anim(row))

            self._show_sheet(sheet, root, animated)
        except Exception as e:
            self.log(f"Note menu error: {e}\n{traceback.format_exc()}")
            self._show_note_menu_fallback(note)

    def _show_note_menu_fallback(self, note):
        act = self._get_activity()
        if act is None:
            return
        keys = ["lock", "collapse", "front", "back", "duplicate"]
        options = ["Закрепить/открепить", "Свернуть/развернуть", "На передний план",
                   "На задний план", "Дублировать"]
        if note.get("type") == "text":
            keys.append("copy"); options.append("Скопировать текст")
        keys.append("delete"); options.append("Удалить")
        def handle_click(dialog, which):
            dialog.dismiss()
            k = keys[which]
            if k == "lock": run_on_ui_thread(lambda: self._toggle_lock(note))
            elif k == "collapse": run_on_ui_thread(lambda: self._toggle_collapse(note))
            elif k == "front": run_on_ui_thread(lambda: self._bring_to_front(note))
            elif k == "back": run_on_ui_thread(lambda: self._send_to_back(note))
            elif k == "duplicate": run_on_ui_thread(lambda: self._duplicate_note(note))
            elif k == "copy": run_on_ui_thread(lambda: self._copy_text_note(note))
            elif k == "delete": run_on_ui_thread(lambda: self._cleanup_and_remove(note))
        class DCL(dynamic_proxy(DialogInterface.OnClickListener)):
            def onClick(self, dialog, which): handle_click(dialog, which)
        builder = AlertDialog.Builder(act)
        builder.setTitle("Меню заметки")
        builder.setItems(options, DCL())
        dialog = builder.create()
        window = dialog.getWindow()
        if window:
            t = WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY if Build.VERSION.SDK_INT >= 26 else WindowManager.LayoutParams.TYPE_PHONE
            window.setType(t)
        dialog.show()

    def _toggle_lock(self, note):
        note["locked"] = not note.get("locked")
        self._save_state()

    def _apply_theme(self, note, theme_name):
        note["theme"] = theme_name
        note["accent"] = Color.parseColor(NOTE_THEMES.get(theme_name, NOTE_THEMES["blue"]))
        self._refresh_note_appearance(note)
        self._save_state()

    def _apply_opacity(self, note, opacity):
        note["opacity"] = opacity
        self._refresh_note_appearance(note)
        self._save_state()

    def _refresh_note_appearance(self, note):
        try:
            accent = note.get("accent", Color.parseColor(NOTE_THEMES.get(note.get("theme", "blue"), NOTE_THEMES["blue"])))
            main_body = note.get("main_body")
            if main_body:
                bg = GradientDrawable()
                bg.setColor(self._note_bg(note.get("opacity", "100%")))
                bg.setCornerRadius(_dp(16))
                main_body.setBackground(bg)
            header = note.get("header_bg_view")
            if header:
                header.setBackgroundColor(_alpha_color(accent, 0x26))
            icon = note.get("header_icon")
            if icon:
                try: icon.setColorFilter(accent)
                except Exception: pass
            if note["container"].isAttachedToWindow():
                self.wm.updateViewLayout(note["container"], note["p"])
        except Exception:
            pass

    def _toggle_collapse(self, note):
        try:
            if note.get("collapsed"):
                note["collapsed"] = False
                note["p"].width = note.get("orig_w", _dp(220))
                note["p"].height = note.get("orig_h", _dp(180))
                self._rebuild_note_content(note)
            else:
                note["collapsed"] = True
                note["orig_w"] = note["p"].width
                note["orig_h"] = note["p"].height
                note["p"].width = _dp(150)
                note["p"].height = WindowManager.LayoutParams.WRAP_CONTENT
                ctx = note["container"].getContext()
                content = note["content"]
                while content.getChildCount() > 0:
                    content.removeViewAt(0)
                accent = note.get("accent", _acc())
                chip = LinearLayout(ctx)
                chip.setOrientation(LinearLayout.HORIZONTAL)
                chip.setGravity(Gravity.CENTER_VERTICAL)
                chip.setPadding(_dp(10), _dp(8), _dp(10), _dp(8))
                cbg = GradientDrawable()
                cbg.setCornerRadius(_dp(12))
                cbg.setColor(_alpha_color(accent, 0x33))
                chip.setBackground(cbg)
                chip.addView(self._type_icon(ctx, note["type"], accent, 18), _llp(_dp(18), _dp(18), Gravity.CENTER_VERTICAL, 0, 0, _dp(6), 0))
                _, type_title, _ = NOTE_META.get(note["type"], ([], "Заметка", "📌"))
                tv = TextView(ctx)
                tv.setText(type_title)
                tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
                tv.setTextColor(_ink())
                chip.addView(tv, _llp(-2, -2, Gravity.CENTER_VERTICAL))
                chip.setOnClickListener(OnClickListener(lambda v: self._toggle_collapse(note)))
                self._apply_press_scale(chip)
                content.addView(chip, _flp(-1, -2))
            if note["container"].isAttachedToWindow():
                self.wm.updateViewLayout(note["container"], note["p"])
            self._save_state()
        except Exception:
            pass

    def _rebuild_note_content(self, note):
        t = note.get("type")
        sd = note.get("saved_data", {})
        content = note["content"]
        while content.getChildCount() > 0:
            content.removeViewAt(0)
        ctx = note["container"].getContext()
        if t == "text": self._build_text_content(note, ctx, sd.get("text", ""))
        elif t == "photo":
            photo = sd.get("photo_b64") or note.get("photo_b64")
            if photo: self._build_photo_content(note, ctx, photo)
        elif t == "todo": self._build_todo_content(note, ctx, sd.get("tasks", []))
        elif t == "timer": self._build_timer_content(note, ctx, sd.get("seconds", 60))
        elif t == "counter": self._build_counter_content(note, ctx, sd.get("count", 0))
        elif t == "canvas": self._build_canvas_content(note, ctx)
        elif t == "link": self._build_link_content(note, ctx, sd.get("url", ""), sd.get("title", "Ссылка"))
        elif t == "clipboard": self._build_clipboard_content(note, ctx)
        elif t == "voice": self._build_voice_content(note, ctx)
        elif t == "reminder": self._build_reminder_content(note, ctx, sd.get("text", ""), sd.get("delay", 60))
        elif t == "randomizer": self._build_randomizer_content(note, ctx, sd.get("items", []))
        if note["container"].isAttachedToWindow():
            self.wm.updateViewLayout(note["container"], note["p"])

    def _bring_to_front(self, note):
        try:
            if note in self.notes:
                self.notes.remove(note)
                self.notes.append(note)
            if self._ui_lock:
                self._needs_reattach = True
                return
            if note["container"].isAttachedToWindow():
                self.wm.removeView(note["container"])
            self._attach_note(note, animate=False)
        except Exception: pass

    def _send_to_back(self, note):
        try:
            if note in self.notes:
                self.notes.remove(note)
                self.notes.insert(0, note)
            if self._ui_lock:
                self._needs_reattach = True
                return
            if note["container"].isAttachedToWindow():
                self.wm.removeView(note["container"])
            self.wm.addView(note["container"], note["p"], 0)
        except Exception:
            try: self.wm.addView(note["container"], note["p"])
            except Exception: pass

    def _duplicate_note(self, note):
        saved = self._serialize_note(note)
        if saved:
            saved["x"] = saved.get("x", 0) + 50
            saved["y"] = saved.get("y", 0) + 50
            run_on_ui_thread(lambda: self._restore_single_note(saved))

    def _copy_text_note(self, note):
        try:
            text = note.get("saved_data", {}).get("text", "")
            if text:
                ctx = note["container"].getContext()
                ClipboardManager = find_class("android.content.ClipboardManager")
                ClipData = find_class("android.content.ClipData")
                cm = ctx.getSystemService(ctx.CLIPBOARD_SERVICE)
                cm.setPrimaryClip(ClipData.newPlainText("Sticky Notes", text))
                BulletinHelper.show_success("Скопировано!", get_last_fragment())
        except Exception:
            pass


    def add_text_note(self, text="", theme=None):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(220), _dp(170), note_type="text", theme=theme)
            self._build_text_content(note, ctx, text)
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка текстовой заметки: {e}")

    def _build_text_content(self, note, ctx, text):
        et = EditText(ctx)
        et.setText(text)
        et.setTextColor(_ink())
        et.setHint("Напишите что-нибудь...")
        et.setHintTextColor(_hint())
        et.setBackgroundColor(Color.TRANSPARENT)
        et.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15)
        et.setGravity(Gravity.TOP | Gravity.LEFT)
        et.setPadding(_dp(12), _dp(10), _dp(12), _dp(12))

        class InputTouchHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, nd, et):
                super().__init__()
                self.plugin, self.nd, self.et = plugin, nd, et
            def onTouch(self, v, event):
                if event.getAction() == MotionEvent.ACTION_UP:
                    self.plugin._set_note_focusable(self.nd, True)
                    self.et.requestFocus()
                return False
        et.setOnTouchListener(InputTouchHandler(self, note, et))

        TextWatcher = find_class("android.text.TextWatcher")
        class Watcher(dynamic_proxy(TextWatcher)):
            def __init__(self, plugin, n):
                super().__init__()
                self.plugin, self.n = plugin, n
            def beforeTextChanged(self, s, start, count, after): pass
            def onTextChanged(self, s, start, before, count): pass
            def afterTextChanged(self, s):
                self.n["saved_data"] = {"text": str(s.toString())}
                self.plugin._save_state()
        et.addTextChangedListener(Watcher(self, note))
        note["content"].addView(et, _llp(-1, -1))
        note["saved_data"] = {"text": text}

    def add_photo_note(self, base64_img, photo_path=None):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(260), _dp(310), note_type="photo")
            note["photo_b64"] = base64_img
            note["saved_data"] = {"photo_path": photo_path, "photo_b64": base64_img}
            self._build_photo_content(note, ctx, base64_img)
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка фото-заметки: {e}")

    def _build_photo_content(self, note, ctx, base64_img):
        web_view = WebView(ctx)
        web_view.setLayoutParams(_flp(-1, -1))
        web_view.setWebViewClient(WebViewClient())
        s = web_view.getSettings()
        s.setJavaScriptEnabled(True)
        s.setSupportZoom(True)
        s.setBuiltInZoomControls(True)
        s.setDisplayZoomControls(False)
        s.setLoadWithOverviewMode(True)
        s.setUseWideViewPort(True)
        web_view.setBackgroundColor(Color.TRANSPARENT)
        html = f"""<!DOCTYPE html><html><head>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<style>body {{ margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; background: transparent; }} img {{ max-width: 94%; max-height: 94%; object-fit: contain; border-radius: 12px; }}</style>
</head><body><img src="{base64_img}" /></body></html>"""
        web_view.loadDataWithBaseURL("https://localhost", html, "text/html", "utf-8", None)
        note["content"].addView(web_view)

    def add_todo_note(self, tasks=None):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(250), _dp(280), note_type="todo")
            note["saved_data"] = {"tasks": tasks or []}
            self._build_todo_content(note, ctx, tasks or [])
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка To-Do заметки: {e}")

    def _build_todo_content(self, note, ctx, tasks):
        root_layout = LinearLayout(ctx)
        root_layout.setOrientation(LinearLayout.VERTICAL)
        root_layout.setPadding(_dp(10), _dp(8), _dp(10), _dp(10))

        header_row = LinearLayout(ctx)
        header_row.setOrientation(LinearLayout.HORIZONTAL)
        header_row.setGravity(Gravity.CENTER_VERTICAL)
        counter_tv = self._create_info_tab(ctx, "Задач: 0")
        header_row.addView(counter_tv, _llp(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, _dp(8), 0))
        btn_clear = self._create_pill(ctx, "Очистить", None, None, text_color=_tc("key_text_RedRegular", Color.RED))
        header_row.addView(btn_clear, _llp(-2, -2, Gravity.CENTER_VERTICAL))
        root_layout.addView(header_row)
        root_layout.addView(View(ctx), _llp(-1, _dp(6)))

        input_row = LinearLayout(ctx)
        input_row.setOrientation(LinearLayout.HORIZONTAL)
        input_row.setGravity(Gravity.CENTER_VERTICAL)
        task_input = EditText(ctx)
        task_input.setHint("Новая задача...")
        task_input.setHintTextColor(_hint())
        task_input.setTextColor(_ink())
        task_input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
        task_input.setBackgroundColor(Color.TRANSPARENT)

        class TodoInputTouchHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, nd, et):
                super().__init__()
                self.plugin, self.nd, self.et = plugin, nd, et
            def onTouch(self, v, event):
                if event.getAction() == MotionEvent.ACTION_UP:
                    self.plugin._set_note_focusable(self.nd, True)
                    self.et.requestFocus()
                return False
        task_input.setOnTouchListener(TodoInputTouchHandler(self, note, task_input))

        btn_add_task = self._create_pill(ctx, None, ['msg_add', 'msg_addbot', 'msg_send'], None)
        input_row.addView(task_input, _llp(0, -2, weight=1.0))
        input_row.addView(btn_add_task, _llp(-2, -2, Gravity.CENTER_VERTICAL))
        root_layout.addView(input_row)

        scroll = ScrollView(ctx)
        list_container = LinearLayout(ctx)
        list_container.setOrientation(LinearLayout.VERTICAL)
        scroll.addView(list_container, _flp(-1, -1))
        root_layout.addView(scroll, _llp(-1, 0, weight=1.0))
        note["content"].addView(root_layout)

        def update_counter():
            try:
                total = list_container.getChildCount()
                checked = sum(1 for i in range(total) if list_container.getChildAt(i).isChecked())
                counter_tv.setText(f"Задач: {total} • {checked}")
            except Exception: pass

        def save_tasks():
            try:
                tlist = []
                for i in range(list_container.getChildCount()):
                    cb = list_container.getChildAt(i)
                    tlist.append({"text": str(cb.getText()), "checked": cb.isChecked()})
                note["saved_data"] = {"tasks": tlist}
                self._save_state()
            except Exception: pass

        class TodoCheckListener(dynamic_proxy(View.OnClickListener)):
            def __init__(self, cb):
                super().__init__()
                self.cb = cb
            def onClick(self, v):
                try:
                    if self.cb.isChecked():
                        self.cb.setTextColor(_sub())
                        self.cb.setPaintFlags(self.cb.getPaintFlags() | Paint.STRIKE_THRU_TEXT_FLAG)
                    else:
                        self.cb.setTextColor(_ink())
                        self.cb.setPaintFlags(self.cb.getPaintFlags() & ~Paint.STRIKE_THRU_TEXT_FLAG)
                    update_counter(); save_tasks()
                except Exception: pass

        def make_long_click(cb):
            class LongClick(dynamic_proxy(View.OnLongClickListener)):
                def onLongClick(self, v):
                    try:
                        parent = cb.getParent()
                        if parent: parent.removeView(cb)
                        update_counter(); save_tasks()
                    except Exception: pass
                    return True
            return LongClick()

        def make_task_cb(t_text, t_checked):
            cb = CheckBox(ctx)
            cb.setText(t_text)
            cb.setTextColor(_ink())
            cb.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
            cb.setChecked(t_checked)
            try:
                cb.setButtonTintList(ColorStateList.valueOf(_acc()))
            except Exception: pass
            cb.setOnClickListener(TodoCheckListener(cb))
            cb.setOnLongClickListener(make_long_click(cb))
            if t_checked:
                cb.setTextColor(_sub())
                cb.setPaintFlags(cb.getPaintFlags() | Paint.STRIKE_THRU_TEXT_FLAG)
            return cb

        def add_task(v):
            try:
                editable = task_input.getText()
                if not editable: return
                text_str = str(editable.toString()).strip()
                if not text_str: return
                cb = make_task_cb(text_str, False)
                list_container.addView(cb, _llp(-1, -2, None, 0, _dp(4), 0, 0))
                task_input.setText("")
                update_counter(); save_tasks()
            except Exception: pass
        btn_add_task.setOnClickListener(OnClickListener(add_task))

        def clear_done(v):
            to_remove = [list_container.getChildAt(i) for i in range(list_container.getChildCount()) if list_container.getChildAt(i).isChecked()]
            for cb in to_remove:
                list_container.removeView(cb)
            update_counter(); save_tasks()
        btn_clear.setOnClickListener(OnClickListener(clear_done))

        for t in tasks:
            cb = make_task_cb(t.get("text", ""), t.get("checked", False))
            list_container.addView(cb, _llp(-1, -2, None, 0, _dp(4), 0, 0))
        update_counter()

    def add_timer_note(self, seconds=60):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(230), WindowManager.LayoutParams.WRAP_CONTENT,
                                          allow_resize=False, note_type="timer")
            note["seconds"] = seconds
            note["running"] = False
            note["saved_data"] = {"seconds": seconds}
            self._build_timer_content(note, ctx, seconds)
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка таймера: {e}")

    def _build_timer_content(self, note, ctx, seconds):
        timer_layout = LinearLayout(ctx)
        timer_layout.setOrientation(LinearLayout.VERTICAL)
        timer_layout.setGravity(Gravity.CENTER_HORIZONTAL)
        timer_layout.setPadding(_dp(12), _dp(10), _dp(12), _dp(12))

        presets_row = LinearLayout(ctx)
        presets_row.setOrientation(LinearLayout.HORIZONTAL)
        presets_row.setGravity(Gravity.CENTER)
        for name, secs in TIMER_PRESETS:
            pbtn = self._create_info_tab(ctx, name)
            def make_preset(s):
                def click(v):
                    if not note["running"]:
                        note["seconds"] = s
                        m, sec = divmod(s, 60)
                        note["emin"].setText(f"{m:02d}")
                        note["esec"].setText(f"{sec:02d}")
                return click
            pbtn.setOnClickListener(OnClickListener(make_preset(secs)))
            presets_row.addView(pbtn, _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(6), 0))
        timer_layout.addView(presets_row, _llp(-1, -2))
        timer_layout.addView(View(ctx), _llp(-1, _dp(8)))

        input_block = LinearLayout(ctx)
        input_block.setOrientation(LinearLayout.HORIZONTAL)
        input_block.setGravity(Gravity.CENTER)

        def make_digit_input(initial_text):
            et = EditText(ctx)
            et.setText(initial_text)
            et.setTextColor(_ink())
            et.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 30)
            et.setGravity(Gravity.CENTER)
            et.setBackgroundColor(Color.TRANSPARENT)
            et.setInputType(InputType.TYPE_CLASS_NUMBER)
            et.setFilters([InputFilter.LengthFilter(2)])
            try:
                if AndroidUtilities:
                    et.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception: pass
            return et

        m, s = divmod(seconds, 60)
        et_min = make_digit_input(f"{m:02d}")
        et_sec = make_digit_input(f"{s:02d}")
        note["emin"] = et_min
        note["esec"] = et_sec

        class TimerInputTouchHandler(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, plugin, nd, et):
                super().__init__()
                self.plugin, self.nd, self.et = plugin, nd, et
            def onTouch(self, v, event):
                if event.getAction() == MotionEvent.ACTION_UP:
                    self.plugin._set_note_focusable(self.nd, True)
                    self.et.requestFocus()
                return False
        et_min.setOnTouchListener(TimerInputTouchHandler(self, note, et_min))
        et_sec.setOnTouchListener(TimerInputTouchHandler(self, note, et_sec))

        colon_tv = TextView(ctx)
        colon_tv.setText(":")
        colon_tv.setTextColor(_sub())
        colon_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 30)
        input_block.addView(et_min, _llp(_dp(52), -2))
        input_block.addView(colon_tv, _llp(-2, -2))
        input_block.addView(et_sec, _llp(_dp(52), -2))
        timer_layout.addView(input_block)
        timer_layout.addView(View(ctx), _llp(-1, _dp(10)))

        ctrl_row = LinearLayout(ctx)
        ctrl_row.setOrientation(LinearLayout.HORIZONTAL)
        ctrl_row.setGravity(Gravity.CENTER_VERTICAL)

        b_toggle = self._create_main_button(ctx, "▶  СТАРТ", None)
        toggle_bg = b_toggle.getBackground()

        def toggle_action(v):
            try:
                if note["running"]:
                    note["running"] = False
                    note["toggle_tv"].setText("▶  СТАРТ")
                    toggle_bg.setColor(_tc("key_featuredStickers_addButton", Color.parseColor("#2196F3")))
                    note["emin"].setEnabled(True); note["esec"].setEnabled(True)
                else:
                    try:
                        m_val = int(str(note["emin"].getText().toString()).strip() or "0")
                        s_val = int(str(note["esec"].getText().toString()).strip() or "0")
                    except ValueError:
                        m_val, s_val = 1, 0
                    total = m_val * 60 + s_val
                    if total <= 0: return
                    note["seconds"] = total
                    note["running"] = True
                    note["toggle_tv"].setText("⏸  ПАУЗА")
                    toggle_bg.setColor(Color.parseColor("#FF9500"))
                    note["emin"].setEnabled(False); note["esec"].setEnabled(False)
                    self._set_note_focusable(note, False)
                    note["emin"].post(note["ticker"])
            except Exception: pass
        b_toggle.setOnClickListener(OnClickListener(toggle_action))

        b_reset = self._create_pill(ctx, None, ['msg_history', 'input_reply', 'msg_reset'], None)
        def reset_action(v):
            note["running"] = False
            note["seconds"] = 60
            note["toggle_tv"].setText("▶  СТАРТ")
            toggle_bg.setColor(_tc("key_featuredStickers_addButton", Color.parseColor("#2196F3")))
            note["emin"].setTextColor(_ink()); note["esec"].setTextColor(_ink())
            note["emin"].setText("01"); note["esec"].setText("00")
            note["emin"].setEnabled(True); note["esec"].setEnabled(True)
            self._set_note_focusable(note, False)
        b_reset.setOnClickListener(OnClickListener(reset_action))

        ctrl_row.addView(b_toggle, _llp(0, -2, Gravity.CENTER_VERTICAL, weight=1.0))
        ctrl_row.addView(b_reset, _llp(-2, -2, Gravity.CENTER_VERTICAL, _dp(8), 0, 0, 0))
        timer_layout.addView(ctrl_row)
        note["content"].addView(timer_layout)

        # найдём TextView внутри main button для смены текста
        try:
            inner = b_toggle.getChildAt(0)
            note["toggle_tv"] = inner
        except Exception:
            note["toggle_tv"] = b_toggle

        RunnableClass = find_class("java.lang.Runnable")
        class TimerTicker(dynamic_proxy(RunnableClass)):
            def __init__(self, n, emin, esec, plugin):
                super().__init__()
                self.n, self.emin, self.esec, self.plugin = n, emin, esec, plugin
            def run(self):
                try:
                    if not self.n.get("running", False): return
                    secs = self.n.get("seconds", 0)
                    if secs > 0:
                        secs -= 1
                        self.n["seconds"] = secs
                        mm, ss = divmod(secs, 60)
                        self.emin.setText(f"{mm:02d}")
                        self.esec.setText(f"{ss:02d}")
                        self.emin.postDelayed(self, 1000)
                    else:
                        self.n["running"] = False
                        self.emin.setText("00"); self.esec.setText("00")
                        red = _tc("key_text_RedRegular", Color.RED)
                        self.emin.setTextColor(red); self.esec.setTextColor(red)
                        self.n["toggle_tv"].setText("▶  СТАРТ")
                        self.emin.setEnabled(True); self.esec.setEnabled(True)
                        self.plugin._set_note_focusable(self.n, False)
                        self.plugin._timer_finished(self.n)
                except Exception: pass
        note["ticker"] = TimerTicker(note, et_min, et_sec, self)

    def _timer_finished(self, note):
        try:
            if self.settings.get("vibrate"):
                ctx = note["container"].getContext()
                v = ctx.getSystemService(ctx.VIBRATOR_SERVICE)
                if v: v.vibrate(500)
            if self.settings.get("sound"):
                BulletinHelper.show_success("⏰ Таймер завершён!", get_last_fragment())
        except Exception: pass

    def add_counter_note(self, count=0):
        try:
            ctx = self._get_ctx()
            note = self._create_note_base(ctx, _dp(180), WindowManager.LayoutParams.WRAP_CONTENT,
                                          allow_resize=False, note_type="counter")
            note["saved_data"] = {"count": count}
            self._build_counter_content(note, ctx, count)
            self._attach_note(note)
            self._save_state()
        except Exception as e:
            self._fail(f"Ошибка счётчика: {e}")

    def _bind_tap(self, view, fn):
        """Надёжная кнопка через OnTouchListener (не зависит от OnClickListener)."""
        class TapTouch(dynamic_proxy(View.OnTouchListener)):
            def __init__(self, action):
                super().__init__()
                self._action = action
            def onTouch(self, v, event):
                try:
                    act = event.getActionMasked()
                    if act == MotionEvent.ACTION_DOWN:
                        v.animate().scaleX(0.92).scaleY(0.92).setDuration(100).start()
                        return True
                    elif act == MotionEvent.ACTION_UP:
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(150).start()
                        self._action()
                        return True
                    elif act == MotionEvent.ACTION_CANCEL:
                        v.animate().scaleX(1.0).scaleY(1.0).setDuration(150).start()
                        return True
                except Exception:
                    pass
                return False
        view.setOnTouchListener(TapTouch(fn))

    def _build_counter_content(self, note, ctx, count):
        layout = LinearLayout(ctx)
        layout.setOrientation(LinearLayout.VERTICAL)
        layout.setGravity(Gravity.CENTER)
        layout.setPadding(_dp(12), _dp(10), _dp(12), _dp(12))

        try:
            current = int(count)
        except Exception:
            current = 0
        note["counter_value"] = current

        counter_tv = TextView(ctx)
        counter_tv.setText(str(current))
        counter_tv.setTextColor(_ink())
        counter_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 32)
        counter_tv.setGravity(Gravity.CENTER)
        try:
            if AndroidUtilities:
                counter_tv.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER)

        b_minus = self._create_pill(ctx, "−", None, None, text_color=_tc("key_text_RedRegular", Color.RED))
        b_plus = self._create_pill(ctx, "+", None, None, text_color=Color.parseColor("#4CAF50"))
        try:
            b_minus.setMinimumWidth(_dp(64))
            b_plus.setMinimumWidth(_dp(64))
        except Exception:
            pass

        def set_value(new_val):
            note["counter_value"] = new_val
            note["saved_data"] = {"count": new_val}
            counter_tv.setText(str(new_val))
            self._save_state()

        def on_minus():
            try:
                set_value(int(note.get("counter_value", 0)) - 1)
            except Exception as e:
                self._fail(f"Счётчик −: {e}")

        def on_plus():
            try:
                set_value(int(note.get("counter_value", 0)) + 1)
            except Exception as e:
                self._fail(f"Счётчик +: {e}")

        self._bind_tap(b_minus, on_minus)
        self._bind_tap(b_plus, on_plus)

        row.addView(b_minus, _llp(-2, -2, Gravity.CENTER, 0, 0, _dp(20), 0))
        row.addView(b_plus, _llp(-2, -2, Gravity.CENTER))
        layout.addView(counter_tv)
        layout.addView(View(ctx), _llp(-1, _dp(8)))
        layout.addView(row)
        note["content"].addView(layout, _flp(-1, -2))

