    def _build_clipboard_content(self, note, ctx):
        layout = LinearLayout(ctx)
        layout.setOrientation(LinearLayout.VERTICAL)
        layout.setPadding(_dp(12), _dp(8), _dp(12), _dp(12))
        title = TextView(ctx)
        title.setText("Буфер обмена")
        title.setTextColor(_ink())
        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13)
        text_tv = TextView(ctx)
        text_tv.setText("(пусто)")
        text_tv.setTextColor(_sub())
        text_tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12)
        text_tv.setPadding(0, _dp(6), 0, _dp(6))
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        b_paste = self._create_pill(ctx, "Вставить", ['msg_log'], None)
        b_copy = self._create_pill(ctx, "Копировать", ['msg_copy'], None)

        def paste(v):
            try:
                ClipboardManager = find_class("android.content.ClipboardManager")
                cm = ctx.getSystemService(ctx.CLIPBOARD_SERVICE)
                if cm and cm.hasPrimaryClip():
                    clip = cm.getPrimaryClip()
                    if clip and clip.getItemCount() > 0:
                        text_tv.setText(str(clip.getItemAt(0).coerceToText(ctx).toString()))
                        text_tv.setTextColor(_ink())
            except Exception: pass
        def copy(v):
            try:
                txt = str(text_tv.getText())
                if txt and txt != "(пусто)":
                    ClipboardManager = find_class("android.content.ClipboardManager")
                    ClipData = find_class("android.content.ClipData")
                    cm = ctx.getSystemService(ctx.CLIPBOARD_SERVICE)
                    cm.setPrimaryClip(ClipData.newPlainText("Note", txt))
            except Exception: pass
        b_paste.setOnClickListener(OnClickListener(paste))
        b_copy.setOnClickListener(OnClickListener(copy))
        row.addView(b_paste, _llp(-2, -2, Gravity.CENTER_VERTICAL, 0, 0, _dp(8), 0))
        row.addView(b_copy, _llp(-2, -2))
        layout.addView(title)
        layout.addView(text_tv)
        layout.addView(row)
        note["content"].addView(layout)

