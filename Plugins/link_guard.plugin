        "log_empty": "The log is empty. Turn on the verbose log and open a few links",
        "log_cut": "(only the tail is shown)",
        "log_copy": "Copy",
        "log_copied": "Log copied",
        "log_cleared": "Log cleared",
        "scripts_LATIN": "Latin",
        "scripts_CYRILLIC": "Cyrillic",
        "scripts_GREEK": "Greek",
        "scripts_ARMENIAN": "Armenian",
        "scripts_HEBREW": "Hebrew",
    },
}


