def is_private_ip(host):
    try:
        first, second = (int(part) for part in host.split(".")[:2])
    except (TypeError, ValueError):
        return False
    return (first == 10 or first == 127 or (first == 192 and second == 168)
            or (first == 172 and 16 <= second <= 31)
            or (first == 169 and second == 254))


def plural_form(forms, count):
    one, few, many = (str(forms).split("|") + ["", ""])[:3]
    tail = abs(int(count)) % 100
    if 11 <= tail <= 14:
        return many
    tail %= 10
    if tail == 1:
        return one
    if 2 <= tail <= 4:
        return few
    return many


def amount(count, unit_key):
    return "%d %s" % (count, plural_form(phrase(unit_key), count))


def big_amount(count, unit_key):
    digits = "{:,}".format(int(count))
    digits = digits.replace(",", "," if LANG == "en" else " ")
    return "%s %s" % (digits, plural_form(phrase(unit_key), count))


def human_age(days):
    if days < 1:
        return phrase("age_today")
    if days < 14:
        return amount(days, "unit_day")
    if days < 60:
        return amount(days // 7, "unit_week")
    if days < 730:
        return amount(days // 30, "unit_month")
    return amount(days // 365, "unit_year")


HIGH, MEDIUM, LOW, INFO = "high", "medium", "low", "info"
_RISK_ORDER = {INFO: 0, LOW: 1, MEDIUM: 2, HIGH: 3}

CACHE_TTL = 300.0
CACHE_MAX = 200
ANCHOR_MAX = 300
COUNT_WINDOW = 5.0


class Verdict:

    def __init__(self, original):
        self.original = original
        self.cleaned = original
        self.final = None
        self.flags = []
        self.removed_params = []
        self.is_shortener = False
        self.host = ""
        self.display_host = ""
        self.source = None
        self.age_days = None

    def add(self, level, text):
        self.flags.append((level, text))

    def clone(self):
        copy = Verdict(self.original)
        copy.cleaned = self.cleaned
        copy.final = self.final
        copy.flags = list(self.flags)
        copy.removed_params = list(self.removed_params)
        copy.is_shortener = self.is_shortener
        copy.host = self.host
        copy.display_host = self.display_host
        copy.source = self.source
        copy.age_days = self.age_days
        return copy

    @property
    def risk(self):
        if not self.flags:
            return INFO
        return max((lvl for lvl, _ in self.flags), key=lambda l: _RISK_ORDER[l])

    @property
    def suspicious(self):
        return _RISK_ORDER[self.risk] >= _RISK_ORDER[MEDIUM]


def levenshtein(left, right):
    if left == right:
        return 0
    if not left or not right:
        return max(len(left), len(right))
    before = None
    prev = list(range(len(right) + 1))
    for i, ca in enumerate(left, 1):
        cur = [i]
        for j, cb in enumerate(right, 1):
            step = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb))
            if (i > 1 and j > 1 and ca == right[j - 2] and left[i - 2] == cb):
                step = min(step, before[j - 2] + 1)
            cur.append(step)
        before, prev = prev, cur
    return prev[-1]


BRAND_CORE_MIN = 3
BRAND_GLUED_MIN = 6
LURE_WORDS = {
    "shop", "store", "market", "magazin", "pay", "payment", "bank", "banking",
    "online", "official", "support", "help", "service", "servis", "login",
    "signin", "secure", "security", "verify", "verification", "account",
    "cabinet", "kabinet", "wallet", "claim", "gift", "bonus", "promo", "prize",
    "win", "winner", "refund", "update", "confirm", "center", "centre", "centr",
    "auth", "access", "recovery", "restore", "unlock", "oplata", "dostavka",
    "vyplata", "viplata", "vozvrat", "podarok", "vhod", "lk", "id", "app",
    "apk", "download", "mobile", "invest", "bot", "premium", "vip", "free",
}
HOST_MAX = 253
LABELS_MAX = 40
BRAND_LIST = sorted(BRANDS)


def letter_mask(text):
    mask = 0
    for char in text:
        mask |= 1 << (ord(char) & 63)
    return mask


def brand_index(brand_list):
    return [(brand, len(brand), letter_mask(brand)) for brand in brand_list]


BRAND_INDEX = brand_index(BRAND_LIST)


def label_tokens(label):
    parts = re.split(r"[^a-z0-9]+", label)
    tokens = set()
    for part in parts:
        if not part:
            continue
        tokens.add(part)
        for piece in re.findall(r"[a-z]+", part):
            tokens.add(piece)
    return tokens


def glued_to_lure(label, core):
    rest = label.replace(core, "", 1).strip("-_.0123456789")
    return rest in LURE_WORDS


def brand_with_extra(reg, brands, brand_list):
    if reg in brands:
        return None
    label = reg.split(".")[0]
    tokens = label_tokens(label)
    for brand in brand_list:
        core = brand.split(".")[0]
        if len(core) < BRAND_CORE_MIN or core in GENERIC_LABELS:
            continue
        if label == core:
            return None
        if core in tokens:
            return core
        if (len(core) >= BRAND_GLUED_MIN and core in label
                and glued_to_lure(label, core)):
            return core
    return None


def registrable(host):
    parts = host.split(".")
    if len(parts) < 2:
        return host
    if len(parts) >= 3:
        tail = ".".join(parts[-2:])
        known = TWO_LEVEL_TLD
        database = active_database()
        if database is not None and database.suffixes:
            known = TWO_LEVEL_TLD | database.suffixes
        if tail in known:
            return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def decode_idna(host):
    if "xn--" not in host:
        return host
    try:
        return host.encode("ascii").decode("idna")
    except Exception:
        return host


def scripts_of(text):
    found = set()
    for ch in text:
        if not ch.isalpha():
            continue
        try:
            name = unicodedata.name(ch)
        except ValueError:
            continue
        for script in ("LATIN", "CYRILLIC", "GREEK", "ARMENIAN", "HEBREW"):
            if name.startswith(script):
                found.add(script)
                break
    return found


def to_latin_lookalike(host):
    return "".join(LOOKALIKE_LETTERS.get(ch, ch) for ch in host.lower())


def slice_utf16(text, offset, length):
    if not length:
        return ""
    try:
        units = text.encode("utf-16-le")
        return units[offset * 2:(offset + length) * 2].decode("utf-16-le", "ignore")
    except Exception:
        return text[offset:offset + length]


def anchor_domain(text):
    if not text:
        return ""
    candidate = text.strip().strip("<>()[]«»\"'").rstrip(".,;:!?")
    match = ANCHOR_RE.match(candidate)
    if not match:
        return ""
    host = decode_idna(match.group(1).lower().rstrip("."))
    if "." not in host:
        return ""
    return registrable(host)


def normalize_domain(text):
    value = str(text).strip().lower()
    if not value:
        return ""
    if "://" in value:
        value = value.split("://", 1)[1]
    value = value.split("/")[0].split("?")[0].split("#")[0]
    if "@" in value:
        value = value.split("@")[-1]
    value = value.split(":")[0].strip().strip(".").lstrip("*.")
    if not value or " " in value:
        return ""
    if not re.fullmatch(r"[a-z0-9\-._~Ѐ-ӿ]+\.(?:[a-zЀ-ӿ]{2,}|xn--[a-z0-9\-]{2,})",
                        value):
        return ""
    return decode_idna(value)


def clean_url(url, aggressive=False):
    try:
        parts = urlsplit(url)
    except Exception:
        return url, []
    if not parts.query:
        return url, []

    kept, removed = [], []
    for segment in parts.query.split("&"):
        if not segment:
            continue
        key = unquote_plus(segment.split("=", 1)[0])
        low = key.lower()
        drop = (
            low in TRACKER_EXACT
            or low.startswith(TRACKER_PREFIXES)
            or (aggressive and low in TRACKER_AGGRESSIVE)
        )
        if drop:
            removed.append(key)
        else:
            kept.append(segment)

    if not removed:
        return url, []
    query = "&".join(kept)
    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, parts.fragment)), removed


def analyze(url, aggressive=False, whitelist=(), anchor=None):
    verdict = Verdict(url)

    try:
        raw = urlsplit(url)
    except Exception:
        verdict.add(HIGH, phrase("f_unparsable"))
        return verdict

    scheme = (raw.scheme or "").lower()
    if scheme in DANGEROUS_SCHEMES:
        verdict.add(HIGH, phrase("f_scheme", scheme))
        return verdict
    if scheme not in ("", "http", "https", "ftp"):
        return verdict

    probe = url if "://" in url else "http://" + url
    try:
        parts = urlsplit(probe)
        host = (parts.hostname or "").lower()
    except Exception:
        verdict.add(HIGH, phrase("f_unparsable"))
        return verdict

    verdict.host = host
    verdict.display_host = decode_idna(host)

    if not host:
        verdict.add(MEDIUM, phrase("f_nodomain"))
        return verdict

    if len(host) > HOST_MAX or host.count(".") > LABELS_MAX:
        verdict.add(HIGH, phrase("f_unparsable"))
        verdict.cleaned, verdict.removed_params = clean_url(url, aggressive)
        return verdict

    reg = registrable(host)
    shown_host = verdict.display_host
    shown_reg = reg if shown_host == host else registrable(shown_host)
    if (reg in whitelist or host in whitelist
            or shown_reg in whitelist or shown_host in whitelist):
        verdict.cleaned, verdict.removed_params = clean_url(url, aggressive)
        return verdict

    known_good = False
    database = active_database()
    if database is not None:
        try:
            hit = database.malicious_hit(host)
            if hit == host:
                verdict.add(HIGH, phrase("f_blocklist"))
            elif hit:
                verdict.add(HIGH, phrase("f_blocklist_parent", hit))
            else:
                known_good = database.is_popular(host) or database.is_popular(reg)
        except Exception as e:
            log("LinkGuard: db lookup failed: %s" % e)

    if parts.username or "@" in parts.netloc:
        verdict.add(HIGH, phrase("f_userinfo", host))

    shown = verdict.display_host
    if shown != host:
        verdict.add(LOW, phrase("f_punycode", shown))
    scripts = scripts_of(shown)
    if len(scripts) > 1:
        names = sorted(phrase("scripts_" + s) for s in scripts)
        verdict.add(HIGH, phrase("f_mixed", ", ".join(names)))

    known_brands = BRANDS
    known_index = BRAND_INDEX
    if database is not None and database.brands:
        known_brands = database.all_brands
        known_index = database.brand_index

    defused = to_latin_lookalike(shown)
    defused_reg = registrable(defused)
    if defused_reg != reg and defused_reg in known_brands:
        verdict.add(HIGH, phrase("f_lookalike", defused_reg))
    elif defused_reg not in known_brands and not known_good:
        own_length = len(defused_reg)
        own_mask = letter_mask(defused_reg)
        for brand, length, mask in known_index:
            if abs(own_length - length) > 2:
                continue
            limit = 1 if length < 10 else 2
            if brand not in BRANDS:
                limit = 1
            if bin(own_mask ^ mask).count("1") > limit:
                continue
            dist = levenshtein(defused_reg, brand)
            if 1 <= dist <= limit:
                verdict.add(HIGH, phrase("f_typo", brand, dist,
                                        plural_form(phrase("unit_char"), dist)))
                break

    if reg not in known_brands and not known_good:
        labels = shown.split(".")
        for brand in BRAND_LIST:
            head = brand.split(".")[0]
            if len(head) < 5 or head in GENERIC_LABELS:
                continue
            if head in labels[:-2]:
                verdict.add(HIGH, phrase("f_subdomain", head, reg))
                break

    shown_as = anchor_domain(anchor)
    if shown_as and shown_as != reg and shown_as != registrable(shown):
        verdict.add(HIGH, phrase("f_anchor", shown_as, reg))

    if IP_RE.fullmatch(host):
        verdict.add(LOW if is_private_ip(host) else MEDIUM,
              phrase("f_ip_local") if is_private_ip(host) else phrase("f_ip"))
    try:
        port = parts.port
    except ValueError:
        port = None
        verdict.add(MEDIUM, phrase("f_badport"))
    if port and port not in (80, 443):
        verdict.add(LOW, phrase("f_port", port))

    if not known_good:
        stolen = brand_with_extra(reg, BRANDS, BRAND_LIST)
        if stolen:
            verdict.add(HIGH, phrase("f_brand_extra", stolen))

    if not known_good:
        if host.count(".") >= 4:
            verdict.add(LOW, phrase("f_deep"))
        if len(host) > 40:
            verdict.add(LOW, phrase("f_long"))

    lowered = (host + parts.path).lower()
    hits = [w for w in BAIT_WORDS if w in lowered]
    if hits and not known_good:
        level = MEDIUM if verdict.flags else LOW
        verdict.add(level, phrase("f_bait", ", ".join(hits[:3])))

    path_low = parts.path.lower()
    for ext in DANGEROUS_EXT:
        if path_low.endswith(ext):
            verdict.add(HIGH, phrase("f_exec", ext))
            break

    if not known_good:
        tld = host.rsplit(".", 1)[-1]
        level = database.zone_level(tld) if database is not None else 0
        if level >= 3:
            verdict.add(MEDIUM, phrase("f_tld_worst", tld))
        elif not level and tld in RISKY_TLD:
            verdict.add(LOW, phrase("f_tld", tld))
        elif level == 2 and verdict.flags:
            verdict.add(LOW, phrase("f_tld", tld))

    if database is not None and not known_good:
        try:
            fresh = database.freshness(reg)
        except Exception as e:
            fresh = 0
            log("LinkGuard: freshness failed: %s" % e)
        if fresh == 10:
            verdict.add(HIGH if verdict.flags else MEDIUM, phrase("f_fresh_10"))
        elif fresh == 30:
            verdict.add(MEDIUM if verdict.flags else LOW, phrase("f_fresh_30"))

    if reg in SHORTENERS or host in SHORTENERS:
        verdict.is_shortener = True
        verdict.add(INFO, phrase("f_short"))

    verdict.cleaned, verdict.removed_params = clean_url(url, aggressive)
    return verdict


REPO_URL = "https://github.com/L0lopop/Link-Guard"
CHAT_URL = "https://t.me/kringplugins"
UPDATE_URL = "https://raw.githubusercontent.com/L0lopop/Link-Guard/main/update.json"
UPDATE_INTERVAL = 6 * 60 * 60

RDAP_URL = "https://rdap.org/domain/%s"
AGE_ALARM_DAYS = 30
AGE_NOTE_DAYS = 120
AGE_CACHE_MAX = 200
AGE_CACHE_TTL = 7 * 24 * 60 * 60
AGE_MISS_TTL = 6 * 60 * 60


def add_age_flag(verdict, days):
    if days is None:
        return
    verdict.age_days = days
    if days <= AGE_ALARM_DAYS:
        verdict.add(HIGH if verdict.flags else MEDIUM, phrase("f_age_new", days))
    elif days <= AGE_NOTE_DAYS:
        verdict.add(LOW, phrase("f_age_young", days))


DB_BASE_URL = "https://github.com/L0lopop/Link-Guard/releases/download/feeds/"
DB_NAME = "full.lgdb"
DB_MANIFEST_NAME = "manifest.json"
DB_MANIFEST_MAX = 64 * 1024
DB_CHECK_GAP = 3 * 60 * 60
DB_TICK_GAP = 30 * 60
DB_RETRY_GAP = 60 * 60
DB_RETRY_LIMIT = 3
DB_RETRY_LONG = 6 * 60 * 60
DB_MAX_BYTES = 24 * 1024 * 1024
DB_MAGIC = b"LGDB"
DB_FORMAT = 1
DB_HEADER = 10
DB_INDEX_ENTRY = 12
DB_HASH_SECTIONS = ("MALW", "WHIT", "FR10", "FR30")
DB_FILE_NAME = "link_guard_domains.lgdb"


class DomainDatabase:

    def __init__(self, blob):
        if not blob.startswith(DB_MAGIC):
            raise ValueError("чужой файл")
        version, self.built_day, count = struct.unpack(">BIB", blob[4:DB_HEADER])
        if version != DB_FORMAT:
            raise ValueError("версия формата %d" % version)
        self.sections = {}
        offset = DB_HEADER
        for _ in range(count):
            tag = blob[offset:offset + 4].decode("ascii")
            length = struct.unpack(">I", blob[offset + 4:offset + 8])[0]
            if offset + 8 + length > len(blob):
                raise ValueError("раздел %s выходит за границы файла" % tag)
            self.sections[tag] = blob[offset + 8:offset + 8 + length]
            offset += 8 + length
        if "MALW" not in self.sections:
            raise ValueError("нет раздела с доменами")
        for tag in DB_HASH_SECTIONS:
            if tag in self.sections:
                self._check_hashes(tag)
        self.platforms = self._lines("PLAT")
        self.brands = self._lines("BRND")
        self.suffixes = self._lines("SUFX")
        self.zones = {}
        for line in self._lines("TLDR"):
            parts = line.split(" ")
            if len(parts) == 2 and parts[1].isdigit():
                self.zones[parts[0]] = int(parts[1])
        self.all_brands = BRANDS | self.brands
        self.brand_list = sorted(self.all_brands)
        self.brand_index = brand_index(self.brand_list)
        self.total = struct.unpack(">I", self.sections["MALW"][1:5])[0]

    def _check_hashes(self, tag):
        raw = self.sections[tag]
        if len(raw) < 11:
            raise ValueError("раздел %s короче заголовка" % tag)
        bits, count, block, index_count = struct.unpack(">BIHI", raw[:11])
        if not 8 <= bits <= 64:
            raise ValueError("раздел %s: разрядность %d" % (tag, bits))
        if count and not block:
            raise ValueError("раздел %s: пустой размер блока" % tag)
        if 11 + index_count * DB_INDEX_ENTRY > len(raw):
            raise ValueError("раздел %s: указатель не помещается" % tag)
        if count and not index_count:
            raise ValueError("раздел %s: записи без указателя" % tag)

    def _lines(self, tag):
        raw = self.sections.get(tag)
        if not raw:
            return set()
        return set(raw.decode("utf-8", "ignore").split(LINE_BREAK))

    @property
    def age_days(self):
        return max(0, int(time.time() // 86400) - self.built_day)

    def _contains(self, tag, host):
        raw = self.sections.get(tag)
        if not raw:
            return False
        bits, count, block, index_count = struct.unpack(">BIHI", raw[:11])
        if not count or not index_count:
            return False
        digest = hashlib.sha256(host.encode("utf-8")).digest()[:8]
        key = int.from_bytes(digest, "big") >> (64 - bits)

        index_at = 11
        data_at = index_at + index_count * DB_INDEX_ENTRY

        low, high = 0, index_count
        while low < high:
            middle = (low + high) // 2
            spot = index_at + middle * DB_INDEX_ENTRY
            if struct.unpack(">Q", raw[spot:spot + 8])[0] <= key:
                low = middle + 1
            else:
                high = middle
        if low == 0:
            return False

        spot = index_at + (low - 1) * DB_INDEX_ENTRY
        value, start = struct.unpack(">QI", raw[spot:spot + DB_INDEX_ENTRY])
        if value == key:
            return True

        position = data_at + start
        limit = len(raw)
        seen = 0
        while seen < block and position < limit:
            shift, delta = 0, 0
            while position < limit:
                byte = raw[position]
                position += 1
                delta |= (byte & 0x7F) << shift
                if not byte & 0x80:
                    break
                shift += 7
            if seen:
                value += delta
                if value == key:
                    return True
                if value > key:
                    return False
            seen += 1
        return False

    def is_popular(self, host):
        return self._contains("WHIT", host)

    def chain(self, host):
        parts = host.split(".")
        result = []
        for i in range(len(parts) - 1):
            candidate = ".".join(parts[i:])
            result.append(candidate)
            if candidate in self.platforms:
                break
        return result

    def malicious_hit(self, host):
        for candidate in self.chain(host):
            if self._contains("MALW", candidate):
                return candidate
        return None

    def zone_level(self, zone):
        return self.zones.get(zone, 0)

    def freshness(self, host):
        if self._contains("FR10", host):
            return 10
        if self._contains("FR30", host):
            return 30
        return 0


_database = None
_database_lock = threading.Lock()


def active_database():
    return _database


def install_database(database):
    global _database
    with _database_lock:
        _database = database


def read_database(path):
    try:
        if not path or not os.path.exists(path):
            return None
        size = os.path.getsize(path)
        if size < DB_HEADER or size > DB_MAX_BYTES:
            log("LinkGuard: db size %d rejected" % size)
            return None
        with open(path, "rb") as handle:
            return DomainDatabase(handle.read())
    except Exception as e:
        log("LinkGuard: db read failed: %s" % e)
        return None


def fetch_database_stamp(timeout=20):
    try:
        import requests
        resp = requests.get(DB_BASE_URL + DB_MANIFEST_NAME, timeout=timeout,
                            params={"ts": int(time.time())},
                            headers={"User-Agent": "LinkGuard/%s" % __version__,
                                     "Cache-Control": "no-cache"})
        if resp.status_code != 200 or len(resp.content) > DB_MANIFEST_MAX:
            return None
        data = resp.json()
        if not isinstance(data, dict):
            return None
        stamp = str(data.get("built") or "")
        return stamp or None
    except Exception as e:
        log("LinkGuard: db stamp failed: %s" % e)
        return None


def fetch_database(name, timeout=90):
    try:
        import requests
        resp = requests.get(DB_BASE_URL + name, timeout=timeout,
                            headers={"User-Agent": "LinkGuard/%s" % __version__})
        if resp.status_code != 200:
            log("LinkGuard: db fetch HTTP %s" % resp.status_code)
            return None
        content = resp.content
        if len(content) > DB_MAX_BYTES or not content.startswith(DB_MAGIC):
            log("LinkGuard: db fetch rejected, %d bytes" % len(content))
            return None
        return content
    except Exception as e:
        log("LinkGuard: db fetch failed: %s" % e)
        return None


def domain_age_days(domain, timeout=8):
    try:
        import datetime
        import requests
        resp = requests.get(RDAP_URL % domain, timeout=timeout,
                            headers={"User-Agent": "LinkGuard/%s" % __version__,
                                     "Accept": "application/rdap+json"})
        if resp.status_code != 200:
            log("LinkGuard: rdap %s HTTP %s" % (domain, resp.status_code))
            return None
        for event in resp.json().get("events", []) or []:
            if str(event.get("eventAction", "")).lower() != "registration":
                continue
            stamp = str(event.get("eventDate", ""))[:10]
            born = datetime.date(int(stamp[0:4]), int(stamp[5:7]), int(stamp[8:10]))
            return (datetime.date.today() - born).days
    except Exception as e:
        log("LinkGuard: rdap failed: %s" % e)
    return None


def client_version():
    if find_class is None:
        return ""
    try:
        build = find_class("org.telegram.messenger.BuildVars")
        if build is None:
            return ""
        value = getattr(build, "BUILD_VERSION_STRING", "") or ""
        return str(value)
    except Exception as e:
        log("LinkGuard: client version unknown: %s" % e)
        return ""


def client_too_old(required):
    if not required:
        return False
    running = client_version()
    if not running:
        return False
    return parse_version(running) < parse_version(required)


def parse_version(text):
    parts = []
    for chunk in str(text).split(".")[:3]:
        digits = "".join(ch for ch in chunk if ch.isdigit())
        parts.append(int(digits) if digits else 0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts)


def fetch_update_info(timeout=8):
    try:
        import requests
        resp = requests.get(UPDATE_URL, timeout=timeout,
                            params={"ts": int(time.time())},
                            headers={"User-Agent": "LinkGuard/%s" % __version__,
                                     "Cache-Control": "no-cache",
                                     "Pragma": "no-cache"})
        if resp.status_code != 200:
            log("LinkGuard: update check HTTP %s" % resp.status_code)
            return None
        data = resp.json()
        return data if isinstance(data, dict) and data.get("version") else None
    except Exception as e:
        log("LinkGuard: update check failed: %s" % e)
        return None


def expand(url, timeout=6):
    resp = None
    try:
        import requests
        headers = {"User-Agent": "Mozilla/5.0 (Android) LinkGuard/1.0"}
        resp = requests.head(url, allow_redirects=True, timeout=timeout, headers=headers)
        if resp.status_code >= 400 or not resp.history:
            resp.close()
            resp = requests.get(url, allow_redirects=True, timeout=timeout,
                                headers=headers, stream=True)
        return resp.url, len(resp.history)
    except Exception as e:
        log("LinkGuard: expand failed: %s" % e)
        return None, 0
    finally:
        if resp is not None:
            try:
                resp.close()
            except Exception:
                pass


if MethodHook is not None:

    class OpenUrlHook(MethodHook):
        plugin_ref = None

        def before_hooked_method(self, param):
            plugin = self.plugin_ref or getattr(self, "plugin", None)
            if plugin is None:
                return
            try:
                plugin.on_open_url(param)
            except Exception as e:
                log("LinkGuard: hook error: %s" % e)

else:
    OpenUrlHook = None


class LinkGuardPlugin(BasePlugin):

    APPROVAL_WINDOW = 10.0

    def on_plugin_load(self):
        self._bypass = {}
        self._cache = {}
        self._anchors = {}
        self._hooks = []
        self._menu_check = self._menu_copy = None
        self._browser_cls = None
        self._progress = None
        self._counted = {}
        self._stats = {}
        self._sources = {}
        self._ages = {}
        self._db_ticked = 0.0
        self._db_loading = False
        self._log = []

        self._step("database", self._load_database)
        self._step("openUrl", self._install_open_url_hook)
        self._step("updates", self._install_update_hook)
        self._step("sendHook", self.add_on_send_message_hook)

        if HAS_MENU:
            self._step("menu", self._register_menu)
        else:
            log("LinkGuard: меню сообщений недоступно в этом SDK")
        self._maybe_check_updates()
        log("LinkGuard %s loaded, lang=%s" % (__version__, LANG))

    def on_plugin_unload(self):
        for h in getattr(self, "_hooks", []):
            try:
                self.unhook_method(h)
            except Exception:
                pass
        self._hooks = []
        for item in (getattr(self, "_menu_check", None), getattr(self, "_menu_copy", None)):
            if item:
                try:
                    self.remove_menu_item(item)
                except Exception:
                    pass

    def _register_menu(self):
        self._menu_check = self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text=phrase("menu_check"),
            icon="msg_info",
            subtext="Link Guard",
            priority=5,
            on_click=self.on_menu_check,
        ))
        self._menu_copy = self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text=phrase("menu_copy"),
            icon="msg_copy",
            priority=4,
            on_click=self.on_menu_copy,
        ))

    def create_settings(self):
        if not HAS_SETTINGS:
            return []
        self._sync_database_mode()
        return [
            Header(text=phrase("hdr_checks")),
            Switch(key="check_enabled", text=phrase("sw_check"), default=True,
                   subtext=phrase("sw_check_sub")),
            Selector(key="show_mode", text=phrase("sel_mode"), default=0,
                     items=[phrase("mode_suspicious"), phrase("mode_always")]),
            Switch(key="expand_short", text=phrase("sw_expand"), default=True,
                   subtext=phrase("sw_expand_sub")),
            Switch(key="check_age", text=phrase("sw_age"), default=False,
                   subtext=phrase("sw_age_sub")),

            Header(text=phrase("hdr_tracker")),
            Switch(key="clean_on_open", text=phrase("sw_clean_open"), default=True,
                   subtext=phrase("sw_clean_open_sub")),
            Switch(key="clean_outgoing", text=phrase("sw_clean_out"), default=False,
                   subtext=phrase("sw_clean_out_sub")),
            Switch(key="aggressive", text=phrase("sw_aggr"), default=False,
                   subtext=phrase("sw_aggr_sub")),
            Text(text=phrase("tags_title"), subtext=phrase("read_more"), on_click=self._on_tags_note),

        ] + self._exception_rows() + [

            Header(text=phrase("hdr_stats")),
        ] + self._detail_row(
            phrase("stats_line", self._stat("stats_cleaned")),
            phrase("stats_detail", self._stat("stats_warned")),
            phrase("stats_sub", self._stat("stats_warned")),
            self._on_reset_stats_click,
            caption=phrase("stats_hint"),
        ) + [

            Header(text=phrase("db_title")),
            Switch(key="use_database", text=phrase("sw_database"), default=True,
                   subtext=phrase("sw_database_sub")),
        ] + self._detail_row(
            phrase("db_refresh"),
            self._database_status(full=True),
            self._database_status(),
            self._on_refresh_database_click,
        ) + [

            Header(text=phrase("hdr_updates")),
            Switch(key="check_updates", text=phrase("sw_updates"), default=True,
                   subtext=phrase("sw_updates_sub")),
            Text(text=phrase("btn_check_now"), subtext=phrase("version_line", __version__),
                 accent=True, on_click=self._on_check_updates_click),
        ] + self._detail_row(
            phrase("btn_repo"), phrase("btn_repo_detail"), phrase("btn_repo_sub"),
            self._on_repo_click, divider=True,
        ) + self._detail_row(
            phrase("btn_chat"), phrase("btn_chat_detail"), phrase("btn_chat_sub"),
            self._on_chat_click,
        ) + [

            Divider(),
            Text(text=phrase("privacy_title"), subtext=phrase("read_more"),
                 on_click=self._on_privacy_note),
        ] + self._diagnostic_rows()

    def _detail_row(self, title, detail, short, handler, caption=None, divider=False):
        cell = self._detail_cell(title, detail, divider)
        if cell is not None:
            try:
                return [Custom(view=cell, on_click=lambda *args: handler())]
            except Exception as e:
                self._debug("settings: своя строка не собралась: %s" % e)
        rows = [Text(text=title, subtext=short, on_click=handler)]
        if caption:
            rows.append(Divider(text=caption))
        return rows

    def _detail_cell(self, title, detail, divider):
        if Custom is None or TextDetailSettingsCell is None:
            return None
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return None
            cell = TextDetailSettingsCell(activity)
            cell.setMultilineDetail(True)
            cell.setTextAndValue(title, detail, bool(divider))
            return cell
        except Exception as e:
            self._debug("settings: ячейка с переносом недоступна: %s" % e)
            return None

    def _diagnostic_rows(self):
        if not DEBUG_BUILD:
            return []
        return [
            Header(text=phrase("hdr_diag")),
            Switch(key="debug_log", text=phrase("sw_debug"), default=False,
                   subtext=phrase("sw_debug_sub")),
            Text(text=phrase("log_show"), subtext=phrase("log_show_sub"),
                 on_click=self._on_show_log, on_long_click=self._on_clear_log),
        ]

    def _exception_rows(self):
        rows = [Header(text=phrase("hdr_exceptions"))]
        domains = self._whitelist_list()
        if domains:
            for domain in domains:
                rows.append(Text(text=domain, subtext=phrase("hold_to_delete"),
                                 on_click=self._make_hint(),
                                 on_long_click=self._make_remove(domain)))
        else:
            rows.append(Text(text=phrase("empty_list"), subtext=phrase("empty_list_sub")))
        rows.append(Input(key="whitelist_add", text=phrase("in_whitelist"),
                          default=self.get_setting("whitelist_add", "") or "",
                          subtext=phrase("in_whitelist_sub")))
        rows.append(Text(text=phrase("btn_add"), accent=True, on_click=self._on_add_domain))
        return rows

    def _make_hint(self):
        def handler(*args):
            self._toast(phrase("hold_to_delete"))
            return True
        return handler

    def _make_remove(self, domain):
        def handler(*args):
            self._ask_remove(domain)
            return True
        return handler

    def _ask_remove(self, domain):
        if not self._can_dialog():
            self._remove_domain(domain)
            return

        def accept(dialog, which):
            dialog.dismiss()
            self._remove_domain(domain)

        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(phrase("del_title"))
        builder.set_message(phrase("del_body", domain))
        builder.set_positive_button(phrase("btn_cancel"), lambda d, w: d.dismiss())
        builder.set_negative_button(phrase("btn_delete"), accept)
        builder.show()

    def _remove_domain(self, domain):
        domains = [d for d in self._whitelist_list() if d != domain]
        self._save_whitelist(domains)
        self._toast(phrase("toast_removed", domain))

    def _on_add_domain(self, *args):
        domain = normalize_domain(self.get_setting("whitelist_add", "") or "")
        if not domain:
            self._toast(phrase("toast_bad_domain"))
            return
        domains = self._whitelist_list()
        if domain not in domains:
            domains.append(domain)
        self.set_setting("whitelist_add", "")
        self._save_whitelist(domains)
        self._toast(phrase("toast_added", domain))

    def _save_whitelist(self, domains):
        if getattr(self, "_cache", None) is not None:
            self._cache.clear()
        self.set_setting("whitelist", ", ".join(domains), reload_settings=True)

    def _whitelist_list(self):
        raw = self.get_setting("whitelist", "") or ""
        seen = []
        for part in re.split(r"[,\s]+", raw):
            item = part.strip().lower().lstrip("*.")
            if item and item not in seen:
                seen.append(item)
        return seen

    def _whitelist(self):
        return set(self._whitelist_list())

    def _aggressive(self):
        return bool(self.get_setting("aggressive", False))

    def _stat(self, key):
        tally = getattr(self, "_stats", None)
        if tally is not None and key in tally:
            return tally[key]
        try:
            return int(self.get_setting(key, 0) or 0)
        except (TypeError, ValueError):
            return 0

    def _count_once(self, url):
        seen = getattr(self, "_counted", None)
        if seen is None:
            seen = self._counted = {}
        now = time.monotonic()
        for key, moment in list(seen.items()):
            if now - moment > COUNT_WINDOW:
                seen.pop(key, None)
        if url in seen:
            return False
        seen[url] = now
        return True

    def _bump(self, key, amount=1):
        if not amount:
            return
        value = self._stat(key) + amount
        if getattr(self, "_stats", None) is None:
            self._stats = {}
        self._stats[key] = value
        self.set_setting(key, value, reload_settings=True)
        self._debug("%s +%s -> %s" % (key, amount, value))

    def _on_reset_stats_click(self, *args):
        self._stats = {"stats_cleaned": 0, "stats_warned": 0}
        self.set_setting("stats_cleaned", 0)
        self.set_setting("stats_warned", 0, reload_settings=True)
        self._toast(phrase("stats_done"))

    def _step(self, name, action):
        try:
            action()
            self._debug("load: %s ok" % name)
            return True
        except Exception as e:
            log("LinkGuard: load step %s failed: %s" % (name, e))
            self._debug("load: %s упал — %s" % (name, e))
            return False

    def _database_enabled(self):
        return bool(self.get_setting("use_database", True))

    def _database_path(self):
        folders = self._writable_dirs()
        return os.path.join(folders[0], DB_FILE_NAME) if folders else None

    def _sweep_database_copies(self):
        swept = 0
        for folder in self._writable_dirs()[1:]:
            stale = os.path.join(folder, DB_FILE_NAME)
            try:
                if os.path.exists(stale):
                    os.remove(stale)
                    swept += 1
            except Exception as e:
                self._debug("db: забытая копия не удалена: %s" % e)
        if swept:
            self._debug("db: убрано забытых копий: %d" % swept)
        return swept

    def _moment(self, key):
        try:
            return float(self.get_setting(key, 0) or 0)
        except (TypeError, ValueError):
            return 0.0

    def _failures(self):
        try:
            return int(self.get_setting("db_failures", 0) or 0)
        except (TypeError, ValueError):
            return 0

    def _due_for_refresh(self, database):
        now = time.time()
        if database is None:
            gap = DB_RETRY_GAP
            if self._failures() >= DB_RETRY_LIMIT:
                gap = DB_RETRY_LONG
            return now - self._moment("db_attempt_at") >= gap
        return now - self._moment("db_checked_at") >= DB_CHECK_GAP

    def _tick_database(self):
        if not self._database_enabled():
            return
        now = time.time()
        if now - getattr(self, "_db_ticked", 0) < DB_TICK_GAP:
            return
        self._db_ticked = now
        due = self._due_for_refresh(active_database())
        self._debug("db: пора проверять — %s" % ("да" if due else "нет"))
        if due:
            self._run_background(lambda: self._refresh_database(manual=False))

    def _load_database(self):
        if not self._database_enabled():
            install_database(None)
            return
        self._sweep_database_copies()
        path = self._database_path()
        database = read_database(path)
        if database is not None:
            install_database(database)
            self._debug("db: с диска, %d записей, возраст %d дн." % (
                database.total, database.age_days))
        elif path and os.path.exists(path):
            try:
                os.remove(path)
                self._debug("db: испорченный файл удалён")
            except Exception as e:
                self._debug("db: испорченный файл не удалён: %s" % e)
        if self._due_for_refresh(database):
            self._run_background(lambda: self._refresh_database(manual=False))

    def _refresh_database(self, manual=False):
        if not self._database_enabled():
            return
        stamp = fetch_database_stamp()
        if stamp:
            self.set_setting("db_checked_at", time.time())
            known = str(self.get_setting("db_built", "") or "")
            if not manual and stamp == known and active_database() is not None:
                self._debug("db: на сервере та же сборка (%s), не качаем" % stamp)
                return
            self._debug("db: на сервере сборка %s, у нас %s" % (stamp, known or "нет"))
        elif not manual and active_database() is not None:
            self._debug("db: описание сборки не пришло, база есть — вслепую не качаем")
            return
        content = fetch_database(DB_NAME)
        self.set_setting("db_attempt_at", time.time())
        if not content:
            self.set_setting("db_failures", self._failures() + 1)
            if manual:
                run_on_ui_thread(lambda: self._toast(phrase("db_failed")))
            return
        try:
            database = DomainDatabase(content)
        except Exception as e:
            self.set_setting("db_failures", self._failures() + 1)
            self._debug("db: файл не разобран: %s" % e)
            if manual:
                run_on_ui_thread(lambda: self._toast(phrase("db_failed")))
            return

        self.set_setting("db_failures", 0)
        install_database(database)
        if getattr(self, "_cache", None) is not None:
            self._cache.clear()
        path = self._database_path()
        if path:
            partial = path + ".part"
            try:
                with open(partial, "wb") as handle:
                    handle.write(content)
                os.replace(partial, path)
            except Exception as e:
                self._debug("db: не сохранилась: %s" % e)
                try:
                    if os.path.exists(partial):
                        os.remove(partial)
                except Exception:
                    pass
        total = database.total
        self.set_setting("db_checked_at", time.time())
        if stamp:
            self.set_setting("db_built", stamp)
        self._debug("db: из сети, %d записей, сборка %s" % (total, stamp or "?"))
        run_on_ui_thread(lambda: self._after_refresh(total, manual))

    def _after_refresh(self, total, manual):
        if manual:
            self._toast(phrase("db_updated", big_amount(total, "unit_entry")))
        try:
            self.set_setting("db_entries", total, reload_settings=True)
        except Exception as e:
            self._debug("db: экран не перерисовался: %s" % e)
            self.set_setting("db_entries", total)

    def _on_refresh_database_click(self, *args):
        if not self._database_enabled():
            self._toast(phrase("db_off"))
            return
        self._toast(phrase("toast_checking"))
        self._run_background(lambda: self._refresh_database(manual=True))

    def _sync_database_mode(self):
        enabled = self._database_enabled()
        if enabled == bool(self.get_setting("db_applied", True)):
            return
        self.set_setting("db_applied", enabled)
        install_database(None)
        if getattr(self, "_cache", None) is not None:
            self._cache.clear()
        if enabled:
            self._db_loading = True
            self._run_background(self._reenable_database)

    def _reenable_database(self):
        try:
            database = read_database(self._database_path())
            if database is None:
                self._refresh_database(manual=True)
                return
            install_database(database)
            if getattr(self, "_cache", None) is not None:
                self._cache.clear()
            self._debug("db: снова включена, взята копия с диска")
            if self._due_for_refresh(database):
                self._refresh_database(manual=False)
        finally:
            self._db_loading = False
            loaded = active_database()
            total = loaded.total if loaded is not None else 0
            run_on_ui_thread(lambda: self._after_refresh(total, False))

    def _database_status(self, full=False):
        database = active_database()
        if not self._database_enabled():
            return phrase("db_status_off")
        if database is None:
            if getattr(self, "_db_loading", False):
                return phrase("db_status_loading")
            return phrase("db_status_none")
        days = database.age_days
        when = phrase("db_today") if days < 1 else phrase("db_ago", amount(days, "unit_day"))
        return phrase("db_status_full" if full else "db_status",
                      big_amount(database.total, "unit_entry"), when)

    def _maybe_check_updates(self):
        if not self.get_setting("check_updates", True):
            return

        known = str(self.get_setting("update_version", "") or "")
        if known and parse_version(known) > parse_version(__version__):
            info = {"version": known,
                    "changelog": self.get_setting("update_changelog", "") or "",
                    "url": self.get_setting("update_url", "") or REPO_URL}
            run_on_ui_thread(lambda: self._show_update(info, known))
            return

        try:
            last = float(self.get_setting("update_checked_at", 0) or 0)
        except (TypeError, ValueError):
            last = 0
        if time.time() - last < UPDATE_INTERVAL:
            return
        self._run_background(lambda: self._check_updates(manual=False))

    def _run_background(self, func):
        def safe():
            try:
                func()
            except Exception as e:
                log("LinkGuard: background task failed: %s" % e)

        if run_on_queue is not None:
            try:
                run_on_queue(safe)
                return
            except Exception:
                pass
        threading.Thread(target=safe, daemon=True).start()

    def _check_updates(self, manual=False):
        info = fetch_update_info()
        self.set_setting("update_checked_at", time.time())
        if not info:
            if manual:
                run_on_ui_thread(lambda: self._toast(phrase("toast_upd_failed")))
            return

        remote = str(info.get("version", ""))
        needed = str(info.get("min_app_version", "") or "")
        if client_too_old(needed):
            self._debug("update: %s требует клиент %s, а стоит %s"
                        % (remote, needed, client_version()))
            if manual:
                run_on_ui_thread(lambda: self._toast(
                    phrase("upd_client_old", needed)))
            return

        local, published = parse_version(__version__), parse_version(remote)
        if published <= local:
            if manual:
                text = (phrase("upd_none", __version__) if published == local
                        else phrase("upd_ahead", __version__, remote))
                run_on_ui_thread(lambda: self._toast(text))
            return

        raw_log = info.get("changelog", "")
        if isinstance(raw_log, (list, tuple)):
            raw_log = LINE_BREAK.join(str(item) for item in raw_log)
        self.set_setting("update_version", remote)
        self.set_setting("update_changelog", str(raw_log))
        self.set_setting("update_url", str(info.get("url") or REPO_URL))
        run_on_ui_thread(lambda: self._show_update(info, remote))

    @staticmethod
    def _format_changelog(info):
        raw = info.get("changelog", "")
        if isinstance(raw, (list, tuple)):
            items = [str(i).strip() for i in raw if str(i).strip()]
        else:
            items = [line.strip(" -•\t") for line in str(raw).splitlines() if line.strip()]
        if not items:
            return ""
        return "%s\n%s" % (phrase("upd_whats_new"), "\n".join("• " + item for item in items))

    def _show_update(self, info, remote, attempt=0):
        link = str(info.get("url") or REPO_URL)

        if not self._can_dialog():
            if attempt < 5:
                run_on_ui_thread(lambda: self._show_update(info, remote, attempt + 1), 3000)
            else:
                self._toast(phrase("toast_upd_available", remote))
            return

        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(phrase("upd_title", remote))
        builder.set_message(phrase("upd_body", __version__, self._format_changelog(info), link))
        builder.set_positive_button(
            phrase("upd_install"), lambda d, w: (d.dismiss(), self._install_update(link, remote)))
        builder.set_negative_button(phrase("btn_later"), lambda d, w: d.dismiss())
        builder.show()

    def _install_update(self, link, remote):
        self._show_progress()
        self._run_background(lambda: self._download_update(link, remote))

    def _show_progress(self):
        self._progress = None
        if not self._can_dialog():
            return
        try:
            builder = AlertDialogBuilder(get_last_fragment().getParentActivity(),
                                         AlertDialogBuilder.ALERT_TYPE_SPINNER)
            builder.set_title(phrase("upd_downloading"))
            builder.set_cancelable(False)
            builder.show()
            self._progress = builder
        except Exception as e:
            log("LinkGuard: progress dialog failed: %s" % e)

    def _hide_progress(self):
        dialog, self._progress = getattr(self, "_progress", None), None
        if dialog is not None:
            try:
                dialog.dismiss()
            except Exception:
                pass

    def _download_update(self, link, remote):
        path, reason = None, ""
        try:
            import requests
            resp = requests.get(link, timeout=30,
                                headers={"User-Agent": "LinkGuard/%s" % __version__})
            if resp.status_code != 200:
                reason = "HTTP %s" % resp.status_code
            elif not self._looks_like_our_plugin(resp.content):
                reason = "файл не похож на Link Guard"
                self._debug("update: скачанное не похоже на плагин, установка отменена")
            else:
                path, reason = self._store_plugin_file(resp.content, remote)
        except Exception as e:
            reason = str(e)
            log("LinkGuard: download failed: %s" % e)

        run_on_ui_thread(lambda: self._finish_download(path, reason, link, remote))

    def _writable_dirs(self):
        found = []
        for getter in (get_plugins_dir, get_cache_dir, get_documents_dir):
            if getter is None:
                continue
            try:
                value = str(getter() or "").rstrip("/")
                if value:
                    found.append(value)
            except Exception as e:
                self._debug("update: каталог недоступен: %s" % e)
        try:
            loader = find_class("org.telegram.messenger.ApplicationLoader")
            if loader is not None:
                found.append(str(loader.applicationContext.getCacheDir().getAbsolutePath()))
        except Exception as e:
            self._debug("update: кэш приложения недоступен: %s" % e)
        try:
            import tempfile
            found.append(tempfile.gettempdir())
        except Exception:
            pass
        return [f for f in dict.fromkeys(found) if f]

    MAX_PLUGIN_SIZE = 2 * 1024 * 1024

    def _looks_like_our_plugin(self, content):
        if not content or len(content) > self.MAX_PLUGIN_SIZE:
            return False
        head = content[:4096].decode("utf-8", "ignore")
        return '__id__ = "link_guard"' in head and "__version__" in head

    def _store_plugin_file(self, content, remote):
        name = "link_guard_%s.plugin" % str(remote).replace(".", "_")
        problems = []
        for folder in self._writable_dirs():
            path = os.path.join(folder, name)
            try:
                if not os.path.isdir(folder):
                    os.makedirs(folder, exist_ok=True)
                with open(path, "wb") as handle:
                    handle.write(content)
                if os.path.exists(path) and os.path.getsize(path) == len(content):
                    self._debug("update: файл сохранён в %s" % path)
                    return path, ""
                problems.append("файл записан не полностью")
            except Exception as e:
                problems.append(str(e))
                self._debug("update: запись в %s не удалась: %s" % (path, e))
        return None, "; ".join(problems[:2]) or "нет доступной папки"

    def _finish_download(self, path, reason, link, remote):
        self._hide_progress()
        if not path:
            copy_to_clipboard(link)
            self._toast(phrase("upd_dl_why", (reason or "неизвестно")[:70]))
            return
        if self._launch_install(path):
            self._toast(phrase("upd_ready"))
            return
        copy_to_clipboard(link)
        self._toast(phrase("upd_dl_failed"))

    def _launch_install(self, path):
        if PluginsController is None:
            self._debug("update: PluginsController недоступен")
            return False
        fragment = get_last_fragment()
        if fragment is None:
            return False
        try:
            if JavaFile is not None:
                if PluginsController.getPluginEngine(JavaFile(path)) is None:
                    self._debug("update: движок не опознал файл")
                    return False
            PluginsController.getInstance().showInstallDialog(fragment, path, True)
            self._debug("update: открыт диалог установки")
            return True
        except Exception as e:
            log("LinkGuard: install dialog failed: %s" % e)
            return False

    def _on_check_updates_click(self, *args):
        self._toast(phrase("toast_checking"))
        self._run_background(lambda: self._check_updates(manual=True))

    def _install_open_url_hook(self):
        if OpenUrlHook is None:
            log("LinkGuard: хуки недоступны в этом SDK, работает только чистка исходящих")
            return
        try:
            handler = OpenUrlHook()
        except TypeError:
            handler = OpenUrlHook(self)
        handler.plugin_ref = self

        for class_name in ("org.telegram.messenger.browser.Browser",):
            try:
                cls = find_class(class_name)
            except Exception:
                cls = None
            if cls is None:
                continue
            self._browser_cls = cls
            try:
                hooks = self.hook_all_methods(cls, "openUrl", handler)
                if hooks:
                    self._hooks.extend(hooks if isinstance(hooks, list) else [hooks])
                    log("LinkGuard: hooked %s.openUrl" % class_name)
            except Exception as e:
                log("LinkGuard: cannot hook %s: %s" % (class_name, e))
        if not self._hooks:
            log("LinkGuard: openUrl не найден, проверка при переходе отключена")

    UPDATE_NAMES = ("TL_updateNewMessage", "TL_updateNewChannelMessage",
                    "TL_updateShortMessage", "TL_updateShortChatMessage",
                    "TL_updates", "TL_updatesCombined")

    def _install_update_hook(self):
        registered = 0
        for name in self.UPDATE_NAMES:
            try:
                self.add_hook(name)
                registered += 1
            except Exception as e:
                log("LinkGuard: hook %s failed: %s" % (name, e))
        self._debug("updates: подписок %d из %d" % (registered, len(self.UPDATE_NAMES)))

    def on_update_hook(self, update_name, account, update):
        self._debug("update: %s" % update_name)
        self._consume_update(update)
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            items = getattr(updates, "updates", None)
            if items is None:
                self._consume_update(updates)
                return HookResult()
            total = items.size()
            names = []
            for i in range(total):
                item = items.get(i)
                if len(names) < 6:
                    names.append(type(item).__name__)
                self._consume_update(item)
            self._debug("updates: %s, внутри %d: %s"
                        % (container_name, total, ", ".join(names) or "пусто"))
        except Exception as e:
            self._debug("updates: разбор не удался — %s" % e)
        return HookResult()

    def _consume_update(self, update):
        try:
            payload = getattr(update, "message", None)
            if isinstance(payload, str):
                self._index_anchors(payload, getattr(update, "entities", None))
                self._index_source(update, payload)
            elif payload is not None:
                text = getattr(payload, "message", None)
                self._index_anchors(text, getattr(payload, "entities", None))
                self._index_source(payload, text)
        except Exception as e:
            self._debug("update: разбор не удался — %s" % e)

    @staticmethod
    def _message_source(message):
        try:
            if getattr(message, "out", False):
                return "trusted"
            peer = getattr(message, "peer_id", None)
            if peer is not None and int(getattr(peer, "channel_id", 0) or 0):
                return "unknown"
            from_id = getattr(message, "from_id", None)
            user_id = int(getattr(message, "user_id", 0) or 0)
            for holder in (from_id, peer):
                if user_id:
                    break
                if holder is None:
                    continue
                user_id = int(getattr(holder, "user_id", 0) or 0)
                if user_id:
                    break
            if not user_id:
                return "unknown"
            if get_messages_controller is None:
                return None
            user = get_messages_controller().getUser(user_id)
            if user is None:
                return None
            return "trusted" if getattr(user, "contact", False) else "unknown"
        except Exception:
            return None

    def _fragment_source(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            if fragment.getCurrentChat() is not None:
                return "unknown"
        except Exception:
            pass
        try:
            user = fragment.getCurrentUser()
        except Exception:
            return None
        if user is None:
            return None
        try:
            if getattr(user, "self", False) or getattr(user, "contact", False):
                return "trusted"
            return "unknown"
        except Exception:
            return None

    def _index_source(self, message, text):
        source = self._message_source(message)
        if not source:
            return
        holder = getattr(self, "_sources", None)
        if holder is None:
            return
        found = list(URL_RE.findall(str(text or "")))
        found.extend(self._anchor_urls(message))
        for url in found:
            if len(holder) >= ANCHOR_MAX:
                holder.clear()
            holder[url] = source

    @staticmethod
    def _anchor_urls(message):
        urls = []
        try:
            entities = getattr(message, "entities", None)
            for i in range(entities.size()):
                url = getattr(entities.get(i), "url", None)
                if url:
                    urls.append(str(url))
        except Exception:
            pass
        return urls

    def _index_anchors(self, text, entities):
        if not text or entities is None:
            return
        try:
            total = entities.size()
        except Exception:
            return
        text = str(text)
        for i in range(total):
            try:
                entity = entities.get(i)
                url = getattr(entity, "url", None)
                if not url:
                    continue
                offset = int(getattr(entity, "offset", 0) or 0)
                length = int(getattr(entity, "length", 0) or 0)
                shown = slice_utf16(text, offset, length)
                if shown:
                    self._remember_anchor(str(url), shown)
            except Exception:
                continue

    def _remember_anchor(self, url, shown):
        anchors = getattr(self, "_anchors", None)
        if anchors is None:
            return
        if len(anchors) >= ANCHOR_MAX:
            anchors.clear()
        anchors[url] = shown

    def _cached_analyze(self, url, anchor=None):
        aggressive = self._aggressive()
        whitelist = self._whitelist()
        signature = (aggressive, tuple(sorted(whitelist)), anchor or "", LANG)
        now = time.time()
        cache = getattr(self, "_cache", None)

        if cache is not None:
            hit = cache.get(url)
            if hit and hit[0] == signature and now - hit[1] < CACHE_TTL:
                return hit[2].clone()

        verdict = analyze(url, aggressive, whitelist, anchor)
        if cache is not None:
            if len(cache) >= CACHE_MAX:
                cache.clear()
            cache[url] = (signature, now, verdict.clone())
        return verdict

    @staticmethod
    def _find_url_arg(param):
        for i, arg in enumerate(param.args):
            if arg is None:
                continue
            try:
                text = str(arg)
            except Exception:
                continue
            if "://" in text or text.lower().startswith("www."):
                return i, text
        return None, None

    def _is_approved(self, url):
        now = time.monotonic()
        stamps = getattr(self, "_bypass", None)
        if not stamps:
            return False
        for key, moment in list(stamps.items()):
            if now - moment > self.APPROVAL_WINDOW:
                stamps.pop(key, None)
        return url in stamps

    def on_open_url(self, param):
        if not self.get_setting("check_enabled", True):
            return

        self._tick_database()

        index, url = self._find_url_arg(param)
        if url is None:
            return

        if self._is_approved(url):
            return

        verdict = self._cached_analyze(url, self._anchors.get(url))
        verdict.source = self._sources.get(url) or self._fragment_source()
        try:
            mode = int(self.get_setting("show_mode", 0) or 0)
        except (TypeError, ValueError):
            mode = 0
        expand_short = bool(self.get_setting("expand_short", True))
        clean_on_open = bool(self.get_setting("clean_on_open", True))
        ask_age = bool(self.get_setting("check_age", False))

        if mode >= 1:
            worth_showing = True
        elif verdict.source == "trusted":
            worth_showing = verdict.suspicious
        else:
            worth_showing = bool(verdict.flags)

        wants_age = (ask_age and bool(verdict.flags)
                     and DOMAIN_RE.fullmatch(registrable(verdict.host or "")) is not None)
        needs_dialog = (worth_showing or (verdict.is_shortener and expand_short)
                        or wants_age) and self._can_dialog()

        self._debug("open %s risk=%s source=%s age=%s dialog=%s arg=%s"
                    % (url, verdict.risk, verdict.source,
                       "да" if wants_age else ("выкл" if not ask_age else "нет"),
                       needs_dialog, type(param.args[index]).__name__))

        if not needs_dialog:
            if clean_on_open and verdict.cleaned != url:
                if self._replace_url_arg(param.args, index, verdict.cleaned):
                    removed = len(verdict.removed_params) if self._count_once(url) else 0
                    self._bump("stats_cleaned", removed)
                    self._debug("cleaned -> %s" % verdict.cleaned)
                    if removed:
                        run_on_ui_thread(lambda: self._toast(phrase("toast_cleaned", removed)))
                else:
                    self._debug("не удалось подставить очищенный адрес")
            return

        param.setResult(None)
        method = param.method
        args = list(param.args)

        unfold = verdict.is_shortener and expand_short
        if unfold or wants_age:
            self._enrich_then_show(verdict, method, args, index, unfold, wants_age)
        else:
            self._show_verdict(verdict, method, args, index)

    def _enrich_then_show(self, verdict, method, args, index, unfold, wants_age):
        def worker():
            if unfold:
                try:
                    final, hops = expand(verdict.cleaned)
                    if final:
                        inner = analyze(final, self._aggressive(), self._whitelist())
                        if self.get_setting("clean_on_open", True) and inner.removed_params:
                            final = inner.cleaned
                            verdict.removed_params.extend(inner.removed_params)
                        verdict.final = final
                        for level, text in inner.flags:
                            verdict.add(level, text)
                        if hops:
                            verdict.add(INFO, phrase("f_hops", hops))
                except Exception as e:
                    log("LinkGuard: expand worker failed: %s" % e)
            if wants_age:
                try:
                    target = verdict.final or verdict.cleaned
                    host = (urlsplit(target).hostname or verdict.host or "").lower()
                    add_age_flag(verdict, self._domain_age(registrable(host)))
                except Exception as e:
                    log("LinkGuard: age worker failed: %s" % e)
            run_on_ui_thread(lambda: self._finish_expanded(verdict, method, args, index))

        self._run_background(worker)

    def _domain_age(self, domain):
        if not domain:
            return None
        cache = getattr(self, "_ages", None)
        if cache is None:
            cache = self._ages = {}
        now = time.time()
        hit = cache.get(domain)
        if hit:
            age = AGE_CACHE_TTL if hit[1] is not None else AGE_MISS_TTL
            if now - hit[0] < age:
                return hit[1]
        if not DOMAIN_RE.fullmatch(domain or ""):
            self._debug("rdap: %s — не доменное имя, пропускаю" % domain)
            return None
        self._debug("rdap: спрашиваю %s" % domain)
        days = domain_age_days(domain)
        if days is None or days < 0:
            if len(cache) >= AGE_CACHE_MAX:
                cache.clear()
            cache[domain] = (now, None)
            self._debug("rdap: %s — ответа нет" % domain)
            return None
        if len(cache) >= AGE_CACHE_MAX:
            cache.clear()
        cache[domain] = (now, days)
        self._debug("rdap: %s -> %s дней" % (domain, days))
        return days

    def _finish_expanded(self, verdict, method, args, index):
        if self._can_dialog():
            self._show_verdict(verdict, method, args, index)
            return
        if verdict.risk == HIGH:
            self._toast(phrase("toast_blocked"))
            return
        self._reopen(method, args, index, verdict.final or verdict.cleaned)

    @staticmethod
    def _title(verdict):
        if verdict.risk == HIGH:
            return phrase("title_danger")
        if verdict.risk == MEDIUM:
            return phrase("title_suspicious")
        return phrase("title_info")

    def _describe(self, verdict):
        lines = []
        shown = verdict.display_host or verdict.host
        if shown:
            lines.append(phrase("lbl_domain", shown))
        if verdict.final and verdict.final != verdict.cleaned:
            lines.append(phrase("lbl_leads", verdict.final))
        if verdict.removed_params:
            lines.append(phrase("lbl_removed", len(verdict.removed_params),
                           ", ".join(verdict.removed_params[:4])))
        if verdict.age_days is not None:
            lines.append(phrase("lbl_age", human_age(verdict.age_days)))
        if verdict.source == "unknown":
            lines.append(phrase("src_stranger"))
        elif verdict.source == "trusted":
            lines.append(phrase("src_trusted"))

        marks = {HIGH: "⛔", MEDIUM: "⚠️", LOW: "•", INFO: "•"}
        problems = sorted(verdict.flags, key=lambda f: -_RISK_ORDER[f[0]])
        if problems:
            lines.append("")
            for level, text in problems:
                lines.append("%s %s" % (marks[level], text))

        target = verdict.final or verdict.cleaned
        lines.append("")
        lines.append(target if len(target) <= 300 else target[:300] + "…")
        return "\n".join(lines)

    @staticmethod
    def _can_dialog():
        if AlertDialogBuilder is None:
            return False
        fragment = get_last_fragment()
        try:
            return bool(fragment and fragment.getParentActivity())
        except Exception:
            return False

    def _show_verdict(self, verdict, method, args, index):
        if not self._can_dialog():
            return
        activity = get_last_fragment().getParentActivity()
        target = verdict.final or (
            verdict.cleaned if self.get_setting("clean_on_open", True) else verdict.original)

        if verdict.suspicious:
            self._bump("stats_warned")

        builder = AlertDialogBuilder(activity)
        builder.set_title(self._title(verdict))
        builder.set_message(self._describe(verdict))

        def do_open(dialog, which):
            dialog.dismiss()
            removed = len(verdict.removed_params)
            if removed and self._count_once(verdict.original):
                self._bump("stats_cleaned", removed)
            self._reopen(method, args, index, target)

        def do_trust(dialog, which):
            dialog.dismiss()
            self._confirm_trust(verdict, method, args, index, target)

        if verdict.risk == HIGH:
            builder.set_positive_button(phrase("btn_cancel"), lambda d, w: d.dismiss())
            builder.set_negative_button(phrase("btn_open"), do_open)
        else:
            builder.set_positive_button(phrase("btn_open"), do_open)
            builder.set_negative_button(phrase("btn_cancel"), lambda d, w: d.dismiss())
            if verdict.host:
                builder.set_neutral_button(phrase("btn_trust"), do_trust)
        builder.show()

    def _confirm_trust(self, verdict, method, args, index, target):
        domain = registrable(verdict.display_host or verdict.host)
        if not domain or not self._can_dialog():
            return

        def accept(dialog, which):
            dialog.dismiss()
            self._trust_domain(domain)
            self._reopen(method, args, index, target)

        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(phrase("trust_title"))
        builder.set_message(phrase("trust_body", domain))
        builder.set_positive_button(phrase("btn_cancel"), lambda d, w: d.dismiss())
        builder.set_negative_button(phrase("btn_trust_yes"), accept)
        builder.show()

    def _trust_domain(self, domain):
        if not domain:
            return
        domains = self._whitelist_list()
        if domain not in domains:
            domains.append(domain)
        self._save_whitelist(domains)
        self._toast(phrase("toast_trusted", domain))

    def _debug(self, message):
        if not self.get_setting("debug_log", False):
            return
        log("LinkGuard: %s" % message)
        if not DEBUG_BUILD:
            return
        lines = getattr(self, "_log", None)
        if lines is None:
            lines = self._log = []
        lines.append("%s  %s" % (time.strftime("%H:%M:%S"), message))
        if len(lines) > LOG_MAX:
            del lines[:len(lines) - LOG_MAX]

    def _log_text(self):
        lines = getattr(self, "_log", None) or []
        if not lines:
            return phrase("log_empty")
        head = phrase("log_head", __version__, len(lines))
        return head + LINE_BREAK + LINE_BREAK.join(lines)

    def _on_show_log(self, *args):
        text = self._log_text()
        tail = text
        if len(tail) > 3500:
            tail = phrase("log_cut") + LINE_BREAK + tail[-3500:]
        if not self._can_dialog():
            self._toast(tail)
            return
        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(phrase("log_title"))
        builder.set_message(tail)
        builder.set_positive_button(phrase("btn_ok"), lambda d, w: d.dismiss())
        builder.set_neutral_button(phrase("log_copy"),
                                   lambda d, w: self._copy_log(d))
        builder.show()

    def _copy_log(self, dialog=None):
        copy_to_clipboard(self._log_text())
        if dialog is not None:
            dialog.dismiss()
        self._toast(phrase("log_copied"))

    def _on_clear_log(self, *args):
        self._log = []
        self._toast(phrase("log_cleared"))

    def _show_note(self, title, body):
        if not self._can_dialog():
            self._toast(body)
            return
        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(title)
        builder.set_message(body)
        builder.set_positive_button(phrase("btn_ok"), lambda d, w: d.dismiss())
        builder.show()

    def _on_tags_note(self, *args):
        self._show_note(phrase("tags_title"), phrase("tags_note"))

    def _on_privacy_note(self, *args):
        self._show_note(phrase("privacy_title"), phrase("privacy_note"))


    @staticmethod
    def _replace_url_arg(args, index, url):
        if index is None or not args:
            return False
        current = args[index]
        if isinstance(current, str):
            args[index] = url
            return True
        try:
            uri_cls = find_class("android.net.Uri")
            if uri_cls is not None and getattr(current, "getScheme", None) is not None:
                args[index] = uri_cls.parse(url)
                return True
        except Exception as e:
            log("LinkGuard: uri replace failed: %s" % e)
        return False

    @staticmethod
    def _context_from(args):
        for arg in args or ():
            if isinstance(arg, str) or arg is None:
                continue
            if getattr(arg, "getPackageName", None) is not None:
                return arg
        return None

    def _open_with_browser(self, context, url):
        if self._browser_cls is None or context is None:
            return False
        try:
            self._browser_cls.openUrl(context, url)
            return True
        except Exception as e:
            log("LinkGuard: browser.openUrl failed: %s" % e)
            return False

    @staticmethod
    def _open_with_intent(context, url):
        if context is None:
            return False
        try:
            intent_cls = find_class("android.content.Intent")
            uri_cls = find_class("android.net.Uri")
            if intent_cls is None or uri_cls is None:
                return False
            intent = intent_cls(intent_cls.ACTION_VIEW, uri_cls.parse(url))
            intent.addFlags(intent_cls.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
            return True
        except Exception as e:
            log("LinkGuard: intent failed: %s" % e)
            return False

    def _own_context(self):
        try:
            fragment = get_last_fragment()
            if fragment is not None:
                activity = fragment.getParentActivity()
                if activity is not None:
                    return activity
        except Exception as e:
            self._debug("link: экран недоступен: %s" % e)
        if find_class is None:
            return None
        try:
            loader = find_class("org.telegram.messenger.ApplicationLoader")
            return loader.applicationContext if loader is not None else None
        except Exception as e:
            self._debug("link: контекст приложения недоступен: %s" % e)
            return None

    def _open_link(self, url):
        bypass = getattr(self, "_bypass", None)
        if bypass is not None:
            bypass[url] = time.monotonic()
        context = self._own_context()
        if self._open_with_browser(context, url):
            self._debug("link: открыл через Browser")
            return True
        if self._open_with_intent(context, url):
            self._debug("link: открыл через Intent")
            return True
        if bypass is not None:
            bypass.pop(url, None)
        copy_to_clipboard(url)
        self._toast(phrase("toast_copied"))
        return False

    def _on_repo_click(self, *args):
        self._open_link(REPO_URL)

    def _on_chat_click(self, *args):
        self._open_link(CHAT_URL)


    def _reopen(self, method, args, index, url):
        now = time.monotonic()
        self._bypass[url] = now
        original = None
        if index is not None and args and isinstance(args[index], str):
            original = args[index]
            self._bypass[original] = now

        context = self._context_from(args)

        if self._open_with_browser(context, url):
            self._debug("reopen: Browser.openUrl")
            return

        if method is not None:
            new_args = list(args or ())
            self._replace_url_arg(new_args, index, url)
            try:
                method.invoke(None, *new_args)
                self._debug("reopen: invoke varargs")
                return
            except Exception as e:
                log("LinkGuard: reopen failed (varargs): %s" % e)
            try:
                method.invoke(None, new_args)
                self._debug("reopen: invoke list")
                return
            except Exception as e:
                log("LinkGuard: reopen failed (list): %s" % e)

        if self._open_with_intent(context, url):
            self._debug("reopen: intent")
            return

        self._bypass.pop(url, None)
        if original:
            self._bypass.pop(original, None)
        copy_to_clipboard(url)
        self._toast(phrase("toast_copied"))

    def on_send_message_hook(self, account, params):
        if not self.get_setting("clean_outgoing", False):
            return HookResult()
        try:
            text = params.message
        except Exception:
            return HookResult()
        if not text or "http" not in text:
            return HookResult()

        try:
            entities = getattr(params, "entities", None)
            if entities is not None and entities.size() > 0:
                return HookResult()
        except Exception:
            pass

        aggressive = self._aggressive()
        removed_total = [0]

        def repl(match):
            cleaned, removed = clean_url(match.group(0), aggressive)
            removed_total[0] += len(removed)
            return cleaned

        new_text = URL_RE.sub(repl, text)
        if not removed_total[0]:
            return HookResult()
        params.message = new_text
        self._bump("stats_cleaned", removed_total[0])
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    @staticmethod
    def _message_text(message):
        for getter in ("messageText", "caption"):
            try:
                value = getattr(message, getter, None)
                if value:
                    return str(value)
            except Exception:
                pass
        try:
            return str(message.messageOwner.message or "")
        except Exception:
            return ""

    def _collect_urls(self, message):
        text = self._message_text(message)
        try:
            self._index_anchors(text, message.messageOwner.entities)
        except Exception:
            pass

        found = list(URL_RE.findall(text))
        try:
            entities = message.messageOwner.entities
            for i in range(entities.size()):
                url = getattr(entities.get(i), "url", None)
                if url:
                    found.append(str(url))
        except Exception:
            pass
        return list(dict.fromkeys(found))

    def on_menu_check(self, context):
        message = context.get("message")
        if not message:
            return
        urls = self._collect_urls(message)
        if not urls:
            self._toast(phrase("toast_no_links"))
            return
        if not self._can_dialog():
            self._toast(phrase("toast_no_dialog"))
            return

        verdicts = [self._cached_analyze(u, self._anchors.get(u)) for u in urls[:5]]
        marks = {HIGH: "⛔", MEDIUM: "⚠️", LOW: "•", INFO: "✓"}
        blocks = ["%s %s\n%s" % (marks[v.risk], v.display_host or v.host or "?",
                                 self._describe(v)) for v in verdicts]

        builder = AlertDialogBuilder(get_last_fragment().getParentActivity())
        builder.set_title(phrase("checked_n", len(verdicts)))
        builder.set_message("\n\n".join(blocks))
        builder.set_positive_button(phrase("btn_ok"), lambda d, w: d.dismiss())
        builder.show()

    def on_menu_copy(self, context):
        message = context.get("message")
        if not message:
            return
        urls = self._collect_urls(message)
        if not urls:
            self._toast(phrase("toast_no_links"))
            return
        aggressive = self._aggressive()
        cleaned = []
        removed_total = 0
        for u in urls:
            clean, removed = clean_url(u, aggressive)
            cleaned.append(clean)
            removed_total += len(removed)
        copy_to_clipboard("\n".join(cleaned))
        self._bump("stats_cleaned", removed_total)

    @staticmethod
    def _toast(text):
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info(text, get_last_fragment())
        except Exception:
            log("LinkGuard: %s" % text)
