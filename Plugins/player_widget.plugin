# -*- coding: utf-8 -*-
__id__ = "player_widget"
__name__ = "Player Widget"
__description__ = "Виджет медиаплеера для рабочего стола. На урезанных прошивках может не работать."
__author__ = "@YouRooni"
__version__ = "1.0.0"
__build__ = 42
__icon__ = "RnDev/31"
__app_version__ = ">=12.1.1"

import base64
import traceback
from base_plugin import BasePlugin
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader
from android.widget import Toast
from android_utils import run_on_ui_thread
from ui.settings import Header, Text, Divider

DEX_B64 = """"""

class PlayerWidget(BasePlugin):
    def on_plugin_load(self):
        self.dex_loader = None
        self.player_manager_class = None
        self.author_sheet_class = None

        try:
            dex_bytes = base64.b64decode(DEX_B64)
            buffer = ByteBuffer.wrap(dex_bytes)
            parent_cl = ApplicationLoader.applicationContext.getClassLoader()
            self.dex_loader = InMemoryDexClassLoader(buffer, parent_cl)

            self.player_manager_class = self.dex_loader.loadClass("dev.rooni.playerwidget.PlayerWidgetManager")
            self.author_sheet_class = self.dex_loader.loadClass("dev.rooni.author.AuthorBottomSheet")

            for method in self.player_manager_class.getMethods():
                if method.getName() == "init" and len(method.getParameterTypes()) == 1:
                    method.invoke(None, ApplicationLoader.applicationContext)
                    break

            self.log("[PlayerWidget] Loaded successfully")

            run_on_ui_thread(self.check_author_promo, delay=700)
        except Exception as e:
            self.log(f"[PlayerWidget] Failed on_plugin_load: {e}\n{traceback.format_exc()}")

    def check_author_promo(self):
        try:
            if self.get_setting("author_promo_shown", False):
                return

            if getattr(self, "author_sheet_class", None) is None:
                return

            is_sub = self.author_sheet_class.getMethod("isSubscribedToAuthor").invoke(None)
            if is_sub:
                self.set_setting("author_promo_shown", True)
                return

            shown = self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
            if shown:
                self.set_setting("author_promo_shown", True)
        except Exception as e:
            self.log(f"[PlayerWidget] Promo check error: {e}")

    def show_author_sheet(self):
        try:
            if getattr(self, "author_sheet_class", None) is not None:
                self.author_sheet_class.getMethod("showFromCurrentActivity").invoke(None)
        except Exception as e:
            self.log(f"[PlayerWidget] Error showing sheet: {e}")

    def on_author_click(self, _=None):
        self.show_author_sheet()

    def on_plugin_unload(self):
        try:
            if self.player_manager_class is not None:
                for method in self.player_manager_class.getMethods():
                    if method.getName() == "destroy" and len(method.getParameterTypes()) == 1:
                        method.invoke(None, ApplicationLoader.applicationContext)
                        break

            self.player_manager_class = None
            self.author_sheet_class = None
            self.dex_loader = None
            self.log("[PlayerWidget] Unloaded successfully")
        except Exception as e:
            self.log(f"[PlayerWidget] Error on_plugin_unload: {e}\n{traceback.format_exc()}")

    def on_pin_click(self, _=None):
        try:
            if self.player_manager_class is None:
                Toast.makeText(ApplicationLoader.applicationContext, "Плагин не загружен", Toast.LENGTH_SHORT).show()
                return

            success = False
            for method in self.player_manager_class.getMethods():
                if method.getName() == "requestPinWidget" and len(method.getParameterTypes()) == 1:
                    success = bool(method.invoke(None, ApplicationLoader.applicationContext))
                    break

            if not success:
                Toast.makeText(
                    ApplicationLoader.applicationContext,
                    "Лаунчер не поддерживает добавление виджетов",
                    Toast.LENGTH_SHORT
                ).show()
        except Exception as e:
            self.log(f"[PlayerWidget] Error pinning widget: {e}")

    def on_refresh_click(self, _=None):
        try:
            if self.player_manager_class is not None:
                for method in self.player_manager_class.getMethods():
                    if method.getName() == "refreshAllWidgets" and len(method.getParameterTypes()) == 1:
                        method.invoke(None, ApplicationLoader.applicationContext)
                        break
            Toast.makeText(ApplicationLoader.applicationContext, "Виджет обновлен", Toast.LENGTH_SHORT).show()
        except Exception as e:
            self.log(f"[PlayerWidget] Error refreshing widget: {e}")

    def on_clear_click(self, _=None):
        try:
            if self.player_manager_class is not None:
                for method in self.player_manager_class.getMethods():
                    if method.getName() == "clearPinnedIds" and len(method.getParameterTypes()) == 1:
                        method.invoke(None, ApplicationLoader.applicationContext)
                        break
            Toast.makeText(ApplicationLoader.applicationContext, "Виджеты сброшены", Toast.LENGTH_SHORT).show()
        except Exception as e:
            self.log(f"[PlayerWidget] Error clearing: {e}")

    def get_pinned_count(self):
        try:
            if self.player_manager_class is not None:
                for method in self.player_manager_class.getMethods():
                    if method.getName() == "getPinnedCount" and len(method.getParameterTypes()) == 0:
                        return int(method.invoke(None))
        except Exception:
            pass
        return 0

    def create_settings(self):
        count = self.get_pinned_count()
        reset_text = f"Сбросить виджеты ({count})" if count > 0 else "Сбросить виджеты"
        return [
            Header(text="Виджет"),
            Text(
                text="Добавить на рабочий стол",
                icon="msg_add",
                on_click=self.on_pin_click
            ),
            Divider(text="Если окно не появилось, добавьте виджет Telegram на рабочий стол вручную."),
            Text(
                text="Обновить виджет",
                icon="msg_retry",
                on_click=self.on_refresh_click
            ),
            Text(
                text=reset_text,
                icon="msg_delete",
                on_click=self.on_clear_click
            ),
            Header(text="Об авторе"),
            Text(
                text="Автор",
                subtext="Подробности о разработчике",
                icon="msg_openprofile",
                on_click=self.on_author_click
            )
        ]
