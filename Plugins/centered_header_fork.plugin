ENTRY_CLASS = "com.extera.plugins.floatingattachbutton.FloatingAttachButtonCore"
DEX_BEGIN = "DEX_BEGIN"
DEX_END = "DEX_END"

BuildVersion = jclass("android.os.Build$VERSION")

class Dex:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loaded = False

    def load(self):
        if self.loaded:
            return
        if self.clazz is None:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                raise RuntimeError("application context is not ready")
            if BuildVersion.SDK_INT < 26:
                raise RuntimeError("embedded DEX requires Android API 26+")
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(self._read_payload()), ctx.getClassLoader())
            self.clazz = loader.loadClass(self.entry_class)
        try:
            self._invoke("load")
            self.loaded = True
        except Exception:
            try:
                self._invoke("unload")
            except Exception:
                pass
            self.loaded = False
            raise

    def unload(self):
        try:
            if self.clazz is not None and self.loaded:
                self._invoke("unload")
        except Exception:
            pass
        self.loaded = False

    def _invoke(self, method_name):
        if self.clazz is None:
            raise RuntimeError("embedded dex class is not loaded")
        for method in self.clazz.getDeclaredMethods():
            if str(method.getName()) != method_name or len(method.getParameterTypes()) != 0:
                continue
            method.setAccessible(True)
            try:
                return method.invoke(None)
            except Exception as exc:
                cause = None
                try:
                    cause = exc.getCause()
                except Exception:
                    pass
                if cause is not None:
                    try:
                        message = cause.getMessage()
                    except Exception:
                        message = None
                    raise RuntimeError(str(message or cause))
                raise
        raise RuntimeError(f"core method not found: {method_name}")

    def _read_payload(self):
        try:
            with open(__file__, "r", encoding="utf-8") as source:
                text = source.read()
            block = text.split(f"# {DEX_BEGIN}", 1)[1].split(f"# {DEX_END}", 1)[0]
            payload = "".join(line.strip()[1:].strip() for line in block.splitlines() if line.strip().startswith("#"))
        except Exception as exc:
            raise RuntimeError(f"embedded dex read failed: {exc}")
        if not payload:
            raise RuntimeError("embedded dex payload not found")
        try:
            return zlib.decompress(base64.b64decode(payload))
        except Exception as exc:
            raise RuntimeError(f"embedded dex decode failed: {exc}")

def _log(msg):
    try:
        log(msg)
    except Exception:
        pass

def _safe_int(x, default=0):
    try:
        if x is None:
            return default
        return int(x)
    except Exception:
        return default

def _dp(v):
    return AndroidUtilities.dp(v)

def _field(obj, *names):
    cls = obj.getClass()
    while cls is not None:
        for n in names:
            try:
                f = cls.getDeclaredField(n)
                f.setAccessible(True)
                v = f.get(obj)
                if v is not None:
                    return v
            except Exception:
                pass
        cls = cls.getSuperclass()
    return None

def _call(obj, name):
    try:
        return getattr(obj, name)()
    except Exception:
        return None

def _text_of(view):
    try:
        t = view.getText()
        return "" if t is None else str(t)
    except Exception:
        return None

Runnable = jclass("java.lang.Runnable")
TruncateAt = jclass("android.text.TextUtils$TruncateAt")

class _Runnable(dynamic_proxy(Runnable)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.fn()
        except Exception:
            _log(f"[CherryHeader] runnable failed: {traceback.format_exc()}")

TAG_OVERLAY = "CherryHeaderOverlay"
TAG_BADGE = "CherryHeaderBadge"
TAG_AVATAR = "CherryHeaderAvatarOverlay"

AVATAR_MIN_DP = 10
AVATAR_MAX_DP = 45
AVATAR_DEFAULT_DP = 30

MARQUEE_MARGIN_MIN_DP = 0
MARQUEE_MARGIN_MAX_DP = 120
MARQUEE_MARGIN_DEFAULT_DP = 12

TICK_MS = 350

class CherryHeaderPlugin(BasePlugin):
    _alive = False
    hook_chat_resume_ref = None
    dex = None

    def __init__(self):
        super().__init__()
        self.hook_chat_resume_ref = None
        self.dex = None

    def on_plugin_load(self):
        self._alive = True
        try:
            self.dex = Dex(ENTRY_CLASS)
            self.dex.load()
        except Exception:
            _log(f"[CherryHeader] Failed to load DEX: {traceback.format_exc()}")
        try:
            chat_cls = find_class("org.telegram.ui.ChatActivity")
            on_resume = chat_cls.getClass().getDeclaredMethod("onResume")
            on_resume.setAccessible(True)
            self.hook_chat_resume_ref = self.hook_method(on_resume, _ChatActivityResumeHook(self))
        except Exception:
            _log(f"[CherryHeader] Failed to hook ChatActivity.onResume: {traceback.format_exc()}")

    def on_plugin_unload(self):
        self._alive = False
        try:
            if self.dex:
                self.dex.unload()
        except Exception:
            pass
        try:
            if self.hook_chat_resume_ref:
                self.unhook_method(self.hook_chat_resume_ref)
        except Exception:
            pass

    def _avatar_dp(self):
        v = _safe_int(self.get_setting("avatar_size_dp", AVATAR_DEFAULT_DP), AVATAR_DEFAULT_DP)
        return max(AVATAR_MIN_DP, min(AVATAR_MAX_DP, v))

    def _marquee_margin_dp(self):
        v = _safe_int(self.get_setting("marquee_margin_dp", MARQUEE_MARGIN_DEFAULT_DP), MARQUEE_MARGIN_DEFAULT_DP)
        return max(MARQUEE_MARGIN_MIN_DP, min(MARQUEE_MARGIN_MAX_DP, v))

    def create_settings(self):
        lang = "ru"
        try:
            lang = Locale.getDefault().getLanguage()
        except Exception:
            pass
        ru = str(lang).startswith("ru")

        scrolling = bool(self.get_setting("scrolling_enabled", True))
        show_badge = bool(self.get_setting("show_unread_badge", True))

        size_item = Input(
            key="avatar_size_dp",
            text="Размер аватара" if ru else "Avatar size",
            default=str(self._avatar_dp()),
        )

        marquee_item = Input(
            key="marquee_margin_dp",
            text="Отступ бегущей строки" if ru else "Marquee padding",
            default=str(self._marquee_margin_dp()),
        )

        if ru:
            return [
                Header(text="Настройки заголовка"),
                Switch(key="scrolling_enabled", text="Бегущая строка", default=scrolling),
                Divider(text="Прокрутка текста при переполнении"),
                Switch(key="show_unread_badge", text="Непрочитанные сообщения", default=show_badge),
                Divider(text="Счётчик непрочитанных над кнопкой назад"),
                Header(text="Точные настройки"),
                marquee_item,
                Divider(text="Число от 0 до 120"),
                size_item,
                Divider(text="Число от 10 до 45")
            ]

        return [
            Header(text="Header settings"),
            Switch(key="scrolling_enabled", text="Marquee text", default=scrolling),
            Divider(text="Scroll text when overflowing"),
            Switch(key="show_unread_badge", text="Unread messages", default=show_badge),
            Divider(text="Unread badge over the back button"),
            Header(text="Precise settings"),
            marquee_item,
            Divider(text="Number from 0 to 120"),
            size_item,
            Divider(text="Number from 10 to 45")
        ]

    def _apply(self, ca):
        try:
            action_bar = ca.getActionBar()
            ctx = ca.getParentActivity()
            if action_bar is None or ctx is None:
                return
            self._remove_old(action_bar, TAG_OVERLAY)
            self._remove_old(action_bar, TAG_BADGE)
            container = _field(ca, "animatedAvatarContainer", "avatarContainer")
            overlay, title, subtitle = self._build_overlay(ca, ctx, action_bar, container)
            badge = None
            if bool(self.get_setting("show_unread_badge", True)):
                badge = self._build_badge(ca, ctx, action_bar)
            self._overlay_avatar_on_menu(ca, ctx)
            self._start_ticker(ca, action_bar, container, overlay, title, subtitle, badge)
        except Exception:
            _log(f"[CherryHeader] apply failed: {traceback.format_exc()}")

    @staticmethod
    def _remove_old(parent, tag):
        for _ in range(3):
            old = parent.findViewWithTag(tag)
            if old is None:
                return
            try:
                p = old.getParent()
                if p is None:
                    return
                p.removeView(old)
            except Exception:
                return

    def _themed(self, ca, key_name, default):
        try:
            key = getattr(Theme, key_name)
            try:
                return int(ca.getThemedColor(key))
            except Exception:
                return int(Theme.getColor(key))
        except Exception:
            return default

    def _build_overlay(self, ca, ctx, action_bar, container):
        marquee = bool(self.get_setting("scrolling_enabled", True))
        overlay = FrameLayout(ctx)
        overlay.setTag(TAG_OVERLAY)

        col = LinearLayout(ctx)
        col.setOrientation(1)
        col.setGravity(Gravity.CENTER)

        pad_px = _dp(self._marquee_margin_dp()) if marquee else 0
        col.setPadding(pad_px, 0, pad_px, 0)

        overlay.addView(col, FrameLayout.LayoutParams(-1, -1))

        def make(size_sp, bold, color):
            tv = TextView(ctx)
            tv.setSingleLine(True)
            tv.setGravity(Gravity.CENTER)
            tv.setTextSize(2, size_sp)
            tv.setTextColor(color)
            tv.setIncludeFontPadding(False)
            if bold:
                tv.setTypeface(Typeface.DEFAULT_BOLD)
            if marquee:
                tv.setEllipsize(TruncateAt.MARQUEE)
                tv.setMarqueeRepeatLimit(-1)
                tv.setHorizontallyScrolling(True)
            else:
                tv.setEllipsize(TruncateAt.END)
            col.addView(tv, LinearLayout.LayoutParams(-1, -2))
            return tv

        title = make(17, True, self._themed(ca, "key_actionBarDefaultTitle", 0xFFFFFFFF))
        subtitle = make(13, False, self._themed(ca, "key_actionBarDefaultSubtitle", 0xCCFFFFFF))

        top = 0
        try:
            if action_bar.getOccupyStatusBar():
                top = AndroidUtilities.statusBarHeight
        except Exception:
            pass
        try:
            h = jclass("org.telegram.ui.ActionBar.ActionBar").getCurrentActionBarHeight()
        except Exception:
            h = _dp(56)

        lp = FrameLayout.LayoutParams(-1, h)
        lp.gravity = Gravity.TOP
        lp.topMargin = top
        lp.leftMargin = _dp(112)
        lp.rightMargin = _dp(112)
        action_bar.addView(overlay, lp)

        from android_utils import OnClickListener
        def open_profile(*_):
            try:
                if container is not None:
                    try:
                        container.openProfile(False)
                        return
                    except Exception:
                        pass
                user = getattr(ca, "currentUser", None)
                chat = getattr(ca, "currentChat", None)
                args = Bundle()
                if user is not None:
                    args.putLong("user_id", getattr(user, "id", 0))
                elif chat is not None:
                    args.putLong("chat_id", abs(getattr(chat, "id", 0)))
                else:
                    return
                ca.presentFragment(ProfileActivity(args))
            except Exception:
                pass

        overlay.setOnClickListener(OnClickListener(open_profile))
        return overlay, title, subtitle

    def _build_badge(self, ca, ctx, action_bar):
        badge = TextView(ctx)
        badge.setTag(TAG_BADGE)
        badge.setGravity(Gravity.CENTER)
        badge.setTextSize(2, 11)
        badge.setTypeface(Typeface.DEFAULT_BOLD)
        badge.setSingleLine(True)
        badge.setMinWidth(_dp(18))
        badge.setPadding(_dp(5), 0, _dp(5), 0)
        badge.setTextColor(self._themed(ca, "key_chats_unreadCounterText", 0xFFFFFFFF))

        bg = GradientDrawable()
        bg.setShape(0)
        bg.setCornerRadius(_dp(9))
        bg.setColor(self._themed(ca, "key_chats_unreadCounter", 0xFF4FA8E0))
        badge.setBackground(bg)
        badge.setVisibility(View.GONE)

        top = 0
        try:
            if action_bar.getOccupyStatusBar():
                top = AndroidUtilities.statusBarHeight
        except Exception:
            pass

        lp = FrameLayout.LayoutParams(-2, _dp(18))
        lp.gravity = Gravity.TOP | Gravity.LEFT
        lp.leftMargin = _dp(30)
        lp.topMargin = top + _dp(6)
        action_bar.addView(badge, lp)
        return badge

    def _overlay_avatar_on_menu(self, ca, ctx):
        try:
            header_item = _field(ca, "headerItem")
            if header_item is None:
                return
            self._remove_old(header_item, TAG_AVATAR)
            size_px = _dp(self._avatar_dp())
            avatar_view = BackupImageView(ctx)
            avatar_view.setTag(TAG_AVATAR)
            try:
                avatar_view.setRoundRadius(size_px // 2)
            except Exception:
                pass
            user = getattr(ca, "currentUser", None)
            chat = getattr(ca, "currentChat", None)
            target = user if user is not None else chat
            if target is not None:
                d = AvatarDrawable()
                d.setInfo(target)
                avatar_view.setForUserOrChat(target, d)

            from android_utils import OnClickListener
            def on_click(*_):
                try:
                    header_item.performClick()
                except Exception:
                    pass

            avatar_view.setOnClickListener(OnClickListener(on_click))
            params = FrameLayout.LayoutParams(size_px, size_px)
            params.gravity = Gravity.CENTER
            header_item.addView(avatar_view, params)
        except Exception:
            _log(f"[CherryHeader] avatar overlay failed: {traceback.format_exc()}")

    def _unread_other(self, ca):
        account = ca.getCurrentAccount()
        mc = ca.getMessagesController()
        cur_id = 0
        cur_unread = 0
        try:
            cur_id = ca.getDialogId()
            dlg = mc.getDialog(cur_id) if mc is not None and cur_id != 0 else None
            if dlg is not None:
                cur_unread = dlg.unread_count
        except Exception:
            pass
        
        total = 0
        try:
            total = int(MessagesStorage.getInstance(account).getMainUnreadCount())
        except Exception:
            total = 0
            
        if total > 0:
            return max(0, total - cur_unread)
            
        return 0

    def _start_ticker(self, ca, action_bar, container, overlay, title, subtitle, badge):
        handler = Handler(Looper.getMainLooper())
        st = {"t": None, "s": None, "n": 0, "miss": 0, "side": -1, "runnable": None}
        marquee = bool(self.get_setting("scrolling_enabled", True))

        def set_text(tv, text, key):
            if text is None or text == st[key]:
                return
            st[key] = text
            tv.setText(text)
            if marquee:
                tv.setSelected(True)

        def teardown():
            for v in (overlay, badge):
                try:
                    if v is not None and v.getParent() is not None:
                        v.getParent().removeView(v)
                except Exception:
                    pass
            try:
                if container is not None:
                    container.setVisibility(View.VISIBLE)
            except Exception:
                pass

        def tick():
            if not self._alive:
                teardown()
                return
            if not overlay.isAttachedToWindow():
                st["miss"] += 1
                if st["miss"] > 6:
                    return
                handler.postDelayed(st["runnable"], TICK_MS)
                return
            st["miss"] = 0
            st["n"] += 1

            if container is not None:
                try:
                    if container.getVisibility() != View.INVISIBLE:
                        container.setVisibility(View.INVISIBLE)
                except Exception:
                    pass

            if container is not None:
                set_text(title, _text_of(_call(container, "getTitleTextView")), "t")
                sub_text = _text_of(_call(container, "getSubtitleTextView"))
                set_text(subtitle, sub_text, "s")
                try:
                    subtitle.setVisibility(View.VISIBLE if sub_text else View.GONE)
                except Exception:
                    pass

            hidden = False
            try:
                hidden = bool(action_bar.isActionModeShowed())
            except Exception:
                pass
            try:
                if not hidden and action_bar.isSearchFieldVisible():
                    hidden = True
            except Exception:
                pass
            overlay.setVisibility(View.INVISIBLE if hidden else View.VISIBLE)

            try:
                col = overlay.getChildAt(0)
                if col is not None:
                    pad_px = _dp(self._marquee_margin_dp()) if marquee else 0
                    if col.getPaddingLeft() != pad_px:
                        col.setPadding(pad_px, 0, pad_px, 0)
            except Exception:
                pass

            try:
                ab_w = action_bar.getMeasuredWidth()
                if ab_w > 0:
                    side = _dp(56)
                    for i in range(action_bar.getChildCount()):
                        ch = action_bar.getChildAt(i)
                        if ch is None or ch.getVisibility() != 0:
                            continue
                        if str(ch.getClass().getSimpleName()) == "ActionBarMenu" and ch.getMeasuredWidth() > 0:
                            side = max(side, ab_w - ch.getLeft())
                    side = min(side, ab_w // 2 - _dp(40))
                    if side != st["side"]:
                        st["side"] = side
                        lp = overlay.getLayoutParams()
                        lp.leftMargin = side
                        lp.rightMargin = side
                        overlay.setLayoutParams(lp)
            except Exception:
                pass

            if badge is not None:
                try:
                    if hidden:
                        badge.setVisibility(View.GONE)
                    else:
                        if st["n"] % 2 == 0: 
                            cnt = self._unread_other(ca)
                            if cnt > 0:
                                badge.setText("99+" if cnt > 99 else str(cnt))
                                badge.setVisibility(View.VISIBLE)
                            else:
                                badge.setVisibility(View.GONE)
                except Exception:
                    pass

            handler.postDelayed(st["runnable"], TICK_MS)

        st["runnable"] = _Runnable(tick)
        handler.post(st["runnable"])


class _ChatActivityResumeHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._apply(param.thisObject)
        except Exception:
            pass

