logger = zwylib.build_log(__name__)
bulletin = zwylib.build_bulletin_helper()
run_async = zwylib.async_manager.run_task
dex_loader = DexLoader()


def format_speed(speed: float) -> str:
    return f"x{speed:g}"


def get_scroll_speed() -> float:
    return S.scroll_speed.safe_get(float)


def get_scroll_speed_index() -> int:
    speed = get_scroll_speed()
    return min(range(len(SCROLL_SPEEDS)), key=lambda i: abs(SCROLL_SPEEDS[i] - speed))


def push_scroll_speed(speed: float):
    if not dex_loader.java_class:
        return

    try:
        for method in dex_loader.java_class.getDeclaredMethods():
            if method.getName() == "setScrollSpeed":
                method.invoke(None, speed)
                return
    except Exception:
        logger.error("Failed to push the scroll speed to dex:", exc_info=True)


def build_scroll_speed_slider() -> Custom:
    def on_choose(index: int):
        item.intValue = index
        speed = SCROLL_SPEEDS[index]
        # reloading would rebuild the settings page right under the finger
        zwylib.SettingsManager.set(S.scroll_speed.plugin_id, S.scroll_speed, speed, reload_settings=False)
        push_scroll_speed(speed)

    # UItem.asSlideView(String[] choices, int chosen, Utilities.Callback<Integer> whenChose)
    item = UItem.asSlideView(
        jarray(String)([format_speed(speed) for speed in SCROLL_SPEEDS]),
        get_scroll_speed_index(),
        zwylib.Callback1(on_choose)
    )
    return Custom(item=item)


class NoForwardLimit(BasePlugin):
    def on_plugin_load(self):
        zwylib.add_autoupdater_task(AUTOUPDATE_CHANNEL_ID, AUTOUPDATE_MSG_ID)

        self.add_on_send_message_hook()

        method = HookUtils.find_max_args_method(get_messages_controller().getClass(), "deleteMessages")
        HookUtils.hook_before(method, delete_messages_hook)

        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text=L.forward_all_menu,
            icon="msg_forward",
            on_click=lambda ctx: run_async(show_chat_forward_popup(ctx))
        ))

        if not dex_loader.inject():
            raise Exception("Failed to load dex module.")

        push_scroll_speed(get_scroll_speed())
        logger.info("Loaded.")

    def on_plugin_unload(self):
        if dex_loader.java_class:
            try:
                dex_loader.java_class.getDeclaredMethod("unload").invoke(None)
            except Exception:
                logger.error("Dex unload error:", exc_info=True)
            finally:
                dex_loader.java_class = None
        logger.info("Unloaded.")

    def create_settings(self):
        try:
            return [
                Header(L.prefs_scroll_speed),
                build_scroll_speed_slider(),
                Divider(L.prefs_scroll_speed_hint),
            ]
        except Exception as e:
            logger.error("An error occurred while generating settings:", exc_info=True)
            trace = zwylib.format_exc_from(e)
            return [
                Divider(f"An error occurred while generating settings:\n{zwylib.format_exc_only(e)}"),
                Text(
                    text="Copy full traceback",
                    icon="msg_copy",
                    on_click=lambda v: copy_to_clipboard(trace)
                ),
            ]
