__app_version__ = ">=12.1.1"
__category__ = ["chats"]
__sdk_version__ = ">=1.4.3.3"

ENTRY_CLASS = "com.exteraplugins.participants_channels.Main"
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"

DEFAULT_HISTORY_LIMIT = 100
MAX_HISTORY_LIMIT = 50000

