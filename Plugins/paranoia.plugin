from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import run_on_ui_thread, log
from client_utils import get_last_fragment, send_message
from ui.alert import AlertDialogBuilder

__id__ = "paranoia"
__name__ = "Paranoia"
__description__ = "Предотвращает случайную отправку несуществующих команд, начинающихся с '.'"
__author__ = "@scorpiovn_sc"
__version__ = "1.2.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"


class ParanoiaPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._is_resending = False
        self._pending_send = None

    def on_plugin_load(self):
        self.add_on_send_message_hook(priority=-1000)

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if self._is_resending:
            return HookResult()

        if hasattr(params, "message") and isinstance(params.message, str) and params.message.startswith("."):
            stripped = params.message.lstrip(".")
            if not stripped or not stripped.strip():
                return HookResult()
            
            self._pending_send = {
                "peer": getattr(params, "peer", None) or getattr(params, "dialogId", None) or getattr(params, "to_id", None),
                "message": params.message,
                "replyToMsg": getattr(params, "replyToMsg", None),
                "entities": getattr(params, "entities", None),
                "media": getattr(params, "media", None),
                "scheduleDate": getattr(params, "scheduleDate", None),
                "account": account,
            }
            
            self._show_confirmation_dialog()
            return HookResult(strategy=HookStrategy.CANCEL)
        
        return HookResult()

    def _show_confirmation_dialog(self):
        def on_positive(bld: AlertDialogBuilder, which: int):
            bld.dismiss()
            self._resend_message()

        def on_negative(bld: AlertDialogBuilder, which: int):
            bld.dismiss()
            self._pending_send = None

        def show_dialog():
            fragment = get_last_fragment()
            if not fragment:
                self._pending_send = None
                return
                
            activity = fragment.getParentActivity()
            if not activity:
                self._pending_send = None
                return
            
            builder = AlertDialogBuilder(activity)
            builder.set_title("Paranoia")
            builder.set_message("Предотвращена случайная отправка несуществующей команды. Отправить?")
            builder.set_positive_button("Да", on_positive)
            builder.set_negative_button("Отмена", on_negative)
            builder.show()

        run_on_ui_thread(show_dialog)

    def _resend_message(self):
        if not self._pending_send:
            return
        
        data = self._pending_send.copy()
        self._pending_send = None
        
        try:
            send_dict = {}
            peer = data.get("peer")
            if not peer:
                return
            send_dict["peer"] = peer
            
            for key in ["message", "replyToMsg", "entities", "media", "scheduleDate"]:
                if data.get(key) is not None:
                    send_dict[key] = data[key]

            self._is_resending = True
            send_message(send_dict)
            
        except Exception as e:
            log(f"Error resending message: {e}")
        finally:
            run_on_ui_thread(lambda: setattr(self, '_is_resending', False), 100)