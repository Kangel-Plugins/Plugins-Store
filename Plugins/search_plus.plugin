class MediaTypeFilter:
    TYPES = [
        ("Без фильтра", None,
         ("msg_msgbubble3", "msg_discussion", "msg_message", "msg_media", "msg_folders")),
        ("Фотографии", "TL_inputMessagesFilterPhotos",
         ("msg_photos", "search_media", "msg_media", "msg_gallery")),
        ("Видео", "TL_inputMessagesFilterVideo",
         ("msg_video", "msg_videocall", "search_media", "msg_media")),
        ("Голосовые сообщения", "TL_inputMessagesFilterVoice",
         ("msg_voice", "search_voice", "msg_micro", "msg_voicechat")),
        ("Видео сообщения", "TL_inputMessagesFilterRoundVideo",
         ("msg_round", "msg_videocall", "msg_video")),
        ("Файлы", "TL_inputMessagesFilterDocument",
         ("msg_files", "search_files", "msg_folders")),
        ("Музыка", "TL_inputMessagesFilterMusic",
         ("msg_music", "search_music", "msg_played")),
        ("GIF", "TL_inputMessagesFilterGif",
         ("msg_gif", "search_gif", "msg_gallery")),
        ("Локации", "TL_inputMessagesFilterGeo",
         ("msg_location", "msg_map", "search_geo", "msg_openin")),
        ("Контакты", "TL_inputMessagesFilterContacts",
         ("msg_contacts", "search_contacts", "msg_addcontact")),
        ("Ссылки", "TL_inputMessagesFilterUrl",
         ("msg_link", "search_links", "msg_link2")),
    ]




    CHECK_ICONS = ("msg_check", "ic_ab_done", "check_filled", "msg_select")




    @staticmethod
    def icons_for(idx):
        try:
            entry = MediaTypeFilter.TYPES[int(idx)]
            if len(entry) > 2:
                return entry[2]
        except Exception:
            pass
        return ()




    @staticmethod
    def filter_class_name_for(idx):
        try:
            return MediaTypeFilter.TYPES[int(idx)][1]
        except Exception as e:
            slog("filter_class_name_for failed", e)
            return None




    ALT_FILTERS = {
        "TL_inputMessagesFilterVoice": ("TL_inputMessagesFilterVoice", "TL_inputMessagesFilterRoundVoice"),
        "TL_inputMessagesFilterRoundVideo": ("TL_inputMessagesFilterRoundVideo", "TL_inputMessagesFilterRoundVoice"),
        "TL_inputMessagesFilterGeo": ("TL_inputMessagesFilterGeo",),
        "TL_inputMessagesFilterContacts": ("TL_inputMessagesFilterContacts",),
    }




    @staticmethod
    def create_filter(idx):
        try:
            cls_name = MediaTypeFilter.filter_class_name_for(idx)
            if cls_name is None:
                return None
            candidates = MediaTypeFilter.ALT_FILTERS.get(cls_name, (cls_name,))
            for name in candidates:
                cls = getattr(TLRPC, name, None)
                if cls is not None:
                    return cls()
            slog(f"create_filter: no TLRPC class for {cls_name}")
            return None
        except Exception as e:
            slog("create_filter failed", e)
            return None








class MediaTypeSheet:
    _icon_cache = {}




    @staticmethod
    def resolve_icon(names):
        if not names:
            return 0
        key = tuple(names)
        if key in MediaTypeSheet._icon_cache:
            return MediaTypeSheet._icon_cache[key]
        res = 0
        try:
            r_cls = JClass.forName("org.telegram.messenger.R$drawable")
            for name in names:
                try:
                    f = r_cls.getDeclaredField(name)
                    f.setAccessible(True)
                    val = int(f.getInt(None))
                    if val != 0:
                        res = val
                        break
                except Exception:
                    continue
        except Exception as e:
            slog("resolve_icon failed", e)
        MediaTypeSheet._icon_cache[key] = res
        return res




    @staticmethod
    def show(plugin):
        try:
            frag = get_last_fragment()
            if frag is None:
                return False
            ctx = frag.getParentActivity()
            if ctx is None:
                return False




            from android.widget import LinearLayout
            from org.telegram.ui.ActionBar import BottomSheet
            from org.telegram.ui.Cells import TextCell
            from android_utils import OnClickListener




            try:
                rp = frag.getResourceProvider()
            except Exception:
                rp = None




            try:
                builder = BottomSheet.Builder(ctx, False, rp)
            except Exception:
                builder = BottomSheet.Builder(ctx, False)




            container = LinearLayout(ctx)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8))




            current = int(plugin._current_media_filter_idx)
            total = len(MediaTypeFilter.TYPES)
            holder = {}




            def make_handler(index):
                def handler(v):
                    try:
                        sheet = holder.get("sheet")
                        if sheet is not None:
                            sheet.dismiss()
                    except Exception:
                        pass
                    plugin.apply_media_filter_deferred(index)
                return handler




            check_res = MediaTypeSheet.resolve_icon(MediaTypeFilter.CHECK_ICONS)
            added = 0




            for i in range(total):
                name = MediaTypeFilter.TYPES[i][0]
                selected = (i == current)
                if selected:
                    icon_res = check_res
                else:
                    icon_res = MediaTypeSheet.resolve_icon(MediaTypeFilter.icons_for(i))




                try:
                    cell = TextCell(ctx, rp) if rp is not None else TextCell(ctx)
                except Exception:
                    try:
                        cell = TextCell(ctx)
                    except Exception:
                        continue




                placed = False
                if icon_res != 0:
                    try:
                        cell.setTextAndIcon(JString(name), icon_res, False)
                        placed = True
                    except Exception:
                        placed = False
                if not placed:
                    try:
                        cell.setText(JString(name), False)
                    except Exception:
                        continue




                if selected:
                    try:
                        cell.setColors(
                            Theme.key_windowBackgroundWhiteBlueText2,
                            Theme.key_windowBackgroundWhiteBlueText2,
                        )
                    except Exception:
                        pass




                cell.setOnClickListener(OnClickListener(make_handler(i)))
                container.addView(cell, LayoutHelper.createLinear(-1, 48))
                added += 1




            if added == 0:
                return False




            builder.setCustomView(container)
            sheet = builder.create()
            holder["sheet"] = sheet
            sheet.show()
            slog(f"bottom sheet shown ({added} items, current={current})")
            return True
        except Exception as e:
            slog("MediaTypeSheet.show failed", e)
            return False








def _find_field(obj, name):
    try:
        cls = obj.getClass()
        while cls is not None:
            try:
                f = cls.getDeclaredField(name)
                f.setAccessible(True)
                return f
            except Exception:
                cls = cls.getSuperclass()
    except Exception:
        pass
    return None








def _find_field_value(obj, name):
    try:
        f = _find_field(obj, name)
        if f is not None:
            return f.get(obj)
    except Exception:
        pass
    return None








def _prim_class(name):
    try:
        box = JClass.forName("java.lang." + name)
        return box.getField("TYPE").get(None)
    except Exception:
        return None








def _find_method(obj, name, pcount):
    try:
        cls = obj.getClass()
        while cls is not None:
            try:
                for m in cls.getDeclaredMethods():
                    if m.getName() == name and len(m.getParameterTypes()) == pcount:
                        m.setAccessible(True)
                        return m
            except Exception:
                pass
            cls = cls.getSuperclass()
    except Exception:
        pass
    return None








def _msg_from_person(m, pid, is_chat):
    try:
        if is_chat:
            peer = getattr(m, "peer_id", None)
            if peer is None:
                return False
            cid = getattr(peer, "channel_id", None)
            if cid is not None and int(cid) == pid:
                return True
            chid = getattr(peer, "chat_id", None)
            if chid is not None and int(chid) == pid:
                return True
            return False
        frm = getattr(m, "from_id", None)
        if frm is None:
            return False
        uid = getattr(frm, "user_id", None)
        if uid is None:
            return False
        return int(uid) == pid
    except Exception:
        return False








def _filter_global_response(plugin, response):
    try:
        if response is None:
            return
        pid = int(plugin._g_person_id)
        if pid != 0:
            is_chat = bool(plugin._g_person_is_chat)
            msgs = getattr(response, "messages", None)
            if msgs is not None:
                removed = 0
                i = msgs.size() - 1
                while i >= 0:
                    m = msgs.get(i)
                    if not _msg_from_person(m, pid, is_chat):
                        msgs.remove(i)
                        removed += 1
                    i -= 1
                slog(f"global person filter: removed={removed} left={msgs.size()}")
            chats = getattr(response, "chats", None)
            if chats is not None and is_chat:
                i = chats.size() - 1
                while i >= 0:
                    c = chats.get(i)
                    if int(getattr(c, "id", 0)) != pid:
                        chats.remove(i)
                    i -= 1
            users = getattr(response, "users", None)
            if users is not None and not is_chat:
                i = users.size() - 1
                while i >= 0:
                    u = users.get(i)
                    if int(getattr(u, "id", 0)) != pid:
                        users.remove(i)
                    i -= 1
    except Exception as e:
        slog("filter global response failed", e)








_SEND_HOOK_SUPPRESS = False








def _current_account_num():
    try:
        frag = get_last_fragment()
        if frag is not None:
            try:
                return int(frag.getCurrentAccount())
            except Exception:
                pass
    except Exception:
        pass
    try:
        uc = JClass.forName("org.telegram.messenger.UserConfig")
        f = uc.getDeclaredField("selectedAccount")
        f.setAccessible(True)
        return int(f.getInt(None))
    except Exception:
        return 0








def _copy_tl_field(src_obj, dst_obj, name):
    try:
        sf = src_obj.getClass().getDeclaredField(name)
        sf.setAccessible(True)
        df = dst_obj.getClass().getDeclaredField(name)
        df.setAccessible(True)
        if sf.getType().isPrimitive():
            tn = sf.getType().getName()
            if tn == "long":
                df.setLong(dst_obj, sf.getLong(src_obj))
            elif tn == "boolean":
                df.setBoolean(dst_obj, sf.getBoolean(src_obj))
            else:
                df.setInt(dst_obj, sf.getInt(src_obj))
        else:
            df.set(dst_obj, sf.get(src_obj))
        return True
    except Exception:
        return False








def _send_extra_pattern_requests(plugin, req, patterns, flags):
    global _SEND_HOOK_SUPPRESS
    try:
        if patterns is None or len(patterns) < 2:
            return
        account = _current_account_num()
        cm = get_connections_manager()
        copy_names = ("peer", "from_id", "saved_peer_id", "top_msg_id", "filter", "min_date", "max_date", "offset_id", "add_offset", "limit", "max_id", "min_id", "hash", "flags")
        token = int(getattr(plugin, "client_extra_token", 0))
        extra_results = getattr(plugin, "client_extra_results", None)
        if extra_results is None:
            extra_results = []
            plugin.client_extra_results = extra_results
        sent = 0
        for pat in patterns[1:]:
            try:
                req2 = TLRPC.TL_messages_search()
                for name in copy_names:
                    _copy_tl_field(req, req2, name)
                qf = req2.getClass().getDeclaredField("q")
                qf.setAccessible(True)
                qf.set(req2, pat.pattern)
                pf = req2.getClass().getDeclaredField("peer")
                pf.setAccessible(True)
                if pf.get(req2) is None:
                    slog(f"extra request '{pat.pattern}': peer null, skip")
                    continue




                def _on_extra(response, error, acc=account, tok=token, pat=pat):
                    try:
                        if error or response is None:
                            slog(f"extra response: error={error}")
                            return
                        if int(getattr(plugin, "client_extra_token", 0)) != tok:
                            slog("extra response: stale token")
                            return
                        try:
                            counts = getattr(plugin, "client_extra_server_counts", None)
                            if counts is None:
                                counts = {}
                                plugin.client_extra_server_counts = counts
                            cnt = int(getattr(response, "count", 0) or 0)
                            if cnt <= 0:
                                msgs0 = getattr(response, "messages", None)
                                if msgs0 is not None:
                                    cnt = int(msgs0.size())
                            counts[pat.pattern] = cnt
                        except Exception:
                            pass
                        msgs = getattr(response, "messages", None)
                        if msgs is None or msgs.size() == 0:
                            slog("extra response: empty")
                            return




                        def _deliver():
                            try:
                                lst = getattr(plugin, "client_extra_results", None)
                                if lst is None:
                                    return
                                for i in range(msgs.size()):
                                    m = msgs.get(i)
                                    try:
                                        mo = MessageObject(acc, m, False, True)
                                    except Exception:
                                        mo = MessageObject(acc, m, False)
                                    lst.append(mo)
                                slog(f"extra delivered count={msgs.size()}")
                                for d in (250, 900):
                                    run_on_ui_thread(lambda: _merge_extra_results(plugin), d)
                                run_on_ui_thread(lambda: _bump_chat_counter(plugin), 300)
                            except Exception as e:
                                slog("extra deliver failed", e)




                        run_on_ui_thread(_deliver)
                    except Exception as e:
                        slog("extra response failed", e)




                plugin._extra_callbacks.append(_on_extra)
                _SEND_HOOK_SUPPRESS = True
                try:
                    rid = send_request(req2, _on_extra)
                    slog(f"extra request '{pat.pattern}' sent id={rid}")
                finally:
                    _SEND_HOOK_SUPPRESS = False
                sent += 1
            except Exception as e:
                slog(f"extra request '{pat.pattern}' failed", e)
        if sent:
            slog(f"sendRequest: extra pattern requests sent={sent}")
    except Exception as e:
        slog("send extra pattern requests failed", e)








def _on_gextra_response(plugin, response, error, tok):
    try:
        slog(f"global extra cb: token={tok} error={error}")
        store = getattr(plugin, "global_extra_store", None)
        if store is None or int(store.get("token", -1)) != tok:
            slog("global extra response: stale store")
            return
        try:
            store["pending"] = max(0, int(store.get("pending", 0)) - 1)
        except Exception:
            store["pending"] = 0
        if error or response is None:
            slog(f"global extra response: error={error}")
            return
        try:
            _filter_global_response(plugin, response)
        except Exception:
            pass
        msgs = getattr(response, "messages", None)
        if msgs is not None:
            for i in range(msgs.size()):
                store["messages"].append(msgs.get(i))
        users = getattr(response, "users", None)
        if users is not None:
            for i in range(users.size()):
                store["users"].append(users.get(i))
        chats = getattr(response, "chats", None)
        if chats is not None:
            for i in range(chats.size()):
                store["chats"].append(chats.get(i))
        slog(f"global extra response: pending={store['pending']} msgs={len(store['messages'])}")
    except Exception as e:
        slog("global extra response failed", e)








def _send_global_extra_requests(plugin, req, patterns, flags):
    global _SEND_HOOK_SUPPRESS
    try:
        if patterns is None or len(patterns) < 2:
            return
        cm = get_connections_manager()
        copy_names = ("flags", "broadcasts_only", "groups_only", "users_only", "folder_id", "community", "filter", "min_date", "max_date", "offset_rate", "offset_peer", "offset_id", "limit")
        tok = int(getattr(plugin, "global_extra_token", 0)) + 1
        plugin.global_extra_token = tok
        store = {"token": tok, "pending": 0, "messages": [], "users": [], "chats": []}
        plugin.global_extra_store = store
        sent = 0
        for pat in patterns[1:]:
            try:
                req2 = TLRPC.TL_messages_searchGlobal()
                for name in copy_names:
                    _copy_tl_field(req, req2, name)
                qf = req2.getClass().getDeclaredField("q")
                qf.setAccessible(True)
                qf.set(req2, pat.pattern)
                opf = req2.getClass().getDeclaredField("offset_peer")
                opf.setAccessible(True)
                if opf.get(req2) is None:
                    opf.set(req2, TLRPC.TL_inputPeerEmpty())
                ff2 = req2.getClass().getDeclaredField("filter")
                ff2.setAccessible(True)
                if ff2.get(req2) is None:
                    ff2.set(req2, TLRPC.TL_inputMessagesFilterEmpty())
                def _gfn(resp, err, t=tok):
                    _on_gextra_response(plugin, resp, err, t)




                plugin._extra_callbacks.append(_gfn)
                store["pending"] += 1
                _SEND_HOOK_SUPPRESS = True
                try:
                    rid = send_request(req2, _gfn)
                    slog(f"global extra '{pat.pattern}' sent id={rid}")
                finally:
                    _SEND_HOOK_SUPPRESS = False
                sent += 1
            except Exception as e:
                slog(f"global extra request '{pat.pattern}' failed", e)
        if sent:
            slog(f"global: extra searchGlobal sent={sent} token={tok}")
    except Exception as e:
        slog("send global extra requests failed", e)








def _msg_dialog_id(m):
    try:
        peer = getattr(m, "peer_id", None)
        if peer is not None:
            uid = int(getattr(peer, "user_id", 0) or 0)
            if uid:
                return uid
            cid = int(getattr(peer, "chat_id", 0) or 0)
            if cid:
                return -cid
            chid = int(getattr(peer, "channel_id", 0) or 0)
            if chid:
                return -chid
    except Exception:
        pass
    try:
        return int(getattr(m, "dialog_id", 0) or 0)
    except Exception:
        return 0








def _dedupe_global_page(plugin, response):
    msgs = getattr(response, "messages", None)
    if msgs is None:
        return "none"
    total = msgs.size()
    if total == 0:
        return "empty"
    anchor = msgs.get(total - 1)
    plugin._g_page_anchor_date = int(getattr(anchor, "date", 0) or 0)
    anchor_key = (_msg_dialog_id(anchor), int(getattr(anchor, "id", 0)))
    seen = getattr(plugin, "_g_seen_keys", None)
    if seen is None:
        seen = set()
        plugin._g_seen_keys = seen
    repeat = anchor_key == getattr(plugin, "_g_last_anchor_key", None)
    kept = []
    dropped = 0
    for i in range(total):
        m = msgs.get(i)
        key = (_msg_dialog_id(m), int(getattr(m, "id", 0)))
        if key in seen:
            dropped += 1
            continue
        seen.add(key)
        kept.append(m)
    if repeat:
        plugin._g_repeat_count = int(getattr(plugin, "_g_repeat_count", 0)) + 1
        msgs.clear()
        slog(f"global: repeat page dropped={dropped} n={plugin._g_repeat_count}")
        return "repeat"
    plugin._g_last_anchor_key = anchor_key
    plugin._g_repeat_count = 0
    if dropped:
        msgs.clear()
        for m in kept:
            msgs.add(m)
    slog(f"global: page deduped kept={len(kept)} dropped={dropped}")
    return "new" if kept else "dupe"








def _merge_global_extras(plugin, response, store):
    msgs = getattr(response, "messages", None)
    if msgs is None or not store.get("messages"):
        return
    items = []
    for i in range(msgs.size()):
        items.append(msgs.get(i))
    if not items:
        return
    seen = set()
    for m in items:
        seen.add((_msg_dialog_id(m), int(getattr(m, "id", 0))))
    anchor_date = int(getattr(plugin, "_g_page_anchor_date", 0) or 0)
    if anchor_date <= 0:
        anchor_date = int(getattr(items[-1], "date", 0) or 0)
    gseen = getattr(plugin, "_g_seen_keys", None)
    if gseen is None:
        gseen = set()
        plugin._g_seen_keys = gseen
    extras = []
    for m in store.get("messages", []):
        key = (_msg_dialog_id(m), int(getattr(m, "id", 0)))
        if key in seen or key in gseen:
            continue
        if int(getattr(m, "date", 0) or 0) <= anchor_date:
            continue
        seen.add(key)
        gseen.add(key)
        extras.append(m)
    if not extras:
        return
    merged = items + extras
    merged.sort(key=lambda m: int(getattr(m, "date", 0) or 0), reverse=True)
    msgs.clear()
    for m in merged:
        msgs.add(m)
    added = len(extras)
    users = getattr(response, "users", None)
    if users is not None:
        have = set()
        for i in range(users.size()):
            have.add(int(getattr(users.get(i), "id", 0)))
        for u in store.get("users", []):
            uid = int(getattr(u, "id", 0))
            if uid not in have:
                have.add(uid)
                users.add(u)
    chats = getattr(response, "chats", None)
    if chats is not None:
        have = set()
        for i in range(chats.size()):
            have.add(int(getattr(chats.get(i), "id", 0)))
        for c in store.get("chats", []):
            cid = int(getattr(c, "id", 0))
            if cid not in have:
                have.add(cid)
                chats.add(c)
    slog(f"global: extras merged added={added} total={len(merged)}")








def _bump_chat_counter(plugin):
    try:
        frag = get_last_fragment()
        if frag is None:
            return
        if "ChatActivity" not in frag.getClass().getName():
            return
        mdc = frag.getMediaDataController()
        if mdc is None:
            return
        counts = getattr(plugin, "client_extra_server_counts", None)
        if not counts:
            return
        extra = sum(int(v) for v in counts.values())
        if extra <= 0:
            return
        plugin._count_hook_skip = True
        try:
            base = int(mdc.getSearchCount())
        finally:
            plugin._count_hook_skip = False
        total = base + extra
        cls = frag.getClass()
        slc_f = _find_field(frag, "searchLastCount")
        if slc_f is None:
            return
        slc_f.setInt(frag, total)
        m = cls.getDeclaredMethod("updateSearchCountText")
        m.setAccessible(True)
        m.invoke(frag)
        slog(f"chat counter refreshed base={base} extra={extra} total={total}")
    except Exception as e:
        slog("bump chat counter failed", e)








def _merge_extra_results(plugin):
    try:
        patterns = getattr(plugin, "client_filter_patterns", None)
        if patterns is None:
            return
        extras = getattr(plugin, "client_extra_results", None)
        if not extras:
            return
        frag = get_last_fragment()
        if frag is None:
            return
        mdc = frag.getMediaDataController()
        if mdc is None:
            return
        mdc_cls = mdc.getClass()
        srm_f = mdc_cls.getDeclaredField("searchResultMessages")
        srm_f.setAccessible(True)
        srm = srm_f.get(mdc)
        if srm is None:
            return
        items = []
        existing = set()
        for i in range(srm.size()):
            mo = srm.get(i)
            items.append(mo)
            existing.add(_msg_id(mo))
        plain = SearchPlusPlugin.patterns_plain(patterns)
        added_items = []
        added = 0
        for mo in extras:
            mid = _msg_id(mo)
            if mid == 0 or mid in existing:
                continue
            if not plain and not SearchPlusPlugin.msg_matches_patterns(mo, patterns):
                continue
            items.append(mo)
            existing.add(mid)
            added_items.append(mo)
            added += 1
        if added == 0:
            return
        plugin.client_extra_matched = int(getattr(plugin, "client_extra_matched", 0)) + added
        items.sort(key=_msg_id, reverse=True)
        srm.clear()
        for mo in items:
            srm.add(mo)
        try:
            map_f = mdc_cls.getDeclaredField("searchServerResultMessagesMap")
            map_f.setAccessible(True)
            maps = map_f.get(mdc)
            from java.lang.reflect import Array as JArray
            for mo in added_items:
                mid = _msg_id(mo)
                for idx in (0, 1):
                    try:
                        sa = JArray.get(maps, idx)
                        sa.put(mid, mo)
                    except Exception:
                        break
        except Exception as e:
            slog("extras map put failed", e)
        reasons = {}
        samples = []
        for mo in added_items:
            r = _inject_preview_highlight(plugin, mo)
            reasons[r] = reasons.get(r, 0) + 1
            if r != "ok" and len(samples) < 3:
                owner = getattr(mo, "messageOwner", None)
                snip = (getattr(owner, "message", "") or "") if owner is not None else ""
                snip = str(snip).replace("\n", "\\n")[:40]
                cap = getattr(mo, "caption", None)
                samples.append(f"{r}:len{len(snip)}:'{snip}' cap={'y' if cap is not None else 'n'}")
        slog(f"preview inject reasons: {reasons} samples={samples}")
        slog(f"client filter: merged extras added={added} total={srm.size()}")
        try:
            adapter_f = frag.getClass().getDeclaredField("messagesSearchAdapter")
            adapter_f.setAccessible(True)
            adapter = adapter_f.get(frag)
            if adapter is not None:
                adapter.notifyDataSetChanged()
        except Exception:
            pass
    except Exception as e:
        slog("merge extra results failed", e)








def _make_request_delegate(fn):
    try:
        rd_cls = jclass("org.telegram.tgnet.RequestDelegate")




        class _RD(dynamic_proxy(rd_cls)):
            def __init__(self, f):
                super().__init__()
                self._fn = f




            def run(self, response, error):
                self._fn(response, error)




        return _RD(fn)
    except Exception as e:
        slog("make request delegate failed", e)
        return None








def _schedule_g_end_clear(plugin, raw_count, limit=0, signal="none"):
    adapter = getattr(plugin, "_g_search_adapter", None)
    if adapter is None or limit <= 0 or raw_count < max(15, limit - 1):
        return
    if signal == "repeat":
        if int(getattr(plugin, "_g_repeat_count", 0)) > 2:
            return
    elif signal not in ("new", "dupe"):
        return




    def _clear():
        try:
            f = _find_field(adapter, "messagesSearchEndReached")
            if f is None:
                return
            if f.getBoolean(adapter):
                f.setBoolean(adapter, False)
                try:
                    adapter.notifyDataSetChanged()
                except Exception:
                    pass
                slog("global: endReached cleared")
        except Exception as e:
            slog("global: endReached clear failed", e)




    run_on_ui_thread(_clear, 300)
    run_on_ui_thread(_clear, 900)








def _resolve_g_search_adapter(plugin):
    frag = getattr(plugin, "_g_dialogs_fragment", None)
    if frag is None:
        return None
    try:
        svp = _find_field_value(frag, "searchViewPager")
        if svp is None:
            return None
        a = _find_field_value(svp, "dialogsSearchAdapter")
        if a is None:
            return None
        cls = None
        try:
            cls = JClass.forName("org.telegram.ui.Adapters.DialogsSearchAdapter")
        except Exception:
            cls = None
        if cls is not None:
            if not cls.isInstance(a):
                return None
        elif "DialogsSearchAdapter" not in a.getClass().getName():
            return None
        return a
    except Exception as e:
        slog("resolve search adapter failed", e)
        return None








def _make_person_delegate(original, plugin, limit=0):
    state = {"done": False, "raw": 0, "limit": int(limit or 0)}




    def _finish(response, error):
        if state["done"]:
            return
        state["done"] = True
        signal = "none"
        try:
            if response is not None and error is None:
                msgs = getattr(response, "messages", None)
                if msgs is not None:
                    try:
                        signal = _dedupe_global_page(plugin, response)
                    except Exception as e:
                        slog("global page dedupe failed", e)
            store = getattr(plugin, "global_extra_store", None)
            if store is not None and store.get("messages"):
                try:
                    _merge_global_extras(plugin, response, store)
                except Exception as e:
                    slog("global extras merge failed", e)
        except Exception as e:
            slog("global extras finish failed", e)
        slog(f"global: response raw={state.get('raw', 0)} limit={state.get('limit', 0)} signal={signal}")
        try:
            original.run(response, error)
        except Exception as e:
            slog("person delegate orig failed", e)
        try:
            _schedule_g_end_clear(plugin, int(state.get("raw", 0)), int(state.get("limit", 0)), signal)
        except Exception as e:
            slog("global end clear schedule failed", e)




    def _wait(response, error, tries=0):
        try:
            store = getattr(plugin, "global_extra_store", None)
            pending = int(store.get("pending", 0)) if store is not None else 0
            if pending > 0 and tries < 15:
                run_on_ui_thread(lambda r=response, e=error, t=tries + 1: _wait(r, e, t), 100)
                return
            if store is not None:
                slog(f"global: extras wait done pending={pending} msgs={len(store.get('messages', []))}")
            _finish(response, error)
        except Exception as e:
            slog("global extras wait failed", e)
            _finish(response, error)




    def _run(response, error):
        try:
            if response is not None and error is None:
                msgs = getattr(response, "messages", None)
                if msgs is not None:
                    state["raw"] = int(msgs.size())
                _filter_global_response(plugin, response)
        except Exception as e:
            slog("person delegate filter failed", e)
        try:
            store = getattr(plugin, "global_extra_store", None)
            if store is not None and int(store.get("pending", 0)) > 0:
                _wait(response, error, 0)
                return
        except Exception as e:
            slog("global extras check failed", e)
        _finish(response, error)




    return _make_request_delegate(_run)








class GlobalPersonDialog:
    def __init__(self, plugin):
        self.plugin = plugin




    def show(self):
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if not ctx:
                from org.telegram.messenger import ApplicationLoader
                ctx = ApplicationLoader.applicationContext
            builder = AlertDialogBuilder(ctx)
            builder.set_title("Человек для глобального поиска")
            input = EditText(ctx)
            input.setHint("ID, +7..., @username, t.me/... (пусто — сбросить)")
            input.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            input.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
            pad = AndroidUtilities.dp(16)
            container = LinearLayout(ctx)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(pad, pad, pad, pad)
            container.addView(input, LayoutHelper.createLinear(-1, -2))
            builder.set_view(container)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())
            plugin = self.plugin




            def on_positive(dialog, which):
                text = str(input.getText().toString())
                plugin._set_g_person_from_text(text)




            builder.set_positive_button("Применить", on_positive)
            builder.show()
            input.requestFocus()
        except Exception as e:
            slog("GlobalPersonDialog.show failed", e)
            BulletinHelper.show_error("Ошибка диалога")








class GlobalFilterSheet:
    @staticmethod
    def _make_builder(ctx, rp):
        from org.telegram.ui.ActionBar import BottomSheet
        try:
            return BottomSheet.Builder(ctx, False, rp)
        except Exception:
            return BottomSheet.Builder(ctx, False)




    @staticmethod
    def _add_rows(ctx, rp, container, items, current_idx, on_pick):
        from android_utils import OnClickListener
        from org.telegram.ui.Cells import TextCell
        check_res = MediaTypeSheet.resolve_icon(MediaTypeFilter.CHECK_ICONS)
        added = 0
        for i in range(len(items)):
            entry = items[i]
            name = entry[0]
            icons = entry[1] if len(entry) > 1 else ()
            selected = (i == current_idx)
            if selected:
                icon_res = check_res
            else:
                icon_res = MediaTypeSheet.resolve_icon(icons)
            try:
                cell = TextCell(ctx, rp) if rp is not None else TextCell(ctx)
            except Exception:
                try:
                    cell = TextCell(ctx)
                except Exception:
                    continue
            placed = False
            if icon_res != 0:
                try:
                    cell.setTextAndIcon(JString(name), icon_res, False)
                    placed = True
                except Exception:
                    placed = False
            if not placed:
                try:
                    cell.setText(JString(name), False)
                except Exception:
                    continue
            if selected:
                try:
                    cell.setColors(
                        Theme.key_windowBackgroundWhiteBlueText2,
                        Theme.key_windowBackgroundWhiteBlueText2,
                    )
                except Exception:
                    pass




            def make_handler(index):
                def handler(v):
                    on_pick(index)
                return handler




            cell.setOnClickListener(OnClickListener(make_handler(i)))
            container.addView(cell, LayoutHelper.createLinear(-1, 48))
            added += 1
        return added




    @staticmethod
    def _show_rows(items, current_idx, on_pick):
        try:
            frag = get_last_fragment()
            if frag is None:
                return False
            ctx = frag.getParentActivity()
            if ctx is None:
                return False
            try:
                rp = frag.getResourceProvider()
            except Exception:
                rp = None
            builder = GlobalFilterSheet._make_builder(ctx, rp)
            container = LinearLayout(ctx)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8))
            holder = {}




            def pick(index):
                try:
                    sheet = holder.get("sheet")
                    if sheet is not None:
                        sheet.dismiss()
                except Exception:
                    pass
                on_pick(index)




            added = GlobalFilterSheet._add_rows(ctx, rp, container, items, current_idx, pick)
            if added == 0:
                return False
            builder.setCustomView(container)
            sheet = builder.create()
            holder["sheet"] = sheet
            sheet.show()
            return True
        except Exception as e:
            slog("GlobalFilterSheet._show_rows failed", e)
            return False




    @staticmethod
    def show(plugin):
        try:
            frag = get_last_fragment()
            if frag is None:
                return False
            ctx = frag.getParentActivity()
            if ctx is None:
                return False
            try:
                rp = frag.getResourceProvider()
            except Exception:
                rp = None
            builder = GlobalFilterSheet._make_builder(ctx, rp)
            container = LinearLayout(ctx)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8))
            person_name = plugin._g_person_name if int(plugin._g_person_id) != 0 else "все"
            date_name = GLOBAL_DATE_PRESETS[int(plugin._g_date_preset_idx)][0]
            type_name = MediaTypeFilter.TYPES[int(plugin._g_type_idx)][0]
            items = [
                (f"Человек: {person_name}", ()),
                (f"Период: {date_name}", ()),
                (f"Тип: {type_name}", ()),
                ("Сбросить фильтры", ()),
            ]
            holder = {}




            def on_pick(index):
                try:
                    sheet = holder.get("sheet")
                    if sheet is not None:
                        sheet.dismiss()
                except Exception:
                    pass
                if index == 0:
                    GlobalPersonDialog(plugin).show()
                elif index == 1:
                    plugin._show_g_date_sheet()
                elif index == 2:
                    plugin._show_g_type_sheet()
                elif index == 3:
                    plugin._reset_g_filters()




            added = GlobalFilterSheet._add_rows(ctx, rp, container, items, -1, on_pick)
            if added == 0:
                return False
            builder.setCustomView(container)
            sheet = builder.create()
            holder["sheet"] = sheet
            sheet.show()
            return True
        except Exception as e:
            slog("GlobalFilterSheet.show failed", e)
            return False








class SearchPlusPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._hooks = []
        self._current_media_filter_idx = 0
        self._type_button = None
        self.client_filter_pending = False
        self.client_filter_type = None
        self.client_filter_anchor_id = 0
        self.client_filter_autoload = 0
        self._unstick_chain = 0
        self._last_search_loaded = 0
        self.client_filter_matched = 0
        self.client_filter_scanned = 0
        self.client_filter_patterns = None
        self.client_extra_results = []
        self.client_extra_token = 0
        self.client_extra_matched = 0
        self.client_extra_server_counts = {}
        self._g_person_id = 0
        self._g_person_is_chat = False
        self._g_person_name = ""
        self._g_date_preset_idx = 0
        self._g_date_from = 0
        self._g_date_to = 0
        self._g_type_idx = 0
        self._last_global_query = ""
        self._g_filter_button = None
        self._g_person_btn = None
        self._g_date_btn = None
        self._g_type_btn = None
        self.chat_highlight_patterns = None
        self._extra_delegates = []
        self._extra_callbacks = []
        self.global_extra_store = None
        self.global_extra_token = 0




    def reset_filter_counters(self):
        self.client_filter_matched = 0
        self.client_filter_scanned = 0
        self.client_extra_matched = 0




    HELP_TOPICS = [
        ("Мультипоиск", "msg_search", "Перечислите слова через разделитель: слово1|слово2|слово3. Найдутся сообщения, где есть хотя бы одно из слов. Все найденные вхождения подсвечиваются в сообщениях и в превью.\n\nКаждая часть — регулярка: например ^привет найдёт сообщения, начинающиеся с привет, а word\\d+ — word с цифрой на конце. Если часть не является корректной регуляркой, она ищется как обычный текст."),
        ("Свой разделитель", "msg_edit", "По умолчанию вертикальная черта. Если ищете текст, который сам содержит черту, поменяйте разделитель в настройках на любой другой символ, например на точку с запятой."),
        ("Фильтр по типу", "msg_media", "Кнопка «Тип» в поиске по чату: все, фото, видео, фото и видео, файлы, музыка, голосовые и кружки, гифки, ссылки. Работает вместе с мультипоиском."),
        ("Глобальные фильтры", "msg_contacts", "Кнопка «Фильтр» в поиске по чатам: конкретный человек, период (сегодня, 3 дня, неделя, месяц, год или свой диапазон дат), тип сообщений. Можно комбинировать между собой."),
        ("Сброс фильтров", "msg_delete", "Кнопка «Сбросить фильтры» в настройках очищает все активные фильтры поиска: тип, человека, период, клиентские фильтры и подсветку. Удобно, когда результаты поиска выглядят странно."),
        ("Поиск по ID", "msg_info", "Введите в поиск по чату или в глобальный поиск ID, телефон или @username, например 123456789, +79001234567, @durov или t.me/durov — откроется профиль."),
        ("Упоминание по ID", "msg_msgbubble3_solar", "В поле ввода наберите @ и сразу цифры: @1234567890 или @+79001234567 — человек появится в списке упоминаний."),
        ("Разблокировать по ID", "msg_copy", "Пункт в меню группы или канала, нужны права администратора. Разблокирует пользователя по его ID без перехода в профиль."),
        ("Ограничение по ID", "msg_link", "По ID находятся только те люди, с кем уже есть переписка, общая группа или кто есть в контактах. Это ограничение Telegram. Незнакомцев ищите по телефону или @username."),
    ]




    def create_settings(self):
        try:
            return [
                Header(text="Мультипоиск"),
                Switch(
                    key="multi_enabled",
                    text="Мультипоиск",
                    subtext="Поиск нескольких слов сразу через разделитель",
                    default=True,
                    icon="msg_search",
                ),
                Input(
                    key="multi_separator",
                    text="Свой разделитель",
                    subtext="Символ между словами, по умолчанию |",
                    default="|",
                ),
                Divider(),
                Text(
                    text="Сбросить фильтры",
                    icon="msg_delete",
                    on_click=self._on_reset_filters_click,
                ),
                Divider(),
                Header(text="Описание функций"),
            ] + [
                Text(
                    text=title,
                    icon=icon,
                    on_click=self._make_help_click(idx),
                )
                for idx, (title, icon, _) in enumerate(self.HELP_TOPICS)
            ] + [
                Divider(),
            ]
        except Exception as e:
            slog("create_settings failed", e)
            return []




    def _make_help_click(self, idx):
        def handler(view=None):
            try:
                title, _, body = self.HELP_TOPICS[idx]
                frag = get_last_fragment()
                ctx = frag.getParentActivity() if frag else None
                if ctx is None:
                    from org.telegram.messenger import ApplicationLoader
                    ctx = ApplicationLoader.applicationContext
                builder = AlertDialogBuilder(ctx)
                builder.set_title(title)
                builder.set_message(body)
                builder.set_positive_button("Понятно", lambda b, w: b.dismiss())
                builder.show()
            except Exception as e:
                slog("help click failed", e)
        return handler




    def _on_reset_filters_click(self, view=None):
        try:
            self._current_media_filter_idx = 0
            self.client_filter_pending = False
            self.client_filter_anchor_id = 0
            self.client_filter_autoload = 0
            self.client_filter_patterns = None
            self.client_extra_server_counts = {}
            self.chat_highlight_patterns = None
            self.reset_filter_counters()
            try:
                if self._type_button is not None:
                    self._type_button.setText(JString("Тип \u25be"))
            except Exception:
                pass
            self._reset_g_filters()
        except Exception as e:
            slog("reset filters click failed", e)
            BulletinHelper.show_error("Ошибка сброса")




    def on_plugin_load(self):
        global plugin_instance
        plugin_instance = self
        try:
            self._hooks = []
            self._mentions_debounce_token = 0
            self._register_menu_items()
            self._hook_global_search()
            self._hook_chat_search_by_id()
            self._hook_inject_type_button()
            self._hook_send_request()
            self._hook_chat_highlight()
            self._hook_mentions_adapter()
            self._hook_users_block_search()
            self._hook_server_search()
            self._hook_notification_center()
            self._hook_search_count()
            self._hook_search_navigation()
            self._hook_trim()
            slog("Search+ loaded")
        except Exception as e:
            slog("on_plugin_load failed", e)




    def on_plugin_unload(self):
        try:
            for h in self._hooks:
                try:
                    self.unhook_method(h)
                except Exception:
                    pass
            self._hooks.clear()
        except Exception as e:
            slog("on_plugin_unload failed", e)




    def _register_menu_items(self):
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Разблокировать по ID",
                icon="msg_reactions",
                on_click=self._menu_unblock_by_id
            ))
        except Exception as e:
            slog("register unblock menu failed", e)




    def _menu_search_by_id(self, ctx):
        try:
            IdSearchDialog(self).show()
        except Exception as e:
