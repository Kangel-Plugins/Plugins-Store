    def _menu_unblock_by_id(self, ctx):
        try:
            frag = get_last_fragment()
            if not frag:
                BulletinHelper.show_error("Нет фрагмента")
                return
            ca_cls = JClass.forName("org.telegram.ui.ChatActivity")
            if not ca_cls.isInstance(frag):
                BulletinHelper.show_error("Откройте чат/канал")
                return
            current_chat = frag.getCurrentChat()
            if not current_chat:
                BulletinHelper.show_error("Это не групповой чат")
                return
            UnblockDialog(self, frag, current_chat).show()
        except Exception as e:
            slog("_menu_unblock_by_id failed", e)
            BulletinHelper.show_error("Ошибка")




    def _do_unblock(self, text, chat, frag):
        try:
            parsed = InputParser.parse(text)
            if not parsed:
                BulletinHelper.show_error("Не распознано. Введите ID, телефон, @username или ссылку")
                return
            kind, value = parsed
            mc = get_messages_controller()
            slog(f"unblock: kind={kind} value={value}")




            if kind == "id":
                try:
                    uid = int(value)
                except Exception:
                    BulletinHelper.show_error("Некорректный ID")
                    return
                user = mc.getUser(uid)
                if user and not isinstance(user, TLRPC.TL_userEmpty):
                    slog(f"unblock: user found in cache id={uid}")
                    self._send_unblock(chat, user, mc)
                    return
                slog(f"unblock: user not in cache, searching banned list id={uid}")
                self._find_banned_user(chat, uid, mc)
            elif kind == "phone":
                def on_done(response, error):
                    try:
                        if error or not response:
                            run_on_ui_thread(lambda: BulletinHelper.show_error("Пользователь не найден"))
                            return
                        user = None
                        if hasattr(response, "users") and not response.users.isEmpty():
                            user = response.users.get(0)
                        elif isinstance(response, TLRPC.User):
                            user = response
                        if user is None:
                            run_on_ui_thread(lambda: BulletinHelper.show_error("Пользователь не найден"))
                            return
                        final_user = user
                        run_on_ui_thread(lambda: self._send_unblock(chat, final_user, mc))
                    except Exception as e:
                        slog("_do_unblock phone on_done failed", e)
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка"))
                ResolveHelper.resolve_phone(value, on_done)
            elif kind == "username":
                def on_done(response, error):
                    try:
                        if error or not response:
                            run_on_ui_thread(lambda: BulletinHelper.show_error("Пользователь не найден"))
                            return
                        user = None
                        if hasattr(response, "users") and not response.users.isEmpty():
                            user = response.users.get(0)
                        elif isinstance(response, TLRPC.User):
                            user = response
                        if user is None:
                            run_on_ui_thread(lambda: BulletinHelper.show_error("Пользователь не найден"))
                            return
                        final_user = user
                        run_on_ui_thread(lambda: self._send_unblock(chat, final_user, mc))
                    except Exception as e:
                        slog("_do_unblock username on_done failed", e)
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка"))
                ResolveHelper.resolve_username(value, on_done)
        except Exception as e:
            slog("_do_unblock failed", e)
            BulletinHelper.show_error("Ошибка")




    def _find_banned_user(self, chat, uid, mc):
        try:
            input_channel = mc.getInputChannel(chat)
            req = TLRPC.TL_channels_getParticipants()
            req.channel = input_channel
            filt = TLRPC.TL_channelParticipantsBanned()
            filt.q = ""
            req.filter = filt
            req.offset = 0
            req.limit = 200
            from java.lang import Long as JLong
            req.hash = JLong.valueOf(0)




            def on_response(response, error):
                try:
                    if error or not response:
                        slog(f"unblock: getParticipants error={error}")
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось получить список забаненных"))
                        return
                    slog(f"unblock: getParticipants response type={type(response).__name__}")
                    found_user = None
                    if hasattr(response, "participants"):
                        slog(f"unblock: participants count={response.participants.size()}")
                        for i in range(response.participants.size()):
                            p = response.participants.get(i)
                            p_uid = 0
                            peer = getattr(p, "peer", None)
                            if peer is not None:
                                p_uid = int(peer.user_id) if hasattr(peer, "user_id") else 0
                            if p_uid == 0:
                                p_uid = int(p.user_id) if hasattr(p, "user_id") else 0
                            slog(f"unblock: participant[{i}] uid={p_uid} type={type(p).__name__}")
                            if p_uid == uid:
                                if hasattr(response, "users"):
                                    for j in range(response.users.size()):
                                        u = response.users.get(j)
                                        if int(u.id) == uid:
                                            found_user = u
                                            break
                                break
                    if found_user is None:
                        slog(f"unblock: user {uid} not found in banned list")
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Пользователь не найден в списке забаненных"))
                        return
                    slog(f"unblock: found banned user id={uid}")
                    final_user = found_user
                    run_on_ui_thread(lambda: self._send_unblock(chat, final_user, mc))
                except Exception as e:
                    slog("_find_banned_user on_response failed", e)
                    run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка"))




            send_request(req, on_response)
            slog("unblock: getParticipants request sent")
        except Exception as e:
            slog("_find_banned_user failed", e)
            BulletinHelper.show_error("Ошибка поиска забаненных")




    def _send_unblock(self, chat, user, mc):
        try:
            input_channel = mc.getInputChannel(chat)
            input_peer = TLRPC.TL_inputPeerUser()
            input_peer.user_id = int(user.id)
            input_peer.access_hash = int(user.access_hash)
            req = TLRPC.TL_channels_editBanned()
            req.channel = input_channel
            req.participant = input_peer
            req.banned_rights = TLRPC.TL_chatBannedRights()
            req.banned_rights.flags = 0
            req.banned_rights.until_date = 0




            def on_response(response, error):
                try:
                    if error:
                        slog("unblock error", error)
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка разблокировки"))
                    else:
                        run_on_ui_thread(lambda: BulletinHelper.show_success("Разблокирован"))
                except Exception as e:
                    slog("unblock on_response failed", e)




            send_request(req, on_response)
            slog("unblock request sent")
        except Exception as e:
            slog("_send_unblock failed", e)
            BulletinHelper.show_error("Ошибка разблокировки")




    def _do_id_search(self, text):
        parsed = InputParser.parse(text)
        if not parsed:
            BulletinHelper.show_error("Не распознано. Введите ID, телефон, @username или ссылку")
            return
        kind, value = parsed
        if kind == "id":
            ResolveHelper.resolve_id(value, self._on_resolve_done)
        elif kind == "phone":
            ResolveHelper.resolve_phone(value, self._on_resolve_response)
        elif kind == "username":
            ResolveHelper.resolve_username(value, self._on_resolve_response)




    def _on_resolve_response(self, response, error):
        self._on_resolve_done(response, error)




    def _on_resolve_done(self, response, error):
        def run():
            try:
                if error or not response:
                    run_on_ui_thread(lambda: BulletinHelper.show_error("Не найдено"))
                    return
                obj = ResolveHelper.extract(response)
                if obj is None:
                    run_on_ui_thread(lambda: BulletinHelper.show_error("Не найдено"))
                    return
                final_obj = obj
                run_on_ui_thread(lambda: ResolveHelper.open_profile(final_obj))
            except Exception as e:
                slog("_on_resolve_done failed", e)
                run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка обработки"))
        threading.Thread(target=run, daemon=True).start()




    def _hook_global_search(self):
        try:
            try:
                da_cls = JClass.forName("org.telegram.ui.DialogsActivity")
            except Exception:
                slog("DialogsActivity not found")
                return
            hooked = 0
            found_destroy = False
            for m in da_cls.getDeclaredMethods():
                name = m.getName()
                if name == "search" and len(m.getParameterTypes()) == 2:
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, GlobalSearchHook(self)))
                    hooked += 1
                    continue
                if name == "showSearch":
                    params = m.getParameterTypes()
                    if len(params) not in (3, 4):
                        continue
                    if not all(p.getName() == "boolean" for p in params):
                        continue
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, GlobalSearchHook(self)))
                    hooked += 1
                    continue
                if name == "onFragmentDestroy" and len(m.getParameterTypes()) == 0:
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, GFragmentDestroyHook(self)))
                    found_destroy = True
                    hooked += 1
            if not found_destroy:
                try:
                    bf_cls = JClass.forName("org.telegram.ui.BaseFragment")
                    for m in bf_cls.getDeclaredMethods():
                        if m.getName() == "onFragmentDestroy" and len(m.getParameterTypes()) == 0:
                            m.setAccessible(True)
                            self._hooks.append(self.hook_method(m, GFragmentDestroyHook(self)))
                            hooked += 1
                            break
                except Exception:
                    pass
            slog(f"hooked DialogsActivity search/showSearch/destroy x{hooked}")
        except Exception as e:
            slog("_hook_global_search failed", e)




    def _hook_chat_search_by_id(self):
        try:
            try:
                ca_cls = JClass.forName("org.telegram.ui.ChatActivity")
            except Exception:
                slog("ChatActivity not found")
                return
            for m in ca_cls.getDeclaredMethods():
                if m.getName() == "openSearchWithText" and len(m.getParameterTypes()) == 1:
                    ptype = m.getParameterTypes()[0].getName()
                    if ptype == "java.lang.String":
                        m.setAccessible(True)
                        self._hooks.append(self.hook_method(m, ChatSearchByIdHook(self)))
                        slog("hooked ChatActivity.openSearchWithText(String)")
        except Exception as e:
            slog("_hook_chat_search_by_id failed", e)




    def _hook_inject_type_button(self):
        try:
            try:
                ca_cls = JClass.forName("org.telegram.ui.ChatActivity")
            except Exception:
                slog("ChatActivity not found")
                return
            for m in ca_cls.getDeclaredMethods():
                if m.getName() == "createSearchContainer" and len(m.getParameterTypes()) == 0:
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, InjectTypeButtonHook(self)))
                    slog("hooked ChatActivity.createSearchContainer")
        except Exception as e:
            slog("_hook_inject_type_button failed", e)




    def _hook_send_request(self):
        try:
            try:
                cm_cls = JClass.forName("org.telegram.tgnet.ConnectionsManager")
            except Exception:
                slog("ConnectionsManager not found")
                return
            hooked = 0
            for m in cm_cls.getDeclaredMethods():
                if m.getName() != "sendRequest":
                    continue
                params = m.getParameterTypes()
                if len(params) < 2:
                    continue
                if params[0].getName() != "org.telegram.tgnet.TLObject":
                    continue
                if params[1].getName() != "org.telegram.tgnet.RequestDelegate":
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, SendRequestHook(self)))
                sig = ",".join(p.getName() for p in params)
                slog(f"hooked ConnectionsManager.sendRequest({sig})")
                hooked += 1
            if hooked == 0:
                slog("sendRequest(TLObject, RequestDelegate, ...) not found")
        except Exception as e:
            slog("_hook_send_request failed", e)




    def _hook_chat_highlight(self):
        try:
            cm_cls = JClass.forName("org.telegram.ui.Cells.ChatMessageCell")
            hooked = 0
            for m in cm_cls.getDeclaredMethods():
                if m.getName() != "setHighlightedText":
                    continue
                params = m.getParameterTypes()
                if len(params) != 4 or params[0].getName() != "java.lang.String":
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, HighlightMultiHook(self)))
                hooked += 1
            slog(f"hooked ChatMessageCell.setHighlightedText x{hooked}")
        except Exception as e:
            slog("_hook_chat_highlight failed", e)




    def _hook_mentions_adapter(self):
        try:
            try:
                ma_cls = JClass.forName("org.telegram.ui.Adapters.MentionsAdapter")
            except Exception:
                slog("MentionsAdapter not found")
                return
            for m in ma_cls.getDeclaredMethods():
                if m.getName() != "searchUsernameOrHashtag":
                    continue
                params = m.getParameterTypes()
                if len(params) != 5:
                    continue
                if params[0].getName() != "java.lang.CharSequence":
                    continue
                if params[1].getName() != "int":
                    continue
                if params[2].getName() != "java.util.ArrayList":
                    continue
                if params[3].getName() != "boolean":
                    continue
                if params[4].getName() != "boolean":
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, MentionsSearchHook(self)))
                slog("hooked MentionsAdapter.searchUsernameOrHashtag")
                return
            slog("MentionsAdapter.searchUsernameOrHashtag not found")
        except Exception as e:
            slog("_hook_mentions_adapter failed", e)




    def _hook_users_block_search(self):
        try:
            targets = [
                "org.telegram.ui.UsersSelectActivity$GroupCreateAdapter",
                "org.telegram.ui.GroupCreateActivity$GroupCreateAdapter",
            ]
            for cls_name in targets:
                try:
                    cls = JClass.forName(cls_name)
                except Exception as e:
                    slog(f"{cls_name} not found: {e}")
                    continue
                hooked = False
                for m in cls.getDeclaredMethods():
                    if m.getName() != "searchDialogs":
                        continue
                    params = m.getParameterTypes()
                    if len(params) != 1:
                        continue
                    if params[0].getName() != "java.lang.String":
                        continue
                    m.setAccessible(True)
                    self._hooks.append(self.hook_method(m, UsersBlockSearchHook(self)))
                    slog(f"hooked {cls_name}.searchDialogs")
                    hooked = True
                    break
                if not hooked:
                    slog(f"{cls_name}.searchDialogs not found")
        except Exception as e:
            slog("_hook_users_block_search failed", e)




    def _hook_server_search(self):
        try:
            try:
                sah_cls = JClass.forName("org.telegram.ui.Adapters.SearchAdapterHelper")
            except Exception as e:
                slog(f"SearchAdapterHelper not found: {e}")
                return
            for m in sah_cls.getDeclaredMethods():
                if m.getName() != "queryServerSearch":
                    continue
                params = m.getParameterTypes()
                if len(params) != 12:
                    continue
                if params[0].getName() != "java.lang.String":
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, ServerSearchHook(self)))
                slog("hooked SearchAdapterHelper.queryServerSearch(12)")
                return
            slog("SearchAdapterHelper.queryServerSearch(12) not found")
        except Exception as e:
            slog("_hook_server_search failed", e)




    def _hook_notification_center(self):
        try:
            try:
                nc_cls = JClass.forName("org.telegram.messenger.NotificationCenter")
            except Exception:
                slog("NotificationCenter not found")
                return
            target = None
            for m in nc_cls.getDeclaredMethods():
                if m.getName() != "postNotificationName":
                    continue
                params = m.getParameterTypes()
                if len(params) != 2:
                    continue
                if params[0].getName() != "int":
                    continue
                if params[1].getName() != "[Ljava.lang.Object;":
                    continue
                target = m
                break
            if target is None:
                slog("NotificationCenter.postNotificationName(int, Object[]) not found")
                return
            target.setAccessible(True)
            self._hooks.append(self.hook_method(target, PostNotificationHook(self)))
            slog("hooked NotificationCenter.postNotificationName(int, Object[])")
        except Exception as e:
            slog("_hook_notification_center failed", e)




    def _hook_search_count(self):
        try:
            mdc_cls = JClass.forName("org.telegram.messenger.MediaDataController")
            for m in mdc_cls.getDeclaredMethods():
                if m.getName() != "getSearchCount":
                    continue
                if len(m.getParameterTypes()) != 0:
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, SearchCountHook(self)))
                slog("hooked MediaDataController.getSearchCount")
                return
            slog("MediaDataController.getSearchCount not found")
        except Exception as e:
            slog("_hook_search_count failed", e)




    def _hook_search_navigation(self):
        try:
            ca_cls = JClass.forName("org.telegram.ui.ChatActivity")
            for m in ca_cls.getDeclaredMethods():
                if m.getName() != "goToNextOrPrevSearchMessage":
                    continue
                params = m.getParameterTypes()
                if len(params) != 1 or params[0].getName() != "boolean":
                    continue
                m.setAccessible(True)
                self._hooks.append(self.hook_method(m, SearchNavigationHook(self)))
                slog("hooked ChatActivity.goToNextOrPrevSearchMessage")
                return
            slog("ChatActivity.goToNextOrPrevSearchMessage not found")
        except Exception as e:
            slog("_hook_search_navigation failed", e)




    def _hook_trim(self):
        try:
            mo_cls = JClass.forName("org.telegram.messenger.MessageObject")
            cap_target = None
            for m in mo_cls.getDeclaredMethods():
                if m.getName() != "generateCaption":
                    continue
                if len(m.getParameterTypes()) != 0:
                    continue
                cap_target = m
                break
            if cap_target is None:
                slog("MessageObject.generateCaption not found")
            else:
                cap_target.setAccessible(True)
                self._hooks.append(self.hook_method(cap_target, TrimHook(self)))
                slog("hooked MessageObject.generateCaption")
            target = None
            for m in mo_cls.getDeclaredMethods():
                if m.getName() != "handleFoundWords":
                    continue
                if len(m.getParameterTypes()) == 4:
                    target = m
                    break
            if target is None:
                slog("MessageObject.handleFoundWords(4) not found")
                return
            target.setAccessible(True)
            self._hooks.append(self.hook_method(target, TrimHook(self)))
            slog("hooked MessageObject.handleFoundWords")
        except Exception as e:
            slog("_hook_trim failed", e)




    def show_media_type_picker(self):
        try:
            if MediaTypeSheet.show(self):
                return
            slog("bottom sheet unavailable, falling back to alert dialog")
            self._show_media_type_alert()
        except Exception as e:
            slog("show_media_type_picker failed", e)
            try:
                self._show_media_type_alert()
            except Exception:
                BulletinHelper.show_error("Ошибка выбора типа")




    def _show_media_type_alert(self):
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if not ctx:
                from org.telegram.messenger import ApplicationLoader
                ctx = ApplicationLoader.applicationContext
            names = [t[0] for t in MediaTypeFilter.TYPES]
            builder = AlertDialogBuilder(ctx)
            builder.set_title("Тип сообщений")
            plugin = self




            def on_item(dialog, which):
                try:
                    idx = int(which)
                    dialog.dismiss()
                    plugin.apply_media_filter_deferred(idx)
                except Exception as e:
                    slog("type on_click failed", e)




            builder.set_items(names, on_item)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            slog("_show_media_type_alert failed", e)
            BulletinHelper.show_error("Ошибка выбора типа")




    def apply_media_filter_deferred(self, idx):
        try:
            target = int(idx)
        except Exception:
            return




        def run():
            try:
                self._set_media_filter(target)
            except Exception as e:
                slog("deferred filter apply failed", e)




        run_on_ui_thread(run, 120)




    def _set_media_filter(self, idx):
        try:
            self._current_media_filter_idx = int(idx)
            name = MediaTypeFilter.TYPES[idx][0]
            slog(f"media filter set: idx={idx} name={name}")
            if self._type_button is not None:
                label = name + " \u25be" if idx != 0 else "\u0422\u0438\u043f \u25be"
                try:
                    self._type_button.setText(JString(label))
                except Exception as e:
                    slog("update type button text failed", e)
            self.client_filter_matched = 0
            self.client_filter_scanned = 0
            try:
                BulletinHelper.show_info(f"Фильтр: {name}")
            except Exception:
                pass
            self._restart_chat_search()
        except Exception as e:
            slog("_set_media_filter failed", e)




    def _restart_chat_search(self):
        try:
            self.client_filter_pending = False
            self.client_filter_anchor_id = 0
            self.client_filter_autoload = 0
            self.reset_filter_counters()
            frag = get_last_fragment()
            if frag is None:
                slog("restart search: no fragment")
                return
            fc = frag.getClass()
            q_field = fc.getDeclaredField("searchingQuery")
            q_field.setAccessible(True)
            query = q_field.get(frag)
            query_str = ""
            if query is not None:
                query_str = str(query)
            user_msg = None
            try:
                u_field = fc.getDeclaredField("searchingUserMessages")
                u_field.setAccessible(True)
                user_msg = u_field.get(frag)
            except Exception:
                pass
            try:
                mdc = frag.getMediaDataController()
                if mdc is not None:
                    mdc_cls = mdc.getClass()
                    from java.lang.reflect import Array as JArray
                    try:
                        er_field = mdc_cls.getDeclaredField("messagesSearchEndReached")
                        er_field.setAccessible(True)
                        er_arr = er_field.get(mdc)
                        if er_arr is not None:
                            n = JArray.getLength(er_arr)
                            for i in range(n):
                                JArray.setBoolean(er_arr, i, False)
                            slog(f"reset endReached: n={n}")
                    except Exception as e:
                        slog("reset endReached failed", e)
                    try:
                        srm_field = mdc_cls.getDeclaredField("searchResultMessages")
                        srm_field.setAccessible(True)
                        srm = srm_field.get(mdc)
                        if srm is not None:
                            sz_before = srm.size()
                            srm.clear()
                            sz_after = srm.size()
                            slog(f"cleared searchResultMessages: before={sz_before} after={sz_after} mdc={mdc.hashCode()}")
                    except Exception as e:
                        slog("clear searchResultMessages failed", e)
                    try:
                        lmd_field = mdc_cls.getDeclaredField("lastMergeDialogId")
                        lmd_field.setAccessible(True)
                        from java.lang import Long as JLong
                        lmd_field.setLong(mdc, JLong.valueOf(-999))
                        ld_field = mdc_cls.getDeclaredField("lastDialogId")
                        ld_field.setAccessible(True)
                        ld_field.setLong(mdc, JLong.valueOf(-999))
                        slog("reset lastMergeDialogId/lastDialogId")
                    except Exception as e:
                        slog("reset dialogIds failed", e)
            except Exception as e:
                slog("mdc reset failed", e)
            open_method = None
            for m in fc.getDeclaredMethods():
                if m.getName() != "openSearchWithText":
                    continue
                params = m.getParameterTypes()
                if len(params) != 1:
                    continue
                open_method = m
                break
            if open_method is None:
                slog("restart search: openSearchWithText not found")
                return
            open_method.setAccessible(True)
            from java.lang import String as JString
            open_method.invoke(frag, JString(query_str))
            slog(f"restart search: openSearchWithText invoked query='{query_str}' user={'yes' if user_msg is not None else 'no'}")
        except Exception as e:
            slog("restart search failed", e)




    def get_active_media_filter(self):
        try:
            idx = self._current_media_filter_idx
            if idx == 0:
                return None
            return MediaTypeFilter.create_filter(idx)
        except Exception as e:
            slog("get_active_media_filter failed", e)
            return None




    @staticmethod
    def compile_multi_patterns(query):
        try:
            enabled = True
            sep = "|"
            try:
                pl = plugin_instance
                if pl is not None:
                    enabled = bool(pl.get_setting("multi_enabled", True))
                    raw_sep = str(pl.get_setting("multi_separator", "|") or "").strip()
                    if raw_sep:
                        sep = raw_sep
            except Exception:
                pass
            if not enabled:
                return None
            if not sep or sep not in query:
                return None
            parts = [p.strip() for p in query.split(sep)]
            parts = [p for p in parts if p]
            if len(parts) < 2:
                return None
            compiled = []
            for p in parts:
                try:
                    compiled.append(re.compile(p, re.IGNORECASE))
                except Exception:
                    compiled.append(re.compile(re.escape(p), re.IGNORECASE))
            return compiled
        except Exception as e:
            slog("compile_multi_patterns failed", e)
            return None




    @staticmethod
    def patterns_plain(patterns):
        try:
            for p in patterns:
                s = re.sub(r"\\.", "", str(getattr(p, "pattern", "")))
                if re.search(r"[(){}\[\]|^$.*+?]", s):
                    return False
            return True
        except Exception:
            return False




    @staticmethod
    def msg_matches_patterns(msg, patterns):
        try:
            text = ""
            mo = getattr(msg, "messageOwner", None)
            if mo is not None:
                text = getattr(mo, "message", "") or ""
            if not text:
                try:
                    cap = msg.getCaption()
                    if cap:
                        text = str(cap)
                except Exception:
                    pass
            if not text:
                return False
            for pat in patterns:
                try:
                    if pat.search(text):
                        return True
                except Exception:
                    continue
            return False
        except Exception:
            return False




    def _ensure_global_filter_button(self, frag, retry=0):
        try:
            target = None
            target_kind = None
            try:
                fsf = _find_field_value(frag, "fragmentSearchField")
                if fsf is not None:
                    icons0 = _find_field_value(fsf, "additionalIconsLayout")
                    if icons0 is None:
                        sf0 = _find_field_value(fsf, "searchField")
                        if sf0 is not None:
                            icons0 = _find_field_value(sf0, "additionalIconsLayout")
                    if icons0 is not None:
                        target = fsf
                        target_kind = "fragmentSearchField"
            except Exception:
                target = None
            if target is None:
                ab = None
                try:
                    ab = frag.getActionBar()
                except Exception:
                    ab = None
                if ab is not None:
                    sc = _find_field_value(ab, "searchContainer")
                    if sc is not None:
                        target = sc
                        target_kind = "searchContainer"
            if target is None:
                sc = _find_field_value(frag, "searchContainer")
                if sc is not None:
                    target = sc
                    target_kind = "searchContainer"
            if target is None:
                try:
                    stf = _find_field_value(frag, "searchTabsAndFiltersLayout")
                    if stf is not None:
                        target = stf
                        target_kind = "searchTabsAndFiltersLayout"
                except Exception:
                    stf = None
            if target is None:
                if retry < 3:
                    plugin_ref = self




                    def _retry(f=frag, r=retry):
                        plugin_ref._ensure_global_filter_button(f, r + 1)




                    run_on_ui_thread(_retry, 200)
                else:
                    slog("global filter button: no target view found")
                return
            tag = target.getTag()
            if tag is not None and str(tag) == "search_plus_gfilter":
                return
            ctx = target.getContext()
            from android_utils import OnClickListener
            plugin = self
            try:
                self._g_filter_accent_color = frag.getThemedColor(Theme.key_windowBackgroundWhiteBlueText2)
            except Exception:
                self._g_filter_accent_color = -0xD19501
            try:
                self._g_filter_base_color = frag.getThemedColor(Theme.key_windowBackgroundWhiteGrayText2)
            except Exception:
                self._g_filter_base_color = -0x8A8A8B
            icon_w = AndroidUtilities.dp(24)
            icon_h = AndroidUtilities.dp(24)
            icons = None
            ref_lp = None
            try:
                icons = _find_field_value(target, "additionalIconsLayout")
            except Exception:
                icons = None
            if icons is None:
                try:
                    sf = _find_field_value(target, "searchField")
                    if sf is not None:
                        icons = _find_field_value(sf, "additionalIconsLayout")
                except Exception:
                    icons = None
            if icons is not None:
                try:
                    n = int(icons.getChildCount())
                    for ri in range(n - 1, -1, -1):
                        ref = icons.getChildAt(ri)
                        rlp = ref.getLayoutParams()
                        if rlp is not None and int(rlp.width) > 0 and int(rlp.height) > 0:
                            icon_w = int(rlp.width)
                            icon_h = int(rlp.height)
                            ref_lp = rlp
                            break
                except Exception:
                    pass
            icon_w += AndroidUtilities.dp(4)
            icon_h += AndroidUtilities.dp(4)
            slog(f"global filter icons size={icon_w}x{icon_h}")
            specs = (
                ("person", ("msg_usersearch", "ic_ab_person", "msg_contact", "ic_user"), "person"),
                ("date", ("msg_calendar", "msg_calendar2", "ic_ab_calendar"), "date"),
                ("type", ("msg_tune", "tuning", "msg_settings", "ic_ab_settings", "msg_saved", "msg_filter"), "type"),
            )
            built = []
            for key, candidates, kind in specs:
                try:
                    res = MediaTypeSheet.resolve_icon(candidates)
                    if res == 0:
                        continue
                    iv = ImageView(ctx)
                    iv.setScaleType(ImageView.ScaleType.FIT_CENTER)
                    pad = max(0, int((icon_w - AndroidUtilities.dp(24)) // 2))
                    iv.setPadding(pad, pad, pad, pad)
                    iv.setColorFilter(PorterDuffColorFilter(self._g_filter_base_color, PorterDuff.Mode.SRC_IN))
                    iv.setAlpha(0.7)
                    iv.setImageResource(res)
                    iv.setVisibility(8)
                    if kind == "person":
                        iv.setOnClickListener(OnClickListener(lambda v: GlobalPersonDialog(plugin).show()))
                    elif kind == "date":
                        iv.setOnClickListener(OnClickListener(lambda v: plugin._show_g_date_sheet()))
                    else:
                        iv.setOnClickListener(OnClickListener(lambda v: plugin._show_g_type_sheet()))
                    built.append((kind, iv))
                    slog(f"global filter icon {kind}: res={res}")
                except Exception as e:
                    slog(f"global filter icon {kind} build failed", e)
            injected = False
            if built and icons is not None:
                try:
                    for kind, iv in built:
                        lp = LinearLayout.LayoutParams(icon_w, icon_h)
                        g = 0
                        if ref_lp is not None:
                            try:
                                g = int(ref_lp.gravity)
                            except Exception:
                                g = 0
                        lp.gravity = g if g != 0 else 16
                        if ref_lp is not None:
                            try:
                                lp.rightMargin = int(ref_lp.rightMargin) + AndroidUtilities.dp(6)
                                lp.topMargin = int(ref_lp.topMargin)
                                lp.bottomMargin = int(ref_lp.bottomMargin)
                            except Exception:
                                pass
                        else:
                            lp.rightMargin = AndroidUtilities.dp(6)
                        lp.leftMargin = AndroidUtilities.dp(6)
                        icons.addView(iv, lp)
                    injected = True
                    slog(f"global filter icons injected into additionalIconsLayout count={len(built)} size={icon_w}x{icon_h}")
                except Exception as e:
                    slog("additionalIconsLayout inject failed", e)
            if not injected:
                btn = AnimatedTextView(ctx, True, True, True)
                btn.setText(JString("Фильтр \u25be"))
                btn.setTextSize(float(AndroidUtilities.dp(13)))
                btn.setGravity(21)
                btn.setTypeface(AndroidUtilities.bold())
                btn.setTextColor(self._g_filter_accent_color)
                pad = AndroidUtilities.dp(10)
                btn.setPadding(pad, 0, pad, 0)
                btn.setAlpha(0.6)
                btn.setOnClickListener(OnClickListener(lambda v: plugin.show_global_filter_sheet()))
                lp = LayoutHelper.createFrame(-2, -1, 21, 0, 0, AndroidUtilities.dp(48), 0)
                target.addView(btn, lp)
                slog(f"global filter button injected into {target_kind}")
                self._g_filter_button = btn
                self._g_person_btn = None
                self._g_date_btn = None
                self._g_type_btn = None
            else:
                self._g_filter_button = None
                self._g_person_btn = None
                self._g_date_btn = None
                self._g_type_btn = None
                for kind, iv in built:
                    if kind == "person":
                        self._g_person_btn = iv
                    elif kind == "date":
                        self._g_date_btn = iv
                    else:
                        self._g_type_btn = iv
            target.setTag(JString("search_plus_gfilter"))
            if target_kind == "fragmentSearchField" and injected and built:
                self._install_g_focus_toggle(target, built)
        except Exception as e:
            slog("ensure global filter button failed", e)




    def _install_g_focus_toggle(self, field, icons):
        try:
            et = _find_field_value(field, "editText")
            if et is None:
                slog("global filter focus toggle: editText not found")
                return
            fc_cls = jclass("android.view.View$OnFocusChangeListener")
            ivs = [iv for _, iv in icons]
            try:
                old = et.getOnFocusChangeListener()
            except Exception:
                old = None




            class _FocusL(dynamic_proxy(fc_cls)):
                def onFocusChange(self, v, has_focus):
                    try:
                        if old is not None:
                            old.onFocusChange(v, has_focus)
                    except Exception:
                        pass
                    try:
                        vis = 0 if bool(has_focus) else 8
                        for iv in ivs:
                            iv.setVisibility(vis)
                    except Exception:
                        pass




            listener = _FocusL()
            self._g_focus_listener = listener
            et.setOnFocusChangeListener(listener)
            try:
                if et.isFocused():
                    for iv in ivs:
                        iv.setVisibility(0)
            except Exception:
                pass
            slog("global filter focus toggle installed on editText")
        except Exception as e:
            slog("install focus toggle failed", e)




    def show_global_filter_sheet(self):
        try:
            if GlobalFilterSheet.show(self):
                return
            self._show_global_filter_alert()
        except Exception as e:
            slog("show_global_filter_sheet failed", e)




    def _show_global_filter_alert(self):
        try:
            frag = get_last_fragment()
