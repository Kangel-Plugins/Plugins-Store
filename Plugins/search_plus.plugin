            BulletinHelper.show_error("Не удалось открыть выбор типа")




    def _refresh_global_search(self):
        try:
            q = str(getattr(self, "_last_global_query", "") or "")
            if not q:
                return
            adapter = _resolve_g_search_adapter(self)
            if adapter is not None:
                try:
                    f = _find_field(adapter, "lastMessagesSearchString")
                    if f is not None:
                        f.set(adapter, None)
                    m = _find_method(adapter, "searchMessagesInternal", 2)
                    if m is not None:
                        m.invoke(adapter, JString(q), JInteger(0))
                    else:
                        m2 = _find_method(adapter, "searchMessagesInternal", 1)
                        if m2 is None:
                            raise Exception("searchMessagesInternal not found")
                        m2.invoke(adapter, JString(q))
                    slog(f"global: search refreshed (adapter) '{q}'")
                    return
                except Exception as e:
                    slog(f"refresh adapter call failed: {e}")
            try:
                da_cls = JClass.forName("org.telegram.ui.DialogsActivity")
            except Exception:
                da_cls = None
            frag = getattr(self, "_g_dialogs_fragment", None)
            ok = False
            if frag is not None and da_cls is not None:
                try:
                    ok = bool(da_cls.isInstance(frag))
                except Exception:
                    ok = False
            if not ok:
                frag = get_last_fragment()
                if frag is not None and da_cls is not None:
                    try:
                        ok = bool(da_cls.isInstance(frag))
                    except Exception:
                        ok = False
            if not ok:
                slog(f"refresh global search: no dialogs fragment q='{q}'")
                return
            fname = str(frag.getClass().getName())
            slog(f"refresh global search: q='{q}' frag={fname}")
            try:
                frag.search(q, True)
                slog(f"global: search refreshed (direct) '{q}'")
                return
            except Exception as e:
                slog(f"refresh direct call failed: {e}")
            m = None
            cls = frag.getClass()
            while cls is not None and m is None:
                try:
                    for mm in cls.getDeclaredMethods():
                        if mm.getName() == "search" and len(mm.getParameterTypes()) == 2:
                            m = mm
                            break
                except Exception:
                    pass
                cls = cls.getSuperclass()
            if m is None:
                slog("refresh global search: method not found")
                return
            m.setAccessible(True)
            m.invoke(frag, JString(q), JBoolean(True))
            slog(f"global: search refreshed (reflect) '{q}'")
        except Exception as e:
            slog("refresh global search failed", e)




    def _set_g_date(self, idx):
        try:
            idx = int(idx)
            if int(GLOBAL_DATE_PRESETS[idx][1]) == -1:
                self._show_custom_date_dialog()
                return
            self._g_date_preset_idx = idx
            self._g_date_from = 0
            self._g_date_to = 0
            name = GLOBAL_DATE_PRESETS[idx][0]
            self._update_g_button()
            BulletinHelper.show_info(f"Период: {name}")
            self._refresh_global_search()
        except Exception as e:
            slog("set g date failed", e)




    def _show_custom_date_dialog(self):
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if not ctx:
                from org.telegram.messenger import ApplicationLoader
                ctx = ApplicationLoader.applicationContext
            builder = AlertDialogBuilder(ctx)
            builder.set_title("Свой период (дд.мм.гггг)")
            pad = AndroidUtilities.dp(16)
            container = LinearLayout(ctx)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(pad, pad, pad, pad)
            et_from = EditText(ctx)
            et_from.setHint("С: 01.01.2024")
            et_to = EditText(ctx)
            et_to.setHint("По: 31.12.2024")
            container.addView(et_from, LayoutHelper.createLinear(-1, -2))
            container.addView(et_to, LayoutHelper.createLinear(-1, -2))
            builder.set_view(container)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())




            def on_positive(dialog, which):
                try:
                    from_ts = SearchPlusPlugin._parse_date_input(str(et_from.getText().toString()), False)
                    to_ts = SearchPlusPlugin._parse_date_input(str(et_to.getText().toString()), True)
                    if from_ts is None or to_ts is None:
                        BulletinHelper.show_error("Неверный формат даты")
                        return
                    if from_ts > to_ts:
                        BulletinHelper.show_error("Дата начала позже конца")
                        return
                    self._g_date_preset_idx = len(GLOBAL_DATE_PRESETS) - 1
                    self._g_date_from = int(from_ts)
                    self._g_date_to = int(to_ts)
                    self._update_g_button()
                    BulletinHelper.show_info("Период: свой")
                    self._refresh_global_search()
                    dialog.dismiss()
                except Exception as e:
                    slog("custom date apply failed", e)




            builder.set_positive_button("Применить", on_positive)
            builder.show()
            et_from.requestFocus()
        except Exception as e:
            slog("custom date dialog failed", e)




    @staticmethod
    def _parse_date_input(text, end_of_day):
        try:
            text = (text or "").strip()
            st = None
            for fmt in ("%d.%m.%Y", "%d.%m.%y", "%d/%m/%Y", "%d-%m-%Y"):
                try:
                    st = time.strptime(text, fmt)
                    break
                except Exception:
                    st = None
            if st is None:
                return None
            if end_of_day:
                return int(time.mktime((st.tm_year, st.tm_mon, st.tm_mday, 23, 59, 59, 0, 0, -1)))
            return int(time.mktime((st.tm_year, st.tm_mon, st.tm_mday, 0, 0, 0, 0, 0, -1)))
        except Exception as e:
            slog("parse date failed", e)
            return None




    def _set_g_type(self, idx):
        try:
            self._g_type_idx = int(idx)
            name = MediaTypeFilter.TYPES[int(idx)][0]
            self._update_g_button()
            BulletinHelper.show_info(f"Тип: {name}")
            self._refresh_global_search()
        except Exception as e:
            slog("set g type failed", e)




    def _set_g_person_from_text(self, text):
        try:
            text = (text or "").strip()
            if not text:
                self._g_person_id = 0
                self._g_person_is_chat = False
                self._g_person_name = ""
                self._update_g_button()
                BulletinHelper.show_info("Фильтр по человеку сброшен")
                return
            parsed = InputParser.parse(text)
            if not parsed:
                BulletinHelper.show_error("Не распознано. Введите ID, телефон, @username или ссылку")
                return
            kind, value = parsed
            plugin = self




            def on_done(response, error):
                def run():
                    try:
                        if error or not response:
                            BulletinHelper.show_error("Не найдено")
                            return
                        obj = ResolveHelper.extract(response)
                        if obj is None:
                            BulletinHelper.show_error("Не найдено")
                            return
                        pid = int(getattr(obj, "id", 0))
                        if pid == 0:
                            BulletinHelper.show_error("Некорректный объект")
                            return
                        plugin._g_person_id = pid
                        plugin._g_person_is_chat = isinstance(obj, TLRPC.Chat)
                        try:
                            from org.telegram.messenger import UserObject
                            if isinstance(obj, TLRPC.User):
                                name = UserObject.getUserName(obj)
                            else:
                                name = getattr(obj, "title", "") or ""
                        except Exception:
                            name = ""
                        plugin._g_person_name = name or str(pid)
                        plugin._update_g_button()
                        BulletinHelper.show_info(f"Поиск по: {plugin._g_person_name}")
                        plugin._refresh_global_search()
                    except Exception as e:
                        slog("g person on_done failed", e)
                        BulletinHelper.show_error("Ошибка")
                run_on_ui_thread(run)




            ResolveHelper.resolve(kind, value, on_done)
        except Exception as e:
            slog("set g person failed", e)
            BulletinHelper.show_error("Ошибка")




    def _reset_g_filters(self):
        try:
            self._g_person_id = 0
            self._g_person_is_chat = False
            self._g_person_name = ""
            self._g_date_preset_idx = 0
            self._g_date_from = 0
            self._g_date_to = 0
            self._g_type_idx = 0
            self._update_g_button()
            BulletinHelper.show_info("Фильтры сброшены")
            self._refresh_global_search()
        except Exception as e:
            slog("reset g filters failed", e)




    def _reset_g_filters_silent(self):
        try:
            self._g_person_id = 0
            self._g_person_is_chat = False
            self._g_person_name = ""
            self._g_date_preset_idx = 0
            self._g_date_from = 0
            self._g_date_to = 0
            self._g_type_idx = 0
            self._g_seen_keys = set()
            self._g_page_anchor_date = 0
            self._g_last_anchor_key = None
            self._g_repeat_count = 0
            self._g_seen_query = ""
            self.global_extra_store = None
            self.global_extra_token = 0
            self._last_global_query = ""
            self._update_g_button()
            slog("global filters auto-reset")
        except Exception as e:
            slog("reset g filters silent failed", e)




    def _update_g_button(self):
        try:
            pairs = (
                (getattr(self, "_g_person_btn", None), int(self._g_person_id) != 0),
                (getattr(self, "_g_date_btn", None), int(self._g_date_preset_idx) > 0),
                (getattr(self, "_g_type_btn", None), int(self._g_type_idx) > 0),
            )
            for btn, active in pairs:
                if btn is None:
                    continue
                try:
                    color = self._g_filter_accent_color if active else self._g_filter_base_color
                    btn.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
                    btn.setAlpha(1.0 if active else 0.7)
                except Exception as e:
                    slog("update g icon failed", e)
            btn = getattr(self, "_g_filter_button", None)
            if btn is None:
                return
            active = int(self._g_person_id) != 0 or int(self._g_date_preset_idx) > 0 or int(self._g_type_idx) > 0
            if hasattr(btn, "setImageResource"):
                try:
                    color = self._g_filter_accent_color if active else self._g_filter_base_color
                    btn.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
                    btn.setAlpha(1.0 if active else 0.7)
                except Exception as e:
                    slog("update g icon failed", e)
                return
            label = "Фильтр •" if active else "Фильтр \u25be"
            btn.setText(JString(label))
        except Exception as e:
            slog("update g button failed", e)








class GFragmentDestroyHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def after_hooked_method(self, param):
        try:
            this = param.thisObject
            if this is None:
                return
            frag = getattr(self.plugin, "_g_dialogs_fragment", None)
            if frag is None:
                return
            same = False
            try:
                same = bool(this.equals(frag))
            except Exception:
                same = this == frag
            if not same:
                return
            self.plugin._g_dialogs_fragment = None
            self.plugin._reset_g_filters_silent()
        except Exception as e:
            slog("g fragment destroy failed", e)








class GlobalSearchHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def before_hooked_method(self, param):
        try:
            args = param.args
            query = None
            for a in args:
                if isinstance(a, str):
                    query = a
                    break
            if query is None:
                if args and all(isinstance(a, bool) for a in args):
                    self.plugin._reset_g_filters_silent()
                return
            if query == "":
                self.plugin._reset_g_filters_silent()
                return
            parsed = InputParser.parse_intent(query)
            if not parsed:
                return
            kind, value = parsed
            if kind == "id":
                return
            plugin = self.plugin
            def on_done(response, error):
                plugin._on_resolve_response(response, error)
            if kind == "phone":
                ResolveHelper.resolve_phone(value, on_done)
            elif kind == "username":
                ResolveHelper.resolve_username(value, on_done)
            slog(f"global search intercepted: {kind}={value}")
        except Exception as e:
            slog("GlobalSearchHook before failed", e)




    def after_hooked_method(self, param):
        try:
            this = param.thisObject
            if this is None:
                return
            try:
                self.plugin._g_dialogs_fragment = this
            except Exception:
                pass
            self.plugin._ensure_global_filter_button(this)
        except Exception as e:
            slog("GlobalSearchHook after failed", e)








class ChatSearchByIdHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def before_hooked_method(self, param):
        try:
            args = param.args
            query = None
            for a in args:
                if isinstance(a, str):
                    query = a
                    break
            if not query:
                return
            parsed = InputParser.parse_intent(query)
            if not parsed:
                return
            kind, value = parsed
            slog(f"chat search by id: {kind}={value}")
            this = param.thisObject
            if this is None:
                return
            plugin = self.plugin
            def on_done(response, error):
                try:
                    if error or not response:
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Не найдено"))
                        return
                    obj = ResolveHelper.extract(response)
                    if obj is None:
                        run_on_ui_thread(lambda: BulletinHelper.show_error("Не найдено"))
                        return
                    final_obj = obj
                    def open_in_chat():
                        try:
                            if isinstance(final_obj, TLRPC.User):
                                this.openSearchWithUser(final_obj)
                                slog("openSearchWithUser called")
                            elif isinstance(final_obj, TLRPC.Chat):
                                this.openSearchWithChat(final_obj)
                                slog("openSearchWithChat called")
                        except Exception as e:
                            slog("open_in_chat failed", e)
                    run_on_ui_thread(open_in_chat)
                except Exception as e:
                    slog("ChatSearchByIdHook on_done failed", e)
            if kind == "id":
                ResolveHelper.resolve_id(value, on_done)
            elif kind == "phone":
                ResolveHelper.resolve_phone(value, on_done)
            elif kind == "username":
                ResolveHelper.resolve_username(value, on_done)
            param.setResult(None)
        except Exception as e:
            slog("ChatSearchByIdHook before failed", e)








class InjectTypeButtonHook(MethodHook):
    TAG_KEY = "search_plus_type_btn"




    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def after_hooked_method(self, param):
        try:
            this = param.thisObject
            if this is None:
                return
            sc_field = this.getClass().getDeclaredField("searchContainer")
            sc_field.setAccessible(True)
            search_container = sc_field.get(this)
            if search_container is None:
                slog("searchContainer is null")
                return
            tag = search_container.getTag()
            if tag is not None and str(tag) == InjectTypeButtonHook.TAG_KEY:
                return
            ctx = search_container.getContext()
            from android_utils import OnClickListener
            btn = AnimatedTextView(ctx, True, True, True)
            btn.setText(JString("\u0422\u0438\u043f \u25be"))
            btn.setTextSize(float(AndroidUtilities.dp(13)))
            btn.setGravity(5)
            btn.setTypeface(AndroidUtilities.bold())
            try:
                color = this.getThemedColor(Theme.key_windowBackgroundWhiteBlueText2)
                btn.setTextColor(color)
            except Exception:
                btn.setTextColor(-0xD19501)
            pad = AndroidUtilities.dp(13)
            btn.setPadding(pad, 0, pad, 0)
            btn.setAlpha(0.5)
            btn.setClickable(False)
            plugin = self.plugin
            btn.setOnClickListener(OnClickListener(lambda v: plugin.show_media_type_picker()))
            init_margin = int(AndroidUtilities.dp(72))
            lp = LayoutHelper.createFrame(-2, -1, 21, 0, 0, init_margin, 0)
            search_container.addView(btn, lp)
            search_container.setTag(JString(InjectTypeButtonHook.TAG_KEY))
            plugin._type_button = btn
            try:
                exp_field = this.getClass().getDeclaredField("searchExpandList")
                exp_field.setAccessible(True)
                exp_btn = exp_field.get(this)
            except Exception:
                exp_btn = None
            try:
                sc_field2 = this.getClass().getDeclaredField("searchContainer")
                sc_field2.setAccessible(True)
                sc_obj = sc_field2.get(this)
            except Exception:
                sc_obj = None




            def reposition(b=btn, exp=exp_btn, sc=sc_obj):
                try:
                    if exp is None:
                        return
                    ex = int(exp.getX())
                    ew = int(exp.getWidth())
                    if ex <= 0 and ew <= 0:
                        return
                    sc_w = 0
                    if sc is not None:
                        try:
                            sc_w = int(sc.getWidth())
                        except Exception:
                            pass
                    if sc_w <= 0:
                        sc_w = int(AndroidUtilities.displaySize.x)
                    if ex > 0:
                        rm = sc_w - ex + int(AndroidUtilities.dp(8))
                    else:
                        rm = int(AndroidUtilities.dp(72))
                    if rm < 0:
                        rm = int(AndroidUtilities.dp(72))
                    blp = b.getLayoutParams()
                    blp_cls = blp.getClass()
                    rm_field = None
                    while blp_cls is not None:
                        try:
                            rm_field = blp_cls.getDeclaredField("rightMargin")
                            break
                        except Exception:
                            blp_cls = blp_cls.getSuperclass()
                    if rm_field is not None:
                        rm_field.setAccessible(True)
                        rm_field.setInt(blp, rm)
                        b.setLayoutParams(blp)
                        slog(f"type button repositioned rightMargin={rm}px (sc_w={sc_w} exp_x={ex} exp_w={ew})")
                except Exception as e:
                    slog("reposition failed", e)
            run_on_ui_thread(reposition, 300)
            run_on_ui_thread(reposition, 800)
            slog("type button injected (gravity 21, expandList-based rightMargin)")
        except Exception as e:
            slog("InjectTypeButtonHook after failed", e)








def _log_search_request(req):
    if not DEBUG:
        return
    try:
        c = req.getClass()




        def gi(n):
            try:
                f = c.getDeclaredField(n)
                f.setAccessible(True)
                return f.getInt(req)
            except Exception:
                return "?"




        def go(n):
            try:
                f = c.getDeclaredField(n)
                f.setAccessible(True)
                v = f.get(req)
                if v is None:
                    return "null"
                return v.getClass().getSimpleName()
            except Exception:
                return "?"




        slog(f"REQ offset_id={gi('offset_id')} add_offset={gi('add_offset')} limit={gi('limit')} max_id={gi('max_id')} min_id={gi('min_id')} from={go('from_id')} filter={go('filter')}")
    except Exception:
        pass








def _log_search_state(tag):
    if not DEBUG:
        return
    try:
        frag = get_last_fragment()
        if frag is None:
            return
        mdc = frag.getMediaDataController()
        if mdc is None:
            return
        mdc_cls = mdc.getClass()
        srm_f = mdc_cls.getDeclaredField("searchResultMessages")
        srm_f.setAccessible(True)
        srm = srm_f.get(mdc)
        loaded = srm.size() if srm is not None else -1
        total = _search_total_count(mdc, mdc_cls)
        end = _search_end_reached(mdc, mdc_cls)
        flags = []
        for name in ("loadingMoreSearchMessages", "loadingSearchMessages", "messagesSearchLoading"):
            try:
                f = mdc_cls.getDeclaredField(name)
                f.setAccessible(True)
                flags.append(f"{name}={f.getBoolean(mdc)}")
            except Exception:
                continue
        slog(f"STATE[{tag}] loaded={loaded} total={total} end={end} {' '.join(flags)}")
    except Exception as e:
        slog(f"STATE[{tag}] failed", e)








def _update_type_button_count(plugin, matched):
    try:
        btn = plugin._type_button
        if btn is None:
            return
        idx = int(plugin._current_media_filter_idx)
        if idx == 0:
            return
        name = MediaTypeFilter.TYPES[idx][0]
        btn.setText(JString(f"{name} {matched}+ ▾"))
    except Exception as e:
        slog("update type button count failed", e)








def _patch_pagination_anchor(plugin, req):
    off_f = req.getClass().getDeclaredField("offset_id")
    off_f.setAccessible(True)
    cur_off = int(off_f.getInt(req))
    anchor = int(plugin.client_filter_anchor_id)
    if cur_off == 0:
        plugin.client_filter_anchor_id = 0
        plugin.client_filter_autoload = 0
        plugin.client_extra_results = []
        plugin.client_extra_server_counts = {}
        plugin.client_extra_matched = 0
        plugin.client_extra_token = int(getattr(plugin, "client_extra_token", 0)) + 1
        plugin._extra_delegates = []
        slog("sendRequest: fresh search, anchor reset")
        return
    if anchor != 0 and anchor < cur_off:
        off_f.setInt(req, anchor)
        slog(f"sendRequest: offset_id {cur_off} -> anchor {anchor}")
    elif anchor != 0 and anchor > cur_off:
        plugin.client_filter_anchor_id = cur_off
        slog(f"sendRequest: client ahead ({cur_off} < anchor {anchor}), follow client")








class HighlightMultiHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self._pending_regions = None
        self._pending_blocks = None




    @staticmethod
    def _collect_regions(raw, patterns):
        cands = []
        seen = set()
        n = len(raw)
        for pat in patterns:
            try:
                m = pat.search(raw)
            except Exception:
                continue
            if m:
                s, e = int(m.start()), int(m.end())
                while s > 0 and raw[s - 1] not in PUNCT_CHARS:
                    s -= 1
                while e < n and raw[e] not in PUNCT_CHARS:
                    e += 1
                if (s, e) not in seen:
                    seen.add((s, e))
                    cands.append((s, e))
        for pat in patterns:
            pfx = str(getattr(pat, "pattern", ""))[:3]
            if len(pfx) < 2:
                continue
            try:
                rx = re.compile(re.escape(pfx), re.IGNORECASE)
            except Exception:
                continue
            for m in rx.finditer(raw):
                s = int(m.start())
                if s > 0 and raw[s - 1] not in PUNCT_CHARS:
                    continue
                e = s + len(pfx)
                while e < n and raw[e] not in PUNCT_CHARS:
                    e += 1
                if (s, e) in seen:
                    continue
                seen.add((s, e))
                cands.append((s, e))
        cands.sort()
        return cands




    @staticmethod
    def _get_source(cell, mo):
        cell_cls = cell.getClass()
        caption = None
        try:
            f = cell_cls.getDeclaredField("currentCaption")
            f.setAccessible(True)
            caption = f.get(cell)
        except Exception:
            caption = None
        if caption is None:
            cap = getattr(mo, "caption", None)
            if cap is not None and len(str(cap)) > 0:
                caption = cap
        if caption is not None:
            blocks = None
            try:
                f = cell_cls.getDeclaredField("captionLayout")
                f.setAccessible(True)
                cl = f.get(cell)
                if cl is not None:
                    blocks = cl.textLayoutBlocks
            except Exception:
                blocks = None
            if blocks is None:
                return None
            return str(caption).lower(), blocks
        owner = getattr(mo, "messageOwner", None)
        raw = (getattr(owner, "message", "") or "") if owner is not None else ""
        raw = str(raw).lower()
        if not raw:
            return None
        blocks = getattr(mo, "textLayoutBlocks", None)
        if blocks is None:
            return None
        return raw, blocks




    def before_hooked_method(self, param):
        try:
            self._pending_regions = None
            self._pending_blocks = None
            args = param.args
            if args is None or len(args) < 1:
                return
            if len(args) >= 4 and bool(args[1]):
                return
            text = args[0]
            if text is None:
                return
            patterns = getattr(self.plugin, "chat_highlight_patterns", None)
            if not patterns:
                return
            cell = param.thisObject
            if cell is None:
                return
            mo = None
            cell_cls = cell.getClass()
            for fname in ("messageObjectToSet", "currentMessageObject"):
                try:
                    f = cell_cls.getDeclaredField(fname)
                    f.setAccessible(True)
                    mo = f.get(cell)
                except Exception:
                    mo = None
                if mo is not None:
                    break
            if mo is None:
                return
            src = self._get_source(cell, mo)
            if src is None:
                return
            raw, blocks = src
            cands = self._collect_regions(raw, patterns)
            if not cands:
                return
            s0, e0 = cands[0]
            rest = cands[1:]
            self._pending_regions = rest
            self._pending_blocks = blocks
            from java.lang import String as _JString
            from java.lang import Integer as _JInteger
            from java.lang import Boolean as _JBoolean
            if raw[s0:e0] == str(text).lower():
                return
            if len(args) >= 4:
                param.args = [
                    _JString(raw[s0:e0]),
                    _JBoolean(bool(args[1])),
                    _JInteger(int(args[2])),
                    _JBoolean(bool(args[3])),
                ]
            else:
                param.args = [_JString(raw[s0:e0])]
        except Exception as e:
            slog("highlight multi hook failed", e)




    def after_hooked_method(self, param):
        regions = self._pending_regions
        blocks = self._pending_blocks
        self._pending_regions = None
        self._pending_blocks = None
        if not regions or blocks is None:
            return
        try:
            cell = param.thisObject
            if cell is None:
                return
            cell_cls = cell.getClass()
            try:
                om = cell_cls.getDeclaredMethod("obtainNewUrlPath")
                om.setAccessible(True)
            except Exception:
                return
            lsn = -1
            try:
                lf = _find_field(cell, "linkSelectionBlockNum")
                if lf is not None:
                    lsn = int(lf.getInt(cell))
            except Exception:
                lsn = -1
            if lsn < 0:
                return
            try:
                d = _find_field(cell, "highlightCaptionToSetStart")
                if d is not None and d.getInt(cell) != -1:
                    return
            except Exception:
                pass
            try:
                n = blocks.size()
            except Exception:
                n = len(blocks)
            added = 0
            for s, e in regions:
                cidx = -1
                for c in range(n):
                    b = blocks.get(c)
                    if s >= int(b.charactersOffset) and s < int(b.charactersEnd):
                        cidx = c
                        break
                if cidx < 0:
                    continue
                b = blocks.get(cidx)
                se = min(e, int(b.charactersEnd))
                if se <= s:
                    continue
                y = 0.0
                if cidx > lsn:
                    for c in range(lsn, cidx):
                        bb = blocks.get(c)
                        y += float(bb.height) + float(bb.padBottom)
                    y += float(b.padTop)
                elif cidx < lsn:
                    for c in range(cidx, lsn):
                        bb = blocks.get(c)
                        y -= float(bb.height) + float(bb.padBottom)
                    y -= float(b.padTop)
                try:
                    path = om.invoke(cell, [])
                    path.setUseCornerPathImplementation(True)
                    path.setCurrentLayout(b.textLayout, s, y)
                    b.textLayout.getSelectionPath(s, se, path)
                    path.closeRects()
                    added += 1
                except Exception as ex:
                    slog(f"highlight region {s}:{e} failed", ex)
            if added:
                try:
                    cell.invalidate()
                except Exception:
                    pass
                slog(f"highlight multi: extra regions={added}")
        except Exception as e:
            slog("highlight multi apply failed", e)




class SendRequestHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def _apply_global_filters(self, param, req):
        try:
            plugin = self.plugin
            try:
                from java.lang import System as JSystem
                rid = int(JSystem.identityHashCode(req))
            except Exception:
                rid = 0
            if rid != 0 and rid == int(getattr(plugin, "_last_global_req_id", 0) or 0):
                return
            if rid != 0:
                plugin._last_global_req_id = rid
            cls = req.getClass()
            _log_search_request(req)
            limit = 0
            try:
                lf = cls.getDeclaredField("limit")
                lf.setAccessible(True)
                limit = int(lf.getInt(req))
            except Exception:
                limit = 0
            patterns = None
            try:
                qf = cls.getDeclaredField("q")
                qf.setAccessible(True)
                q_val = qf.get(req)
                q_str = str(q_val) if q_val is not None else ""
                patterns = SearchPlusPlugin.compile_multi_patterns(q_str)
                plugin._last_global_query = q_str
                if patterns is not None and len(patterns) > 1:
                    plugin.global_extra_store = None
                if patterns is not None:
                    qf.set(req, patterns[0].pattern)
                    plugin.chat_highlight_patterns = None
                    plugin.global_preview_patterns = patterns
                    slog(f"global: multi q set to '{patterns[0].pattern}' ({len(patterns)} patterns)")
                else:
                    plugin.global_preview_patterns = None
            except Exception as e:
                slog("global q patch failed", e)
            try:
                off_f = cls.getDeclaredField("offset_id")
                off_f.setAccessible(True)
                off_id = int(off_f.getInt(req))
            except Exception:
                off_id = -1
            cur_q = str(getattr(plugin, "_last_global_query", "") or "")
            if off_id == 0 or cur_q != str(getattr(plugin, "_g_seen_query", "") or ""):
                plugin._g_seen_keys = set()
                plugin._g_last_anchor_key = None
                plugin._g_repeat_count = 0
                plugin._g_seen_query = cur_q
                slog("global: fresh search, dedupe state reset")
            didx = int(plugin._g_date_preset_idx)
            if didx > 0:
                try:
                    days = int(GLOBAL_DATE_PRESETS[didx][1])
                    lt = time.localtime()
                    midnight = int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))
                    if days == -1:
                        min_date = int(plugin._g_date_from)
                        max_date = int(plugin._g_date_to)
                    else:
                        min_date = midnight - (days - 1) * 86400
                        max_date = 0
                    mf = cls.getDeclaredField("min_date")
                    mf.setAccessible(True)
                    mf.setInt(req, min_date)
                    if max_date > 0:
                        xf = cls.getDeclaredField("max_date")
                        xf.setAccessible(True)
                        xf.setInt(req, max_date)
                    slog(f"global: min_date={min_date} max_date={max_date}")
                except Exception as e:
                    slog("global date failed", e)
            tidx = int(plugin._g_type_idx)
            if tidx > 0:
                try:
                    filt = MediaTypeFilter.create_filter(tidx)
                    if filt is not None:
                        ff = cls.getDeclaredField("filter")
                        ff.setAccessible(True)
                        ff.set(req, filt)
                        slog(f"global: filter={filt.getClass().getSimpleName()}")
                except Exception as e:
                    slog("global type failed", e)
            if patterns is not None and len(patterns) > 1:
                try:
                    try:
                        gflags = int(param.args[2]) if len(param.args) > 2 else 0
                    except Exception:
                        gflags = 0
                    _send_global_extra_requests(plugin, req, patterns, gflags)
                except Exception as e:
                    slog("global extras send failed", e)
            pid = int(plugin._g_person_id)
            if pid != 0 or patterns is not None:
                try:
                    orig = param.args[1]
                    if orig is not None:
                        plugin._g_search_adapter = _resolve_g_search_adapter(plugin)
                        if plugin._g_search_adapter is None:
                            slog("global: search adapter not resolved")
                        wrapped = _make_person_delegate(orig, plugin, limit)
                        if wrapped is not None:
                            param.args[1] = wrapped
                            plugin._extra_delegates.append(wrapped)
                            slog("global: response delegate wrapped")
                except Exception as e:
                    slog("global wrap failed", e)
        except Exception as e:
            slog("apply global filters failed", e)




    def before_hooked_method(self, param):
        try:
            if _SEND_HOOK_SUPPRESS:
                return
            args = param.args
            if args is None or len(args) < 1:
                return
            req = args[0]
            if req is None:
                return
            try:
                req_class_name = req.getClass().getName()
            except Exception:
                req_class_name = str(type(req))
            cls_lower = str(req_class_name).lower()
            if "searchglobal" in cls_lower:
                self._apply_global_filters(param, req)
                return
            if "messages_search" not in cls_lower:
                return
            try:
                from java.lang import System as JSystem
                rid = int(JSystem.identityHashCode(req))
            except Exception:
                rid = 0
            if rid != 0 and rid == int(getattr(self.plugin, "_last_chat_req_id", 0) or 0):
                return
            if rid != 0:
                self.plugin._last_chat_req_id = rid
            slog(f"sendRequest: req class={req_class_name}")
            _log_search_request(req)
            try:
                qf = req.getClass().getDeclaredField("q")
                qf.setAccessible(True)
                q_val = qf.get(req)
                q_str = str(q_val) if q_val is not None else ""
            except Exception:
                q_str = ""
            patterns = SearchPlusPlugin.compile_multi_patterns(q_str)
            if patterns is not None:
                self.plugin.client_filter_pending = True
                self.plugin.client_filter_type = None
                self.plugin.client_filter_patterns = patterns
                self.plugin.chat_highlight_patterns = patterns
                try:
                    first_q = patterns[0].pattern
                    qf2 = req.getClass().getDeclaredField("q")
                    qf2.setAccessible(True)
                    qf2.set(req, first_q)
                    slog(f"sendRequest: multi q set to first pattern '{first_q}'")
                except Exception as e:
                    slog("sendRequest: multi q set failed", e)
                try:
                    lmf = req.getClass().getDeclaredField("limit")
                    lmf.setAccessible(True)
                    lmf.setInt(req, 100)
                except Exception as e:
                    slog("sendRequest: multi limit failed", e)
                try:
                    _patch_pagination_anchor(self.plugin, req)
                except Exception as e:
                    slog("sendRequest: multi anchor failed", e)
                try:
                    extra_flags = int(args[2]) if len(args) > 2 else 0
                except Exception:
                    extra_flags = 0
                try:
                    _send_extra_pattern_requests(self.plugin, req, patterns, extra_flags)
                except Exception as e:
                    slog("sendRequest: extra requests failed", e)
                slog(f"sendRequest: multi-pattern mode, {len(patterns)} patterns")
                return
            self.plugin.client_filter_patterns = None
            self.plugin.chat_highlight_patterns = None
            self.plugin.client_extra_server_counts = {}
            active_filter = self.plugin.get_active_media_filter()
            if active_filter is None:
                slog("sendRequest: no active filter")
                return
            slog(f"sendRequest: active filter={active_filter.getClass().getName()}")
            try:
                fid = req.getClass().getDeclaredField("from_id")
                fid.setAccessible(True)
                from_id_val = fid.get(req)
            except Exception:
                from_id_val = None
            if from_id_val is not None:
                self.plugin.client_filter_pending = True
                self.plugin.client_filter_type = active_filter
                self.plugin.client_filter_patterns = None
                try:
                    lmf = req.getClass().getDeclaredField("limit")
                    lmf.setAccessible(True)
                    lmf.setInt(req, 100)
                except Exception as e:
                    slog("sendRequest: set limit failed", e)
                try:
                    _patch_pagination_anchor(self.plugin, req)
                except Exception as e:
                    slog("sendRequest: anchor patch failed", e)
                return
            try:
                f = req.getClass().getDeclaredField("filter")
                f.setAccessible(True)
                current_filter = f.get(req)
                slog(f"sendRequest: current filter={current_filter.getClass().getName() if current_filter else 'null'}")
                filter_replaced = False
                if current_filter is None:
                    f.set(req, active_filter)
                    filter_replaced = True
                    slog("sendRequest: set filter (was null)")
                else:
                    cur_name = current_filter.getClass().getName()
                    if "Empty" in cur_name or "empty" in cur_name:
                        f.set(req, active_filter)
                        filter_replaced = True
                        slog("sendRequest: replaced empty filter with active")
            except Exception as e:
                slog("sendRequest: filter replace failed", e)
        except Exception as e:
            slog("SendRequestHook before failed", e)








class PostNotificationHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        self._notif_id = None




    def _get_notif_id(self):
        if self._notif_id is not None:
            return self._notif_id
        try:
            nc_cls = JClass.forName("org.telegram.messenger.NotificationCenter")
            f = nc_cls.getDeclaredField("chatSearchResultsAvailable")
            f.setAccessible(True)
            self._notif_id = f.getInt(None)
        except Exception:
            self._notif_id = -1
        return self._notif_id




    def before_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 2:
                return
            notif_id = args[0]
            if notif_id is None:
                return
            try:
                nid = int(notif_id)
            except Exception:
                return
            target_id = self._get_notif_id()
            if nid != target_id:
                return
            _log_search_state("results")
            if self.plugin.client_filter_pending:
                obj_arr = args[1]
                try:
                    if getattr(self.plugin, "client_filter_patterns", None) is not None:
                        _merge_extra_results(self.plugin)
                except Exception as e:
                    slog("pre-filter extras merge failed", e)
                _do_client_filter(self.plugin, obj_arr)
            else:
                _unstick_user_search(self.plugin)
        except Exception as e:
            slog("PostNotificationHook before failed", e)
            self.plugin.client_filter_pending = False








def _inject_preview_highlight(plugin, mo):
    try:
        patterns = getattr(plugin, "chat_highlight_patterns", None) or getattr(plugin, "global_preview_patterns", None)
        if not patterns:
            return "no-patterns"
        owner = getattr(mo, "messageOwner", None)
        cap = getattr(mo, "caption", None)
        raw = ""
        if cap is not None and len(str(cap)) > 0:
            raw = str(cap)
        elif owner is not None:
            raw = getattr(owner, "message", "") or ""
        raw = str(raw).lower()
        if not raw:
            return "empty-raw"
        n = len(raw)
        words = []
        seen = set()
        for pat in patterns:
            try:
                m = pat.search(raw)
            except Exception:
                continue
            if m:
                s, e = int(m.start()), int(m.end())
                while s > 0 and raw[s - 1] not in PUNCT_CHARS:
                    s -= 1
                while e < n and raw[e] not in PUNCT_CHARS:
                    e += 1
                if (s, e) not in seen:
                    seen.add((s, e))
                    words.append(raw[s:e])
        for pat in patterns:
            pfx = str(getattr(pat, "pattern", ""))[:3]
            if len(pfx) < 2:
                continue
            try:
                rx = re.compile(re.escape(pfx), re.IGNORECASE)
            except Exception:
                continue
            for m in rx.finditer(raw):
                s = int(m.start())
                if s > 0 and raw[s - 1] not in PUNCT_CHARS:
                    continue
                e = s + len(pfx)
                while e < n and raw[e] not in PUNCT_CHARS:
                    e += 1
                if (s, e) in seen:
                    continue
                seen.add((s, e))
                words.append(raw[s:e])
        if not words:
            return "no-word"
        from java.util import ArrayList as _AL
        hw = getattr(mo, "highlightedWords", None)
        if hw is None:
            hw = _AL()
            mo.highlightedWords = hw
        added = 0
        for w in words:
            already = False
            for i in range(hw.size()):
                try:
                    if str(hw.get(i)) == w:
                        already = True
                        break
                except Exception:
                    break
            if not already:
                hw.add(JString(w))
                added += 1
        mth = getattr(mo, "messageTrimmedToHighlight", None)
        if mth is None or len(str(mth)) == 0:
            text = raw.replace("\n", " ")
            tcut = 0
            while tcut < n and text[tcut] == " ":
                tcut += 1
            if 0 < tcut < n:
                text = text[tcut:]
            mo.messageTrimmedToHighlight = JString(text)
            mo.messageTrimmedToHighlightCut = True
        slog(f"trim: preview words added={added} total={hw.size()}")
        return "ok"
    except Exception as e:
        slog("inject preview highlight failed", e)
        return "error"








class TrimHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    @staticmethod
    def _strip_leading(cs):
        if cs is None:
            return None, 0
        try:
            s = str(cs)
            n = len(s)
            cut = 0
            while cut < n and s[cut] in " \t\n\r\u00a0\u200b\u2028\u2029":
                cut += 1
            if cut == 0 or cut >= n:
                return None, 0
            return cs.subSequence(cut, n), cut
        except UnicodeDecodeError:
            n = cs.length()
            cut = 0
            while cut < n:
                ch = cs.charAt(cut)
                c = ch if isinstance(ch, str) else chr(ch)
                if c not in " \t\n\r\u00a0\u200b\u2028\u2029":
                    break
                cut += 1
            if cut == 0 or cut >= n:
                return None, 0
            return cs.subSequence(cut, n), cut




    def after_hooked_method(self, param):
        try:
            mo = param.thisObject
            if mo is None:
                return
            if not param.args:
                cap = getattr(mo, "caption", None)
                new_cap, cutc = self._strip_leading(cap)
                if new_cap is not None:
                    mo.caption = new_cap
                    slog(f"trim caption: stripped {cutc} leading chars")
                return
            cs = getattr(mo, "messageTrimmedToHighlight", None)
            new_cs, cut = self._strip_leading(cs)
            if new_cs is not None:
                mo.messageTrimmedToHighlight = new_cs
                slog(f"trim: stripped {cut} leading chars")
            _inject_preview_highlight(self.plugin, mo)
        except Exception as e:
            slog("trim hook failed", e)








class SearchCountHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def after_hooked_method(self, param):
        try:
            if getattr(self.plugin, "_count_hook_skip", False):
                return
            counts = getattr(self.plugin, "client_extra_server_counts", None)
            if not counts:
                return
            extra = sum(int(v) for v in counts.values())
            if extra <= 0:
                return
            base = int(param.getResult() or 0)
            total = base + extra
            param.setResult(JInteger(int(total)))
            slog(f"search count hook: base={base} extra={extra} total={total}")
        except Exception as e:
            slog("search count hook failed", e)








class SearchNavigationHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def before_hooked_method(self, param):
        try:
            search_up = bool(param.args[0])
            frag = param.thisObject
            if frag is None:
                return
            mdc = frag.getMediaDataController()
            if mdc is None:
                return
            patterns = getattr(self.plugin, "client_filter_patterns", None)
            if not patterns:
                return
            srm = mdc.searchResultMessages
            size = int(srm.size())
            if size == 0:
                return
            idx = int(mdc.getSearchPosition())
            if idx < 0 or idx >= size:
                return
            try:
                reversed_mode = bool(frag.reversed)
            except Exception:
                reversed_mode = False
            step = 1 if (search_up != reversed_mode) else -1
            nxt = idx + step
            if nxt < 0 or nxt >= size:
                return
            msg = srm.get(nxt)
            mid = _msg_id(msg)
            if mid == 0:
                return
            mdc.setSearchedPosition(nxt)
            frag.scrollToMessageId(mid, 0, True, 0, True, 0)
            try:
                ic = _prim_class("Integer")
                um = frag.getClass().getDeclaredMethod("updateSearchButtons", ic, ic, ic)
                um.setAccessible(True)
                um.invoke(frag, JInteger(int(mdc.getMask())), JInteger(nxt), JInteger(int(mdc.getSearchCount())))
            except Exception as e:
                slog("update search buttons failed", e)
            try:
                bc = _prim_class("Boolean")
                sm = frag.getClass().getDeclaredMethod("showMessagesSearchListView", bc)
                sm.setAccessible(True)
                sm.invoke(frag, JBoolean(False))
            except Exception:
                pass
            try:
                um = None
                for mm in frag.getClass().getDeclaredMethods():
                    if mm.getName() == "updateVisibleRows" and len(mm.getParameterTypes()) == 0:
                        um = mm
                        break
                if um is not None:
                    um.setAccessible(True)




                    def _reapply(f=frag, m=um):
                        try:
                            m.invoke(f)
                        except Exception:
                            pass




                    run_on_ui_thread(_reapply, 2600)
            except Exception:
                pass
            param.setResult(None)
            slog(f"search jump: index={nxt} id={mid} up={search_up}")
        except Exception as e:
            slog("search navigation hook failed", e)








def _is_user_filtered_search(frag):
    for name in ("searchingUserMessages", "searchingChatMessages"):
        try:
            f = frag.getClass().getDeclaredField(name)
            f.setAccessible(True)
            if f.get(frag) is not None:
                return True
        except Exception:
            continue
    return False








def _clear_end_reached(mdc, mdc_cls):
    try:
        from java.lang.reflect import Array as JArray
        f = mdc_cls.getDeclaredField("messagesSearchEndReached")
        f.setAccessible(True)
        arr = f.get(mdc)
        if arr is None:
            return False
        JArray.setBoolean(arr, 0, False)
        return True
    except Exception as e:
        slog("clear endReached failed", e)
        return False








def _unstick_user_search(plugin):
    try:
        frag = get_last_fragment()
        if frag is None:
            return
        if not _is_user_filtered_search(frag):
            plugin._unstick_chain = 0
            return
        mdc = frag.getMediaDataController()
        if mdc is None:
            return
        mdc_cls = mdc.getClass()
        srm_f = mdc_cls.getDeclaredField("searchResultMessages")
        srm_f.setAccessible(True)
        srm = srm_f.get(mdc)
        if srm is None:
            return
        loaded = srm.size()
        total = _search_total_count(mdc, mdc_cls)
        end = _search_end_reached(mdc, mdc_cls)
        if not end:
            plugin._unstick_chain = 0
            plugin._last_search_loaded = loaded
            return
        if loaded == 0 or total <= 0 or loaded >= total:
            plugin._unstick_chain = 0
            return
        if loaded <= plugin._last_search_loaded:
            slog(f"unstick: no progress loaded={loaded}, stop")
            plugin._unstick_chain = 0
            return
        if plugin._unstick_chain >= UNSTICK_MAX_CHAIN:
            plugin._unstick_chain = 0
            return
        plugin._last_search_loaded = loaded
        plugin._unstick_chain += 1
        _clear_end_reached(mdc, mdc_cls)
        _reset_load_flag(mdc, mdc_cls)
        slog(f"unstick: premature end cleared loaded={loaded} total={total} chain={plugin._unstick_chain}")
    except Exception as e:
        slog("unstick failed", e)








def _search_total_count(mdc, mdc_cls):
    try:
        from java.lang.reflect import Array as JArray
        f = mdc_cls.getDeclaredField("messagesSearchCount")
        f.setAccessible(True)
        arr = f.get(mdc)
        if arr is None:
            return 0
        n = JArray.getLength(arr)
        total = 0
        for i in range(n):
            total += int(JArray.getInt(arr, i))
        return total
    except Exception:
        return 0








def _reset_load_flag(mdc, mdc_cls):
    done = False
    for name in ("loadingMoreSearchMessages", "loadingSearchMessages", "messagesSearchLoading"):
        try:
            f = mdc_cls.getDeclaredField(name)
            f.setAccessible(True)
            if f.getBoolean(mdc):
                f.setBoolean(mdc, False)
                slog(f"unstick: {name}=False")
                done = True
        except Exception:
            continue
    return done








_MO_BOOL_METHODS = None




def _get_mo_bool_methods():
    global _MO_BOOL_METHODS
    if _MO_BOOL_METHODS is not None:
        return _MO_BOOL_METHODS
    _MO_BOOL_METHODS = {}
    try:
        mo_cls = JClass.forName("org.telegram.messenger.MessageObject")
        for m in mo_cls.getDeclaredMethods():
            name = m.getName()
            if name not in ("isPhoto", "isVideo", "isMusic", "isVoice", "isDocument", "isGif", "isSticker", "isRoundVideo"):
                continue
            params = m.getParameterTypes()
            if len(params) != 0:
                continue
            m.setAccessible(True)
            _MO_BOOL_METHODS[name] = m
    except Exception as e:
        slog("get_mo_bool_methods failed", e)
    return _MO_BOOL_METHODS




def _msg_matches_filter(msg, filter_type):
    try:
        methods = _get_mo_bool_methods()
        ft_name = filter_type.getClass().getName()
        def call(nm):
            mm = methods.get(nm)
            if mm is None:
                return False
            return bool(mm.invoke(msg, None))
        if "PhotoVideo" in ft_name:
            return call("isPhoto") or call("isVideo")
        if "Photos" in ft_name:
            return call("isPhoto")
        if "Video" in ft_name:
            return call("isVideo")
        if "Document" in ft_name:
            return call("isDocument")
        if "Music" in ft_name:
            return call("isMusic")
        if "RoundVoice" in ft_name:
            return call("isVoice") or call("isRoundVideo")
        if "Gif" in ft_name:
            return call("isGif")
        return False
    except Exception:
        return False




def _msg_id(msg):
    try:
        return int(msg.getId())
    except Exception:
        pass
    try:
        mo_cls = msg.getClass()
        for m in mo_cls.getMethods():
            if m.getName() == "getId" and len(m.getParameterTypes()) == 0:
                m.setAccessible(True)
                return int(m.invoke(msg, None))
    except Exception:
        pass
    try:
        owner = getattr(msg, "messageOwner", None)
        if owner is not None:
            return int(owner.id)
    except Exception:
        pass
    return 0








def _search_end_reached(mdc, mdc_cls):
    try:
        from java.lang.reflect import Array as JArray
        er_f = mdc_cls.getDeclaredField("messagesSearchEndReached")
        er_f.setAccessible(True)
        er_arr = er_f.get(mdc)
        if er_arr is None:
            return False
        return bool(JArray.getBoolean(er_arr, 0))
    except Exception as e:
        slog("client filter: endReached read failed", e)
        return False








def _load_more_search(mdc):
    try:
        mdc_cls = mdc.getClass()
        for m in mdc_cls.getDeclaredMethods():
            if m.getName() != "loadMoreSearchMessages":
                continue
            params = m.getParameterTypes()
            m.setAccessible(True)
            if len(params) == 0:
                m.invoke(mdc, None)
            elif len(params) == 1 and params[0].getName() == "boolean":
                from java.lang import Boolean as JBoolean
                m.invoke(mdc, JBoolean(False))
            else:
                continue
            slog("client filter: loadMoreSearchMessages invoked")
            return True
        slog("client filter: loadMoreSearchMessages not found")
    except Exception as e:
        slog("client filter: loadMore failed", e)
    return False








def _do_client_filter(plugin, obj_arr=None):
    try:
        if not plugin.client_filter_pending:
            return
        plugin.client_filter_pending = False
        frag = get_last_fragment()
        if frag is None:
            return
        mdc = frag.getMediaDataController()
        if mdc is None:
            return
        mdc_cls = mdc.getClass()
        srm_f = mdc_cls.getDeclaredField("searchResultMessages")
        srm_f.setAccessible(True)
        srm = srm_f.get(mdc)
        if srm is None:
            return
        size = srm.size()
        if size == 0:
            return
        patterns = getattr(plugin, "client_filter_patterns", None)
        filter_type = plugin.client_filter_type
        if filter_type is None and patterns is None:
            return
        tail_msg = srm.get(size - 1)
        tail_id = _msg_id(tail_msg)
        prev_anchor = int(plugin.client_filter_anchor_id)
        if tail_id != 0 and (prev_anchor == 0 or tail_id < prev_anchor):
            plugin.client_filter_anchor_id = tail_id
        plain = patterns is not None and SearchPlusPlugin.patterns_plain(patterns)
        removed = 0
        i = size - 1
        while i >= 0:
            msg = srm.get(i)
            if plain:
                keep = True
            elif patterns is not None:
                keep = SearchPlusPlugin.msg_matches_patterns(msg, patterns)
            else:
                keep = _msg_matches_filter(msg, filter_type)
            if not keep:
                srm.remove(i)
                removed += 1
            i -= 1
        remaining = srm.size()
        raw_total = _search_total_count(mdc, mdc_cls)
        end_reached = _search_end_reached(mdc, mdc_cls)
        if end_reached:
            if raw_total > size and _is_user_filtered_search(frag):
                _clear_end_reached(mdc, mdc_cls)
                _reset_load_flag(mdc, mdc_cls)
                end_reached = False
                slog(f"client filter: premature end cleared (page={size} total={raw_total})")
        plugin.client_filter_matched = remaining
        plugin.client_filter_scanned = size
        _update_type_button_count(plugin, remaining)
        if remaining == 0 and not end_reached:
            srm.add(tail_msg)
        slog(f"client filter: size={size} removed={removed} remaining={remaining} anchor={plugin.client_filter_anchor_id} end={end_reached}")
        try:
            adapter_f = frag.getClass().getDeclaredField("messagesSearchAdapter")
            adapter_f.setAccessible(True)
            adapter = adapter_f.get(frag)
            if adapter is not None:
                adapter.notifyDataSetChanged()
        except Exception as e:
            slog("client filter: adapter refresh failed", e)
        if end_reached:
            plugin.client_filter_autoload = 0
            return
        if remaining >= CLIENT_FILTER_MIN_RESULTS:
            plugin.client_filter_autoload = 0
            return
        if tail_id != 0 and tail_id == prev_anchor:
            slog("client filter: anchor did not advance, stop autoload")
            plugin.client_filter_autoload = 0
            return
        if plugin.client_filter_autoload >= CLIENT_FILTER_MAX_AUTOLOAD:
            slog("client filter: autoload limit reached")
            plugin.client_filter_autoload = 0
            return
        plugin.client_filter_autoload += 1
        slog(f"client filter: autoload {plugin.client_filter_autoload}")




        def _autoload():
            _load_more_search(mdc)




        run_on_ui_thread(_autoload, CLIENT_FILTER_AUTOLOAD_DELAY_MS)
    except Exception as e:
        slog("do_client_filter failed", e)
        plugin.client_filter_pending = False








class MentionsSearchHook(MethodHook):
    DEBOUNCE_MS = 300




    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def _get_field(self, obj, name):
        f = obj.getClass().getDeclaredField(name)
        f.setAccessible(True)
        return f.get(obj)




    def _invoke_direct(self, adapter, method_name, arg_types, args):
        cls = adapter.getClass()
        for m in cls.getDeclaredMethods():
            if m.getName() != method_name:
                continue
            params = m.getParameterTypes()
            if len(params) != len(arg_types):
                continue
            ok = True
            for i, t in enumerate(arg_types):
                if params[i].getName() != t:
                    ok = False
                    break
            if not ok:
                continue
            m.setAccessible(True)
            return m.invoke(adapter, *args)
        return None




    def before_hooked_method(self, param):
        try:
            this = param.thisObject
            if this is None:
                return
            args = param.args
            if args is None or len(args) < 1:
                return
            cs = args[0]
            if cs is None:
                return
            text = str(cs.toString()) if hasattr(cs, "toString") else str(cs)
            parsed = InputParser.parse_mention(text)
            if not parsed:
                return
            kind, value = parsed
            slog(f"mentions: matched '@{value}' kind={kind}")
            param.setResult(None)
            token = int(time.time() * 1000)
            self.plugin._mentions_debounce_token = token
            plugin = self.plugin
            adapter = this




            def run_delayed():
                try:
                    if plugin._mentions_debounce_token != token:
                        slog("mentions: stale token, abort")
                        return
                    slog(f"mentions: debounce fired, resolve kind={kind} value={value}")
                    self._resolve_and_inject(adapter, kind, value, text)
                except Exception as e:
                    slog("MentionsSearchHook run_delayed failed", e)




            run_on_ui_thread(run_delayed, MentionsSearchHook.DEBOUNCE_MS)
        except Exception as e:
            slog("MentionsSearchHook before failed", e)




    def _resolve_and_inject(self, adapter, kind, value, text):
        def on_done(response, error):
            try:
                slog(f"mentions: on_done response={response} error={error}")
                if error or not response:
                    slog(f"mentions: on_done abort error={error}")
                    return
                obj = ResolveHelper.extract(response)
                slog(f"mentions: on_done obj={obj} type={type(obj).__name__ if obj else 'null'}")
                if obj is None:
                    slog("mentions: on_done obj is null")
                    return
                slog("mentions: on_done -> inject_result")
                run_on_ui_thread(lambda: self._inject_result(adapter, obj))
            except Exception as e:
                slog("MentionsSearchHook on_done failed", e)




        if kind == "id":
            ResolveHelper.resolve_id(value, on_done)
        elif kind == "phone":
            ResolveHelper.resolve_phone(value, on_done)




    def _inject_result(self, adapter, obj):
        try:
            slog(f"mentions: _inject_result start obj={type(obj).__name__}")
            LongSparseArray = jclass("androidx.collection.LongSparseArray")
            result_list = ArrayList()
            result_map = LongSparseArray()
            slog("mentions: list+map created")
            if isinstance(obj, TLRPC.User):
                slog("mentions: calling addUserResult")
                self._invoke_direct(
                    adapter, "addUserResult",
                    ["java.util.ArrayList", "androidx.collection.LongSparseArray", "org.telegram.tgnet.TLRPC$User"],
                    [result_list, result_map, obj],
                )
            elif isinstance(obj, TLRPC.Chat):
                slog("mentions: calling addChatResult")
                self._invoke_direct(
                    adapter, "addChatResult",
                    ["java.util.ArrayList", "androidx.collection.LongSparseArray", "org.telegram.tgnet.TLRPC$Chat"],
                    [result_list, result_map, obj],
                )
            slog(f"mentions: list size after add={result_list.size()}")
            try:
                allow_bots = self._get_field(adapter, "allowBots")
                allow_chats = self._get_field(adapter, "allowChats")
                slog(f"mentions: allowBots={allow_bots} allowChats={allow_chats}")
            except Exception as e:
                slog("mentions: allowBots/allowChats get failed", e)
            slog("mentions: calling showUsersResult")
            self._invoke_direct(
                adapter, "showUsersResult",
                ["java.util.ArrayList", "androidx.collection.LongSparseArray", "boolean"],
                [result_list, result_map, True],
            )
            try:
                sru = self._get_field(adapter, "searchResultUsernames")
                slog(f"mentions: searchResultUsernames={sru} size={sru.size() if sru else 'null'}")
            except Exception as e:
                slog("mentions: searchResultUsernames get failed", e)
            slog(f"mentions: injected result for {type(obj).__name__}")
        except Exception as e:
            slog("MentionsSearchHook _inject_result failed", e)








class UsersBlockSearchHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def before_hooked_method(self, param):
        try:
            adapter = param.thisObject
            args = param.args
            if not args or len(args) < 1:
                return
            query = args[0]
            if not query or len(str(query).strip()) == 0:
                return
            query_str = str(query).strip()
            slog(f"UsersBlockSearch: query={query_str}")
            parsed = InputParser.parse_intent(query_str)
            if not parsed:
                return
            kind, value = parsed
            slog(f"UsersBlockSearch: parsed kind={kind} value={value}")
            param.setResult(None)
            self._resolve_and_update(adapter, kind, value)
        except Exception as e:
            slog("UsersBlockSearchHook before failed", e)




    def _resolve_and_update(self, adapter, kind, value):
        def on_done(response, error):
            try:
                slog(f"UsersBlockSearch: on_done response={response} error={error}")
                if error or not response:
                    slog(f"UsersBlockSearch: error={error}")
                    run_on_ui_thread(lambda: self._show_empty(adapter))
                    return
                obj = ResolveHelper.extract(response)
                slog(f"UsersBlockSearch: obj={obj} type={type(obj).__name__ if obj else 'null'}")
                if obj is None:
                    slog("UsersBlockSearch: obj null")
                    run_on_ui_thread(lambda: self._show_empty(adapter))
                    return
                run_on_ui_thread(lambda: self._update_results(adapter, obj))
            except Exception as e:
                slog("UsersBlockSearchHook on_done failed", e)




        ResolveHelper.resolve(kind, value, on_done)




    def _update_results(self, adapter, obj):
        try:
            slog("UsersBlockSearch: _update_results start")
            result_list = ArrayList()
            result_names = ArrayList()
            result_list.add(obj)
            try:
                from org.telegram.messenger import UserObject
                if isinstance(obj, TLRPC.User):
                    name = UserObject.getUserName(obj)
                elif isinstance(obj, TLRPC.Chat):
                    name = getattr(obj, "title", "") or ""
                else:
                    name = ""
                result_names.add(JString(name) if name else None)
            except Exception as e:
                slog("UsersBlockSearch: name build failed", e)
                result_names.add(None)
            slog(f"UsersBlockSearch: result_list size={result_list.size()}")
            try:
                cls = adapter.getClass()
                slog(f"UsersBlockSearch: adapter class={cls.getName()}")
                searching_field = None
                for f in cls.getDeclaredFields():
                    if f.getName() == "searching":
                        searching_field = f
                        break
                if searching_field:
                    searching_field.setAccessible(True)
                    searching_field.setBoolean(adapter, True)
                    slog("UsersBlockSearch: searching=true")
                upd_method = None
                for m in cls.getDeclaredMethods():
                    if m.getName() == "updateSearchResults":
                        params = m.getParameterTypes()
                        if len(params) == 2 and params[0].getName() == "java.util.ArrayList" and params[1].getName() == "java.util.ArrayList":
                            upd_method = m
                            break
                if upd_method:
                    upd_method.setAccessible(True)
                    upd_method.invoke(adapter, result_list, result_names)
                    slog("UsersBlockSearch: updateSearchResults called")
                else:
                    slog("UsersBlockSearch: updateSearchResults not found")
            except Exception as e:
                slog("UsersBlockSearch: invoke updateSearchResults failed", e)
        except Exception as e:
            slog("UsersBlockSearchHook _update_results failed", e)




    def _show_empty(self, adapter):
        try:
            slog("UsersBlockSearch: _show_empty")
            result_list = ArrayList()
            result_names = ArrayList()
            try:
                cls = adapter.getClass()
                searching_field = None
                for f in cls.getDeclaredFields():
                    if f.getName() == "searching":
                        searching_field = f
                        break
                if searching_field:
                    searching_field.setAccessible(True)
                    searching_field.setBoolean(adapter, True)
                upd_method = None
                for m in cls.getDeclaredMethods():
                    if m.getName() == "updateSearchResults":
                        params = m.getParameterTypes()
                        if len(params) == 2 and params[0].getName() == "java.util.ArrayList" and params[1].getName() == "java.util.ArrayList":
                            upd_method = m
                            break
                if upd_method:
                    upd_method.setAccessible(True)
                    upd_method.invoke(adapter, result_list, result_names)
                    slog("UsersBlockSearch: empty updateSearchResults called")
                else:
                    slog("UsersBlockSearch: updateSearchResults not found (empty)")
            except Exception as e:
                slog("UsersBlockSearch: invoke updateSearchResults (empty) failed", e)
        except Exception as e:
            slog("UsersBlockSearchHook _show_empty failed", e)








class ServerSearchHook(MethodHook):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin




    def _get_field(self, obj, name):
        f = obj.getClass().getDeclaredField(name)
        f.setAccessible(True)
        return f.get(obj)




    def _invoke_direct(self, helper, method_name, arg_types, args):
        cls = helper.getClass()
        for m in cls.getDeclaredMethods():
            if m.getName() != method_name:
                continue
            params = m.getParameterTypes()
            if len(params) != len(arg_types):
                continue
            ok = True
            for i, t in enumerate(arg_types):
                if params[i].getName() != t:
                    ok = False
                    break
            if not ok:
                continue
            m.setAccessible(True)
            return m.invoke(helper, *args)
        return None




    def before_hooked_method(self, param):
        try:
            helper = param.thisObject
            helper_cls_name = helper.getClass().getName()
            if "SearchAdapterHelper" not in helper_cls_name:
                return
            args = param.args
            if not args or len(args) < 1:
                return
            query = args[0]
            if not query or len(str(query).strip()) == 0:
                return
            query_str = str(query).strip()
            slog(f"ServerSearch: query={query_str}")
            parsed = InputParser.parse_intent(query_str)
            if not parsed:
                slog(f"ServerSearch: not parsed query={query_str}")
                return
            kind, value = parsed
            slog(f"ServerSearch: parsed kind={kind} value={value}")
            if kind == "id":
                try:
                    uid = int(value)
                except Exception:
                    return
                mc = get_messages_controller()
                user = mc.getUser(uid)
                if user and not isinstance(user, TLRPC.TL_userEmpty):
                    param.setResult(None)
                    self._resolve_and_inject(helper, kind, value)
                else:
                    slog(f"ServerSearch: id={uid} not in cache, letting original search proceed")
            else:
                param.setResult(None)
                self._resolve_and_inject(helper, kind, value)
        except Exception as e:
            slog("ServerSearchHook before failed", e)




    def _resolve_and_inject(self, helper, kind, value):
        def on_done(response, error):
            try:
                slog(f"ServerSearch: on_done response={response} error={error}")
                if error or not response:
                    slog(f"ServerSearch: error={error}")
                    return
                obj = ResolveHelper.extract(response)
                slog(f"ServerSearch: obj={obj} type={type(obj).__name__ if obj else 'null'}")
                if obj is None:
                    slog("ServerSearch: obj null")
                    return
                run_on_ui_thread(lambda: self._inject(helper, obj))
            except Exception as e:
                slog("ServerSearchHook on_done failed", e)




        ResolveHelper.resolve(kind, value, on_done)




    def _inject(self, helper, obj):
        try:
            slog(f"ServerSearch: _inject start obj={type(obj).__name__}")
            global_search = self._get_field(helper, "globalSearch")
            global_map = self._get_field(helper, "globalSearchMap")
            slog(f"ServerSearch: globalSearch={global_search} map={global_map}")
            if global_search is None or global_map is None:
                slog("ServerSearch: globalSearch or map is null")
                return
            from java.lang import Long as JLong
            from java.lang import Integer as JInteger
            obj_id = JLong.valueOf(0)
            if isinstance(obj, TLRPC.User):
                obj_id = JLong.valueOf(int(obj.id))
            elif isinstance(obj, TLRPC.Chat):
                obj_id = JLong.valueOf(int(obj.id))
            slog(f"ServerSearch: obj_id={obj_id}")
            self._invoke_direct(
                helper, "addUniqueObject",
                ["java.util.ArrayList", "androidx.collection.LongSparseArray", "org.telegram.tgnet.TLObject", "long"],
                [global_search, global_map, obj, obj_id],
            )
            slog(f"ServerSearch: addUniqueObject done, globalSearch size={global_search.size()}")
            delegate = self._get_field(helper, "delegate")
            slog(f"ServerSearch: delegate={delegate}")
            if delegate is not None:
                try:
                    from java.util import ArrayList as JArrayList
                    empty = JArrayList()
                    self._invoke_direct(
                        helper, "mergeResults",
                        ["java.util.ArrayList"],
                        [empty],
                    )
                    slog("ServerSearch: mergeResults(empty) called")
                except Exception as e:
                    slog("ServerSearch: mergeResults failed", e)
                try:
                    pending = self._get_field(helper, "pendingRequestIds")
                    if pending is not None:
                        pending.clear()
                        slog("ServerSearch: pendingRequestIds cleared")
                except Exception as e:
                    slog("ServerSearch: clear pending failed", e)
                try:
                    dcls = delegate.getClass()
                    adapter = None
                    for df in dcls.getDeclaredFields():
                        if df.getName() == "f$0":
                            df.setAccessible(True)
                            adapter = df.get(delegate)
                            break
                    slog(f"ServerSearch: adapter={adapter}")
                    if adapter is not None:
                        acls = adapter.getClass()
                        activity = None
                        for af in acls.getDeclaredFields():
                            if af.getName() == "this$0":
                                af.setAccessible(True)
                                activity = af.get(adapter)
                                break
                        slog(f"ServerSearch: activity={activity}")
                        if activity is not None:
                            act_cls = activity.getClass()
                            for sf in act_cls.getDeclaredFields():
                                if sf.getName() == "searching":
                                    sf.setAccessible(True)
                                    sf.setBoolean(activity, True)
                                    slog("ServerSearch: searching=true")
                                    break
                    for dm in dcls.getDeclaredMethods():
                        if dm.getName() != "onDataSetChanged":
                            continue
                        params = dm.getParameterTypes()
                        if len(params) != 1:
                            continue
                        if params[0].getName() != "int":
                            continue
                        dm.setAccessible(True)
                        dm.invoke(delegate, [JInteger(0)])
                        slog("ServerSearch: onDataSetChanged(0) called")
                        break
                    if adapter is not None:
                        acls2 = adapter.getClass()
                        for am in acls2.getDeclaredMethods():
                            if am.getName() != "notifyDataSetChanged":
                                continue
                            am.setAccessible(True)
                            am.invoke(adapter, [])
                            slog("ServerSearch: adapter.notifyDataSetChanged() called")
                            break
                except Exception as e:
                    slog("ServerSearch: onDataSetChanged failed", e)
        except Exception as e:
            slog("ServerSearchHook _inject failed", e)