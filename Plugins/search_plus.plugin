            if not ctx:
                from org.telegram.messenger import ApplicationLoader
                ctx = ApplicationLoader.applicationContext
            person_name = self._g_person_name if int(self._g_person_id) != 0 else "все"
            date_name = GLOBAL_DATE_PRESETS[int(self._g_date_preset_idx)][0]
            type_name = MediaTypeFilter.TYPES[int(self._g_type_idx)][0]
            names = [
                f"Человек: {person_name}",
                f"Период: {date_name}",
                f"Тип: {type_name}",
                "Сбросить фильтры",
            ]
            builder = AlertDialogBuilder(ctx)
            builder.set_title("Фильтры глобального поиска")
            plugin = self




            def on_item(dialog, which):
                try:
                    idx = int(which)
                    dialog.dismiss()
                    if idx == 0:
                        GlobalPersonDialog(plugin).show()
                    elif idx == 1:
                        plugin._show_g_date_sheet()
                    elif idx == 2:
                        plugin._show_g_type_sheet()
                    elif idx == 3:
                        plugin._reset_g_filters()
                except Exception as e:
                    slog("g filter on_click failed", e)




            builder.set_items(names, on_item)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            slog("_show_global_filter_alert failed", e)
            BulletinHelper.show_error("Ошибка фильтров")




