def to_color(hex_val):
    return int(hex_val - 0x100000000) if hex_val > 0x7FFFFFFF else hex_val


def get_theme_colors():
    is_dark = False
    try:
        is_dark = Theme.isCurrentThemeDark()
    except Exception:
        pass

    if is_dark:
        return {
            "primary": to_color(0xFFFFFFFF),
            "secondary": to_color(0xFFB0B0B0),
            "accent": to_color(0xFFA8C7FA),
            "track": to_color(0xFF333942),
            "hint": to_color(0xFF888888),
            "divider": to_color(0x33FFFFFF)
        }
    else:
        return {
            "primary": to_color(0xFF1F1F1F),
            "secondary": to_color(0xFF5E5E5E),
            "accent": to_color(0xFF0B57D0),
            "track": to_color(0xFFD3E3FD),
            "hint": to_color(0xFF888888),
            "divider": to_color(0x22000000)
        }


def create_md3_progress_drawable(track_color, indicator_color, radius_px):
    track = GradientDrawable()
    track.setShape(GradientDrawable.RECTANGLE)
    track.setCornerRadius(float(radius_px))
    track.setColor(track_color)

    fill = GradientDrawable()
    fill.setShape(GradientDrawable.RECTANGLE)
    fill.setCornerRadius(float(radius_px))
    fill.setColor(indicator_color)

    clip = ClipDrawable(fill, Gravity.START, ClipDrawable.HORIZONTAL)
    layers = LayerDrawable([track, clip])
    layers.setId(0, 0x01020000)
    layers.setId(1, 0x0102000d)
    return layers


def fmt_date(ts):
    if not ts:
        return "—"
    try:
        return datetime.fromtimestamp(ts).strftime("%d.%m.%Y")
    except Exception:
        return "—"


def count_words(text, counter):
    if not text:
        return
    words = re.findall(r"[а-яёa-z]{%d,}" % MIN_WORD_LEN, text.lower())
    for w in words:
        if w not in STOP_WORDS:
            counter[w] = counter.get(w, 0) + 1


def _lookup_chat_obj(controller, raw_chat_id):
    chat = None
    if raw_chat_id > 1000000000000:
        chat = controller.getChat(raw_chat_id - 1000000000000)
    elif raw_chat_id > 1000000000:
        chat = controller.getChat(raw_chat_id)
        if not chat:
            chat = controller.getChat(raw_chat_id - 1000000000)
    else:
        chat = controller.getChat(raw_chat_id)
    return chat


def detect_chat_mode(account, dialog_id):
    if dialog_id > 0:
        return "dialog"
    controller = MessagesController.getInstance(account)
    chat = _lookup_chat_obj(controller, -dialog_id)
    if chat and (ChatObject.isChannel(chat) and not chat.megagroup):
        return "channel"
    return "group"


def resolve_dialog_title(account, dialog_id):
    try:
        controller = MessagesController.getInstance(account)
        self_id = UserConfig.getInstance(account).getClientUserId()
        if dialog_id == self_id:
            return "Избранное"
        if dialog_id > 0:
            u = controller.getUser(int(dialog_id))
            if u:
                name = str(UserObject.getUserName(u) or "").strip()
                if name:
                    return name
        else:
            c = _lookup_chat_obj(controller, -int(dialog_id))
            if c and getattr(c, "title", None):
                return str(c.title).strip()
    except Exception:
        pass
    return f"Чат {dialog_id}"


def resolve_sender_name(account, sender_key, names_cache, self_id):
    if sender_key in names_cache:
        return names_cache[sender_key]
    try:
        controller = MessagesController.getInstance(account)
        if sender_key > 0:
            if sender_key == self_id:
                u = controller.getUser(int(self_id))
                nm = str(UserObject.getUserName(u) or "Вы").strip() if u else "Вы"
                res = f"{nm} (Вы)"
                names_cache[sender_key] = res
                return res
            u = controller.getUser(int(sender_key))
            if u:
                nm = str(UserObject.getUserName(u) or "").strip()
                if nm:
                    names_cache[sender_key] = nm
                    return nm
            return f"User {sender_key}"
        else:
            c = _lookup_chat_obj(controller, -int(sender_key))
            if c and getattr(c, "title", None):
                nm = str(c.title).strip()
                names_cache[sender_key] = nm
                return nm
            return f"Channel {abs(sender_key)}"
    except Exception:
        return f"ID {sender_key}"


def evaluate_chat_rank(state):
    mode = state["mode"]
    if mode == "channel":
        posts = state["total_posts"]
        r_total = state["reactions_total"]
        f_total = state["forwards_count"]
        score = min(65.0, (posts ** 0.5) * 3.0) + min(25.0, (r_total / max(1, posts)) * 2.5) + min(10.0, f_total * 0.5)
        idx = max(1, min(100, int(round(score))))
        return idx, CHAT_TITLES_100[idx - 1], "Стиль канала: вещание и сбор реакций"

    my = state["my_count"]
    their = state["their_count"]
    total = max(1, my + their)
    my_pct = (my / float(total)) * 100.0
    my_avg = (state["my_chars"] / float(my)) if my > 0 else 0.0
    caps_ratio = (state["my_caps_msgs"] / float(my)) if my > 0 else 0.0
    short_ratio = (state["my_short_msgs"] / float(my)) if my > 0 else 0.0
    voice_ratio = (state["my_voice_round"] / float(my)) if my > 0 else 0.0

    if my == 0:
        return 1, CHAT_TITLES_100[0], "0 сообщений (абсолютная тишина)"

    vol_pts = min(45.0, (my ** 0.5) * 1.65)
    share_pts = min(25.0, my_pct * 0.35)
    len_pts = min(20.0, my_avg * 0.28)
    react_pts = min(10.0, (state["reactions_total"] ** 0.4) * 1.2)
    penalty = (short_ratio * 8.0) if my_avg < 12 else 0.0
    bonus = min(5.0, voice_ratio * 12.0)

    raw_score = vol_pts + share_pts + len_pts + react_pts + bonus - penalty
    idx = max(1, min(100, int(round(raw_score))))

    traits = []
    if my_avg >= 90:
        traits.append("романист (длинные тексты)")
    elif my_avg <= 12:
        traits.append("краткий телеграфист")
    else:
        traits.append("сбалансированный слог")

    if caps_ratio >= 0.15:
        traits.append("любитель КАПСА ⚡")
    if voice_ratio >= 0.15:
        traits.append("фанат ГС/кружочков 🎙")
    if my_pct >= 65:
        traits.append("доминатор эфира 🔥")
    elif my_pct <= 20:
        traits.append("наблюдатель 👀")

    style_desc = ", ".join(traits) if traits else "классический собеседник"
    return idx, CHAT_TITLES_100[idx - 1], style_desc


def classify_media(msg):
    m = getattr(msg, "media", None)
    if not m or isinstance(m, (TLRPC.TL_messageMediaEmpty, TLRPC.TL_messageMediaWebPage)):
        return None

    if isinstance(m, TLRPC.TL_messageMediaPhoto):
        return "Фото"
    if isinstance(m, (TLRPC.TL_messageMediaGeo, TLRPC.TL_messageMediaGeoLive, TLRPC.TL_messageMediaVenue)):
        return "Геолокация"
    if isinstance(m, TLRPC.TL_messageMediaPoll):
        return "Опросы"
    if isinstance(m, TLRPC.TL_messageMediaContact):
        return "Контакты"

    if isinstance(m, TLRPC.TL_messageMediaDocument):
        doc = getattr(m, "document", None)
        if not doc:
            return "Файлы"

        is_sticker = False
        is_animated = False
        is_round = False
        is_video = False
        is_voice = False
        is_audio = False

        attrs = getattr(doc, "attributes", None)
        if attrs:
            for j in range(attrs.size()):
                attr = attrs.get(j)
                if isinstance(attr, (TLRPC.TL_documentAttributeSticker, TLRPC.TL_documentAttributeCustomEmoji)):
                    is_sticker = True
                elif isinstance(attr, TLRPC.TL_documentAttributeAnimated):
                    is_animated = True
                elif isinstance(attr, TLRPC.TL_documentAttributeVideo):
                    if getattr(attr, "round_message", False):
                        is_round = True
                    else:
                        is_video = True
                elif isinstance(attr, TLRPC.TL_documentAttributeAudio):
                    if getattr(attr, "voice", False):
                        is_voice = True
                    else:
                        is_audio = True

        mime = (getattr(doc, "mime_type", "") or "").lower()
        if not is_sticker and ("webp" in mime or "tgsticker" in mime):
            is_sticker = True

        if is_sticker:
            return "Стикеры"
        if is_round:
            return "Кружочки"
        if is_voice:
            return "Голосовые"
        if is_animated or "gif" in mime:
            return "GIF"
        if is_video:
            return "Видео"
        if is_audio:
            return "Аудио / Музыка"
        return "Файлы"

    return "Другое медиа"


def get_export_directory():
    try:
        dl_dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS)
        if dl_dir:
            path = dl_dir.getAbsolutePath()
            if os.path.isdir(path) and os.access(path, os.W_OK):
                return path
    except Exception:
        pass

    fallback = "/storage/emulated/0/Download"
    if os.path.isdir(fallback) and os.access(fallback, os.W_OK):
        return fallback

    try:
        act = LaunchActivity.instance
        if act:
            ext_files = act.getExternalFilesDir(None)
            if ext_files:
                return ext_files.getAbsolutePath()
    except Exception:
        pass

    return "/sdcard/Download"
class ChatStatsPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.is_processing = False
        self.cancelled = False
        self.progress_dialog = None
        self.progress_pct_tv = None
        self.progress_count_tv = None
        self.fact_tv = None
        self.progress_bar = None
        self._fact_timer = None
        self._start_time = 0
        self._facts_shuffled = []
        self._fact_index = 0

    def on_plugin_load(self):
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="Статистика чата",
            icon="msg_stats",
            on_click=self.on_menu_click
        ))

    def on_menu_click(self, param):
        if self.is_processing:
            BulletinHelper.show_error("Сканирование уже идёт...")
            return

        dialog_id = param.get("dialog_id")
        account = UserConfig.selectedAccount
        self_id = UserConfig.getInstance(account).getClientUserId()
        mode = detect_chat_mode(account, dialog_id)
        chat_title = resolve_dialog_title(account, dialog_id)

        def _show_setup_dialog():
            act = LaunchActivity.instance
            if not act:
                return

            colors = get_theme_colors()
            opts = [500, 1000, 5000, 10000, 0]
            labels = ["500", "1 000", "5 000", "10 000", "MAX (все)"]
            dp = AndroidUtilities.dp

            container = LinearLayout(act)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setPadding(dp(20), dp(12), dp(20), dp(4))

            sub_tv = TextView(act)
            sub_tv.setText(f"Чат: {chat_title}")
            sub_tv.setTextSize(13.0)
            sub_tv.setTypeface(None, Typeface.BOLD)
            sub_tv.setTextColor(colors["accent"])
            sub_tv.setPadding(0, 0, 0, dp(6))
            container.addView(sub_tv)

            hint_tv = TextView(act)
            hint_tv.setText("Сколько сообщений просканировать:")
            hint_tv.setTextSize(14.0)
            hint_tv.setTextColor(colors["primary"])
            hint_tv.setPadding(0, 0, 0, dp(8))
            container.addView(hint_tv)

            rg = RadioGroup(act)
            rg.setOrientation(LinearLayout.VERTICAL)
            for idx, lbl in enumerate(labels):
                rb = RadioButton(act)
                rb.setId(idx)
                rb.setText(lbl)
                rb.setTextSize(14.0)
                rb.setTextColor(colors["primary"])
                rg.addView(rb)
            rg.check(1)
            container.addView(rg)

            cust_lbl = TextView(act)
            cust_lbl.setText("Или укажи своё число:")
            cust_lbl.setTextSize(13.0)
            cust_lbl.setTextColor(colors["secondary"])
            cust_lbl.setPadding(0, dp(8), 0, dp(4))
            container.addView(cust_lbl)

            cust_edit = EditText(act)
            cust_edit.setHint("Например: 3000")
            cust_edit.setHintTextColor(colors["hint"])
            cust_edit.setTextSize(14.0)
            cust_edit.setTextColor(colors["primary"])
            cust_edit.setInputType(0x00000002)
            container.addView(cust_edit)

            def on_start(dlg, _w):
                dlg.dismiss()
                raw = cust_edit.getText().toString().strip()
                if raw:
                    try:
                        limit = max(0, int(raw))
                    except ValueError:
                        checked = rg.getCheckedRadioButtonId()
                        limit = opts[checked] if 0 <= checked < len(opts) else 1000
                else:
                    checked = rg.getCheckedRadioButtonId()
                    limit = opts[checked] if 0 <= checked < len(opts) else 1000

                self.is_processing = True
                self.cancelled = False
                self._start_time = datetime.now().timestamp()
                self._facts_shuffled = list(TELEGRAM_FACTS)
                random.shuffle(self._facts_shuffled)
                self._fact_index = 0

                state = {
                    "dialog_id": dialog_id,
                    "chat_title": chat_title,
                    "self_id": self_id,
                    "mode": mode,
                    "account": account,
                    "limit": limit,
                    "my_count": 0,
                    "their_count": 0,
                    "my_chars": 0,
                    "their_chars": 0,
                    "my_caps_msgs": 0,
                    "my_short_msgs": 0,
                    "my_voice_round": 0,
                    "total_posts": 0,
                    "word_counter": {},
                    "first_date": None,
                    "last_date": None,
                    "offset_id": 0,
                    "total_scanned": 0,
                    "day_counts": {},
                    "media_types": {},
                    "hours": [0] * 24,
                    "participant_counts": {},
                    "participant_chars": {},
                    "participant_names": {},
                    "forwards_count": 0,
                    "my_forwards": 0,
                    "reacted_msgs": 0,
                    "reactions_total": 0,
                    "reaction_emojis": {},
                }

                self._show_progress_ui(limit)
                self._fetch_chunk(state)

            b = AlertDialogBuilder(act)
            b.set_title("Chat Stats")
            b.set_view(container)
            b.set_positive_button("Старт", on_start)
            b.set_negative_button("Отмена", lambda dlg, _w: dlg.dismiss())
            b.show()

        run_on_ui_thread(_show_setup_dialog)

    def _show_progress_ui(self, limit):
        def _run():
            try:
                act = LaunchActivity.instance
                if not act:
                    return

                colors = get_theme_colors()
                dp = AndroidUtilities.dp

                container = LinearLayout(act)
                container.setOrientation(LinearLayout.VERTICAL)
                container.setPadding(dp(24), dp(16), dp(24), dp(12))

                top_row = LinearLayout(act)
                top_row.setOrientation(LinearLayout.HORIZONTAL)
                top_row.setGravity(Gravity.BOTTOM)

                self.progress_count_tv = TextView(act)
                self.progress_count_tv.setText("Прочитано: 0")
                self.progress_count_tv.setTextSize(17.0)
                self.progress_count_tv.setTypeface(None, Typeface.BOLD)
                self.progress_count_tv.setTextColor(colors["primary"])
                cnt_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
                self.progress_count_tv.setLayoutParams(cnt_lp)
                top_row.addView(self.progress_count_tv)

                self.progress_pct_tv = TextView(act)
                if limit == 0:
                    self.progress_pct_tv.setText("")
                else:
                    self.progress_pct_tv.setText("0%")
                    self.progress_pct_tv.setTextSize(22.0)
                    self.progress_pct_tv.setTypeface(None, Typeface.BOLD)
                    self.progress_pct_tv.setTextColor(colors["accent"])
                top_row.addView(self.progress_pct_tv)

                container.addView(top_row)

                if limit == 0:
                    self.progress_bar = ProgressBar(act, None, 0x01010077)
                    self.progress_bar.setIndeterminate(True)
                    pb_lp = LinearLayout.LayoutParams(dp(48), dp(48))
                    pb_lp.gravity = Gravity.CENTER_HORIZONTAL
                    pb_lp.topMargin = dp(12)
                    pb_lp.bottomMargin = dp(12)
                    self.progress_bar.setLayoutParams(pb_lp)
                else:
                    self.progress_bar = ProgressBar(act, None, 0x01010078)
                    self.progress_bar.setMax(1000)
                    self.progress_bar.setProgress(0)
                    md3_drawable = create_md3_progress_drawable(
                        colors["track"],
                        colors["accent"],
                        dp(8)
                    )
                    self.progress_bar.setProgressDrawable(md3_drawable)
                    pb_lp = LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        dp(14)
                    )
                    pb_lp.topMargin = dp(12)
                    pb_lp.bottomMargin = dp(12)
                    self.progress_bar.setLayoutParams(pb_lp)

                container.addView(self.progress_bar)

                self.fact_tv = TextView(act)
                self.fact_tv.setText("")
                self.fact_tv.setTextSize(12.0)
                self.fact_tv.setTextColor(colors["secondary"])
                self.fact_tv.setAlpha(0.5)
                self.fact_tv.setPadding(0, dp(12), 0, dp(4))
                container.addView(self.fact_tv)

                def on_stop_click(dlg, _w):
                    self.cancelled = True

                builder = AlertDialogBuilder(act)
                builder.set_title("Chat Stats")
                builder.set_view(container)
                builder.set_negative_button("Стоп", on_stop_click)
                self.progress_dialog = builder.show()

                self._schedule_fact_rotation()
            except Exception:
                pass
        run_on_ui_thread(_run)

    def _schedule_fact_rotation(self):
        if not self.is_processing or not self.progress_dialog:
            return

        def _rotate():
            if not self.is_processing or not self.progress_dialog:
                return
            elapsed = datetime.now().timestamp() - self._start_time
            if elapsed >= 5.0 and self.fact_tv:
                if self._facts_shuffled:
                    fact_text = self._facts_shuffled[self._fact_index % len(self._facts_shuffled)]
                    self._fact_index += 1
                    run_on_ui_thread(lambda: self.fact_tv.setText(fact_text))

            self._fact_timer = threading.Timer(3.0, self._rotate_fact_loop)
            self._fact_timer.start()

        _rotate()

    def _rotate_fact_loop(self):
        if self.is_processing and self.progress_dialog:
            self._schedule_fact_rotation()

    def _update_progress(self, scanned, limit=0):
        def _run():
            try:
                if self.progress_count_tv:
                    lim_str = str(limit) if limit else "MAX"
                    self.progress_count_tv.setText(f"Прочитано: {scanned} / {lim_str}")

                if self.progress_bar and limit > 0:
                    pct = min(100, int((scanned / float(limit)) * 100))
                    target_val = min(1000, int((scanned / float(limit)) * 1000))

                    if self.progress_pct_tv:
                        self.progress_pct_tv.setText(f"{pct}%")

                    try:
                        anim = ObjectAnimator.ofInt(
                            self.progress_bar,
                            "progress",
                            self.progress_bar.getProgress(),
                            target_val
                        )
                        anim.setDuration(260)
                        anim.setInterpolator(DecelerateInterpolator())
                        anim.start()
                    except Exception:
                        self.progress_bar.setProgress(target_val)
            except Exception:
                pass
        run_on_ui_thread(_run)

    def _hide_progress(self):
        def _run():
            if self._fact_timer:
                try:
                    self._fact_timer.cancel()
                except Exception:
                    pass
                self._fact_timer = None

            if self.progress_dialog:
                try:
                    self.progress_dialog.dismiss()
                except Exception:
                    pass
                self.progress_dialog = None

            self.progress_pct_tv = None
            self.progress_count_tv = None
            self.fact_tv = None
            self.progress_bar = None
        run_on_ui_thread(_run)

    def _fetch_chunk(self, state):
        if self.cancelled:
            self._finish(state)
            return

        limit = state["limit"]
        if limit and state["total_scanned"] >= limit:
            self._finish(state)
            return

        account = state["account"]
        controller = MessagesController.getInstance(account)

        remaining = (limit - state["total_scanned"]) if limit else 100
        batch_size = min(100, remaining) if limit else 100

        req = TLRPC.TL_messages_getHistory()
        req.peer = controller.getInputPeer(state["dialog_id"])
        req.offset_id = state["offset_id"]
        req.limit = batch_size
        req.add_offset = 0
        req.min_id = 0
        req.max_id = 0
        req.hash = 0

        def on_response(response, error):
            if self.cancelled:
                self._finish(state)
                return

            if error:
                err_text = getattr(error, "text", "Unknown error")
                if "FLOOD_WAIT" in err_text and state["total_scanned"] > 0:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Лимит запросов ({err_text}). Данные собраны."))
                    self._finish(state)
                else:
                    self.is_processing = False
                    self._hide_progress()
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка: {err_text}"))
                return

            # Кэшируем имена юзеров и чатов из пакета ответа
            try:
                if getattr(response, "users", None):
                    controller.putUsers(response.users, False)
                    for u_idx in range(response.users.size()):
                        u_obj = response.users.get(u_idx)
                        if u_obj and getattr(u_obj, "id", None):
                            uid = int(u_obj.id)
                            nm = str(UserObject.getUserName(u_obj) or "").strip()
                            if nm:
                                state["participant_names"][uid] = f"{nm} (Вы)" if uid == state["self_id"] else nm
                if getattr(response, "chats", None):
                    controller.putChats(response.chats, False)
                    for c_idx in range(response.chats.size()):
                        c_obj = response.chats.get(c_idx)
                        if c_obj and getattr(c_obj, "id", None) and getattr(c_obj, "title", None):
                            state["participant_names"][-int(c_obj.id)] = str(c_obj.title).strip()
            except Exception:
                pass

            messages = response.messages
            if messages.isEmpty():
                self._finish(state)
                return

            mode = state["mode"]
            scanned_in_batch = 0

            for i in range(messages.size()):
                if self.cancelled or (limit and state["total_scanned"] + scanned_in_batch >= limit):
                    break

                msg = messages.get(i)
                state["offset_id"] = msg.id
                scanned_in_batch += 1

                if getattr(msg, "action", None) is not None:
                    continue
                if not hasattr(msg, "message"):
                    continue

                if msg.date:
                    if state["last_date"] is None or msg.date > state["last_date"]:
                        state["last_date"] = msg.date
                    if state["first_date"] is None or msg.date < state["first_date"]:
                        state["first_date"] = msg.date

                    try:
                        dt_loc = datetime.fromtimestamp(msg.date)
                        day_key = dt_loc.strftime("%d.%m.%Y")
                        state["day_counts"][day_key] = state["day_counts"].get(day_key, 0) + 1
                        state["hours"][dt_loc.hour] += 1
                    except Exception:
                        pass

                # Подсчёт пересылок
                is_fwd = getattr(msg, "fwd_from", None) is not None
                if is_fwd:
                    state["forwards_count"] += 1

                # Подсчёт реакций
                reactions_obj = getattr(msg, "reactions", None)
                if reactions_obj and getattr(reactions_obj, "results", None):
                    res_list = reactions_obj.results
                    msg_react_sum = 0
                    for r_idx in range(res_list.size()):
                        r_cnt_obj = res_list.get(r_idx)
                        cnt_val = int(getattr(r_cnt_obj, "count", 0) or 0)
                        if cnt_val <= 0:
                            continue
                        msg_react_sum += cnt_val
                        r_type = getattr(r_cnt_obj, "reaction", None)
                        emo_str = "⭐"
                        if r_type:
                            if getattr(r_type, "emoticon", None):
                                emo_str = str(r_type.emoticon)
                            elif isinstance(r_type, TLRPC.TL_reactionCustomEmoji):
                                emo_str = "💎(Кастом)"
                        state["reaction_emojis"][emo_str] = state["reaction_emojis"].get(emo_str, 0) + cnt_val
                    if msg_react_sum > 0:
                        state["reacted_msgs"] += 1
                        state["reactions_total"] += msg_react_sum

                mtp = classify_media(msg)
                if mtp:
                    state["media_types"][mtp] = state["media_types"].get(mtp, 0) + 1

                txt = msg.message or ""

                if mode == "channel":
                    state["total_posts"] += 1
                    count_words(txt, state["word_counter"])
                else:
                    sender_id = None
                    from_peer = getattr(msg, "from_id", None)
                    if from_peer:
                        if isinstance(from_peer, TLRPC.TL_peerUser):
                            sender_id = int(from_peer.user_id)
                        elif isinstance(from_peer, TLRPC.TL_peerChannel):
                            sender_id = -int(from_peer.channel_id)
                        elif isinstance(from_peer, TLRPC.TL_peerChat):
                            sender_id = -int(from_peer.chat_id)

                    is_mine = (sender_id == state["self_id"]) or bool(getattr(msg, "out", False))
                    if is_mine and not sender_id:
                        sender_id = int(state["self_id"])
                    elif not is_mine and not sender_id and state["dialog_id"] > 0:
                        sender_id = int(state["dialog_id"])

                    if sender_id is not None:
                        state["participant_counts"][sender_id] = state["participant_counts"].get(sender_id, 0) + 1
                        state["participant_chars"][sender_id] = state["participant_chars"].get(sender_id, 0) + len(txt)

                    if is_mine:
                        state["my_count"] += 1
                        state["my_chars"] += len(txt)
                        if is_fwd:
                            state["my_forwards"] += 1
                        if mtp in ("Голосовые", "Кружочки"):
                            state["my_voice_round"] += 1
                        words_in_msg = txt.split()
                        if 0 < len(words_in_msg) <= 2:
                            state["my_short_msgs"] += 1
                        alpha_chars = [c for c in txt if c.isalpha()]
                        if len(alpha_chars) >= 5:
                            up_cnt = sum(1 for c in alpha_chars if c.isupper())
                            if (up_cnt / float(len(alpha_chars))) >= 0.7:
                                state["my_caps_msgs"] += 1
                    else:
                        state["their_count"] += 1
                        state["their_chars"] += len(txt)

                    count_words(txt, state["word_counter"])

            state["total_scanned"] += scanned_in_batch
            self._update_progress(state["total_scanned"], limit)

            if messages.size() < batch_size or (limit and state["total_scanned"] >= limit) or self.cancelled:
                self._finish(state)
            else:
                threading.Timer(0.15, self._fetch_chunk, args=[state]).start()

        send_request(req, on_response)

    def _finish(self, state):
        self.is_processing = False
        self._hide_progress()
        run_on_ui_thread(lambda: self._show_result(state))
    def _build_txt_content(self, lines, state):
        out = [
            "========================================",
            "       СТАТИСТИКА ЧАТА (exteraGram)     ",
            "========================================",
            f"Чат: {state['chat_title']}",
            f"ID диалога: {state['dialog_id']}",
            f"Дата выгрузки: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}",
            "----------------------------------------"
        ]
        for label, value, is_divider in lines:
            if is_divider:
                out.append("----------------------------------------")
            elif not value:
                out.append(f"\n[{label.upper()}]")
            else:
                out.append(f"{label}: {value}")
        out.append("========================================")
        return "\n".join(out)

    def _build_json_content(self, state, export_meta):
        top_50_words = [
            {"rank": idx, "word": w, "count": c}
            for idx, (w, c) in enumerate(
                sorted(state["word_counter"].items(), key=lambda x: x[1], reverse=True)[:50], 1
            )
        ]

        hourly_breakdown = {
            f"{h:02d}:00-{((h + 1) % 24):02d}:00": cnt
            for h, cnt in enumerate(state["hours"])
        }

        payload = {
            "plugin": {
                "id": __id__,
                "version": __version__,
                "exported_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            },
            "chat": {
                "title": state["chat_title"],
                "dialog_id": state["dialog_id"],
                "mode": state["mode"],
                "total_scanned": state["total_scanned"],
                "scan_limit": state["limit"] if state["limit"] else "MAX",
                "stopped_manually": self.cancelled
            },
            "user_rank": export_meta["rank_info"],
            "period": {
                "first_message_date": fmt_date(state["first_date"]),
                "last_message_date": fmt_date(state["last_date"]),
                "first_timestamp": state["first_date"],
                "last_timestamp": state["last_date"],
                "days_span": export_meta["days_span"],
                "active_days": export_meta["active_days"],
                "messages_per_day_avg": export_meta["per_day"]
            },
            "messages": export_meta["messages_block"],
            "top_participants": export_meta["top_participants"],
            "reactions_and_forwards": {
                "forwards_total": state["forwards_count"],
                "my_forwards": state["my_forwards"],
                "messages_with_reactions": state["reacted_msgs"],
                "reactions_total": state["reactions_total"],
                "top_reactions": export_meta["top_reactions"]
            },
            "activity_peaks": {
                "most_active_day": export_meta["best_day_obj"],
                "least_active_day": export_meta["worst_day_obj"],
                "peak_active_hour": export_meta["peak_active_str"],
                "peak_inactive_hour": export_meta["peak_inactive_str"],
                "hourly_distribution": hourly_breakdown
            },
            "media_attachments": dict(sorted(state["media_types"].items(), key=lambda x: -x[1])),
            "top_words": top_50_words
        }
        return json.dumps(payload, ensure_ascii=False, indent=2)

    def _build_html_content(self, state, export_meta):
        title_esc = html.escape(str(state["chat_title"]))
        rank_info = export_meta["rank_info"]
        rank_title_esc = html.escape(rank_info["title"])
        rank_style_esc = html.escape(rank_info["style"])
        rank_lvl = rank_info["level"]

        my_cnt = state["my_count"]
        their_cnt = state["their_count"]
        total_msg = max(1, state["total_posts"] if state["mode"] == "channel" else (my_cnt + their_cnt))
        my_pct = round(my_cnt / total_msg * 100, 1) if state["mode"] != "channel" else 100.0
        their_pct = round(100.0 - my_pct, 1)

        # Почасовой график (24 столбика)
        max_h = max(state["hours"]) if any(state["hours"]) else 1
        hours_bars_html = []
        for h, cnt in enumerate(state["hours"]):
            pct_h = max(4, int(round((cnt / float(max_h)) * 100))) if cnt > 0 else 2
            hours_bars_html.append(
                f'<div class="bar-col" title="{h:02d}:00 — {cnt}">'
                f'<div class="bar-val">{cnt if cnt > 0 else ""}</div>'
                f'<div class="bar-fill" style="height:{pct_h}%;"></div>'
                f'<div class="bar-lbl">{h:02d}</div></div>'
            )

        # Топ-5 участников
        part_rows = []
        palette = ["#A8C7FA", "#81C995", "#FDE293", "#F28B82", "#D7AEFB"]
        for idx, p in enumerate(export_meta["top_participants"]):
            color = palette[idx % len(palette)]
            p_name = html.escape(p["name"])
            part_rows.append(
                f'<div class="p-row"><div class="p-head"><span>#{p["rank"]} {p_name}</span>'
                f'<b>{p["count"]} ({p["percent"]}%) • ср. {p["avg_chars"]} симв.</b></div>'
                f'<div class="p-track"><div class="p-fill" style="width:{max(2, p["percent"])}%;background:{color};"></div></div></div>'
            )
        participants_html = "".join(part_rows) if part_rows else "<p class='muted'>Нет данных об участниках</p>"

        # Медиа
        mt_items = sorted(state["media_types"].items(), key=lambda x: -x[1])
        sum_media = max(1, sum(c for _, c in mt_items))
        media_rows = []
        for idx, (m_name, m_cnt) in enumerate(mt_items):
            m_pct = round(m_cnt / sum_media * 100, 1)
            color = palette[idx % len(palette)]
            media_rows.append(
                f'<div class="p-row"><div class="p-head"><span>{html.escape(m_name)}</span>'
                f'<b>{m_cnt} ({m_pct}%)</b></div>'
                f'<div class="p-track"><div class="p-fill" style="width:{max(2, m_pct)}%;background:{color};"></div></div></div>'
            )
        media_html = "".join(media_rows) if media_rows else "<p class='muted'>Медиафайлы не найдены</p>"

        # Реакции и слова
        react_chips = "".join(
            f'<span class="chip">{html.escape(r["emoji"])} <b>{r["count"]}</b></span>'
            for r in export_meta["top_reactions"]
        ) or "<span class='muted'>Реакций пока нет</span>"

        top_words_chips = "".join(
            f'<span class="chip">#{idx} {html.escape(w)} <b>{c}</b></span>'
            for idx, (w, c) in enumerate(sorted(state["word_counter"].items(), key=lambda x: -x[1])[:20], 1)
        ) or "<span class='muted'>Слов недостаточно</span>"

        return f"""<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Статистика — {title_esc}</title>
<style>
:root {{
  --bg: #0F141A; --card: #1A212B; --text: #E3E8EF; --muted: #8E9BAE;
  --accent: #A8C7FA; --green: #81C995; --warn: #FDE293; --border: rgba(255,255,255,0.08);
}}
* {{ box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }}
body {{ background: var(--bg); color: var(--text); padding: 20px; max-width: 920px; margin: 0 auto; line-height: 1.5; }}
.header {{ background: linear-gradient(135deg, #1E293B, #0F172A); border: 1px solid var(--border); border-radius: 20px; padding: 24px; margin-bottom: 18px; }}
.header h1 {{ font-size: 24px; margin-bottom: 6px; color: #FFF; }}
.header .sub {{ color: var(--muted); font-size: 13px; }}
.rank-box {{ background: linear-gradient(135deg, #1A2B4C, #241B35); border: 1px solid rgba(168,199,250,0.3); border-radius: 20px; padding: 20px; margin-bottom: 18px; }}
.rank-badge {{ display: inline-block; background: var(--accent); color: #081226; font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 99px; margin-bottom: 8px; }}
.rank-title {{ font-size: 20px; font-weight: 800; color: #FFF; margin-bottom: 4px; }}
.rank-style {{ font-size: 13px; color: var(--accent); margin-bottom: 10px; }}
.grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-bottom: 18px; }}
.stat-card {{ background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 16px; }}
.stat-card .lbl {{ font-size: 12px; color: var(--muted); margin-bottom: 4px; }}
.stat-card .val {{ font-size: 22px; font-weight: 800; color: var(--accent); }}
.section {{ background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 20px; margin-bottom: 18px; }}
.section h2 {{ font-size: 16px; margin-bottom: 14px; color: #FFF; }}
.donut-wrap {{ display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }}
.donut {{ width: 150px; height: 150px; border-radius: 50%; background: conic-gradient(var(--accent) 0% {my_pct}%, #364559 {my_pct}% 100%); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }}
.donut-hole {{ width: 102px; height: 102px; border-radius: 50%; background: var(--card); display: flex; flex-direction: column; align-items: center; justify-content: center; }}
.donut-hole b {{ font-size: 20px; color: #FFF; }}
.donut-hole span {{ font-size: 11px; color: var(--muted); }}
.legend p {{ margin-bottom: 8px; font-size: 14px; }}
.dot {{ display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; }}
.p-row {{ margin-bottom: 12px; }}
.p-head {{ display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; gap: 8px; }}
.p-track {{ width: 100%; height: 10px; background: #263040; border-radius: 99px; overflow: hidden; }}
.p-fill {{ height: 100%; border-radius: 99px; }}
.hours-chart {{ display: flex; align-items: flex-end; gap: 4px; height: 150px; padding-top: 20px; border-bottom: 1px solid var(--border); }}
.bar-col {{ flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }}
.bar-val {{ font-size: 9px; color: var(--muted); margin-bottom: 3px; }}
.bar-fill {{ width: 100%; max-width: 18px; background: linear-gradient(180deg, var(--accent), #3B82F6); border-radius: 4px 4px 0 0; }}
.bar-lbl {{ font-size: 10px; color: var(--muted); margin-top: 6px; }}
.chips {{ display: flex; flex-wrap: wrap; gap: 8px; }}
.chip {{ background: #252F3F; border: 1px solid var(--border); padding: 6px 12px; border-radius: 99px; font-size: 13px; }}
.chip b {{ color: var(--accent); margin-left: 4px; }}
.muted {{ color: var(--muted); font-size: 13px; }}
</style>
</head>
<body>
  <div class="header">
    <h1>📊 {title_esc}</h1>
    <div class="sub">ID: {state['dialog_id']} • Период: {fmt_date(state['first_date'])} — {fmt_date(state['last_date'])} ({export_meta['days_span']} дн., активных: {export_meta['active_days']}) • Сгенерировано в exteraGram</div>
  </div>

  <div class="rank-box">
    <span class="rank-badge">РАНГ {rank_lvl} ИЗ 100</span>
    <div class="rank-title">🏆 {rank_title_esc}</div>
    <div class="rank-style">Характеристика: {rank_style_esc}</div>
    <div class="p-track"><div class="p-fill" style="width:{rank_lvl}%;background:linear-gradient(90deg,#A8C7FA,#81C995);"></div></div>
  </div>

  <div class="grid">
    <div class="stat-card"><div class="lbl">Всего сообщений</div><div class="val">{total_msg}</div></div>
    <div class="stat-card"><div class="lbl">В среднем в день</div><div class="val">{export_meta['per_day']}</div></div>
    <div class="stat-card"><div class="lbl">Всего реакций</div><div class="val">{state['reactions_total']}</div></div>
    <div class="stat-card"><div class="lbl">Переслано (Fwd)</div><div class="val">{state['forwards_count']}</div></div>
  </div>

  <div class="section">
    <h2>🎯 Соотношение активности и Топ-5 участников</h2>
    <div class="donut-wrap" style="margin-bottom:20px;">
      <div class="donut"><div class="donut-hole"><b>{my_pct}%</b><span>Ваша доля</span></div></div>
      <div class="legend">
        <p><span class="dot" style="background:var(--accent);"></span><b>Вы:</b> {my_cnt} сообщ. ({my_pct}%)</p>
        <p><span class="dot" style="background:#364559;"></span><b>Остальные:</b> {their_cnt} сообщ. ({their_pct}%)</p>
        <p class="muted">Пик часа: {export_meta['peak_active_str'] or '—'}</p>
        <p class="muted">Рекорд дня: {export_meta['max_day_str'] or '—'}</p>
      </div>
    </div>
    {participants_html}
  </div>

  <div class="section">
    <h2>🕒 Активность по часам (00:00 — 23:00)</h2>
    <div class="hours-chart">{"".join(hours_bars_html)}</div>
  </div>

  <div class="section">
    <h2>❤️ Популярные реакции (на {state['reacted_msgs']} сообщ.)</h2>
    <div class="chips">{react_chips}</div>
  </div>

  <div class="section">
    <h2>📎 Медиа и вложения</h2>
    {media_html}
  </div>

  <div class="section">
    <h2>🔥 Топ-20 слов чата</h2>
    <div class="chips">{top_words_chips}</div>
  </div>
</body>
</html>"""
    def _send_text_to_saved(self, state, text_content):
        account = state["account"]
        self_id = int(state["self_id"])
        msg_text = text_content[:4090]

        def _send_via_tlrpc():
            req = TLRPC.TL_messages_sendMessage()
            req.peer = TLRPC.TL_inputPeerSelf()
            req.message = msg_text
            req.random_id = random.randint(1, 0x7FFFFFFF)

            def _on_sent(response, error):
                if error:
                    err_txt = getattr(error, "text", "Unknown error")
                    run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка отправки: {err_txt}"))
                else:
                    run_on_ui_thread(lambda: BulletinHelper.show_info("Отправлено в Избранное!"))

            send_request(req, _on_sent)

        def _try_helper():
            try:
                helper = SendMessagesHelper.getInstance(account)
                params = SendMessagesHelper.SendMessageParams.of(
                    msg_text, self_id, None, None, None, True, None, None, None, True, 0, None, False
                )
                helper.sendMessage(params)
                BulletinHelper.show_info("Отправлено в Избранное!")
            except Exception:
                _send_via_tlrpc()

        run_on_ui_thread(_try_helper)

    def _upload_and_send_doc_tlrpc(self, state, full_path, filename, mime_type, caption, fallback_text):
        try:
            with open(full_path, "rb") as f:
                raw_bytes = f.read()

            from org.telegram.tgnet import NativeByteBuffer
            file_id = random.randint(1, 0x7FFFFFFFFFFFFFFF)
            part_size = 131072
            total_parts = max(1, (len(raw_bytes) + part_size - 1) // part_size)

            def _upload_part(part_idx):
                start = part_idx * part_size
                chunk = raw_bytes[start:start + part_size]

                req_part = TLRPC.TL_upload_saveFilePart()
                req_part.file_id = file_id
                req_part.file_part = part_idx
                buf = NativeByteBuffer(len(chunk))
                buf.writeBytes(chunk)
                buf.rewind()
                req_part.bytes = buf

                def _on_part_done(resp, err):
                    if err:
                        self._send_text_to_saved(state, fallback_text)
                        return
                    if part_idx + 1 < total_parts:
                        _upload_part(part_idx + 1)
                    else:
                        _finalize_send()

                send_request(req_part, _on_part_done)

            def _finalize_send():
                input_file = TLRPC.TL_inputFile()
                input_file.id = file_id
                input_file.parts = total_parts
                input_file.name = filename
                input_file.md5_checksum = ""

                media = TLRPC.TL_inputMediaUploadedDocument()
                media.file = input_file
                media.mime_type = mime_type

                attr_fname = TLRPC.TL_documentAttributeFilename()
                attr_fname.file_name = filename
                media.attributes.add(attr_fname)

                req_media = TLRPC.TL_messages_sendMedia()
                req_media.peer = TLRPC.TL_inputPeerSelf()
                req_media.media = media
                req_media.message = caption
                req_media.random_id = random.randint(1, 0x7FFFFFFF)

                def _on_media_sent(resp, err):
                    if err:
                        self._send_text_to_saved(state, fallback_text)
                    else:
                        run_on_ui_thread(
                            lambda: BulletinHelper.show_info("Файл отправлен в Избранное!")
                        )

                send_request(req_media, _on_media_sent)

            _upload_part(0)
        except Exception:
            self._send_text_to_saved(state, fallback_text)

    def _send_file_to_saved(self, state, full_path, filename, mime_type, caption, fallback_text):
        account = state["account"]
        self_id = int(state["self_id"])

        def _run_send():
            sent = False
            helper = None
            try:
                helper = AccountInstance.getInstance(account).getSendMessagesHelper()
            except Exception:
                try:
                    helper = SendMessagesHelper.getInstance(account)
                except Exception:
                    helper = None

            for target in ([helper, SendMessagesHelper] if helper else [SendMessagesHelper]):
                if sent:
                    break
                for args in [
                    (full_path, full_path, None, caption, mime_type, self_id, None, None, None, None, None, True, 0, None, None, 0, False),
                    (account, full_path, full_path, None, caption, mime_type, self_id, None, None, None, None, None, True, 0, None, None, 0, False),
                    (full_path, full_path, None, caption, mime_type, self_id, None, None, None, None, None, True, 0),
                ]:
                    try:
                        target.prepareSendingDocument(*args)
                        sent = True
                        break
                    except Exception:
                        pass

            if sent:
                BulletinHelper.show_info("Файл отправлен в Избранное!")
            else:
                self._upload_and_send_doc_tlrpc(state, full_path, filename, mime_type, caption, fallback_text)

        run_on_ui_thread(_run_send)

    def _show_export_dialog(self, state, lines, export_meta):
        act = LaunchActivity.instance
        if not act:
            return

        colors = get_theme_colors()
        dp = AndroidUtilities.dp

        container = LinearLayout(act)
        container.setOrientation(LinearLayout.VERTICAL)
        container.setPadding(dp(20), dp(12), dp(20), dp(4))

        desc = TextView(act)
        desc.setText("Выбери формат и способ выгрузки:")
        desc.setTextSize(14.0)
        desc.setTextColor(colors["primary"])
        desc.setPadding(0, 0, 0, dp(8))
        container.addView(desc)

        rg = RadioGroup(act)
        rg.setOrientation(LinearLayout.VERTICAL)

        options = [
            "Сохранить HTML в Загрузки",
            "Сохранить в TXT в Загрузки",
            "Сохранить в JSON в Загрузки",
            "Отправить HTML в Избранное",
            "Отправить TXT в Избранное",
            "Отправить JSON в Избранное",
            "Отправить текстом в Избранное"
        ]
        for idx, title in enumerate(options):
            rb = RadioButton(act)
            rb.setId(idx)
            rb.setText(title)
            rb.setTextSize(13.5)
            rb.setTextColor(colors["primary"])
            rg.addView(rb)

        rg.check(0)
        container.addView(rg)

        path_hint = TextView(act)
        path_hint.setText("Файлы сохраняются в папку Download (Загрузки)")
        path_hint.setTextSize(12.0)
        path_hint.setTextColor(colors["secondary"])
        path_hint.setPadding(0, dp(10), 0, dp(4))
        container.addView(path_hint)

        def on_confirm_export(dlg, _w):
            choice = rg.getCheckedRadioButtonId()
            dlg.dismiss()

            ts_str = datetime.now().strftime("%Y%m%d_%H%M%S")
            chat_id_clean = abs(int(state["dialog_id"]))

            try:
                if choice == 6:
                    txt_data = self._build_txt_content(lines, state)
                    self._send_text_to_saved(state, txt_data)
                    return

                export_dir = get_export_directory()
                os.makedirs(export_dir, exist_ok=True)

                if choice in (0, 3):
                    filename = f"chat_stats_{chat_id_clean}_{ts_str}.html"
                    content = self._build_html_content(state, export_meta)
                    mime = "text/html"
                elif choice in (1, 4):
                    filename = f"chat_stats_{chat_id_clean}_{ts_str}.txt"
                    content = self._build_txt_content(lines, state)
                    mime = "text/plain"
                else:
                    filename = f"chat_stats_{chat_id_clean}_{ts_str}.json"
                    content = self._build_json_content(state, export_meta)
                    mime = "application/json"

                full_path = os.path.join(export_dir, filename)
                with open(full_path, "w", encoding="utf-8") as f:
                    f.write(content)

                if choice in (0, 1, 2):
                    BulletinHelper.show_info(f"Сохранено в Загрузки: {filename}")
                else:
                    caption = f"📊 Статистика: {state['chat_title']} (ID: {state['dialog_id']})"
                    fallback_msg = self._build_txt_content(lines, state)
                    self._send_file_to_saved(state, full_path, filename, mime, caption, fallback_msg)

            except Exception as e:
                BulletinHelper.show_error(f"Ошибка экспорта: {e}")

        b = AlertDialogBuilder(act)
        b.set_title("Экспорт статистики")
        b.set_view(container)
        b.set_positive_button("Выполнить", on_confirm_export)
        b.set_negative_button("Отмена", lambda dlg, _w: dlg.dismiss())
        b.show()

    def _show_result(self, state):
        act = LaunchActivity.instance
        if not act:
            return

        colors = get_theme_colors()
        mode = state["mode"]
        account = state["account"]
        self_id = state["self_id"]
        chat_title = resolve_dialog_title(account, state["dialog_id"])
        state["chat_title"] = chat_title

        top_words = sorted(state["word_counter"].items(), key=lambda x: x[1], reverse=True)[:10]
        first_ts = state["first_date"]
        last_ts = state["last_date"]

        days_span = 1
        if first_ts and last_ts and last_ts >= first_ts:
            days_span = max(1, int((last_ts - first_ts) // 86400) + 1)

        day_counts = state["day_counts"]
        active_days = len(day_counts)

        max_day_str = None
        min_day_str = None
        best_day_obj = None
        worst_day_obj = None
        if day_counts:
            best_day, best_cnt = max(day_counts.items(), key=lambda x: x[1])
            worst_day, worst_cnt = min(day_counts.items(), key=lambda x: x[1])
            unit = "постов" if mode == "channel" else "сообщ."
            max_day_str = f"{best_day} ({best_cnt} {unit})"
            min_day_str = f"{worst_day} ({worst_cnt} {unit})"
            best_day_obj = {"date": best_day, "count": best_cnt}
            worst_day_obj = {"date": worst_day, "count": worst_cnt}

        hours = state["hours"]
        peak_active_str = None
        peak_inactive_str = None
        if any(hours):
            max_hr_cnt = max(hours)
            peak_hr = hours.index(max_hr_cnt)
            peak_active_str = "%02d:00–%02d:00 (%d)" % (peak_hr, (peak_hr + 1) % 24, max_hr_cnt)

            min_hr_cnt = min(hours)
            quiet_hr = hours.index(min_hr_cnt)
            peak_inactive_str = "%02d:00–%02d:00 (%d)" % (quiet_hr, (quiet_hr + 1) % 24, min_hr_cnt)

        rank_lvl, rank_title, rank_style = evaluate_chat_rank(state)
        rank_info = {"level": rank_lvl, "title": rank_title, "style": rank_style}

        lines = []
        messages_block = {}
        top_participants_list = []

        lines.append(("Чат", chat_title, False))
        lines.append(("Ваш ранг", rank_title, False))
        lines.append(("Стиль общения", rank_style, False))
        lines.append(("", "", True))

        if mode == "channel":
            total = state["total_posts"]
            per_day = round(total / days_span, 1)
            lines.append(("Постов учтено", str(total), False))
            lines.append(("Первый пост", fmt_date(first_ts), False))
            lines.append(("Последний пост", fmt_date(last_ts), False))
            lines.append(("Период (дней)", str(days_span), False))
            lines.append(("Активных дней", str(active_days), False))
            lines.append(("В среднем в день", str(per_day), False))
            messages_block = {"total_posts": total}
        else:
            my = state["my_count"]
            their = state["their_count"]
            total = my + their
            my_pct = round(my / total * 100, 1) if total > 0 else 0.0
            their_pct = round(their / total * 100, 1) if total > 0 else 0.0
            per_day = round(total / days_span, 1)

            label_their = "Собеседник" if mode == "dialog" else "Остальные"
            my_avg = round(state["my_chars"] / my) if my else 0
            their_avg = round(state["their_chars"] / their) if their else 0

            lines.append(("Сообщений", str(total), False))
            lines.append(("Первое", fmt_date(first_ts), False))
            lines.append(("Последнее", fmt_date(last_ts), False))
            lines.append(("Период (дней)", str(days_span), False))
            lines.append(("Активных дней", str(active_days), False))
            lines.append(("Сообщений в день", str(per_day), False))
            lines.append(("", "", True))
            lines.append(("Я", f"{my} ({my_pct}%)", False))
            lines.append((label_their, f"{their} ({their_pct}%)", False))
            lines.append(("", "", True))

            if my > their:
                leader = f"Вы ({my_pct}% vs {their_pct}%)"
            elif their > my:
                leader = f"{label_their} ({their_pct}% vs {my_pct}%)"
            else:
                leader = "Поровну"
            lines.append(("Кто пишет больше", leader, False))
            lines.append(("Ср. длина (я)", f"{my_avg} симв.", False))
            lines.append((f"Ср. длина ({label_their.lower()})", f"{their_avg} симв.", False))

            messages_block = {
                "total": total,
                "my_messages": my,
                "my_percent": my_pct,
                "my_avg_length_chars": my_avg,
                "their_messages": their,
                "their_percent": their_pct,
                "their_avg_length_chars": their_avg,
                "leader": leader
            }

            # Топ-5 активных участников
            p_counts = state["participant_counts"]
            if p_counts:
                lines.append(("", "", True))
                lines.append(("Топ-5 участников чата", "", False))
                sorted_p = sorted(p_counts.items(), key=lambda x: x[1], reverse=True)[:5]
                for rank_idx, (pid, pcnt) in enumerate(sorted_p, 1):
                    pname = resolve_sender_name(account, pid, state["participant_names"], self_id)
                    ppct = round(pcnt / total * 100, 1) if total > 0 else 0.0
                    pavg = round(state["participant_chars"].get(pid, 0) / pcnt) if pcnt > 0 else 0
                    lines.append((f"{rank_idx}. {pname}", f"{pcnt} ({ppct}%)", False))
                    top_participants_list.append({
                        "rank": rank_idx,
                        "id": pid,
                        "name": pname,
                        "count": pcnt,
                        "percent": ppct,
                        "avg_chars": pavg
                    })

        # Блок реакций и пересылок
        top_reactions_list = [
            {"emoji": emo, "count": cnt}
            for emo, cnt in sorted(state["reaction_emojis"].items(), key=lambda x: -x[1])[:5]
        ]
        if state["forwards_count"] > 0 or state["reactions_total"] > 0:
            lines.append(("", "", True))
            lines.append(("Реакции и пересылки", "", False))
            lines.append(("Переслано сообщений", f"{state['forwards_count']} (моих: {state['my_forwards']})", False))
            lines.append(("Сообщений с реакциями", str(state["reacted_msgs"]), False))
            lines.append(("Всего реакций", str(state["reactions_total"]), False))
            if top_reactions_list:
                emo_summary = "  ".join(f"{r['emoji']} {r['count']}" for r in top_reactions_list)
                lines.append(("Топ реакций", emo_summary, False))

        if max_day_str or peak_active_str:
            lines.append(("", "", True))
            lines.append(("Особые дни и часы", "", False))
            if max_day_str:
                lines.append(("Макс. за день", max_day_str, False))
            if min_day_str:
                lines.append(("Мин. за день", min_day_str, False))
            if peak_active_str:
                lines.append(("Пик активности", peak_active_str, False))
            if peak_inactive_str:
                lines.append(("Пик неактивности", peak_inactive_str, False))

        mt = state["media_types"]
        if mt:
            lines.append(("", "", True))
            lines.append(("Медиа и вложения", "", False))
            for mtp, cnt in sorted(mt.items(), key=lambda x: -x[1]):
                lines.append((mtp, str(cnt), False))

        lines.append(("", "", True))
        lim = state["limit"]
        status_suffix = " (остановлено)" if self.cancelled else ""
        lines.append(("Просканировано", f"{state['total_scanned']} / {lim if lim else 'MAX'}{status_suffix}", False))

        if top_words:
            lines.append(("", "", True))
            lines.append(("Топ-10 слов", "", False))
            for rank, (word, cnt) in enumerate(top_words, 1):
                lines.append((f"{rank}. {word}", str(cnt), False))

        export_meta = {
            "days_span": days_span,
            "active_days": active_days,
            "per_day": per_day,
            "messages_block": messages_block,
            "best_day_obj": best_day_obj,
            "worst_day_obj": worst_day_obj,
            "max_day_str": max_day_str,
            "peak_active_str": peak_active_str,
            "peak_inactive_str": peak_inactive_str,
            "rank_info": rank_info,
            "top_participants": top_participants_list,
            "top_reactions": top_reactions_list
        }

        dp = AndroidUtilities.dp
        main = LinearLayout(act)
        main.setOrientation(LinearLayout.VERTICAL)
        scroll = ScrollView(act)
        scroll.setPadding(dp(20), dp(8), dp(20), dp(8))
        inner = LinearLayout(act)
        inner.setOrientation(LinearLayout.VERTICAL)

        for label, value, is_divider in lines:
            if is_divider:
                div = TextView(act)
                div.setHeight(dp(1))
                div.setBackgroundColor(colors["divider"])
                lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(1))
                lp.topMargin = dp(6)
                lp.bottomMargin = dp(6)
                div.setLayoutParams(lp)
                inner.addView(div)
                continue

            row = LinearLayout(act)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            lp_row = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
            lp_row.topMargin = dp(4)
            lp_row.bottomMargin = dp(4)
            row.setLayoutParams(lp_row)

            lbl = TextView(act)
            lbl.setText(label)
            lbl.setTextSize(14.0)
            lbl.setTextColor(colors["secondary"] if value else colors["primary"])
            if not value:
                lbl.setTypeface(None, Typeface.BOLD)
            lbl_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.0)
            lbl.setLayoutParams(lbl_lp)
            row.addView(lbl)

            if value:
                val = TextView(act)
                val.setText(value)
                val.setTextSize(14.0)
                val.setTextColor(colors["accent"] if label == "Ваш ранг" else colors["primary"])
                val.setTypeface(None, Typeface.BOLD)
                val.setGravity(Gravity.END)
                val_lp = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1.2)
                val.setLayoutParams(val_lp)
                row.addView(val)

            inner.addView(row)

        scroll.addView(inner)
        main.addView(scroll)

        builder = AlertDialogBuilder(act)
        builder.set_title(f"📊 {chat_title}")
        b_close = lambda b, w: b.dismiss()
        b_export = lambda b, w: self._show_export_dialog(state, lines, export_meta)
        builder.set_view(main)
        builder.set_positive_button("Закрыть", b_close)
        builder.set_neutral_button("Экспорт", b_export)
        builder.show()