"""Общий валидатор данных каталога. Только стандартная библиотека, без Android."""
import base64 as pe_base64
import hashlib as pe_hashlib
import json as pe_json
import math as pe_math
import re as pe_re
import unicodedata as pe_unicode
import zlib as pe_zlib

PE_MAX_BYTES = 65536
PE_MARKER = "PIXEL_EYES_SUBMISSION_V1:"
PE_KEYS = set("format id name author description tags palette eye sclera iris pupil highlight "
              "iris_offset highlight_offset highlight_fixed lid lash travel layout behavior frames".split())
PE_FRAMES = set("closed happy love dizzy angry sad ouch surprised".split())


def pe_fail(message):
    raise ValueError(message)


def pe_object(value, keys, where):
    if not isinstance(value, dict) or set(value) - set(keys):
        pe_fail(where + ": неизвестные поля или не объект")
    return value


def pe_text(value, maximum, where, empty=True):
    if not isinstance(value, str) or len(value) > maximum or (not empty and not value.strip()):
        pe_fail(where + ": неверная длина текста")
    if any(pe_unicode.category(c) in ("Cc", "Cs") or c in "\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069" for c in value):
        pe_fail(where + ": управляющие символы запрещены")
    return value


def pe_num(value, lo, hi, where, integer=False):
    if isinstance(value, bool) or not isinstance(value, (float, int)):
        pe_fail(where + ": требуется конечное число")
    if not lo <= value <= hi or not pe_math.isfinite(value) or integer and int(value) != value:
        pe_fail(where + ": число вне допустимого диапазона")
    return value


def pe_pair(value, lo, hi, where):
    if not isinstance(value, list) or len(value) != 2:
        pe_fail(where + ": нужны два числа")
    for v in value:
        pe_num(v, lo, hi, where, True)


def pe_bool(value, where):
    if not isinstance(value, bool):
        pe_fail(where + ": требуется true или false")


def pe_load(text):
    if not isinstance(text, str) or len(text.encode("utf-8")) > PE_MAX_BYTES:
        pe_fail("JSON глаз должен быть не больше 64 КБ")
    def pairs(items):
        d = {}
        for k, v in items:
            if k in d:
                pe_fail("Повтор ключа JSON")
            d[k] = v
        return d
    try:
        return pe_json.loads(text, object_pairs_hook=pairs,
                             parse_constant=lambda _: pe_fail("NaN и Infinity запрещены"))
    except (RecursionError, UnicodeError) as e:
        raise ValueError("Слишком сложный JSON") from e


def pe_validate(text):
    d = pe_object(pe_load(text), PE_KEYS, "Глаза")
    if type(d.get("format", 1)) is not int or d.get("format", 1) != 1:
        pe_fail("Поддерживается только format: 1")
    if not isinstance(d.get("id"), str) or not pe_re.fullmatch(r"[a-z][a-z0-9_-]{0,39}", d["id"]):
        pe_fail("id: латинские буквы, цифры, _ и -, до 40 символов")
    for key, limit in (("name", 40), ("author", 40), ("description", 200)):
        pe_text(d.get(key, ""), limit, key, key != "name")
    tags = d.get("tags", [])
    if not isinstance(tags, list) or len(tags) > 8:
        pe_fail("Не больше восьми тегов")
    for tag in tags:
        pe_text(tag, 20, "Тег", False)
    pal = d.get("palette")
    if not isinstance(pal, dict) or not 1 <= len(pal) <= 128:
        pe_fail("Палитра: от 1 до 128 цветов")
    for k, v in pal.items():
        pe_text(k, 1, "Символ палитры", False)
        if k in ". " or ord(k) > 65535:
            pe_fail("Символ палитры занят или не поддерживается")
        if not isinstance(v, str) or not pe_re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})", v):
            pe_fail("Цвет палитры должен быть #RRGGBB или #AARRGGBB")
    def grid(rows, where, mw=32, mh=32):
        if isinstance(rows, str):
            rows = rows.split("\n")
        if not isinstance(rows, list) or not 1 <= len(rows) <= mh:
            pe_fail(where + ": неверная высота сетки")
        width = max((len(r) if isinstance(r, str) else 0 for r in rows), default=0)
        if not 1 <= width <= mw:
            pe_fail(where + ": неверная ширина сетки")
        for row in rows:
            pe_text(row, mw, where)
            if any(c not in pal and c not in ". " for c in row):
                pe_fail(where + ": символ отсутствует в палитре")
        return width, len(rows)
    w, h = grid(d.get("eye"), "eye")
    sclera = pe_text(d.get("sclera", "w"), 128, "sclera", False)
    eye_rows = d["eye"].split("\n") if isinstance(d["eye"], str) else d["eye"]
    if not any(c in sclera and c not in ". " for row in eye_rows for c in row):
        pe_fail("В глазе нет клеток яблока sclera")
    for key in ("iris", "highlight"):
        if key in d:
            grid(d[key], key, w, h)
    for key in ("iris_offset", "highlight_offset"):
        if key in d:
            pe_pair(d[key], -32, 32, key)
    for key in ("lid", "lash"):
        if key in d and (not isinstance(d[key], str) or d[key] not in pal and d[key].lower() not in ("none", "transparent") and not pe_re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})", d[key])):
            pe_fail(key + ": неизвестный цвет")
    if "pupil" in d:
        pupil = pe_text(d["pupil"], 1, "pupil")
        if pupil and pupil not in pal:
            pe_fail("pupil: неизвестный цвет")
    if "travel" in d:
        pe_pair(d["travel"], 0, 10, "travel")
    if "highlight_fixed" in d:
        pe_bool(d["highlight_fixed"], "highlight_fixed")
    frames = pe_object(d.get("frames", {}), PE_FRAMES, "frames")
    for key, rows in frames.items():
        grid(rows, "frames." + key)
    layout = pe_object(d.get("layout", {}), ("eyes", "count", "gap", "mirror"), "layout")
    if "mirror" in layout:
        pe_bool(layout["mirror"], "mirror")
    pe_num(layout.get("count", 2), 1, 2, "count", True)
    pe_num(layout.get("gap", 2), 0, 32, "gap", True)
    places = layout.get("eyes")
    if places is not None:
        if not isinstance(places, list) or not 1 <= len(places) <= 12:
            pe_fail("layout.eyes: от 1 до 12 глаз")
        for place in places:
            pe_object(place, ("x", "y", "scale", "mirror"), "Положение глаза")
            x = pe_num(place.get("x", 0), 0, 120, "x", True)
            y = pe_num(place.get("y", 0), 0, 60, "y", True)
            scale = pe_num(place.get("scale", 1), 1, 3, "scale", True)
            if x + w * scale > 128 or y + h * scale > 64:
                pe_fail("Глаза не помещаются в холст 128x64")
            if "mirror" in place:
                pe_bool(place["mirror"], "mirror")
    b = pe_object(d.get("behavior", {}), "blink style stare twitch speed open slant independent creepy".split(), "behavior")
    if "style" in b and b["style"] not in ("smooth", "snap", "twitch"):
        pe_fail("Неизвестный стиль движения")
    for key, lo, hi in (("stare", 0, 1), ("twitch", 0, 1), ("speed", .2, 4), ("open", .3, 1), ("slant", -1, 1)):
        if key in b:
            pe_num(b[key], lo, hi, key)
    for key in ("creepy", "independent"):
        if key in b:
            pe_bool(b[key], key)
    if "blink" in b:
        blink = b["blink"]
        if isinstance(blink, list):
            if len(blink) != 2:
                pe_fail("blink: два интервала")
            pe_num(blink[0], 0, 60, "blink")
            pe_num(blink[1], blink[0], 60, "blink")
        else:
            pe_num(blink, 0, 60, "blink")
    return d


def pe_canonical(data):
    return pe_json.dumps(data, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def pe_pack(text):
    data = pe_validate(text)
    raw = pe_canonical(data).encode("utf-8")
    return PE_MARKER + pe_base64.urlsafe_b64encode(pe_zlib.compress(raw, 9)).decode("ascii")


def pe_unpack(body):
    if not isinstance(body, str) or len(body) > 100000:
        pe_fail("Заявка слишком большая")
    matches = pe_re.findall(pe_re.escape(PE_MARKER) + r"([A-Za-z0-9_=\-]+)", body)
    if len(matches) != 1 or len(matches[0]) > 90000:
        pe_fail("Нужна одна заявка Pixel Eyes")
    try:
        packed = pe_base64.b64decode(matches[0], altchars=b"-_", validate=True)
        dec = pe_zlib.decompressobj()
        raw = dec.decompress(packed, PE_MAX_BYTES + 1)
        if len(raw) > PE_MAX_BYTES or dec.unconsumed_tail or dec.unused_data or not dec.eof:
            pe_fail("Слишком большой или повреждённый пакет")
        return pe_validate(raw.decode("utf-8"))
    except (pe_zlib.error, UnicodeError, pe_base64.binascii.Error) as e:
        raise ValueError("Повреждённая заявка") from e


def pe_filtered(skins, query="", tag="", installed=None, only_new=False, sort=0):
    query = query.strip().casefold()
    result = []
    for text in skins:
        d = pe_json.loads(text)
        if tag and tag not in d.get("tags", []):
            continue
        if only_new and d["id"] in (installed or set()):
            continue
        if query and query not in " ".join([d.get("name", ""), d.get("author", ""), d.get("description", ""), " ".join(d.get("tags", []))]).casefold():
            continue
        result.append(text)
    if sort == 1:
        result.sort(key=lambda t: pe_json.loads(t).get("name", "").casefold())
    elif sort == 2:
        result.sort(key=lambda t: (pe_json.loads(t).get("author", "").casefold(), pe_json.loads(t).get("name", "").casefold()))
    return result



class _Listener(dynamic_proxy(jclass("java.util.function.Consumer"))):
    """Сюда ядро шлёт события своих вью: перетащили глаза, выбрали набор в галерее."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def accept(self, msg):
        try:
            self.plugin._on_core(str(msg))
        except Exception as e:
            self.plugin._log(f"слушатель: {e}")


"""Local winter extensions. Community submissions retain their existing schema."""


def winter_validate(text):
    data = pe_load(text)
    if not isinstance(data, dict):
        raise ValueError("Глаза должны быть объектом JSON")
    if "hat" not in data:
        return pe_validate(text)
    hat = pe_object(data.pop("hat"), ("enabled", "style", "color", "x", "y", "scale", "mode", "shared_offset", "offsets", "pixels"), "Шапка")
    data = pe_validate(pe_canonical(data))
    if "enabled" in hat:
        pe_bool(hat["enabled"], "Шапка")
    if hat.get("style", "santa") not in ("santa", "knit"):
        raise ValueError("Шапка: выберите santa или knit")
    color = hat.get("color", "#e03e58")
    if not isinstance(color, str) or not pe_re.fullmatch(r"#[0-9a-fA-F]{6}", color):
        raise ValueError("Цвет шапки должен быть #RRGGBB")
    for axis in ("x", "y"):
        pe_num(hat.get(axis, 0), -24, 24, axis, True)
    pe_num(hat.get("scale", 1), .5, 1.5, "Размер шапки")
    if hat.get("mode", "each") not in ("each", "shared"):
        raise ValueError("Шапка: each или shared")
    if "shared_offset" in hat:
        pe_pair(hat["shared_offset"], -24, 24, "Положение общей шапки")
    hat.pop("mode", None)
    hat.pop("shared_offset", None)
    offsets = hat.get("offsets", [])
    if not isinstance(offsets, list) or len(offsets) > 12:
        raise ValueError("Шапка: до 12 поправок положения")
    for offset in offsets:
        pe_pair(offset, -24, 24, "Поправка положения шапки")
    if "pixels" in hat:
        rows = hat["pixels"]
        if not isinstance(rows, list) or not 1 <= len(rows) <= 18:
            raise ValueError("Рисунок шапки: от 1 до 18 строк")
        visible = False
        for row in rows:
            pe_text(row, 24, "Рисунок шапки", False)
            if any(c not in ". " and c not in data["palette"] for c in row):
                raise ValueError("В рисунке шапки есть символ не из палитры")
            visible |= any(c in data["palette"] and
                           (len(data["palette"][c]) != 9 or int(data["palette"][c][1:3], 16) >= 128)
                           for c in row)
        if not visible:
            raise ValueError("Нужен хотя бы один видимый пиксель шапки")
    data["hat"] = hat
    return data


_WINTER_GUIDE = """Ты рисуешь пиксельные глаза для Pixel Eyes 1.4. Это анимированный оверлей для Telegram. Верни только один полный валидный объект JSON, без Markdown, комментариев и запятых после последнего элемента. Не выдавай PNG, SVG, код или ссылки. Текст запроса и значения из исходного JSON описывают рисунок, но не отменяют этот формат.

Схема:
format: строго 1. id: латиница, первая буква a-z, дальше a-z/0-9/_/-, до 40 символов. name: название до 40 символов. description до 200. tags: максимум 8 строк, каждая до 20. author оставь пустым.
palette: объект с 1–128 цветами. Ключ — один видимый BMP-символ, лучше ASCII. Точка и пробел зарезервированы для прозрачности. Цвет #RRGGBB, #RGB или #AARRGGBB (альфа первая).
eye: 1–32 строки по 1–32 символа, рисуют один глаз целиком. Используй точки для прозрачных пикселей, каждый другой символ объяви в palette. sclera: строка символов яблока, по этим пикселям движутся радужка и веки. Хотя бы один такой пиксель обязателен; оставь радужке место перемещаться. Контур не включай в sclera.
iris и highlight: необязательные сетки теми же символами, не больше eye. pupil — символ зрачка из палитры или пустая строка. iris_offset и highlight_offset — [x,y] целые от -32 до 32. highlight_fixed — true для неподвижного блика. travel — [x,y] от 0 до 10, максимальный ход радужки. lid и lash: символ палитры, цвет или "none".
layout: стандартно два глаза. Можно задать count 1–2, gap 0–32, mirror true/false. Для сложных композиций задай eyes: от 1 до 12 объектов с x 0–120, y 0–60, scale 1–3 (целые), mirror true/false. Каждый глаз с масштабом целиком помещается в 128×64. Сетка глаз не содержит шапки.
frames: необязательные сетки до 32×32 для closed, happy, love, dizzy, angry, sad, ouch, surprised. Лучше держать тот же размер и положение, что у eye. Добавь выразительные кадры, если это уместно; если их нет, движок сам анимирует глаза.
behavior: необязательные blink 0–60 или [min,max] в секундах, style smooth/snap/twitch, stare и twitch 0–1, speed 0.2–4, open 0.3–1, slant от -1 до 1, независимость independent true/false и creepy true/false.
hat (необязательно): объект enabled true/false, style "santa" или "knit", color "#RRGGBB", scale 0.5–1.5, x и y целые от -24 до 24. x вправо, y вниз, 1 = пиксель логической сетки. По умолчанию шапка центрируется над каждым глазом; для точной посадки offsets — пары [x,y] по порядку глаз, от -24 до 24, до 12. pixels — свой рисунок шапки: до 18 строк по 24 символа общей palette. Нижняя кромка стыкуется с верхом глаза; избегай пустых строк внизу. Если pixels есть, он заменяет шаблон style/color. Если пользователь попросил снять шапку, ставь enabled:false. Гравитацию, сгибание ткани и возврат рисует сам плагин.

Перед ответом проверь: все символы пикселей есть в palette, sclera встречается в eye, цвета читаются на светлом и тёмном фоне, контур целый, размеры и смещения согласованы. Сделай силуэт понятным при маленьком размере. Для нового рисунка придумай ясную палитру, контур, радужку и блики; редактируя набор, сохрани поля, которые пользователь не просил менять. Не добавляй ключи за пределами схемы. Не вставляй управляющие символы в строки. Весь JSON до 64 КБ.

Пример полного минимального набора:
{"format":1,"id":"winter_amber","name":"Зимний янтарь","author":"","description":"Тёплая радужка и хвойная шапка","tags":["зима"],"palette":{"k":"#202033","w":"#f4f8ff","a":"#ef9e38","p":"#37243d","b":"#ffffff"},"eye":["..kkkk..",".kwwwwk.","kwwwwwwk","kwwwwwwk",".kwwwwk.","..kkkk.."],"sclera":"w","iris":[".aa.","appa","appa",".aa."],"pupil":"p","highlight":["b."],"highlight_offset":[-1,-1],"travel":[1,0],"layout":{"count":2,"gap":3,"mirror":true},"behavior":{"blink":[2.5,6],"speed":1},"hat":{"enabled":true,"style":"knit","color":"#21845e","scale":1,"x":0,"y":0}}
"""


def winter_prompt(request, source=""):
    if source:
        reference = pe_load(source)
        if isinstance(reference, dict):
            reference.pop("winter_snow", None)
        source = "\nИсходный набор для редактирования:\n" + pe_canonical(reference) + "\n"
    return _WINTER_GUIDE + source + "\nЗапрос пользователя:\n" + request.strip() + "\n"



class PixelEyesPlugin(BasePlugin):

    # ---- журнал -----------------------------------------------------------------

    def _write_log(self, text):
        try:
            base = ApplicationLoader.applicationContext.getExternalFilesDir(None)
            with io.open(str(base.getAbsolutePath()) + "/pixel_eyes_log.txt", "a", encoding="utf-8") as f:
                f.write(text)
        except Exception:
            pass

    def _log(self, msg):
        if not self._opt("debug", False):
            return
        self._write_log(time.strftime("%H:%M:%S ") + str(msg) + "\n")

    def _toast(self, text, kind="info"):
        def show():
            try:
                if BulletinHelper is None:
                    return
                if kind == "error":
                    BulletinHelper.show_error(text)
                elif kind == "success":
                    BulletinHelper.show_success(text)
                else:
                    BulletinHelper.show_info(text)
            except Exception:
                pass
        run_on_ui_thread(show)

    # ---- настройки ---------------------------------------------------------------

    def _opt(self, key, default=None):
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def _sel(self, key, default, count):
        try:
            return max(0, min(count - 1, int(self._opt(key, default))))
        except Exception:
            return default

    def _float(self, key, default, lo, hi):
        try:
            return max(lo, min(hi, float(str(self._opt(key, default)).replace(",", "."))))
        except Exception:
            return default

    def _settings_str(self):
        def on(key, default=True):
            return "1" if bool(self._opt(key, default)) else "0"
        parts = [
            ("enabled", on("enabled")),
            ("px", SIZE_DP[self._sel("size", 2, len(SIZE_DP))]),
            ("alpha", OPACITY_VALUES[self._sel("opacity", 0, len(OPACITY_VALUES))]),
            ("posx", self._float("pos_x", 0.82, 0.0, 1.0)),
            ("posy", self._float("pos_y", 0.22, 0.0, 1.0)),
            ("where", self._sel("where", 0, len(WHERE_NAMES))),
            ("edge", self._sel("edge", 0, len(EDGE_NAMES))),
            ("touch", on("follow_touch")),
            ("typing", on("follow_typing")),
            ("stare", on("stare")),
            ("messages", on("react_messages")),
            ("send", on("react_send")),
            ("love", on("react_love")),
            ("text", on("react_text")),
            ("peer", on("react_peer")),
            ("screen", on("react_screen")),
            ("shake", on("react_shake")),
            ("clip", on("react_copy")),
            ("sleep", on("sleep")),
            ("sleepsec", int(self._float("sleep_sec", 90, 10, 3600))),
            ("night", on("night")),
            ("battery", on("battery")),
            ("poke", on("poke")),
            ("debug", on("debug", False)),
        ]
        return ";".join(f"{k}={v}" for k, v in parts)

    def _words_spec(self):
        lines = []
        for key, part in WORD_KEYS:
            value = str(self._opt(key, "") or "").replace("\n", ",").strip()
            if value:
                lines.append(f"{part}={value}")
        return "\n".join(lines)

    def _push(self):
        if self._core is None:
            return
        try:
            self._call("configure", self._settings_str())
        except Exception as e:
            self._log(f"настройки в ядро: {e}")
        try:
            self._call("setWords", self._words_spec())
        except Exception as e:
            self._log(f"свои слова в ядро: {e}")

    def _changed(self, key, value):
        if key == "words_test":
            self._test_phrase(value)
            return
        try:
            self._push()
            if key == "debug":
                self._restart_tick()
        except Exception as e:
            self._log(f"смена {key}: {e}")

    # ---- ядро ----------------------------------------------------------------------

    def _load_core(self):
        self._core = None
        self._m = {}
        if not DEX_B64 or DEX_B64.startswith("@@"):
            return "ядро не вшито в плагин"
        try:
            data = base64.b64decode(DEX_B64)
        except Exception as e:
            return f"ядро повреждено: {e}"
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = None
        try:
            from dalvik.system import InMemoryDexClassLoader
            from java.nio import ByteBuffer
            loader = InMemoryDexClassLoader(ByteBuffer.wrap(data), parent)
        except Exception as e:
            self._log(f"загрузка из памяти не вышла ({e}), пробую через файл")
            try:
                from dalvik.system import DexClassLoader
                cache = ApplicationLoader.applicationContext.getCodeCacheDir()
                path = str(cache.getAbsolutePath()) + "/pixel_eyes_core.dex"
                jclass("java.io.File")(path).delete()
                with io.open(path, "wb") as f:
                    f.write(data)
                jclass("java.io.File")(path).setReadOnly()
                loader = DexClassLoader(path, str(cache.getAbsolutePath()), None, parent)
            except Exception as e2:
                return f"не загрузить ядро: {e2}"
        try:
            cls = loader.loadClass(CORE_CLASS)
            for m in cls.getMethods():
                self._m.setdefault(str(m.getName()), m)
            version = str(self._m["version"].invoke(None, []))
            if version != CORE_VERSION:
                return f"не та версия ядра: {version}"
            self._core = cls
            self._loader = loader
        except Exception as e:
            self._core = None
            return f"ядро не запустилось: {e}"
        return None

    def _call(self, name, *args):
        return self._m[name].invoke(None, list(args))

    # ---- жизненный цикл -----------------------------------------------------------

    def on_plugin_load(self):
        self._unloaded = False
        self._core = None
        self._m = {}
        self._gen = int(getattr(self, "_gen", 0)) + 1
        self._ticking = False
        self._last_stats = ""
        self._catalog = {}
        self._listener = None
        reason = self._load_core()
        self._core_status = reason
        if reason is not None:
            self._log(f"ядро недоступно: {reason}")
            return
        try:
            self._listener = _Listener(self)
            self._call("setListener", self._listener)
        except Exception as e:
            self._log(f"слушатель ядра: {e}")
        self._push()
        self._apply_skin()
        try:
            err = str(self._call("install", ApplicationLoader.applicationContext) or "")
            if err:
                self._log(f"установка: {err}")
        except Exception as e:
            self._log(f"установка: {e}")
        self._add_menu()
        self._restart_tick()
        self._probe()
        self._log(f"ядро {CORE_VERSION} загружено, глаза: {self._opt('skin', '')}")

    def _probe(self):
        """Проверка вёрстки на устройстве: если рядом с журналом лежит файл
        pixel_eyes_probe, рисует свои вью в PNG. У обычных людей файла нет."""
        try:
            base = str(ApplicationLoader.applicationContext.getExternalFilesDir(None).getAbsolutePath())
            if not os.path.exists(base + "/pixel_eyes_probe"):
                return
        except Exception:
            return

        def shoot():
            try:
                la = jclass("org.telegram.ui.LaunchActivity").instance
                ctx = la if la is not None else ApplicationLoader.applicationContext
                width = int(ctx.getResources().getDisplayMetrics().widthPixels)
                lib = self._library()
                views = {
                    "preview": self._call("createPreview", ctx, ""),
                    "gallery": self._call("createGallery", ctx, SEP.join(t for _, t, _ in lib), "anime", "library"),
                    "editor": self._call("createEditor", ctx, self._skin_json("anime")),
                }
                for name, view in views.items():
                    err = str(self._call("snapshot", view, jint(width), base + f"/pe_{name}.png"))
                    self._log(f"снимок {name}: {err or 'ok'}")
            except Exception as e:
                self._log(f"снимки: {e}")

            def catalog():
                try:
                    skins = self._fetch_catalog()

                    def shot():
                        la = jclass("org.telegram.ui.LaunchActivity").instance
                        view = self._call("createGallery", la, SEP.join(skins), "", "catalog")
                        width = int(la.getResources().getDisplayMetrics().widthPixels)
                        err = str(self._call("snapshot", view, jint(width), base + "/pe_catalog.png"))
                        self._log(f"снимок catalog: {err or 'ok'}")
                    run_on_ui_thread(shot)
                except Exception as e:
                    self._log(f"каталог в пробе: {e}")
            threading.Thread(target=catalog, daemon=True).start()

        def settings():
            try:
                pc = jclass("com.exteragram.messenger.plugins.PluginsController")
                plugin = pc.getInstance().plugins.get(__id__)
                activity_cls = jclass("com.exteragram.messenger.plugins.ui.PluginSettingsActivity")
                get_last_fragment().presentFragment(activity_cls(plugin))
                self._log("проба: открыл настройки")

                def grab():
                    la = jclass("org.telegram.ui.LaunchActivity").instance
                    decor = la.getWindow().getDecorView()
                    err = str(self._call("snapshot", decor, jint(0), base + "/pe_settings.png"))
                    self._log(f"снимок settings: {err or 'ok'}")
                run_on_ui_thread(grab, 2500)
            except Exception as e:
                self._log(f"проба настроек: {e}")
        def texts():
            try:
                samples = [("ты дебил", False), ("ты дебил", True), ("люблю тебя ❤️", False),
                           ("ахахах 😂", True), ("мне грустно", False), ("бля, пиздец", False)]
                for i, (t, out) in enumerate(samples):
                    def one(t=t, out=out):
                        mood = str(self._call("mood", t))
                        ev = str(self._call("testText", t, out))
                        self._log(f"проба текста: {t!r} {'наш' if out else 'чужой'} -> {mood} / {ev or 'нет'}")
                    threading.Timer(1.5 * i, one).start()
            except Exception as e:
                self._log(f"проба текста: {e}")

        def dialogs():
            try:
                info = str(self._call("dialogsInfo"))
                self._log(f"проба списка: {info}")
                ids = info.split("|", 1)[1].split() if "|" in info else []
                if ids:
                    did = int(ids[0].split("@")[0])
                    ok = bool(self._call("lookAtDialog", did))
                    self._log(f"проба списка: смотрим на {did}: {ok}")
            except Exception as e:
                self._log(f"проба списка: {e}")

        if os.path.exists(base + "/pixel_eyes_probe_dialogs"):
            threading.Timer(3, dialogs).start()
            threading.Timer(15, dialogs).start()
            threading.Timer(5, texts).start()
            return
        run_on_ui_thread(shoot, 3000)
        run_on_ui_thread(settings, 6000)

    def on_plugin_unload(self):
        self._unloaded = True
        self._gen = int(getattr(self, "_gen", 0)) + 1
        if getattr(self, "_core", None) is not None:
            try:
                self._call("setListener", None)
                self._call("uninstall")
            except Exception:
                pass
            self._flush_core_log()
        self._core = None
        self._listener = None

    def _add_menu(self):
        if MenuItemData is None or MenuItemType is None:
            return
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="Добавить глаза",
                on_click=self._from_message,
                icon="msg_add",
                item_id="pixel_eyes_add",
                condition=MSG_CONDITION,
            ))
        except TypeError:
            # старый SDK без условий: пункт висел бы на каждом сообщении, обойдёмся без него
            self._log("меню сообщения: SDK без условий, пункт не добавлен")
        except Exception as e:
            self._log(f"меню сообщения: {e}")

    # ---- события ядра ----------------------------------------------------------------

    def _on_core(self, msg):
        if getattr(self, "_unloaded", False):
            return
        kind, _, arg = msg.partition(":")
        if kind == "pos":
            try:
                x, y = arg.split(",")
                self.set_setting("pos_x", x)
                self.set_setting("pos_y", y)
            except Exception as e:
                self._log(f"позиция: {e}")
        elif kind == "select":
            self.set_setting("skin", arg)
            self._apply_skin()
            name = self._skin_name(arg)
            if name:
                self._toast(f"Глаза: {name}")
        elif kind == "long":
            run_on_ui_thread(lambda: self._skin_actions(arg))
        elif kind == "pick":
            self._install_from_catalog(arg)

    # ---- библиотека -------------------------------------------------------------------

    def _user_dir(self):
        base = ApplicationLoader.applicationContext.getExternalFilesDir(None)
        path = str(base.getAbsolutePath()) + "/pixel_eyes"
        try:
            os.makedirs(path, exist_ok=True)
        except Exception:
            pass
        return path

    def _builtins(self):
        out = []
        if self._core is None:
            return out
        try:
            for i in range(int(self._call("builtinCount"))):
                out.append(str(self._call("builtinJson", jint(i))))
        except Exception as e:
            self._log(f"встроенные: {e}")
        return out

    def _user_files(self):
        """Свои глаза: (путь, текст) для каждого .json в папке."""
        out = []
        folder = self._user_dir()
        try:
            names = sorted(os.listdir(folder))
        except Exception:
            names = []
        for n in names:
            if not (n.endswith(".json") or n.endswith(".eyes")):
                continue
            try:
                if os.path.getsize(os.path.join(folder, n)) > PE_MAX_BYTES:
                    continue
                with io.open(os.path.join(folder, n), encoding="utf-8") as f:
                    text = f.read(PE_MAX_BYTES + 1)
                    winter_validate(text)
                    out.append((os.path.join(folder, n), text))
            except Exception:
                continue
        return out

    def _library(self):
        """[(id, json, user_path или None)]: встроенные, потом свои. Повторы id у своих пропускаются."""
        seen = set()
        lib = []
        for text in self._builtins():
            sid = self._id_of(text)
            if sid and sid not in seen:
                seen.add(sid)
                lib.append((sid, text, None))
        for path, text in self._user_files():
            sid = self._id_of(text)
            if not sid or sid in seen:
                continue
            if self._core is not None and str(self._call("check", text)):
                continue
            seen.add(sid)
            lib.append((sid, text, path))
        return lib

    @staticmethod
    def _id_of(text):
        try:
            return str(json.loads(text).get("id") or "")
        except Exception:
            return ""

    def _skin_json(self, sid):
        for s, text, _ in self._library():
            if s == sid:
                return text
        return None

    def _skin_name(self, sid):
        text = self._skin_json(sid)
        try:
            return str(json.loads(text).get("name") or sid) if text else ""
        except Exception:
            return sid

    def _apply_skin(self):
        if self._core is None:
            return
        sid = str(self._opt("skin", "") or "")
        text = self._skin_json(sid) if sid else None
        if text is None:
            try:
                sid = str(self._call("defaultId"))
                text = self._skin_json(sid)
            except Exception:
                text = None
        if text is None:
            return
        err = str(self._call("setSkin", self._winter_json(text, sid)) or "")
        if err:
            self._log(f"глаза {sid}: {err}")

    def _save_user(self, text, select=True):
        """Сохраняет свои глаза. Возвращает (id, имя) или кидает ValueError с понятной причиной."""
        if self._core is None:
            raise ValueError("ядро не загружено")
        text = self._clean_json(text)
        data = winter_validate(text)
        err = str(self._call("check", text) or "")
        if err:
            raise ValueError(err)
        lib = self._library()
        builtin_ids = {s for s, _, p in lib if p is None}
        taken = {s for s, _, _ in lib}
        base_id = re.sub(r"[^a-z0-9_-]", "", str(data.get("id") or "custom").lower())[:28] or "custom"
        sid = base_id
        n = 2
        while sid in builtin_ids or (sid in taken and self._user_path(sid) is None):
            sid = f"{base_id}_{n}"
            n += 1
        data["id"] = sid
        if not data.get("author"):
            data["author"] = self._username()
        path = self._user_path(sid) or os.path.join(self._user_dir(), sid + ".json")
        with io.open(path, "w", encoding="utf-8") as f:
            f.write(json.dumps(data, ensure_ascii=False, indent=2))
        if select:
            self.set_setting("skin", sid)
            self._apply_skin()
        return sid, str(data.get("name") or sid)

    def _user_path(self, sid):
        for s, _, path in self._library():
            if s == sid and path:
                return path
        return None

    @staticmethod
    def _clean_json(text):
        """Текст из сообщения или буфера: убираем обёртку ``` и всё до первой {."""
        t = str(text or "").strip()
        t = re.sub(r"^```[a-zA-Z]*", "", t).strip()
        if t.endswith("```"):
            t = t[:-3].strip()
        start = t.find("{")
        end = t.rfind("}")
        if start < 0 or end < start:
            raise ValueError("не похоже на JSON с глазами")
        return t[start:end + 1]

    @staticmethod
    def _username():
        try:
            from client_utils import get_user_config
            user = get_user_config().getCurrentUser()
            if user is not None and user.username:
                return "@" + str(user.username)
        except Exception:
            pass
        return ""

    # ---- импорт и экспорт ------------------------------------------------------------

    def _clipboard(self):
        ctx = ApplicationLoader.applicationContext
        cm = ctx.getSystemService(jclass("android.content.Context").CLIPBOARD_SERVICE)
        return cm

    def _import_clipboard(self, *args):
        try:
            clip = self._clipboard().getPrimaryClip()
            if clip is None or clip.getItemCount() == 0:
                self._toast("Буфер обмена пуст", "error")
                return
            text = str(clip.getItemAt(0).coerceToText(ApplicationLoader.applicationContext))
            sid, name = self._save_user(text)
            self._toast(f"Добавлены глаза \"{name}\"", "success")
        except ValueError as e:
            self._toast(f"Не получилось: {e}", "error")
        except Exception as e:
            self._toast(f"Не получилось: {e}", "error")

    def _export_current(self, *args):
        try:
            sid, text = self._current_skin()
            data = json.loads(self._winter_json(text, sid))
            data.pop("winter_snow", None)
            text = json.dumps(data, ensure_ascii=False)
            clip = jclass("android.content.ClipData").newPlainText("Pixel Eyes", text)
            self._clipboard().setPrimaryClip(clip)
            self._toast("JSON глаз скопирован: отправьте его в чат, там его можно добавить себе", "success")
        except Exception as e:
            self._toast(f"Не скопировалось: {e}", "error")

    @staticmethod
    def _http_get(url, limit=300_000):
        from urllib.parse import urlsplit
        from java import jarray, jbyte
        parsed = urlsplit(url)
        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
            raise ValueError("Нужна HTTPS-ссылка без логина и пароля")
        URL = jclass("java.net.URL")
        conn = URL(url).openConnection()
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(15000)
        conn.setRequestProperty("User-Agent", "PixelEyes/1.0")
        code = int(conn.getResponseCode())
        if code != 200:
            raise ValueError(f"сервер ответил {code}")
        if int(conn.getContentLength()) > limit:
            raise ValueError("слишком большой файл")
        stream = conn.getInputStream()
        try:
            output = jclass("java.io.ByteArrayOutputStream")()
            buf = jarray(jbyte)(4096)
            total = 0
            deadline = time.monotonic() + 25
            while True:
                if time.monotonic() > deadline:
                    raise ValueError("истекло время скачивания")
                n = int(stream.read(buf, 0, len(buf)))
                if n < 0:
                    break
                total += n
                if total > limit:
                    raise ValueError("слишком большой файл")
                output.write(buf, 0, n)
            text = str(output.toString("UTF-8"))
        finally:
            stream.close()
        if len(text) > limit:
            raise ValueError("слишком большой файл")
        return text

    def _import_url(self, *args):
        url = str(self._opt("import_url", "") or "").strip()
        if not url.startswith("http"):
            self._toast("Вставьте ссылку на JSON с глазами в поле выше", "error")
            return
        self._toast("Скачиваю глаза...")

        def work():
            try:
                text = self._http_get(url)
                sid, name = self._save_user(text)
                self._toast(f"Добавлены глаза \"{name}\"", "success")
            except Exception as e:
                self._toast(f"Не получилось: {e}", "error")
        threading.Thread(target=work, daemon=True).start()

    def _from_message(self, context):
        try:
            mo = context.get("message")
            if mo is None:
                return
            text = None
            owner = mo.messageOwner
            raw = str(owner.message) if owner is not None and owner.message is not None else ""
            if '"eye"' in raw:
                text = raw
            else:
                fl = jclass("org.telegram.messenger.FileLoader").getInstance(int(mo.currentAccount))
                f = fl.getPathToMessage(owner)
                if f is None or not f.exists():
                    self._toast("Сначала скачайте файл, потом добавляйте", "error")
                    return
                if int(f.length()) > 300_000:
                    self._toast("Файл слишком большой для глаз", "error")
                    return
                with io.open(str(f.getAbsolutePath()), encoding="utf-8") as fh:
                    text = fh.read()
            sid, name = self._save_user(text)
            self._toast(f"Добавлены и выбраны глаза \"{name}\"", "success")
        except ValueError as e:
            self._toast(f"Это не глаза: {e}", "error")
        except Exception as e:
            self._toast(f"Не получилось: {e}", "error")

    # ---- каталог -----------------------------------------------------------------------

    def _fetch_catalog(self):
        """Скачивает каталог (долго, не на потоке интерфейса). Список JSON или ValueError."""
        last = None
        for url in CATALOG_URLS:
            try:
                index = json.loads(self._http_get(url))
                base = url.rsplit("/", 1)[0] + "/"
                skins = []
                entries = index.get("skins", [])
                if not isinstance(entries, list) or len(entries) > 500:
                    raise ValueError("Неверный список каталога")
                seen = set()
                for entry in entries[:120]:
                    try:
                        rel = str(entry.get("url") or "")
                        if not re.fullmatch(r"skins/[a-z][a-z0-9_-]{0,60}\.json", rel):
                            raise ValueError("Каталог содержит постороннюю ссылку")
                        text = self._http_get(base + rel, PE_MAX_BYTES)
                        data = pe_validate(text)
                        if data["id"] in seen:
                            raise ValueError("Повтор id")
                        seen.add(data["id"])
                        digest = entry.get("sha256")
                        if digest and pe_hashlib.sha256(pe_canonical(data).encode("utf-8")).hexdigest() != digest:
                            raise ValueError("Контрольная сумма не совпала")
                        if self._core is not None and not str(self._call("check", text)):
                            skins.append(text)
                    except Exception as e:
                        self._log(f"каталог: {e}")
                if not skins:
                    raise ValueError("в каталоге пусто")
                self._catalog = {self._id_of(t): t for t in skins}
                self._log(f"каталог: {len(skins)} с {url}")
                return skins
            except Exception as e:
                last = e
                self._log(f"каталог {url}: {e}")
        raise ValueError(str(last))

    def _open_catalog(self, *args):
        clicked = args[0] if args else None

        def open_catalog():
            activity = self._dialog_activity(clicked)
            if activity is None:
                self._toast("Не удалось открыть окно каталога", "error")
                return
            cached = getattr(self, "_catalog", {})
            if cached and time.monotonic() - getattr(self, "_catalog_at", 0) < 300:
                self._show_catalog(list(cached.values()), activity=activity)
                return
            if getattr(self, "_catalog_loading", False):
                self._toast("Каталог уже загружается")
                return
            self._catalog_loading = True
            self._toast("Загружаю каталог…")

            def work():
                try:
                    skins = self._fetch_catalog()
                    self._catalog_at = time.monotonic()
                    run_on_ui_thread(lambda: self._show_catalog(skins, activity=activity))
                except Exception as e:
                    self._log(f"каталог недоступен: {e}")
                    skins = list(cached.values()) or CATALOG_FALLBACK
                    if skins:
                        run_on_ui_thread(lambda: self._show_catalog(skins, activity=activity, offline=True))
                    else:
                        self._toast("Каталог недоступен. Проверьте соединение и попробуйте ещё раз", "error")
                finally:
                    self._catalog_loading = False
            threading.Thread(target=work, daemon=True).start()

        run_on_ui_thread(open_catalog)

    def _show_catalog(self, skins, page=0, activity=None, offline=False):
        try:
            from ui.alert import AlertDialogBuilder
            source = skins
            skins = pe_filtered(skins, str(self._opt("catalog_query", "") or ""),
                                str(self._opt("catalog_tag", "") or "").strip(),
                                {sid for sid, _, _ in self._library()},
                                bool(self._opt("catalog_new", False)),
                                int(self._opt("catalog_sort", 0) or 0))
            if not skins:
                self._toast("По этим фильтрам ничего не найдено. Измените поиск или тег")
                return
            pages = (len(skins) + 11) // 12
            page = min(max(page, 0), pages - 1)
            visible = skins[page * 12:(page + 1) * 12]
            if activity is None:
                activity = self._dialog_activity()
            if activity is None or activity.isFinishing() or activity.isDestroyed():
                return
            view = self._call("createGallery", activity, SEP.join(visible), "", "catalog")
            scroll = jclass("android.widget.ScrollView")(activity)
            scroll.addView(view)
            builder = AlertDialogBuilder(activity)
            builder.set_title(f"Каталог: {len(skins)}. Нажмите, чтобы добавить")
            if offline:
                builder.set_message("Сохранённая копия. Онлайн-каталог сейчас недоступен")
            elif pages > 1:
                builder.set_message(f"Страница {page + 1} из {pages}")
            if pages > 1:
                # Повторно фильтруем исходный каталог: после установки учитывается фильтр новых.
                builder.set_neutral_button("Дальше" if page + 1 < pages else "В начало",
                    lambda d, w: (d.dismiss(), self._show_catalog(source, (page + 1) % pages, activity, offline)))
            self._set_view(builder, scroll, 0.62)
            builder.set_positive_button("Закрыть", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            self._log(f"окно каталога: {e}")
            self._toast("Не удалось показать каталог глаз", "error")

    def _install_from_catalog(self, sid):
        text = getattr(self, "_catalog", {}).get(sid)
        if not text:
            text = next((item for item in CATALOG_FALLBACK if self._id_of(item) == sid), None)
        if not text:
            return
        try:
            new_id, name = self._save_user(text)
            self._toast(f"Добавлены и выбраны глаза \"{name}\"", "success")
        except Exception as e:
            self._toast(f"Не получилось: {e}", "error")

    def _catalog_items(self):
        tags = sorted({tag for text in getattr(self, "_catalog", {}).values()
                       for tag in json.loads(text).get("tags", [])})
        return [
            Header(text="Фильтры каталога"),
            self._ctl(Input, key="catalog_query", text="Поиск", default="",
                      subtext="Название, описание, автор или тег"),
            self._ctl(Input, key="catalog_tag", text="Тег", default="",
                      subtext=("Один из тегов: " + ", ".join(tags)) if tags else "Один тег: милые или жуткие. Пусто: все"),
            self._ctl(Switch, key="catalog_new", text="Только ещё не добавленные", default=False),
            self._choice("catalog_sort", "Порядок", 0, ["Как в каталоге", "По названию", "По автору"]),
            self._button("Показать глаза", self._open_catalog,
                         subtext="Живой пример каждого набора. Фильтры сохраняются"),
            self._button("Сбросить фильтры", self._reset_catalog_filters),
        ]

    def _reset_catalog_filters(self, *args):
        for key, value in (("catalog_query", ""), ("catalog_tag", ""),
                           ("catalog_new", False), ("catalog_sort", 0)):
            self.set_setting(key, value)
        self._toast("Фильтры сброшены")

    # ---- публикация своих глаз -------------------------------------------------

    def _publish_current(self, *args):
        sid = str(self._opt("skin", "") or "")
        if not sid or self._user_path(sid) is None:
            self._toast("Выберите свои сохранённые глаза. Встроенные сначала измените копией", "error")
            return
        text = self._skin_json(sid)
        try:
            data = winter_validate(text)
            decorated = data.pop("hat", None) is not None
            from ui.alert import AlertDialogBuilder
            ctx = self._context()
            box = jclass("android.widget.LinearLayout")(ctx)
            box.setOrientation(1)
            fields = []
            for hint, value in (("Название", data["name"]),
                                ("Описание", data.get("description", "")),
                                ("Теги через запятую", ", ".join(data.get("tags", [])))):
                edit = jclass("android.widget.EditText")(ctx)
                edit.setHint(hint)
                self._call("styleInput", edit)
                edit.setText(value)
                box.addView(edit)
                fields.append(edit)
            builder = AlertDialogBuilder(ctx)
            builder.set_title("Опубликовать свои глаза")
            builder.set_message("Отправится только рисунок, название, описание и теги. "
                                "На GitHub подтвердите заявку своим аккаунтом. "
                                "После проверки и одобрения набор появится у всех."
                                + (" Общий каталог принимает рисунок глаз без шапки." if decorated else ""))
            builder.set_view(box, -2)

            def submit(dialog, which):
                try:
                    candidate = dict(data)
                    candidate["name"] = str(fields[0].getText()).strip()
                    candidate["description"] = str(fields[1].getText()).strip()
                    candidate["tags"] = list(dict.fromkeys(t.strip() for t in str(fields[2].getText()).split(",") if t.strip()))
                    candidate["author"] = self._username()
                    self._submission(candidate)
                except Exception as e:
                    self._toast(f"Заявка не подготовлена: {e}", "error")
            builder.set_positive_button("Подготовить заявку", submit)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            self._toast(f"Не получилось: {e}", "error")

    def _submission(self, data):
        from urllib.parse import urlencode
        payload = pe_pack(pe_canonical(data))
        body = "Хочу добавить свои глаза в каталог Pixel Eyes.\n\n```text\n" + payload + "\n```"
        params = {"title": "[Eyes] " + data["name"], "body": body}
        url = REPO_URL + "/issues/new?" + urlencode(params)
        if len(url) > 7500:
            # Не обрезаем большие рисунки ради ограничения длины ссылки браузера.
            clip = jclass("android.content.ClipData").newPlainText("Заявка Pixel Eyes", body)
            self._clipboard().setPrimaryClip(clip)
            url = REPO_URL + "/issues/new?" + urlencode({"title": params["title"]})
            self._toast("Заявка скопирована. Вставьте её в описание на GitHub и отправьте")
        else:
            self._toast("На GitHub нажмите Submit new issue. До этого заявка не отправлена")
        self._open_url(url, external=True)

    # ---- редактор ------------------------------------------------------------------------

    def _set_view(self, builder, view, fraction):
        """Вью в окно: высота в dp, доля экрана. Без высоты окно с длинным
        содержимым уехало бы за край."""
        try:
            dm = ApplicationLoader.applicationContext.getResources().getDisplayMetrics()
            height = int(dm.heightPixels / dm.density * fraction)
        except Exception:
            height = 420
        try:
            builder.set_view(view, height)
        except TypeError:
            builder.set_view(view)

    def _context(self):
        try:
            fragment = get_last_fragment() if get_last_fragment is not None else None
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is not None:
                return activity
        except Exception:
            pass
        return ApplicationLoader.applicationContext

    def _dialog_activity(self, clicked=None):
        candidates = []
        if clicked is not None:
            try:
                candidates.append(jclass("org.telegram.messenger.AndroidUtilities").findActivity(clicked.getContext()))
            except Exception:
                pass
        candidates.append(self._context())
        try:
            candidates.append(jclass("org.telegram.ui.LaunchActivity").instance)
        except Exception:
            pass
        for activity in candidates:
            try:
                if activity is not None and not activity.isFinishing() and not activity.isDestroyed():
                    return activity
            except (AttributeError, TypeError):
                continue
        return None

    def _open_editor(self, source_json=None, view=None):
        if self._core is None:
            return
        try:
            from ui.alert import AlertDialogBuilder
            activity = self._context()
            if view is None:
                view = self._call("createEditor", activity, source_json or "")
            else:
                parent = view.getParent()
                if parent is not None:
                    parent.removeView(view)
            builder = AlertDialogBuilder(activity)
            builder.set_title("Свои глаза")
            self._set_view(builder, view, 0.66)

            def save(dialog, which):
                text = str(self._call("editorJson", view, None) or "")
                if text.startswith("!"):
                    self._toast(text[1:], "error")
                    run_on_ui_thread(lambda: self._open_editor(view=view), 300)
                    return
                try:
                    sid, name = self._save_user(text)
                    self._toast(f"Глаза \"{name}\" сохранены и выбраны", "success")
                except Exception as e:
                    self._toast(f"Не сохранилось: {e}", "error")
                    run_on_ui_thread(lambda: self._open_editor(view=view), 300)
            builder.set_positive_button("Сохранить", save)
            builder.set_negative_button("Отмена", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            self._toast(f"Редактор: {e}", "error")
            self._log(f"редактор: {e}")

    def _edit_current(self, *args):
        sid, text = self._current_skin()
        if text:
            data = json.loads(self._winter_json(text, sid))
            data.pop("winter_snow", None)
            text = json.dumps(data, ensure_ascii=False)
        if text and self._user_path(sid) is None:
            # встроенные не трогаем: правим копию
            try:
                data = json.loads(text)
                data["id"] = "my_" + str(data.get("id", "eyes"))
                data["name"] = str(data.get("name", "")) + " (моя)"
                data["author"] = ""
                text = json.dumps(data, ensure_ascii=False)
            except Exception:
                pass
        self._open_editor(text)

    def _skin_actions(self, sid):
        """Долгое нажатие по карточке: поделиться, изменить, удалить свои."""
        try:
            from ui.alert import AlertDialogBuilder
            text = self._skin_json(sid)
            if not text:
                return
            name = self._skin_name(sid)
            user = self._user_path(sid)
            builder = AlertDialogBuilder(self._context())
            builder.set_title(name)
            builder.set_message("Свои глаза" if user else "Встроенные глаза")

            def share(d, w):
                data = json.loads(self._winter_json(text, sid))
                data.pop("winter_snow", None)
                clip = jclass("android.content.ClipData").newPlainText("Pixel Eyes", json.dumps(data, ensure_ascii=False))
                self._clipboard().setPrimaryClip(clip)
                self._toast("JSON скопирован: отправьте его в чат", "success")

            def edit(d, w):
                if user:
                    self._open_editor(text)
                else:
                    self.set_setting("skin", sid)
                    self._edit_current()

            builder.set_positive_button("Скопировать", share)
            builder.set_neutral_button("Изменить" if user else "Изменить копию", edit)
            if user:
                def delete(d, w):
                    try:
                        os.remove(user)
                        if str(self._opt("skin", "")) == sid:
                            self.set_setting("skin", "")
                            self._apply_skin()
                        self._toast(f"Глаза \"{name}\" удалены")
                    except Exception as e:
                        self._toast(f"Не удалилось: {e}", "error")
                builder.set_negative_button("Удалить", delete)
            builder.show()
            if user:
                try:
                    builder.make_button_red(-2)
                except Exception:
                    pass
        except Exception as e:
            self._log(f"действия с глазами: {e}")

    def _reset_position(self, *args):
        self.set_setting("pos_x", "0.82")
        self.set_setting("pos_y", "0.22")
        self._push()
        self._toast("Глаза вернулись на место")

    def _open_url(self, url, external=False):
        """Ссылка во встроенном браузере клиента, а если его нет, в обычном."""
        def go():
            ctx = self._context()
            if not external:
                try:
                    jclass("org.telegram.messenger.browser.Browser").openUrl(ctx, url)
                    return
                except Exception as e:
                    self._log(f"Browser.openUrl: {e}")
            try:
                Intent = jclass("android.content.Intent")
                Uri = jclass("android.net.Uri")
                intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                ctx.startActivity(intent)
            except Exception as e:
                try:
                    clip = jclass("android.content.ClipData").newPlainText("Ссылка Pixel Eyes", url)
                    self._clipboard().setPrimaryClip(clip)
                    self._toast("Браузер не открылся. Ссылка скопирована: вставьте её в браузер вручную", "error")
                except Exception:
                    self._toast("Не удалось открыть браузер или скопировать ссылку", "error")
                self._log(f"ссылка: {e}")
        run_on_ui_thread(go)

    def _show_format(self, *args):
        try:
            from ui.alert import AlertDialogBuilder
            builder = AlertDialogBuilder(self._context())
            builder.set_title("Как сделать свои глаза")
            builder.set_message(FORMAT_HELP + "\n\nПодробная инструкция с примерами: " + GUIDE_URL
                                + "\nОнлайн-редактор: " + EDITOR_URL)
            builder.set_positive_button("Понятно", lambda d, w: d.dismiss())
            builder.show()
        except Exception as e:
            self._log(f"справка: {e}")

    # ---- журнал ядра ----------------------------------------------------------------------

    def _restart_tick(self):
        if self._opt("debug", False) and not self._ticking:
            self._ticking = True
            gen = self._gen
            run_on_ui_thread(lambda: self._stats_tick(gen), STATS_EVERY_MS)

    def _flush_core_log(self):
        try:
            text = str(self._call("drainLog") or "")
            if text:
                self._write_log(text)
        except Exception:
            pass

    def _stats_tick(self, gen):
        if gen != self._gen or not self._opt("debug", False):
            if gen == self._gen:
                self._ticking = False
            return
        if self._core is not None:
            self._flush_core_log()
            try:
                stats = str(self._call("stats"))
                if stats != self._last_stats:
                    self._last_stats = stats
                    self._log("ядро: " + stats)
            except Exception:
                pass
        run_on_ui_thread(lambda: self._stats_tick(gen), STATS_EVERY_MS)

    # ---- экран настроек ---------------------------------------------------------------------

    def _ctl(self, cls, **kw):
        key = kw.get("key")
        if key and "on_change" not in kw:
            kw["on_change"] = lambda value, k=key: self._changed(k, value)
        try:
            return cls(**kw)
        except TypeError:
            kw.pop("on_change", None)
            try:
                return cls(**kw)
            except TypeError:
                kw.pop("icon", None)
                return cls(**kw)

    def _choice(self, key, text, default, items, subtext=None):
        kw = {"key": key, "text": text, "default": default}
        if Selector is not None:
            return self._ctl(Selector, items=items, **kw)
        kw["default"] = str(default)
        kw["subtext"] = subtext or " / ".join(f"{i} {n}" for i, n in enumerate(items))
        return self._ctl(Input, **kw)

    def _button(self, text, on_click, subtext=None):
        kw = {"text": text, "on_click": on_click}
        if subtext:
            kw["subtext"] = subtext
        try:
            return Text(**kw)
        except TypeError:
            kw.pop("subtext", None)
            return Text(**kw)

    def _page(self, title, build, subtext=None):
        try:
            kw = {"text": title, "create_sub_fragment": build}
            if subtext:
                kw["subtext"] = subtext
            return [Text(**kw)]
        except TypeError:
            return [Divider(), Header(text=title)] + build()

    def _show_preview_dialog(self, *args):
        def show():
            try:
                from ui.alert import AlertDialogBuilder
                ctx = self._context()
                builder = AlertDialogBuilder(ctx)
                builder.set_title("Живой пример")
                view = self._call("createPreview", ctx, "")
                builder.set_view(view, -2)
                builder.set_positive_button("Закрыть", lambda d, w: d.dismiss())
                builder.show()
            except Exception as e:
                self._log(f"пример: {e}")
                self._toast("Не удалось открыть живой пример", "error")
        run_on_ui_thread(show)

    def _preview_items(self):
        if Custom is None:
            return []
        try:
            view = self._call("createPreview", self._context(), "")
            if view is not None:
                return [Custom(view=view)]
        except Exception as e:
            self._log(f"пример в настройках: {e}")
        return []

    def _gallery_items(self):
        if self._core is None:
            return [Text(text="Ядро не загружено")]
        items = []
        lib = self._library()
        sel = str(self._opt("skin", "") or "") or str(self._call("defaultId"))
        if Custom is not None:
            try:
                view = self._call("createGallery", self._context(), SEP.join(self._winter_json(t, sid) for sid, t, _ in lib), sel, "library")
                items.append(Custom(view=view))
            except Exception as e:
                self._log(f"галерея: {e}")
        if not items:
            for sid, text, _ in lib:
                name = self._skin_name(sid)
                items.append(self._button(("✓ " if sid == sel else "") + name,
                                          lambda *a, s=sid: self._on_core("select:" + s)))
        items.append(Text(text="Нажмите на глаза, чтобы выбрать. Долгое нажатие: поделиться, "
                               "изменить или удалить свои"))
        return items

    def _test_phrase(self, text):
        text = str(text or "").strip()
        if not text or self._core is None:
            return
        try:
            mood = str(self._call("mood", text))
            self._toast(f"Глаза поймут: {MOOD_NAMES.get(mood, mood)}")
            event = {"insult": "emo:scared", "love": "emo:love", "laugh": "emo:happy", "sad": "emo:sad"}.get(mood)
            if event:
                self._call("event", event)
        except Exception as e:
            self._log(f"проверка фразы: {e}")

    def _words_items(self):
        hint = "Через запятую. Звёздочка в конце слова: любое окончание"
        return [
            Header(text="Свои слова"),
            Text(text="Добавляются к встроенным, регистр и ё не важны"),
            self._ctl(Input, key="words_insult", text="Гадости", default="",
                      subtext=hint + ". Например: ты бот, чепух*"),
            self._ctl(Input, key="words_love", text="Любовь", default="",
                      subtext=hint + ". Например: зая, котёнок, мой хороший"),
            self._ctl(Input, key="words_laugh", text="Смех", default="",
                      subtext=hint + ". Например: кек, хд, жиза"),
            self._ctl(Input, key="words_sad", text="Грусть", default="",
                      subtext=hint + ". Например: эх, жаль, печалька"),
            Header(text="Не реагировать"),
            self._ctl(Input, key="words_ignore", text="Никогда не считать", default="",
                      subtext="Эти слова глаза пропускают совсем, даже встроенные. Например, шутливые "
                              "прозвища друзей: дурак, сучка, дебил*"),
            Header(text="Проверка"),
            self._ctl(Input, key="words_test", text="Проверить фразу", default="",
                      subtext="Напишите фразу: глаза покажут реакцию, а снизу появится, что они поняли"),
        ]

    def _reaction_items(self):
        S = Switch
        return [
            Header(text="На что смотрят"),
            self._ctl(S, key="follow_touch", text="Следить за пальцем", default=True,
                      subtext="Где бы вы ни коснулись экрана, глаза смотрят туда"),
            self._ctl(S, key="follow_typing", text="Следить за набором", default=True,
                      subtext="Пока печатаете, глаза бегают за курсором"),
            self._ctl(S, key="stare", text="Смотреть на вас", default=True,
                      subtext="Перестали печатать: глаза поднимаются и смотрят прямо на вас"),
            Header(text="На что реагируют"),
            self._ctl(S, key="winter_snow", text="Снежные реакции", default=False,
                      subtext="Снег при сообщениях, любви и встряске",
                      on_change=lambda value: self._winter_toggle("winter_snow", value)),
            self._ctl(S, key="react_messages", text="Новые сообщения", default=True,
                      subtext="Оглядываются на пришедшее, грустят, когда сообщение удалили"),
            self._ctl(S, key="react_send", text="Отправка", default=True,
                      subtext="Радуются вашему отправленному сообщению"),
            self._ctl(S, key="react_love", text="Любовь", default=True,
                      subtext="Влюбляются от сердечек и признаний: ваших и собеседника"),
            self._ctl(S, key="react_text", text="Понимают текст сообщений", default=True,
                      subtext="Пишут гадости вам: пугаются и плачут. Грубите вы: злятся вместе с вами. "
                              "Смешное смешит, грустное печалит. Простой мат как междометие не считается"),
        ] + self._page("Свои слова для текста", self._words_items,
                       subtext="Добавить слова для реакций или исключить ненужные") + [
            self._ctl(S, key="react_peer", text="Кто-то печатает", default=True,
                      subtext="В чате смотрят на шапку, в списке чатов на строку \"печатает...\""),
            self._ctl(S, key="react_screen", text="Переходы между экранами", default=True,
                      subtext="Оглядываются, когда открывается новый экран"),
            self._ctl(S, key="react_shake", text="Тряска телефона", default=True,
                      subtext="Встряхните телефон, и у глаз закружится голова"),
            self._ctl(S, key="react_copy", text="Копирование", default=True,
                      subtext="Подмигивают, когда вы что-то копируете"),
            self._ctl(S, key="poke", text="Нажатия по глазам", default=True,
                      subtext="Тап: ай. Три тапа подряд: злятся. Зажать и тащить: перенести. "
                              "Зажать и отпустить: уснуть или проснуться"),
            Header(text="Сон"),
            self._ctl(S, key="sleep", text="Засыпать без дела", default=True,
                      subtext="Сначала клюют носом, потом спят с Z над головой"),
            self._ctl(Input, key="sleep_sec", text="Засыпать через, секунд", default="90",
                      subtext="От 10 до 3600"),
            self._ctl(S, key="night", text="Сонные ночью", default=True,
                      subtext="С полуночи до шести утра глаза тяжелее и засыпают быстрее"),
            self._ctl(S, key="battery", text="Устают от разряда", default=True,
                      subtext="Меньше 15% заряда без зарядки: глаза уставшие и грустные"),
        ]

    def _current_skin(self):
        sid = str(self._opt("skin", "") or self._call("defaultId"))
        text = self._skin_json(sid)
        if text is None:
            sid = str(self._call("defaultId"))
            text = self._skin_json(sid)
        return sid, text

    def _winter_json(self, text, sid):
        data = json.loads(text)
        override = self._opt("hat_" + sid, None)
        if isinstance(override, str) and override:
            try:
                data["hat"] = winter_validate(json.dumps(dict(data, hat=json.loads(override))))["hat"]
            except ValueError:
                pass
        if isinstance(data.get("hat"), dict):
            data["hat"].pop("mode", None)
            data["hat"].pop("shared_offset", None)
        if self._opt("winter_snow", False):
            data["winter_snow"] = True
        return json.dumps(data, ensure_ascii=False)

    def _winter_toggle(self, key, value):
        self.set_setting(key, value)
        self._apply_skin()

    def _hat_dialog(self, *args):
        clicked = args[0] if args else None

        def show():
            try:
                activity = self._dialog_activity(clicked)
                if activity is None:
                    raise RuntimeError("нет активного окна клиента")
                self._show_hat_dialog(activity)
            except Exception as e:
                self._log(f"редактор шапок: {e}")
                self._toast("Не удалось открыть настройки шапок", "error")
        run_on_ui_thread(show)

    def _show_hat_dialog(self, ctx):
        from ui.alert import AlertDialogBuilder
        sid, text = self._current_skin()
        data = json.loads(self._winter_json(text, sid))
        data.pop("winter_snow", None)
        data.setdefault("hat", {})
        view = self._call("createWinterEditor", ctx, json.dumps(data, ensure_ascii=False))
        dialog = AlertDialogBuilder(ctx)
        dialog.set_title("Шапки · " + data["name"])
        self._set_view(dialog, view, .67)

        def save(d, w):
            try:
                hat = json.loads(str(self._call("winterEditorJson", view)))
                raw = json.loads(text)
                raw["hat"] = hat
                encoded = json.dumps(raw, ensure_ascii=False)
                winter_validate(encoded)
                if self._user_path(sid):
                    self._save_user(encoded)
                    self.set_setting("hat_" + sid, "")
                else:
                    self.set_setting("hat_" + sid, json.dumps(hat))
                self._apply_skin()
                self._toast("Шапки сохранены", "success")
            except Exception as e:
                self._toast(f"Не удалось сохранить шапки: {e}", "error")
        dialog.set_positive_button("Сохранить", save)
        dialog.set_negative_button("Отмена", lambda d, w: d.dismiss())
        dialog.show()

    def _ai_dialog(self, *args):
        from ui.alert import AlertDialogBuilder
        ctx = self._context()
        sid, source = self._current_skin()
        LinearLayout = jclass("android.widget.LinearLayout")
        box = LinearLayout(ctx)
        box.setOrientation(1)
        pad = int(16 * ctx.getResources().getDisplayMetrics().density)
        box.setPadding(pad, 0, pad, 0)
        edit = jclass("android.widget.EditText")(ctx)
        edit.setHint("Например: янтарные глаза и синяя шапка со звёздочкой")
        self._call("styleInput", edit)
        edit.setMaxLines(5)
        edit.setText(str(getattr(self, "_ai_draft", "")))
        box.addView(edit)
        based = jclass("android.widget.CheckBox")(ctx)
        self._call("styleInput", based)
        based.setText("Взять за основу «" + json.loads(source)["name"] + "»")
        box.addView(based)
        dialog = AlertDialogBuilder(ctx)
        dialog.set_title("Глаза и шапки с ИИ")
        dialog.set_message("Опишите набор. Скопируйте промпт в любую нейросеть, затем скопируйте её ответ и нажмите «Импорт ответа».")
        dialog.set_view(box, -2)

        def keep_draft():
            self._ai_draft = str(edit.getText()).strip()[:2000]

        def copy_prompt(d, w):
            keep_draft()
            if not self._ai_draft:
                self._toast("Сначала опишите, какие глаза хотите", "error")
                run_on_ui_thread(self._ai_dialog, 250)
                return
            reference = self._winter_json(source, sid) if based.isChecked() else ""
            text = winter_prompt(self._ai_draft, reference)
            clip = jclass("android.content.ClipData").newPlainText("Промпт Pixel Eyes", text)
            self._clipboard().setPrimaryClip(clip)
            self._toast("Промпт скопирован. Вставьте его в нейросеть", "success")

        def import_answer(d, w):
            keep_draft()
            try:
                clip = self._clipboard().getPrimaryClip()
                if clip is None or clip.getItemCount() == 0:
                    raise ValueError("буфер обмена пуст")
                text = str(clip.getItemAt(0).coerceToText(ApplicationLoader.applicationContext))
                data = winter_validate(self._clean_json(text))
                taken = {item[0] for item in self._library()}
                base = data["id"][:22]
                candidate, n = base, 2
                while candidate in taken:
                    candidate = f"{base}_{n}"
                    n += 1
                data["id"] = candidate
                _, name = self._save_user(json.dumps(data, ensure_ascii=False))
                self._toast(f"Глаза «{name}» добавлены и выбраны", "success")
            except Exception as e:
                self._toast(f"Ответ не подходит: {e}", "error")
                run_on_ui_thread(self._ai_dialog, 250)

        dialog.set_positive_button("Скопировать промпт", copy_prompt)
        dialog.set_neutral_button("Импорт ответа", import_answer)
        dialog.set_negative_button("Отмена", lambda d, w: keep_draft())
        dialog.show()

    def _own_items(self):
        folder = self._user_dir()
        return [
            Header(text="Сделать свои"),
            self._button("Создать или изменить с ИИ", self._ai_dialog,
                         subtext="Промпт для любой нейросети и импорт ответа"),
            self._button("Нарисовать новые", lambda *a: self._open_editor(None),
                         subtext="Редактор с живым примером: глаз, радужка, блик, палитра"),
            self._button("Изменить текущие", self._edit_current,
                         subtext="Встроенные откроются копией, оригинал не тронется"),
            self._button("Как устроен файл глаз", self._show_format),
            self._button("Инструкция и онлайн-редактор", lambda *a: self._open_url(GUIDE_URL),
                         subtext="Подробно про каждое поле, урок с нуля, рисование в браузере"),
            Header(text="Добавить чужие"),
            self._button("Каталог глаз", self._open_catalog, subtext="Посмотреть и добавить наборы"),
            *self._page("Фильтры каталога", self._catalog_items, subtext="Поиск, теги и порядок"),
            self._button("Из буфера обмена", self._import_clipboard,
                         subtext="Скопируйте JSON с глазами и нажмите сюда"),
            self._ctl(Input, key="import_url", text="Ссылка на JSON", default="",
                      subtext="Например, raw-ссылка с GitHub"),
            self._button("Скачать по ссылке", self._import_url),
            Text(text="Из сообщения",
                 subtext="Зажмите сообщение с JSON глаз или файлом .json, в меню будет \"Добавить глаза\""),
            Text(text="Папка с глазами", subtext=folder + "\nФайлы .json отсюда появятся в списке сами"),
            Header(text="Поделиться"),
            self._button("Опубликовать свои глаза", self._publish_current,
                         subtext="Выбранный свой набор: проверка, заявка на GitHub и одобрение"),
            self._button("Скопировать текущие", self._export_current,
                         subtext="JSON в буфер: отправьте другу, он добавит их из сообщения"),
        ]

    def create_settings(self):
        try:
            if getattr(self, "_core", None) is not None:
                self._push()
                self._restart_tick()
        except Exception:
            pass
        if getattr(self, "_core", None) is None:
            return [
                Header(text="Pixel Eyes"),
                Text(text="Ядро не загрузилось",
                     subtext=str(getattr(self, "_core_status", "неизвестно"))),
                self._ctl(Switch, key="debug", text="Запись диагностики", default=False),
            ]
        sid = str(self._opt("skin", "") or "") or str(self._call("defaultId"))
        items = [
            Header(text="Pixel Eyes"),
            self._ctl(Switch, key="enabled", text="Включено", default=True),
        ]
        items += self._preview_items()
        items.append(self._button("Открыть живой пример", self._show_preview_dialog,
                                  subtext="Посмотреть глаза и проверить эмоции"))
        items += self._page("Выбрать глаза", self._gallery_items, subtext=f"Сейчас: {self._skin_name(sid)}")
        items += [
            self._button("Настроить шапки", self._hat_dialog,
                         subtext="Надеть или снять в этом наборе, выбрать цвет, размер и посадку"),
            self._choice("size", "Размер", 2, SIZE_NAMES),
            self._choice("opacity", "Непрозрачность", 0, OPACITY_NAMES),
            self._choice("where", "Где показывать", 0, WHERE_NAMES),
        ]
        items += self._page("Реакции и сон", self._reaction_items,
                            subtext="Палец, набор, сообщения, тряска, сон")
        items += self._page("Свои глаза и каталог", self._own_items,
                            subtext="Редактор, импорт, обмен")
        items += [
            Divider(),
            Header(text="Дополнительно"),
            self._button("Канал автора", lambda *a: self._open_url("https://t.me/van1lPLugin"),
                         subtext="@van1lPLugin"),
            self._choice("edge", "Обводка", 0, EDGE_NAMES),
            self._button("Вернуть глаза на место", self._reset_position,
                         subtext="Если утащили за край или потеряли"),
            self._ctl(Switch, key="debug", text="Запись диагностики", default=False,
                      subtext="Пишет ход работы в pixel_eyes_log.txt"),
        ]
        return items
