CAREFUL, NORMAL, FAST = 0, 1, 2
MODES = ("careful", "normal", "fast")
# (порог в дБ, сколько секунд речи микрофон должен быть заглушён)
MODE_RULES = {CAREFUL: (10.0, 0.15), NORMAL: (7.0, 0.08), FAST: (5.0, 0.04)}
KINDS = (("round", True), ("voice", True))
SWITCHES = KINDS + (("level", True),)

MONO, STEREO, PCM_16 = 16, 12, 2
FAST_TAU = 0.03                     # сглаживание уровней для решения
LEARN_TAU = 4.0                     # норма микрофонов подстраивается за столько секунд речи
RECENT_TAU = 2.0                    # громкость «перед пальцем»: за столько секунд речи
WARM_SECONDS = 1.0                  # столько речи нужно, чтобы выучить норму с нуля
WARM_MARGIN = 6.0                   # пока нормы нет, другой микрофон берётся, только если громче на столько дБ
DULL_SHARE = 0.7                    # закрытый микрофон глохнет и сам по себе: доля порога
SPEECH_ABOVE = 9.0                  # речь: громкость хотя бы одного микрофона выше его шума на столько дБ
NOISE_RISE = 3.0                    # дБ/с: как быстро может подрасти оценка шума
DEAD_LEVEL = 6.0                    # дБ: тише собственного шума любого живого микрофона — канал заглушён
RETURN_AFTER = 0.5                  # сколько основной микрофон должен звучать нормально, чтобы вернуться
GAIN_LIMITS = (-6.0, 24.0)          # выравнивание громкости запасного микрофона, дБ
NORM_LIMIT = 60.0                   # сохранённая норма за этими пределами — мусор
STALL_SECONDS = 1.0                 # запас буфера записи: столько звука переживает заминку без потерь
SLOW_SHARE, SLOW_CHUNKS = 0.3, 3    # обработка дольше 30 % длины куска трижды подряд → лёгкий режим
ROUND_CALLERS = ("com.exteragram.messenger.camera.RoundVideoEncoder",
                 "org.telegram.utils.camera.roundvideo.RoundVideoCodecRecorder",
                 "org.telegram.ui.Components.InstantCameraView")
VOICE_CALLERS = ("org.telegram.messenger.MediaController",)
AUDIO_RECORD = "android.media.AudioRecord"
TAG = "LYU_MIC_SWITCH"


def db(value):
    return 20.0 * math.log10(float(value) + 1.0)


def smoothing(dt, tau):
    return 1.0 - math.exp(-dt / tau)


def measure(channel):
    """(громкость, средние частоты): средний модуль сигнала и разности сумм по 4 отсчёта
    (~1,5–6 кГц: здесь палец глушит сильнее всего, а голос слышен даже дальнему микрофону)."""
    count = len(channel) // 4
    if count < 2:
        return 0.0, 0.0
    level = sum(map(abs, channel)) / len(channel)
    add = operator.add
    blocks = list(map(add, map(add, channel[0::4], channel[1::4]), map(add, channel[2::4], channel[3::4])))[:count]
    mid = sum(map(abs, map(operator.sub, blocks[1:], blocks[:-1]))) / (4.0 * (count - 1))
    return level, mid


def median(values):
    ordered = sorted(values)
    return ordered[len(ordered) // 2]


def clip(value):
    return -32768 if value < -32768 else (32767 if value > 32767 else value)


def scaled(channel, gain):
    if abs(gain - 1.0) < 0.02:
        return channel
    return array("h", [clip(int(v * gain)) for v in channel])


def crossfade(old, new, old_gain, new_gain):
    count = len(old)
    return array("h", [clip(int((a * old_gain * (count - i) + b * new_gain * i) / count))
                       for i, (a, b) in enumerate(zip(old, new))])


def left_only(raw):
    samples = array("h")
    samples.frombytes(raw[:len(raw) - len(raw) % 4])
    return samples[0::2].tobytes()


def parse_norms(text):
    """Сохранённые нормы микрофонов: «вид:источник=4 числа;…» → {(вид, источник): [4 числа]}."""
    norms = {}
    for item in str(text or "").split(";"):
        try:
            key, values = item.split("=")
            kind, source = key.split(":")
            numbers = [float(v) for v in values.split(",")]
            if kind in ("round", "voice") and len(numbers) == 4 and all(abs(v) < NORM_LIMIT for v in numbers):
                norms[(kind, int(source))] = numbers
        except ValueError:
            continue
    return norms


def format_norms(norms):
    return ";".join("%s:%d=%s" % (kind, source, ",".join("%.2f" % v for v in values))
                    for (kind, source), values in sorted(norms.items()))


def caller_kind(class_names):
    """Кто создаёт запись: кружок, голосовое или чужой код (звонки, камера и т. п.)."""
    for name in class_names:
        if name.startswith(ROUND_CALLERS):
            return "round"
        if name.startswith(VOICE_CALLERS):
            return "voice"
    return None


class MicPicker:
    """Выбор микрофона для одной записи. Получает чередующиеся стереосэмплы (левый, правый),
    возвращает моно того микрофона, который сейчас не заглушён.

    Норма (norm) — как микрофоны этого телефона обычно звучат в речи, всё в дБ: разница средних
    частот левый − правый, разница громкости и «яркость» каждого (средние частоты минус громкость).
    Дальний от рта микрофон может быть тише основного на 20 дБ и больше — это и есть норма."""

    def __init__(self, kind, mode, match_level, norm=None, rate=48000, source=0):
        self.kind, self.rate, self.source = kind, rate, source
        self.scratch = None                 # свой Java-буфер для стереочтения
        self.threshold, self.hold = MODE_RULES.get(mode, MODE_RULES[NORMAL])
        self.match_level = match_level
        self.norm = [float(v) for v in norm] if norm is not None and len(norm) == 4 else None
        self.warm = []                      # первая речь, пока нормы нет
        self.preferred = 0 if self.norm is None or self.norm[0] >= 0 else 1
        self.current = self.preferred
        self.fast = None                    # [разница, яркость Л, яркость П] относительно нормы
        self.recent = None                  # громкость речи каждого микрофона за последние секунды, дБ
        self.floor = None                   # шум каждого микрофона, дБ
        self.event = self.calm = 0.0
        self.seconds = self.backup_seconds = 0.0
        self.switches = 0
        self.log_at = 0.0
        self.last_dev = 0.0
        self.light = self.light_logged = False   # лёгкий режим: текущий микрофон без анализа
        self.slow_chunks = self.errors = 0

    def gain(self, channel):
        if not self.match_level or self.norm is None or channel == self.preferred:
            return 1.0
        if self.recent is not None:
            # Запасной звучит так же громко, как основной перед тем, как его закрыли.
            value = self.recent[self.preferred] - self.recent[channel]
        else:
            value = self.norm[1] if channel == 1 else -self.norm[1]
        value = max(GAIN_LIMITS[0], min(GAIN_LIMITS[1], value))
        return 1.0 if abs(value) < 1.0 else 10.0 ** (value / 20.0)

    def speech(self, levels, dt):
        """Есть ли голос: громкость хотя бы одного микрофона заметно выше его шума.
        В паузах оба микрофона звучат одинаково тихо — сравнивать там нечего."""
        if self.floor is None:
            self.floor = list(levels)
        active = False
        for i in (0, 1):
            if levels[i] < self.floor[i]:
                self.floor[i] += smoothing(dt, 0.05) * (levels[i] - self.floor[i])
            else:
                self.floor[i] += min(levels[i] - self.floor[i], NOISE_RISE * dt)
            active = active or levels[i] - self.floor[i] >= SPEECH_ABOVE
        return active

    def decide(self, mid_left, mid_right, level_left, level_right, dt):
        """Обновляет оценки и возвращает микрофон (0 — левый, 1 — правый) для этого кусочка."""
        mids = (db(mid_left), db(mid_right))
        levels = (db(level_left), db(level_right))
        if not self.speech(levels, dt):
            return self.current
        values = (mids[0] - mids[1], levels[0] - levels[1], mids[0] - levels[0], mids[1] - levels[1])
        if self.norm is None:
            # Нормы ещё нет: учим её по первой секунде речи (медиана — всплески не мешают),
            # а пока пишем с того микрофона, который заметно громче.
            self.warm.append(values)
            if len(self.warm) * dt < WARM_SECONDS:
                louder = (values[1], -values[1])
                return 1 - self.current if louder[1 - self.current] > WARM_MARGIN else self.current
            self.norm = [median(column) for column in zip(*self.warm)]
            self.warm = []
            if abs(self.norm[0]) >= WARM_MARGIN / 2:
                self.preferred = 0 if self.norm[0] >= 0 else 1
            else:
                self.preferred = self.current   # микрофоны почти одинаковы: не переключаться зря
            return self.preferred
        norm = self.norm
        now = (values[0] - norm[0], values[2] - norm[2], values[3] - norm[3])
        if self.fast is None:
            self.fast = list(now)
        k = smoothing(dt, FAST_TAU)
        for i in (0, 1, 2):
            self.fast[i] += k * (now[i] - self.fast[i])
        dev = self.last_dev = self.fast[0]
        # Насколько микрофон заглушён (дБ): относительно соседа и относительно себя обычного.
        muffled = (-dev, dev)
        dull = (-self.fast[1], -self.fast[2])
        current, other = self.current, 1 - self.current
        # Плотно закрытый микрофон Samsung может приглушить почти до нулей — ниже собственного шума
        # живого микрофона; «яркости» у такого канала нет, поэтому отдельная проверка.
        dead = levels[current] < DEAD_LEVEL
        covered = muffled[current] > self.threshold and (dull[current] > self.threshold * DULL_SHARE or dead)
        if current == self.preferred and not covered:
            # Норма медленно подстраивается под то, как человек держит телефон; пока основной
            # микрофон похож на закрытый — не учим, иначе палец станет «нормой».
            slow = smoothing(dt, LEARN_TAU if abs(dev) < self.threshold else LEARN_TAU * 3)
            for i in range(4):
                norm[i] += slow * (values[i] - norm[i])
            # Громкость на слух — среднее общей громкости и средних частот; пока основной закрыт
            # или пишет запасной, не меняется: по ней запасной подтягивается до прежней громкости.
            loud = ((levels[0] + mids[0]) * 0.5, (levels[1] + mids[1]) * 0.5)
            if self.recent is None:
                self.recent = list(loud)
            else:
                k = smoothing(dt, RECENT_TAU)
                for i in (0, 1):
                    self.recent[i] += k * (loud[i] - self.recent[i])
        if covered:
            # Закрыт пальцем: глуше соседа и глуше себя обычного. Шум трения пальца о соседний
            # микрофон делает соседа «ярче», но текущий от этого не глохнет — переключения нет.
            self.calm = 0.0
            self.event += dt
            if self.event >= self.hold:
                self.event = 0.0
                return other
            return current
        self.event = max(0.0, self.event - dt)
        if current != self.preferred:
            # Возврат, когда основной снова звучит как обычно; редкие всплески не обнуляют счёт.
            preferred = self.preferred
            if muffled[preferred] < self.threshold * 0.5 and dull[preferred] < self.threshold * 0.5:
                self.calm += dt
                if self.calm >= RETURN_AFTER:
                    self.calm = 0.0
                    return preferred
            elif muffled[preferred] > self.threshold:
                self.calm = 0.0
            else:
                self.calm = max(0.0, self.calm - dt)
        return current

    def process(self, raw):
        """Чередующийся стерео PCM 16 бит → моно байты половинной длины."""
        samples = array("h")
        samples.frombytes(raw[:len(raw) - len(raw) % 4])
        left, right = samples[0::2], samples[1::2]
        frames = len(left)
        if frames == 0:
            return b""
        dt = frames / float(self.rate)
        if self.light:
            self.seconds += dt
            if self.current != self.preferred:
                self.backup_seconds += dt
            return (left, right)[self.current].tobytes()
        level_left, mid_left = measure(left)
        level_right, mid_right = measure(right)
        choice = self.decide(mid_left, mid_right, level_left, level_right, dt)
        channels = (left, right)
        if choice != self.current:
            out = crossfade(channels[self.current], channels[choice], self.gain(self.current), self.gain(choice))
            self.current = choice
            self.switches += 1
        else:
            out = scaled(channels[choice], self.gain(choice))
        self.seconds += dt
        if self.current != self.preferred:
            self.backup_seconds += dt
        return out.tobytes()

    def note_time(self, spent, dt):
        """Сколько занял весь путь куска (ожидание Python, пересылка, анализ). Если телефон не
        успевает несколько раз подряд — дальше без анализа, но звук не прерывается."""
        if spent > dt * SLOW_SHARE:
            self.slow_chunks += 1
            self.light = self.light or self.slow_chunks >= SLOW_CHUNKS
        else:
            self.slow_chunks = 0

    def fail(self):
        """Ошибка обработки: после нескольких подряд — лёгкий режим до конца записи."""
        self.errors += 1
        self.light = self.light or self.errors >= 3


# ----- Helpers -------------------------------------------------------------------

def language():
    try:
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        code = str(info.baseLangCode or info.shortName or "en").lower().replace("_", "-")
    except Exception:
        code = "en"
    return "ru" if code.split("-")[0] == "ru" else "en"


def dp(value):
    return int(AndroidUtilities.dp(float(value)))


def on_main_thread():
    current = Looper.myLooper()
    return current is not None and current.equals(Looper.getMainLooper())


def foreground_value(color):
    value = int(color) & 0xFFFFFFFF
    channels = [((value >> shift) & 255) / 255.0 for shift in (16, 8, 0)]
    linear = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    luminance = sum(c * w for c, w in zip(linear, (0.2126, 0.7152, 0.0722)))
    return -16777216 if luminance > 0.179 else -1


def connected_background(index, count, selected, rtl, color, ripple):
    # M3 Expressive connected group: внутренние углы 8 dp, внешние и выбранный — полностью круглые.
    left = 24 if selected or (index == count - 1 if rtl else index == 0) else 8
    right = 24 if selected or (index == 0 if rtl else index == count - 1) else 8
    radii = jarray(jfloat)([float(dp(r)) for r in (left, left, right, right, right, right, left, left)])
    shape, mask = GradientDrawable(), GradientDrawable()
    for drawable in (shape, mask):
        drawable.setCornerRadii(radii)
    shape.setColor(jint(color))
    mask.setColor(jint(Color.WHITE))
    return RippleDrawable(ColorStateList.valueOf(jint(ripple)), shape, mask)


def tonal(color, radius):
    shape = GradientDrawable()
    shape.setCornerRadius(float(radius))
    shape.setColor(jint(color))
    return shape


def soft_haptic(view):
    effect_id = HapticFeedbackConstants.SEGMENT_FREQUENT_TICK if Build.VERSION.SDK_INT >= 34 else HapticFeedbackConstants.CLOCK_TICK
    return view.performHapticFeedback(effect_id)


def use_mvel_reflective(plugin):
    """MVEL через несколько сотен вызовов переключается на ASM-ускоритель, байткод которого
    ART не загружает, и фильтр молча отклоняет вызовы. Отражающий оптимизатор работает всегда."""
    try:
        System.setProperty("mvel2.disable.jit", "true")
        jclass("org.mvel2.optimizers.OptimizerFactory").setDefaultOptimizer("reflective")
        return True
    except Exception as error:
        plugin.report("MVEL", error)
        return False


def input_signature():
    """Набор входов звука: при подключении гарнитуры стерео проверяется заново."""
    try:
        manager = ApplicationLoader.applicationContext.getSystemService("audio")
        devices = manager.getDevices(1)   # AudioManager.GET_DEVICES_INPUTS
        return tuple(sorted(int(d.getType()) for d in devices))
    except Exception:
        return None


def thread_id():
    return int(Thread.currentThread().getId())


# ----- Hooks -------------------------------------------------------------------------

class CreateHook(MethodHook):
    """AudioRecord(source, rate, channels, format, size): запись кружка или голосового — в стерео."""
    def __init__(self, plugin): self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.before_create(param)
        except Exception as error:
            self.plugin.report("Создание записи", error)

    def after_hooked_method(self, param):
        try:
            self.plugin.after_create(param)
        except Exception as error:
            self.plugin.report("После создания записи", error)


class ReadHook(MethodHook):
    """read(byte[], int, int) и read(ByteBuffer, int) стереозаписи: плагин сам читает вдвое больше
    стерео и отдаёт ровно запрошенное число байт моно — размеры кусков и время у Telegram прежние."""
    def __init__(self, plugin, into_buffer):
        self.plugin, self.into_buffer = plugin, into_buffer

    def before_hooked_method(self, param):
        try:
            self.plugin.before_read(param, self.into_buffer)
        except Exception as error:
            self.plugin.report("Чтение звука", error)


class ReleaseHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.finish(param.thisObject)
        except Exception as error:
            self.plugin.report("Конец записи", error)


class LanguageHook(MethodHook):
    def __init__(self, plugin): self.plugin = plugin

    def after_hooked_method(self, param):
        if self.plugin.alive:
            run_on_ui_thread(self.plugin.sync_language)


class Click(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
    def __init__(self, plugin, value):
        super().__init__()
        self.plugin, self.value = plugin, value

    def onClick(self, *args):
        plugin = self.plugin
        try:
            if plugin is None or not plugin.alive:
                return
            soft_haptic(args[0])
            if plugin.mode != self.value:
                plugin.set_setting("mode", self.value)
                plugin.settings_changed()
        except Exception as error:
            if plugin is not None:
                plugin.report("Нажатие", error)


# ----- Plugin ---------------------------------------------------------------------------

LYU_GROUP_URL = "https://t.me/LyuPlugins"
LYU_AUTHOR_URL = "https://t.me/lyuto_bor"


def open_lyu_url(view, url):
    # Ссылки на группу и автора; Telegram сам откроет t.me внутри клиента.
    try:
        from org.telegram.messenger.browser import Browser
        context = view.getContext() if view is not None else None
        if context is None:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment is not None else None
        if context is not None:
            Browser.openUrl(context, url)
    except Exception:
        pass


def open_lyu_group(view=None, *args):
    open_lyu_url(view, LYU_GROUP_URL)


def open_lyu_author(view=None, *args):
    open_lyu_url(view, LYU_AUTHOR_URL)


class MicSwitchPlugin(BasePlugin):
    def on_plugin_load(self):
        self.alive = True
        self.plugin_avatar = _install_plugin_avatar(self)
        self.errors = set()
        self.pickers = {}        # identityHashCode записи → MicPicker
        self.pending = {}        # id потока → (вид записи, источник), пока идёт конструктор
        self.testing = set()     # потоки, в которых плагин сам проверяет стерео
        self.kinds = {}          # identityHashCode записи → (вид, источник, частота)
        self.stereo_ok = set()   # (источник, частота, входы), для которых стерео уже получалось
        self.norms = parse_norms(self.get_setting("norms", ""))   # (вид, источник) → норма микрофонов
        self.last = None
        self.controls = None
        self.native_plugin, self.ui_language = None, None
        # Записи, которые плагин перевёл в стерео: Java-набор для фильтра чтения.
        self.targets = Collections.newSetFromMap(Collections.synchronizedMap(WeakHashMap()))
        self.load_settings()
        self.settings_factory = SimpleSettingFactory(self.create_controls, self.bind_controls,
                                                     is_clickable=False, is_shadow=False)
        ours = None
        if use_mvel_reflective(self):
            ours = HookFilter.Condition("object.contains(param.thisObject)", object=self.targets)
        self.hook_audio(ours)
        self.hook_class("org.telegram.messenger.LocaleController", "applyLanguage", LanguageHook(self))
        run_on_ui_thread(self.sync_language)

    def on_plugin_unload(self):
        # Состояние записей не трогаем: идущая запись должна дочитаться в моно, пока SDK не снял хуки.
        self.alive = False
        _release_plugin_avatar(self)

        def clean():
            self.release_controls()
            if self.native_plugin is not None:
                set_private_field(self.native_plugin, "name", __name__)
                self.native_plugin.setDescription(__description__)
        if on_main_thread():
            clean()
        else:
            run_on_ui_thread(clean)

    def hook_audio(self, ours):
        try:
            target = JavaClass.forName(AUDIO_RECORD)
            ints = ["int"] * 5
            for constructor in target.getDeclaredConstructors():
                if [str(t.getName()) for t in constructor.getParameterTypes()] == ints:
                    self.hook_method(constructor, CreateHook(self))
            for method in target.getDeclaredMethods():
                name = str(method.getName())
                types = [str(t.getName()) for t in method.getParameterTypes()]
                if name == "read" and types in (["[B", "int", "int"], ["java.nio.ByteBuffer", "int"]):
                    hook = ReadHook(self, types[0] == "java.nio.ByteBuffer")
                elif name == "release" and not types:
                    hook = ReleaseHook(self)
                else:
                    continue
                if ours is None:
                    self.hook_method(method, hook)
                else:
                    self.hook_method(method, before=hook.before_hooked_method, before_filters=[ours])
        except Exception as error:
            self.report("Подключение AudioRecord", error)

    def hook_class(self, class_name, name, hook):
        try:
            loader = ApplicationLoader.applicationContext.getClassLoader()
            for method in JavaClass.forName(class_name, False, loader).getDeclaredMethods():
                if str(method.getName()) == name:
                    self.hook_method(method, hook)
        except Exception as error:
            self.report("Подключение " + name, error)

    def report(self, action, error):
        message = action + ": " + str(error)
        if message not in self.errors:
            self.errors.add(message)
            Log.e(TAG, message)

    def load_settings(self):
        self.mode = max(0, min(len(MODES) - 1, int(self.get_setting("mode", NORMAL) or 0)))
        self.switches = {key: bool(self.get_setting(key, default)) for key, default in SWITCHES}

    # --- recording ---------------------------------------------------------------

    def before_create(self, param):
        tid = thread_id()
        self.pending.pop(tid, None)
        if not self.alive or tid in self.testing:
            return
        args = param.args
        source, rate, channels, encoding, size = (int(args[i]) for i in range(5))
        if channels != MONO or encoding != PCM_16:
            return
        names = [str(e.getClassName()) for e in Thread.currentThread().getStackTrace()]
        kind = caller_kind(names)
        if kind is None or not self.switches.get(kind, False):
            return
        AudioRecord = jclass(AUDIO_RECORD)
        minimum = int(AudioRecord.getMinBufferSize(rate, STEREO, PCM_16))
        if minimum <= 0:
            self.remember_mono(kind)
            return
        # Запас на заминки: у голосовых свой буфер всего ~40 мс. Больший буфер не добавляет
        # задержки — чтение отдаёт звук, как только он есть.
        stereo_size = max(size * 2, minimum, int(rate * 4 * STALL_SECONDS))
        key = (source, rate, input_signature())
        if key[2] is None or key not in self.stereo_ok:
            # Пробная стереозапись с теми же параметрами (один раз, 15–60 мс, в фоновом потоке
            # записи): если телефон её не даёт, Telegram получает свою моно-запись без изменений.
            started = time.perf_counter()
            self.testing.add(tid)
            try:
                probe = AudioRecord(source, rate, STEREO, PCM_16, stereo_size)
                ok = int(probe.getState()) == 1 and int(probe.getChannelCount()) == 2
                probe.release()
            except Exception as error:
                self.report("Проверка стерео", error)
                ok = False
            finally:
                self.testing.discard(tid)
            Log.i(TAG, "%s: source=%d stereo=%s check=%.1f ms" % (kind, source, ok, (time.perf_counter() - started) * 1000))
            if not ok:
                self.remember_mono(kind)
                return
            self.stereo_ok.add(key)
        self.pending[tid] = (kind, source, rate, key)
        args[4] = jint(stereo_size)
        args[2] = jint(STEREO)            # последним: до этого запись остаётся обычной моно

    def after_create(self, param):
        info = self.pending.pop(thread_id(), None)
        if info is None:
            return
        record = param.thisObject
        kind, source, rate, key = info
        if param.getThrowable() is not None or int(record.getState()) != 1 or int(record.getChannelCount()) != 2:
            self.stereo_ok.discard(key)   # в следующий раз снова проверить заранее
            self.remember_mono(kind)
            return
        # Сначала — в набор: даже если дальше что-то сломается, чтение этой записи сведёт стерео в моно.
        self.targets.add(record)
        self.kinds[int(System.identityHashCode(record))] = (kind, source, rate)
        picker = self.picker_for(record)
        Log.i(TAG, "%s: stereo capture, source=%d main=%s" % (
            kind, source, "?" if picker.norm is None else "LR"[picker.preferred]))

    def picker_for(self, record):
        """Состояние записи; если его нет (сбой, переполнение), создаётся заново — звук важнее нормы."""
        ident = int(System.identityHashCode(record))
        picker = self.pickers.get(ident)
        if picker is None:
            kind, source, rate = self.kinds.get(ident, ("round", 0, int(record.getSampleRate())))
            picker = MicPicker(kind, self.mode, self.switches.get("level", True), self.norms.get((kind, source)), rate, source)
            while len(self.pickers) >= 8:
                # Записи без release: не копить, выбрасывать самые старые.
                self.pickers.pop(next(iter(self.pickers)))
            self.pickers[ident] = picker
        return picker

    def before_read(self, param, into_buffer):
        record = param.thisObject
        if not self.targets.contains(record):
            return                       # без Java-фильтра сюда приходят и чужие записи
        target = param.args[0]
        if into_buffer:
            offset, wanted = int(target.position()), int(param.args[1])
        else:
            offset, wanted = int(param.args[1]), int(param.args[2])
        wanted -= wanted % 2
        if wanted <= 0:
            return
        picker = self.picker_for(record)
        scratch = picker.scratch
        if scratch is None or len(scratch) < wanted * 2:
            scratch = picker.scratch = jarray(jbyte)(wanted * 2)
        # Четырёхаргументный read(…, READ_BLOCKING) плагин не перехватывает. Сам вызов Java
        # отпускает GIL: пока ждём микрофон, Python остальных плагинов работает.
        count = int(record.read(scratch, jint(0), jint(wanted * 2), jint(0)))
        if count <= 0:
            param.setResult(jint(count))  # 0 или код ошибки — как вернула бы система
            return
        count -= count % 4
        started = time.perf_counter()
        # С этого места стерео уже прочитано: Telegram обязан получить моно при любой ошибке.
        try:
            raw = bytes(scratch)[:count]
            try:
                mono = picker.process(raw)
            except Exception as error:
                picker.fail()
                self.report("Обработка звука", error)
                mono = left_only(raw)
            out = jarray(jbyte)(mono)
        except Exception as error:
            self.report("Сведение в моно", error)
            out = jarray(jbyte)(count // 2)  # тишина нужной длины лучше стерео-каши
            mono = bytes(count // 2)
        if into_buffer:
            # Система пишет в буфер, не глядя на limit; Telegram голосовых может оставить его
            # от прошлого куска. Пишем так же и возвращаем позицию и limit как были.
            limit = int(target.limit())
            target.limit(target.capacity())
            target.put(out, 0, len(mono))
            target.position(offset)
            target.limit(limit)
        else:
            System.arraycopy(out, 0, target, offset, len(mono))
        param.setResult(jint(len(mono)))
        picker.note_time(time.perf_counter() - started, count / 4.0 / picker.rate)
        if picker.light and not picker.light_logged:
            picker.light_logged = True
            Log.w(TAG, "%s: light mode (slow phone or errors) at t=%.1f" % (picker.kind, picker.seconds))
        self.trace(picker)

    def trace(self, picker):
        if picker.seconds - picker.log_at >= 0.5:
            picker.log_at = picker.seconds
            if picker.fast is None:
                Log.d(TAG, "%s t=%.1f mic=%s learning" % (picker.kind, picker.seconds, "LR"[picker.current]))
                return
            Log.d(TAG, "%s t=%.1f mic=%s dev=%+.1f dull=%+.1f/%+.1f norm=%+.1f/%+.1f switches=%d" % (
                picker.kind, picker.seconds, "LR"[picker.current], picker.last_dev, -picker.fast[1],
                -picker.fast[2], picker.norm[0], picker.norm[1], picker.switches))

    def finish(self, record):
        ident = int(System.identityHashCode(record))
        picker = self.pickers.pop(ident, None)
        self.kinds.pop(ident, None)
        self.targets.remove(record)
        if picker is None or picker.seconds < 0.3:
            return
        norm = picker.norm
        if norm is not None and all(abs(v) < NORM_LIMIT for v in norm):
            self.norms[(picker.kind, picker.source)] = list(norm)
            run_on_ui_thread(self.save_norms)
        self.last = {"kind": picker.kind, "stereo": True, "seconds": picker.seconds,
                     "switches": picker.switches, "backup": picker.backup_seconds}
        Log.i(TAG, "%s finished: %.1f s, switches=%d, backup=%.1f s, norm=%s" % (
            picker.kind, picker.seconds, picker.switches, picker.backup_seconds,
            "none" if norm is None else "/".join("%+.1f" % v for v in norm)))
        run_on_ui_thread(self.refresh_controls)

    def save_norms(self):
        # Норма — свойство микрофонов телефона: переживает перезапуск, первая запись сразу знает её.
        if self.alive:
            try:
                self.set_setting("norms", format_norms(self.norms))
            except Exception as error:
                self.report("Сохранение нормы", error)

    def remember_mono(self, kind):
        self.last = {"kind": kind, "stereo": False}
        run_on_ui_thread(self.refresh_controls)

    # --- language ------------------------------------------------------------------

    def tr(self, key):
        return STRINGS[key][1 if language() == "en" else 0]

    def sync_language(self):
        if not self.alive:
            return
        current = language()
        if current == self.ui_language:
            return
        self.ui_language = current
        try:
            from com.exteragram.messenger.plugins import PluginsController
            controller = PluginsController.getInstance()
            self.native_plugin = controller.plugins.get(__id__)
            if self.native_plugin is not None:
                set_private_field(self.native_plugin, "name", self.tr("title"))
                self.native_plugin.setDescription(self.tr("description"))
            controller.invalidatePluginSettings(__id__)
            controller.loadPluginSettings(__id__)
        except Exception as error:
            self.report("Язык", error)

    # --- settings ---------------------------------------------------------------------

    def create_settings(self):
        items = [Header(text=self.tr("where"))]
        for key, default in KINDS:
            items.append(Switch(key=key, text=self.tr(key), default=default,
                                subtext=self.tr(key + "_hint"), on_change=self.settings_changed))
        items += [Header(text=self.tr("switching")), Custom(factory=self.settings_factory.instance.java),
                  Switch(key="level", text=self.tr("level"), default=True,
                         subtext=self.tr("level_hint"), on_change=self.settings_changed),
                  Divider(text=self.tr("hint")),
                  Text(text="LyuPlugins", subtext=self.tr("group"), icon="msg_channel", on_click=open_lyu_group),
                  Text(text=self.tr("author"), subtext=self.tr("title") + " · " + __version__, icon="msg_openprofile", on_click=open_lyu_author)]
        return items

    def settings_changed(self, *args):
        self.load_settings()
        self.refresh_controls()

    def create_controls(self, context, *args):
        root = LinearLayout(context)
        try:
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(16), dp(4), dp(16), dp(10))
            root.setLayoutParams(jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")(-1, -2))
            self.release_controls()
            views = []
            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setBaselineAligned(False)
            row.setGravity(Gravity.CENTER_VERTICAL)
            for index in range(len(MODES)):
                button = TextView(context)
                button.setTextSize(14.0)
                button.setGravity(Gravity.CENTER)
                button.setIncludeFontPadding(False)
                button.setMaxLines(1)
                button.setMinHeight(dp(48))
                button.setFocusable(True)
                button.setOnClickListener(Click(self, index))
                params = LinearLayout.LayoutParams(0, dp(48), 1.0)
                params.gravity = Gravity.CENTER_VERTICAL
                if index > 0:
                    params.setMarginStart(dp(2))
                row.addView(button, params)
                views.append(("mode:%d" % index, button))
            root.addView(row, LinearLayout.LayoutParams(-1, dp(52)))
            mode_hint = TextView(context)
            mode_hint.setTextSize(13.0)
            mode_hint.setPadding(dp(4), dp(6), dp(4), 0)
            root.addView(mode_hint, LinearLayout.LayoutParams(-1, -2))

            card = LinearLayout(context)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(dp(16), dp(12), dp(16), dp(12))
            card_params = LinearLayout.LayoutParams(-1, -2)
            card_params.topMargin = dp(14)
            root.addView(card, card_params)
            title = TextView(context)
            title.setTextSize(14.0)
            title.setTypeface(AndroidUtilities.bold())
            card.addView(title, LinearLayout.LayoutParams(-1, -2))
            status = TextView(context)
            status.setTextSize(14.0)
            status.setPadding(0, dp(4), 0, 0)
            card.addView(status, LinearLayout.LayoutParams(-1, -2))
            views += [("row", row), ("mode_hint", mode_hint), ("card", card), ("title", title), ("status", status)]
            self.controls = {key: WeakReference(view) for key, view in views}
            self.refresh_controls()
        except Exception as error:
            self.report("Настройки", error)
        return root

    def bind_controls(self, view, *args):
        self.refresh_controls()

    def control(self, name):
        ref = self.controls.get(name) if self.controls else None
        return ref.get() if ref is not None else None

    def release_controls(self):
        if self.controls:
            for index in range(len(MODES)):
                view = self.control("mode:%d" % index)
                if view is not None:
                    view.setOnClickListener(None)
        self.controls = None

    def status_text(self):
        last = self.last
        if not last:
            return self.tr("last_none")
        if not last.get("stereo"):
            return self.tr("last_mono")
        text = self.tr("last_stats") % (self.tr("last_" + last["kind"]), int(round(last["seconds"])), last["switches"])
        if last["backup"] >= 0.5:
            text += self.tr("last_backup") % int(round(last["backup"]))
        return text

    def refresh_controls(self):
        if not self.controls:
            return
        try:
            accent_value = int(Theme.getColor(Theme.key_switchTrackChecked))
            accent = jint(accent_value)
            normal = jint(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            gray = jint(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
            for index, key in enumerate(MODES):
                button = self.control("mode:%d" % index)
                if button is None:
                    continue
                chosen = self.mode == index
                button.setText(self.tr(key))
                button.setContentDescription(self.tr("switching") + ": " + self.tr(key))
                button.setSelected(chosen)
                button.setTypeface(AndroidUtilities.bold() if chosen else None)
                button.setTextColor(jint(foreground_value(accent_value)) if chosen else normal)
                rtl = button.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL
                button.setBackground(connected_background(index, len(MODES), chosen, rtl,
                                                          accent_value if chosen else Theme.multAlpha(accent, 0.16),
                                                          Theme.multAlpha(accent, 0.24)))
            hint = self.control("mode_hint")
            if hint is not None:
                hint.setText(self.tr(MODES[self.mode] + "_hint"))
                hint.setTextColor(gray)
            card = self.control("card")
            if card is not None:
                card.setBackground(tonal(Theme.multAlpha(accent, 0.10), dp(24)))
            title = self.control("title")
            if title is not None:
                title.setText(self.tr("last"))
                title.setTextColor(normal)
            status = self.control("status")
            if status is not None:
                status.setText(self.status_text())
                status.setTextColor(gray)
        except Exception as error:
            self.report("Настройки", error)

