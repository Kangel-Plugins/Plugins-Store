"""Embedded offline artwork for enabled plugins; no frame or network callbacks.

Bundled verbatim by build_plugin_avatars.py so each .plugin stays standalone.
The public SDK metadata still contains a valid fallback sticker reference.
"""

class _LyuAvatarHook(MethodHook):
    def __init__(self, avatar):
        self.avatar = avatar

    def before_hooked_method(self, param):
        avatar = self.avatar
        if not avatar.active or str(param.args[1]) != avatar.pack:
            return
        try:
            from java.lang.ref import WeakReference
            view = param.args[0]
            view.setImageBitmap(avatar.bitmap)
            key = int(view.hashCode())
            # List holders are recycled. Retain only weak references, once each.
            avatar.views = {k: ref for k, ref in avatar.views.items() if ref.get() is not None}
            avatar.views[key] = WeakReference(view)
            param.setResult(None)
        except Exception:
            # Suppress a request for this private local alias even on failure.
            param.setResult(None)
            avatar.plugin.logger.exception("Unable to bind embedded plugin avatar")


class _LyuPluginAvatar:
    def __init__(self, plugin):
        from android.graphics import BitmapFactory
        from android.util import Base64
        from java.lang import Class
        from base_plugin import HookFilter
        self.plugin = plugin
        self.active = True
        self.views = {}
        self.native = None
        self.original = None
        self.pack = "LyuLocalAvatar_" + __id__
        raw = Base64.decode(_LYU_AVATAR_PNG, 0)
        self.bitmap = BitmapFactory.decodeByteArray(raw, 0, len(raw))
        if self.bitmap is None:
            raise ValueError("Invalid embedded avatar PNG")
        cls = Class.forName("org.telegram.messenger.MediaDataController", False,
                            ApplicationLoader.applicationContext.getClassLoader())
        method = next(m for m in cls.getDeclaredMethods()
                      if str(m.getName()) == "setPlaceholderImageByIndex"
                      and len(m.getParameterTypes()) == 4)
        method.setAccessible(True)
        hook = _LyuAvatarHook(self)
        plugin.hook_method(method, before=hook.before_hooked_method,
                           before_filters=[HookFilter.ArgumentEqual(1, self.pack)])
        run_on_ui_thread(self.apply)

    def apply(self):
        if not self.active or not self.plugin.alive:
            return
        from com.exteragram.messenger.plugins import PluginsController
        self.native = PluginsController.getInstance().plugins.get(__id__)
        if self.native is not None:
            self.original = str(self.native.getIcon() or __icon__)
            self.native.setIcon(self.pack + "/0")

    def close(self):
        self.active = False
        def restore():
            from org.telegram.messenger import MediaDataController, UserConfig
            if self.native is not None and str(self.native.getIcon()) == self.pack + "/0":
                self.native.setIcon(self.original or __icon__)
                pack, index = (self.original or __icon__).rsplit("/", 1)
                for ref in self.views.values():
                    view = ref.get()
                    if view is None:
                        continue
                    # A recycled holder may now belong to another plugin.
                    parent = view.getParent()
                    while parent is not None:
                        if str(parent.getClass().getName()) == "com.exteragram.messenger.plugins.ui.components.PluginCell":
                            native = get_private_field(parent, "plugin")
                            if native is not None and str(native.getId()) == __id__:
                                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(
                                    view, pack, int(index), "100_100")
                            break
                        parent = parent.getParent() if hasattr(parent, "getParent") else None
            self.views.clear()
            # Do not recycle a bitmap still referenced by an Android ImageReceiver.
            self.bitmap = None
            self.native = None
        run_on_ui_thread(restore)


def _install_plugin_avatar(plugin):
    try:
        return _LyuPluginAvatar(plugin)
    except Exception:
        plugin.logger.exception("Embedded plugin avatar is unavailable; keeping SDK fallback")
        return None


def _release_plugin_avatar(plugin):
    avatar = getattr(plugin, "plugin_avatar", None)
    if avatar is not None:
        avatar.close()
        plugin.plugin_avatar = None

# END EMBEDDED LYU PLUGIN AVATAR
