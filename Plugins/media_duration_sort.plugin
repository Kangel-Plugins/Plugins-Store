from typing import Any, Dict, List, Optional, Tuple

from java import dynamic_proxy, jclass
from java.lang import Runnable, Runtime
from java.lang.ref import WeakReference
from java.util import ArrayList
from org.telegram.messenger import DialogObject, MessageObject, MessagesController, NotificationCenter, UserConfig
from org.telegram.tgnet import ConnectionsManager, TLRPC

from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import PLUGINS_QUEUE, RequestCallback, run_on_queue
from hook_utils import find_class
from ui.bulletin import BulletinHelper

__id__ = "media_duration_sort"
__name__ = "Media Duration"
__description__ = "добавляет в меню общих медиа сортировку видео по длительности"
__author__ = "@mishabotov & @itskotovski"
__version__ = "3.0 [remaked]"
__icon__ = "Icon1_by_TgEmojis_bot/163"

LAYOUT_CLASS = "org.telegram.ui.Components.SharedMediaLayout"
DATA_CLASS = LAYOUT_CLASS + "$SharedMediaData"
PAGE_CLASS = LAYOUT_CLASS + "$MediaPage"
OPTIONS_CLASS = "org.telegram.ui.Components.ItemOptions"
CELL_CLASS = "org.telegram.ui.Cells.SharedPhotoVideoCell2"

LABEL_LONG = "Сначала длинные"
LABEL_SHORT = "Сначала короткие"

LONG = 1
SHORT = 2
TAB_MEDIA = 0
FILTER_VIDEOS = 2
PAGE_SIZE = 100
POSITIONS = 100
SPLIT = 600
LANES = 3
RETRIES = 3
FLOOD_MAX = 300
RESERVE = 0.2
INT_MAX = 2147483647


def field(cls, name: str):
    current = cls
    while current is not None:
        try:
            result = current.getDeclaredField(name)
            result.setAccessible(True)
            return result
        except Exception:
            current = current.getSuperclass()
    return None


def methods(cls, name: str, count: int) -> List[Any]:
    found = []
    for item in list(cls.getDeclaredMethods()):
        if item.getName() == name and len(item.getParameterTypes()) == count:
            item.setAccessible(True)
            found.append(item)
    return found


def roomy() -> bool:
    runtime = Runtime.getRuntime()
    limit = int(runtime.maxMemory())
    used = int(runtime.totalMemory()) - int(runtime.freeMemory())
    return limit - used > limit * RESERVE


class Lane:
    def __init__(self, did: int, index: int, peer, offset: int, stop: Optional[int]):
        self.did = did
        self.index = index
        self.peer = peer
        self.offset = offset
        self.stop = stop
        self.tries = 0


class Sort:
    def __init__(self, layout, data, fragment, mode: int):
        self.ref = WeakReference(layout)
        self.data = data
        self.fragment = WeakReference(fragment)
        self.mode = mode
        self.account = int(fragment.getCurrentAccount())
        self.guid = int(ConnectionsManager.generateClassGuid())
        self.did = 0
        self.merge = 0
        self.topic = 0
        self.saved = None
        self.peer = None
        self.origin = INT_MAX
        self.acc = None
        self.meta: Dict[Tuple[int, int], Tuple[float, int]] = {}
        self.order: List[Tuple[int, int]] = []
        self.pending: List[Lane] = []
        self.active = 0
        self.total = 0
        self.loading = True
        self.capped = False
        self.request = -1
        self.filter = 0


class MediaDurationPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.alive = False
        self.fields: Dict[str, Any] = {}
        self.change = None
        self.states: List[Sort] = []
        self.layouts: List[Any] = []
        self.shown = None

    def on_plugin_load(self):
        self.alive = True
        try:
            self.resolve()
            self.install()
        except Exception as error:
            self.alive = False
            self.log(f"Media Duration не запущен: {error}")

    def on_plugin_unload(self):
        self.alive = False
        run_on_ui_thread(self.teardown)

    def resolve(self):
        layout = find_class(LAYOUT_CLASS).getClass()
        data = find_class(DATA_CLASS).getClass()
        page = find_class(PAGE_CLASS).getClass()
        options = find_class(OPTIONS_CLASS).getClass()
        wanted = {
            "media": (layout, "sharedMediaData"),
            "pages": (layout, "mediaPages"),
            "owner": (layout, "profileActivity"),
            "dialog": (layout, "dialog_id"),
            "merge": (layout, "mergeDialogId"),
            "topic": (layout, "topicId"),
            "info": (layout, "info"),
            "offset": (data, "startOffset"),
            "stubs": (data, "endLoadingStubs"),
            "manager": (page, "layoutManager"),
            "fragment": (options, "fragment"),
            "scrim": (options, "scrimView"),
        }
        for key, (cls, name) in wanted.items():
            value = field(cls, name)
            if value is None:
                raise RuntimeError(f"нет поля {name}")
            self.fields[key] = value
        found = methods(layout, "changeMediaFilterType", 0)
        if not found:
            raise RuntimeError("нет changeMediaFilterType")
        self.change = found[0]

    def install(self):
        layout = find_class(LAYOUT_CLASS).getClass()
        options = find_class(OPTIONS_CLASS).getClass()
        show = methods(options, "show", 0)
        if not show:
            raise RuntimeError("нет ItemOptions.show")
        self.hook_method(show[0], ShowHook(self))
        for ctor in list(layout.getDeclaredConstructors()):
            ctor.setAccessible(True)
            self.hook_method(ctor, TrackHook(self))
        for item in methods(layout, "updateFastScrollVisibility", 2):
            self.hook_method(item, ScrollHook(self))
        for item in methods(layout, "didReceivedNotification", 3):
            self.hook_method(item, NotifyHook(self))
        try:
            cell = find_class(CELL_CLASS).getClass()
            for item in methods(cell, "setMessageObject", 2):
                self.hook_method(item, ThumbHook(self))
        except Exception as error:
            self.log(f"Без превью-заглушек: {error}")

    def teardown(self):
        for state in list(self.states):
            try:
                self.drop(state, True)
            except Exception as error:
                self.log(f"Не удалось вернуть порядок: {error}")
        self.states.clear()
        self.layouts.clear()
        self.shown = None

    def track(self, layout):
        alive = []
        for ref in self.layouts:
            item = ref.get()
            if item is None:
                continue
            if item.equals(layout):
                return
            alive.append(ref)
        alive.append(WeakReference(layout))
        self.layouts = alive

    def media(self, layout):
        array = self.fields["media"].get(layout)
        return array[0] if array is not None and len(array) > 0 else None

    def pages(self, layout) -> List[Any]:
        array = self.fields["pages"].get(layout)
        if array is None:
            return []
        return [page for page in array if page is not None and int(page.selectedType) == TAB_MEDIA]

    def locate(self, options, scrim):
        for ref in list(self.layouts):
            layout = ref.get()
            if layout is not None and scrim.equals(layout.photoVideoOptionsItem):
                return layout
        fragment = self.fields["fragment"].get(options)
        if fragment is None:
            return None
        holder = field(fragment.getClass(), "sharedMediaLayout")
        layout = holder.get(fragment) if holder is not None else None
        if layout is not None and scrim.equals(layout.photoVideoOptionsItem):
            return layout
        return None

    @staticmethod
    def gone(state: Sort) -> bool:
        fragment = state.fragment.get()
        return state.ref.get() is None or fragment is None or bool(fragment.isFinished)

    @staticmethod
    def valid(state: Sort) -> bool:
        return not state.loading and state.request >= 0 and int(state.data.requestIndex) == state.request

    def state_of(self, layout) -> Optional[Sort]:
        found = None
        for state in list(self.states):
            if self.gone(state):
                self.drop(state, False)
            elif not state.loading and not self.valid(state):
                self.states.remove(state)
            elif found is None and state.ref.get().equals(layout):
                found = state
        return found

    def sorted(self, layout) -> bool:
        state = self.state_of(layout)
        return state is not None and self.valid(state)

    def inject(self, options):
        if not self.alive:
            return
        last = self.shown.get() if self.shown is not None else None
        if last is not None and last.equals(options):
            return
        scrim = self.fields["scrim"].get(options)
        if scrim is None:
            return
        layout = self.locate(options, scrim)
        if layout is None or int(layout.getClosestTab()) != TAB_MEDIA:
            return
        if DialogObject.isEncryptedDialog(int(self.fields["dialog"].getLong(layout))):
            return
        self.shown = WeakReference(options)
        state = self.state_of(layout)
        mode = state.mode if state is not None else 0
        options.addGap()
        for value, label in ((LONG, LABEL_LONG), (SHORT, LABEL_SHORT)):
            text = label
            if state is not None and state.loading and state.mode == value:
                text = f"{label} · {self.progress(state)}"
            options.addChecked(mode == value, text, Action(self.choose, options, layout, value))

    @staticmethod
    def progress(state: Sort) -> str:
        loaded = len(state.order)
        if state.total > 0:
            return f"{min(loaded, state.total)} из {state.total}"
        return f"{loaded}" if loaded else "загрузка…"

    def choose(self, options, layout, mode: int):
        try:
            options.dismiss()
        except Exception:
            pass
        if not self.alive:
            return
        try:
            state = self.state_of(layout)
            if state is None:
                self.start(layout, mode)
            elif state.mode == mode:
                self.drop(state, True)
            else:
                state.mode = mode
                if not state.loading:
                    self.arrange(state, layout, True, False)
        except Exception as error:
            self.log(f"Не удалось переключить сортировку: {error}")

    def start(self, layout, mode: int):
        fragment = self.fields["owner"].get(layout)
        data = self.media(layout)
        did = int(self.fields["dialog"].getLong(layout))
        if fragment is None or data is None or did == 0:
            return
        state = Sort(layout, data, fragment, mode)
        controller = MessagesController.getInstance(state.account)
        state.peer = controller.getInputPeer(did)
        if state.peer is None:
            return
        state.did = did
        state.merge = int(self.fields["merge"].getLong(layout))
        state.topic = int(self.fields["topic"].getLong(layout))
        if state.topic != 0 and did == int(UserConfig.getInstance(state.account).getClientUserId()):
            state.saved = controller.getInputPeer(state.topic)
        info = self.fields["info"].get(layout)
        if state.merge != 0 and info is not None:
            state.origin = int(info.migrated_from_max_id)
        state.acc = jclass(DATA_CLASS)()
        self.states.append(state)
        BulletinHelper.show_info("Загружаю все видео, чтобы отсортировать")
        if state.topic != 0 and state.saved is None:
            run_on_queue(lambda: self.plan(state, None, None), PLUGINS_QUEUE)
            return
        request = TLRPC.TL_messages_getSearchResultsPositions()
        request.peer = state.peer
        request.filter = TLRPC.TL_inputMessagesFilterVideo()
        request.offset_id = 0
        request.limit = POSITIONS
        if state.saved is not None:
            request.saved_peer_id = state.saved
            request.flags |= 4
        self.send(state, request, lambda response, error: self.plan(state, response, error))

    def send(self, state: Sort, request, callback):
        manager = ConnectionsManager.getInstance(state.account)
        token = manager.sendRequest(
            request,
            RequestCallback(lambda response, error: run_on_queue(lambda: callback(response, error), PLUGINS_QUEUE)),
        )
        manager.bindRequestToGuid(token, state.guid)

    def plan(self, state: Sort, response, error):
        if not state.loading:
            return
        cuts = []
        if response is not None and error is None:
            state.total = int(response.count)
            cuts = sorted({int(item.msg_id) for item in list(response.positions.toArray()) if int(item.msg_id) > 0}, reverse=True)
        if state.total > SPLIT and cuts:
            starts = [0] + [cut + 1 for cut in cuts]
            stops = cuts + [None]
            state.pending = [Lane(state.did, 0, state.peer, start, stop) for start, stop in zip(starts, stops)]
        else:
            state.pending = [Lane(state.did, 0, state.peer, 0, None)]
        if state.merge != 0:
            peer = MessagesController.getInstance(state.account).getInputPeer(state.merge)
            if peer is not None:
                state.pending.append(Lane(state.merge, 1, peer, state.origin, None))
        self.pump(state)

    def pump(self, state: Sort):
        while state.loading and not state.capped and state.pending and state.active < LANES:
            lane = state.pending.pop(0)
            state.active += 1
            self.fetch(state, lane)
        if state.loading and state.active == 0 and (state.capped or not state.pending):
            self.complete(state)

    def fetch(self, state: Sort, lane: Lane):
        if not state.loading:
            return
        request = TLRPC.TL_messages_search()
        request.peer = lane.peer
        request.q = ""
        request.filter = TLRPC.TL_inputMessagesFilterVideo()
        request.limit = PAGE_SIZE
        request.offset_id = lane.offset
        if lane.index == 0 and state.topic != 0:
            if state.saved is not None:
                request.saved_peer_id = state.saved
                request.flags |= 4
            else:
                request.top_msg_id = state.topic
                request.flags |= 2
        self.send(state, request, lambda response, error: self.page(state, lane, response, error))

    def page(self, state: Sort, lane: Lane, response, error):
        if not state.loading:
            return
        if self.gone(state):
            run_on_ui_thread(lambda: self.drop(state, False))
            return
        if error is not None or response is None:
            self.retry(state, lane, str(error.text) if error is not None else "")
            return
        lane.tries = 0
        if state.total == 0:
            state.total = int(response.count)
        users = response.users
        chats = response.chats
        run_on_ui_thread(lambda: self.adopt(state.account, users, chats))
        messages = response.messages
        done = True
        lowest = None
        for i in range(int(messages.size())):
            message = messages.get(i)
            mid = int(message.id)
            if lane.stop is not None and mid <= lane.stop:
                break
            done = False
            if lowest is None or mid < lowest:
                lowest = mid
            key = (lane.did, mid)
            if key in state.meta:
                continue
            obj = MessageObject(state.account, message, False, False)
            if state.acc.addMessage(obj, lane.index, False, False):
                state.meta[key] = (float(obj.getDuration()), int(message.date))
                state.order.append(key)
        if lowest is None or (lane.offset > 0 and lowest >= lane.offset):
            done = True
        if not done and not roomy():
            state.capped = True
        if done or state.capped:
            state.active -= 1
            self.pump(state)
            return
        lane.offset = lowest
        self.fetch(state, lane)

    def retry(self, state: Sort, lane: Lane, text: str):
        if text.startswith("FLOOD_WAIT_"):
            try:
                seconds = int(text.rsplit("_", 1)[1])
            except ValueError:
                seconds = 5
            if seconds > FLOOD_MAX:
                self.fail(state, f"Telegram ограничил запросы на {seconds // 60} мин, попробуйте позже")
                return
            delay = (seconds + 1) * 1000
        else:
            lane.tries += 1
            if lane.tries > RETRIES:
                self.fail(state, "Не удалось загрузить видео")
                return
            delay = 1000 * lane.tries
        run_on_queue(lambda: self.fetch(state, lane), PLUGINS_QUEUE, delay)

    def fail(self, state: Sort, text: str):
        def finish():
            self.drop(state, False)
            BulletinHelper.show_error(text)

        run_on_ui_thread(finish)

    @staticmethod
    def adopt(account: int, users, chats):
        controller = MessagesController.getInstance(account)
        controller.putUsers(users, False)
        controller.putChats(chats, False)

    def complete(self, state: Sort):
        acc = state.acc
        keys = state.order
        index = self.rank(state, keys)
        items = acc.messages.toArray()
        result = ArrayList(len(index))
        for i in index:
            result.add(items[i])
        ordered = [keys[i] for i in index]
        run_on_ui_thread(lambda: self.apply(state, acc, result, ordered))

    @staticmethod
    def rank(state: Sort, keys: List[Tuple[int, int]]) -> List[int]:
        meta = state.meta
        sign = -1 if state.mode == LONG else 1
        return sorted(range(len(keys)), key=lambda i: (sign * meta[keys[i]][0], -meta[keys[i]][1], -keys[i][1]))

    def apply(self, state: Sort, acc, result, ordered: List[Tuple[int, int]]):
        layout = state.ref.get()
        if not state.loading or layout is None or self.gone(state):
            self.drop(state, False)
            return
        data = state.data
        state.loading = False
        state.acc = None
        state.order = ordered
        state.filter = int(data.filterType)
        data.filterType = FILTER_VIDEOS
        data.messages = result
        data.messagesDict = acc.messagesDict
        data.sections = acc.sections
        data.sectionArrays = acc.sectionArrays
        data.endReached[0] = True
        data.endReached[1] = True
        data.startReached = True
        data.loading = False
        data.loadingAfterFastScroll = False
        data.fastScrollPeriods.clear()
        data.fastScrollDataLoaded = True
        self.fields["offset"].setInt(data, 0)
        self.fields["stubs"].setInt(data, 0)
        for index in range(2):
            data.setTotalCount(index, int(acc.messagesDict[index].size()))
        data.requestIndex = int(data.requestIndex) + 1
        state.request = int(data.requestIndex)
        self.redraw(layout, True)
        if state.capped:
            BulletinHelper.show_info(f"Памяти хватило только на {len(ordered)} видео, отсортированы они")

    def arrange(self, state: Sort, layout, scroll: bool, rescan: bool):
        items = state.data.messages.toArray()
        keys = None
        if not rescan and len(items) == len(state.order) and len(items) > 0:
            head = items[0]
            tail = items[len(items) - 1]
            if (int(head.getDialogId()), int(head.getId())) == state.order[0] and (int(tail.getDialogId()), int(tail.getId())) == state.order[-1]:
                keys = list(state.order)
        run_on_queue(lambda: self.reorder(state, items, keys, scroll), PLUGINS_QUEUE)

    def reorder(self, state: Sort, items, keys: Optional[List[Tuple[int, int]]], scroll: bool):
        if keys is None:
            keys = self.scan(state, items)
        index = self.rank(state, keys)
        result = ArrayList(len(index))
        for i in index:
            result.add(items[i])
        ordered = [keys[i] for i in index]
        run_on_ui_thread(lambda: self.swap(state, result, ordered, len(keys), scroll))

    @staticmethod
    def scan(state: Sort, items) -> List[Tuple[int, int]]:
        keys = []
        meta = state.meta
        for i in range(len(items)):
            obj = items[i]
            key = (int(obj.getDialogId()), int(obj.getId()))
            if key not in meta:
                meta[key] = (float(obj.getDuration()), int(obj.messageOwner.date))
            keys.append(key)
        return keys

    def swap(self, state: Sort, result, ordered: List[Tuple[int, int]], size: int, scroll: bool):
        layout = state.ref.get()
        if layout is None or state not in self.states or not self.valid(state):
            return
        if int(state.data.messages.size()) != size:
            self.arrange(state, layout, scroll, True)
            return
        state.data.messages = result
        state.order = ordered
        self.redraw(layout, scroll)

    def redraw(self, layout, scroll: bool):
        for page in self.pages(layout):
            page.fastScrollEnabled = False
            try:
                layout.updateFastScrollVisibility(page, False)
            except Exception:
                pass
            if scroll:
                manager = self.fields["manager"].get(page)
                if manager is not None:
                    manager.scrollToPositionWithOffset(0, 0)
        layout.updateAdapters()

    def refresh(self, layout):
        state = self.state_of(layout)
        if state is not None and self.valid(state):
            self.arrange(state, layout, False, True)

    def drop(self, state: Sort, restore: bool):
        if state in self.states:
            self.states.remove(state)
        if state.loading:
            state.loading = False
            state.acc = None
            state.pending = []
            try:
                ConnectionsManager.getInstance(state.account).cancelRequestsForGuid(state.guid)
            except Exception:
                pass
            return
        layout = state.ref.get()
        if not restore or layout is None or int(state.data.requestIndex) != state.request:
            return
        data = state.data
        data.filterType = state.filter
        if state.merge != 0:
            data.max_id[1] = state.origin
            data.endReached[1] = False
        self.change.invoke(layout)


class Action(dynamic_proxy(Runnable)):
    def __init__(self, callback, *args):
        super().__init__()
        self.callback = callback
        self.args = args

    def run(self):
        self.callback(*self.args)


class ShowHook(MethodHook):
    def __init__(self, plugin: MediaDurationPlugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.inject(param.thisObject)
        except Exception as error:
            self.plugin.log(f"Ошибка меню: {error}")


class TrackHook(MethodHook):
    def __init__(self, plugin: MediaDurationPlugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if self.plugin.alive:
                self.plugin.track(param.thisObject)
        except Exception:
            pass


class ScrollHook(MethodHook):
    def __init__(self, plugin: MediaDurationPlugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        plugin = self.plugin
        if not plugin.states:
            return
        try:
            page = param.args[0]
            if page is not None and int(page.selectedType) == TAB_MEDIA and plugin.sorted(param.thisObject):
                page.fastScrollEnabled = False
        except Exception:
            pass


class NotifyHook(MethodHook):
    def __init__(self, plugin: MediaDurationPlugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        plugin = self.plugin
        if not plugin.states:
            return
        try:
            if int(param.args[0]) == NotificationCenter.didReceiveNewMessages:
                plugin.refresh(param.thisObject)
        except Exception as error:
            plugin.log(f"Ошибка обновления порядка: {error}")


class ThumbHook(MethodHook):
    def __init__(self, plugin: MediaDurationPlugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if not self.plugin.states:
            return
        try:
            obj = param.args[0]
            if obj is not None and obj.strippedThumb is None:
                obj.createStrippedThumb()
        except Exception:
            pass
