from typing import Any, List
from android.view import ViewGroup
from android.widget import ImageView, TextView
from java.lang import Long as JLong
from java.util import ArrayList
from org.telegram.messenger import ApplicationLoader, MediaController, MessageObject, UserConfig
from org.telegram.tgnet import TLRPC
from org.telegram.ui import LaunchActivity
from android_utils import OnClickListener, log, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment, get_messages_controller, get_user_config, send_request
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from ui.settings import Input, Selector

__id__ = "music_tab"
__name__ = "Music Tab"
__description__ = "Заменяет кнопку «Контакты» на главном экране кнопкой «Музыка». По нажатию открывается последняя или первая музыка из Избранного или из выбранного чата."
__author__ = "@akresik"
__version__ = "1.0.0"
__icon__ = "Ryzhij_kot95/0"
__min_version__ = "13.1.1"
__category__ = ["media", "appearance"]

class TabsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._patch_activity(param.thisObject)
        except Exception as e:
            log(f"[MT] after_hooked_method error: {e}")

class MusicTabPlugin(BasePlugin):
    _drawable = None
    _icon_failed = False
    _fields_logged = False

    def on_plugin_load(self):
        try:
            activity_class = find_class("org.telegram.ui.MainTabsActivity")
            if activity_class is None:
                log("[MT] on_plugin_load error: MainTabsActivity not found")
                return
            for method_name in ("createView", "onResume"):
                unhooks = self.hook_all_methods(activity_class, method_name, TabsHook(self))
                if not unhooks:
                    log(f"[MT] on_plugin_load error: hook {method_name} not installed")
            run_on_ui_thread(self._patch_current)
        except Exception as e:
            log(f"[MT] on_plugin_load error: {e}")

    def _patch_current(self):
        try:
            candidates = []
            layout = LaunchActivity.instance.getActionBarLayout()
            stack = layout.getFragmentStack()
            for i in range(stack.size()):
                candidates.append(stack.get(i))
            last = get_last_fragment()
            if last is not None:
                candidates.append(last)
            for fragment in candidates:
                if fragment.getClass().getSimpleName() == "MainTabsActivity":
                    self._patch_activity(fragment)
                    return
            log("[MT] _patch_current error: MainTabsActivity instance not found")
        except Exception as e:
            log(f"[MT] _patch_current error: {e}")

    def _patch_activity(self, activity):
        try:
            tab = activity.tabs[1]
            if tab is None:
                log("[MT] _patch_activity error: contacts tab is None")
                return
            listener = OnClickListener(self._on_music_click)
            tab.setOnClickListener(listener)
            tab.setOnLongClickListener(None)
            self._patch_visuals(tab)
        except Exception as e:
            log(f"[MT] _patch_activity error: {e}")

    def _patch_visuals(self, tab):
        try:
            texts = []
            images = []
            self._collect(tab, texts, images)
            if not texts and not images:
                self._log_fields(tab)
                return
            for tv in texts:
                tv.setText("Музыка")
            drawable = self._get_icon()
            if drawable is not None:
                for iv in images:
                    iv.setImageDrawable(drawable)
        except Exception as e:
            log(f"[MT] _patch_visuals error: {e}")

    def _collect(self, view, texts, images):
        try:
            if view is None:
                return
            if isinstance(view, TextView):
                texts.append(view)
            elif isinstance(view, ImageView):
                images.append(view)
            elif isinstance(view, ViewGroup):
                for i in range(view.getChildCount()):
                    self._collect(view.getChildAt(i), texts, images)
        except Exception as e:
            log(f"[MT] _collect error: {e}")

    def _log_fields(self, tab):
        try:
            if self._fields_logged:
                return
            self._fields_logged = True
            names = []
            clazz = tab.getClass()
            while clazz is not None:
                for field in clazz.getDeclaredFields():
                    names.append(f"{field.getName()}:{field.getType().getSimpleName()}")
                clazz = clazz.getSuperclass()
            log(f"[MT] _log_fields error: no TextView or ImageView in {tab.getClass().getName()}, fields: {names}")
        except Exception as e:
            log(f"[MT] _log_fields error: {e}")

    def _get_icon(self):
        try:
            if self._drawable is not None:
                return self._drawable
            if self._icon_failed:
                return None
            context = ApplicationLoader.applicationContext
            resources = context.getResources()
            package = context.getPackageName()
            for name in ["files_music"]:
                res_id = resources.getIdentifier(name, "drawable", package)
                if res_id != 0:
                    self._drawable = context.getDrawable(res_id).mutate()
                    return self._drawable
            self._icon_failed = True
            log("[MT] _get_icon error: music icon resource not found")
            return None
        except Exception as e:
            self._icon_failed = True
            log(f"[MT] _get_icon error: {e}")
            return None

    def _resolve_dialog_id(self):
        try:
            if self.get_setting("chat_source", 0) == 0:
                return int(get_user_config().getClientUserId())
            raw = str(self.get_setting("chat_id", "")).strip()
            if not raw:
                return None
            try:
                value = int(raw)
            except ValueError:
                return None
            controller = get_messages_controller()
            if raw.startswith("-100"):
                chat_id = int(raw[4:])
                return -chat_id if controller.getChat(JLong(chat_id)) is not None else None
            if value < 0:
                return value if controller.getChat(JLong(-value)) is not None else None
            if controller.getUser(JLong(value)) is not None:
                return value
            if controller.getChat(JLong(value)) is not None:
                return -value
            return None
        except Exception as e:
            log(f"[MT] _resolve_dialog_id error: {e}")
            return None

    def _on_music_click(self, view):
        try:
            dialog_id = self._resolve_dialog_id()
            if dialog_id is None:
                BulletinHelper.show_error("Чат не найден")
                return
            peer = get_messages_controller().getInputPeer(dialog_id)
            if peer is None or isinstance(peer, TLRPC.TL_inputPeerEmpty):
                BulletinHelper.show_error("Чат не найден")
                return
            self._request_music(dialog_id, peer)
        except Exception as e:
            log(f"[MT] _on_music_click error: {e}")
            BulletinHelper.show_error("Чат не найден")

    def _request_music(self, dialog_id, peer):
        try:
            first = self.get_setting("music_order", 0) == 1
            req = TLRPC.TL_messages_search()
            req.peer = peer
            req.q = ""
            req.filter = TLRPC.TL_inputMessagesFilterMusic()
            req.limit = 1
            req.offset_id = 1 if first else 0
            req.add_offset = -1 if first else 0
            send_request(req, lambda response, error: self._on_music_response(dialog_id, response, error))
        except Exception as e:
            log(f"[MT] _request_music error: {e}")
            BulletinHelper.show_error("Музыка не найдена")

    def _on_music_response(self, dialog_id, response, error):
        try:
            if error is not None or response is None:
                BulletinHelper.show_error("Музыка не найдена")
                return
            messages = response.messages
            if messages is None or messages.size() == 0:
                BulletinHelper.show_error("Музыка не найдена")
                return
            message = messages.get(0)
            run_on_ui_thread(lambda: self._play_message(dialog_id, message))
        except Exception as e:
            log(f"[MT] _on_music_response error: {e}")
            BulletinHelper.show_error("Музыка не найдена")

    def _play_message(self, dialog_id, message):
        try:
            if message.dialog_id == 0:
                message.dialog_id = dialog_id
            message_object = MessageObject(UserConfig.selectedAccount, message, True, True)
            playlist = ArrayList()
            playlist.add(message_object)
            controller = MediaController.getInstance()
            try:
                controller.setPlaylist(playlist, message_object, dialog_id)
            except Exception as e:
                log(f"[MT] _play_message error: setPlaylist failed: {e}")
            if not controller.playMessage(message_object):
                BulletinHelper.show_error("Не удалось воспроизвести музыку")
        except Exception as e:
            log(f"[MT] _play_message error: {e}")
            BulletinHelper.show_error("Не удалось воспроизвести музыку")

    def _on_source_change(self, new_index):
        try:
            run_on_ui_thread(lambda: self.set_setting("chat_source", new_index, reload_settings=True))
        except Exception as e:
            log(f"[MT] _on_source_change error: {e}")

    def create_settings(self) -> List[Any]:
        try:
            settings = [
                Selector(
                    key="chat_source",
                    text="Чат с музыкой",
                    default=0,
                    items=["Избранное", "Свой"],
                    icon="msg_topic_restart",
                    on_change=self._on_source_change,
                ),
            ]
            if self.get_setting("chat_source", 0) == 1:
                settings.append(
                    Input(
                        key="chat_id",
                        text="ID чата",
                        default="",
                        subtext="ID канала, группы, личного чата или бота, с -100 или без",
                        icon="msg_edit",
                    )
                )
            settings.append(
                Selector(
                    key="music_order",
                    text="Какую открывать",
                    default=0,
                    items=["Последнюю", "Первую"],
                    icon="msg_reset",
                )
            )
            return settings
        except Exception as e:
            log(f"[MT] create_settings error: {e}")
            return []