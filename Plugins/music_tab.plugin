from typing import Any, List
from android.view import ViewGroup
from android.widget import ImageView
from java import jclass
from java.lang import Long as JLong
from java.util import ArrayList
from org.telegram.messenger import ApplicationLoader, MediaController, MessageObject, UserConfig
from org.telegram.tgnet import TLRPC
from org.telegram.ui import LaunchActivity
from android_utils import OnClickListener, log, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_messages_controller, get_user_config, send_request
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Selector

__id__ = "music_tab"
__name__ = "Music Tab"
__description__ = "Заменяет кнопку «Контакты» на главном экране кнопкой «Музыка». По нажатию открывается последняя или первая музыка из Избранного или из выбранного чата, либо трек из профиля."
__author__ = "@akresik"
__version__ = "1.1.0"
__icon__ = "Clawde/40"
__min_version__ = "13.1.1"
__category__ = ["media", "appearance"]

class TabsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._patch_activity(param.thisObject)
        except Exception as e:
            log(f"[MT] after_hooked_method error: {e}")

class MusicTabPlugin(BasePlugin):
    _drawable = None

    def on_plugin_load(self):
        try:
            activity_class = find_class("org.telegram.ui.MainTabsActivity")
            if activity_class is None:
                log("[MT] on_plugin_load error: MainTabsActivity not found")
                return
            for method_name in ("createView", "onResume"):
                if not self.hook_all_methods(activity_class, method_name, TabsHook(self)):
                    log(f"[MT] on_plugin_load error: hook {method_name} not installed")
            run_on_ui_thread(self._patch_current)
        except Exception as e:
            log(f"[MT] on_plugin_load error: {e}")

    def _patch_current(self):
        try:
            stack = LaunchActivity.instance.getActionBarLayout().getFragmentStack()
            for i in range(stack.size()):
                fragment = stack.get(i)
                if fragment.getClass().getSimpleName() == "MainTabsActivity":
                    self._patch_activity(fragment)
                    return
            log("[MT] _patch_current error: MainTabsActivity instance not found")
        except Exception as e:
            log(f"[MT] _patch_current error: {e}")

    def _patch_activity(self, activity):
        tabs = activity.tabs
        if tabs is None or tabs[1] is None:
            return
        tab = tabs[1]
        tab.setOnClickListener(OnClickListener(self._on_music_click))
        tab.setOnLongClickListener(None)
        tab.setText("Музыка")
        drawable = self._get_icon()
        image = self._find_image(tab)
        if drawable is not None and image is not None:
            image.setImageDrawable(drawable)

    def _find_image(self, view):
        if isinstance(view, ImageView):
            return view
        if isinstance(view, ViewGroup):
            for i in range(view.getChildCount()):
                image = self._find_image(view.getChildAt(i))
                if image is not None:
                    return image
        return None

    def _get_icon(self):
        if self._drawable is None:
            context = ApplicationLoader.applicationContext
            res_id = context.getResources().getIdentifier("files_music", "drawable", context.getPackageName())
            if res_id == 0:
                log("[MT] _get_icon error: music icon resource not found")
                return None
            self._drawable = context.getDrawable(res_id).mutate()
        return self._drawable

    def _resolve_dialog_id(self):
        try:
            if self.get_setting("chat_source", 0) == 0:
                return int(get_user_config().getClientUserId())
            raw = str(self.get_setting("chat_id", "")).strip()
            if not raw:
                return None
            try:
                value = int(raw)
            except ValueError:
                return None
            controller = get_messages_controller()
            if raw.startswith("-100"):
                chat_id = int(raw[4:])
                return -chat_id if controller.getChat(JLong(chat_id)) is not None else None
            if value < 0:
                return value if controller.getChat(JLong(-value)) is not None else None
            if controller.getUser(JLong(value)) is not None:
                return value
            if controller.getChat(JLong(value)) is not None:
                return -value
            return None
        except Exception as e:
            log(f"[MT] _resolve_dialog_id error: {e}")
            return None

    def _on_music_click(self, view):
        try:
            dialog_id = self._resolve_dialog_id()
            if dialog_id is None:
                BulletinHelper.show_error("Чат не найден")
                return
            if self.get_setting("music_source", 0) == 1:
                self._request_profile_music(dialog_id)
                return
            peer = get_messages_controller().getInputPeer(dialog_id)
            if peer is None or isinstance(peer, TLRPC.TL_inputPeerEmpty):
                BulletinHelper.show_error("Чат не найден")
                return
            self._request_chat_music(dialog_id, peer)
        except Exception as e:
            log(f"[MT] _on_music_click error: {e}")
            BulletinHelper.show_error("Чат не найден")

    def _request_chat_music(self, dialog_id, peer):
        first = self.get_setting("music_order", 0) == 1
        req = TLRPC.TL_messages_search()
        req.peer = peer
        req.q = ""
        req.filter = TLRPC.TL_inputMessagesFilterMusic()
        req.limit = 1
        req.offset_id = 1 if first else 0
        req.add_offset = -1 if first else 0
        send_request(req, lambda response, error: self._on_chat_music_response(dialog_id, response, error))

    def _on_chat_music_response(self, dialog_id, response, error):
        try:
            if error is not None or response is None or response.messages.size() == 0:
                BulletinHelper.show_error("Музыка не найдена")
                return
            message = response.messages.get(0)
            run_on_ui_thread(lambda: self._play_message(dialog_id, message))
        except Exception as e:
            log(f"[MT] _on_chat_music_response error: {e}")
            BulletinHelper.show_error("Музыка не найдена")

    def _play_message(self, dialog_id, message):
        if message.dialog_id == 0:
            message.dialog_id = dialog_id
        self._play_single(dialog_id, MessageObject(UserConfig.selectedAccount, message, True, True))

    def _request_profile_music(self, dialog_id, offset=0):
        try:
            if dialog_id <= 0:
                BulletinHelper.show_error("Музыка профиля есть только у пользователей")
                return
            input_user = get_messages_controller().getInputUser(dialog_id)
            if input_user is None:
                BulletinHelper.show_error("Пользователь не найден")
                return
            req = TLRPC.TL_getSavedMusic()
            req.id = input_user
            req.offset = offset
            req.limit = 1
            req.hash = 0
            send_request(req, lambda response, error: self._on_profile_music_response(dialog_id, offset, response, error))
        except Exception as e:
            log(f"[MT] _request_profile_music error: {e}")
            BulletinHelper.show_error("Музыка профиля не найдена")

    def _on_profile_music_response(self, dialog_id, offset, response, error):
        try:
            if error is not None or not isinstance(response, TLRPC.TL_savedMusic) or response.documents.size() == 0:
                BulletinHelper.show_error("Музыка профиля не найдена")
                return
            first = self.get_setting("music_order", 0) == 1
            count = int(response.count)
            if first and offset == 0 and count > 1:
                self._request_profile_music(dialog_id, count - 1)
                return
            document = response.documents.get(0)
            if first:
                run_on_ui_thread(lambda: self._play_profile_single(dialog_id, document))
            else:
                run_on_ui_thread(lambda: self._play_profile_list(dialog_id, document))
        except Exception as e:
            log(f"[MT] _on_profile_music_response error: {e}")
            BulletinHelper.show_error("Музыка профиля не найдена")

    def _play_profile_single(self, dialog_id, document):
        try:
            music_list = jclass("org.telegram.messenger.MessagesController$SavedMusicList")(UserConfig.selectedAccount, dialog_id)
            self._play_single(dialog_id, music_list.toMessageObject(document))
        except Exception as e:
            log(f"[MT] _play_profile_single error: {e}")
            BulletinHelper.show_error("Не удалось воспроизвести музыку")

    def _play_profile_list(self, dialog_id, document):
        try:
            music_list = jclass("org.telegram.messenger.MessagesController$SavedMusicList")(UserConfig.selectedAccount, dialog_id)
            music_list.setup(document)
            controller = MediaController.getInstance()
            controller.cleanup()
            controller.currentSavedMusicList = music_list
            playlist = controller.getPlaylist()
            playlist.clear()
            playlist.addAll(music_list.list)
            if not controller.playMessage(music_list.list.get(0)):
                BulletinHelper.show_error("Не удалось воспроизвести музыку")
        except Exception as e:
            log(f"[MT] _play_profile_list error: {e}")
            BulletinHelper.show_error("Не удалось воспроизвести музыку")

    def _play_single(self, dialog_id, message_object):
        try:
            playlist = ArrayList()
            playlist.add(message_object)
            controller = MediaController.getInstance()
            controller.setPlaylist(playlist, message_object, dialog_id)
            if not controller.playMessage(message_object):
                BulletinHelper.show_error("Не удалось воспроизвести музыку")
        except Exception as e:
            log(f"[MT] _play_single error: {e}")
            BulletinHelper.show_error("Не удалось воспроизвести музыку")

    def _reload_with(self, key, new_index):
        run_on_ui_thread(lambda: self.set_setting(key, new_index, reload_settings=True))

    def _on_source_change(self, new_index):
        self._reload_with("chat_source", new_index)

    def _on_music_source_change(self, new_index):
        self._reload_with("music_source", new_index)

    def _on_order_change(self, new_index):
        self._reload_with("music_order", new_index)

    def create_settings(self) -> List[Any]:
        try:
            own = self.get_setting("chat_source", 0) == 0
            from_profile = self.get_setting("music_source", 0) == 1
            settings = [
                Header(text="Музыка"),
                Selector(
                    key="music_source",
                    text="Где искать",
                    default=0,
                    items=["Из чата", "Из профиля"],
                    icon="msg_search",
                    on_change=self._on_music_source_change,
                ),
                Selector(
                    key="music_order",
                    text="Какой трек",
                    default=0,
                    items=["Последний", "Первый"],
                    icon="msg_reset",
                    on_change=self._on_order_change,
                ),
                Header(text="Чат"),
                Selector(
                    key="chat_source",
                    text="Чей чат",
                    default=0,
                    items=["Избранное", "Свой"],
                    icon="msg_topic_restart",
                    on_change=self._on_source_change,
                ),
            ]
            if own and from_profile:
                settings.append(Divider(text="Используется ваш профиль"))
            if not own:
                settings.append(
                    Input(
                        key="chat_id",
                        text="ID чата",
                        default="",
                        subtext="Канал, группа, личный чат или бот",
                        icon="msg_edit",
                    )
                )
                if from_profile:
                    settings.append(Divider(text="Музыка профиля есть только у пользователей"))
            return settings
        except Exception as e:
            log(f"[MT] create_settings error: {e}")
            return []