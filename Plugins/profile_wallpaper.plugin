import os
import threading

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Text, Selector, Divider
from ui.bulletin import BulletinHelper
from android_utils import run_on_ui_thread

__id__ = "profile_wallpaper"
__name__ = "Profile Wallpaper"
__description__ = "Свой фон для страницы вашего профиля: фото из галереи, размытие, затемнение и регулируемая прозрачность блоков.\nИсправлено: ошибка запуска «getName» на некоторых версиях exteraGram."
__author__ = "@JIl06uTeJIb_K0TuKoB"
__version__ = "1.4.4"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.10.6"
__category__ = ["appearance"]
__app_version__ = ">=12.10.6"

PICK_CODE = 90817
PERCENTS = [f"{i}%" for i in range(0, 101, 5)]  # шаг 5%
BLUR_ITEMS = ["Выкл", "Слабое", "Среднее", "Сильное", "Очень сильное", "Максимум"]



def _jcls(name):
    """Возвращает java.lang.Class (нужен hook_all_methods) независимо от версии клиента."""
    try:
        c = find_class(name)
        if c is not None and hasattr(c, "getName"):
            return c
    except Exception:
        pass
    try:
        from org.telegram.messenger import ApplicationLoader
        return ApplicationLoader.applicationContext.getClassLoader().loadClass(name)
    except Exception:
        from java.lang import Class
        return Class.forName(name)


class ProfileHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            view = param.getResult()
            run_on_ui_thread(lambda: self.plugin.apply_background(fragment, view))
        except Exception as e:
            self.plugin.logger.error(f"hook error: {e}")


class ResultHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if int(param.args[0]) != PICK_CODE:
                return
            if int(param.args[1]) != -1 or param.args[2] is None:  # RESULT_OK = -1
                return
            uri = param.args[2].getData()
            if uri is not None:
                self.plugin.save_picked(uri)
        except Exception as e:
            self.plugin.logger.error(f"result hook error: {e}")


class ProfileWallpaperPlugin(BasePlugin):
    _cache = None
    _lock = threading.Lock()

    def on_plugin_unload(self):
        self._cache = None

    def on_plugin_load(self):
        cls = _jcls("org.telegram.ui.ProfileActivity")
        if not cls:
            self.logger.error("ProfileActivity not found")
            return
        self.hook_all_methods(cls, "createView", ProfileHook(self))
        launch = _jcls("org.telegram.ui.LaunchActivity")
        if launch:
            self.hook_all_methods(launch, "onActivityResult", ResultHook(self))

    def pick_image(self, view=None):
        def launch():
            try:
                from android.content import Intent
                activity = None
                try:
                    from client_utils import get_last_fragment
                    frag = get_last_fragment()
                    if frag is not None:
                        activity = frag.getParentActivity()
                except Exception as e:
                    self.logger.error(f"last fragment: {e}")
                if activity is None:
                    from org.telegram.ui import LaunchActivity
                    activity = LaunchActivity.instance
                if activity is None:
                    BulletinHelper.show_error("Не нашёл активность Telegram")
                    return
                intent = Intent(Intent.ACTION_GET_CONTENT)
                intent.setType("image/*")
                intent.addCategory(Intent.CATEGORY_OPENABLE)
                activity.startActivityForResult(
                    Intent.createChooser(intent, "Выберите фото"), PICK_CODE)
            except Exception as e:
                self.logger.error(f"pick error: {e}")
                BulletinHelper.show_error(f"Ошибка: {e}")
        run_on_ui_thread(launch)

    def reset_image(self, view=None):
        self.set_setting("image_path", "", reload_settings=True)
        BulletinHelper.show_info("Фон сброшен")

    def save_picked(self, uri):
        from android.graphics import BitmapFactory, Bitmap
        from java.io import FileOutputStream
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        stream = ctx.getContentResolver().openInputStream(uri)
        bmp = BitmapFactory.decodeStream(stream)
        stream.close()
        if bmp is None:
            BulletinHelper.show_error("Не удалось открыть изображение")
            return
        biggest = max(bmp.getWidth(), bmp.getHeight())
        if biggest > 2048:
            s = 2048.0 / biggest
            bmp = Bitmap.createScaledBitmap(
                bmp, int(bmp.getWidth() * s), int(bmp.getHeight() * s), True)
        path = str(ctx.getFilesDir().getAbsolutePath()) + "/profile_wallpaper.jpg"
        out = FileOutputStream(path)
        bmp.compress(Bitmap.CompressFormat.JPEG, 92, out)
        out.close()
        self.set_setting("image_path", path, reload_settings=True)
        BulletinHelper.show_info("Фон выбран. Откройте профиль заново")

    def create_settings(self):
        has_img = bool(self.get_setting("image_path", ""))
        return [
            Header(text="Фон профиля"),
            Text(
                text="Выбрать фото",
                subtext="Фото выбрано" if has_img else "Фото не выбрано",
                icon="msg_photos",
                accent=True,
                on_click=self.pick_image,
            ),
            Text(
                text="Убрать фон",
                icon="msg_delete",
                red=True,
                on_click=self.reset_image,
            ),
            Header(text="Оформление"),
            Selector(key="blur", text="Размытие", default=0,
                     items=BLUR_ITEMS, icon="msg_theme"),
            Selector(key="dim_pct", text="Затемнение", default=6,
                     items=PERCENTS, icon="msg_theme"),
            Selector(key="opacity_pct", text="Плотность блоков", default=10,
                     items=PERCENTS, icon="msg_theme"),
            Divider(text="Плотность 0% — блоки полностью прозрачные, 100% — сплошные. "
                         "Фон виден только в вашем профиле, изменения применяются "
                         "при следующем открытии профиля."),
        ]

    def _field(self, obj, name):
        f = obj.getClass().getDeclaredField(name)
        f.setAccessible(True)
        return f.get(obj)

    def is_own_profile(self, fragment):
        try:
            from org.telegram.messenger import UserConfig
            f = fragment.getClass().getDeclaredField("userId")
            f.setAccessible(True)
            uid = int(f.getLong(fragment))
            me = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
            return uid != 0 and uid == me
        except Exception as e:
            self.logger.error(f"own profile check: {e}")
            return False

    def build_bitmap(self, path, sw, sh, blur):
        """Готовит картинку под экран. Результат кэшируется."""
        from android.graphics import BitmapFactory, Bitmap

        key = (path, os.path.getmtime(path), sw, sh, blur)
        with self._lock:
            if self._cache and self._cache[0] == key:
                return self._cache[1]

        opts = BitmapFactory.Options()
        opts.inJustDecodeBounds = True
        BitmapFactory.decodeFile(path, opts)
        opts.inSampleSize = max(1, min(opts.outWidth // sw, opts.outHeight // sh))
        opts.inJustDecodeBounds = False
        bmp = BitmapFactory.decodeFile(path, opts)
        if bmp is None:
            return None

        # обрезка по центру под пропорции экрана
        bw, bh = bmp.getWidth(), bmp.getHeight()
        target = sw / float(sh)
        if bw / float(bh) > target:
            cw, ch = int(bh * target), bh
        else:
            cw, ch = bw, int(bw / target)
        bmp = Bitmap.createBitmap(bmp, (bw - cw) // 2, (bh - ch) // 2, cw, ch)
        bmp = Bitmap.createScaledBitmap(bmp, sw, sh, True)

        if blur > 0:
            try:
                from org.telegram.messenger import Utilities
                if not bmp.isMutable():
                    bmp = bmp.copy(Bitmap.Config.ARGB_8888, True)
                Utilities.stackBlurBitmap(bmp, blur * 5)
            except Exception as e:
                self.logger.error(f"stackBlur failed, fallback: {e}")
                k = 2 + blur * 3
                small = Bitmap.createScaledBitmap(bmp, max(1, sw // k), max(1, sh // k), True)
                bmp = Bitmap.createScaledBitmap(small, sw, sh, True)

        with self._lock:
            self._cache = (key, bmp)
        return bmp

    def apply_background(self, fragment, view):
        # только для своего профиля
        if not self.is_own_profile(fragment):
            return
        path = self.get_setting("image_path", "")
        if not path or not os.path.exists(path):
            return

        from org.telegram.messenger import AndroidUtilities
        sw = int(AndroidUtilities.displaySize.x)
        sh = int(AndroidUtilities.displaySize.y)
        blur = int(self.get_setting("blur", 0))

        def work():
            try:
                bmp = self.build_bitmap(path, sw, sh, blur)
                if bmp is None:
                    self.logger.error("cannot decode image")
                    return
                run_on_ui_thread(lambda: self.finish_apply(fragment, view, bmp))
            except Exception as e:
                self.logger.error(f"build error: {e}")

        # тяжёлую работу делаем не в потоке интерфейса
        threading.Thread(target=work, daemon=True).start()

    def finish_apply(self, fragment, view, bmp):
        try:
            from android.graphics import Color
            from android.graphics.drawable import BitmapDrawable, ColorDrawable, LayerDrawable

            photo = BitmapDrawable(view.getContext().getResources(), bmp)
            dim = int(self.get_setting("dim_pct", 6)) * 5
            shade = ColorDrawable(Color.argb(int(255 * dim / 100), 0, 0, 0))
            view.setBackground(LayerDrawable([photo, shade]))

            # делаем прозрачными список и шапку
            for name, action in (
                ("listView", lambda v: v.setBackgroundColor(0)),
                ("topView", lambda v: v.setAlpha(0.0)),
            ):
                try:
                    v = self._field(fragment, name)
                    if v is not None:
                        action(v)
                except Exception as e:
                    self.logger.error(f"{name}: {e}")
            try:
                ab = fragment.getActionBar()
                if ab is not None:
                    ab.setBackgroundColor(0)
            except Exception as e:
                self.logger.error(f"actionBar: {e}")

            opacity = int(self.get_setting("opacity_pct", 10)) * 5
            self.set_blocks_alpha(view, opacity / 100.0)
        except Exception as e:
            self.logger.error(f"finish_apply: {e}")

    def set_blocks_alpha(self, view, alpha):
        try:
            from android.view import ViewGroup
            if isinstance(view, ViewGroup):
                for i in range(view.getChildCount()):
                    child = view.getChildAt(i)
                    bg = child.getBackground()
                    if bg is not None:
                        bg.setAlpha(int(255 * alpha))
                    self.set_blocks_alpha(child, alpha)
        except Exception as e:
            self.logger.error(f"alpha: {e}")
