from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from java import dynamic_proxy

__id__ = "catalog_corner"
__name__ = "CatalogCorner"
__description__ = "Переносит кнопку «Каталог плагинов» в правый верхний угол экрана «Плагины» и оставляет только иконку"
__author__ = "@LuPlugins (@optimist_opti)"
__version__ = "1.1"

ITEM_ID = 7701
DEDUPE_IDS = (2, 3)
ICON_CANDIDATES = ["menu_shop", "msg_shop", "msg_list"]
ACTIVITY = "com.exteragram.messenger.plugins.ui.PluginsActivity"
REPOS = "com.exteragram.messenger.plugins.catalog.ui.PluginRepositoriesActivity"


def _load_class(name):
    try:
        from org.telegram.messenger import ApplicationLoader
        return ApplicationLoader.applicationContext.getClassLoader().loadClass(name)
    except Exception:
        return None


def _find_field(obj, name):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            cls = cls.getSuperclass()
    return None


def _icon_res(context):
    res = context.getResources()
    pkg = context.getPackageName()
    for name in ICON_CANDIDATES:
        try:
            rid = int(res.getIdentifier(name, "drawable", pkg))
            if rid:
                return rid
        except Exception:
            continue
    return 0


def _open_catalog(activity, button):
    try:
        repos = find_class(REPOS)
        if repos is not None:
            activity.presentFragment(repos())
            return
    except Exception:
        pass
    try:
        if button is not None:
            button.performClick()
    except Exception:
        pass


def _dedupe(menu):
    seen = set()
    for i in range(int(menu.getChildCount())):
        try:
            child = menu.getChildAt(i)
            tag = child.getTag()
            if tag is None:
                continue
            key = int(tag)
        except Exception:
            continue
        if key in DEDUPE_IDS:
            if key in seen:
                child.setVisibility(8)
                try:
                    child.setClickable(False)
                except Exception:
                    pass
            else:
                seen.add(key)


class _Click(dynamic_proxy(find_class("android.view.View$OnClickListener"))):
    def __init__(self, activity, button):
        super().__init__()
        self.activity = activity
        self.button = button

    def onClick(self, v):
        _open_catalog(self.activity, self.button)


class _KeepHidden(dynamic_proxy(find_class("android.view.ViewTreeObserver$OnPreDrawListener"))):
    def __init__(self, button):
        super().__init__()
        self.button = button

    def onPreDraw(self):
        try:
            if int(self.button.getVisibility()) != 8:
                self.button.setVisibility(8)
        except Exception:
            pass
        return True


class _ResumeHook(MethodHook):
    def __init__(self, target):
        self.target = target

    def after_hooked_method(self, param):
        try:
            activity = param.thisObject
            if activity is None or not self.target.isInstance(activity):
                return
            action_bar = activity.getActionBar()
            if action_bar is None:
                return
            menu = action_bar.createMenu()
            if menu is None:
                return
            _dedupe(menu)
            if menu.getItem(ITEM_ID) is not None:
                return
            icon = _icon_res(activity.getContext())
            if not icon:
                return
            button = _find_field(activity, "catalogButton")
            item = menu.addItem(ITEM_ID, icon)
            item.setContentDescription("Каталог плагинов")
            item.setOnClickListener(_Click(activity, button))
            if button is not None:
                button.setVisibility(8)
                root = activity.getFragmentView()
                if root is not None:
                    root.getViewTreeObserver().addOnPreDrawListener(_KeepHidden(button))
        except Exception:
            pass


class CatalogCornerPlugin(BasePlugin):
    def on_plugin_load(self):
        target = _load_class(ACTIVITY)
        if target is None:
            return
        cls = target
        while cls is not None:
            try:
                method = cls.getDeclaredMethod("onResume")
                method.setAccessible(True)
                self.hook_method(method, _ResumeHook(target))
                return
            except Exception:
                cls = cls.getSuperclass()
