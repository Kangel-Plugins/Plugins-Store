from android_utils import OnClickListener, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from hook_utils import find_class
from java import jclass
from java.lang import Boolean
from ui.bulletin import BulletinHelper

__id__ = "hide_business_bot_banner"
__name__ = "Hide Business Bot Banner"
__description__ = "Hides the business-bot panel and adds a native Start/Stop action to the chat menu."
__author__ = "@anivPlugins"
__version__ = "1.0"
__icon__ = "TheMoomintroll/11"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"

ANIMATED_LINEAR_LAYOUT_CLASS = "org.telegram.ui.Components.AnimatedLinearLayout"
BUSINESS_BOT_BUTTON_CLASS = "org.telegram.ui.Business.BusinessBotButton"
CHAT_ACTIVITY_CLASS = "org.telegram.ui.ChatActivity"
HEADER_ITEM_FIELD = "headerItem"
SET_VIEW_VISIBLE_METHOD = "setViewVisible"
UPDATE_TOP_PANEL_METHOD = "updateTopPanel"
ON_RESUME_METHOD = "onResume"
ON_FRAGMENT_DESTROY_METHOD = "onFragmentDestroy"

MESSAGES_CONTROLLER_CLASS = "org.telegram.messenger.MessagesController"
CONNECTIONS_MANAGER_CLASS = "org.telegram.tgnet.ConnectionsManager"
LOCALE_CONTROLLER_CLASS = "org.telegram.messenger.LocaleController"
R_STRING_CLASS = "org.telegram.messenger.R$string"
R_DRAWABLE_CLASS = "org.telegram.messenger.R$drawable"
TOGGLE_BOT_REQUEST_CLASS = (
    "org.telegram.tgnet.tl.TL_account$toggleConnectedBotPaused"
)

# Kept only to remove the SDK-managed item left by version 1.1 on hot reload.
LEGACY_MENU_ITEM_ID = "hide_business_bot_banner_toggle"
# Native Telegram menu ids are ints. This value is outside ChatActivity's own range.
NATIVE_MENU_ITEM_ID = 0x6A7101
BOT_ID_KEY = "dialog_botid"
BOT_FLAGS_KEY = "dialog_botflags"
PAUSED_FLAG = 1
VIEW_VISIBLE = 0
VIEW_GONE = 8


class HideBusinessBotBannerHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if len(param.args) < 2:
                return

            child = param.args[0]
            if child is None:
                return

            class_name = str(child.getClass().getName())
            if class_name == BUSINESS_BOT_BUTTON_CLASS:
                param.args[1] = Boolean(False)
        except Exception as exc:
            self.plugin.log_once(
                "hide_banner",
                f"Could not hide {BUSINESS_BOT_BUTTON_CLASS}: {exc}",
            )


class SyncBusinessBotMenuHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            chat_activity = getattr(param, "thisObject", None)
            if chat_activity is not None:
                self.plugin.sync_menu_for_chat(chat_activity)
        except Exception as exc:
            self.plugin.log_once("sync_menu_hook", f"Menu sync failed: {exc}")


class ForgetBusinessBotMenuHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            chat_activity = getattr(param, "thisObject", None)
            if chat_activity is not None:
                self.plugin.forget_menu_for_chat(chat_activity)
        except Exception as exc:
            self.plugin.log_once("forget_menu_hook", f"Menu cleanup failed: {exc}")


class HideBusinessBotBannerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.unhook_objects = []
        self.logged_messages = set()
        self.native_menu_items = {}
        self.active = False
        self.MessagesController = None
        self.ConnectionsManager = None
        self.LocaleController = None
        self.RString = None
        self.RDrawable = None
        self.ToggleConnectedBotPaused = None
        self.header_item_field = None

    def on_plugin_load(self):
        self.on_plugin_unload()
        self.active = True

        # Version 1.1 used the managed plugin menu. Remove it during hot reload.
        try:
            self.remove_menu_item(LEGACY_MENU_ITEM_ID)
        except Exception:
            pass

        try:
            self.MessagesController = jclass(MESSAGES_CONTROLLER_CLASS)
            self.ConnectionsManager = jclass(CONNECTIONS_MANAGER_CLASS)
            self.LocaleController = jclass(LOCALE_CONTROLLER_CLASS)
            self.RString = jclass(R_STRING_CLASS)
            self.RDrawable = jclass(R_DRAWABLE_CLASS)
            self.ToggleConnectedBotPaused = jclass(TOGGLE_BOT_REQUEST_CLASS)
        except Exception as exc:
            self.log_once("java_classes", f"Could not resolve bot API classes: {exc}")

        self.install_hook(
            ANIMATED_LINEAR_LAYOUT_CLASS,
            SET_VIEW_VISIBLE_METHOD,
            HideBusinessBotBannerHook(self),
            "banner_visibility",
        )
        self.install_hook(
            CHAT_ACTIVITY_CLASS,
            UPDATE_TOP_PANEL_METHOD,
            SyncBusinessBotMenuHook(self),
            "update_top_panel",
        )
        self.install_hook(
            CHAT_ACTIVITY_CLASS,
            ON_RESUME_METHOD,
            SyncBusinessBotMenuHook(self),
            "chat_resume",
        )
        self.install_hook(
            CHAT_ACTIVITY_CLASS,
            ON_FRAGMENT_DESTROY_METHOD,
            ForgetBusinessBotMenuHook(self),
            "chat_destroy",
        )

        try:
            run_on_ui_thread(self.sync_current_chat)
        except Exception as exc:
            self.log_once("initial_menu_sync", f"Initial menu sync failed: {exc}")

    def install_hook(self, class_name, method_name, hook, log_key):
        try:
            target_class = find_class(class_name)
            if target_class is None:
                self.log_once(
                    f"missing_class_{log_key}",
                    f"Class not found: {class_name}",
                )
                return

            unhooks = self.hook_all_methods(
                target_class,
                method_name,
                hook,
                priority=10000,
            )
            if unhooks:
                self.unhook_objects.extend(unhooks)
            else:
                self.log_once(
                    f"missing_method_{log_key}",
                    f"Method not hooked: {class_name}.{method_name}",
                )
        except Exception as exc:
            self.log_once(
                f"hook_setup_{log_key}",
                f"Hook setup failed for {class_name}.{method_name}: {exc}",
            )

    def on_plugin_unload(self):
        self.active = False

        try:
            self.remove_menu_item(LEGACY_MENU_ITEM_ID)
        except Exception:
            pass

        stale_items = list(getattr(self, "native_menu_items", {}).values())
        self.native_menu_items.clear()
        self.header_item_field = None

        if stale_items:
            try:
                run_on_ui_thread(
                    lambda items=stale_items: self.detach_native_items(items)
                )
            except Exception as exc:
                self.log_once("menu_cleanup", f"Menu cleanup failed: {exc}")

        for unhook in list(getattr(self, "unhook_objects", [])):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objects.clear()

    def sync_current_chat(self):
        try:
            fragment = get_last_fragment()
            if fragment is not None and self.java_class_name(fragment) == CHAT_ACTIVITY_CLASS:
                self.sync_menu_for_chat(fragment, require_active=False)
        except Exception as exc:
            self.log_once("initial_menu_sync", f"Initial menu sync failed: {exc}")

    def sync_menu_for_chat(self, chat_activity, require_active=True):
        if not self.active or self.MessagesController is None:
            return
        if require_active and not self.is_active_fragment(chat_activity):
            return

        menu_key = int(chat_activity.hashCode())
        account = int(chat_activity.getCurrentAccount())
        dialog_id = int(chat_activity.getDialogId())
        preferences = self.MessagesController.getNotificationsSettings(account)
        bot_id = int(preferences.getLong(f"{BOT_ID_KEY}{dialog_id}", 0))

        if bot_id == 0:
            record = self.native_menu_items.get(menu_key)
            if record is not None:
                record["item"].setVisibility(VIEW_GONE)
            return

        flags = int(preferences.getInt(f"{BOT_FLAGS_KEY}{dialog_id}", 0))
        paused = (flags & PAUSED_FLAG) != 0
        header_item = self.get_header_item(chat_activity)
        if header_item is None:
            return

        record = self.native_menu_items.get(menu_key)
        if record is None:
            listener = OnClickListener(
                lambda _view, fragment=chat_activity: self.on_native_toggle_click(fragment)
            )
            item = header_item.lazilyAddSubItem(
                NATIVE_MENU_ITEM_ID,
                int(self.RDrawable.msg_bot),
                self.bot_action_text(paused),
            )
            item.setOnClickListener(listener)
            record = {
                "header": header_item,
                "item": item,
                "listener": listener,
            }
            self.native_menu_items[menu_key] = record

        record["item"].setText(self.bot_action_text(paused))
        record["item"].setIcon(int(self.RDrawable.msg_bot))
        record["item"].setVisibility(VIEW_VISIBLE)

    def forget_menu_for_chat(self, chat_activity):
        menu_key = int(chat_activity.hashCode())
        record = self.native_menu_items.pop(menu_key, None)
        if record is not None:
            self.detach_native_item(record)

    def get_header_item(self, chat_activity):
        # Newer Telegram versions expose a getter. In 12.5.1 headerItem is a
        # private ChatActivity field, so use reflection as a compatibility path.
        try:
            return chat_activity.getHeaderItem()
        except Exception:
            pass

        if self.header_item_field is None:
            field = chat_activity.getClass().getDeclaredField(HEADER_ITEM_FIELD)
            field.setAccessible(True)
            self.header_item_field = field
        return self.header_item_field.get(chat_activity)

    @staticmethod
    def detach_native_item(record):
        try:
            record["item"].setVisibility(VIEW_GONE)
            record["item"].setOnClickListener(None)
        except Exception:
            pass

    def detach_native_items(self, records):
        try:
            for record in records:
                self.detach_native_item(record)
        except Exception as exc:
            self.log_once("menu_cleanup_callback", f"Menu cleanup failed: {exc}")

    def on_native_toggle_click(self, fragment):
        try:
            if not self.active:
                return
            if self.MessagesController is None or self.ConnectionsManager is None:
                raise RuntimeError("Telegram bot API classes are unavailable")
            if self.ToggleConnectedBotPaused is None:
                raise RuntimeError("toggleConnectedBotPaused is unavailable")

            try:
                header_item = self.get_header_item(fragment)
                if header_item is not None:
                    header_item.closeSubMenu()
            except Exception as exc:
                self.log_once("close_submenu", f"Could not close chat menu: {exc}")

            account = int(fragment.getCurrentAccount())
            dialog_id = int(fragment.getDialogId())
            preferences = self.MessagesController.getNotificationsSettings(account)
            bot_id = int(preferences.getLong(f"{BOT_ID_KEY}{dialog_id}", 0))
            if bot_id == 0:
                self.sync_menu_for_chat(fragment, require_active=False)
                self.show_error("Бот больше не управляет этим чатом", fragment)
                return

            flags_key = f"{BOT_FLAGS_KEY}{dialog_id}"
            old_flags = int(preferences.getInt(flags_key, 0))
            was_paused = (old_flags & PAUSED_FLAG) != 0
            paused = not was_paused
            if paused:
                new_flags = old_flags | PAUSED_FLAG
            else:
                new_flags = old_flags & ~PAUSED_FLAG

            peer = self.MessagesController.getInstance(account).getInputPeer(dialog_id)
            if peer is None:
                raise RuntimeError("Telegram could not resolve InputPeer")

            request = self.ToggleConnectedBotPaused()
            request.peer = peer
            # Chaquopy converts Python bool to Java's primitive boolean field.
            request.paused = bool(paused)

            preferences.edit().putInt(flags_key, new_flags).apply()
            try:
                self.ConnectionsManager.getInstance(account).sendRequest(request, None)
            except Exception:
                preferences.edit().putInt(flags_key, old_flags).apply()
                raise

            self.sync_menu_for_chat(fragment, require_active=False)
            try:
                fragment.updateTopPanel(True)
            except Exception as exc:
                self.log_once("refresh_top_panel", f"Top panel refresh failed: {exc}")

            status = "Бот остановлен" if paused else "Бот запущен"
            self.show_success(status, fragment)
        except Exception as exc:
            self.log_once("toggle_bot", f"Bot toggle failed: {exc}")
            self.show_error(f"Не удалось переключить бота: {exc}", fragment)

    def bot_action_text(self, paused):
        try:
            resource_id = self.RString.BizBotStart if paused else self.RString.BizBotStop
            return str(self.LocaleController.getString(resource_id))
        except Exception:
            return "Запустить бота" if paused else "Остановить бота"

    def is_active_fragment(self, fragment):
        try:
            active_fragment = get_last_fragment()
            if active_fragment is None:
                return True
            return int(active_fragment.hashCode()) == int(fragment.hashCode())
        except Exception:
            return True

    def show_success(self, message, fragment):
        try:
            BulletinHelper.show_success(message, fragment)
        except Exception as exc:
            self.log_once("success_bulletin", f"Success bulletin failed: {exc}")

    def show_error(self, message, fragment):
        try:
            BulletinHelper.show_error(message, fragment)
        except Exception as exc:
            self.log_once("error_bulletin", f"Error bulletin failed: {exc}")

    @staticmethod
    def java_class_name(obj):
        return str(obj.getClass().getName())

    def log_once(self, key, message):
        if key in self.logged_messages:
            return
        self.logged_messages.add(key)
        self.log(message)
