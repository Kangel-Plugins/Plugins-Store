def _client_lang():
    try:
        lc = find_class("org.telegram.messenger.LocaleController")
        if lc is not None:
            loc = lc.getInstance().getCurrentLocale()
            if loc is not None:
                lang = str(loc.getLanguage() or "")
                if lang:
                    return lang.lower()
    except Exception:
        pass
    try:
        return str(Locale.getDefault().getLanguage() or "en").lower()
    except Exception:
        return "en"


def _texts():
    lang = _client_lang()
    base = dict(_TEXT["en"])
    if lang.startswith("ru"):
        base.update(_TEXT["ru"])
    return base


class BottomBarCustomizerPlugin(BasePlugin):
    def _sync_description(self):
        try:
            pc = find_class("com.exteragram.messenger.plugins.PluginsController")
            if pc is not None:
                plg = pc.getInstance().getPlugins().get(__id__)
                if plg is not None:
                    plg.setDescription(__description__ if _client_lang().startswith("ru") else _DESC_EN)
        except Exception:
            pass

    def on_plugin_load(self):
        self._sync_description()
        if not _engine.start(self):
            _log("Bottom Bar Customizer DEX engine could not start")

    def on_plugin_unload(self):
        _engine.unload()

    def _on_change(self, key):
        def _callback(new_value):
            try:
                _engine.push_settings(self, {key: new_value})
            except Exception as e:
                _log("setting update failed", e)
        return _callback

    def _make_switch(self, t, key, default=True):
        val = bool(self.get_setting(key, default))
        cb = self._on_change(key)
        try:
            return Switch(key=key, text=t[key], default=val, on_change=cb)
        except Exception:
            return Switch(key=key, text=t[key], default=val)

    def _make_selector(self, t, key, items_key, default=0):
        cb = self._on_change(key)
        val = _int(self.get_setting(key, default), default)
        try:
            return Selector(
                key=key,
                text=t[key],
                items=t[items_key],
                default=val,
                on_change=cb,
            )
        except Exception:
            return Selector(
                key=key,
                text=t[key],
                items=t[items_key],
                default=val,
            )

    def _make_text(self, title, sub=None, icon=None, sub_fragment=None):
        kwargs = {"text": title}
        if sub:
            kwargs["subtext"] = sub
        if icon:
            kwargs["icon"] = icon
        if sub_fragment is not None:
            kwargs["create_sub_fragment"] = sub_fragment
        try:
            return Text(**kwargs)
        except Exception:
            kwargs.pop("subtext", None)
            try:
                return Text(**kwargs)
            except Exception:
                kwargs.pop("icon", None)
                return Text(**kwargs)

    def _ensure_engine(self):
        if _engine.bridge is None:
            _engine.start(self)
        else:
            _engine.set_change_listener(lambda: _engine.sync_from_java(self))
            _engine.push_settings(self, force=True)

    def _create_order_settings(self):
        self._ensure_engine()
        rows = []
        preview = _make_custom_row("preview")
        if preview is not None:
            rows.append(preview)
            rows.append(Divider())
        order_view = _make_custom_row("order")
        if order_view is not None:
            rows.append(order_view)
        if not rows:
            rows.append(Divider(text=_engine.last_error or "Order view unavailable"))
        return rows

    def _create_presets_settings(self):
        self._ensure_engine()
        rows = []
        presets_view = _make_custom_row("presets")
        if presets_view is not None:
            rows.append(presets_view)
        else:
            rows.append(Divider(text=_engine.last_error or "Presets view unavailable"))
        return rows

    def create_settings(self):
        self._ensure_engine()
        t = _texts()
        sw = lambda key, default=True: self._make_switch(t, key, default)
        sel = lambda key, items_key, default=0: self._make_selector(t, key, items_key, default)

        items = []
        editor = _make_custom_row("editor")
        if editor is not None:
            items.append(editor)
            items.append(Divider())
        elif _engine.last_error:
            items.append(Divider(text=_engine.last_error))

        order_title, order_sub = t["order_row"]
        presets_title, presets_sub = t["presets_row"]

        items.extend([
            sw("enabled", True),
            self._make_text(order_title, sub=order_sub, icon="msg_reorder", sub_fragment=self._create_order_settings),
            self._make_text(presets_title, sub=presets_sub, icon="msg_customize", sub_fragment=self._create_presets_settings),
            Divider(),
            sw("show_labels", True),
            sw("show_badge", True),
            sw("profile_avatar_icon", True),
            sw("show_bottom_fade", True),
            sel("bar_width_mode", "width_modes", 0),
            Divider(text=t["about"] % __version__),
        ])
        return items


