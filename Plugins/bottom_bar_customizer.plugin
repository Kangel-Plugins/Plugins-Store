_TAG = "BottomBarCustomizer"
_ENGINE_CLASS = "com.bottombar.Bridge"
_DEX_SHA1 = "f7f03735977b0ab23e7b8bafc791ca059bff423c"
_ICON_TGS_SHA1 = "77fba92aa658c01f1035067c4081665ea8e27453"

_DESC_EN = (
    "Customize Telegram's bottom bar: toggle and reorder tabs, "
    "quick presets, capsule style, and a live preview over your chats."
)

_ALL_TABS = (
    "chats",
    "feed",
    "contacts",
    "calls",
    "settings",
    "profile",
    "saved",
    "archive",
    "search",
)

_DEFAULT_ORDER = ",".join(_ALL_TABS)

_TAB_DEFAULTS = {
    "chats": True,
    "feed": False,
    "contacts": False,
    "calls": False,
    "settings": True,
    "profile": True,
    "saved": False,
    "archive": False,
    "search": False,
}

_CFG_TO_PY = {
    "enabled": ("enabled", "bool"),
    "t_chats": ("tab_chats", "bool"),
    "t_feed": ("tab_feed", "bool"),
    "t_contacts": ("tab_contacts", "bool"),
    "t_calls": ("tab_calls", "bool"),
    "t_settings": ("tab_settings", "bool"),
    "t_profile": ("tab_profile", "bool"),
    "t_saved": ("tab_saved", "bool"),
    "t_archive": ("tab_archive", "bool"),
    "t_search": ("tab_search", "bool"),
    "labels": ("show_labels", "bool"),
    "badge": ("show_badge", "bool"),
    "fade": ("show_bottom_fade", "bool"),
    "avatar_icon": ("profile_avatar_icon", "bool"),
    "width_mode": ("bar_width_mode", "int"),
    "order": ("tab_order", "str"),
}


def _log(msg, err=None):
    try:
        text = msg if err is None else "%s: %s" % (msg, err)
        jclass("android.util.Log").w(_TAG, text)
    except Exception:
        pass


def _int(val, default=0):
    try:
        return default if val is None else int(val)
    except (TypeError, ValueError):
        return default


def _parse_order(raw):
    out = []
    if isinstance(raw, str) and raw:
        for item in raw.split(","):
            t = item.strip()
            if t in _ALL_TABS and t not in out:
                out.append(t)
    for t in _ALL_TABS:
        if t not in out:
            out.append(t)
    return out


def _get_app_context():
    try:
        al = find_class("org.telegram.messenger.ApplicationLoader")
        if al is not None and al.applicationContext is not None:
            return al.applicationContext
    except Exception:
        pass
    try:
        la = find_class("org.telegram.ui.LaunchActivity")
        if la is not None and la.instance is not None:
            return la.instance
    except Exception:
        pass
    return None


def _get_ui_context():
    try:
        la = find_class("org.telegram.ui.LaunchActivity")
        if la is not None and la.instance is not None:
            return la.instance
    except Exception:
        pass
    return _get_app_context()


def _read_config(plugin, overrides=None):
    def get(key, default):
        if overrides is not None and key in overrides:
            return overrides[key]
        return plugin.get_setting(key, default)

    order_str = ",".join(_parse_order(get("tab_order", _DEFAULT_ORDER)))
    return {
        "enabled": 1 if bool(get("enabled", True)) else 0,
        "t_chats": 1 if bool(get("tab_chats", _TAB_DEFAULTS["chats"])) else 0,
        "t_feed": 1 if bool(get("tab_feed", _TAB_DEFAULTS["feed"])) else 0,
        "t_contacts": 1 if bool(get("tab_contacts", _TAB_DEFAULTS["contacts"])) else 0,
        "t_calls": 1 if bool(get("tab_calls", _TAB_DEFAULTS["calls"])) else 0,
        "t_settings": 1 if bool(get("tab_settings", _TAB_DEFAULTS["settings"])) else 0,
        "t_profile": 1 if bool(get("tab_profile", _TAB_DEFAULTS["profile"])) else 0,
        "t_saved": 1 if bool(get("tab_saved", _TAB_DEFAULTS["saved"])) else 0,
        "t_archive": 1 if bool(get("tab_archive", _TAB_DEFAULTS["archive"])) else 0,
        "t_search": 1 if bool(get("tab_search", _TAB_DEFAULTS["search"])) else 0,
        "labels": 1 if bool(get("show_labels", True)) else 0,
        "badge": 1 if bool(get("show_badge", True)) else 0,
        "fade": 1 if bool(get("show_bottom_fade", True)) else 0,
        "avatar_icon": 1 if bool(get("profile_avatar_icon", True)) else 0,
        "width_mode": _int(get("bar_width_mode", 0), 0),
        "order": order_str,
    }


def _format_cfg_line(cfg):
    parts = []
    for k in sorted(cfg.keys()):
        v = cfg[k]
        if isinstance(v, str):
            parts.append("%s=%s" % (k, v))
        else:
            parts.append("%s=%d" % (k, int(v)))
    return "cfg:" + ";".join(parts)


class _DexEngine:
    def __init__(self):
        self.bridge = None
        self.loader = None
        self.running = False
        self._last_cfg = None
        self._listener_ref = None
        self.last_error = ""

    def _err(self, msg, exc=None):
        text = msg if exc is None else "%s: %s" % (msg, exc)
        self.last_error = text
        _log(msg, exc)

    @staticmethod
    def _decode_dex():
        data = zlib.decompress(base64.b64decode(_DEX_DATA))
        if hashlib.sha1(data).hexdigest() != _DEX_SHA1:
            _log("embedded dex sha1 mismatch")
            return None
        return data

    @staticmethod
    def _decode_icon_tgs():
        data = base64.b64decode(_ICON_TGS_DATA)
        if hashlib.sha1(data).hexdigest() != _ICON_TGS_SHA1:
            _log("embedded icon sha1 mismatch")
            return None
        return data

    @staticmethod
    def _extract_icon_file(context):
        try:
            data = _DexEngine._decode_icon_tgs()
            if not data:
                return ""
            folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "bottom_bar_customizer")
            path = os.path.join(folder, "icon-%s.tgs" % _ICON_TGS_SHA1[:10])
            if not os.path.exists(path) or os.path.getsize(path) != len(data):
                os.makedirs(folder, exist_ok=True)
                tmp = path + ".tmp"
                with open(tmp, "wb") as f:
                    f.write(data)
                os.replace(tmp, path)
            return path
        except Exception as e:
            _log("icon extract failed", e)
            return ""

    @staticmethod
    def _extract_dex_file(context, data):
        folder = os.path.join(str(context.getFilesDir().getAbsolutePath()), "bottom_bar_customizer")
        path = os.path.join(folder, "%s-%s.dex" % (__id__, _DEX_SHA1[:10]))
        if not os.path.exists(path):
            os.makedirs(folder, exist_ok=True)
            for name in os.listdir(folder):
                if name.startswith(__id__ + "-") and name.endswith(".dex"):
                    try:
                        os.remove(os.path.join(folder, name))
                    except OSError:
                        pass
            tmp = path + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, path)
        try:
            os.chmod(path, 0o444)
        except OSError:
            pass
        return path

    def _load(self):
        context = _get_app_context()
        if context is None:
            self._err("appContext is null")
            return False

        data = self._decode_dex()
        if not data:
            self._err("dex decode failed")
            return False

        dex_path = ""
        loaded_class = None

        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = InMemoryDexClassLoader(ByteBuffer.wrap(data), context.getClassLoader())
            loaded_class = self.loader.loadClass(_ENGINE_CLASS)
        except Exception as mem_err:
            _log("InMemoryDexClassLoader fallback", mem_err)
            try:
                dex_path = self._extract_dex_file(context, data)
                DexClassLoader = jclass("dalvik.system.DexClassLoader")
                opt_dir = context.getDir("dex_opt", 0).getAbsolutePath()
                self.loader = DexClassLoader(dex_path, opt_dir, None, context.getClassLoader())
                loaded_class = self.loader.loadClass(_ENGINE_CLASS)
            except Exception as file_err:
                self._err("DexClassLoader failed", file_err)
                return False

        if loaded_class is None:
            self._err("Bridge class is null")
            return False

        try:
            loaded_class.getMethod(
                "init",
                jclass("android.content.Context"),
                jclass("java.lang.String"),
            ).invoke(None, context, dex_path)
        except Exception as init_err:
            self._err("Bridge.init failed", init_err)
            return False

        self.bridge = loaded_class
        eng_ver = self.cmd("version")
        if eng_ver != __version__:
            self._err("version mismatch: %s != %s" % (eng_ver, __version__))
            self.unload()
            return False

        icon_path = self._extract_icon_file(context)
        if icon_path:
            self.cmd("icon:" + icon_path)

        self.last_error = ""
        return True

    def cmd(self, text):
        if self.bridge is None:
            return ""
        try:
            res = self.bridge.getMethod("cmd", jclass("java.lang.String")).invoke(None, text)
            return "" if res is None else str(res)
        except Exception as e:
            _log("cmd error", e)
            return ""

    def set_change_listener(self, callback):
        if self.bridge is None or _RunnableProxy is None or callback is None:
            return
        try:
            runnable = _RunnableProxy(callback)
            self._listener_ref = runnable
            self.bridge.getMethod(
                "setChangeListener",
                jclass("java.lang.Runnable"),
            ).invoke(None, runnable)
        except Exception as e:
            _log("set_change_listener failed", e)

    def push_settings(self, plugin, overrides=None, force=False):
        if self.bridge is None:
            return
        cfg = _read_config(plugin, overrides)
        line = _format_cfg_line(cfg)
        if force or line != self._last_cfg:
            self._last_cfg = line
            self.cmd(line)

    def sync_from_java(self, plugin):
        if self.bridge is None or plugin is None:
            return
        dump = self.cmd("cfg:dump")
        if not dump:
            return
        parsed = {}
        for part in dump.split(";"):
            if "=" not in part:
                continue
            k, v = part.split("=", 1)
            k = k.strip()
            v = v.strip()
            meta = _CFG_TO_PY.get(k)
            if meta is None:
                continue
            py_key, kind = meta
            if kind == "bool":
                val = _int(v, 0) != 0
            elif kind == "int":
                val = _int(v, 0)
            else:
                val = v
            parsed[k] = val if kind == "str" else (1 if (kind == "bool" and val) else (0 if kind == "bool" else val))
            if plugin.get_setting(py_key, None) != val:
                plugin.set_setting(py_key, val, reload_settings=False)
        if parsed:
            self._last_cfg = _format_cfg_line(parsed)

    def create_view(self, context, kind):
        if self.bridge is None:
            self._load()
        if self.bridge is not None and context is not None:
            try:
                m = self.bridge.getMethod(
                    "createView",
                    jclass("android.content.Context"),
                    jclass("java.lang.String"),
                )
                view = m.invoke(None, context, str(kind))
                if view is not None:
                    return view
                self._err("createView(%s) returned null" % kind)
            except Exception as e:
                self._err("createView(%s)" % kind, e)
        return None

    def refresh_view(self, view):
        if self.bridge is None or view is None:
            return
        try:
            self.bridge.getMethod("refreshView", jclass("android.view.View")).invoke(None, view)
        except Exception as e:
            _log("refresh_view failed", e)

    def start(self, plugin):
        try:
            if not self._load():
                return False
            self.set_change_listener(lambda: self.sync_from_java(plugin))
            self.push_settings(plugin, force=True)
            hook_count = _int(self.cmd("engine:start"), 0)
            self.running = hook_count > 0
            if not self.running:
                _log("no hooks installed; stock bottom bar remains")
            return self.running
        except Exception as e:
            self._err("start failed", e)
            return False

    def unload(self):
        self.running = False
        self._listener_ref = None
        bridge, self.bridge = self.bridge, None
        self.loader = None
        self._last_cfg = None
        if bridge is not None:
            try:
                bridge.getMethod("unload").invoke(None)
            except Exception as e:
                _log("unload failed", e)


_engine = _DexEngine()


def _fallback_error_view(context, kind):
    try:
        tv = jclass("android.widget.TextView")(context)
        msg = _engine.last_error or ("Preview unavailable (%s)" % kind)
        tv.setText(msg)
        tv.setTextColor(-3355444)
        tv.setPadding(36, 28, 36, 28)
        return tv
    except Exception:
        return jclass("android.widget.FrameLayout")(context)


def _create_editor_v190(context, list_view, current_account, class_guid, resources_provider):
    v = _engine.create_view(context, "editor")
    return v if v is not None else _fallback_error_view(context, "editor")


def _create_preview_v190(context, list_view, current_account, class_guid, resources_provider):
    v = _engine.create_view(context, "preview")
    return v if v is not None else _fallback_error_view(context, "preview")


def _create_order_v190(context, list_view, current_account, class_guid, resources_provider):
    v = _engine.create_view(context, "order")
    return v if v is not None else _fallback_error_view(context, "order")


def _create_presets_v190(context, list_view, current_account, class_guid, resources_provider):
    v = _engine.create_view(context, "presets")
    return v if v is not None else _fallback_error_view(context, "presets")


def _bind_refresh_v190(view, item, divider, adapter, list_view):
    _engine.refresh_view(view)


_CREATORS_V190 = {
    "editor": _create_editor_v190,
    "preview": _create_preview_v190,
    "order": _create_order_v190,
    "presets": _create_presets_v190,
}

_FACTORIES_V190 = {}


def _get_factory(kind):
    if SimpleSettingFactory is None:
        return None
    f = _FACTORIES_V190.get(kind)
    if f is not None:
        return f
    fn = _CREATORS_V190.get(kind, _create_editor_v190)
    try:
        f = SimpleSettingFactory(
            fn,
            _bind_refresh_v190,
            is_clickable=False,
            is_shadow=False,
        )
        _FACTORIES_V190[kind] = f
        return f
    except Exception as e:
        _engine._err("SimpleSettingFactory(%s)" % kind, e)
        return None


def _make_custom_row(kind):
    ctx = _get_ui_context()
    if Custom is not None and ctx is not None:
        view = _engine.create_view(ctx, kind)
        if view is not None:
            fields = getattr(Custom, "__dataclass_fields__", None)
            if fields is None or "view" in fields:
                try:
                    return Custom(view=view)
                except Exception as e:
                    _log("Custom(view=) fallback", e)
            if fields is None or "item" in fields:
                try:
                    uitem_cls = find_class("org.telegram.ui.Components.UItem")
                    if uitem_cls is not None:
                        uitem = uitem_cls.asCustom(view)
                        if uitem is not None:
                            return Custom(item=uitem)
                except Exception as e:
                    _log("Custom(item=) fallback", e)

    factory = _get_factory(kind)
    if factory is not None:
        if callable(factory):
            try:
                return factory()
            except Exception as e:
                _log("factory() fallback", e)
        if Custom is not None:
            try:
                return Custom(factory=factory)
            except Exception as e:
                _log("Custom(factory=) fallback", e)
    return None


