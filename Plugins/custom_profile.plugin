    def _about_page(self):
        """Раздел «О плагине»: куда идти с вопросами."""
        rows = [
            self._row(Header, text="Custom Profile " + __version__),
            self._row(Text, text=self._t("Канал плагина", "Plugin channel"),
                      icon="msg_channel", link_alias="channel",
                      on_click=lambda _: self._open("RoflPlugins")),
            # Обычная строка клиента вместо яркого web-баннера: сбор заметен,
            # но не перетягивает на себя весь экран настроек.
            self._row(Text,
                      text=self._t("Поддержать Custom Profile",
                                   "Support Custom Profile"),
                      icon="msg_fave", link_alias="support",
                      subtext=self._t("Помочь с сервером и развитием плагина",
                                      "Help with the server and plugin development"),
                      on_click=lambda _: self._open_support()),
            # Вместо одного автора — те, кто поддержал плагин: он держится не на
            # одном человеке. Список приходит с сервера, лица рисует клиент.
            self._row(Text, text=self._t("Спасибо", "Thanks"), icon="msg_fave",
                      subtext=self._t("Те, кто поддержал плагин",
                                      "People who supported the plugin"),
                      link_alias="thanks",
                      on_click=lambda _: self._open_thanks()),
        ]
        return [row for row in rows if row is not None]

    def _open(self, username):
        self._open_url("tg://resolve?domain=" + username)

    def _open_url(self, url):
        """Открывает доверенную ссылку через системный выбор приложения."""
        try:
            from android_utils import run_on_ui_thread as _ui
            from client_utils import get_last_fragment
            from android.content import Intent
            from android.net import Uri

            def go():
                fragment = get_last_fragment()
                context = fragment.getParentActivity() if fragment else None
                if context is None:
                    return
                context.startActivity(Intent(Intent.ACTION_VIEW,
                                             Uri.parse(url)))

            _ui(go)
        except Exception as e:
            self.log("[cpb] ссылка не открылась: %s" % e)

    def create_settings(self) -> List[Any]:
        # Оформление правится в самом профиле, где сразу видно, что меняется, а
        # здесь собрано то, что к профилю не привязано: расход батареи, вид своих
        # сообщений у собеседников и куда идти с вопросами. Разделы уходят на свои
        # страницы: списком в одну простыню это читается хуже, а у каждой строки
        # есть своя ссылка, которую клиент даёт скопировать.
        core = getattr(self, "_core", None)
        if core is None:
            rows = [
                self._row(Header, text="Custom Profile"),
                self._row(Text, text=self._t(
                    "Ядро плагина не загрузилось — переустановите плагин.",
                    "The plugin core did not load — reinstall the plugin.")),
            ]
            return [row for row in rows if row is not None]
        appearance = [
            self._row(Text, text=self._t("Отображение", "Display"),
                      icon="msg_palette", link_alias="display",
                      subtext=self._t("Что видно в чатах и списках", "What appears in chats and lists"),
                      create_sub_fragment=lambda: self._display_page()),
            self._row(Text, text=self._t("Пузырёк сообщений", "Message bubble"),
                      icon="msg_discussion", link_alias="bubble",
                      subtext=self._t("Цвета и текст ваших сообщений", "Colors and text of your messages"),
                      on_click=lambda _: self._open_bubble()),
            self._row(Text, text=self._t("Бейджик профиля", "Profile badge"),
                      icon="msg_gallery", link_alias="chat_badge",
                      subtext=self._t("Изображение на вашей карточке профиля", "Image on your profile card"),
                      on_click=lambda _: self._core.open_chat_badge()),
            self._row(Text, text=self._t("Музыка и плеер", "Music and player"),
                      icon="msg_media", link_alias="music",
                      subtext=self._t("Обложка и текст песни", "Cover art and lyrics"),
                      create_sub_fragment=lambda: self._music_page()),
        ]
        performance = [
            self._row(Text, text=self._t("Энергосбережение", "Power saving"),
                      icon="msg2_battery", link_alias="power",
                      subtext=self._t("Анимации рамок и нагрузка", "Frame animations and performance"),
                      create_sub_fragment=lambda: self._power_page()),
            self._row(Text, text=self._t("Данные и память", "Data and storage"),
                      icon="msg2_data", link_alias="storage",
                      subtext=self._t("Кэш, лимиты и очистка", "Cache, limits and clearing"),
                      on_click=lambda _: self._core.open_storage_settings()),
        ]
        application = [
            self._lang_row(),
            self._row(Text, text=self._t("Обновления", "Updates"),
                      icon="msg_download", link_alias="updates",
                      subtext=self._t("Новые версии и история изменений", "New versions and change history"),
                      create_sub_fragment=lambda: self._updates_page()),
            self._row(Text, text=self._t("Помощь", "Help"),
                      icon="msg_info", link_alias="forum",
                      subtext=self._t("Вопросы и ответы сообщества", "Community questions and answers"),
                      on_click=lambda _: self._core.open_help_forum()),
        ]
        if self._dev_mode():
            application.append(self._row(
                Text, text=self._t("Настройки разработчика", "Developer settings"),
                icon="msg_customize", link_alias="developer",
                create_sub_fragment=lambda: self._dev_page()))
        rows = (self._section("Оформление", "Appearance", appearance)
                + self._section("Производительность", "Performance", performance)
                + self._section("Приложение", "Application", application))
        rows.append(self._row(Text, text=self._t("О плагине", "About"),
                              create_sub_fragment=lambda: self._about_page(),
                              link_alias="about"))
        return [row for row in rows if row is not None]



def _args(*values):
    from java import jarray, jclass
    arr = jarray(jclass("java.lang.Object"))(len(values))
    for i, v in enumerate(values):
        arr[i] = v
    return arr

class _Core:

    def __init__(self, cls):
        self._cls = cls
        self._methods = {}
        for m in cls.getDeclaredMethods():
            self._methods.setdefault(m.getName(), m)

    def unload(self):
        m = self._methods.get("unload")
        if m is not None:
            m.invoke(None, _args())

    def dev_mode(self):
        m = self._methods.get("devMode")
        if m is None:
            return False
        return bool(m.invoke(None, _args()))

    def check_update(self):
        m = self._methods.get("checkUpdate")
        if m is None:
            raise RuntimeError("в ядре нет checkUpdate")
        m.invoke(None, _args())

    def unskip_release(self):
        m = self._methods.get("unskipRelease")
        if m is None:
            raise RuntimeError("в ядре нет unskipRelease")
        m.invoke(None, _args())

    def open_changelog(self):
        m = self._methods.get("openChangelog")
        if m is None:
            raise RuntimeError("в ядре нет openChangelog")
        m.invoke(None, _args())

    def open_help_forum(self):
        m = self._methods.get("openHelpForum")
        if m is None:
            raise RuntimeError("в ядре нет openHelpForum")
        m.invoke(None, _args())

    def open_storage_settings(self):
        m = self._methods.get("openStorageSettings")
        if m is None:
            raise RuntimeError("в ядре нет openStorageSettings")
        m.invoke(None, _args())

    def open_whats_new_editor(self):
        m = self._methods.get("openWhatsNewEditor")
        if m is None:
            raise RuntimeError("в ядре нет openWhatsNewEditor")
        m.invoke(None, _args())

    def open_egg(self):
        m = self._methods.get("openEgg")
        if m is None:
            raise RuntimeError("в ядре нет openEgg")
        m.invoke(None, _args())

    def open_log(self):
        m = self._methods.get("openLog")
        if m is None:
            raise RuntimeError("в ядре нет openLog")
        m.invoke(None, _args())

    def toggle_chat_load(self):
        m = self._methods.get("toggleChatLoad")
        if m is None:
            raise RuntimeError("в ядре нет toggleChatLoad")
        m.invoke(None, _args())

    def show_error_demo(self):
        m = self._methods.get("showErrorDemo")
        if m is None:
            raise RuntimeError("в ядре нет showErrorDemo")
        m.invoke(None, _args())

    def show_test_animation(self):
        m = self._methods.get("showTestAnimation")
        if m is None:
            raise RuntimeError("в ядре нет showTestAnimation")
        m.invoke(None, _args())

    def ping_servers(self):
        m = self._methods.get("pingServers")
        if m is None:
            raise RuntimeError("в ядре нет pingServers")
        m.invoke(None, _args())

    def lang_mode(self):
        m = self._methods.get("langMode")
        if m is None:
            return "auto"
        return m.invoke(None, _args())

    def set_lang_mode(self, mode):
        m = self._methods.get("setLangMode")
        if m is None:
            raise RuntimeError("в ядре нет setLangMode")
        m.invoke(None, _args(str(mode)))

    def english(self):
        m = self._methods.get("english")
        if m is None:
            return False
        return bool(m.invoke(None, _args()))

    def flag_of(self, key):
        m = self._methods.get("flagOf")
        if m is None:
            raise RuntimeError("в ядре нет flagOf")
        return m.invoke(None, _args(key))

    def open_thanks(self):
        m = self._methods.get("openThanks")
        if m is None:
            raise RuntimeError("в ядре нет openThanks")
        m.invoke(None, _args())

    def open_chat_badge(self):
        m = self._methods.get("openChatBadge")
        if m is None:
            raise RuntimeError("в ядре нет openChatBadge")
        m.invoke(None, _args())

    def open_bubble(self):
        m = self._methods.get("openBubbleSheet")
        if m is None:
            raise RuntimeError("в ядре нет openBubbleSheet")
        m.invoke(None, _args())

    def flag_set(self, key, value):
        m = self._methods.get("flagSet")
        if m is None:
            raise RuntimeError("в ядре нет flagSet")
        from java import jboolean
        m.invoke(None, _args(key, jboolean(bool(value))))
