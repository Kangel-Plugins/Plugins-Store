                         "msg_background"),
        ]) + self._section("Предпросмотр", "Preview", [
            self._row(Text, text=self._t("Окно ошибки", "Error window"),
                      icon="msg_report", link_alias="error", on_click=lambda _: self._show_error()),
            self._row(Text, text=self._t("Тестовая анимация", "Test animation"),
