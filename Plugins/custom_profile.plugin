    def _updates_page(self):
        return self._section("Новые версии", "New versions", [
            self._switch("updates_beta",
                         self._t("Бета-версии", "Beta versions"),
                         self._t("Новые функции до стабильного выпуска", "New features before the stable release"),
                         "msg_customize"),
            self._row(Text, text=self._t("Проверить обновления", "Check for updates"),
                      subtext=self._t("Найти новую версию плагина", "Look for a new plugin version"),
                      icon="msg_download", link_alias="check",
                      on_click=lambda _: self._check_update()),
            self._row(Text, text=self._t("Вернуть пропущенную версию", "Restore skipped version"),
                      subtext=self._t("Снова предложить её установку", "Offer its installation again"),
                      icon="msg_reset", link_alias="unskip",
                      on_click=lambda _: self._unskip()),
        ]) + self._section("История", "History", [
            self._row(Text, text=self._t("Ченжлог", "Changelog"),
