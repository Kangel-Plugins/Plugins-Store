    def _dev_page(self):
        return self._section("Диагностика", "Diagnostics", [
            self._row(Text, text=self._t("Проверить связь", "Check servers"),
                      subtext=self._t("Время ответа серверов", "Server response times"),
                      icon="msg_speed", link_alias="ping", on_click=lambda _: self._ping()),
            self._row(Text, text=self._t("Журнал плагина", "Plugin log"),
                      subtext=self._t("События текущего запуска", "Events from the current session"),
                      icon="msg_log", link_alias="log", on_click=lambda _: self._open_log()),
        ]) + self._section("Проверка плавности", "Scroll diagnostics", [
            self._switch("dev_frame_load",
                         self._t("Показывать нагрузку рамок", "Show frame load"),
                         self._t("Доля времени UI и фоновой подготовки. Без GPU; одинаковые рамки суммируются.", "UI and background preparation time. Excludes GPU; identical frames are summed."),
                         "msg_speed"),
            self._row(Text, text=self._t("Нагрузка списка чатов", "Chat list load"),
                      subtext=self._t("Плавающая панель замеров", "Floating diagnostics panel"),
                      icon="msg_speed", link_alias="chat_load", on_click=lambda _: self._toggle_chat_load()),
            self._switch("dev_hide_chat_names",
