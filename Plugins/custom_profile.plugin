from typing import Any, List

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread
import ui.settings as _uisettings

def _ui_optional(_name):
    try:
        return getattr(_uisettings, _name)
    except Exception:
        return None

Header = _ui_optional("Header")
Text = _ui_optional("Text")
Switch = _ui_optional("Switch")
Selector = _ui_optional("Selector")
Divider = _ui_optional("Divider")

__id__ = "custom_profile"
__name__ = "Custom Profile"
__description__ = "Полная кастомизация профилей Telegram в одном плагине"
__author__ = "@RoflPlugins"
__version__ = "2.0"
__icon__ = "RoflPlugins/18"
__app_version__ = ">=12.10.6"
__category__ = ["appearance"]
__sdk_version__ = ">=1.4.0"

_LEGACY_KEYS = [
    "enabled", "show_emoji", "banner_mode", "banner_path", "banner_color",
    "grad_type", "grad_dir", "grad_angle", "grad_c1", "grad_c2", "grad_c3",
    "grad_use3", "grad_radius", "grad_count", "banner_alpha", "banner_fade",
    "banner_fade_angle", "banner_fade_radius", "bg_alpha", "bg_fade",
    "bg_fade_angle", "bg_fade_radius", "grad_cx", "grad_cy", "banner_fade_cx",
    "banner_fade_cy", "bg_fade_cx", "bg_fade_cy", "bg_enabled", "bg_mode",
    "bg_color", "bg_path", "share_enabled", "last_pub_sig", "avatar_shape",
    "avatar_radius", "avatar_round", "avatar_custom", "avatar_alpha",
    "blocks_color_enabled", "blocks_color", "blocks_alpha", "blocks_blur",
    "blocks_depth", "publish_consent", "remote_enabled", "remote_prompted",
    "name_grad_angle", "name_size", "name_font", "banner_dim", "bg_dim",
    "avatar_dim", "name_font_path", "thought_text", "thought_text_color",
    "thought_bg_color", "thought_font", "thought_font_copy",
    "thought_font_path", "name_color_enabled", "name_color",
    "name_glow_enabled", "name_glow_color", "name_glow_radius",
    "name_glow_strength", "name_fx", "name_fx_speed", "name_grad_c1",
    "name_grad_c2", "avatar_fade", "avatar_fade_radius",
    "profile_text_color_enabled", "profile_text_color",
    "profile_hint_color_enabled", "profile_hint_color",
    "profile_action_color_enabled", "profile_action_color",
    "banner_sound", "banner_sound_volume", "bg_sound", "bg_sound_volume",
]

_LEGACY_ACCT_KEYS = ["device_key", "cpb_likes"]

_DEX_B64 = ""
_DEX_SHA = "a039fd7d0398a424f20066b4f4ad80cca49385bc200c5d267693bc67c181053b"
_ERROR_STICKER_B64 = ""
_ERROR_STICKER_SHA = "3455cbe98277a4c1cfb915634f49c6b32e54d25b69ca15518a77ae465aea87c5"
_BAN_AUDIO_B64 = ""
_BAN_AUDIO_SHA = "8ef5dafd676273e5564e57fc298cc798377c792349bd69e47bd7b572ea45d59e"
_BUILD_SHA = "dd49a231ef0498e91afcd237f9e1fd3700b55301c096e84008c149cbbe938b90"
_SUPPORT_URL = "https://yoomoney.ru/quickpay/fundraise/button?billNumber=1KCA52HJPLD.260918"

class CustomProfileBannerPlugin(BasePlugin):

    def on_plugin_load(self):
        self._core = None
        try:
            self._core = self._load_core()
        except Exception as e:
            self.log("[cpb] dex core load failed: %s" % e)
            self._core = None
        if self._core is None:
            self.log("[cpb] плагин не активен: ядро не загрузилось")

    def on_plugin_unload(self):
        core = getattr(self, "_core", None)
        if core is None:
            return
        try:
            core.unload()
        except Exception as e:
            self.log("[cpb] unload failed: %s" % e)
        self._core = None

    def _load_core(self):
        import base64
        import hashlib
        import os
        import zlib

        from java import jclass
        from org.telegram.messenger import ApplicationLoader

        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            raise RuntimeError("нет контекста приложения")

        base = ctx.getFilesDir().getAbsolutePath()
        dex_dir = os.path.join(base, "cpb_native")
        os.makedirs(dex_dir, exist_ok=True)
        dex_path = os.path.join(dex_dir, "cpb_%s.dex" % _DEX_SHA[:16])
        audio_path = os.path.join(dex_dir, "ban_intro.m4a")
        audio_ok = False
        if os.path.exists(audio_path):
            try:
                with open(audio_path, "rb") as f:
                    audio_ok = hashlib.sha256(f.read()).hexdigest() == _BAN_AUDIO_SHA
            except Exception:
                pass
        if not audio_ok:
            audio = zlib.decompress(base64.b64decode(_BAN_AUDIO_B64))
            if hashlib.sha256(audio).hexdigest() != _BAN_AUDIO_SHA:
                raise RuntimeError("аудио бана не совпало с подписью")
            audio_tmp = audio_path + ".part"
            with open(audio_tmp, "wb") as f:
                f.write(audio)
            os.replace(audio_tmp, audio_path)
        sticker_dir = os.path.join(ctx.getCacheDir().getAbsolutePath(), "cpb_native")
        os.makedirs(sticker_dir, exist_ok=True)
        sticker_path = os.path.join(sticker_dir, "error_sticker.webp")

        sticker_ok = False
        if os.path.exists(sticker_path) and os.path.getsize(sticker_path) > 0:
            try:
                with open(sticker_path, "rb") as f:
                    sticker_ok = hashlib.sha256(f.read()).hexdigest() == _ERROR_STICKER_SHA
            except Exception:
                sticker_ok = False
        if not sticker_ok:
            sticker = zlib.decompress(base64.b64decode(_ERROR_STICKER_B64))
            got = hashlib.sha256(sticker).hexdigest()
            if got != _ERROR_STICKER_SHA:
                raise RuntimeError("баннер ошибки не совпал с подписью: %s" % got[:16])
            tmp = sticker_path + ".part"
            with open(tmp, "wb") as f:
                f.write(sticker)
            os.replace(tmp, sticker_path)

        if not os.path.exists(dex_path) or os.path.getsize(dex_path) == 0:
            # Ядро лежит в плагине сжатым: base64 раздувает содержимое на треть,
            # и несжатое оно занимало вдвое больше собственного веса.
            data = zlib.decompress(base64.b64decode(_DEX_B64))
            got = hashlib.sha256(data).hexdigest()
            if got != _DEX_SHA:
                # Ядро побилось по дороге: класть такое рядом и грузить нельзя.
                raise RuntimeError("ядро не совпало с подписью: %s" % got[:16])
            tmp = dex_path + ".part"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, dex_path)
            for old in os.listdir(dex_dir):
                if old.endswith(".dex") and old != os.path.basename(dex_path):
                    try:
                        os.chmod(os.path.join(dex_dir, old), 0o600)
                        os.remove(os.path.join(dex_dir, old))
                    except Exception:
                        pass
        try:
            os.chmod(dex_path, 0o400)
        except Exception:
            pass

        opt_dir = os.path.join(dex_dir, "opt")
        os.makedirs(opt_dir, exist_ok=True)

        DexClassLoader = jclass("dalvik.system.DexClassLoader")
        parent = ctx.getClassLoader()
        loader = DexClassLoader(dex_path, opt_dir, None, parent)
        core = loader.loadClass("cpb.CpbNative")

        legacy = self._collect_legacy()
        load = None
        for m in core.getDeclaredMethods():
            if m.getName() == "load":
                load = m
                break
        if load is None:
            raise RuntimeError("в ядре нет метода load")
        try:
            from java import jclass
            jclass("android.util.Log").i(
                "CpbNative", "plugin build " + _DEX_SHA[:12])
        except Exception:
            pass
        load.invoke(None, _args(ctx, legacy))
        # Версию и подпись сборки знает шим, а не ядро: сообщаем их для отчётов
        # об ошибках, чтобы в диагностике было видно, какая именно сборка стоит.
        try:
            for m in core.getDeclaredMethods():
                if m.getName() == "diagBuild":
                    m.invoke(None, _args(__version__, _DEX_SHA))
                    break
        except Exception as e:
            self.log("[cpb] версия для отчётов не передана: %s" % e)
        self.log("[cpb] ядро загружено, перенесено настроек: %d" % legacy.size())
        return _Core(core)

    def _collect_legacy(self):
        from java import jclass

        HashMap = jclass("java.util.HashMap")
        out = HashMap()
        out.put("__cpb_build_sha", _BUILD_SHA)
        tag = self._acct_tag()
        missing = object()
        for key in _LEGACY_KEYS:
            for full in (tag + "_" + key, key):
                try:
                    value = self.get_setting(full, missing)
                except Exception:
                    value = missing
                if value is not missing and value is not None:
                    out.put(tag + "_" + key, self._as_java(value))
                    break
        for key in _LEGACY_ACCT_KEYS:
            try:
                value = self.get_setting(tag + "_" + key, missing)
            except Exception:
                value = missing
            if value is not missing and value is not None:
                out.put(tag + "_" + key, self._as_java(value))
        return out

    @staticmethod
    def _as_java(value):
        from java import jclass
        if isinstance(value, bool):
            return jclass("java.lang.Boolean")(bool(value))
        if isinstance(value, int):
            return jclass("java.lang.Integer")(int(value))
        if isinstance(value, float):
            return jclass("java.lang.Float")(float(value))
        return str(value)

    def _acct_tag(self):
        try:
            from hook_utils import find_class
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = int(uc.selectedAccount)
            uid = int(uc.getInstance(acc).getClientUserId())
            return str(uid) if uid > 0 else ("slot%d" % acc)
        except Exception:
            return "0"

    def _t(self, ru, en):
        """
        Подпись на языке человека.

        Язык знает ядро — там же, где его выбирают, — а страница только
        спрашивает. Свой выбор языка здесь означал бы, что настройки говорят на
        одном языке, а всё остальное на другом.
        """
        try:
            return en if self._core.english() else ru
        except Exception:
            return ru

    def _flag(self, key, default=False):
        try:
            return bool(self._core.flag_of(key))
        except Exception:
            return default

    def _set_flag(self, key, value):
        try:
            self._core.flag_set(key, bool(value))
        except Exception as e:
            self.log("[cpb] настройка %s не легла: %s" % (key, e))

    def _row(self, kind, **kwargs):
        """
        Собирает строку настроек, отбрасывая то, чего не знает эта сборка.

        У разных версий клиента разный набор именованных доводов: где-то нет
        значка, где-то — своей ссылки. Строка без значка выглядит скромнее, но
        показывается; строка, собранная с чужим доводом, не показывается вовсе.
        """
        if kind is None:
            return None
        try:
            return kind(**kwargs)
        except TypeError:
            pass
        for name in ("link_alias", "icon", "subtext"):
            kwargs.pop(name, None)
            try:
                return kind(**kwargs)
            except TypeError:
                continue
        return None

    def _switch(self, key, title, hint, icon, default=False):
        """Переключатель, который правит настройку ядра, а не свою копию."""
        return self._row(
            Switch,
            key="cpb_" + key,
            text=title,
            subtext=hint,
            icon=icon,
            default=self._flag(key, default),
            link_alias=key,
            on_change=lambda value: self._set_flag(key, value),
        )

    def _lang_row(self):
        """
        Выбор языка плагина: авто, русский, английский.

        Тот же выбор есть в редакторе оформления, и настройка у них одна на
        двоих: здесь она просто на виду у тех, кто в редактор не заходит.
        """
        if Selector is None:
            return None
        modes = ("auto", "ru", "en")
        try:
            current = str(self._core.lang_mode())
        except Exception:
            current = "auto"
        at = modes.index(current) if current in modes else 0

        def choose(index):
            try:
                self._core.set_lang_mode(modes[int(index)])
            except Exception as e:
                self.log("[cpb] язык не сменился: %s" % e)

        return self._row(
            Selector,
            key="cpb_ui_lang",
            text=self._t("Язык плагина", "Plugin language"),
            default=at,
            items=[self._t("Авто", "Auto"), "Русский", "English"],
            icon="msg_translate",
            link_alias="language",
            on_change=choose,
        )

    def _section(self, ru, en, rows, note=None):
        """Нативная группа: заголовок, ячейки и серый разделитель клиента."""
        rows = [row for row in rows if row is not None]
        if not rows:
            return []
        header = self._row(Header, text=self._t(ru, en))
        divider = self._row(Divider, text=note or "")
        return [row for row in [header, *rows, divider] if row is not None]

    def _display_page(self):
        """Что пользователь видит в чатах; настройки своего оформления — отдельно."""
        return self._section("В чатах и списках", "In chats and lists", [
            self._switch("chat_decor",
                         self._t("Рамки вне профиля", "Frames outside profiles"),
                         self._t("Рамки в чатах и списках пользователей", "Frames in chats and user lists"),
                         "msg_media", True),
            self._switch("chat_badges_enabled",
                         self._t("Фоновые бейджики", "Background badges"),
                         self._t("Изображения на карточках пользователей", "Images on user cards"),
                         "msg_gallery", True),
            self._switch("chat_bubbles",
                         self._t("Пузырьки сообщений", "Message bubbles"),
                         self._t("Оформление ваших сообщений и сообщений собеседников", "Custom bubbles for you and other users"),
                         "msg_discussion", True),
        ]) + self._section("Отклик", "Feedback", [
            self._switch("haptic_enabled",
                         self._t("Виброотклик", "Haptic feedback"),
                         self._t("Отклик на нажатия и действия в плагине", "Feedback for taps and actions in the plugin"),
                         "msg_customize", True),
        ])

    def _music_page(self):
        return self._section("Плеер", "Player", [
            self._switch("player_cover",
                         self._t("Обложка под плеером", "Cover behind the player"),
                         self._t("Цвета обложки в оформлении плеера", "Cover colors in the player"),
                         "msg_media", True),
        ]) + self._section("Текст песни", "Lyrics", [
            self._switch("lyrics_plasma",
                         self._t("Анимированный фон", "Animated background"),
                         self._t("Движение цветов обложки за текстом песни", "Moving cover colors behind the lyrics"),
                         "msg_customize", True),
        ])

    def _power_page(self):
        """Только параметры, уменьшающие расход ресурсов и анимации рамок."""
        return self._section("Статичные рамки", "Static frames", [
            self._switch("bake_outside",
                         self._t("В чатах и списках", "In chats and lists"),
                         self._t("Останавливать анимацию рамок вне профиля", "Freeze frame animations outside profiles"),
                         "files_storage"),
            self._switch("bake_profile",
                         self._t("В профилях", "In profiles"),
                         self._t("Останавливать анимацию рамки в профиле", "Freeze frame animations in profiles"),
                         "msg_photos"),
        ], self._t("Снижает нагрузку и расход батареи. Оформление остаётся видимым.",
                   "Reduces load and battery use. Decorations remain visible."))

    def _dev_mode(self):
        try:
            return bool(self._core.dev_mode())
        except Exception:
            return False

