from typing import Any, List

from base_plugin import BasePlugin
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread
import ui.settings as _uisettings

def _ui_optional(_name):
    try:
        return getattr(_uisettings, _name)
    except Exception:
        return None

Header = _ui_optional("Header")
Text = _ui_optional("Text")
Switch = _ui_optional("Switch")
Selector = _ui_optional("Selector")
Divider = _ui_optional("Divider")

__id__ = "custom_profile"
__name__ = "Custom Profile"
__description__ = (
    "Раскрасьте свой профиль используя этот плагин!\n\n"
    " ↑ Настройки на разных версиях: \n"
    " |  ExteraGram 12.5.1> - Профиль -> ⋮ -> Оформить профиль\n"
    " |  ExteraGram 12.8.1 - Настройки плагина"
)
__author__ = "@RoflPlugins"
__version__ = "1.8"
__icon__ = "RoflPlugins/18"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.0"

_LEGACY_KEYS = [
    "enabled", "show_emoji", "banner_mode", "banner_path", "banner_color",
    "grad_type", "grad_dir", "grad_angle", "grad_c1", "grad_c2", "grad_c3",
    "grad_use3", "grad_radius", "grad_count", "banner_alpha", "banner_fade",
    "banner_fade_angle", "banner_fade_radius", "bg_alpha", "bg_fade",
    "bg_fade_angle", "bg_fade_radius", "grad_cx", "grad_cy", "banner_fade_cx",
    "banner_fade_cy", "bg_fade_cx", "bg_fade_cy", "bg_enabled", "bg_mode",
    "bg_color", "bg_path", "share_enabled", "last_pub_sig", "avatar_shape",
    "avatar_radius", "avatar_round", "avatar_custom", "avatar_alpha",
    "blocks_color_enabled", "blocks_color", "blocks_alpha", "blocks_blur",
    "blocks_depth", "publish_consent", "remote_enabled", "remote_prompted",
    "name_grad_angle", "name_size", "name_font", "banner_dim", "bg_dim",
    "avatar_dim", "name_font_path", "thought_text", "thought_text_color",
    "thought_bg_color", "thought_font", "thought_font_copy",
    "thought_font_path", "name_color_enabled", "name_color",
    "name_glow_enabled", "name_glow_color", "name_glow_radius",
    "name_glow_strength", "name_fx", "name_fx_speed", "name_grad_c1",
    "name_grad_c2", "avatar_fade", "avatar_fade_radius",
    "profile_text_color_enabled", "profile_text_color",
    "profile_hint_color_enabled", "profile_hint_color",
    "profile_action_color_enabled", "profile_action_color",
    "banner_sound", "banner_sound_volume", "bg_sound", "bg_sound_volume",
]

_LEGACY_ACCT_KEYS = ["device_key", "cpb_likes"]

_DEX_B64 = ""
_DEX_SHA = "623bd07491d7898343a26e6613da0b251b30fcd00776549ca05562e70ddb79ca"
_BUILD_SHA = "5471f79734bad2941548f90f522b9c35ad03932e18ce77833138ff29c271c072"

class CustomProfileBannerPlugin(BasePlugin):

    def on_plugin_load(self):
        self._core = None
        try:
            self._core = self._load_core()
        except Exception as e:
            self.log("[cpb] dex core load failed: %s" % e)
            self._core = None
        if self._core is None:
            self.log("[cpb] плагин не активен: ядро не загрузилось")

    def on_plugin_unload(self):
        core = getattr(self, "_core", None)
        if core is None:
            return
        try:
            core.unload()
        except Exception as e:
            self.log("[cpb] unload failed: %s" % e)
        self._core = None

    def _load_core(self):
        import base64
        import hashlib
        import os
        import zlib

        from java import jclass
        from org.telegram.messenger import ApplicationLoader

        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            raise RuntimeError("нет контекста приложения")

        base = ctx.getFilesDir().getAbsolutePath()
        dex_dir = os.path.join(base, "cpb_native")
        os.makedirs(dex_dir, exist_ok=True)
        dex_path = os.path.join(dex_dir, "cpb_%s.dex" % _DEX_SHA[:16])

        if not os.path.exists(dex_path) or os.path.getsize(dex_path) == 0:
            # Ядро лежит в плагине сжатым: base64 раздувает содержимое на треть,
            # и несжатое оно занимало вдвое больше собственного веса.
            data = zlib.decompress(base64.b64decode(_DEX_B64))
            got = hashlib.sha256(data).hexdigest()
            if got != _DEX_SHA:
                # Ядро побилось по дороге: класть такое рядом и грузить нельзя.
                raise RuntimeError("ядро не совпало с подписью: %s" % got[:16])
            tmp = dex_path + ".part"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, dex_path)
            for old in os.listdir(dex_dir):
                if old.endswith(".dex") and old != os.path.basename(dex_path):
                    try:
                        os.chmod(os.path.join(dex_dir, old), 0o600)
                        os.remove(os.path.join(dex_dir, old))
                    except Exception:
                        pass
        try:
            os.chmod(dex_path, 0o400)
        except Exception:
            pass

        opt_dir = os.path.join(dex_dir, "opt")
        os.makedirs(opt_dir, exist_ok=True)

        DexClassLoader = jclass("dalvik.system.DexClassLoader")
        parent = ctx.getClassLoader()
        loader = DexClassLoader(dex_path, opt_dir, None, parent)
        core = loader.loadClass("cpb.CpbNative")

        legacy = self._collect_legacy()
        load = None
        for m in core.getDeclaredMethods():
            if m.getName() == "load":
                load = m
                break
        if load is None:
            raise RuntimeError("в ядре нет метода load")
        try:
            from java import jclass
            jclass("android.util.Log").i(
                "CpbNative", "plugin build " + _DEX_SHA[:12])
        except Exception:
            pass
        load.invoke(None, _args(ctx, legacy))
        # Версию и подпись сборки знает шим, а не ядро: сообщаем их для отчётов
        # об ошибках, чтобы в диагностике было видно, какая именно сборка стоит.
        try:
            for m in core.getDeclaredMethods():
                if m.getName() == "diagBuild":
                    m.invoke(None, _args(__version__, _DEX_SHA))
                    break
        except Exception as e:
            self.log("[cpb] версия для отчётов не передана: %s" % e)
        self.log("[cpb] ядро загружено, перенесено настроек: %d" % legacy.size())
        return _Core(core)

    def _collect_legacy(self):
        from java import jclass

        HashMap = jclass("java.util.HashMap")
        out = HashMap()
        out.put("__cpb_build_sha", _BUILD_SHA)
        tag = self._acct_tag()
        missing = object()
        for key in _LEGACY_KEYS:
            for full in (tag + "_" + key, key):
                try:
                    value = self.get_setting(full, missing)
                except Exception:
                    value = missing
                if value is not missing and value is not None:
                    out.put(tag + "_" + key, self._as_java(value))
                    break
        for key in _LEGACY_ACCT_KEYS:
            try:
                value = self.get_setting(tag + "_" + key, missing)
            except Exception:
                value = missing
            if value is not missing and value is not None:
                out.put(tag + "_" + key, self._as_java(value))
        return out

    @staticmethod
    def _as_java(value):
        from java import jclass
        if isinstance(value, bool):
            return jclass("java.lang.Boolean")(bool(value))
        if isinstance(value, int):
            return jclass("java.lang.Integer")(int(value))
        if isinstance(value, float):
            return jclass("java.lang.Float")(float(value))
        return str(value)

    def _acct_tag(self):
        try:
            from hook_utils import find_class
            uc = find_class("org.telegram.messenger.UserConfig")
            acc = int(uc.selectedAccount)
            uid = int(uc.getInstance(acc).getClientUserId())
            return str(uid) if uid > 0 else ("slot%d" % acc)
        except Exception:
            return "0"

    def _t(self, ru, en):
        """
        Подпись на языке человека.

        Язык знает ядро — там же, где его выбирают, — а страница только
        спрашивает. Свой выбор языка здесь означал бы, что настройки говорят на
        одном языке, а всё остальное на другом.
        """
        try:
            return en if self._core.english() else ru
        except Exception:
            return ru

    def _flag(self, key, default=False):
        try:
            return bool(self._core.flag_of(key))
        except Exception:
            return default

    def _set_flag(self, key, value):
        try:
            self._core.flag_set(key, bool(value))
        except Exception as e:
            self.log("[cpb] настройка %s не легла: %s" % (key, e))

    def _row(self, kind, **kwargs):
        """
        Собирает строку настроек, отбрасывая то, чего не знает эта сборка.

        У разных версий клиента разный набор именованных доводов: где-то нет
        значка, где-то — своей ссылки. Строка без значка выглядит скромнее, но
        показывается; строка, собранная с чужим доводом, не показывается вовсе.
        """
        if kind is None:
            return None
        try:
            return kind(**kwargs)
        except TypeError:
            pass
        for name in ("link_alias", "icon", "subtext"):
            kwargs.pop(name, None)
            try:
                return kind(**kwargs)
            except TypeError:
                continue
        return None

    def _switch(self, key, title, hint, icon, default=False):
        """Переключатель, который правит настройку ядра, а не свою копию."""
        return self._row(
            Switch,
            key="cpb_" + key,
            text=title,
            subtext=hint,
            icon=icon,
            default=self._flag(key, default),
            link_alias=key,
            on_change=lambda value: self._set_flag(key, value),
        )

    def _lang_row(self):
        """
        Выбор языка плагина: авто, русский, английский.

        Тот же выбор есть в редакторе оформления, и настройка у них одна на
        двоих: здесь она просто на виду у тех, кто в редактор не заходит.
        """
        if Selector is None:
            return None
        modes = ("auto", "ru", "en")
        try:
            current = str(self._core.lang_mode())
        except Exception:
            current = "auto"
        at = modes.index(current) if current in modes else 0

        def choose(index):
            try:
                self._core.set_lang_mode(modes[int(index)])
            except Exception as e:
                self.log("[cpb] язык не сменился: %s" % e)

        return self._row(
            Selector,
            key="cpb_ui_lang",
            text=self._t("Язык плагина", "Plugin language"),
            default=at,
            items=[self._t("Авто", "Auto"), "Русский", "English"],
            icon="msg_translate",
            link_alias="language",
            on_change=choose,
        )

    def _power_page(self):
        """Раздел «Энергосбережение»: те же тумблеры, что и у экрана клиента."""
        rows = [
            self._row(Header, text=self._t("Расход батареи", "Battery use")),
            self._switch("chat_decor",
                         self._t("Видеть рамки вне профиля",
                                 "Show frames outside profiles"),
                         self._t("Рамки и украшения в списках чатов и в переписке.",
                                 "Frames and decorations in chat lists and chats."),
                         "msg_media", True),
            self._switch("bake_outside",
                         self._t("Запекание вне профиля", "Baking outside profiles"),
                         self._t("Чужое оформление рисуется одной готовой текстурой:"
                                 " легче для батареи, но анимация застывает.",
                                 "Someone's decoration is drawn as one ready texture:"
                                 " easier on the battery, but the animation freezes."),
                         "files_storage"),
            self._switch("bake_profile",
                         self._t("Запекание в профиле", "Baking in profiles"),
                         self._t("То же самое на самом экране профиля.",
                                 "The same on the profile screen itself."),
                         "msg_photos"),
        ]
        return [row for row in rows if row is not None]

    def _dev_mode(self):
        try:
            return bool(self._core.dev_mode())
        except Exception:
            return False

    def _open_thanks(self):
        try:
            self._core.open_thanks()
        except Exception as e:
            self.log("[cpb] список поддержавших не открылся: %s" % e)

    def _open_bubble(self):
        try:
            self._core.open_bubble()
        except Exception as e:
            self.log("[cpb] лист пузырька не открылся: %s" % e)

    def _dev_page(self):
        """
        Раздел разработчика: выбор сервера и проверка связи.

        Открывается пятью нажатиями по полосе вверху настроек. Обычному человеку
        он не нужен, а на виду только путал бы: переключить сервер значит уйти на
        пустую базу.
        """
        rows = [
            self._row(Header, text=self._t("Разработка", "Development")),
            self._row(Text, text=self._t("Проверить связь", "Check servers"),
                      subtext=self._t("Сколько идёт ответ от каждого сервера",
                                      "How long each server takes to answer"),
                      icon="msg_speed", link_alias="ping",
                      on_click=lambda _: self._ping()),
            self._row(Text, text=self._t("Журнал плагина", "Plugin log"),
                      subtext=self._t("Что плагин записал о себе за этот запуск",
                                      "What the plugin recorded about itself"),
                      icon="msg_log", link_alias="log",
                      on_click=lambda _: self._open_log()),
        ]
        return [row for row in rows if row is not None]

    def _open_log(self):
        try:
            self._core.open_log()
        except Exception as e:
            self.log("[cpb] журнал не открылся: %s" % e)

    def _ping(self):
        try:
            self._core.ping_servers()
        except Exception as e:
            self.log("[cpb] связь не проверилась: %s" % e)

    def _about_page(self):
        """Раздел «О плагине»: куда идти с вопросами."""
        rows = [
            self._row(Header, text="Custom Profile " + __version__),
            self._row(Text, text=self._t("Канал плагина", "Plugin channel"),
                      icon="msg_channel", link_alias="channel",
                      on_click=lambda _: self._open("RoflPlugins")),
            # Вместо одного автора — те, кто поддержал плагин: он держится не на
            # одном человеке. Список приходит с сервера, лица рисует клиент.
            self._row(Text, text=self._t("Спасибо", "Thanks"), icon="msg_fave",
                      subtext=self._t("Те, кто поддержал плагин",
                                      "People who supported the plugin"),
                      link_alias="thanks",
                      on_click=lambda _: self._open_thanks()),
        ]
        return [row for row in rows if row is not None]

    def _open(self, username):
        try:
            from android_utils import run_on_ui_thread as _ui
            from client_utils import get_last_fragment
            from android.content import Intent
            from android.net import Uri

            def go():
                fragment = get_last_fragment()
                context = fragment.getParentActivity() if fragment else None
                if context is None:
                    return
                context.startActivity(Intent(Intent.ACTION_VIEW,
                                             Uri.parse("tg://resolve?domain=" + username)))

            _ui(go)
        except Exception as e:
            self.log("[cpb] ссылка не открылась: %s" % e)

    def create_settings(self) -> List[Any]:
        # Оформление правится в самом профиле, где сразу видно, что меняется, а
        # здесь собрано то, что к профилю не привязано: расход батареи, вид своих
        # сообщений у собеседников и куда идти с вопросами. Разделы уходят на свои
        # страницы: списком в одну простыню это читается хуже, а у каждой строки
        # есть своя ссылка, которую клиент даёт скопировать.
        core = getattr(self, "_core", None)
        if core is None:
            rows = [
                self._row(Header, text="Custom Profile"),
                self._row(Text, text=self._t(
                    "Ядро плагина не загрузилось — переустановите плагин.",
                    "The plugin core did not load — reinstall the plugin.")),
            ]
            return [row for row in rows if row is not None]
        rows = [
            self._lang_row(),
            self._row(Text, text=self._t("Энергосбережение", "Battery saving"),
                      icon="msg_speed",
                      create_sub_fragment=lambda: self._power_page(),
                      link_alias="power"),
            # Настройки пузырька живут листом «Дополнительных функций»: там
            # цвета, перелив, направление и живой образец. Второй набор ячеек
            # здесь означал бы две правды об одном и том же.
            self._row(Text, text=self._t("Пузырёк сообщений", "Message bubble"),
                      icon="msg_msgbubble2",
                      subtext=self._t("Цвет, перелив, направление и цвет текста",
                                      "Color, gradient, direction and text color"),
                      on_click=lambda _: self._open_bubble(),
                      link_alias="bubble"),
            self._row(Text, text=self._t("Обновления", "Updates"),
                      icon="msg_download",
                      subtext=self._t("Проверка при входе и ранние сборки",
                                      "Check on start and early builds"),
                      create_sub_fragment=lambda: self._updates_page(),
                      link_alias="updates"),
            self._row(Text, text=self._t("О плагине", "About"), icon="msg_info",
                      create_sub_fragment=lambda: self._about_page(),
                      link_alias="about"),
        ]
        dev = self._dev_mode()
        self.log("[cpb] страница настроек: разработчик=%s" % dev)
        if dev:
            rows.append(self._row(
                Text, text=self._t("Настройки разработчика", "Developer settings"),
                icon="msg_customize", link_alias="developer",
                create_sub_fragment=lambda: self._dev_page()))
        return [row for row in rows if row is not None]


def _args(*values):
    from java import jarray, jclass
    arr = jarray(jclass("java.lang.Object"))(len(values))
    for i, v in enumerate(values):
        arr[i] = v
    return arr

class _Core:

    def __init__(self, cls):
        self._cls = cls
        self._methods = {}
        for m in cls.getDeclaredMethods():
            self._methods.setdefault(m.getName(), m)

    def unload(self):
        m = self._methods.get("unload")
        if m is not None:
            m.invoke(None, _args())

    def dev_mode(self):
        m = self._methods.get("devMode")
        if m is None:
            return False
        return bool(m.invoke(None, _args()))

    def check_update(self):
        m = self._methods.get("checkUpdate")
        if m is None:
            raise RuntimeError("в ядре нет checkUpdate")
        m.invoke(None, _args())

    def unskip_release(self):
        m = self._methods.get("unskipRelease")
        if m is None:
            raise RuntimeError("в ядре нет unskipRelease")
        m.invoke(None, _args())

    def open_log(self):
        m = self._methods.get("openLog")
        if m is None:
            raise RuntimeError("в ядре нет openLog")
        m.invoke(None, _args())

    def ping_servers(self):
        m = self._methods.get("pingServers")
        if m is None:
            raise RuntimeError("в ядре нет pingServers")
        m.invoke(None, _args())

    def lang_mode(self):
        m = self._methods.get("langMode")
        if m is None:
            return "auto"
        return m.invoke(None, _args())

    def set_lang_mode(self, mode):
        m = self._methods.get("setLangMode")
        if m is None:
            raise RuntimeError("в ядре нет setLangMode")
        m.invoke(None, _args(str(mode)))

    def english(self):
        m = self._methods.get("english")
        if m is None:
            return False
        return bool(m.invoke(None, _args()))

    def flag_of(self, key):
        m = self._methods.get("flagOf")
        if m is None:
            raise RuntimeError("в ядре нет flagOf")
        return m.invoke(None, _args(key))

    def open_thanks(self):
        m = self._methods.get("openThanks")
        if m is None:
            raise RuntimeError("в ядре нет openThanks")
        m.invoke(None, _args())

    def open_bubble(self):
        m = self._methods.get("openBubbleSheet")
        if m is None:
            raise RuntimeError("в ядре нет openBubbleSheet")
        m.invoke(None, _args())

    def flag_set(self, key, value):
        m = self._methods.get("flagSet")
        if m is None:
            raise RuntimeError("в ядре нет flagSet")
        from java import jboolean
        m.invoke(None, _args(key, jboolean(bool(value))))


