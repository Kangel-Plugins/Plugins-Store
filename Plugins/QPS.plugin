_CARDS_CELL_CANDIDATES = (
    "com.exteragram.messenger.plugins.ui.components.PluginCell",
    "com.exteragram.messenger.plugins.ui.PluginCell",
    "com.exteragram.messenger.plugins.ui.cells.PluginCell",
    "com.exteragram.messenger.plugins.components.PluginCell",
    "com.exteragram.messenger.plugins.PluginCell",
)
_CARDS_ENGINE_CANDIDATES = (
    "com.exteragram.messenger.plugins.Engine",
    "com.exteragram.messenger.plugins.PluginsEngine",
    "com.exteragram.messenger.plugins.engine.Engine",
)
_CARDS_BIND_METHODS = ("set", "bindNormalState", "bindErrorState", "bindNotRespondingState")


def _cards_java_class(name):
    from java import jclass
    loader = ApplicationLoader.applicationContext.getClassLoader()
    return jclass("java.lang.Class").forName(name, False, loader)


def _cards_find_class(simple, candidates):
    """java.lang.Class по простому имени: кандидаты -> типы внутри PluginsActivity/PluginsController -> DexFile APK."""
    for n in candidates:
        try:
            return _cards_java_class(n)
        except Exception:
            pass
    try:
        for base in (PluginsActivity, PluginsController):
            bc = _cards_java_class_of(base)
            types = []
            for f in bc.getDeclaredFields():
                types.append(f.getType())
            for m in bc.getDeclaredMethods():
                types.append(m.getReturnType())
                types.extend(list(m.getParameterTypes()))
            for k in bc.getDeclaredClasses():
                types.append(k)
            for t in types:
                if str(t.getSimpleName()) == simple:
                    return t
    except Exception as e:
        log(f"[{__id__}] cards: class scan({simple}) failed: {e}")
    try:
        from java import jclass
        info = ApplicationLoader.applicationContext.getApplicationInfo()
        paths = [str(info.sourceDir)] + [str(x) for x in (info.splitSourceDirs or [])]
        DexFile = jclass("dalvik.system.DexFile")
        for p in paths:
            df = DexFile(p)
            en = df.entries()
            while en.hasMoreElements():
                n = str(en.nextElement())
                if n.endswith("." + simple) and "$" not in n:
                    return _cards_java_class(n)
    except Exception as e:
        log(f"[{__id__}] cards: DexFile scan({simple}) failed: {e}")
    return None


def _cards_java_class_of(jc):
    """Chaquopy jclass -> java.lang.Class."""
    try:
        return _cards_java_class(str(jc.getName()))
    except Exception:
        pass
    return jc.getClass()


class QpsCardsDex:
    """Ленивая загрузка dex карточек; вызовы через рефлексию, только UI-поток."""

    def __init__(self):
        self._lock = threading.Lock()
        self._m = None
        self.error = None
        self._spread = True

    def _load_locked(self):
        from java import jclass, jarray, jbyte
        data = _cards_b64.b64decode(_QPS_CARDS_DEX_B64)
        buf = jclass("java.nio.ByteBuffer").wrap(jarray(jbyte)(data))
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = jclass("dalvik.system.InMemoryDexClassLoader")(buf, parent)
        cls = loader.loadClass(QPS_CARDS_DEX_CLASS)
        C = jclass("java.lang.Class")
        obj, st = C.forName("java.lang.Object"), C.forName("java.lang.String")
        self._m = {"apply": cls.getMethod("apply", obj, obj, st, obj, obj),
                   "remove": cls.getMethod("remove", obj),
                   "find": cls.getMethod("find", obj, st),
                   "version": cls.getMethod("version")}
        self._loader = loader

    def ensure(self):
        if self._m is not None:
            return True
        with self._lock:
            if self._m is None:
                try:
                    self._load_locked()
                    self.error = None
                except Exception:
                    self.error = traceback.format_exc()
                    self._m = None
                    log(f"[{__id__}] cards dex load failed: {self.error}")
        return self._m is not None

    def _invoke(self, name, *args):
        m = self._m[name]
        if self._spread:
            try:
                return m.invoke(None, *args)
            except TypeError:
                self._spread = False
        from java import jclass, jarray
        return m.invoke(None, jarray(jclass("java.lang.Object"))(list(args)))

    def apply(self, anchor, hide, js, tf_reg, tf_med):
        if not self.ensure():
            return "err:dex_not_loaded"
        return str(self._invoke("apply", anchor, hide, js, tf_reg, tf_med))

    def remove(self, root):
        if not self.ensure():
            return -1
        return int(self._invoke("remove", root))

    def find(self, root, cls_name):
        if not self.ensure():
            return []
        return list(self._invoke("find", root, cls_name) or [])

    def close(self):
        with self._lock:
            self._m = None


_QPS_CARDS_DEX = QpsCardsDex()


class QpsCardHook(XposedHook):
    """after-хук PluginCell.set/bind*State."""

    def __init__(self, plugin_instance, kind):
        super().__init__()
        self.plugin = plugin_instance
        self.kind = kind

    @guard(msg="QPS card hook failed")
    def after_hooked_method(self, param):
        p = self.plugin
        if p._unloaded:
            return
        a = param.args
        p._cards_on_cell(param.thisObject, a[0] if (self.kind == "set" and len(a) >= 1) else None)


class QpsLoadTimeHook(XposedHook):
    """before/after Engine.loadPlugin / setPluginEnabled(True) -> load_times.json."""

    def __init__(self, plugin_instance, kind):
        super().__init__()
        self.plugin = plugin_instance
        self.kind = kind

    @guard(msg="QPS load-time hook (before) failed")
    def before_hooked_method(self, param):
        if not self.plugin._unloaded:
            self.plugin._cards_lt_enter(param.args, self.kind)

    @guard(msg="QPS load-time hook (after) failed")
    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        thr = None
        try:
            thr = param.getThrowable()
        except Exception:
            pass
        self.plugin._cards_lt_exit(param.args, self.kind, failed=thr is not None)


def _cards_arg_id(args):
    for x in args:
        if isinstance(x, str) and x:
            return x
    return None


def _cards_arg_bool(args):
    for x in args:
        if isinstance(x, bool):
            return x
    return None


def _cards_get(obj, *names):
    for n in names:
        try:
            v = getattr(obj, n)
            if callable(v):
                v = v()
            if v is not None and str(v).strip():
                return str(v).strip()
        except Exception:
            pass
    return ""


class CardsMixin:
    def _cards_state(self):
        st = getattr(self, "_cards", None)
        if st is None:
            st = {"on": True, "dirty": False, "hooks": [], "fields": {}, "info": {}, "errs": (0.0, {}),
                  "lt": {}, "lt_depth": {}, "lt_t0": {}, "lt_last": {}, "lt_lock": threading.Lock(),
                  "save_timer": None, "cell_cls": None, "logged": 0, "sig": {}}
            self._cards = st
        return st

    # ---------------------------------------------------------------- жизненный цикл
    @safe(msg="QPS cards on_load failed", notify=False)
    def _cards_on_load(self):
        st = self._cards_state()
        st["on"] = bool(self.get_setting("cards_replace", True))
        d = safety_read_json(QPS_CARDS_LT_FILE, {})
        st["lt"] = d if isinstance(d, dict) else {}
        n = 0
        cell = _cards_find_class("PluginCell", _CARDS_CELL_CANDIDATES)
        st["cell_cls"] = cell
        if cell is None:
            log(f"[{__id__}] cards: PluginCell class not found")
        else:
            for m in cell.getDeclaredMethods():
                name = str(m.getName())
                if name not in _CARDS_BIND_METHODS:
                    continue
                if name == "set" and len(m.getParameterTypes()) != 2:
                    continue
                h = self.hook_method(m, QpsCardHook(self, "set" if name == "set" else "bind"))
                if h:
                    st["hooks"].append(h)
                    n += 1
            log(f"[{__id__}] cards: {cell.getName()} hooks={n}")
        # замер времени
        engine = _cards_find_class("Engine", _CARDS_ENGINE_CANDIDATES)
        m_n = 0
        if engine is not None:
            for m in engine.getDeclaredMethods():
                name = str(m.getName())
                if name in ("loadPlugin", "setPluginEnabled"):
                    h = self.hook_method(m, QpsLoadTimeHook(self, "load" if name == "loadPlugin" else "enable"))
                    if h:
                        st["hooks"].append(h)
                        m_n += 1
            log(f"[{__id__}] cards: Engine={engine.getName()} time hooks={m_n}")
        else:  # запасной путь: только включение через контроллер (уже проверено, что он хукается)
            try:
                for m in _cards_java_class_of(PluginsController).getDeclaredMethods():
                    if str(m.getName()) == "setPluginEnabled":
                        h = self.hook_method(m, QpsLoadTimeHook(self, "enable"))
                        if h:
                            st["hooks"].append(h)
                            m_n += 1
            except Exception as e:
                log(f"[{__id__}] cards: controller time hook failed: {e}")
            log(f"[{__id__}] cards: Engine class not found, controller hooks={m_n}")

    @safe(msg="QPS cards on_unload failed", notify=False)
    def _cards_on_unload(self):
        st = self._cards_state()
        for h in st["hooks"]:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        st["hooks"].clear()
        t = st.get("save_timer")
        if t is not None:
            t.cancel()
            self._cards_lt_save()
        try:
            run_on_ui_thread(self._cards_remove_all)   # вернуть оригинальные карточки
        except Exception:
            pass

    # ---------------------------------------------------------------- настройка
    def _cards_settings_items(self):
        return [
            Header(text=localise("Q5_CARDS_HEADER")),
            Switch(key="cards_replace", text=localise("Q5_CARDS_SWITCH"), default=True,
                   on_change=lambda v: self._cards_toggle(bool(v))),
            Divider(text=localise("Q5_CARDS_NOTE")),
        ]

    def _cards_toggle(self, value):
        st = self._cards_state()
        st["on"] = bool(value)
        st["sig"].clear()
        if value:
            run_on_ui_thread(self._cards_redecorate_all)
        else:
            st["dirty"] = True
            run_on_ui_thread(self._cards_remove_all)

    def _cards_root(self):
        from org.telegram.ui import LaunchActivity
        act = LaunchActivity.instance
        return act.getWindow().getDecorView() if act is not None else None

    @guard(msg="QPS cards remove failed")
    def _cards_remove_all(self):
        root = self._cards_root()
        if root is not None:
            n = _QPS_CARDS_DEX.remove(root)
            log(f"[{__id__}] cards: removed blocks={n}")

    @guard(msg="QPS cards redecorate failed")
    def _cards_redecorate_all(self):
        root = self._cards_root()
        cell_cls = self._cards_state()["cell_cls"]
        if root is None or cell_cls is None:
            return
        for cell in _QPS_CARDS_DEX.find(root, "PluginCell"):
            self._cards_on_cell(cell, None)

    # ---------------------------------------------------------------- поля/данные
    def _cards_field(self, obj, name):
        st = self._cards_state()
        cls = obj.getClass()
        key = (str(cls.getName()), name)
        f = st["fields"].get(key, False)
        if f is False:
            f = None
            c = cls
            while c is not None and f is None:
                try:
                    f = c.getDeclaredField(name)
                    f.setAccessible(True)
                except Exception:
                    f = None
                    c = c.getSuperclass()
            st["fields"][key] = f
        if f is None:
            return None
        try:
            return f.get(obj)
        except Exception:
            return None

    def _cards_errors(self):
        """{id: число ошибок за 24 ч}, обновляется не чаще раза в QPS_CARDS_ERR_TTL."""
        st = self._cards_state()
        ts, cur = st["errs"]
        now = time.time()
        if now - ts < QPS_CARDS_ERR_TTL:
            return cur
        data = safety_read_json("error_counts.json", {})
        lim = now - QPS_CARDS_UNSTABLE_HOURS * 3600
        res = {}
        if isinstance(data, dict):
            for pid, e in data.items():
                try:
                    c = sum(1 for t in (e or {}).get("events", []) if isinstance(t, int) and t >= lim)
                except Exception:
                    c = 0
                if c:
                    res[str(pid)] = c
        st["errs"] = (now, res)
        return res

    def _cards_info(self, pid, plugin):
        st = self._cards_state()
        now = time.time()
        c = st["info"].get(pid)
        if c and now - c[0] < QPS_CARDS_INFO_TTL:
            return c[1]
        try:
            commands = [str(x) for x in (self._get_plugin_commands(pid) or [])]
        except Exception:
            commands = []
        info = {"version": _cards_get(plugin, "getVersion", "version"), "author": _cards_get(plugin, "getAuthor", "author"),
                "commands": commands}
        st["info"][pid] = (now, info)
        return info

    def _cards_on_cell(self, cell, plugin):
        st = self._cards_state()
        if not st["on"]:
            if st["dirty"]:
                _QPS_CARDS_DEX.remove(cell)   # переиспользованная ячейка со старым блоком
            return
        if plugin is None:
            plugin = self._cards_field(cell, "plugin")
        if plugin is None:
            return
        pid = _cards_get(plugin, "getId", "id")
        if not pid:
            return
        desc = self._cards_field(cell, "descriptionView")
        sub = self._cards_field(cell, "subtitleView")
        name_v = self._cards_field(cell, "pluginNameView")
        anchor = desc or sub
        if anchor is None:
            return
        info = self._cards_info(pid, plugin)
        if not info["version"] and not info["author"] and sub is not None:   # запасной путь: «v1.0 • автор»
            try:
                parts = [x.strip() for x in str(sub.getText()).split("\u2022")]
                info["version"] = parts[0] if parts else ""
                info["author"] = parts[1] if len(parts) > 1 else ""
            except Exception:
                pass
        errors = self._cards_errors().get(pid, 0) if pid not in safety_excluded_cached(self) else 0
        data = dict(info)
        data["enabled"] = bool(ioe_read_enabled(pid, plugin))
        data["errors"] = errors
        data["unstable"] = errors >= QPS_CARDS_UNSTABLE_N
        data["labels"] = {"stable": localise("Q5_CARD_STABLE"), "unstable": localise("Q5_CARD_UNSTABLE"),
                          "disabled": localise("Q5_CARD_DISABLED"), "commands": localise("Q5_CARD_COMMANDS"),
                          "errors": localise("Q5_CARD_ERRORS")}
        try:
            ref = desc or sub
            data["colors"] = {"text": int(ref.getCurrentTextColor()),
                              "sub": int((sub or ref).getCurrentTextColor()),
                              "red": _ioe_theme_color("key_text_RedRegular", 0xFFE53935),
                              "green": _ioe_theme_color("key_windowBackgroundWhiteGreenText", 0xFF4CAF50),
                              "link": _ioe_theme_color("key_windowBackgroundWhiteLinkText", 0xFF3390EC)}
            data["size_px"] = float((sub or ref).getTextSize())
        except Exception:
            pass
        js = json.dumps(data, ensure_ascii=False, sort_keys=True)
        tf_reg = tf_med = None
        try:
            tf_reg = (desc or sub).getTypeface()
            tf_med = name_v.getTypeface() if name_v is not None else tf_reg
        except Exception:
            pass
        res = _QPS_CARDS_DEX.apply(anchor, sub, js, tf_reg, tf_med)
        if res != "ok" or st["logged"] < 3:
            if st["logged"] < 12:
                st["logged"] += 1
                log(f"[{__id__}] cards: apply({pid}) -> {res}")
        st["dirty"] = True

    # ---------------------------------------------------------------- время загрузки
    def _cards_lt_enter(self, args, kind):
        pid = _cards_arg_id(args)
        if not pid:
            return
        if kind == "enable" and _cards_arg_bool(args) is not True:
            return
        st = self._cards_state()
        if st.get("lt_dbg", 0) < 6:
            st["lt_dbg"] = st.get("lt_dbg", 0) + 1
            log(f"[{__id__}] cards: time {kind} id={pid} args={[type(x).__name__ for x in args]}")
        with st["lt_lock"]:
            d = st["lt_depth"].get(pid, 0)
            if d == 0:
                st["lt_t0"][pid] = time.perf_counter()
            st["lt_depth"][pid] = d + 1

    def _cards_lt_exit(self, args, kind, failed=False):
        pid = _cards_arg_id(args)
        if not pid:
            return
        if kind == "enable" and _cards_arg_bool(args) is not True:
            return
        st = self._cards_state()
        with st["lt_lock"]:
            d = st["lt_depth"].get(pid, 0) - 1
            if d > 0:
                st["lt_depth"][pid] = d
                return
            st["lt_depth"].pop(pid, None)
            t0 = st["lt_t0"].pop(pid, None)
            if t0 is None or failed:
                return
            ms = (time.perf_counter() - t0) * 1000.0
            now = time.time()
            last = st["lt_last"].get(pid)
            if kind == "enable" and last and last[0] == "load" and now - last[1] <= QPS_CARDS_LT_JOIN_SEC:
                ms += last[2]
            st["lt_last"][pid] = (kind, now, ms)
            st["lt"][pid] = {"ms": round(ms, 2), "ts": int(now), "kind": kind}
        self._cards_lt_schedule_save()

    def _cards_lt_schedule_save(self):
        st = self._cards_state()
        if st.get("save_timer") is not None:
            return
        t = threading.Timer(1.0, self._cards_lt_save)
        t.daemon = True
        st["save_timer"] = t
        t.start()

    def _cards_lt_save(self):
        st = self._cards_state()
        st["save_timer"] = None
        with st["lt_lock"]:
            snap = dict(st["lt"])
        safety_write_json(QPS_CARDS_LT_FILE, snap)


def safety_excluded_cached(owner):
    """excluded.json читается не чаще раза в QPS_CARDS_ERR_TTL (вместе с кешем ошибок)."""
    st = owner._cards_state()
    ts, cur = st.get("excl", (0.0, set()))
    now = time.time()
    if now - ts >= QPS_CARDS_ERR_TTL:
        cur = safety_excluded()
        st["excl"] = (now, cur)
    return cur


# ---- fragment: qpswipe_bridge.py ----
# MIXIN: QpsWipeMixin
# QPS 5.1: QPSwipe (бывший OMD) вшит как сжатый модуль qps_wipe. Грузится лениво, живёт в своём namespace,
# логи и ошибки идут через логгер QPS. Исходник: sha256 ниже сверяется при загрузке.
import zlib as _qpsw_zlib
import types as _qpsw_types
