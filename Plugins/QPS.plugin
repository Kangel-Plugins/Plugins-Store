class QpsDex:
    """Ленивая загрузка dex из base64. Потокобезопасно; один loader на процесс плагина."""

    def __init__(self):
        self._lock = threading.Lock()
        self._loader = None
        self._method = None
        self.error = None

    def _load_locked(self):
        from java import jclass, jarray, jbyte
        data = _b64.b64decode(_QPS_DEX_B64)
        buf = jclass("java.nio.ByteBuffer").wrap(jarray(jbyte)(data))
        parent = ApplicationLoader.applicationContext.getClassLoader()
        loader = jclass("dalvik.system.InMemoryDexClassLoader")(buf, parent)
        cls = loader.loadClass(QPS_DEX_CLASS)
        str_cls = jclass("java.lang.Class").forName("java.lang.String")
        self._method = cls.getMethod("call", str_cls, str_cls)
        self._loader = loader

    def ensure(self):
        if self._method is not None:
            return True
        with self._lock:
            if self._method is not None:
                return True
            try:
                self._load_locked()
                self.error = None
            except Exception:
                self.error = traceback.format_exc()
                self._loader = self._method = None
                log(f"[{__id__}] dex load failed: {self.error}")
        return self._method is not None

    def call(self, method, args=None):
        """-> dict {"ok":bool,"result"|"error"}; сам не бросает исключений."""
        if not self.ensure():
            return {"ok": False, "error": "dex_not_loaded: " + str(self.error).strip().splitlines()[-1]}
        try:
            payload = json.dumps(args if args is not None else {}, ensure_ascii=False)
            try:
                raw = self._method.invoke(None, method, payload)
            except TypeError:
                from java import jclass, jarray
                arr = jarray(jclass("java.lang.Object"))([method, payload])
                raw = self._method.invoke(None, arr)
            return json.loads(str(raw))
        except Exception as e:
            log(f"[{__id__}] dex call {method} failed: {traceback.format_exc()}")
            return {"ok": False, "error": f"{type(e).__name__}: {e}"}

    def close(self):
        with self._lock:
            self._loader = self._method = None


_QPS_DEX = QpsDex()


def qps_dex_call(method, args=None):
    return _QPS_DEX.call(method, args)


def qps5_dir():
    ctx = ApplicationLoader.applicationContext
    d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), QPS5_DIRNAME)
    os.makedirs(d, exist_ok=True)
    return d


class DexBridgeMixin:
    @safe(msg="QPS5 on_load failed", notify=False)
    def _qps5_on_load(self):
        qps5_dir()  # dex грузится лениво, при первом вызове
        self._ioe_ui_on_load()
        self._safety_on_load()
        self._cards_on_load()

    @safe(msg="QPS5 on_unload failed", notify=False)
    def _qps5_on_unload(self):
        self._cards_on_unload()
        self._safety_on_unload()
        self._ioe_ui_on_unload()
        _QPS_DEX.close()

    def _qps5_settings_items(self):
        # stage8: диагностика только в Debug
        try:
            items = [Header(text="Бэкап плагинов (.qps)")]
            items += (self._ioe_ui_settings_items() if hasattr(self, "_ioe_ui_settings_items") else [])
            items.append(Divider(text=localise("Q5_EXPORT_NOTE")))
            if self.get_setting("debug_mode", False):
                items += [
                    Header(text="QPS 5.0: диагностика (только в Debug)"),
                    Text(text="Проверка dex-ядра", icon="msg_info",
                         on_click=lambda _=None: self._submit(self._dex_selftest_run, "dex_selftest")),
                    Divider(text="Загружает dex из плагина, вызывает ping/fmt_time/selftest (zip, sha256). "
                                 "Результат — всплывашка и файл files/qps5/dex_selftest.json."),
                ]
                items += (self._ioe_settings_items() if hasattr(self, "_ioe_settings_items") else [])
            return items
        except Exception as e:
            log(f"[{__id__}] qps5 settings items failed: {e}")
            return []

    def _dex_selftest_run(self):
        t0 = time.time()
        res = {"ping": qps_dex_call("ping"),
               "fmt": qps_dex_call("fmt_time", {"ms": 1240}),
               "selftest": qps_dex_call("selftest", {"dir": os.path.join(qps5_dir(), "tmp")}),
               "reserved": qps_dex_call("backup_export"),
               "bad": qps_dex_call("nope")}
        res["load_ms"] = int((time.time() - t0) * 1000)
        ok = (res["ping"].get("ok") and res["ping"]["result"].get("api") == QPS_DEX_API
              and res["fmt"].get("result") == "1.24\u0441"
              and res["selftest"].get("ok") and res["selftest"]["result"].get("zip") == "ok"
              and res["reserved"].get("ok") is False and res["bad"].get("ok") is False)
        res["pass"] = bool(ok)
        try:
            with open(os.path.join(qps5_dir(), "dex_selftest.json"), "w", encoding="utf-8") as f:
                json.dump(res, f, ensure_ascii=False, indent=1)
        except Exception as e:
            log(f"[{__id__}] selftest write failed: {e}")
        log(f"[{__id__}] dex selftest: {json.dumps(res, ensure_ascii=False)}")
        if ok:
            sdk = res["ping"]["result"].get("sdk_int")
            BulletinHelper.show_info(f"QPS dex OK ({res['load_ms']} мс, API {sdk}, zip ok)")
        else:
            err = _QPS_DEX.error or json.dumps({k: v for k, v in res.items() if isinstance(v, dict) and not v.get("ok")},
                                              ensure_ascii=False)
            BulletinHelper.show_error("QPS dex FAIL: " + str(err).strip().splitlines()[-1][:120])


# ---- fragment: ioe_core.py ----
# MIXIN: IoeCoreMixin
# QPS 5.0 / этап 4: Python-обвязка бэкапа .qps (IoE v1). Вся логика zip/manifest/хэшей/отката — в dex
# (qps.Core: backup_export / backup_inspect / backup_import). Здесь только то, что требует Telegram/SDK:
# список плагинов, флаги включения (SharedPreferences), выгрузка/перезагрузка плагинов, тексты ошибок.
# Меню (.export) и хук на нажатие по файлу — этап 5; они вызывают функции отсюда из фонового потока.

QPS_BACKUP_EXT = ".qps"
QPS_BACKUP_TEMP_DIR = "QpsIoE"  # внутри getExternalCacheDir()
QPS_PREFS_NAME = "plugin_settings"  # SharedPreferences plugin_settings.xml
QPS_ENABLED_KEY = "plugin_enabled_"  # + <id>
QPS_PLUGIN_SETTINGS_FILE = "plugin_settings.json"

_QPS_IOE_ERRORS = {
    "bad_archive": "Файл повреждён или это не бэкап QPS",
    "hash_mismatch": "Контрольная сумма не совпала: архив повреждён или изменён",
    "unsafe_path": "Архив содержит небезопасные пути, импорт отклонён",
    "unsupported_version": "Бэкап создан более новой версией QPS",
    "too_large": "Архив слишком большой",
    "nothing_to_export": "Нет плагинов для экспорта",
    "io_error": "Ошибка чтения или записи файла",
    "bad_args": "Некорректные параметры",
    "import_failed": "Ошибка импорта, изменения отменены",
}


def ioe_error_text(resp):
    """Короткое сообщение для bulletin по ответу dex/обвязки ({"ok":False,...})."""
    if not isinstance(resp, dict) or resp.get("ok"):
        return ""
    code = resp.get("code") or ""
    text = _QPS_IOE_ERRORS.get(code)
    if text is None:
        text = "Ошибка бэкапа: " + str(resp.get("error", "неизвестная"))[:120]
    if code == "import_failed" and resp.get("rolled_back") is False:
        text = "Ошибка импорта, откат выполнен не полностью"
    return text


def _ioe_plugins_dir():
    d = get_plugins_dir()
    return str(d) if d else None


def _ioe_temp_dir():
    """Папка для готовых .qps (внешний cache — оттуда файл можно отправить в чат)."""
    ctx = ApplicationLoader.applicationContext
    root = ctx.getExternalCacheDir() or ctx.getCacheDir()
    d = os.path.join(str(root.getAbsolutePath()), QPS_BACKUP_TEMP_DIR)
    os.makedirs(d, exist_ok=True)
    return d


def ioe_cleanup_temp():
    """Оставляем только тот архив, который сейчас создадим (как в IoE)."""
    try:
        d = _ioe_temp_dir()
        for n in os.listdir(d):
            if n.lower().endswith((QPS_BACKUP_EXT, QPS_BACKUP_EXT + ".qpstmp")):
                try:
                    os.remove(os.path.join(d, n))
                except Exception:
                    pass
    except Exception as e:
        log(f"[{__id__}] ioe cleanup failed: {e}")


def _ioe_app_version():
    try:
        ctx = ApplicationLoader.applicationContext
        return str(ctx.getPackageManager().getPackageInfo(ctx.getPackageName(), 0).versionName)
    except Exception:
        return "unknown"


def _ioe_controller_plugins():
    """[(id, plugin_obj)] из PluginsController.plugins (Java Map или dict)."""
    plugins = PluginsController.getInstance().plugins
    if hasattr(plugins, "entrySet"):
        it = plugins.entrySet().iterator()
        out = []
        while it.hasNext():
            e = it.next()
            out.append((str(e.getKey()), e.getValue()))
        return out
    return [(str(k), v) for k, v in dict(plugins).items()]


def _ioe_plugin_name(obj, fallback):
    try:
        return str(obj.name)
    except Exception:
        try:
            return str(obj.getName())
        except Exception:
            return fallback


def _ioe_plugin_path(obj):
    try:
        return str(obj.file.getAbsolutePath())
    except Exception:
        return None


def ioe_read_enabled(plugin_id, plugin_obj=None):
    """Флаг включения: SharedPreferences plugin_enabled_<id>; если ключа нет — состояние объекта плагина."""
    try:
        prefs = ApplicationLoader.applicationContext.getSharedPreferences(QPS_PREFS_NAME, 0)
        key = QPS_ENABLED_KEY + plugin_id
        if prefs.contains(key):
            return bool(prefs.getBoolean(key, False))
    except Exception as e:
        log(f"[{__id__}] ioe prefs read failed for {plugin_id}: {e}")
    try:
        if plugin_obj is not None:
            return bool(getattr(plugin_obj, "enabled", False) or
                        (plugin_obj.isEnabled() if hasattr(plugin_obj, "isEnabled") else False))
    except Exception:
        pass
    return False


def ioe_set_enabled(plugin_id, enabled):
    """controller.setPluginEnabled(id, bool, None) — проверено на устройстве (SPEC, раздел 3)."""
    try:
        PluginsController.getInstance().setPluginEnabled(plugin_id, bool(enabled), None)
        return True
    except Exception as e:
        log(f"[{__id__}] setPluginEnabled({plugin_id}, {enabled}) failed: {e}")
        return False


def ioe_list_plugins():
    """Установленные плагины для меню экспорта: [{id,name,path,enabled}] по имени. QPS тоже в списке."""
    res = []
    try:
        for pid, obj in _ioe_controller_plugins():
            res.append({"id": pid, "name": _ioe_plugin_name(obj, pid), "path": _ioe_plugin_path(obj),
                        "enabled": ioe_read_enabled(pid, obj)})
    except Exception:
        log(f"[{__id__}] ioe list via controller failed: {traceback.format_exc()}")
    if not res:  # запасной путь: файлы на диске (<id>.py), без имён и флагов
        d = _ioe_plugins_dir()
        if d and os.path.isdir(d):
            for n in sorted(os.listdir(d)):
                if n.endswith((".py", ".plugin")):
                    pid = n.rsplit(".", 1)[0]
                    res.append({"id": pid, "name": pid, "path": os.path.join(d, n),
                                "enabled": ioe_read_enabled(pid)})
    res.sort(key=lambda p: p["name"].lower())
    return res


QPS_AUTHOR_KEY = "qps_author"


def ioe_current_author():
    """{"id": int|None, "username": str} текущего аккаунта (кто экспортирует). Без падений."""
    try:
        user = get_user_config(int(get_selected_account())).getCurrentUser()
        uid = int(user.id) if user is not None else None
        uname = ""
        if user is not None:
            uname = str(getattr(user, "username", "") or "")
            if not uname:
                try:
                    un = user.usernames
                    if un is not None and un.size() > 0:
                        uname = str(un.get(0).username or "")
                except Exception:
                    pass
        return {"id": uid, "username": uname}
    except Exception as e:
        log(f"[{__id__}] ioe: author lookup failed: {e}")
        return {"id": None, "username": ""}


def ioe_stamp_author(path, author):
    """Пишет автора в комментарий zip (записи архива и хэши манифеста не затрагиваются). -> bool."""
    tmp = path + ".authtmp"
    try:
        shutil.copyfile(path, tmp)
        with zipfile.ZipFile(tmp, "a") as z:
            z.comment = json.dumps({QPS_AUTHOR_KEY: author}, ensure_ascii=False).encode("utf-8")
        os.replace(tmp, path)
        return True
    except Exception as e:
        log(f"[{__id__}] ioe: stamp author failed: {e}")
        try:
            if os.path.exists(tmp):
                os.remove(tmp)
        except Exception:
            pass
        return False


def ioe_read_author(path):
    """Автор из комментария zip -> {"id","username"} или None (старый файл без автора)."""
    try:
        with zipfile.ZipFile(path) as z:
            raw = bytes(z.comment or b"")
        if not raw:
            return None
        a = json.loads(raw.decode("utf-8")).get(QPS_AUTHOR_KEY)
        return a if isinstance(a, dict) else None
    except Exception:
        return None


def ioe_author_text(a):
    if not a or (not a.get("id") and not a.get("username")):
        return "Автор: не указан"
    un = str(a.get("username") or "").lstrip("@")
    return "Автор: %s (id: %s)" % ("@" + un if un else "без username", a.get("id") if a.get("id") else "?")


def ioe_export(plugin_ids=None, with_settings=True, out_path=None, settings=None):
    """Экспорт в .qps. plugin_ids=None — все установленные. settings — готовый dict {id: {...}} вместо
    чтения files/plugins/plugin_settings.json (по умолчанию читает dex из файла, как IoE).
    -> ответ dex: {"ok":True,"result":{path,size,sha256,plugins,skipped,settings,warnings}} | {"ok":False,...}."""
    try:
        d = _ioe_plugins_dir()
        if not d:
            return {"ok": False, "code": "io_error", "error": "io_error: plugins dir unavailable"}
        items = ioe_list_plugins()
        if plugin_ids is not None:
            want = set(plugin_ids)
            items = [p for p in items if p["id"] in want]
        if out_path is None:
            ioe_cleanup_temp()
            out_path = os.path.join(_ioe_temp_dir(), "qps_backup_%d%s" % (int(time.time()), QPS_BACKUP_EXT))
        args = {"out_path": out_path, "plugins_dir": d, "with_settings": bool(with_settings),
                "plugins": [{k: p[k] for k in ("id", "name", "path", "enabled") if p.get(k) is not None}
                            for p in items],
                "qps_version": __version__, "client_version": _ioe_app_version(), "sdk_version": __sdk_version__}
        if settings is not None:
            args["settings"] = settings
        resp = qps_dex_call("backup_export", args)
        if resp.get("ok"):
            author = ioe_current_author()
            if ioe_stamp_author(resp["result"]["path"], author):
                resp["result"]["author"] = author
                try:
                    resp["result"]["size"] = os.path.getsize(resp["result"]["path"])
                    h = __import__("hashlib").sha256()
                    with open(resp["result"]["path"], "rb") as f:
                        for ch in iter(lambda: f.read(1 << 20), b""):
                            h.update(ch)
                    resp["result"]["sha256"] = h.hexdigest()
                except Exception:
                    pass
        log(f"[{__id__}] ioe export: ok={resp.get('ok')} "
            f"{json.dumps(resp.get('result', {}).get('plugins', resp.get('error')), ensure_ascii=False)[:200]}")
        return resp
    except Exception as e:
        log(f"[{__id__}] ioe export crashed: {traceback.format_exc()}")
        return {"ok": False, "error": f"{type(e).__name__}: {e}"}


def ioe_inspect(path):
    """Проверка архива без записи + пометки exists/same для каждого плагина (для окна импорта)."""
    try:
        args = {"path": path}
        d = _ioe_plugins_dir()
        if d:
            args["plugins_dir"] = d
            args["existing_paths"] = _ioe_existing_paths()
        return qps_dex_call("backup_inspect", args)
    except Exception as e:
        return {"ok": False, "error": f"{type(e).__name__}: {e}"}


def _ioe_existing_paths():
    """{id: путь загруженного файла}: перезаписываем именно тот файл, из которого плагин загружен."""
    out = {}
    try:
        for pid, obj in _ioe_controller_plugins():
            p = _ioe_plugin_path(obj)
            if p:
                out[pid] = p
    except Exception:
        pass
    return out


def ioe_import(path, ids=None, conflict="skip", decisions=None, with_settings=True,
               restore_enabled=True, reload_plugins=True):
    """Импорт .qps. Вызывать из фонового потока (есть sleep и загрузка плагинов).
    conflict/decisions: "skip"|"overwrite" (по умолчанию пропуск; decisions — по id).
    restore_enabled: вернуть флаги включения из бэкапа (для добавленных/перезаписанных).
    Порядок: inspect → выключить включённые плагины, которые будут перезаписаны → dex backup_import
    (проверка хэшей, запись, откат) → при ошибке вернуть им включённое состояние →
    loadPluginFromFile для записанных → применить флаги. QPS сам себя не выгружает и не перезагружает.
    -> ответ dex + {"reloaded":[...],"enabled":[...],"load_errors":[...],"restart_required":True}."""
    disabled = []
    try:
        d = _ioe_plugins_dir()
        if not d:
            return {"ok": False, "code": "io_error", "error": "io_error: plugins dir unavailable"}
        existing = _ioe_existing_paths()
        insp = qps_dex_call("backup_inspect", {"path": path, "plugins_dir": d, "existing_paths": existing})
        if not insp.get("ok"):
            return insp
        decisions = decisions or {}
        sel = set(ids) if ids is not None else None
        was_enabled = {}
        for p in insp["result"]["plugins"]:
            pid = p["id"]
            if (sel is not None and pid not in sel) or not p.get("exists"):
                continue
            if decisions.get(pid, conflict) != "overwrite":
                continue
            was_enabled[pid] = ioe_read_enabled(pid)
            if pid != __id__ and not p.get("same") and was_enabled[pid]:
                if ioe_set_enabled(pid, False):
                    disabled.append(pid)
        if disabled:
            time.sleep(0.5)  # дать плагинам выгрузиться (как в IoE)

        args = {"path": path, "plugins_dir": d, "conflict": conflict, "decisions": decisions,
                "with_settings": bool(with_settings), "existing_paths": existing}
        if ids is not None:
            args["ids"] = list(ids)
        resp = qps_dex_call("backup_import", args)
        if not resp.get("ok"):
            for pid in disabled:  # откат файлов сделал dex; возвращаем включённое состояние
                ioe_set_enabled(pid, True)
            log(f"[{__id__}] ioe import failed: {resp}")
            return resp

        res = resp["result"]
        reloaded, enabled, errors = [], [], []
        for it in res.get("imported", []):
            pid, act = it["id"], it["action"]
            if act == "unchanged" or pid == __id__:
                continue  # файл не менялся / QPS не перезагружаем на ходу — вступит в силу после перезапуска
            if reload_plugins:
                try:
                    from java.lang import String as _JString
                    from org.telegram.messenger import Utilities as _Utilities
                    PluginsController.getInstance().loadPluginFromFile(_JString(it["path"]), _Utilities.Callback())
                    reloaded.append(pid)
                except Exception as e:
                    errors.append({"id": pid, "error": f"{type(e).__name__}: {e}"})
                    log(f"[{__id__}] ioe: loadPluginFromFile {pid} failed: {e}")
            want = bool(it.get("enabled")) if restore_enabled else bool(was_enabled.get(pid, False))
            if want and ioe_set_enabled(pid, True):
                enabled.append(pid)
        res["reloaded"], res["enabled"], res["load_errors"] = reloaded, enabled, errors
        res["restart_required"] = True
        return resp
    except Exception as e:
        for pid in disabled:
            ioe_set_enabled(pid, True)
        log(f"[{__id__}] ioe import crashed: {traceback.format_exc()}")
        return {"ok": False, "error": f"{type(e).__name__}: {e}"}


def ioe_scan_qps_files():
    """Запасной вариант импорта (этап 5): .qps в Загрузках и во временной папке IoE."""
    dirs = []
    try:
        dirs.append(_ioe_temp_dir())
    except Exception:
        pass
    try:
        from android.os import Environment as _Env
        dl = _Env.getExternalStoragePublicDirectory(_Env.DIRECTORY_DOWNLOADS)
        if dl:
            dirs.append(str(dl.getAbsolutePath()))
    except Exception:
        pass
    found = []
    for d in dirs:
        try:
            for n in os.listdir(d):
                if n.lower().endswith(QPS_BACKUP_EXT):
                    found.append(os.path.join(d, n))
        except Exception:
            continue
    found.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return found


def _read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def ioe_selftest():
    """Самопроверка на устройстве: полный цикл в песочнице files/qps5/ioe_selftest (реальные плагины не трогаются):
    экспорт → импорт → подмена содержимого → path traversal → откат. -> {"pass":bool,"steps":[[имя,bool,инфо]]}."""
    import zipfile as _zf
    steps = []

    def step(name, cond, info=""):
        steps.append([name, bool(cond), str(info)[:160]])
        return bool(cond)

    base = os.path.join(qps5_dir(), "ioe_selftest")
    shutil.rmtree(base, ignore_errors=True)
    src, dst, dst2 = (os.path.join(base, n) for n in ("src", "dst", "dst2"))
    for d in (src, dst, dst2):
        os.makedirs(d)
    code_a = '__id__ = "st_alpha"\n# \u043f\u0440\u0438\u0432\u0435\u0442\n'
    code_b = '__id__ = "st_beta"\n'
    for n, c in (("st_alpha", code_a), ("st_beta", code_b)):
        with open(os.path.join(src, n + ".py"), "w", encoding="utf-8") as f:
            f.write(c)
    with open(os.path.join(src, QPS_PLUGIN_SETTINGS_FILE), "w", encoding="utf-8") as f:
        json.dump({"st_alpha": {"k": "\u0437\u043d\u0430\u0447", "n": 1}, "st_beta": {"b": True}, "other": {}}, f)
    out = os.path.join(base, "t.qps")
    r = qps_dex_call("backup_export", {"out_path": out, "plugins_dir": src, "qps_version": __version__,
                                       "plugins": [{"id": "st_alpha", "enabled": True}, {"id": "st_beta"}]})
    ok = step("export", r.get("ok") and os.path.isfile(out), r.get("error", ""))
    if ok:
        with _zf.ZipFile(out) as z:
            step("zip: manifest/settings/plugins", sorted(z.namelist()) == [
                "manifest.json", "plugins/st_alpha.py", "plugins/st_beta.py", "settings.json"], z.namelist())
        r = qps_dex_call("backup_import", {"path": out, "plugins_dir": dst})
        step("import", r.get("ok") and len(r["result"]["imported"]) == 2, r.get("error", ""))
        try:
            with open(os.path.join(dst, "st_alpha.py"), encoding="utf-8") as _f:
                same = _f.read() == code_a
            with open(os.path.join(dst, QPS_PLUGIN_SETTINGS_FILE), encoding="utf-8") as _f:
                st = json.load(_f)
            step("байты и настройки совпали", same and st.get("st_alpha", {}).get("k") == "\u0437\u043d\u0430\u0447" and "other" not in st, st)
        except Exception as e:
            step("байты и настройки совпали", False, e)
        # подмена содержимого плагина (манифест старый) → hash_mismatch, ничего не записано
        tam = os.path.join(base, "tam.qps")
        with _zf.ZipFile(out) as zi, _zf.ZipFile(tam, "w") as zo:
            for it in zi.infolist():
                zo.writestr(it.filename, b"evil" if it.filename == "plugins/st_alpha.py" else zi.read(it.filename))
        r = qps_dex_call("backup_import", {"path": tam, "plugins_dir": dst2})
        step("подмена → hash_mismatch", r.get("code") == "hash_mismatch" and not os.listdir(dst2), r)
        # path traversal
        trv = os.path.join(base, "trv.qps")
        with _zf.ZipFile(out) as zi, _zf.ZipFile(trv, "w") as zo:
            for it in zi.infolist():
                zo.writestr(it.filename, zi.read(it.filename))
            zo.writestr("../evil.py", b"x")
        r = qps_dex_call("backup_import", {"path": trv, "plugins_dir": dst2})
        step("path traversal → unsafe_path", r.get("code") == "unsafe_path" and not os.listdir(dst2)
             and not os.path.exists(os.path.join(base, "evil.py")), r)
        # мусор
        junk = os.path.join(base, "junk.qps")
        with open(junk, "wb") as f:
            f.write(b"not a zip")
        r = qps_dex_call("backup_import", {"path": junk, "plugins_dir": dst2})
        step("битый архив → bad_archive", r.get("code") == "bad_archive", r)
        # откат: st_alpha перезаписывается, st_beta падает (путь временного файла занят папкой)
        with open(os.path.join(dst2, "st_alpha.py"), "w", encoding="utf-8") as f:
            f.write("ORIGINAL")
        os.makedirs(os.path.join(dst2, "st_beta.py.qpstmp", "x"))
        r = qps_dex_call("backup_import", {"path": out, "plugins_dir": dst2, "conflict": "overwrite"})
        step("откат при сбое", r.get("code") == "import_failed" and r.get("rolled_back") is True
             and _read_text(os.path.join(dst2, "st_alpha.py")) == "ORIGINAL"
             and not os.path.exists(os.path.join(dst2, "st_beta.py")), r)
    res = {"pass": all(s[1] for s in steps), "steps": steps}
    shutil.rmtree(base, ignore_errors=True)
    try:
        with open(os.path.join(qps5_dir(), "ioe_selftest.json"), "w", encoding="utf-8") as f:
            json.dump(res, f, ensure_ascii=False, indent=1)
    except Exception as e:
        log(f"[{__id__}] ioe selftest write failed: {e}")
    return res


def ioe_real_export_check():
    """Тестовый экспорт РЕАЛЬНЫХ плагинов + проверка архива и сравнение с установленными (без импорта).
    -> {"ok":bool,"text":str,"path":str}."""
    r = ioe_export()
    if not r.get("ok"):
        return {"ok": False, "text": ioe_error_text(r), "path": ""}
    res = r["result"]
    insp = ioe_inspect(res["path"])
    if not insp.get("ok"):
        return {"ok": False, "text": "Архив создан, но не проходит проверку: " + ioe_error_text(insp), "path": res["path"]}
    pl = insp["result"]["plugins"]
    same = sum(1 for p in pl if p.get("same"))
    text = "QPS IoE: %d плагинов, настройки: %s, %d КБ, совпадает с установленными: %d/%d" % (
        len(pl), "да" if res["settings"] else "нет", max(1, res["size"] // 1024), same, len(pl))
    if res.get("skipped"):
        text += ", пропущено: %d" % len(res["skipped"])
    return {"ok": same == len(pl), "text": text, "path": res["path"]}


class IoeCoreMixin:
    """Тонкие асинхронные обёртки для UI этапа 5: работа в пуле QPS, колбэк — в UI-потоке."""

    def _ioe_settings_items(self):
        try:
            return [
                Text(text="Проверка бэкапа .qps (песочница)", icon="msg_info",
                     on_click=lambda _=None: self._submit(self._ioe_selftest_run, "ioe_selftest")),
                Text(text="Тестовый экспорт плагинов в .qps", icon="msg_info",
                     on_click=lambda _=None: self._submit(self._ioe_real_check_run, "ioe_real_check")),
                Divider(text="Песочница: экспорт→импорт→подмена→traversal→откат во временной папке, реальные плагины "
                             "не меняются. Тестовый экспорт: создаёт .qps из установленных плагинов (files/cache QpsIoE) "
                             "и сверяет его с установленными; импорт не выполняется."),
            ]
        except Exception as e:
            log(f"[{__id__}] ioe settings items failed: {e}")
            return []

    def _ioe_selftest_run(self):
        res = ioe_selftest()
        log(f"[{__id__}] ioe selftest: {json.dumps(res, ensure_ascii=False)}")
        bad = [s for s in res["steps"] if not s[1]]
        if res["pass"]:
            run_on_ui_thread(lambda: BulletinHelper.show_info(f"QPS IoE OK ({len(res['steps'])} проверок)"))
        else:
            msg = "QPS IoE FAIL: " + "; ".join(f"{s[0]} ({s[2][:40]})" for s in bad)[:150]
            run_on_ui_thread(lambda: BulletinHelper.show_error(msg))

    def _ioe_real_check_run(self):
        res = ioe_real_export_check()
        log(f"[{__id__}] ioe real export: {res}")
        show = BulletinHelper.show_info if res["ok"] else BulletinHelper.show_error
        run_on_ui_thread(lambda: show(res["text"]))

    def ioe_export_async(self, plugin_ids, with_settings, on_done):
        def task():
            resp = ioe_export(plugin_ids, with_settings)
            run_on_ui_thread(lambda: on_done(resp))
        return self._submit(task, "ioe_export")

    def ioe_import_async(self, path, on_done, **kw):
        def task():
            resp = ioe_import(path, **kw)
            run_on_ui_thread(lambda: on_done(resp))
        return self._submit(task, "ioe_import")

    def ioe_inspect_async(self, path, on_done):
        def task():
            resp = ioe_inspect(path)
            run_on_ui_thread(lambda: on_done(resp))
        return self._submit(task, "ioe_inspect")


# ---- fragment: ioe_ui.py ----
# MIXIN: IoeUiMixin
# QPS 5.0 / этап 5: UI бэкапа .qps поверх ioe_core. Логику zip/хэшей/отката НЕ дублирует: зовёт
# ioe_list_plugins / ioe_export_async / ioe_inspect / ioe_import / ioe_scan_qps_files из ioe_core.py.
# 1) команда `.export` в Избранном (on_send_message_hook) -> всплывающее меню (android.app.Dialog, UI-поток);
# 2) нажатие на .qps в чате -> хуки openForView/openDocument/didPressImage -> меню с текстом про фон, 10 с;
# 3) запасной импорт: кнопка «Импорт» в меню .export (список .qps из QpsIoE и Загрузок).
# Правила: всё UI — только в UI-потоке, диск/dex/сеть — в пуле QPS; один диалог за раз; при закрытии
# снимаются таймер и ссылки; при выгрузке плагина меню закрывается.

try:
    from base_plugin import HookResult, HookStrategy
except Exception:  # SDK без этих имён: команда .export будет доступна из настроек (запасной вход)
    HookResult = None
    HookStrategy = None

QPS_IOE_COMMAND = ".export"
QPS_IOE_TITLE = "QPS IoE v1"
QPS_IOE_IMPORT_TEXT = ("Загрузка плагинов проходит в фоновом режиме, возможны лаги. "
                       "Дождитесь окончания загрузки и перезапустите приложение. "
                       "Баннер автоматически закроется через 10 секунд.")
QPS_IOE_IMPORT_CLOSE_SEC = 10.0
QPS_IOE_IMPORT_CONFLICT = "overwrite"   # решение этапа 5: восстановление из бэкапа заменяет плагины (откат есть)
QPS_IOE_DOWNLOAD_WAIT_SEC = 180
QPS_IOE_IMPORT_CONFIRM = True            # подтверждение «Да / Отмена» перед импортом .qps
QPS_IOE_CONFIRM_TEXT = "Вы уверены что хотите импортировать эти плагины?"
QPS_IOE_HOOK_DEBOUNCE_SEC = 1.5
QPS_IOE_DIAG_LIMIT = 40                 # сколько вызовов файловых хуков писать в диагностический лог

_IOE_UI_CLASSES = {}                    # кэш dynamic_proxy-классов (создаются лениво, один раз)


def ioe_is_qps_name(name):
    try:
        return bool(name) and str(name).strip().lower().endswith(QPS_BACKUP_EXT)
    except Exception:
        return False


def _ioe_target_log(t):
    if not t:
        return "saved"
    return f"peer={t.get('peer')} topic={t.get('topic')}"


def ioe_is_command(text):
    try:
        return str(text).strip().lower() == QPS_IOE_COMMAND
    except Exception:
        return False


def _ioe_jname(obj):
    try:
        return str(obj.getClass().getName())
    except Exception:
        return ""


def _ioe_ui_class(kind):
    """Классы-слушатели на dynamic_proxy (Chaquopy). kind: click | dismiss."""
    cls = _IOE_UI_CLASSES.get(kind)
    if cls is not None:
        return cls
    from java import dynamic_proxy
    if kind == "click":
        from android.view import View as _V

        class _Click(dynamic_proxy(_V.OnClickListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onClick(self, v):
                try:
                    self.fn()
                except Exception:
                    log(f"[{__id__}] ioe ui click failed: {traceback.format_exc()}")
        cls = _Click
    else:
        from android.content import DialogInterface as _DI

        class _Dismiss(dynamic_proxy(_DI.OnDismissListener)):
            def __init__(self, fn):
                super().__init__()
                self.fn = fn

            def onDismiss(self, d):
                try:
                    self.fn()
                except Exception:
                    log(f"[{__id__}] ioe ui dismiss failed: {traceback.format_exc()}")
        cls = _Dismiss
    _IOE_UI_CLASSES[kind] = cls
    return cls


def _ioe_theme_color(key, default):
    try:
        from org.telegram.ui.ActionBar import Theme
        return int(Theme.getColor(getattr(Theme, key)))
    except Exception:
        return default


def _ioe_palette():
    bg = _ioe_theme_color("key_dialogBackground", 0xFF1F1F1F)
    lum = (((bg >> 16) & 255) * 299 + ((bg >> 8) & 255) * 587 + (bg & 255) * 114) / 1000
    dark = lum < 128
    return {
        "bg": bg,
        "text": _ioe_theme_color("key_dialogTextBlack", 0xFFFFFFFF if dark else 0xFF000000),
        "gray": _ioe_theme_color("key_dialogTextGray2", 0xFF9E9E9E),
        "accent": _ioe_theme_color("key_featuredStickers_addButton", 0xFF3390EC),
        "btn_text": _ioe_theme_color("key_featuredStickers_buttonText", 0xFFFFFFFF),
        "divider": _ioe_theme_color("key_divider", 0x22888888),
    }


class QpsFileOpenHook(XposedHook):
    """before-хук на открытие файла: openForView / openDocument / didPressImage (см. SPEC, раздел 3)."""

    def __init__(self, plugin_instance, name):
        super().__init__()
        self.plugin = plugin_instance
        self.name = name

    @guard(msg="QPS file hook failed")
    def before_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        self.plugin._ioe_on_file_hook(self.name, param)


class IoeUiMixin:
    # ---------------------------------------------------------------- жизненный цикл
    def _ioe_state(self):
        st = getattr(self, "_ioe_ui", None)
        if st is None:
            st = {"dialog": None, "timer": None, "hooks": [], "busy": False, "diag": 0,
                  "stats": {}, "last_name": "", "last_ts": 0.0, "lock": threading.Lock()}
            self._ioe_ui = st
        return st

    @safe(msg="QPS ioe ui on_load failed", notify=False)
    def _ioe_ui_on_load(self):
        st = self._ioe_state()
        try:
            if HookResult is not None:
                self.add_on_send_message_hook()
                log(f"[{__id__}] ioe: on_send_message_hook registered")
            else:
                log(f"[{__id__}] ioe: HookResult/HookStrategy unavailable, .export only via settings")
        except Exception:
            log(f"[{__id__}] ioe: add_on_send_message_hook failed: {traceback.format_exc()}")
        self._ioe_install_file_hooks(st)

    @safe(msg="QPS ioe ui on_unload failed", notify=False)
    def _ioe_ui_on_unload(self):
        st = self._ioe_state()
        for h in list(st["hooks"]):
            try:
                self.unhook_method(h)
            except Exception as e:
                log(f"[{__id__}] ioe: unhook failed: {e}")
        st["hooks"] = []
        self._ioe_cancel_timer(st)
        run_on_ui_thread(self._ioe_close_menu)

    def _ioe_install_file_hooks(self, st):
        from java import jclass
        targets = (
            ("org.telegram.messenger.AndroidUtilities", ("openForView", "openDocument"), None),
            ("org.telegram.ui.ChatActivity$ChatMessageCellDelegate", ("didPressImage",), 4),
        )
        for cname, names, nargs in targets:
            try:
                cls = jclass(cname)
                for m in cls.getClass().getDeclaredMethods():
                    n = str(m.getName())
                    if n not in names:
                        continue
                    if nargs is not None and len(m.getParameterTypes()) != nargs:
                        continue
                    try:
                        h = self.hook_method(m, QpsFileOpenHook(self, n))
                        if h:
                            st["hooks"].append(h)
                            log(f"[{__id__}] ioe: file hook ON {cname.rsplit('.', 1)[-1]}.{n}"
                                f"({','.join(str(t.getSimpleName()) for t in m.getParameterTypes())})")
                        else:
                            log(f"[{__id__}] ioe: file hook returned nothing for {n}")
                    except Exception as e:
                        log(f"[{__id__}] ioe: file hook {n} failed: {e}")
            except Exception as e:
                log(f"[{__id__}] ioe: class {cname} unavailable: {e}")
        log(f"[{__id__}] ioe: file hooks installed: {len(st['hooks'])}")

    def _ioe_ui_settings_items(self):
        """Запасной вход в меню из настроек QPS (если команда .export недоступна)."""
        try:
            return [Text(text=localise("Q5_EXPORT_SETTINGS_ITEM"), icon="msg_saved",
                         on_click=lambda _=None: self._ioe_open_export_menu())]
        except Exception as e:
            log(f"[{__id__}] ioe ui settings items failed: {e}")
            return []

    # ---------------------------------------------------------------- команда .export
    def on_send_message_hook(self, account, params):
        try:
            text = getattr(params, "message", None)
            if not ioe_is_command(text):
                return HookResult() if HookResult is not None else None
            # решение владельца: .export работает в любом чате; account — аккаунт, из которого набрана команда
            target = self._ioe_target_from_params(account, params)
            log(f"[{__id__}] ioe: '.export' typed, account={account}, target={_ioe_target_log(target)}")
            self._ioe_open_export_menu(account, target)
            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            log(f"[{__id__}] ioe: on_send_message_hook failed: {traceback.format_exc()}")
        return HookResult() if HookResult is not None else None

    def _ioe_handle_clear_log_click(self, view=None):
        """Debug → «Очистить лог»: удаляет накопленный лог, запись продолжается."""
        try:
            rec = getattr(self, "_dbg_recorder", None)
            if rec is None or not getattr(rec, "path", None):
                BulletinHelper.show_info("Сначала включи режим отладки")
                return

            def job():
                try:
                    held = rec.seal()
                    rec.release(held, True)
                    log(f"[{__id__}] ioe: debug log cleared by user")
                    BulletinHelper.show_success("Лог очищен")
                except Exception:
                    log(f"[{__id__}] ioe: clear log failed: {traceback.format_exc()}")
                    BulletinHelper.show_error("Не удалось очистить лог")
            if not self._submit(job, "debug_clear_log"):
                BulletinHelper.show_error("Не удалось очистить лог")
        except Exception:
            log(f"[{__id__}] ioe: clear log click failed: {traceback.format_exc()}")

    def _ioe_is_saved_peer(self, account, params):
        """Избранное = диалог с самим собой. peer может быть числом (dialog id) или объектом."""
        try:
            me = int(get_user_config(account).getClientUserId())
        except Exception:
            me = None
        peer = getattr(params, "peer", None)
        cands = []
        try:
            if isinstance(peer, int):
                cands.append(peer)
            elif peer is not None:
                for a in ("user_id", "dialog_id", "dialogId", "id"):
                    v = getattr(peer, a, None)
                    if isinstance(v, int):
                        cands.append(v)
                inner = getattr(peer, "peer", None)
                if inner is not None:
                    v = getattr(inner, "user_id", None)
                    if isinstance(v, int):
                        cands.append(v)
        except Exception:
            pass
        if not cands:  # запасной путь: открытый чат
            try:
                fr = get_last_fragment()
                cands.append(int(fr.getDialogId()))
            except Exception:
                pass
        log(f"[{__id__}] ioe: peer candidates={cands} me={me} peer_type={_ioe_jname(peer) or type(peer).__name__}")
        return me is not None and me in cands

    # ---------------------------------------------------------------- диалог: каркас
    def _ioe_cancel_timer(self, st):
        t = st.get("timer")
        st["timer"] = None
        if t is not None:
            try:
                t.cancel()
            except Exception:
                pass

    def _ioe_close_menu(self):
        """Только UI-поток. Идемпотентно: снимает таймер и ссылки, закрывает диалог."""
        st = self._ioe_state()
        self._ioe_cancel_timer(st)
        d = st.get("dialog")
        st["dialog"] = None
        if d is not None:
            try:
                d.setOnDismissListener(None)
                d.dismiss()
            except Exception as e:
                log(f"[{__id__}] ioe: dialog dismiss failed: {e}")

    def _ioe_dp(self, ctx, v):
        return int(v * ctx.getResources().getDisplayMetrics().density + 0.5)

    def _ioe_build_shell(self, ctx, pal, account):
        """-> (dialog, content LinearLayout). Крестик справа сверху, иконка по центру, заголовок."""
        from android.app import Dialog
        from android.graphics import Color, Typeface
        from android.graphics.drawable import ColorDrawable, GradientDrawable
        from android.view import Gravity, ViewGroup
        from android.widget import FrameLayout, LinearLayout, TextView
        dp = lambda v: self._ioe_dp(ctx, v)
        dlg = Dialog(ctx)
        dlg.requestWindowFeature(1)
        root = FrameLayout(ctx)
        bgd = GradientDrawable()
        bgd.setColor(pal["bg"])
        bgd.setCornerRadius(float(dp(16)))
        root.setBackground(bgd)
        col = LinearLayout(ctx)
        col.setOrientation(LinearLayout.VERTICAL)
        col.setPadding(dp(16), dp(20), dp(16), dp(12))
        root.addView(col, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
                                                   ViewGroup.LayoutParams.WRAP_CONTENT))
        icon = self._ioe_make_icon(ctx, account, dp)
        col.addView(icon, LinearLayout.LayoutParams(dp(64), dp(64)))
        icon.getLayoutParams().gravity = Gravity.CENTER_HORIZONTAL
        title = TextView(ctx)
        title.setText(QPS_IOE_TITLE)
        title.setTextColor(pal["text"])
        title.setTextSize(18.0)
        title.setTypeface(Typeface.DEFAULT_BOLD)
        title.setGravity(Gravity.CENTER)
        title.setPadding(0, dp(8), 0, dp(8))
        col.addView(title, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
                                                     ViewGroup.LayoutParams.WRAP_CONTENT))
        close = TextView(ctx)
        close.setText("✕")
        close.setTextColor(pal["gray"])
        close.setTextSize(20.0)
        close.setGravity(Gravity.CENTER)
        close.setOnClickListener(_ioe_ui_class("click")(lambda: self._ioe_close_menu()))
        lp = FrameLayout.LayoutParams(dp(44), dp(44))
        lp.gravity = Gravity.TOP | Gravity.RIGHT
        root.addView(close, lp)
        dlg.setContentView(root)
        w = dlg.getWindow()
        w.setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))
        width = min(int(ctx.getResources().getDisplayMetrics().widthPixels * 0.92), dp(420))
        w.setLayout(width, ViewGroup.LayoutParams.WRAP_CONTENT)
        dlg.setCancelable(True)
        dlg.setCanceledOnTouchOutside(True)
        dlg.setOnDismissListener(_ioe_ui_class("dismiss")(lambda: self._ioe_on_dismissed(dlg)))
        return dlg, col

    def _ioe_on_dismissed(self, dlg):
        st = self._ioe_state()
        if st.get("dialog") is dlg:
            st["dialog"] = None
        self._ioe_cancel_timer(st)

    def _ioe_make_icon(self, ctx, account, dp):
        """Иконка QPS: стикер AnimatedEmojies/404; если набор не в кэше — текстовая заглушка. НЕ ПОДТВЕРЖДЕНО на устройстве."""
        try:
            from org.telegram.ui.Components import BackupImageView
            from org.telegram.messenger import MediaDataController, ImageLocation
            ss = MediaDataController.getInstance(int(account)).getStickerSetByName("AnimatedEmojies")
            docs = ss.documents if ss is not None else None
            if docs is not None and docs.size() > 404:
                doc = docs.get(404)
                img = BackupImageView(ctx)
                img.getImageReceiver().setAutoRepeat(1)
                img.setImage(ImageLocation.getForDocument(doc), "64_64", None, None, ss)
                return img
            log(f"[{__id__}] ioe: icon sticker set not cached, fallback to text icon")
        except Exception as e:
            log(f"[{__id__}] ioe: icon via sticker failed: {e}")
        from android.widget import TextView
        from android.view import Gravity
        tv = TextView(ctx)
        tv.setText("🧩")
        tv.setTextSize(40.0)
        tv.setGravity(Gravity.CENTER)
        return tv

    def _ioe_button(self, ctx, pal, text, fn, filled):
        from android.graphics import Typeface
        from android.graphics.drawable import GradientDrawable
        from android.view import Gravity
        from android.widget import TextView
        dp = lambda v: self._ioe_dp(ctx, v)
        b = TextView(ctx)
        b.setText(text)
        b.setGravity(Gravity.CENTER)
        b.setTypeface(Typeface.DEFAULT_BOLD)
        b.setTextSize(15.0)
        b.setPadding(dp(12), 0, dp(12), 0)
        g = GradientDrawable()
        g.setCornerRadius(float(dp(10)))
        if filled:
            g.setColor(pal["accent"])
            b.setTextColor(pal["btn_text"])
        else:
            g.setColor(0)
            g.setStroke(dp(1), pal["accent"])
            b.setTextColor(pal["accent"])
        b.setBackground(g)
        b.setOnClickListener(_ioe_ui_class("click")(fn))
        return b

    def _ioe_show_dialog(self, dlg):
        st = self._ioe_state()
        self._ioe_close_menu()
        st["dialog"] = dlg
        dlg.show()

    # ---------------------------------------------------------------- меню экспорта
    def _ioe_target_from_params(self, account, params):
        """Куда слать .qps: чат (dialog id) и топик, из которых набрана .export. None = Избранное."""
        t = {"peer": None, "topic": 0, "topic_obj": None}
        try:
            peer = getattr(params, "peer", None)
            if isinstance(peer, int) and not isinstance(peer, bool) and peer != 0:
                t["peer"] = int(peer)
        except Exception:
            pass
        try:
            mo = getattr(params, "replyToTopMsg", None)
            if mo is not None:
                tid = int(mo.getId())
                if tid > 0:
                    t["topic"], t["topic_obj"] = tid, mo
        except Exception:
            pass
        if t["peer"] is None:  # запасной путь: открытый чат
            try:
                fr = get_last_fragment()
                if "ChatActivity" in _ioe_jname(fr):
                    t["peer"] = int(fr.getDialogId())
                    for name in ("getThreadMessageId", "getTopicId"):
                        try:
                            v = int(getattr(fr, name)())
                            if v > 0:
                                t["topic"] = v
                                break
                        except Exception:
                            pass
            except Exception:
                pass
        return t if t["peer"] is not None else None

    def _ioe_send_file(self, path, caption, account, target):
        """UI-поток. Файл уходит в чат/топик из target с указанным аккаунтом, иначе в Избранное этого аккаунта.
        -> "chat" | "saved" (куда ушло)."""
        me = int(get_user_config(account).getClientUserId())
        peer = target["peer"] if target else me
        topic = target.get("topic", 0) if target else 0
        variants = []
        if topic:
            variants.append({"replyToMsg": topic})
            if target.get("topic_obj") is not None:
                variants.append({"replyToMsg": target["topic_obj"]})
        variants.append({})
        last = None
        for i, extra in enumerate(variants):
            try:
                send_document(peer, path, caption=caption, account=account, **extra)
                if topic and not extra:
                    log(f"[{__id__}] ioe: topic reply not accepted by send_document, sent without topic")
                return "chat" if target else "saved"
            except Exception as e:
                last = e
                log(f"[{__id__}] ioe: send_document variant {i} {sorted(extra)} failed: {e!r}")
        raise last

    def _ioe_open_export_menu(self, account=None, target=None):
        """Любой поток. Список плагинов читаем в пуле, окно строим в UI-потоке."""
        if account is None:
            try:
                account = int(get_selected_account())
            except Exception:
                account = 0

        def task():
            items = ioe_list_plugins()
            run_on_ui_thread(lambda: self._ioe_build_export_menu(items, account, target))
        if not self._submit(task, "ioe_menu_list"):
            log(f"[{__id__}] ioe: cannot open menu, executor unavailable")

    def _ioe_build_export_menu(self, items, account, target=None):
        try:
            if self._unloaded:
                return
            ctx = self._get_ui_context()
            if not ctx:
                log(f"[{__id__}] ioe: no ui context for export menu")
                return
            from android.content.res import ColorStateList
            from android.view import ViewGroup, Gravity
            from android.widget import CheckBox, LinearLayout, ScrollView, TextView
            pal = _ioe_palette()
            dp = lambda v: self._ioe_dp(ctx, v)
            dlg, col = self._ioe_build_shell(ctx, pal, account)
            tint = ColorStateList.valueOf(pal["accent"])
            checks = []  # [(id, CheckBox)]
            lst = LinearLayout(ctx)
            lst.setOrientation(LinearLayout.VERTICAL)
            for it in items:
                cb = CheckBox(ctx)
                cb.setText(str(it.get("name") or it["id"]))
                cb.setTextColor(pal["text"])
                cb.setTextSize(15.0)
                cb.setButtonTintList(tint)
                cb.setChecked(True)  # по умолчанию выбраны все
                lst.addView(cb, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
                                                          ViewGroup.LayoutParams.WRAP_CONTENT))
                checks.append((it["id"], cb))
            sv = ScrollView(ctx)
            sv.addView(lst)
            h = int(ctx.getResources().getDisplayMetrics().heightPixels * 0.38)
            col.addView(sv, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, h))
            counter = TextView(ctx)
            counter.setTextColor(pal["gray"])
            counter.setTextSize(13.0)
            counter.setPadding(0, dp(6), 0, dp(2))
            col.addView(counter)

            def refresh_counter():
                n = sum(1 for _, c in checks if c.isChecked())
                counter.setText(f"Выбрано: {n} из {len(checks)}")
            for _, c in checks:
                c.setOnClickListener(_ioe_ui_class("click")(refresh_counter))
            refresh_counter()

            settings_cb = CheckBox(ctx)
            settings_cb.setText("Экспортировать настройки")
            settings_cb.setTextColor(pal["text"])
            settings_cb.setTextSize(15.0)
            settings_cb.setButtonTintList(tint)
            settings_cb.setChecked(True)  # по умолчанию включено; повторное нажатие — без настроек
            col.addView(settings_cb)

            def toggle_all():
                # «Выбор»: если что-то отмечено — снять со всех, если ничего — отметить все
                target = not any(c.isChecked() for _, c in checks)
                for _, c in checks:
                    c.setChecked(target)
                refresh_counter()

            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setPadding(0, dp(8), 0, 0)
            rowlp = lambda: LinearLayout.LayoutParams(0, dp(44), 1.0)
            b_sel = self._ioe_button(ctx, pal, "Выбор", toggle_all, False)
            row.addView(b_sel, rowlp())
            b_exp = self._ioe_button(ctx, pal, "Экспорт", lambda: do_export(b_exp), True)
            lp = rowlp()
            lp.leftMargin = dp(8)
            row.addView(b_exp, lp)
            col.addView(row)

            def do_export(btn):
                ids = [pid for pid, c in checks if c.isChecked()]
                if not ids:
                    BulletinHelper.show_error("Выберите хотя бы один плагин")
                    return
                st = self._ioe_state()
                if st["busy"]:
                    return
                st["busy"] = True
                btn.setText("Экспорт…")
                btn.setEnabled(False)
                with_settings = bool(settings_cb.isChecked())

                def done(resp):
                    st["busy"] = False
                    self._ioe_close_menu()
                    self._ioe_after_export(resp, account, target)
                if not self.ioe_export_async(ids, with_settings, done):
                    st["busy"] = False
                    btn.setEnabled(True)
                    btn.setText("Экспорт")
            self._ioe_show_dialog(dlg)
        except Exception:
            log(f"[{__id__}] ioe: export menu failed: {traceback.format_exc()}")
            self._ioe_state()["busy"] = False

    def _ioe_after_export(self, resp, account, target=None):
        """UI-поток: отправка готового .qps в текущий чат (с топиком и аккаунтом), без чата — в Избранное."""
        try:
            if not resp.get("ok"):
                BulletinHelper.show_error(ioe_error_text(resp))
                return
            r = resp["result"]
            n = len(r.get("plugins", []))
            cap = localise("Q5_EXPORT_CAPTION", n, localise("Q5_YES" if r.get("settings") else "Q5_NO"))
            if r.get("author"):
                cap += "\n" + ioe_author_text(r["author"])
            where = self._ioe_send_file(r["path"], cap, account, target)
            skipped = len(r.get("skipped", []))
            BulletinHelper.show_info(localise("Q5_EXPORT_DONE_CHAT" if where == "chat" else "Q5_EXPORT_DONE_SAVED", n)
                                     + (localise("Q5_EXPORT_SKIPPED", skipped) if skipped else ""))
        except Exception:
            log(f"[{__id__}] ioe: after export failed: {traceback.format_exc()}")
            BulletinHelper.show_error(localise("Q5_EXPORT_SEND_FAIL"))

    # ---------------------------------------------------------------- импорт по нажатию на файл
    def _ioe_on_file_hook(self, hook_name, param):
        """UI-поток, before-хук. Перехватывает ТОЛЬКО .qps; для остальных файлов ничего не меняет."""
        st = self._ioe_state()
        args = list(param.args) if param.args is not None else []
        mo, path, name = None, None, None
        for a in args:
            jn = _ioe_jname(a)
            try:
                if jn.endswith(".MessageObject"):
                    mo = a
                elif jn.endswith("ChatMessageCell"):
                    mo = a.getMessageObject()
                elif jn == "java.io.File":
                    path = str(a.getAbsolutePath())
                    name = name or str(a.getName())
                elif isinstance(a, str) and ioe_is_qps_name(a) and name is None:
                    name = a
            except Exception:
                pass
        if mo is not None and not name:
            for getter in ("getDocumentName", "getFileName"):
                try:
                    v = getattr(mo, getter)()
                    if v:
                        name = str(v)
                        break
                except Exception:
                    pass
        st["stats"][hook_name] = st["stats"].get(hook_name, 0) + 1
        is_qps = ioe_is_qps_name(name)
        if is_qps or st["diag"] < QPS_IOE_DIAG_LIMIT:
            st["diag"] += 1
            log(f"[{__id__}] ioe hook {hook_name}: name={name!r} qps={is_qps} "
                f"args={[_ioe_jname(a) or type(a).__name__ for a in args][:6]} "
                f"calls={dict(st['stats'])}")
        if not is_qps:
            return
        # перехват: boolean -> True (обработано), void -> None
        try:
            rt = str(param.method.getReturnType().getName())
        except Exception:
            rt = "boolean"
        try:
            param.setResult(True if rt == "boolean" else None)
        except Exception:
            log(f"[{__id__}] ioe: setResult failed: {traceback.format_exc()}")
        now = time.time()
        if name == st["last_name"] and now - st["last_ts"] < QPS_IOE_HOOK_DEBOUNCE_SEC:
            return
        st["last_name"], st["last_ts"] = name, now
        self._ioe_start_import(mo=mo, path=path, name=name)

    def _ioe_start_import(self, mo=None, path=None, name=None):
        """UI-поток. Сначала в пуле скачиваем файл и читаем список плагинов/автора, затем показываем
        подтверждение (текст + список плагинов + Да/Отмена), и только после «Да» — меню с фоном и импорт."""
        st = self._ioe_state()
        if st["busy"] or st.get("preparing"):
            BulletinHelper.show_info("QPS: импорт уже выполняется")
            return
        # данные сообщения читаем здесь (UI-поток), дальше работаем только с простыми значениями
        info = {"path": path, "name": name, "account": 0, "doc": None, "mo": None}
        try:
            if mo is not None:
                info["mo"] = mo
                info["account"] = int(mo.currentAccount)
                info["doc"] = mo.getDocument()
        except Exception:
            pass
        st["preparing"] = True
        if not self._submit(lambda: self._ioe_prepare_worker(info), "ioe_prepare_worker"):
            st["preparing"] = False

    def _ioe_resolve_file(self, info):
        """Пул QPS. Локальный путь к .qps (скачивает при необходимости). -> путь или None (bulletin уже показан)."""
        path = info.get("path")
        if path:
            return path
        path, fl = self._ioe_msg_file(info)
        if not path:
            self._ioe_bulletin(False, "Не удалось определить файл .qps")
            return None
        doc = info.get("doc")
        want = int(getattr(doc, "size", 0) or 0)
        if not (os.path.isfile(path) and (not want or os.path.getsize(path) >= want)):
            self._ioe_bulletin(True, "QPS: скачиваю файл .qps…")
            try:
                run_on_ui_thread(lambda: fl.loadFile(doc, info["mo"], 1, 0))
                log(f"[{__id__}] ioe: download started {path} size={want}")
            except Exception:
                log(f"[{__id__}] ioe: loadFile failed: {traceback.format_exc()}")
            end = time.time() + QPS_IOE_DOWNLOAD_WAIT_SEC
            while time.time() < end and not self._unloaded:
                if os.path.isfile(path) and os.path.getsize(path) > 0 and \
                        (not want or os.path.getsize(path) >= want):
                    return path
                time.sleep(1.0)
            self._ioe_bulletin(False, "Файл .qps не скачался, попробуйте ещё раз")
            return None
        return path

    def _ioe_prepare_worker(self, info):
        """Пул QPS. Файл -> inspect -> автор; подтверждение показываем в UI-потоке."""
        st = self._ioe_state()
        shown = False
        try:
            path = self._ioe_resolve_file(info)
            if not path or self._unloaded:
                return
            insp = ioe_inspect(path)
            if not insp.get("ok"):
                return self._ioe_bulletin(False, ioe_error_text(insp))
            plugins = insp.get("result", {}).get("plugins", []) or []
            author = ioe_read_author(path)
            info["path"] = path

            def show():
                try:
                    if self._unloaded:
                        return
                    if not QPS_IOE_IMPORT_CONFIRM:
                        return self._ioe_confirmed_import(info)
                    if not self._ioe_show_confirm(plugins, author, lambda: self._ioe_confirmed_import(info)):
                        BulletinHelper.show_error("QPS: не удалось показать подтверждение, импорт отменён")
                except Exception:
                    log(f"[{__id__}] ioe: confirm dialog failed: {traceback.format_exc()}")
                    BulletinHelper.show_error("QPS: не удалось показать подтверждение, импорт отменён")
            run_on_ui_thread(show)
            shown = True
        except Exception:
            log(f"[{__id__}] ioe: prepare worker crashed: {traceback.format_exc()}")
            self._ioe_bulletin(False, "Ошибка чтения .qps")
        finally:
            st["preparing"] = False

    def _ioe_confirmed_import(self, info):
        """UI-поток. После «Да»: меню с текстом про фон (10 с) и запуск импорта в пуле."""
        st = self._ioe_state()
        if st["busy"]:
            BulletinHelper.show_info("QPS: импорт уже выполняется")
            return
        st["busy"] = True
        try:
            self._ioe_show_import_menu()
        except Exception:
            log(f"[{__id__}] ioe: import menu failed: {traceback.format_exc()}")
        if not self._submit(lambda: self._ioe_import_worker(info), "ioe_import_worker"):
            st["busy"] = False

    def _ioe_show_confirm(self, plugins, author, on_yes):
        """UI-поток. Диалог: «Вы уверены…», автор, ПОЛНЫЙ список плагинов, кнопки Да / Отмена.
        Возвращает True, если показан."""
        ctx = self._get_ui_context()
        if not ctx:
            return False
        from android.view import ViewGroup, Gravity
        from android.widget import LinearLayout, ScrollView, TextView
        pal = _ioe_palette()
        dp = lambda v: self._ioe_dp(ctx, v)
        try:
            account = int(get_selected_account())
        except Exception:
            account = 0
        self._ioe_close_menu()
        dlg, col = self._ioe_build_shell(ctx, pal, account)
        mw = ViewGroup.LayoutParams.MATCH_PARENT
        wc = ViewGroup.LayoutParams.WRAP_CONTENT
        tv = TextView(ctx)
        tv.setText(QPS_IOE_CONFIRM_TEXT)
        tv.setTextColor(pal["text"])
        tv.setTextSize(16.0)
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(dp(4), dp(4), dp(4), dp(6))
        col.addView(tv, LinearLayout.LayoutParams(mw, wc))

        au = TextView(ctx)
        au.setText(ioe_author_text(author))
        au.setTextColor(pal["gray"])
        au.setTextSize(13.0)
        au.setGravity(Gravity.CENTER)
        au.setPadding(dp(4), 0, dp(4), dp(6))
        col.addView(au, LinearLayout.LayoutParams(mw, wc))

        lines = []
        for p in plugins:
            nm = str(p.get("name") or p.get("id") or "?")
            pid = str(p.get("id") or "")
            ver = str(p.get("version") or "")
            line = "• " + nm
            if pid and pid != nm:
                line += " (" + pid + ")"
            if ver:
                line += " v" + ver
            if p.get("exists"):
                line += " — без изменений" if p.get("same") else " — будет заменён"
            else:
                line += " — новый"
            lines.append(line)
        cnt = TextView(ctx)
        cnt.setText("Будет установлено плагинов: %d" % len(lines))
        cnt.setTextColor(pal["text"])
        cnt.setTextSize(14.0)
        cnt.setPadding(dp(4), dp(2), dp(4), dp(4))
        col.addView(cnt, LinearLayout.LayoutParams(mw, wc))

        lst = LinearLayout(ctx)
        lst.setOrientation(LinearLayout.VERTICAL)
        for line in lines:
            t = TextView(ctx)
            t.setText(line)
            t.setTextColor(pal["text"])
            t.setTextSize(14.0)
            t.setPadding(dp(4), dp(3), dp(4), dp(3))
            lst.addView(t, LinearLayout.LayoutParams(mw, wc))
        sv = ScrollView(ctx)
        sv.addView(lst)
        h = int(ctx.getResources().getDisplayMetrics().heightPixels * 0.38)
        col.addView(sv, LinearLayout.LayoutParams(mw, h if len(lines) > 8 else wc))

        def yes():
            self._ioe_close_menu()
            on_yes()

        def no():
            self._ioe_close_menu()
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setPadding(0, dp(8), 0, 0)
        b_yes = self._ioe_button(ctx, pal, "Да", yes, True)
        b_no = self._ioe_button(ctx, pal, "Отмена", no, False)
        row.addView(b_yes, LinearLayout.LayoutParams(0, dp(44), 1.0))
        lp = LinearLayout.LayoutParams(0, dp(44), 1.0)
        lp.leftMargin = dp(8)
        row.addView(b_no, lp)
        col.addView(row)
        self._ioe_show_dialog(dlg)
        return True

    def _ioe_show_import_menu(self):
        ctx = self._get_ui_context()
        if not ctx:
            return
        from android.view import ViewGroup, Gravity
        from android.widget import LinearLayout, TextView
        pal = _ioe_palette()
        dp = lambda v: self._ioe_dp(ctx, v)
        try:
            account = int(get_selected_account())
        except Exception:
            account = 0
        dlg, col = self._ioe_build_shell(ctx, pal, account)
        tv = TextView(ctx)
        tv.setText(QPS_IOE_IMPORT_TEXT)
        tv.setTextColor(pal["text"])
        tv.setTextSize(15.0)
        tv.setGravity(Gravity.CENTER)
        tv.setPadding(dp(4), dp(4), dp(4), dp(12))
        col.addView(tv, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
                                                  ViewGroup.LayoutParams.WRAP_CONTENT))
        self._ioe_show_dialog(dlg)
        st = self._ioe_state()
        t = threading.Timer(QPS_IOE_IMPORT_CLOSE_SEC, lambda: run_on_ui_thread(self._ioe_timer_close))
        t.daemon = True
        st["timer"] = t
        t.start()

    def _ioe_timer_close(self):
        if not self._unloaded:
            self._ioe_close_menu()

    def _ioe_msg_file(self, info):
        """Путь к локальному файлу сообщения (может ещё не существовать)."""
        mo = info.get("mo")
        if mo is None:
            return None, None
        from org.telegram.messenger import FileLoader
        fl = FileLoader.getInstance(info["account"])
        f = None
        try:
            f = fl.getPathToMessage(mo.messageOwner)
        except Exception:
            try:
                f = fl.getPathToAttach(info["doc"])
            except Exception:
                f = None
        return (str(f.getAbsolutePath()) if f is not None else None), fl

    def _ioe_import_worker(self, info):
        """Пул QPS. Ждёт файл (скачивает при необходимости), inspect -> import, итог — bulletin."""
        st = self._ioe_state()
        try:
            path = info.get("path")
            if not path:
                path, fl = self._ioe_msg_file(info)
                if not path:
                    return self._ioe_bulletin(False, "Не удалось определить файл .qps")
                doc = info.get("doc")
                want = int(getattr(doc, "size", 0) or 0)
                if not (os.path.isfile(path) and (not want or os.path.getsize(path) >= want)):
                    try:
                        run_on_ui_thread(lambda: fl.loadFile(doc, info["mo"], 1, 0))
                        log(f"[{__id__}] ioe: download started {path} size={want}")
                    except Exception:
                        log(f"[{__id__}] ioe: loadFile failed: {traceback.format_exc()}")
                    end = time.time() + QPS_IOE_DOWNLOAD_WAIT_SEC
                    while time.time() < end and not self._unloaded:
                        if os.path.isfile(path) and os.path.getsize(path) > 0 and \
                                (not want or os.path.getsize(path) >= want):
                            break
                        time.sleep(1.0)
                    else:
                        return self._ioe_bulletin(False, "Файл .qps не скачался, попробуйте ещё раз")
            if self._unloaded:
                return
            log(f"[{__id__}] ioe: import from {path}")
            insp = ioe_inspect(path)
            if not insp.get("ok"):
                return self._ioe_bulletin(False, ioe_error_text(insp))
            resp = ioe_import(path, conflict=QPS_IOE_IMPORT_CONFLICT)
            if not resp.get("ok"):
                return self._ioe_bulletin(False, ioe_error_text(resp))
            r = resp.get("result", {})
            n = len(r.get("imported", []))
            errs = r.get("load_errors") or []
            msg = f"Импорт завершён: {n} плагинов. Перезапустите приложение"
            if errs:
                msg += f" (ошибок загрузки: {len(errs)})"
            self._ioe_bulletin(not errs, msg)
        except Exception:
            log(f"[{__id__}] ioe: import worker crashed: {traceback.format_exc()}")
            self._ioe_bulletin(False, "Ошибка импорта .qps")
        finally:
            st["busy"] = False

    def _ioe_bulletin(self, ok, text):
        show = BulletinHelper.show_info if ok else BulletinHelper.show_error
        run_on_ui_thread(lambda: show(text))

# ---- fragment: safety_core.py ----
# MIXIN: SafetyCoreMixin
# QPS 5.0 / этап 6: QPS SAFITY CORE — фоновая защита (SPEC, разделы 2, 3, 5, 8д).
#  * разбор ошибок плагинов в logcat по трём форматам (чистые функции/класс, без Android — тестируются в песочнице);
#  * скан каждые N>=55 с только новых строк (`logcat -d -t '<время>'`, запас `-t N`), потоково, без накопления;
#  * native/ANR — по ApplicationExitInfo на следующем запуске (+ watchdog зависания UI-потока);
#  * исключения (excluded.json), счётчик ошибок (error_counts.json), last_enabled.json (эвристика native/ANR).

import collections as _collections

QPS_SAFETY_MIN_INTERVAL = 55          # сек; и минимум, и дефолт (решение владельца)
QPS_SAFETY_FIRST_DELAY = 20           # первый скан через 20 с после загрузки (ошибки в потоках ~20 с)
QPS_SAFETY_OVERLAP_SEC = 3            # перекрытие окон скана (граница блока); дубли гасит дедупликация
QPS_SAFETY_FALLBACK_LINES = 2500      # запасной `-t N`
QPS_SAFETY_BLAME_WINDOW_SEC = 60      # native/ANR: плагин включён последним не раньше чем за 60 с до сбоя
QPS_SAFETY_AUTO_DISABLE_LAST = False  # True = при native/ANR по эвристике сразу выключать «последний включённый»
QPS_SAFETY_HANG_SEC = 12              # watchdog: UI-поток не отвечает дольше N сек
QPS_SAFETY_WATCHDOG_TICK = 4
QPS_SAFETY_MAX_TEXT = 160
QPS_SAFETY_TEST_MARKER = "QPS_SAFETY_TEST"   # ошибки с этим маркером принимаются и от самого QPS (самопроверка)
QPS_SAFETY_BUTTON_MARKER = "QPS_SAFETY_PROBE_BUTTON"
QPS_SAFETY_BULLETIN = "Внимание, обнаружены сбои, проверьте избранное"
QPS_SAFETY_WARN_TEXT = ("Защита тестовая и не гарантирует защиту от крашей. Native и зависание определяются на следующем "
                        "запуске приложения (ApplicationExitInfo); вину на плагин в этих случаях QPS только предполагает.")

_SAFETY_HDR = re.compile(r"^\d\d-\d\d \d\d:\d\d:\d\d\.\d+\s+(\d+)\s+(\d+)\s+([VDIWEF])\s+(.*?)\s*:\s?(.*)$")
_SAFETY_HOOK = re.compile(r"\[([^\[\]]+?):\s*Hook error\]")
_SAFETY_FILE = re.compile(r"plugins[/\\]([A-Za-z0-9_][\w.\-]*?)\.(?:py|plugin)\b")
_SAFETY_PYFR = re.compile(r"\(([A-Za-z0-9_][\w.\-]*)\.py:\d+\)")
_SAFETY_MARKERS = ("Traceback", "During handling", "The above exception")


def safety_clean(text, limit=QPS_SAFETY_MAX_TEXT):
    t = " ".join(str(text or "").split())
    return t if len(t) <= limit else t[:limit - 1] + "…"


class SafetyLogParser:
    """Потоковый разбор logcat (-v threadtime). feed(line) -> [event]; flush() -> [event].
    event = {id, text, fmt (1|2|3), ts, tid, name?}. Памяти не копит: открытых блоков не больше 8.
    known_ids — установленные плагины; names — {имя: id} (запасная атрибуция формата 1)."""

    def __init__(self, known_ids=None, names=None, self_id="QPS"):
        self.known = set(known_ids or [])
        self.names = dict(names or {})
        self.self_id = self_id
        self.blocks = _collections.OrderedDict()   # (pid, tid) -> block

    # --- служебное
    def _ok_id(self, pid, text):
        if not pid:
            return False
        if pid == self.self_id and QPS_SAFETY_TEST_MARKER not in text and QPS_SAFETY_BUTTON_MARKER not in text:
            return False
        return (not self.known) or pid in self.known

    def _finish(self, b):
        exc = b.get("exc")
        if not exc:
            return None
        ids = [i for i in b["ids"] if self._ok_id(i, exc)]
        if b["fmt"] == 1 and not ids:
            nid = self.names.get(b.get("name") or "")
            if nid and self._ok_id(nid, exc):
                ids = [nid]
        if not ids:
            return None
        pid = ids[0] if b["fmt"] == 3 else ids[-1]   # fmt3: Java печатает внутренний кадр первым; fmt1/2: последним
        return {"id": pid, "text": safety_clean(exc), "fmt": b["fmt"], "ts": b["ts"], "tid": b["tid"], "name": b.get("name")}

    def _open(self, key, fmt, ts, tid, name=None, saw_tb=False):
        while len(self.blocks) >= 8:
            self.blocks.popitem(last=False)
        self.blocks[key] = {"fmt": fmt, "ts": ts, "tid": tid, "name": name, "ids": [], "exc": None,
                            "saw_tb": saw_tb, "after_marker": saw_tb, "n": 0}

    # --- основной вход
    def feed(self, line):
        out = []
        m = _SAFETY_HDR.match(line.rstrip("\r\n"))
        if not m:
            return out
        pid, tid, lvl, tag, msg = m.groups()
        key = (pid, tid)
        ts = line[:18]
        for _ in range(2):   # вторая итерация — если строка закрыла блок и сама может быть началом нового
            b = self.blocks.get(key)
            if b is None:
                break
            done = self._step(b, msg)
            if done:
                self.blocks.pop(key, None)
                ev = self._finish(b)
                if ev:
                    out.append(ev)
                continue
            return out
        self._maybe_start(key, tag, msg, ts, tid)
        return out

    def _maybe_start(self, key, tag, msg, ts, tid):
        hm = _SAFETY_HOOK.search(msg)
        if hm:
            self._open(key, 1, ts, tid, name=hm.group(1).strip(), saw_tb="Traceback" in msg)
        elif msg.startswith("Exception in thread"):
            self._open(key, 2, ts, tid)
        elif "Error in runnable" in msg:
            self._open(key, 3, ts, tid)
        # обычный `Traceback` без «Exception in thread» — обработанная ошибка (print_exc), не считаем

    def _step(self, b, msg):
        """True — блок завершён (строка в него не входит)."""
        b["n"] += 1
        if b["n"] > 120:
            return True
        if b["fmt"] == 3:
            s = msg.strip()
            if msg.startswith("com.chaquo.python.PyException:") and b["exc"] is None:
                b["exc"] = msg.split(":", 1)[1].strip()
                return False
            if msg[:1] in (" ", "\t") or s.startswith("at ") or s.startswith("..."):
                if "<python>" in msg:
                    fm = _SAFETY_PYFR.search(msg)
                    if fm:
                        b["ids"].append(fm.group(1))
                return False
            if s.startswith("Caused by:"):
                return False
            return True
        # форматы 1 и 2 — python-traceback
        if msg.startswith(_SAFETY_MARKERS) or not msg.strip():
            b["after_marker"] = True
            if msg.startswith("Traceback"):
                b["saw_tb"] = True
            return False
        if msg[:1] in (" ", "\t"):
            fm = _SAFETY_FILE.search(msg)
            if fm:
                b["ids"].append(fm.group(1))
            return False
        if b["saw_tb"] and (b["exc"] is None or b["after_marker"]):
            b["exc"] = msg.strip()
            b["after_marker"] = False
            return False
        if b["exc"] is None and not b["saw_tb"]:
            return False if b["n"] < 3 else True   # «Exception in thread X:» без Traceback в соседней строке
        return True

    def flush(self):
        out = []
        for b in list(self.blocks.values()):
            ev = self._finish(b)
            if ev:
                out.append(ev)
        self.blocks.clear()
        return out


def safety_logcat_time(ts):
    return time.strftime("%m-%d %H:%M:%S", time.localtime(ts)) + ".000"


def safety_scan_logcat(since_ts, parser, timeout=25):
    """Читает logcat с момента since_ts потоково, отдаёт события парсера. Запасной путь — `-t N`."""
    events = []
    base = ["logcat", "-d", "-v", "threadtime"]
    for mode, args in (("time", ["-t", safety_logcat_time(since_ts)]), ("lines", ["-t", str(QPS_SAFETY_FALLBACK_LINES)])):
        proc = None
        timer = None
        try:
            proc = subprocess.Popen(base + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL)
            timer = threading.Timer(timeout, lambda p=proc: p.kill())
            timer.daemon = True
            timer.start()
            for raw in proc.stdout:
                events.extend(parser.feed(raw.decode("utf-8", "replace")))
            events.extend(parser.flush())
            proc.wait(timeout=5)
            if proc.returncode == 0:
                return events, mode
        except Exception as e:
            log(f"[{__id__}] safety: logcat {args} failed: {e}")
        finally:
            if timer is not None:
                timer.cancel()
            if proc is not None:
                try:
                    proc.kill()
                except Exception:
                    pass
    return events, "fail"


# ---------------------------------------------------------------- файлы данных (files/qps5/*.json)
_SAFETY_FILE_LOCK = threading.Lock()


def safety_read_json(name, default):
    try:
        with _SAFETY_FILE_LOCK, open(os.path.join(qps5_dir(), name), "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def safety_write_json(name, data):
    try:
        path = os.path.join(qps5_dir(), name)
        with _SAFETY_FILE_LOCK:
            with open(path + ".tmp", "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False)
            os.replace(path + ".tmp", path)
        return True
    except Exception as e:
        log(f"[{__id__}] safety: write {name} failed: {e}")
        return False


def safety_excluded():
    d = safety_read_json("excluded.json", [])
    return set(str(x) for x in d) if isinstance(d, list) else set()


def safety_set_excluded(plugin_id, value):
    s = safety_excluded()
    (s.add if value else s.discard)(plugin_id)
    return safety_write_json("excluded.json", sorted(s))


def safety_count_add(plugin_id, kind, text, ts=None):
    """error_counts.json: {id: {total, last_ts, last_text, last_kind, events:[ts…] (≤200, 7 дней)}} — вход этапа 7."""
    ts = int(ts or time.time())
    data = safety_read_json("error_counts.json", {})
    if not isinstance(data, dict):
        data = {}
    e = data.get(plugin_id) or {"total": 0, "events": []}
    e["total"] = int(e.get("total", 0)) + 1
    e["last_ts"], e["last_text"], e["last_kind"] = ts, safety_clean(text, 200), kind
    ev = [t for t in e.get("events", []) if isinstance(t, int) and t > ts - 7 * 86400] + [ts]
    e["events"] = ev[-200:]
    data[plugin_id] = e
    safety_write_json("error_counts.json", data)
    return e["total"]


def safety_recent_count(plugin_id, hours=24):
    e = (safety_read_json("error_counts.json", {}) or {}).get(plugin_id) or {}
    lim = time.time() - hours * 3600
    return sum(1 for t in e.get("events", []) if isinstance(t, int) and t >= lim)


def safety_pick_last_enabled(last, exit_ts_ms, window=QPS_SAFETY_BLAME_WINDOW_SEC):
    """Эвристика native/ANR: плагин включён последним за <=window с до сбоя. last={id,name,ts_ms}. -> dict|None"""
    try:
        d = (int(exit_ts_ms) - int(last["ts_ms"])) / 1000.0
        if 0 <= d <= window and last.get("id"):
            return {"id": last["id"], "name": last.get("name") or last["id"], "delta": int(d)}
    except Exception:
        pass
    return None


def safety_message(name, texts):
    shown = "; ".join(texts[:3]) + ("; …" if len(texts) > 3 else "")
    return f"QPS SAFITY CORE: Плагин {name} вызывает ошибки [{shown}]. Рекомендуется отключить плагин."


class SafetyEnableHook(XposedHook):
    """after-хук PluginsController.setPluginEnabled(id, True, …) -> last_enabled.json."""

    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    @guard(msg="Safety enable-hook failed")
    def after_hooked_method(self, param):
        if self.plugin._unloaded:
            return
        a = param.args
        if len(a) >= 2 and bool(a[1]):
            self.plugin._safety_note_enabled(str(a[0]))


class SafetyCoreMixin:
    def _safety_state(self):
        st = getattr(self, "_safety", None)
        if st is None:
            st = {"timer": None, "wd": None, "stop": threading.Event(), "since": time.time(), "seen": _collections.deque(maxlen=300),
                  "notified": _collections.deque(maxlen=300), "lock": threading.Lock(), "hooks": [], "hang_reported": 0.0,
                  "ui_ping": time.time(), "scans": 0}
            self._safety = st
        return st

    # ---------------------------------------------------------------- жизненный цикл
    @safe(msg="QPS safety on_load failed", notify=False)
    def _safety_on_load(self):
        st = self._safety_state()
        st["stop"].clear()
        st["since"] = time.time()
        try:
            for target in PluginsController.getClass().getDeclaredMethods():
                if str(target.getName()) == "setPluginEnabled":
                    h = self.hook_method(target, SafetyEnableHook(self))
                    if h:
                        st["hooks"].append(h)
        except Exception as e:
            log(f"[{__id__}] safety: enable hook failed: {e}")
        t = threading.Timer(8.0, self._safety_check_exit)   # после старта UI
        t.daemon = True
        t.start()
        st["exit_timer"] = t
        self._safety_apply()

    @safe(msg="QPS safety on_unload failed", notify=False)
    def _safety_on_unload(self):
        st = self._safety_state()
        st["stop"].set()
        for k in ("timer", "exit_timer"):
            if st.get(k) is not None:
                st[k].cancel()
                st[k] = None
        for h in st["hooks"]:
            try:
                self.unhook_method(h)
            except Exception:
                pass
        st["hooks"].clear()

    def _safety_on(self, key):
        return bool(self.get_setting(key, False))

    def _safety_interval(self):
        try:
            v = int(str(self.get_setting("safety_scan_interval", str(QPS_SAFETY_MIN_INTERVAL))).strip())
        except (TypeError, ValueError):
            v = QPS_SAFETY_MIN_INTERVAL
        return max(QPS_SAFETY_MIN_INTERVAL, v)

    def _safety_apply(self, *_):
        """Перезапуск фоновых задач под текущие тумблеры (вызывается при загрузке и on_change)."""
        st = self._safety_state()
        if self._unloaded or st["stop"].is_set():
            return
        if st.get("timer") is not None:
            st["timer"].cancel()
            st["timer"] = None
        if self._safety_on("safety_java"):
            self._safety_schedule(QPS_SAFETY_FIRST_DELAY)
        if self._safety_on("safety_hang") and (st.get("wd") is None or not st["wd"].is_alive()):
            wd = threading.Thread(target=self._safety_watchdog, name="qps-safety-wd", daemon=True)
            st["wd"] = wd
            wd.start()

    def _safety_schedule(self, delay):
        st = self._safety_state()
        if self._unloaded or st["stop"].is_set():
            return
        t = threading.Timer(delay, self._safety_tick)
        t.daemon = True
        st["timer"] = t
        t.start()

    def _safety_tick(self):
        try:
            if self._unloaded or not self._safety_on("safety_java"):
                return
            self.safety_scan_now()
        except Exception:
            log(f"[{__id__}] safety tick failed: {traceback.format_exc()}")
        finally:
            if not self._unloaded and self._safety_on("safety_java"):
                self._safety_schedule(self._safety_interval())

    # ---------------------------------------------------------------- скан logcat (Java/Python)
    def safety_scan_now(self, report=True):
        """Один скан: новые строки с прошлого раза. -> list событий (после дедупликации)."""
        st = self._safety_state()
        with st["lock"]:
            now = time.time()
            since = st["since"] - QPS_SAFETY_OVERLAP_SEC
            plugins = ioe_list_plugins() or []
            parser = SafetyLogParser(known_ids=[p["id"] for p in plugins], names={p["name"]: p["id"] for p in plugins},
                                     self_id=__id__)
            events, mode = safety_scan_logcat(since, parser)
            st["since"] = now
            st["scans"] += 1
            fresh = []
            excluded = safety_excluded()
            for ev in events:
                key = (ev["ts"], ev["tid"], ev["id"], ev["text"])
                if key in st["seen"]:
                    continue
                st["seen"].append(key)
                if ev["id"] in excluded:
                    continue
                fresh.append(ev)
        log(f"[{__id__}] safety: scan #{st['scans']} mode={mode} events={len(fresh)}")
        if report and fresh:
            self._safety_report(fresh, plugins, "python")
        return fresh

    # ---------------------------------------------------------------- отчёт
    def _safety_report(self, events, plugins, kind, suffix=None):
        names = {p["id"]: p["name"] for p in plugins}
        by = _collections.OrderedDict()
        for ev in events:
            by.setdefault(ev["id"], []).append(ev["text"])
            safety_count_add(ev["id"], kind, ev["text"])
        st = self._safety_state()
        sent = False
        for pid, texts in by.items():
            uniq = list(_collections.OrderedDict.fromkeys(texts))
            fresh_texts = [t for t in uniq if (pid, t) not in st["notified"]]   # дедупликация одинаковых ошибок
            if not fresh_texts:
                continue
            for t in fresh_texts:
                st["notified"].append((pid, t))
            if suffix:
                fresh_texts = fresh_texts[:1] + [suffix]
            msg = safety_message(names.get(pid, pid), fresh_texts)
            self._safety_send_saved(msg)
            sent = True
        if sent:
            run_on_ui_thread(lambda: BulletinHelper.show_error(QPS_SAFETY_BULLETIN))

    def _safety_send_saved(self, text):
        try:
            account = get_selected_account()
            me = int(get_user_config(account).getClientUserId())
        except Exception:
            log(f"[{__id__}] safety: no account for Saved Messages: {traceback.format_exc()}")
            return False
        def go():
            try:
                try:
                    from client_utils import send_message as _sm
                    _sm({"peer": me, "message": text, "account": account})
                    return
                except Exception as e1:
                    log(f"[{__id__}] safety: client_utils.send_message failed ({e1}), fallback SendMessagesHelper")
                from org.telegram.messenger import SendMessagesHelper
                SendMessagesHelper.getInstance(account).sendMessage(SendMessagesHelper.SendMessageParams.of(text, me))
            except Exception:
                log(f"[{__id__}] safety: send failed: {traceback.format_exc()}")
        run_on_ui_thread(go)
        return True

    # ---------------------------------------------------------------- last_enabled / native / ANR
    def _safety_note_enabled(self, plugin_id):
        if plugin_id == __id__:
            return
        name = plugin_id
        try:
            obj = PluginsController.getInstance().plugins.get(plugin_id)
            if obj is not None:
                name = _ioe_plugin_name(obj, plugin_id)
        except Exception:
            pass
        safety_write_json("last_enabled.json", {"id": plugin_id, "name": name, "ts_ms": int(time.time() * 1000)})

    @safe(default=None, msg="Safety exit check failed", notify=False)
    def _safety_check_exit(self):
        """На запуске: новые ApplicationExitInfo (native/ANR) -> эвристика «включён последним» -> отчёт."""
        from android.os import Build
        if Build.VERSION.SDK_INT < 30:
            return
        from android.app import ApplicationExitInfo
        ctx = ApplicationLoader.applicationContext
        am = ctx.getSystemService(Context.ACTIVITY_SERVICE)
        infos = am.getHistoricalProcessExitReasons(ctx.getPackageName(), 0, 8)
        state = safety_read_json("safety_state.json", None)
        entries = []
        for i in range(infos.size()):
            info = infos.get(i)
            entries.append((int(info.getTimestamp()), int(info.getReason()), info))
        newest = max([e[0] for e in entries] or [0])
        if not isinstance(state, dict):   # первый запуск: старые сбои до включения защиты не разбираем
            safety_write_json("safety_state.json", {"last_exit_ts": newest})
            return
        last = int(state.get("last_exit_ts", 0))
        safety_write_json("safety_state.json", {"last_exit_ts": max(last, newest)})
        want = {}
        if self._safety_on("safety_native"):
            want[ApplicationExitInfo.REASON_CRASH_NATIVE] = "native"
        if self._safety_on("safety_hang"):
            want[ApplicationExitInfo.REASON_ANR] = "hang"
        for ts, reason, info in sorted(entries):
            if ts <= last or reason not in want:
                continue
            self._safety_handle_exit(want[reason], ts, info)

    def _safety_firebase_crash(self, info):
        """Native-краш в потоке Firebase (ScionFrontendAp) — не вина плагина (SPEC, раздел 3). НЕ ПОДТВЕРЖДЕНО на устройстве."""
        try:
            stream = info.getTraceInputStream()
            if stream is None:
                return False
            data = bytes(bytearray(stream.readNBytes(600000)))
            stream.close()
            return b"ScionFrontendAp" in data or b"com.google.android.gms.measurement" in data
        except Exception:
            return False

    def _safety_handle_exit(self, kind, ts, info):
        label = "native-краш" if kind == "native" else "зависание (ANR)"
        if kind == "native" and self._safety_firebase_crash(info):
            log(f"[{__id__}] safety: native crash ts={ts} in Firebase thread, plugin not blamed")
            return
        last = safety_read_json("last_enabled.json", None)
        pick = safety_pick_last_enabled(last, ts) if isinstance(last, dict) else None
        log(f"[{__id__}] safety: exit {kind} ts={ts} desc={info.getDescription()} blame={pick}")
        if not pick or pick["id"] in safety_excluded():
            return
        plugins = ioe_list_plugins() or []
        if pick["id"] not in [p["id"] for p in plugins]:
            return   # плагин уже удалён
        caveat = f"{label}; предположение: плагин был включён за {pick['delta']} с до сбоя"
        ev = {"id": pick["id"], "text": caveat, "fmt": 0, "ts": str(ts), "tid": "0"}
        if QPS_SAFETY_AUTO_DISABLE_LAST:
            ioe_set_enabled(pick["id"], False)
            ev["text"] = caveat + "; плагин выключен автоматически"
        self._safety_report([ev], plugins, kind)

    # ---------------------------------------------------------------- watchdog зависания
    def _safety_watchdog(self):
        st = self._safety_state()
        st["ui_ping"] = time.time()
        def pong():
            st["ui_ping"] = time.time()
        while not st["stop"].is_set() and not self._unloaded and self._safety_on("safety_hang"):
            try:
                age = time.time() - st["ui_ping"]
                if age > QPS_SAFETY_HANG_SEC and time.time() - st["hang_reported"] > 120:
                    st["hang_reported"] = time.time()
                    self._safety_on_hang(age)
                run_on_ui_thread(pong)
            except Exception:
                log(f"[{__id__}] safety watchdog failed: {traceback.format_exc()}")
            st["stop"].wait(QPS_SAFETY_WATCHDOG_TICK)

    def _safety_on_hang(self, age):
        """UI-поток молчит: ищем плагиновые кадры в Python-стеках, затем isNotResponding у плагинов."""
        plugins = ioe_list_plugins() or []
        known = {p["id"] for p in plugins}
        culprit = None
        try:
            for tid, frame in sys._current_frames().items():
                f = frame
                while f is not None:
                    m = _SAFETY_FILE.search(f.f_code.co_filename.replace("\\", "/"))
                    if m and m.group(1) in known and m.group(1) != __id__:
                        culprit = m.group(1)
                        break
                    f = f.f_back
                if culprit:
                    break
        except Exception:
            pass
        if not culprit:
            for pid, obj in _ioe_controller_plugins():
                try:
                    nr = getattr(obj, "isNotResponding", None)
                    if nr is not None and bool(nr() if callable(nr) else nr):
                        culprit = pid
                        break
                except Exception:
                    pass
        log(f"[{__id__}] safety: UI hang {age:.0f}s culprit={culprit}")
        if culprit and culprit not in safety_excluded():
            self._safety_report([{"id": culprit, "text": f"зависание интерфейса {int(age)} с", "fmt": 0, "ts": str(time.time()), "tid": "0"}],
                                plugins, "hang")

    # ---------------------------------------------------------------- UI: настройки
    def _safety_settings_items(self):
        sw = lambda key, text: Switch(key=key, text=text, default=False, on_change=lambda v: self._safety_apply())
        items = [
            Header(text="Защита (QPS SAFITY CORE)"),
            sw("safety_native", "Native-краши (на следующем запуске)"),
            sw("safety_java", "Java/Python-ошибки плагинов (скан)"),
            sw("safety_hang", "Зависание интерфейса"),
            Input(key="safety_scan_interval", text="Интервал скана, сек (минимум 55)",
                  default=str(QPS_SAFETY_MIN_INTERVAL), icon="msg_timer"),
        ]
        if self.get_setting("debug_mode", False):
            items += [
                Text(text="Скан сейчас (тест защиты)", icon="msg_search", on_click=lambda _=None: self._submit(self._safety_manual_scan, "safety_scan")),
                Text(text="Тест: ошибка в потоке", icon="msg_info", on_click=lambda _=None: self._safety_test_thread()),
                Text(text="Тест: ошибка в runnable (UI)", icon="msg_info", on_click=lambda _=None: self._safety_test_runnable()),
                Text(text="Тест: ошибка в кнопке настроек", icon="msg_info", on_click=self._safety_test_button),
            ]
        items.append(Divider(text=QPS_SAFETY_WARN_TEXT))
        return items

    def _safety_manual_scan(self):
        evs = self.safety_scan_now(report=False)
        plugins = ioe_list_plugins() or []
        if evs:
            self._safety_report(evs, plugins, "python")
        run_on_ui_thread(lambda: BulletinHelper.show_info(f"QPS защита: найдено ошибок {len(evs)}"))

    # --- самопроверка форматов (ошибки с маркером принимаются и от QPS, см. SafetyLogParser._ok_id)
    def _safety_test_thread(self):
        def boom():
            raise ValueError(QPS_SAFETY_TEST_MARKER + " thread")
        threading.Thread(target=boom, name="qps-safety-test").start()   # -> «Exception in thread qps-safety-test:»
        BulletinHelper.show_info("Тест: ошибка в потоке брошена, нажмите «Скан сейчас»")

    def _safety_test_runnable(self):
        def boom():
            raise ValueError(QPS_SAFETY_TEST_MARKER + " runnable")
        run_on_ui_thread(boom)   # -> «Error in runnable» + PyException
        BulletinHelper.show_info("Тест: ошибка в runnable брошена, нажмите «Скан сейчас»")

    def _safety_test_button(self, _=None):
        """Проверка открытого вопроса SPEC: попадает ли исключение обработчика кнопки настроек в logcat."""
        self._submit(lambda: (time.sleep(3), self._safety_probe_button_result()), "safety_btn_probe")
        raise ValueError(QPS_SAFETY_BUTTON_MARKER)

    def _safety_probe_button_result(self):
        lines = []
        try:
            res = subprocess.run(["logcat", "-d", "-v", "threadtime", "-t", "800"], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
            lines = [l for l in res.stdout.decode("utf-8", "replace").splitlines() if QPS_SAFETY_BUTTON_MARKER in l][:6]
        except Exception as e:
            lines = [f"logcat failed: {e}"]
        found = [l for l in lines if "logcat failed" not in l]
        safety_write_json("button_probe.json", {"found": bool(found), "lines": [l[:300] for l in lines], "ts": int(time.time())})
        log(f"[{__id__}] safety: button probe found={bool(found)} lines={lines}")
        run_on_ui_thread(lambda: BulletinHelper.show_info(
            "Кнопка настроек: исключение " + ("ЕСТЬ в logcat" if found else "НЕ найдено в logcat")))

    # ---------------------------------------------------------------- меню плагинов: «Исключить из warning»
    def _safety_toggle_exclude(self, plugin_id, plugin_name):
        now = plugin_id not in safety_excluded()
        ok = safety_set_excluded(plugin_id, now)
        msg = (f"{plugin_name}: исключён из warning" if now else f"{plugin_name}: снова под защитой") if ok else "Не удалось сохранить исключение"
        BulletinHelper.show_info(msg)


def localise_exclude(plugin_id):
    return "Вернуть в warning" if plugin_id in safety_excluded() else "Исключить из warning"

# ---- fragment: cards.py ----
