def localise(key, *args):
    lang = Locale.getDefault().getLanguage()
    locale_dict = getattr(Locales, lang, Locales.default)
    text = locale_dict.get(key, Locales.default.get(key, key))
    return text.format(*args) if args else text


def _error_bulletin_icon():
    raw = getattr(R_tg, "raw", None)
    for name in ("error", "chats_infotip", "info"):
        icon = getattr(raw, name, None)
        if icon:
            return icon
    return 0

# эту хуйню вешаем только к except который логает+ отдает дефолт
# если на except завязан fallback на другой путь — не вешать, оно сожрёт ветку
def safe(default=None, msg=None, ctx=None, notify=True):
    def deco(fn):
        @wraps(fn)
        def wrapper(self, *args, **kwargs):
            try:
                return fn(self, *args, **kwargs)
            except Exception as e:
                label = msg or f"{fn.__name__} failed"
                if ctx is not None:
                    try:
                        label = f"{label} for {ctx(*args, **kwargs)}"
                    except Exception:
                        pass
                # notify=False идёт для внутренней кухни (тики таймеров, поштучные проходы по списку плагинов) —
                # там бюллетень на каждый чих это спам, но полный трейс всё равно летит в лог
                if notify:
                    self._handle_error(label)
                else:
                    log(f"[{__id__}] {label}: {traceback.format_exc()}")
                return default
        return wrapper
    return deco

class _CommandVisitor(ast.NodeVisitor):
   # if u see this, i have rlly br0ken vision xDD
    VALID_COMMAND_RE = re.compile(r"^\.[\w-]+$")
    # регексу похуй что это расширение файла а не команда - .py/.plugin/.elyx/.eaf сюда не пускаем
    _EXCLUDED_TOKENS = {".py", ".plugin", ".elyx", ".eaf"}

    def __init__(self):
        self.commands = set()
        self.variables = {}

    def _resolve_node_value(self, node):
        if isinstance(node, ast.Constant):
            return str(node.value)
        if isinstance(node, ast.Name) and node.id in self.variables:
            return str(self.variables[node.id])
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
            left = self._resolve_node_value(node.left)
            right = self._resolve_node_value(node.right)
            if left is not None and right is not None:
                return left + right
        return None

    def visit_Assign(self, node):
        if len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            try:
                self.variables[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError, TypeError, AttributeError, SyntaxError):
                pass
        self.generic_visit(node)

    def _add_command(self, value):
        if isinstance(value, str):
            command = value.strip().split(" ")[0]
            if command in self._EXCLUDED_TOKENS:
                return
            if self.VALID_COMMAND_RE.match(command):
                self.commands.add(command)

    def visit_Compare(self, node):
        if any(isinstance(op, (ast.Eq, ast.NotEq, ast.In)) for op in node.ops):
            for item in [node.left] + node.comparators:
                value = self._resolve_node_value(item)
                if value:
                    self._add_command(value)
                elif isinstance(item, (ast.List, ast.Tuple)):
                    for element in item.elts:
                        val = self._resolve_node_value(element)
                        if val:
                            self._add_command(val)
        self.generic_visit(node)

    def visit_Call(self, node):
        if isinstance(node.func, ast.Attribute) and node.func.attr == "startswith":
            if node.args:
                arg = node.args[0]
                if isinstance(arg, (ast.Tuple, ast.List)):
                    for element in arg.elts:
                        value = self._resolve_node_value(element)
                        if value:
                            self._add_command(value)
                else:
                    value = self._resolve_node_value(arg)
                    if value:
                        self._add_command(value)
        self.generic_visit(node)

def _get_id_from_tree(tree):
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        for target in node.targets:
            if isinstance(target, ast.Name) and target.id == "__id__":
                try:
                    value = ast.literal_eval(node.value)
                except (ValueError, TypeError, SyntaxError):
                    return None
                return value if isinstance(value, str) and value else None
    return None


def _get_returns_no_nested(node):
    returns = []
    for child in ast.iter_child_nodes(node):
        if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            continue
        if isinstance(child, ast.Return):
            returns.append(child)
        else:
            returns.extend(_get_returns_no_nested(child))
    return returns

def _has_real_create_settings(tree):
    for node in ast.walk(tree):
        if not isinstance(node, ast.ClassDef):
            continue
        for item in node.body:
            if not (isinstance(item, ast.FunctionDef) and item.name == "create_settings"):
                continue
            arg_names = [a.arg for a in item.args.args]
            if not arg_names or arg_names[0] != "self":
                continue
            returns = _get_returns_no_nested(item)
            if not returns:
                continue
            for ret in returns:
                value = ret.value
                if value is None:
                    continue
                if isinstance(value, ast.Constant) and value.value is None:
                    continue
                if isinstance(value, (ast.List, ast.Tuple)) and not value.elts:
                    continue
                return True
    return False

class PluginStateChangeHook(XposedHook):
    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    def after_hooked_method(self, param):
        self.plugin._schedule_cache_rebuild()

class QuickSettingsPlugin(BasePlugin):
    PRIORITY_PLUGIN = 90
    PRIORITY_SHORTCUT = 91

    @safe(msg="Failed to cancel timer", notify=False)
    def _cancel_timer(self, timer):
        if timer:
            timer.cancel()

    @safe(default=False, msg="Clipboard copy failed", notify=False)
    def _copy_to_clipboard(self, label, text):
        context = ApplicationLoader.applicationContext
        if not context:
            return False
        clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)
        if not clipboard:
            return False
        clipboard.setPrimaryClip(ClipData.newPlainText(label, text))
        return True

    def _handle_error(self, context_label, message_key="PLUGIN_GENERIC_ERROR",
                      message_args=(), notify=True):
        tb = traceback.format_exc()
        log(f"[{__id__}] {context_label}: {tb}")

        def notify_action():
            bulletin_text = localise(message_key, *message_args)

            def copy_action():
                copied = self._copy_to_clipboard(
                    f"{__id__} error: {context_label}",
                    f"[{__id__}] {context_label}\n{tb}"
                )
                if copied:
                    BulletinHelper.show_info(localise("ERROR_DETAILS_COPIED"))

            try:
                BulletinHelper.show_with_button(
                    bulletin_text,
                    _error_bulletin_icon(),
                    localise("BULLETIN_ACTION_COPY_DETAILS"),
                    copy_action,
                    get_last_fragment()
                )
            except Exception as e:
                log(f"[{__id__}] show_with_button unavailable: {e}")
                BulletinHelper.show_error(bulletin_text)

        if notify:
            run_on_ui_thread(notify_action)

    def _run_ui_action(self, action, error_context, message_key="PLUGIN_GENERIC_ERROR",
                       message_args=(), notify_on_error=True):
        def wrapped():
            try:
                action()
            except Exception:
                self._handle_error(
                    error_context, message_key, message_args, notify=notify_on_error
                )

        run_on_ui_thread(wrapped)

    def _notify(self, kind, text):
        fn = {
            "success": BulletinHelper.show_success,
            "error": BulletinHelper.show_error,
            "info": BulletinHelper.show_info,
        }.get(kind, BulletinHelper.show_info)
        run_on_ui_thread(lambda: fn(text))

    def __init__(self):
        super().__init__()
        self.added_menu_items = []
        self.hooks = []
        self.update_timer = None
        self.plugin_info_cache = {}
        self.file_cache = {}
        self.cache_path = None
        self.rebuild_timer = None
        self._executor = None
        self._staged_timers = set()
        self._staged_lock = threading.Lock()
        self._staged_timeout_lock = threading.Lock()
        self._rebuild_lock = threading.Lock()
        self._rebuild_exec_lock = threading.Lock()
        self._menu_lock = threading.Lock()
        self._cache_lock = threading.Lock()
        self._plugin_locks = {}
        self._plugin_locks_lock = threading.Lock()

    def _get_plugin_lock(self, plugin_id):
        with self._plugin_locks_lock:
            lock = self._plugin_locks.get(plugin_id)
            if lock is None:
                lock = threading.Lock()
                self._plugin_locks[plugin_id] = lock
            return lock

    def create_settings(self):
        return [
            Header(text=localise("HEADER_MENU_LOCATION")),
            Selector(
                key="menu_location",
                text=localise("SELECTOR_SHOW_MENU_IN"),
                items=localise("SELECTOR_ITEMS_MENU_LOCATION"),
                default=MENU_LOCATION_BOTH,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_PLUGINS_SHORTCUT")),
            Switch(
                key="show_chat_plugins_shortcut",
                text=localise("SWITCH_SHOW_CHAT_PLUGINS_SHORTCUT"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_CHAT_MENU_ACTION")),
            Selector(
                key="chat_menu_action",
                text=localise("SELECTOR_CHAT_MENU_ACTION"),
                items=localise("SELECTOR_ITEMS_CHAT_MENU_ACTION"),
                default=ACTION_OPEN_MENU,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_PLUGIN_VISIBILITY")),
            Switch(
                key="show_plugins_without_settings",
                text=localise("SWITCH_SHOW_PLUGINS_WITHOUT_SETTINGS"),
                default=False,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Switch(
                key="show_disabled_plugins",
                text=localise("SWITCH_SHOW_DISABLED_PLUGINS"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_CACHE_MANAGEMENT")),
            Text(
                text=localise("SETTINGS_REBUILD_CACHE_BUTTON"),
                icon="msg_update",
                on_click=self._handle_rebuild_cache_click
            ),
            Divider(text=localise("SETTINGS_REBUILD_CACHE_SUBTEXT")),
            Header(text=localise("HEADER_STAGED_CLEANUP")),
            Input(
                key="staged_cleanup_timeout",
                text=localise("INPUT_STAGED_CLEANUP_TIMEOUT"),
                default=str(DEFAULT_STAGED_CLEANUP_TIMEOUT),
                icon="msg_timer",
                on_change=self._on_staged_cleanup_timeout_change
            ),
            Divider(text=localise("STAGED_CLEANUP_TIMEOUT_SUBTEXT"))
        ]

    def _handle_rebuild_cache_click(self, view):
        BulletinHelper.show_info(localise("INFO_CACHE_REBUILDING"))
        self._schedule_cache_rebuild(delay=0.1, show_notification=True)

    def _on_staged_cleanup_timeout_change(self, new_value):
        # лочим, чтобы чтение старого значения + запись клэмпнутого не порвало друг друга при гонке колбэков
        with self._staged_timeout_lock:
            try:
                parsed = int(str(new_value).strip())
            except (TypeError, ValueError):
                parsed = DEFAULT_STAGED_CLEANUP_TIMEOUT
            clamped = max(MIN_STAGED_CLEANUP_TIMEOUT, min(MAX_STAGED_CLEANUP_TIMEOUT, parsed))
            if str(clamped) != str(new_value).strip():
                self.set_setting("staged_cleanup_timeout", str(clamped), reload_settings=True)

    def _get_staged_cleanup_timeout(self):
        with self._staged_timeout_lock:
            raw = self.get_setting("staged_cleanup_timeout", str(DEFAULT_STAGED_CLEANUP_TIMEOUT))
        try:
            value = int(str(raw).strip())
        except (TypeError, ValueError):
            return DEFAULT_STAGED_CLEANUP_TIMEOUT
        return max(MIN_STAGED_CLEANUP_TIMEOUT, min(MAX_STAGED_CLEANUP_TIMEOUT, value))

    def on_plugin_load(self):
        self._executor = ThreadPoolExecutor(max_workers=2)
        self._clear_temp_dir()
        self._init_cache_system()
        if self._load_cache():
            self._schedule_cache_rebuild(delay=2.0)
        else:
            self._schedule_cache_rebuild(delay=0.1)
        self._schedule_menu_update(delay=0)
        self._apply_hooks()

    def on_plugin_unload(self):
        run_on_ui_thread(self._remove_menu_items)
        self._remove_hooks()
        self._cancel_timer(self.update_timer)
        self._cancel_timer(self.rebuild_timer)
        if self._executor:
            self._executor.shutdown(wait=False)
            self._executor = None
        self._cancel_staged_timers()
        self._clear_temp_dir()

    @safe(msg="Failed to initialize cache system")
    def _init_cache_system(self):
        context = ApplicationLoader.applicationContext
        if not context:
            return
        base_dir = context.getFilesDir()
        if not base_dir:
            return

        cache_dir = File(base_dir, QUICKSETTINGS_CACHE_DIR)
        if not cache_dir.exists():
            cache_dir.mkdirs()

        self.cache_path = File(cache_dir, CACHE_FILENAME).getAbsolutePath()

    def _index_by_plugin_id(self, file_cache):
        index = {}
        for entry in file_cache.values():
            if not isinstance(entry, dict):
                continue
            plugin_id = entry.get("plugin_id")
            if plugin_id:
                index[plugin_id] = entry
        return index

    def _load_cache(self):
        if not self.cache_path or not os.path.exists(self.cache_path):
            return False
        try:
            with open(self.cache_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if not isinstance(data, dict):
                return False

            # старый кэш v4.0 лежал по plugin_id и без mtime — такие записи просто отвалятся на ребилде
            with self._cache_lock:
                self.file_cache = data
                self.plugin_info_cache = self._index_by_plugin_id(data)
            log(f"[{__id__}] Cache loaded successfully with {len(self.plugin_info_cache)} entries.")
            return True
        except Exception as e:
            log(f"[{__id__}] Failed to load cache: {e}. Rebuilding.")
            return False

    def _rebuild_cache_and_update_menu(self, show_notification=False):
        # тут раньше лочился только таймер в _schedule_cache_rebuild, а не сам скан —
        # если хук дёргает ребилд пока прошлый ещё физически читает диск, оба потока
        # лезут писать в один cache_path+".tmp" одновременно. non-blocking acquire:
        # если кто-то уже внутри - не лезем следом, а перепланируем себя на потом
        if not self._rebuild_exec_lock.acquire(blocking=False):
            log(f"[{__id__}] Rebuild already in progress, requeueing.")
            self._schedule_cache_rebuild(delay=1.0, show_notification=show_notification)
            return

        try:
            self._do_rebuild_cache_and_update_menu(show_notification)
        finally:
            self._rebuild_exec_lock.release()

    def _do_rebuild_cache_and_update_menu(self, show_notification=False):
        log(f"[{__id__}] Starting cache rebuild.")
        if not self.cache_path:
            self._init_cache_system()

        if not self.cache_path:
            log(f"[{__id__}] Cache path not initialized. Aborting rebuild.")
            return

        cache_data = {}
        parsed = 0
        reused = 0
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return

            old_cache = self.file_cache

            for filename in os.listdir(plugins_dir):
                is_elyx = filename.endswith(ELYX_EXTS)
                if not is_elyx and not filename.endswith((".py", ".plugin")):
                    continue
                file_path = os.path.join(plugins_dir, filename)
                try:
                    stat = os.stat(file_path)
                    size = stat.st_size

                    # файл не трогали с прошлого раза — берём готовое, нехуй его парсить заново
                    old = old_cache.get(filename)
                    if (
                        isinstance(old, dict)
                        and old.get("plugin_id")
                        and old.get("mtime") == stat.st_mtime
                        and old.get("size") == size
                    ):
                        # старый кэш мог быть записан до появления is_elyx - копия, а не мутация
                        # in-place, self.plugin_info_cache на этот словарь ещё смотрит живой юай-поток
                        cache_data[filename] = old if "is_elyx" in old else {**old, "is_elyx": is_elyx}
                        reused += 1
                        continue

                    if is_elyx:
                        if size > MAX_ELYX_ARCHIVE_SIZE:
                            log(f"[{__id__}] Skipped {filename}: {size} bytes is too fat for elyx scan")
                            continue

                        elyx_result = self._scan_elyx_archive(file_path)
                        if not elyx_result:
                            continue
                        elyx_plugin_id, elyx_has_settings, elyx_commands, elyx_parse_failed = elyx_result

                        parsed += 1
                        cache_data[filename] = {
                            "plugin_id": elyx_plugin_id,
                            "mtime": stat.st_mtime,
                            "size": size,
                            "has_settings": elyx_has_settings,
                            "commands": elyx_commands,
                            "parse_failed": elyx_parse_failed,
                            "is_elyx": True
                        }
                        continue

                    # 8 мб — это уже не плагин, а хуйня какая-то, парсить не будем
                    if size > MAX_FILE_SIZE:
                        log(f"[{__id__}] Skipped {filename}: {size} bytes is too fat for ast")
                        continue

                    with open(file_path, "r", encoding="utf-8-sig") as f:
                        content = f.read()

                    if "__id__" not in content:
                        continue

                    try:
                        tree = ast.parse(content, filename=filename)
                    except Exception as ast_err:
                        log(f"[{__id__}] AST parse failed for {filename}: {ast_err}")
                        tree = None

                    parse_failed = tree is None

                    plugin_id = _get_id_from_tree(tree) if tree is not None else None
                    if not plugin_id:
                        plugin_id = self._get_id_from_file_content(content)
                    if not plugin_id:
                        continue
                    has_settings = _has_real_create_settings(tree) if tree is not None else False

                    if tree is not None:
                        visitor = _CommandVisitor()
                        visitor.visit(tree)
                        commands = sorted(list(visitor.commands))
                    else:
                        commands = []

                    parsed += 1
                    cache_data[filename] = {
                        "plugin_id": plugin_id,
                        "mtime": stat.st_mtime,
                        "size": size,
                        "has_settings": has_settings,
                        "commands": commands,
                        "parse_failed": parse_failed,
                        "is_elyx": False
                    }
                except Exception as inner_e:
                    log(f"[{__id__}] Skipped {filename}: {inner_e}")
                    continue

            # пишем в .tmp и подменяем, чтоб дохляк посреди записи не наебашил по json
            tmp_path = self.cache_path + ".tmp"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(cache_data, f)
            os.replace(tmp_path, self.cache_path)

            with self._cache_lock:
                self.file_cache = cache_data
                self.plugin_info_cache = self._index_by_plugin_id(cache_data)

            log(
                f"[{__id__}] Cache rebuilt and saved with {len(cache_data)} entries "
                f"(parsed {parsed}, reused {reused})."
            )

            self._schedule_menu_update(delay=0)
            if show_notification:
                self._notify("success", localise("INFO_CACHE_REBUILT_SUCCESS"))

        except Exception:
            self._handle_error("Error during cache rebuild", notify=show_notification)

    def _schedule_cache_rebuild(self, delay=1.0, show_notification=False):
        with self._rebuild_lock:
            self._cancel_timer(self.rebuild_timer)
            timer = threading.Timer(
                delay, self._rebuild_cache_and_update_menu, args=(show_notification,)
            )
            timer.daemon = True
            self.rebuild_timer = timer
            timer.start()

    def _apply_hooks(self):
        if self.hooks:
            return
        try:
            controller_class = PluginsController.getClass()
            hook_handler = PluginStateChangeHook(self)

            methods_to_hook = [
                ("loadPluginFromFile", String, Utilities.Callback),
                ("setPluginEnabled", String, Boolean.TYPE, Utilities.Callback),
                ("deletePlugin", String),
            ]
            for method_name, *arg_types in methods_to_hook:
                try:
                    target = controller_class.getDeclaredMethod(method_name, *arg_types)
                    hook = self.hook_method(target, hook_handler)
                    if hook:
                        self.hooks.append(hook)
                    else:
                        log(f"[{__id__}] hook_method returned nothing for {method_name}, skipping")
                except Exception as e:
                    log(f"[{__id__}] Failed to hook {method_name}: {e}")
        except Exception as e:
            log(f"[{__id__}] Failed to apply hooks: {e}")

    def _remove_hooks(self):
        for hook in self.hooks:
            try:
                self.unhook_method(hook)
            except Exception as e:
                log(f"[{__id__}] Failed to unhook {hook}: {e}")
        self.hooks.clear()

    def _schedule_menu_update(self, delay=0.0):
        # таймер чтобы не ебашить меню 10 раз в секунду
        with self._menu_lock:
            self._cancel_timer(self.update_timer)
            timer = threading.Timer(delay, self._update_menu_items)
            timer.daemon = True
            self.update_timer = timer
            timer.start()

    def _get_id_from_file_content(self, content):
        match = re.search(
            r"^__id__\s*=\s*['\"]([\w.-]+)['\"]", content, re.MULTILINE
        )
        return match.group(1) if match else None

    def _read_zip_entry_capped(self, zf, name, max_size):
        info = zf.getinfo(name)
        if info.file_size > max_size:
            return None
        return zf.read(name)

    def _parse_flat_mapping(self, text):
        result = {}
        for line in text.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#") or ":" not in stripped:
                continue
            key, _, value = stripped.partition(":")
            key = key.strip().strip('"').strip("'")
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                value = value[1:-1]
            if key:
                result[key] = value
        return result

    def _parse_structured(self, raw, is_json):
        text = raw.decode("utf-8-sig", errors="replace")
        if is_json:
            try:
                return json.loads(text)
            except Exception as e:
                log(f"[{__id__}] Failed to parse elyx json: {e}")
                return None
        try:
            import yaml
            return yaml.safe_load(text)
        except ImportError:
            return self._parse_flat_mapping(text)
        except Exception as e:
            log(f"[{__id__}] Failed to parse elyx yaml: {e}")
            return None

    def _read_elyx_refmap(self, zf):
        names = zf.namelist()
        for candidate in ELYX_REFMAP_NAMES:
            if candidate in names:
                raw = self._read_zip_entry_capped(zf, candidate, MAX_FILE_SIZE)
                if raw is None:
                    return {}
                parsed = self._parse_structured(raw, candidate.endswith(".json"))
                return parsed if isinstance(parsed, dict) else {}
        return {}

    def _read_elyx_metainfo(self, zf, refmap):
        names = zf.namelist()
        meta_path = refmap.get("metainfo")
        if not meta_path or meta_path not in names:
            meta_path = next((c for c in ELYX_METAINFO_NAMES if c in names), None)
        if not meta_path:
            return None

        raw = self._read_zip_entry_capped(zf, meta_path, MAX_FILE_SIZE)
        if raw is None:
            return None
        meta = self._parse_structured(raw, meta_path.endswith(".json"))
        if not isinstance(meta, dict):
            return None

        normalised = {}
        for key, value in meta.items():
            clean_key = key.strip("_") if isinstance(key, str) else key
            normalised[clean_key] = value
        return normalised

    def _read_elyx_main_path(self, zf, refmap):
        names = zf.namelist()
        main_path = refmap.get("main")
        if main_path and main_path in names:
            return main_path
        return "main.py" if "main.py" in names else None

    def _get_elyx_plugin_id(self, file_path):
        try:
            with zipfile.ZipFile(file_path) as zf:
                refmap = self._read_elyx_refmap(zf)
                meta = self._read_elyx_metainfo(zf, refmap)
                if meta and meta.get("id"):
                    return str(meta["id"])
        except Exception as e:
            log(f"[{__id__}] Failed to read elyx id from {file_path}: {e}")
        return None

    def _scan_elyx_archive(self, file_path):
        try:
            with zipfile.ZipFile(file_path) as zf:
                refmap = self._read_elyx_refmap(zf)
                meta = self._read_elyx_metainfo(zf, refmap)
                if not meta or not meta.get("id"):
                    return None
                plugin_id = str(meta["id"])

                main_rel = self._read_elyx_main_path(zf, refmap)

                wheels_prefix = refmap.get("wheels") or "wheels"
                wheels_prefix = wheels_prefix.rstrip("/") + "/"

                py_names = [
                    n for n in zf.namelist()
                    if n.endswith(".py")
                    and not n.startswith(wheels_prefix)
                    and "/.elyxbuilder/" not in n
                    and not n.startswith(".elyxbuilder/")
                ]
                if main_rel and main_rel not in py_names:
                    py_names.insert(0, main_rel)

                has_settings = False
                commands = set()
                parse_failed = False

                for name in py_names:
                    raw = self._read_zip_entry_capped(zf, name, MAX_FILE_SIZE)
                    if raw is None:
                        continue
                    try:
                        source = raw.decode("utf-8-sig", errors="replace")
                        tree = ast.parse(source, filename=name)
                    except Exception as ast_err:
                        log(f"[{__id__}] AST parse failed for {file_path}::{name}: {ast_err}")
                        parse_failed = True
                        continue

                    if not has_settings and _has_real_create_settings(tree):
                        has_settings = True

                    visitor = _CommandVisitor()
                    visitor.visit(tree)
                    commands.update(visitor.commands)

                return plugin_id, has_settings, sorted(commands), parse_failed
        except Exception as e:
            log(f"[{__id__}] Failed to scan elyx archive {file_path}: {e}")
            return None

    @safe(default=False, ctx=lambda plugin_obj: type(plugin_obj).__name__, notify=False)
    def _is_plugin_enabled(self, plugin_obj):
        return getattr(plugin_obj, "enabled", False) or (
            plugin_obj.isEnabled() if hasattr(plugin_obj, "isEnabled") else False
        )

    @safe(ctx=lambda plugin_id: plugin_id)
    def _get_plugin_obj(self, plugin_id):
        return PluginsController.getInstance().plugins.get(plugin_id)

    def _get_plugin_display_name(self, plugin_obj, fallback_id):
        try:
            return str(plugin_obj.name)
        except AttributeError:
            return str(plugin_obj.getName()) if hasattr(plugin_obj, "getName") else fallback_id

    def _get_displayable_plugins(self):
        plugins_to_show = []
        show_without_settings = self.get_setting("show_plugins_without_settings", False)
        show_disabled = self.get_setting("show_disabled_plugins", True)

        entries = []
        try:
            plugins_map = PluginsController.getInstance().plugins

            if hasattr(plugins_map, "entrySet"):
                java_iterator = plugins_map.entrySet().iterator()
                while java_iterator.hasNext():
                    entry = java_iterator.next()
                    entries.append((str(entry.getKey()), entry.getValue()))
            elif isinstance(plugins_map, dict):
                entries = list(plugins_map.items())
        except Exception as e:
            log(f"[{__id__}] Plugins snapshot broke at {len(entries)} entries: {e}")

        try:
            for plugin_id, plugin_obj in entries:
                # фильтруем себя, иначе меню в себя уйдёт — рекурсия хуёвая штука
                if plugin_id == __id__:
                    continue

                try:
                    is_enabled = self._is_plugin_enabled(plugin_obj)
                    plugin_name = self._get_plugin_display_name(plugin_obj, plugin_id)

                    if not (is_enabled or show_disabled):
                        continue

                    info = self.plugin_info_cache.get(plugin_id, {})
                    # если нет настроек и команд — нахуй оно в меню нужно
                    if not show_without_settings and not info.get("parse_failed", False) and not (
                        self._plugin_has_settings(plugin_id)
                        or self._plugin_has_commands(plugin_id)
                    ):
                        continue

                    plugins_to_show.append((plugin_id, str(plugin_name), is_enabled))
                except Exception as e:
                    log(f"[{__id__}] Error processing plugin {plugin_id}: {e}")

        except Exception as e:
            log(f"[{__id__}] Error getting displayable plugins: {e}")

        return sorted(plugins_to_show, key=lambda item: item[1].casefold())

    def _update_menu_items(self):
        try:
            menu_data = self._compute_menu_data()
        except Exception:
            self._handle_error("Error computing menu data", notify=False)
            return

        self._run_ui_action(
            lambda: self._apply_menu_items(menu_data),
            "Error updating menu items",
            notify_on_error=False
        )

    def _compute_menu_data(self):
        location = self.get_setting("menu_location", MENU_LOCATION_BOTH)
        chat_action = self.get_setting("chat_menu_action", ACTION_OPEN_MENU)
        show_shortcut = self.get_setting("show_chat_plugins_shortcut", True)
        return location, chat_action, show_shortcut, self._get_displayable_plugins()

    def _apply_menu_items(self, menu_data):
        location, chat_action, show_shortcut, displayable_plugins = menu_data

        self._remove_menu_items()

        if location in (MENU_LOCATION_CHAT, MENU_LOCATION_BOTH):
            for idx, (plugin_id, plugin_name, is_enabled) in enumerate(displayable_plugins):
                if chat_action == ACTION_OPEN_SETTINGS:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id:
                        self._open_settings_or_show_bulletin(plugin_id)
                    )
                elif chat_action == ACTION_TOGGLE_STATE:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id, plugin_name=plugin_name:
                        self._toggle_plugin_state(plugin_id, plugin_name)
                    )
                else:
                    on_click_action = (
                        lambda ctx, plugin_id=plugin_id, plugin_name=plugin_name:
                        self._show_plugin_action_dialog(plugin_id, plugin_name)
                    )

                icon = "msg_select_solar" if is_enabled else "msg_block_solar"

                item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=plugin_name,
                    icon=icon,
                    # каждому пункту - свой приоритет, а не один общий на всех: с одинаковым
                    # priority на всех элементах список при росте (без настроек=True) рендерился
                    # криво и обрубался примерно вдвое
                    priority=self.PRIORITY_PLUGIN - idx,
                    on_click=on_click_action
                ))
                self.added_menu_items.append(item)

            if show_shortcut:
                item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text=localise("MENU_ITEM_PLUGINS_SHORTCUT"),
                    icon="msg_plugins_solar",
                    priority=self.PRIORITY_SHORTCUT,
                    on_click=lambda ctx: self._open_plugins_activity()
                ))
                self.added_menu_items.append(item)

        if location in (MENU_LOCATION_DRAWER, MENU_LOCATION_BOTH):
            settings_item = self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text=localise("TITLE_PLUGIN_SETTINGS"),
                icon="msg_reorder",
                priority=self.PRIORITY_PLUGIN,
                on_click=lambda ctx: self._open_plugins_activity()
            ))
            self.added_menu_items.append(settings_item)

    def _remove_menu_items(self):
        failed = []
        for item in self.added_menu_items:
            try:
                self.remove_menu_item(item)
            except Exception as e:
                log(f"[{__id__}] Failed to remove menu item {item}: {e}")
                failed.append(item)
        self.added_menu_items = failed

    def _plugin_has_settings(self, plugin_id):
        return self.plugin_info_cache.get(plugin_id, {}).get("has_settings", False)

    def _get_plugin_commands(self, plugin_id):
        return self.plugin_info_cache.get(plugin_id, {}).get("commands", [])

    def _plugin_has_commands(self, plugin_id):
        return bool(self._get_plugin_commands(plugin_id))

    def _plugin_is_elyx(self, plugin_id, plugin_obj=None):
        info = self.plugin_info_cache.get(plugin_id)
        if info is not None and "is_elyx" in info:
            return info.get("is_elyx", False)

        # кэша ещё нет (свежепоставленный плагин) - смотрим прямо на файл, без похода на диск
        if plugin_obj is None:
            plugin_obj = self._get_plugin_obj(plugin_id)
        if plugin_obj and hasattr(plugin_obj, "file"):
            try:
                path = plugin_obj.file.getAbsolutePath()
                if path:
                    return path.endswith(ELYX_EXTS)
            except Exception as e:
                log(f"[{__id__}] Failed to resolve file for elyx check {plugin_id}: {e}")
        return False

    def _get_ui_context(self):
        fragment = get_last_fragment()
        if not fragment:
            return None
        return fragment.getContext() or fragment.getParentActivity()

    def _show_plugin_action_dialog(self, plugin_id, plugin_name):
        def action():
            context = self._get_ui_context()
            if not context:
                return

            plugin_obj = self._get_plugin_obj(plugin_id)
            if not plugin_obj:
                return

            builder = AlertDialogBuilder(context)
            builder.set_title(plugin_name)
            is_enabled = self._is_plugin_enabled(plugin_obj)
            is_elyx = self._plugin_is_elyx(plugin_id, plugin_obj)

            actions = []
            if not is_elyx and self._plugin_has_settings(plugin_id) and is_enabled:
                actions.append(("settings", localise("DIALOG_ACTION_SETTINGS")))

            if not is_elyx and self._plugin_has_commands(plugin_id):
                actions.append(("show_commands", localise("DIALOG_ACTION_SHOW_COMMANDS")))

            if is_enabled:
                actions.append(("disable", localise("DIALOG_ACTION_DISABLE")))
            else:
                actions.append(("enable", localise("DIALOG_ACTION_ENABLE")))

            actions.append(("restart", localise("DIALOG_ACTION_RESTART")))

            if not is_elyx:
                actions.extend([
                    ("delete", localise("DIALOG_ACTION_DELETE")),
                    ("share", localise("DIALOG_ACTION_SHARE")),
                    ("open_with", localise("DIALOG_ACTION_OPEN_WITH"))
                ])

            items = [text for _, text in actions]

            handlers = {
                "settings": lambda: self._open_specific_settings(plugin_id),
                "show_commands": lambda: self._show_plugin_commands_dialog(plugin_id, plugin_name),
                "disable": lambda: self._disable_plugin(plugin_id, plugin_name),
                "enable": lambda: self._enable_plugin(plugin_id, plugin_name),
                "restart": lambda: self._restart_plugin(plugin_id, plugin_name),
                "delete": lambda: self._delete_plugin_with_undo(plugin_id, plugin_name),
                "share": lambda: self._share_plugin(plugin_id),
                "open_with": lambda: self._open_plugin_with(plugin_id),
            }

            def on_item_click(dialog, which):
                handler = handlers.get(actions[which][0])
                if handler:
                    handler()
                dialog.dismiss()

            builder.set_items(items, on_item_click)
            builder.show()

        self._run_ui_action(action, "Error building action dialog")

    def _show_plugin_commands_dialog(self, plugin_id, plugin_name):
        def action():
            commands = self._get_plugin_commands(plugin_id)
            if not commands:
                BulletinHelper.show_info(localise("INFO_NO_COMMANDS_FOUND"))
                return

            context = self._get_ui_context()
            if not context:
                return

            builder = AlertDialogBuilder(context)
            builder.set_title(localise("DIALOG_COMMANDS_TITLE", plugin_name))

            commands_text = "\n".join(commands)
            builder.set_message(commands_text)

            builder.set_positive_button("OK", lambda d, w: d.dismiss())
            builder.show()

        self._run_ui_action(action, "Error showing commands dialog", notify_on_error=False)

    def _open_settings_or_show_bulletin(self, plugin_id):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj:
            return

        if not self._plugin_has_settings(plugin_id):
            BulletinHelper.show_info(localise("PLUGIN_HAS_NO_SETTINGS"))
            return

        if not self._is_plugin_enabled(plugin_obj):
            plugin_name = self._get_plugin_display_name(plugin_obj, plugin_id)
            BulletinHelper.show_info(localise("PLUGIN_DISABLED", plugin_name))
            return

        self._open_specific_settings(plugin_id)

    def _toggle_plugin_state(self, plugin_id, plugin_name):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj:
            return

        if self._is_plugin_enabled(plugin_obj):
            self._disable_plugin(plugin_id, plugin_name)
        else:
            self._enable_plugin(plugin_id, plugin_name)

    def _open_specific_settings(self, plugin_id):
        def action():
            plugin_obj = self._get_plugin_obj(plugin_id)
            if plugin_obj:
                fragment = get_last_fragment()
                if fragment:
                    fragment.presentFragment(PluginSettingsActivity(plugin_obj))

        self._run_ui_action(action, "Error opening settings", notify_on_error=False)

    def _open_plugins_activity(self):
        def action():
            fragment = get_last_fragment()
            if fragment:
                fragment.presentFragment(PluginsActivity())

        self._run_ui_action(action, "Failed to open PluginsActivity", notify_on_error=False)

    def _set_plugin_enabled_locked(self, plugin_id, enabled):
        controller = PluginsController.getInstance()

        try:
            controller.setPluginEnabled(plugin_id, enabled, None)
        except Exception as e:
            log(f"[{__id__}] controller.setPluginEnabled failed for {plugin_id}, falling back: {e}")

        # сука этот апи пиздит что сделал — перечитываем реестр после каждой попытки
        plugin_obj = controller.plugins.get(plugin_id)
        if plugin_obj and self._is_plugin_enabled(plugin_obj) == enabled:
            return True

        try:
            if plugin_obj:
                plugin_obj.setEnabled(enabled)
        except Exception as e:
            log(f"[{__id__}] plugin_obj.setEnabled({enabled}) fallback failed for {plugin_id}: {e}")

        plugin_obj = controller.plugins.get(plugin_id)
        if plugin_obj and self._is_plugin_enabled(plugin_obj) == enabled:
            return True

        return False

    @safe(default=False, ctx=lambda plugin_id, enabled: plugin_id, notify=False)
    def _set_plugin_enabled_silent(self, plugin_id, enabled):
        # лочим на конкретный plugin_id, чтобы enable/disable/restart на одном и том же плагине
        # не могли выполниться внахлёст друг на друга - гонка состояний иначе неизбежна
        with self._get_plugin_lock(plugin_id):
            return self._set_plugin_enabled_locked(plugin_id, enabled)

    def _submit(self, task, label="task"):
        executor = self._executor
        if executor is None:
            log(f"[{__id__}] Executor is gone, skipping {label}")
            return False
        try:
            executor.submit(task)
            return True
        except RuntimeError as e:
            log(f"[{__id__}] Executor rejected {label}: {e}")
            return False

    def _set_plugin_enabled(self, plugin_id, enabled, success_key, error_key, plugin_name):
        def action():
            try:
                success = self._set_plugin_enabled_silent(plugin_id, enabled)

                if success:
                    self._notify("success", localise(success_key, plugin_name))
                    self._schedule_cache_rebuild(delay=0.5)
                else:
                    log(f"[{__id__}] Failed to set enabled={enabled} for {plugin_id}")
                    self._notify("error", localise(error_key, plugin_name))
            except Exception as e:
                log(f"[{__id__}] Toggle task for {plugin_id} died: {e}")

        self._submit(action, f"toggle:{plugin_id}")

    def _disable_plugin(self, plugin_id, plugin_name):
        self._set_plugin_enabled(
            plugin_id, False, "PLUGIN_DISABLED", "PLUGIN_DISABLE_ERROR", plugin_name
        )

    def _enable_plugin(self, plugin_id, plugin_name):
        self._set_plugin_enabled(
            plugin_id, True, "PLUGIN_ENABLED", "PLUGIN_ENABLE_ERROR", plugin_name
        )

    def _restart_plugin(self, plugin_id, plugin_name):
        self._notify("info", localise("RESTART_LAUNCHED"))

        def action():
            try:
                # оба шага под одним и тем же плагин-локом - снаружи никто не втиснется
                # между disable и enable, иначе поймаем гонку с обычным toggle
                with self._get_plugin_lock(plugin_id):
                    disabled = self._set_plugin_enabled_locked(plugin_id, False)
                    enabled = self._set_plugin_enabled_locked(plugin_id, True)

                if disabled and enabled:
                    self._notify("success", localise("RESTART_SUCCESSFUL"))
                    self._schedule_cache_rebuild(delay=0.5)
                else:
                    log(
                        f"[{__id__}] Restart incomplete for {plugin_id}: "
                        f"disabled={disabled} enabled={enabled}"
                    )
                    self._notify("error", localise("PLUGIN_GENERIC_ERROR"))
            except Exception:
                self._handle_error("Error restarting plugin", "PLUGIN_GENERIC_ERROR")

        if not self._submit(action, f"restart:{plugin_id}"):
            self._notify("error", localise("PLUGIN_GENERIC_ERROR"))

    def _delete_plugin_with_undo(self, plugin_id, plugin_name):
        plugin_obj = self._get_plugin_obj(plugin_id)
        was_enabled = self._is_plugin_enabled(plugin_obj) if plugin_obj else False

        # выключаем прямо тут, как только тапнули "Удалить" — до того как юзер вообще увидел бюллетень с Undo,
        # а не после его истечения. так быстрее, но по факту плагин уже мёртв ещё до окна отмены, не просто помечен
        predelete_future = None
        if was_enabled:
            executor = self._executor
            if executor is not None:
                try:
                    predelete_future = executor.submit(
                        lambda: self._set_plugin_enabled_silent(plugin_id, False)
                    )
                except RuntimeError as e:
                    log(f"[{__id__}] Executor rejected predelete:{plugin_id}: {e}")

        def perform_delete():
            self._delete_plugin(plugin_id, plugin_name)

        def undo_callback():
            if was_enabled:
                def undo_task():
                    if predelete_future is not None:
                        try:
                            predelete_future.result(timeout=10)
                        except Exception as e:
                            log(f"[{__id__}] predelete wait failed for {plugin_id}: {e}")
                    self._set_plugin_enabled_silent(plugin_id, True)
                self._submit(undo_task, f"undo:{plugin_id}")
            BulletinHelper.show_info(localise("ACTION_UNDONE"))

        bulletin_text = localise("PLUGIN_WILL_BE_DELETED", plugin_name)
        BulletinHelper.show_undo(
            text=bulletin_text,
            on_action=perform_delete,
            on_undo=undo_callback
        )

    def _plugin_still_exists(self, plugin_id):
        if self._get_plugin_obj(plugin_id) is not None:
            return True
        path = self._find_plugin_path(plugin_id)
        return path is not None and os.path.exists(path)

    def _delete_plugin(self, plugin_id, plugin_name):
        def delete_task():
            try:
                controller = PluginsController.getInstance()
                plugin_obj = controller.plugins.get(plugin_id)
                plugin_path = self._find_plugin_path(plugin_id)

                if plugin_obj and self._is_plugin_enabled(plugin_obj):
                    try:
                        plugin_obj.setEnabled(False)
                    except Exception as e:
                        log(f"[{__id__}] setEnabled(False) failed for {plugin_id}: {e}")

                # что за хуйня с sdk, deletePlugin выкидывает плагин из реестра но на диске он блять продолжает существовать
                try:
                    controller.deletePlugin(plugin_id)
                except Exception as e:
                    log(f"[{__id__}] deletePlugin(id) failed for {plugin_id}: {e}")

                deleted = not self._plugin_still_exists(plugin_id)

                if not deleted:
                    deleted = self._force_remove_plugin_file(plugin_id, plugin_path)

                if deleted:
                    self._notify("success", localise("PLUGIN_DELETED_SUCCESS", plugin_name))
                    self._schedule_cache_rebuild(delay=0.5)
                else:
                    self._notify("error", localise("PLUGIN_DELETE_ERROR", plugin_name))
            except Exception:
                self._handle_error("Error in _delete_plugin", "PLUGIN_DELETE_ERROR", (plugin_name,))

        self._submit(delete_task, f"delete:{plugin_id}")

    def _is_path_inside_dir(self, path, directory):
        dir_with_sep = directory if directory.endswith(os.sep) else directory + os.sep
        return path == directory or path.startswith(dir_with_sep)

    def _force_remove_plugin_file(self, plugin_id, plugin_path):
        if not plugin_path:
            log(f"[{__id__}] No resolved path for {plugin_id}, cannot force-remove")
            return False
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return False

            real_plugins_dir = os.path.realpath(plugins_dir)
            real_path = os.path.realpath(plugin_path)
            if not self._is_path_inside_dir(real_path, real_plugins_dir):
                log(f"[{__id__}] Refusing to remove {plugin_path}: outside plugins dir")
                return False

            if not os.path.isfile(real_path):
                log(f"[{__id__}] {real_path} is not a regular file, skipping")
                return False

            # всё что не py, не plugin и не elyx-архив признать иноагентами
            if os.path.islink(plugin_path) or not real_path.endswith((".py", ".plugin") + ELYX_EXTS):
                log(f"[{__id__}] Refusing to remove {plugin_path}: symlink or not a plugin file")
                return False

            os.remove(real_path)
            log(f"[{__id__}] Manually removed plugin file: {real_path}")

            controller = PluginsController.getInstance()
            try:
                if hasattr(controller.plugins, "remove"):
                    controller.plugins.remove(plugin_id)
                elif isinstance(controller.plugins, dict):
                    controller.plugins.pop(plugin_id, None)
            except Exception as e:
                log(f"[{__id__}] Registry cleanup after manual delete failed for {plugin_id}: {e}")

            return not self._plugin_still_exists(plugin_id)
        except Exception as e:
            log(f"[{__id__}] Manual file removal failed for {plugin_id}: {e}")
            return False

    def _find_plugin_path(self, plugin_id):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if plugin_obj and hasattr(plugin_obj, "file"):
            try:
                java_path = plugin_obj.file.getAbsolutePath()
                if java_path and os.path.isfile(java_path):
                    return java_path
            except Exception as e:
                log(
                    f"[{__id__}] plugin_obj.file.getAbsolutePath() failed for {plugin_id}, "
                    f"falling back to directory scan: {e}"
                )

        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return None

            for filename in os.listdir(plugins_dir):
                is_elyx = filename.endswith(ELYX_EXTS)
                if not is_elyx and not filename.endswith((".py", ".plugin")):
                    continue

                file_path = os.path.join(plugins_dir, filename)
                try:
                    if is_elyx:
                        if os.path.getsize(file_path) > MAX_ELYX_ARCHIVE_SIZE:
                            log(f"[{__id__}] Skipping {filename}: too big to scan")
                            continue
                        if self._get_elyx_plugin_id(file_path) == plugin_id:
                            return file_path
                        continue

                    if os.path.getsize(file_path) > MAX_FILE_SIZE:
                        log(f"[{__id__}] Skipping {filename}: too big to scan")
                        continue

                    with open(file_path, "r", encoding="utf-8-sig") as f:
                        content = f.read()
                    id_from_file = self._get_id_from_file_content(content)
                    if id_from_file == plugin_id:
                        return file_path
                except Exception as e:
                    log(
                        f"[{__id__}] Skipping unreadable file {filename} "
                        f"while searching for {plugin_id}: {e}"
                    )
                    continue
        except Exception as e:
            log(f"[{__id__}] Directory scan for {plugin_id} failed: {e}")
        return None

    def _resolve_plugin_file_or_notify(self, plugin_id):
        plugin_path = self._find_plugin_path(plugin_id)
        if not plugin_path:
            self._notify("error", localise("SHARE_ERROR_NOT_FOUND"))
            return None
        return plugin_path

    def _resolve_share_mime(self, filename):
        if filename.endswith(ELYX_EXTS):
            return "application/zip"
        return "text/plain"

    def _staging_roots(self):
        roots = []
        app_context = ApplicationLoader.applicationContext
        if not app_context:
            return roots
        for getter in ("getExternalCacheDir", "getCacheDir", "getFilesDir"):
            try:
                root = getattr(app_context, getter)()
            except Exception as e:
                log(f"[{__id__}] {getter} unavailable for staging: {e}")
                continue
            if root:
                roots.append(root)
        return roots

    def _stage_plugin_copy(self, plugin_path, root, rename_py_to_plugin=False):
        try:
            staged_dir = File(root, QUICKSETTINGS_TEMP_DIR)
            if not staged_dir.exists() and not staged_dir.mkdirs():
                return None

            filename = File(plugin_path).getName()
            if rename_py_to_plugin and filename.endswith(".py"):
                filename = filename[:-3] + ".plugin"

            staged_file = File(staged_dir, filename)
            staged_path = staged_file.getAbsolutePath()
            with open(plugin_path, "rb") as f_in, open(staged_path, "wb") as f_out:
                while True:
                    chunk = f_in.read(65536)
                    if not chunk:
                        break
                    f_out.write(chunk)
            return staged_file
        except Exception as e:
            log(f"[{__id__}] Staging {plugin_path} failed: {e}")
            return None

    def _copy_plugin_to_external_cache(self, plugin_path, rename_py_to_plugin=False):
        for root in self._staging_roots():
            staged_file = self._stage_plugin_copy(
                plugin_path, root, rename_py_to_plugin
            )
            if staged_file:
                return staged_file
        return None

    def _stage_for_provider(self, context, plugin_path):
        authority = context.getPackageName() + ".provider"
        for root in self._staging_roots():
            staged_file = self._stage_plugin_copy(plugin_path, root)
            if not staged_file:
                continue
            try:
                uri = FileProvider.getUriForFile(context, authority, staged_file)
                return staged_file, uri
            except Exception as e:
                log(f"[{__id__}] Provider has no root for {root}: {e}")
                self._delete_staged_file(staged_file.getAbsolutePath())
        return None, None

    def _delete_staged_file(self, path):
        try:
            if os.path.isfile(path):
                os.remove(path)
        except Exception as e:
            log(f"[{__id__}] Failed to drop staged file {path}: {e}")

    def _schedule_staged_cleanup(self, path, delay=None):
        if delay is None:
            delay = self._get_staged_cleanup_timeout()
        timer = threading.Timer(delay, self._run_staged_cleanup, args=(path,))
        timer.args = (path, timer)
        timer.daemon = True
        with self._staged_lock:
            self._staged_timers.add(timer)
        timer.start()

    def _run_staged_cleanup(self, path, timer):
        try:
            self._delete_staged_file(path)
        finally:
            with self._staged_lock:
                self._staged_timers.discard(timer)

    def _cancel_staged_timers(self):
        with self._staged_lock:
            timers = list(self._staged_timers)
            self._staged_timers.clear()
        for t in timers:
            self._cancel_timer(t)

    @safe(msg="Temp dir cleanup failed", notify=False)
    def _clear_temp_dir(self):
        # мистер пропер пиздабол нихуя не моет пол,но внешний кэш чистит xD
        for root in self._staging_roots():
            temp_dir = os.path.join(root.getAbsolutePath(), QUICKSETTINGS_TEMP_DIR)
            if not os.path.isdir(temp_dir):
                continue
            for name in os.listdir(temp_dir):
                self._delete_staged_file(os.path.join(temp_dir, name))

    def _share_plugin(self, plugin_id):
        fragment = get_last_fragment()
        if not fragment:
            return

        try:
            dialog_id = fragment.getDialogId()
            account_instance = get_account_instance()
        except Exception:
            self._handle_error("Error sharing plugin", "SHARE_ERROR_GENERAL")
            return

        def stage_and_send():
            try:
                plugin_path = self._resolve_plugin_file_or_notify(plugin_id)
                if not plugin_path:
                    return

                staged_file = self._copy_plugin_to_external_cache(
                    plugin_path, rename_py_to_plugin=True
                )
                if not staged_file:
                    self._notify("error", localise("SHARE_ERROR_GENERAL"))
                    return
                external_path = staged_file.getAbsolutePath()

                mime = self._resolve_share_mime(external_path)

                def send():
                    SendMessagesHelper.prepareSendingDocument(
                        account_instance, external_path, external_path, None,
                        None, mime, dialog_id,
                        None, None, None, None, None,
                        True, 0, None, None, 0, False
                    )

                run_on_ui_thread(send)

                # тг файл впитал, через настроенный тайм-аут мистер пропер сюда тоже придёт
                self._schedule_staged_cleanup(external_path)
            except Exception:
                self._handle_error("Error sharing plugin", "SHARE_ERROR_GENERAL")

        if not self._submit(stage_and_send, f"share:{plugin_id}"):
            self._notify("error", localise("SHARE_ERROR_GENERAL"))

    def _open_plugin_with(self, plugin_id):
        context = self._get_ui_context()
        if not context:
            return

        def stage_and_open():
            try:
                plugin_path = self._resolve_plugin_file_or_notify(plugin_id)
                if not plugin_path:
                    return

                staged_file, uri = self._stage_for_provider(context, plugin_path)
                if not staged_file:
                    self._notify("error", localise("SHARE_ERROR_GENERAL"))
                    return

                def open_chooser():
                    intent = Intent(Intent.ACTION_VIEW)
                    intent.setDataAndType(uri, self._resolve_share_mime(staged_file.getAbsolutePath()))
                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                    chooser = Intent.createChooser(intent, localise("OPEN_WITH_TITLE"))
                    context.startActivity(chooser)

                run_on_ui_thread(open_chooser)
                self._schedule_staged_cleanup(staged_file.getAbsolutePath())
            except Exception:
                self._handle_error("Error in _open_plugin_with", "SHARE_ERROR_GENERAL")

        if not self._submit(stage_and_open, f"open_with:{plugin_id}"):
            self._notify("error", localise("SHARE_ERROR_GENERAL"))