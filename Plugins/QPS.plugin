DEBUG_LOGCAT_RE = re.compile(r"qps|quicksettings|elyx|\.eaf|PluginsController|pysdk|PyObject|chaquopy|AndroidRuntime|FATAL", re.I)
DEBUG_REDACT_RES = (
    (re.compile(
        r"(?i)([\"']?[\w.\-]*(?:token|passw(?:or)?d|pwd|secret|api[_\-]?(?:key|hash)|authorization|auth[_\-]?key|private[_\-]?key|cookie)[\w.\-]*[\"']?\s*[=:]\s*)"
        r"(?:([\"'])[^\"']*\2|.+)"
    ), lambda m: m.group(1) + (m.group(2) + "<redacted>" + m.group(2) if m.group(2) else "<redacted>")),
    (re.compile(r"(?i)\bBearer\s+\S+"), "Bearer <redacted>"),
    (re.compile(r"\b\d{6,10}:[\w-]{30,}\b"), "<bot-token>"),
    (re.compile(r"(?<![\w.])\+\d[\d\s().-]{8,}\d"), "<phone>"),
    (re.compile(r"(?<![\w.:+-])[78]\d{10}(?![\w.])"), "<phone>"),
    (re.compile(r"\b[A-Za-z0-9_\-]{40,}\b"), "<long-key>"),
)


def redact_text(text):
    for pattern, repl in DEBUG_REDACT_RES:
        text = pattern.sub(repl, text)
    return text

DEBUG_HOOK_NAME_RE = re.compile(r"(load|install|delet|remov|enabl|disabl|elyx|archive|extract|register|validat|pars|updat)", re.I)
DEBUG_HOOK_EXCLUDE_RE = re.compile(r"^(get|is|has)", re.I)
