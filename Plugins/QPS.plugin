def localise(key: str, *args) -> str:
    lang = Locale.getDefault().getLanguage()
    locale_dict = getattr(Locales, lang, Locales.default)
    text = locale_dict.get(key, Locales.default.get(key, key))
    return text.format(*args) if args else text

MENU_LOCATION_CHAT = 0
MENU_LOCATION_DRAWER = 1
MENU_LOCATION_BOTH = 2

ACTION_OPEN_SETTINGS = 0
ACTION_TOGGLE_STATE = 1
ACTION_OPEN_MENU = 2

class QuickCommandExtractor:
    class _CommandVisitor(ast.NodeVisitor):
   # if u see this, i have rlly br0ken vision xDD
        VALID_COMMAND_RE = re.compile(r"^\.[\w-]+$")

        def __init__(self):
            self.commands = set()
            self.variables = {}

        def _resolve_node_value(self, node: ast.AST) -> Optional[str]:
            if isinstance(node, ast.Constant):
                return str(node.value)
            if isinstance(node, ast.Name) and node.id in self.variables:
                return str(self.variables[node.id])
            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
                left = self._resolve_node_value(node.left)
                right = self._resolve_node_value(node.right)
                if left is not None and right is not None:
                    return left + right
            return None

        def visit_Assign(self, node: ast.Assign):
            if len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
                try:
                    self.variables[node.targets[0].id] = ast.literal_eval(node.value)
                except (ValueError, TypeError, AttributeError, SyntaxError):
                    pass
            self.generic_visit(node)

        def _add_command(self, value: Any):
            if isinstance(value, str):
                command = value.strip().split(" ")[0]
                if self.VALID_COMMAND_RE.match(command):
                    self.commands.add(command)

        def visit_Compare(self, node: ast.Compare):
            if isinstance(node.ops[0], (ast.Eq, ast.NotEq, ast.In)):
                for item in [node.left] + node.comparators:
                    value = self._resolve_node_value(item)
                    if value:
                        self._add_command(value)
                    elif isinstance(item, (ast.List, ast.Tuple)):
                        for element in item.elts:
                            val = self._resolve_node_value(element)
                            if val:
                                self._add_command(val)
            self.generic_visit(node)

        def visit_Call(self, node: ast.Call):
            if isinstance(node.func, ast.Attribute) and node.func.attr == 'startswith':
                if node.args:
                    value = self._resolve_node_value(node.args[0])
                    if value:
                        self._add_command(value)
            self.generic_visit(node)

class PluginStateChangeHook(XposedHook):
    def __init__(self, plugin_instance):
        super().__init__()
        self.plugin = plugin_instance

    def after_hooked_method(self, param):
        self.plugin._schedule_cache_rebuild()

class QuickSettingsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.added_menu_items: List[MenuItemData] = []
        self.hooks: List[object] = []
        self.update_timer: Optional[threading.Timer] = None
        self.plugin_info_cache: Dict[str, Dict] = {}
        self.cache_path: Optional[str] = None
        self.rebuild_timer: Optional[threading.Timer] = None

    def create_settings(self):
        return [
            Header(text=localise("HEADER_MENU_LOCATION")),
            Selector(
                key="menu_location",
                text=localise("SELECTOR_SHOW_MENU_IN"),
                items=localise("SELECTOR_ITEMS_MENU_LOCATION"),
                default=MENU_LOCATION_BOTH,
                on_change=lambda _: self._schedule_menu_update(delay=0)
            ),
            Header(text=localise("HEADER_PLUGINS_SHORTCUT")),
            Switch(
                key="show_chat_plugins_shortcut",
                text=localise("SWITCH_SHOW_CHAT_PLUGINS_SHORTCUT"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0)
            ),
            Header(text=localise("HEADER_CHAT_MENU_ACTION")),
            Selector(
                key="chat_menu_action",
                text=localise("SELECTOR_CHAT_MENU_ACTION"),
                items=localise("SELECTOR_ITEMS_CHAT_MENU_ACTION"),
                default=ACTION_OPEN_MENU,
                on_change=lambda _: self._schedule_menu_update(delay=0)
            ),
            Header(text=localise("HEADER_PLUGIN_VISIBILITY")),
            Switch(
                key="show_plugins_without_settings",
                text=localise("SWITCH_SHOW_PLUGINS_WITHOUT_SETTINGS"),
                default=False,
                on_change=lambda _: self._schedule_menu_update(delay=0)
            ),
            Switch(
                key="show_disabled_plugins",
                text=localise("SWITCH_SHOW_DISABLED_PLUGINS"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0)
            ),
            Header(text=localise("HEADER_CACHE_MANAGEMENT")),
            Text(
                text=localise("SETTINGS_REBUILD_CACHE_BUTTON"),
                icon="msg_update",
                on_click=self._handle_rebuild_cache_click
            ),
            Divider(text=localise("SETTINGS_REBUILD_CACHE_SUBTEXT"))
        ]

    def _handle_rebuild_cache_click(self, view):
        BulletinHelper.show_info(localise("INFO_CACHE_REBUILDING"))
        self._schedule_cache_rebuild(delay=0.1, show_notification=True)

    def on_plugin_load(self):
        self._init_cache_system()
        self._load_cache()
        self._schedule_cache_rebuild(delay=2.0)
        self._schedule_menu_update(delay=0)
        self._apply_hooks()

    def on_plugin_unload(self):
        self._remove_menu_items()
        self._remove_hooks()
        if self.update_timer: self.update_timer.cancel()
        if self.rebuild_timer: self.rebuild_timer.cancel()

    def _init_cache_system(self):
        try:
            context = ApplicationLoader.applicationContext
            if not context:
                return
            base_dir = context.getFilesDir()
            if not base_dir:
                return


            cache_dir = File(base_dir, QUICKSETTINGS_CACHE_DIR)
            if not cache_dir.exists():
                cache_dir.mkdirs()


            self.cache_path = File(cache_dir, CACHE_FILENAME).getAbsolutePath()
        except Exception as e:
            log(f"[{__id__}] Failed to initialize cache system: {e}")

    def _load_cache(self) -> bool:
        if not getattr(self, "cache_path", None) or not os.path.exists(self.cache_path):
            return False
        try:
            with open(self.cache_path, "r", encoding="utf-8") as f:
                self.plugin_info_cache = json.load(f)
            log(f"[{__id__}] Cache loaded successfully with {len(self.plugin_info_cache)} entries.")
            return True
        except Exception as e:
            log(f"[{__id__}] Failed to load cache: {e}. Rebuilding.")
            return False

    def _rebuild_cache_and_update_menu(self, show_notification: bool = False):
        log(f"[{__id__}] Starting cache rebuild.")
        if not getattr(self, "cache_path", None):
            self._init_cache_system()


        if not self.cache_path:
            log(f"[{__id__}] Cache path not initialized. Aborting rebuild.")
            return

        cache_data = {}
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return

            extractor = QuickCommandExtractor()
            for filename in os.listdir(plugins_dir):
                if not filename.endswith(('.py', '.plugin')):
                    continue
                file_path = os.path.join(plugins_dir, filename)
                try:
                    with open(file_path, "r", encoding="utf-8") as f:
                        content = f.read()


                    plugin_id = self._get_id_from_file_content(content)
                    if not plugin_id:
                        continue

                    has_settings = "def create_settings(self)" in content


                    try:
                        visitor = extractor._CommandVisitor()
                        tree = ast.parse(content, filename=filename)
                        visitor.visit(tree)
                        commands = sorted(list(visitor.commands))
                    except Exception as ast_err:
                        log(f"[{__id__}] AST parse failed for {filename}: {ast_err}")
                        commands = []

                    cache_data[plugin_id] = {
                        "has_settings": has_settings,
                        "commands": commands
                    }
                except Exception as inner_e:
                    log(f"[{__id__}] Skipped {filename}: {inner_e}")
                    continue


            with open(self.cache_path, "w", encoding="utf-8") as f:
                json.dump(cache_data, f)


            log(f"[{__id__}] Cache rebuilt and saved with {len(cache_data)} entries.")


            if self._load_cache():
                self._schedule_menu_update(delay=0)
                if show_notification:
                    run_on_ui_thread(lambda: BulletinHelper.show_success(localise("INFO_CACHE_REBUILT_SUCCESS")))

        except Exception as e:
            log(f"[{__id__}] Error during cache rebuild: {e}")
            if show_notification:
                run_on_ui_thread(lambda: BulletinHelper.show_error(localise("PLUGIN_GENERIC_ERROR")))

    def _schedule_cache_rebuild(self, delay: float = 1.0, show_notification: bool = False):
        if self.rebuild_timer:
            self.rebuild_timer.cancel()
        self.rebuild_timer = threading.Timer(delay, self._rebuild_cache_and_update_menu, args=(show_notification,))
        self.rebuild_timer.start()

    def _apply_hooks(self):
        if self.hooks:
            return
        try:
            controller_class = PluginsController.getClass()
            hook_handler = PluginStateChangeHook(self)


            methods_to_hook = [
                ("loadPluginFromFile", String, Utilities.Callback),
                ("setPluginEnabled", String, Boolean.TYPE, Utilities.Callback),
                ("deletePlugin", String),
            ]
            for method_name, *arg_types in methods_to_hook:
                try:
                    target = controller_class.getDeclaredMethod(method_name, *arg_types)
                    hook = self.hook_method(target, hook_handler)
                    self.hooks.append(hook)
                except Exception as e:
                    log(f"[{__id__}] Failed to hook {method_name}: {e}")
        except Exception as e:
            log(f"[{__id__}] Failed to apply hooks: {e}")

    def _remove_hooks(self):
        for hook in self.hooks:
            try: self.unhook_method(hook)
            except Exception: pass
        self.hooks.clear()

    def _schedule_menu_update(self, delay: float = 1.0):
        if self.update_timer:
            self.update_timer.cancel()


        self.update_timer = threading.Timer(delay, self._update_menu_items)
        self.update_timer.start()

    def _get_id_from_file_content(self, content: str) -> Optional[str]:
        match = re.search(r"__id__\s*=\s*['\"]([^'\"]+)['\"]", content)
        return match.group(1) if match else None

    def _is_plugin_enabled(self, plugin_obj) -> bool:
        try:
            return getattr(plugin_obj, "enabled", False) or (plugin_obj.isEnabled() if hasattr(plugin_obj, 'isEnabled') else False)
        except Exception:
            return False

    def _get_plugin_obj(self, plugin_id: str):
        try:
            return PluginsController.getInstance().plugins.get(plugin_id)
        except Exception:
            return None

    def _get_plugin_display_name(self, plugin_obj, fallback_id: str) -> str:
        try:
            return str(plugin_obj.name)
        except AttributeError:
            return str(plugin_obj.getName()) if hasattr(plugin_obj, 'getName') else fallback_id

    def _get_displayable_plugins(self) -> List[tuple]:
        plugins_to_show = []
        show_without_settings = self.get_setting("show_plugins_without_settings", False)
        show_disabled = self.get_setting("show_disabled_plugins", True)


        try:
            plugins_map = PluginsController.getInstance().plugins


            entries = []
            if hasattr(plugins_map, 'entrySet'):
                java_iterator = plugins_map.entrySet().iterator()
                while java_iterator.hasNext():
                    entry = java_iterator.next()
                    entries.append((str(entry.getKey()), entry.getValue()))
            elif isinstance(plugins_map, dict):
                entries = list(plugins_map.items())

            for plugin_id, plugin_object in entries:
                if plugin_id == __id__:
                    continue

                try:
                    is_enabled = self._is_plugin_enabled(plugin_object)
                    p_name = self._get_plugin_display_name(plugin_object, plugin_id)

                    if not (is_enabled or show_disabled):
                        continue

                    if not show_without_settings:
                        if not self._plugin_has_settings(plugin_id) and not self._plugin_has_commands(plugin_id):
                            continue


                    plugins_to_show.append((plugin_id, str(p_name), is_enabled, plugin_object))
                except Exception as e:
                    log(f"[{__id__}] Error processing plugin {plugin_id}: {e}")


        except Exception as e:
            log(f"[{__id__}] Error getting displayable plugins: {e}")

        return sorted(plugins_to_show, key=lambda item: item[1])

    def _update_menu_items(self):
        def action():
            self._remove_menu_items()


            location = self.get_setting("menu_location", MENU_LOCATION_BOTH)
            displayable_plugins = self._get_displayable_plugins()
            chat_action = self.get_setting("chat_menu_action", ACTION_OPEN_MENU)

            if location in [MENU_LOCATION_CHAT, MENU_LOCATION_BOTH]:
                if displayable_plugins:
                    for p_id, p_name, is_enabled, plugin_obj in displayable_plugins:
                        if chat_action == ACTION_OPEN_MENU:
                            on_click_action = lambda ctx, pid=p_id, pname=p_name: self._show_plugin_action_dialog(pid, pname)
                        elif chat_action == ACTION_OPEN_SETTINGS:
                            on_click_action = lambda ctx, pid=p_id: self._open_settings_or_show_bulletin(pid)
                        elif chat_action == ACTION_TOGGLE_STATE:
                            on_click_action = lambda ctx, pid=p_id, pname=p_name: self._toggle_plugin_state(pid, pname)
                        else:
                            on_click_action = lambda ctx, pid=p_id, pname=p_name: self._show_plugin_action_dialog(pid, pname)


                        icon = "msg_select_solar" if is_enabled else "msg_block_solar"


                        item = self.add_menu_item(MenuItemData(
                            menu_type=MenuItemType.CHAT_ACTION_MENU,
                            text=p_name,
                            icon=icon,
                            priority=90,
                            on_click=on_click_action
                        ))
                        self.added_menu_items.append(item)

                if self.get_setting("show_chat_plugins_shortcut", True):
                    item = self.add_menu_item(MenuItemData(
                        menu_type=MenuItemType.CHAT_ACTION_MENU,
                        text="exteraGram > Plugins",
                        icon="msg_plugins_solar",
                        priority=91,
                        on_click=lambda ctx: self._open_plugins_activity()
                    ))
                    self.added_menu_items.append(item)

            if location in [MENU_LOCATION_DRAWER, MENU_LOCATION_BOTH]:
                settings_item = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text=localise("TITLE_PLUGIN_SETTINGS"),
                    icon="msg_reorder",
                    priority=90,
                    on_click=lambda ctx: self._open_plugins_activity()
                ))
                self.added_menu_items.append(settings_item)

        run_on_ui_thread(action)

    def _remove_menu_items(self):
        for item in self.added_menu_items:
            try:
                self.remove_menu_item(item)
            except Exception:
                pass
        self.added_menu_items.clear()

    def _plugin_has_settings(self, plugin_id: str) -> bool:
        return self.plugin_info_cache.get(plugin_id, {}).get('has_settings', False)

    def _plugin_has_commands(self, plugin_id: str) -> bool:
        return bool(self.plugin_info_cache.get(plugin_id, {}).get('commands', []))

    def _show_plugin_action_dialog(self, plugin_id: str, plugin_name: str):
        def action():
            try:
                fragment = get_last_fragment()
                if not fragment: return
                context = fragment.getContext() or fragment.getParentActivity()
                if not context: return

                builder = AlertDialogBuilder(context)
                builder.set_title(plugin_name)


                plugin_obj = self._get_plugin_obj(plugin_id)
                if not plugin_obj: return

                is_enabled = self._is_plugin_enabled(plugin_obj)

                actions = []
                if self._plugin_has_settings(plugin_id) and is_enabled:
                    actions.append(("settings", localise("DIALOG_ACTION_SETTINGS")))


                if self._plugin_has_commands(plugin_id):
                    actions.append(("show_commands", localise("DIALOG_ACTION_SHOW_COMMANDS")))

                if is_enabled:
                    actions.append(("disable", localise("DIALOG_ACTION_DISABLE")))
                else:
                    actions.append(("enable", localise("DIALOG_ACTION_ENABLE")))

                actions.extend([
                    ("delete", localise("DIALOG_ACTION_DELETE")),
                    ("share", localise("DIALOG_ACTION_SHARE")),
                    ("open_with", localise("DIALOG_ACTION_OPEN_WITH"))
                ])

                items = [text for _, text in actions]

                def on_item_click(dialog, which):
                    action_key = actions[which][0]


                    if action_key == "settings":
                        self._open_specific_settings(plugin_id)
                    elif action_key == "show_commands":
                        self._show_plugin_commands_dialog(plugin_id, plugin_name)
                    elif action_key == "disable":
                        self._disable_plugin(plugin_id, plugin_name)
                    elif action_key == "enable":
                        self._enable_plugin(plugin_id, plugin_name)
                    elif action_key == "delete":
                        self._delete_plugin_with_undo(plugin_id, plugin_name)
                    elif action_key == "share":
                        self._share_plugin(plugin_id)
                    elif action_key == "open_with":
                        self._open_plugin_with(plugin_id)
                    dialog.dismiss()

                builder.set_items(items, on_item_click)
                builder.show()
            except Exception:
                BulletinHelper.show_error("QuickSettings: Error building action list")
        run_on_ui_thread(action)

    def _show_plugin_commands_dialog(self, plugin_id: str, plugin_name: str):
        def action():
            commands = self.plugin_info_cache.get(plugin_id, {}).get('commands', [])
            if not commands:
                BulletinHelper.show_info(localise("INFO_NO_COMMANDS_FOUND"))
                return


            try:
                fragment = get_last_fragment()
                if not fragment: return
                context = fragment.getContext() or fragment.getParentActivity()


                builder = AlertDialogBuilder(context)
                builder.set_title(localise("DIALOG_COMMANDS_TITLE", plugin_name))


                commands_text = "\n".join(commands)
                builder.set_message(commands_text)


                builder.set_positive_button("OK", lambda d, w: d.dismiss())
                builder.show()
            except Exception as e:
                log(f"[{__id__}] Error showing commands dialog: {e}")

        run_on_ui_thread(action)

    def _open_settings_or_show_bulletin(self, plugin_id: str):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj: return

        if not self._plugin_has_settings(plugin_id):
            BulletinHelper.show_info(localise("PLUGIN_HAS_NO_SETTINGS"))
            return


        if not self._is_plugin_enabled(plugin_obj):
            p_name = self._get_plugin_display_name(plugin_obj, plugin_id)
            BulletinHelper.show_info(localise("PLUGIN_DISABLED", p_name))
            return

        self._open_specific_settings(plugin_id)

    def _toggle_plugin_state(self, plugin_id: str, plugin_name: str):
        plugin_obj = self._get_plugin_obj(plugin_id)
        if not plugin_obj: return

        if self._is_plugin_enabled(plugin_obj):
            self._disable_plugin(plugin_id, plugin_name)
        else:
            self._enable_plugin(plugin_id, plugin_name)

    def _open_specific_settings(self, plugin_id: str):
        def action():
            try:
                java_plugin = self._get_plugin_obj(plugin_id)
                if java_plugin:
                    fragment = get_last_fragment()
                    if fragment:
                        fragment.presentFragment(PluginSettingsActivity(java_plugin))
            except Exception as e:
                log(f"[{__id__}] Error opening settings: {e}")


        run_on_ui_thread(action)

    def _open_plugins_activity(self):
        def action():
            try:
                get_last_fragment().presentFragment(PluginsActivity())
            except Exception:
                pass
        run_on_ui_thread(action)

    def _set_plugin_enabled_silent(self, plugin_id: str, enabled: bool) -> bool:
        try:
            controller = PluginsController.getInstance()
            try:
                controller.setPluginEnabled(plugin_id, enabled, None)
            except Exception:
                pass

            plugin_obj = controller.plugins.get(plugin_id)
            if plugin_obj and self._is_plugin_enabled(plugin_obj) == enabled:
                return True

            if plugin_obj and self._is_plugin_enabled(plugin_obj) != enabled:
                try:
                    plugin_obj.setEnabled(enabled)
                except Exception:
                    pass

            plugin_obj = controller.plugins.get(plugin_id)
            return bool(plugin_obj) and self._is_plugin_enabled(plugin_obj) == enabled
        except Exception:
            return False

    def _set_plugin_enabled(self, plugin_id: str, enabled: bool, success_key: str, error_key: str, plugin_name: str):
        def action():
            success = self._set_plugin_enabled_silent(plugin_id, enabled)


            if success:
                run_on_ui_thread(lambda: BulletinHelper.show_success(localise(success_key, plugin_name)))
                self._schedule_cache_rebuild(delay=0.5)
            else:
                log(f"[{__id__}] Failed to set enabled={enabled} for {plugin_id}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(localise(error_key, plugin_name)))

        threading.Thread(target=action).start()

    def _disable_plugin(self, plugin_id: str, plugin_name: str):
        self._set_plugin_enabled(plugin_id, False, "PLUGIN_DISABLED", "PLUGIN_DISABLE_ERROR", plugin_name)

    def _enable_plugin(self, plugin_id: str, plugin_name: str):
        self._set_plugin_enabled(plugin_id, True, "PLUGIN_ENABLED", "PLUGIN_ENABLE_ERROR", plugin_name)

    def _delete_plugin_with_undo(self, plugin_id: str, plugin_name: str):
        plugin_obj = self._get_plugin_obj(plugin_id)
        was_enabled = self._is_plugin_enabled(plugin_obj) if plugin_obj else False

        if was_enabled:
            self._set_plugin_enabled_silent(plugin_id, False)

        def perform_delete():
            self._delete_plugin(plugin_id, plugin_name)

        def undo_callback():
            if was_enabled:
                self._set_plugin_enabled_silent(plugin_id, True)
            BulletinHelper.show_info(localise("ACTION_UNDONE"))

        bulletin_text = localise("PLUGIN_WILL_BE_DELETED", plugin_name)
        BulletinHelper.show_undo(
            text=bulletin_text,
            on_action=perform_delete,
            on_undo=undo_callback
        )

    def _plugin_still_exists(self, plugin_id: str) -> bool:
        if self._get_plugin_obj(plugin_id) is not None:
            return True
        path = self._find_plugin_path(plugin_id)
        return path is not None and os.path.exists(path)

    def _delete_plugin(self, plugin_id: str, plugin_name: str):
        def delete_task():
            try:
                controller = PluginsController.getInstance()
                plugin_obj = controller.plugins.get(plugin_id)
                plugin_path = self._find_plugin_path(plugin_id)

                # Controller API refuses to delete an enabled plugin.
                if plugin_obj and self._is_plugin_enabled(plugin_obj):
                    try:
                        plugin_obj.setEnabled(False)
                    except Exception as e:
                        log(f"[{__id__}] setEnabled(False) failed for {plugin_id}: {e}")

                # Official API call. On this SDK build it only unregisters the
                # plugin without removing the file from disk, so it's not
                # sufficient by itself - kept because it's the correct, cheap
                # first attempt and may do more on other builds.
                try:
                    controller.deletePlugin(plugin_id)
                except Exception as e:
                    log(f"[{__id__}] deletePlugin(id) failed for {plugin_id}: {e}")

                deleted = not self._plugin_still_exists(plugin_id)

                if not deleted:
                    deleted = self._force_remove_plugin_file(plugin_id, plugin_path)

                if deleted:
                    run_on_ui_thread(lambda: BulletinHelper.show_success(
                        localise("PLUGIN_DELETED_SUCCESS", plugin_name)
                    ))
                    self._schedule_cache_rebuild(delay=0.5)
                else:
                    run_on_ui_thread(lambda: BulletinHelper.show_error(
                        localise("PLUGIN_DELETE_ERROR", plugin_name)
                    ))
            except Exception:
                log(f"[{__id__}] Error in _delete_plugin: {traceback.format_exc()}")
                run_on_ui_thread(lambda: BulletinHelper.show_error(
                    localise("PLUGIN_DELETE_ERROR", plugin_name)
                ))
        threading.Thread(target=delete_task).start()

    def _is_path_inside_dir(self, path: str, directory: str) -> bool:
        """os.path.commonpath doesn't exist on Jython 2.7, so check the
        prefix manually instead."""
        directory_with_sep = directory if directory.endswith(os.sep) else directory + os.sep
        return path == directory or path.startswith(directory_with_sep)

    def _force_remove_plugin_file(self, plugin_id: str, plugin_path: Optional[str]) -> bool:
        """Manual cleanup for when the controller API leaves the plugin file
        on disk. Only removes a path confirmed to sit inside the real
        plugins directory and to be a regular file; every step is logged
        instead of silently swallowed."""
        if not plugin_path:
            log(f"[{__id__}] No resolved path for {plugin_id}, cannot force-remove")
            return False
        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir:
                return False

            real_plugins_dir = os.path.realpath(plugins_dir)
            real_path = os.path.realpath(plugin_path)
            if not self._is_path_inside_dir(real_path, real_plugins_dir):
                log(f"[{__id__}] Refusing to remove {plugin_path}: outside plugins dir")
                return False

            if not os.path.isfile(real_path):
                log(f"[{__id__}] {real_path} is not a regular file, skipping")
                return False

            os.remove(real_path)
            log(f"[{__id__}] Manually removed plugin file: {real_path}")

            controller = PluginsController.getInstance()
            try:
                if hasattr(controller.plugins, "remove"):
                    controller.plugins.remove(plugin_id)
                elif isinstance(controller.plugins, dict):
                    controller.plugins.pop(plugin_id, None)
            except Exception as e:
                log(f"[{__id__}] Registry cleanup after manual delete failed for {plugin_id}: {e}")

            return not self._plugin_still_exists(plugin_id)
        except Exception as e:
            log(f"[{__id__}] Manual file removal failed for {plugin_id}: {e}")
            return False

    def _find_plugin_path(self, plugin_id: str) -> Optional[str]:
        plugin_obj = self._get_plugin_obj(plugin_id)
        if plugin_obj and hasattr(plugin_obj, 'file'):
            try:
                return plugin_obj.file.getAbsolutePath()
            except Exception:
                pass

        try:
            plugins_dir = get_plugins_dir()
            if not plugins_dir: return None

            for filename in os.listdir(plugins_dir):
                if not filename.endswith(('.py', '.plugin')): continue


                file_path = os.path.join(plugins_dir, filename)
                try:
                    with open(file_path, "r", encoding="utf-8") as f:
                        content = f.read()
                    id_from_file = self._get_id_from_file_content(content)
                    if id_from_file == plugin_id:
                        return file_path
                except Exception:
                    continue
        except Exception:
            pass
        return None

    def _copy_plugin_to_external_cache(self, plugin_path: str, rename_py_to_plugin: bool = False) -> Optional["File"]:
        """Stages a plugin file inside the app's external cache dir so it can
        be handed to another app via FileProvider / SendMessagesHelper.
        Returns the staged File, or None if staging failed."""
        ext_cache_root = ApplicationLoader.applicationContext.getExternalCacheDir()
        plugin_ext_dir = File(ext_cache_root, QUICKSETTINGS_TEMP_DIR)
        if not plugin_ext_dir.exists() and not plugin_ext_dir.mkdirs():
            return None

        filename = File(plugin_path).getName()
        if rename_py_to_plugin and filename.endswith(".py"):
            filename = filename[:-3] + ".plugin"

        staged_file = File(plugin_ext_dir, filename)
        with open(plugin_path, 'rb') as f_in, open(staged_file.getAbsolutePath(), 'wb') as f_out:
            f_out.write(f_in.read())

        return staged_file

    def _share_plugin(self, plugin_id: str):
        def action():
            try:
                plugin_path = self._find_plugin_path(plugin_id)
                if not plugin_path:
                    BulletinHelper.show_error(localise("SHARE_ERROR_NOT_FOUND"))
                    return

                fragment = get_last_fragment()
                if not fragment: return


                dialog_id = fragment.getDialogId()
                account_instance = get_account_instance()

                staged_file = self._copy_plugin_to_external_cache(plugin_path, rename_py_to_plugin=True)
                if not staged_file:
                    BulletinHelper.show_error(localise("SHARE_ERROR_GENERAL"))
                    return
                external_path = staged_file.getAbsolutePath()

                mime, _ = mimetypes.guess_type(external_path)
                if mime is None: mime = "application/octet-stream"

                SendMessagesHelper.prepareSendingDocument(
                    account_instance, external_path, external_path, None,
                    None, mime, dialog_id,
                    None, None, None, None, None,
                    True, 0, None, None, 0, False
                )
            except Exception:
                BulletinHelper.show_error(localise("SHARE_ERROR_GENERAL"))


        run_on_ui_thread(action)

    def _open_plugin_with(self, plugin_id: str):
        def action():
            try:
                plugin_path = self._find_plugin_path(plugin_id)
                if not plugin_path:
                    BulletinHelper.show_error(localise("SHARE_ERROR_NOT_FOUND"))
                    return


                fragment = get_last_fragment()
                if not fragment: return
                context = fragment.getContext() or fragment.getParentActivity()
                if not context: return

                staged_file = self._copy_plugin_to_external_cache(plugin_path)
                if not staged_file:
                    return

                authority = context.getPackageName() + ".provider"
                uri = FileProvider.getUriForFile(context, authority, staged_file)

                intent = Intent(Intent.ACTION_VIEW)
                intent.setDataAndType(uri, "text/plain")
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)

                chooser_intent = Intent.createChooser(intent, localise("OPEN_WITH_TITLE"))
                context.startActivity(chooser_intent)

            except Exception:
                log(f"[{__id__}] Error in _open_plugin_with: {traceback.format_exc()}")
                BulletinHelper.show_error(localise("SHARE_ERROR_GENERAL"))


        run_on_ui_thread(action)