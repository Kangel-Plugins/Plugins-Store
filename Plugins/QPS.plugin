)
_QPSW_LOCK = threading.RLock()


def _qpsw_error_sink(label, trace, notify):
    owner = _DEBUG_STATE["plugin"]
    if owner is None:
        return
    text = f"QPSwipe: {label}"
    if notify:
        owner._handle_error(text)
    else:
        owner._dbg_report_error(text)


def _qpsw_standalone_check():
    obj = dict(_ioe_controller_plugins()).get("OMD")
    return obj is not None and ioe_read_enabled("OMD", obj)


class QpsWipeLoader:
    def __init__(self):
        self.module = None
        self.error = None

    def ensure(self):
        if self.module is not None:
            return self.module
        with _QPSW_LOCK:
            if self.module is not None:
                return self.module
            try:
                raw = _qpsw_zlib.decompress(_qpsw_b64.b64decode(_QPSW_B64))
                if _qpsw_hashlib.sha256(raw).hexdigest() != QPSW_SHA256:
                    raise ValueError("qps_wipe sha256 mismatch")
                module = _qpsw_types.ModuleType(QPSW_MODULE_NAME)
                sys.modules[QPSW_MODULE_NAME] = module
                exec(compile(raw.decode("utf-8"), QPSW_MODULE_NAME, "exec"), module.__dict__)
                if int(module.QPSw_API) != QPSW_API:
                    raise ValueError("qps_wipe api mismatch")
                module.QPSw_bind(log, _qpsw_error_sink)
                self.module = module
                self.error = None
            except Exception:
                self.error = traceback.format_exc()
                sys.modules.pop(QPSW_MODULE_NAME, None)
                self.module = None
                log(f"[{__id__}] QPSwipe load failed: {self.error}")
        return self.module

    def close(self):
        with _QPSW_LOCK:
            self.module = None
            sys.modules.pop(QPSW_MODULE_NAME, None)


_QPSW = QpsWipeLoader()


class QpsWipeMixin:
    _qpsw_eng = None

    @safe(default=None, msg="QPSwipe engine init failed", notify=False)
    def _qpsw_engine(self):
        with _QPSW_LOCK:
            if self._qpsw_eng is not None:
                return self._qpsw_eng
            module = _QPSW.ensure()
            if module is None:
                return None
            self._qpsw_eng = module.QPSw_Engine(self, _qpsw_standalone_check, _ioe_plugins_dir())
            return self._qpsw_eng

    @safe(msg="QPSwipe on_load failed", notify=False)
    def _qpsw_on_load(self):
        engine = self._qpsw_engine()
        if engine is not None:
            engine.on_load()

    @safe(msg="QPSwipe on_unload failed", notify=False)
    def _qpsw_on_unload(self):
        engine = self._qpsw_eng
        self._qpsw_eng = None
        if engine is not None:
            engine.on_unload()
        _QPSW.close()

    @safe(default=[], msg="QPSwipe settings failed", notify=False)
    def _qpsw_settings_items(self):
        engine = self._qpsw_engine()
        return engine.settings_items() if engine is not None else []


class QuickSettingsPlugin(DexBridgeMixin, IoeCoreMixin, IoeUiMixin, SafetyCoreMixin, CardsMixin, QpsWipeMixin, MenuMixin, ActionsMixin, ShareMixin, DebugMixin, CacheMixin, ElyxScannerMixin, BasePlugin):
    PRIORITY_PLUGIN = 90
    PRIORITY_SHORTCUT = 91

    @safe(msg="Failed to cancel timer", notify=False)
    def _cancel_timer(self, timer):
        if timer:
            timer.cancel()

    @safe(default=False, msg="Clipboard copy failed", notify=False)
    def _copy_to_clipboard(self, label, text):
        context = ApplicationLoader.applicationContext
        if not context:
            return False
        clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)
        if not clipboard:
            return False
        clipboard.setPrimaryClip(ClipData.newPlainText(label, text))
        return True

    def _handle_error(self, context_label, message_key="PLUGIN_GENERIC_ERROR",
                      message_args=(), notify=True):
        tb = traceback.format_exc()
        log(f"[{__id__}] {context_label}: {tb}")
        self._dbg_report_error(context_label)

        def notify_action():
            bulletin_text = localise(message_key, *message_args)

            def copy_action():
                copied = self._copy_to_clipboard(
                    f"{__id__} error: {context_label}",
                    f"[{__id__}] {context_label}\n{tb}"
                )
                if copied:
                    BulletinHelper.show_info(localise("ERROR_DETAILS_COPIED"))

            try:
                BulletinHelper.show_with_button(
                    bulletin_text,
                    _error_bulletin_icon(),
                    localise("BULLETIN_ACTION_COPY_DETAILS"),
                    copy_action,
                    get_last_fragment()
                )
            except Exception as e:
                log(f"[{__id__}] show_with_button unavailable: {e}")
                BulletinHelper.show_error(bulletin_text)

        if notify:
            run_on_ui_thread(notify_action)

    def _run_ui_action(self, action, error_context, message_key="PLUGIN_GENERIC_ERROR",
                       message_args=(), notify_on_error=True):
        def wrapped():
            try:
                action()
            except Exception:
                self._handle_error(
                    error_context, message_key, message_args, notify=notify_on_error
                )

        run_on_ui_thread(wrapped)

    def _notify(self, kind, text):
        fn = {
            "success": BulletinHelper.show_success,
            "error": BulletinHelper.show_error,
            "info": BulletinHelper.show_info,
        }.get(kind, BulletinHelper.show_info)
        fn(text)

    def __init__(self):
        super().__init__()
        self.added_menu_items = []
        self.hooks = []
        self.update_timer = None
        self._menu_gen = 0
        self._watch_stop = None
        self._watch_sig = None
        self.plugin_info_cache = {}
        self.file_cache = {}
        self.cache_path = None
        self.rebuild_timer = None
        self._executor = None
        self._unloaded = False
        self._pending_notify = False
        self._sync_timer = None
        self._sync_lock = threading.Lock()
        self._sync_hints = set()
        self._registry_state_last = None
        self._registry_last_good_state = None
        self._registry_suspect_log_at = 0.0
        self._registry_recovery_lock = threading.Lock()
        self._registry_recovery_pending = False
        self._registry_recovery_last_at = 0.0
        self._cache_dirty = False
        self._pending_timer = None
        self._staged_timers = set()
        self._staged_lock = threading.Lock()
        self._rebuild_lock = threading.Lock()
        self._rebuild_exec_lock = threading.Lock()
        self._menu_lock = threading.Lock()
        self._cache_lock = threading.Lock()
        self._plugin_locks = {}
        self._plugin_locks_lock = threading.Lock()
        self._undo_timers = set()
        self._pending_undo_finalizers = {}
        self._dbg_pending_lock = threading.Lock()
        self._undo_timers_lock = threading.Lock()
        self._dbg_lock = threading.Lock()
        self._dbg_probe_lock = threading.Lock()
        self._dbg_probe_run_lock = threading.Lock()
        self._dbg_running = False
        self._dbg_recorder = None
        self._dbg_stop_event = threading.Event()
        self._dbg_proc = None
        self._dbg_threads = []
        self._dbg_unhooks = []
        self._dbg_hook_counts = {}
        self._dbg_probe_timer = None
        self._dbg_last_archives = []
        self._dbg_last_controller = {}
        self._dbg_last_fs = {}
        self._dbg_last_ctrl_state = {}
        self._dbg_last_cache_stamp = None
        self._dbg_account = None
        self._dbg_report_lock = threading.Lock()
        self._dbg_last_report = 0
        self._dbg_report_sigs = {}
        self._dbg_hook_fn = None
        self._dbg_prev_excepthook = None

    def _get_plugin_lock(self, plugin_id):
        with self._plugin_locks_lock:
            lock = self._plugin_locks.get(plugin_id)
            if lock is None:
                lock = threading.Lock()
                self._plugin_locks[plugin_id] = lock
            return lock

    def create_settings(self):
        return [
            Header(text=localise("HEADER_CHAT_MENU_ACTION")),
            Selector(
                key="chat_menu_action",
                text=localise("SELECTOR_CHAT_MENU_ACTION"),
                items=localise("SELECTOR_ITEMS_CHAT_MENU_ACTION"),
                default=ACTION_OPEN_MENU,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_PLUGIN_VISIBILITY")),
            Switch(
                key="show_plugins_without_settings",
                text=localise("SWITCH_SHOW_PLUGINS_WITHOUT_SETTINGS"),
                default=False,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Switch(
                key="show_disabled_plugins",
                text=localise("SWITCH_SHOW_DISABLED_PLUGINS"),
                default=True,
                on_change=lambda _: self._schedule_menu_update(delay=0.1)
            ),
            Header(text=localise("HEADER_CACHE_MANAGEMENT")),
            Text(
                text=localise("SETTINGS_REBUILD_CACHE_BUTTON"),
                icon="msg_update",
                on_click=self._handle_rebuild_cache_click
            ),
            Divider(text=localise("SETTINGS_REBUILD_CACHE_SUBTEXT")),
            Header(text=localise("HEADER_DELETE")),
            Switch(
                key="del_bullet",
                text=localise("SWITCH_DELETE_BULLET"),
                default=True
            ),
            Divider(text=localise("DELETE_BULLET_SUBTEXT")),
            Header(text=localise("HEADER_STAGED_CLEANUP")),
            Input(
                key="staged_cleanup_timeout",
                text=localise("INPUT_STAGED_CLEANUP_TIMEOUT"),
                default=str(DEFAULT_STAGED_CLEANUP_TIMEOUT),
                icon="msg_timer"
            ),
            Divider(text=localise("STAGED_CLEANUP_TIMEOUT_SUBTEXT")),
            *self._cards_settings_items(),
            *self._qpsw_settings_items(),
            Header(text=localise("HEADER_DEBUG")),
            Switch(
                key="debug_mode",
                text=localise("SWITCH_DEBUG_MODE"),
                default=False,
                on_change=lambda value: self._on_debug_toggle(value)
            ),
            Selector(
                key="debug_log_format",
                text=localise("SELECTOR_DEBUG_LOG_FORMAT"),
                items=localise("SELECTOR_ITEMS_DEBUG_FORMAT"),
                default=1
            ),
            Text(
                text=localise("BUTTON_FAST_LOG"),
                icon="msg_saved",
                on_click=self._handle_fast_log_click
            ),
            Text(
                text=localise("BUTTON_DEBUG_PROBE"),
                icon="msg_list",
                on_click=self._handle_debug_probe_click
            ),
            Text(
                text="Очистить лог",
                icon="msg_delete",
                on_click=self._ioe_handle_clear_log_click
            ),
            Switch(
                key="debug_auto_send",
                text=localise("SWITCH_DEBUG_AUTO_SEND"),
                default=False,
                on_change=lambda value: self._on_debug_auto_send(value)
            ),
            Divider(text=localise("DEBUG_SUBTEXT")),
            *self._safety_settings_items(),
        ] + self._qps5_settings_items()

    def _get_staged_cleanup_timeout(self):
        raw = self.get_setting("staged_cleanup_timeout", str(DEFAULT_STAGED_CLEANUP_TIMEOUT))
        try:
            value = int(str(raw).strip())
        except (TypeError, ValueError):
            return DEFAULT_STAGED_CLEANUP_TIMEOUT
        return max(MIN_STAGED_CLEANUP_TIMEOUT, min(MAX_STAGED_CLEANUP_TIMEOUT, value))

    def on_plugin_load(self):
        self._unloaded = False
        _DEBUG_STATE["plugin"] = self
        self._executor = ThreadPoolExecutor(max_workers=2)
        self._clear_temp_dir()
        self._init_cache_system()
        self._submit(self._cleanup_legacy_private_data, "legacy_cleanup")
        if self.get_setting("debug_mode", False):
            self._submit(self._dbg_boot, "debug_boot")
        self._pending_timer = threading.Timer(10.0, self._dbg_process_pending)
        self._pending_timer.daemon = True
        self._pending_timer.start()
        if self._load_cache():
            self._schedule_cache_rebuild(delay=2.0)
        else:
            self._schedule_cache_rebuild(delay=0.1)
        self._schedule_menu_update(delay=0)
        self._apply_hooks()
        self._start_registry_watch()
        self._qps5_on_load()
        self._qpsw_on_load()

    def on_plugin_unload(self):
        self._unloaded = True
        self._qpsw_on_unload()
        self._qps5_on_unload()
        self._stop_registry_watch()
        run_on_ui_thread(self._remove_menu_items)
        self._remove_hooks()
        with self._menu_lock:
            self._cancel_timer(self.update_timer)
        with self._rebuild_lock:
            self._cancel_timer(self.rebuild_timer)
        with self._sync_lock:
            self._cancel_timer(self._sync_timer)
            self._sync_hints.clear()
        self._cancel_timer(self._pending_timer)
        with self._undo_timers_lock:
            undo_timers = list(self._undo_timers)
            self._undo_timers.clear()
            finalizers = list(self._pending_undo_finalizers.values())
            self._pending_undo_finalizers.clear()
        for t in undo_timers:
            self._cancel_timer(t)
        for finalize in finalizers:
            try:
                finalize()
            except Exception as e:
                log(f"[{__id__}] Pending undo finalize failed: {e}")
        if self._executor:
            self._executor.shutdown(wait=False)
            self._executor = None
        self._cancel_staged_timers()
        self._dbg_stop()
        self._clear_temp_dir()
        _DEBUG_STATE["plugin"] = None

    @safe(default=False, ctx=lambda plugin_obj: type(plugin_obj).__name__, notify=False)
    def _is_plugin_enabled(self, plugin_obj):
        return getattr(plugin_obj, "enabled", False) or (
            plugin_obj.isEnabled() if hasattr(plugin_obj, "isEnabled") else False
        )

    @safe(ctx=lambda plugin_id: plugin_id)
    def _get_plugin_obj(self, plugin_id):
        return PluginsController.getInstance().plugins.get(plugin_id)

    def _get_plugin_display_name(self, plugin_obj, fallback_id):
        if hasattr(plugin_obj, "name"):
            return str(plugin_obj.name)
        return str(plugin_obj.getName()) if hasattr(plugin_obj, "getName") else fallback_id

    def _submit(self, task, label="task", detached=False):
        # detached=True - если пула уже нет (QPS выгружается), выполняем в отдельном потоке:
        # так нужно для довершения удаления, которое юзер уже подтвердил
        executor = self._executor
        if executor is not None:
            try:
                executor.submit(task)
                return True
            except RuntimeError as e:
                log(f"[{__id__}] Executor rejected {label}: {e}")
        else:
            log(f"[{__id__}] Executor is gone for {label}")
        if not detached:
            return False
        try:
            thread = threading.Thread(target=task, name=f"QPS-{label}", daemon=True)
            thread.start()
            return True
        except Exception as e:
            log(f"[{__id__}] Detached thread failed for {label}: {e}")
            return False

    def _rmtree_guarded(self, target, root, label):
        if not target or not root:
            log(f"[{__id__}] Refusing rmtree of {label}: empty path")
            return False
        if os.path.islink(target) or not os.path.isdir(target):
            log(f"[{__id__}] Refusing rmtree of {label} {target}: symlink or not a directory")
            return False
        real_root = os.path.realpath(root)
        real_target = os.path.realpath(target)
        depth = len([part for part in real_target.split(os.sep) if part])
        if (
            real_target == real_root
            or not self._is_path_inside_dir(real_target, real_root)
            or depth < 3
            or os.path.ismount(real_target)
        ):
            log(f"[{__id__}] Refusing rmtree of {label} {target}: outside {root}")
            return False

        def on_error(func, path, exc_info):
            log(f"[{__id__}] rmtree {label}: {getattr(func, '__name__', func)} failed for {path}: {exc_info[1]}")

        shutil.rmtree(real_target, onerror=on_error)
        gone = not os.path.exists(real_target)
        if not gone:
            log(f"[{__id__}] rmtree {label} left {real_target} partially in place")
        return gone

    def _is_path_inside_dir(self, path, directory):
        dir_with_sep = directory if directory.endswith(os.sep) else directory + os.sep
        return path == directory or path.startswith(dir_with_sep)