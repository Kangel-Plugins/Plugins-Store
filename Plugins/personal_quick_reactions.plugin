USER_REQUEST_SELECTOR_MODE = 15
USERS_STORAGE_KEY = "users_v1"
USERS_STORAGE_VERSION = 2
REACTION_PICKER_TYPE_SET_DEFAULT = 2
REACTION_POPUP_WRAP_CONTENT = -2
REACTION_POPUP_GRAVITY_TOP_RIGHT = 53
DEFAULT_PERSONAL_REACTION = "❤"
FOLLOW_GLOBAL_REACTION = "__follow_global__"

