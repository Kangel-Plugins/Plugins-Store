__id__ = "game_arcade"
__name__ = "Arcade Games"
__version__ = "1.1"
__min_version__ = "12.10.6"
__author__ = "@Art_727 & @lerowplug"
__description__ = "Легендарные игры 2048, Flappy Bird и Chrome Dino прямо в клиенте. Сделан на основе плагина Flappy Bird, автор @hijut"
__icon__ = "ArtPack99/34"

import gc
import weakref

from android.graphics import Color
from android.view import Gravity, ViewGroup, WindowManager
from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType
from client_utils import get_last_fragment
from android_utils import run_on_ui_thread, log
from hook_utils import find_class
from java import dynamic_proxy
from ui.settings import Header, Switch, Text, Divider
from ui.bulletin import BulletinHelper
from org.telegram.messenger import LocaleController

ADBLOCK_JS = """
(function() {
    // 1. Заглушки для рекламных сетей
    try {
        window.adsbygoogle = [];
        window.adsbygoogle.push = function() {};
        window.vm = { init: function(){}, push: function(){}, show: function(cb){ if(cb) cb(); } };
        window.vmax = {};
        window.primis = {};
        window.aip = { show: function(cb){ if(cb) cb(); } };
        window.open = function() { return null; };
    } catch(e) {}

    var adRegex = /(vmg\\.host|venatus|primis|doubleclick|googleads|googlesyndication|vungle|unity3d|adservice|adnxs|taboola|outbrain|criteo|rubicon|pubmatic|scorecard|amazon-adsystem|flashtalking|adcolony|applovin|playwire)/i;

    // 2. Блокировка присвоения .src рекламным скриптам и фреймам
    try {
        var sDesc = Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype, 'src');
        if (sDesc && sDesc.set) {
            Object.defineProperty(HTMLScriptElement.prototype, 'src', {
                set: function(val) {
                    if (typeof val === 'string' && adRegex.test(val)) return;
                    return sDesc.set.call(this, val);
                },
                get: sDesc.get,
                configurable: true
            });
        }
        var iDesc = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, 'src');
        if (iDesc && iDesc.set) {
            Object.defineProperty(HTMLIFrameElement.prototype, 'src', {
                set: function(val) {
                    if (typeof val === 'string' && adRegex.test(val)) return;
                    return iDesc.set.call(this, val);
                },
                get: iDesc.get,
                configurable: true
            });
        }
    } catch(e) {}

    // 3. Перехват appendChild: запрещаем вставлять рекламные скрипты и контейнеры в DOM
    try {
        if (!Node.prototype.__orig_append) {
            Node.prototype.__orig_append = Node.prototype.appendChild;
            Node.prototype.appendChild = function(child) {
                if (child && child.tagName) {
                    var tag = child.tagName.toLowerCase();
                    if (tag === 'script' || tag === 'iframe') {
                        var s = child.src || child.getAttribute('src') || '';
                        if (adRegex.test(s)) return child;
                    }
                    var id = (child.id || '').toLowerCase();
                    var cls = (child.className || '').toLowerCase();
                    if (id.includes('vm-') || id.includes('primis') || cls.includes('vm-') || cls.includes('primis')) {
                        return child;
                    }
                }
                return Node.prototype.__orig_append.apply(this, arguments);
            };
        }
    } catch(e) {}

    // 4. Муляжи для video и iframe
    try {
        if (!Document.prototype.__orig_ce) {
            Document.prototype.__orig_ce = Document.prototype.createElement;
            Document.prototype.createElement = function(tag) {
                var t = (tag || '').toLowerCase();
                if (t === 'video') {
                    var dummy = Document.prototype.__orig_ce.call(document, 'div');
                    dummy.play = function() { return Promise.resolve(); };
                    dummy.pause = function() {};
                    dummy.load = function() {};
                    dummy.src = '';
                    dummy.style.display = 'none';
                    return dummy;
                }
                if (t === 'iframe') {
                    var fakeFrame = Document.prototype.__orig_ce.call(document, 'div');
                    fakeFrame.style.display = 'none';
                    fakeFrame.contentWindow = { document: { write: function(){}, open: function(){}, close: function(){} } };
                    return fakeFrame;
                }
                return Document.prototype.__orig_ce.apply(this, arguments);
            };
        }
    } catch(e) {}

    // 5. Тотальный чистильщик плавающих слайдеров и контейнеров
    function destroyAdDocks() {
        try {
            // Удаляем любые рекламные элементы
            var bad = document.querySelectorAll(`
                iframe, ins, video,
                [id*="vm-"], [class*="vm-"], [id*="primis"], [class*="primis"],
                #bottom-ads, .bottom-ads, #video-ad, .video-ad,
                [id*="google_ads"], [id*="ad-container"], [class*="ad-container"],
                [id*="ad_wrapper"], [class*="ad_wrapper"],
                div[style*="fixed"][style*="bottom"], div[style*="fixed"][style*="z-index"],
                div[style*="translateY"]
            `);
            for (var i = 0; i < bad.length; i++) {
                var el = bad[i];
                if (el.tagName === 'CANVAS' || el.id === 'canvas' || el.id === 'game') continue;
                el.style.setProperty('display', 'none', 'important');
                el.remove();
            }

            // Любой фиксированный блок на уровне body во Flappy Bird — это реклама
            var bodyChildren = document.body ? document.body.children : [];
            for (var j = 0; j < bodyChildren.length; j++) {
                var bChild = bodyChildren[j];
                if (bChild.tagName === 'CANVAS' || bChild.id === 'canvas' || bChild.id === 'game') continue;
                var comp = window.getComputedStyle(bChild);
                if (comp.position === 'fixed' || comp.position === 'sticky') {
                    bChild.remove();
                }
            }
        } catch(e) {}
    }

    // 6. CSS-подавление
    var css = `
        iframe, ins, video,
        [id*="vm-"], [class*="vm-"], [id*="primis"], [class*="primis"],
        #bottom-ads, .bottom-ads, #video-ad, .video-ad,
        [id*="google_ads"], [id*="ad-container"], [class*="ad-container"],
        [id*="ad_wrapper"], [class*="ad_wrapper"],
        div[style*="fixed"][style*="bottom"], div[style*="fixed"][style*="z-index"],
        div[style*="translateY"], [class*="close-button"] {
            display: none !important;
            visibility: hidden !important;
            height: 0px !important;
            width: 0px !important;
            opacity: 0 !important;
            pointer-events: none !important;
            position: absolute !important;
            top: -99999px !important;
        }
    `;

    try {
        var head = document.head || document.documentElement;
        if (head && !document.getElementById('__arcade_nuker_css')) {
            var s = document.createElement('style');
            s.id = '__arcade_nuker_css';
            s.textContent = css;
            head.appendChild(s);
        }
    } catch(e) {}

    destroyAdDocks();

    if (!window.__arcade_observer_set) {
        window.__arcade_observer_set = true;
        try {
            var obs = new MutationObserver(function() {
                destroyAdDocks();
            });
            obs.observe(document.documentElement || document.body, { childList: true, subtree: true });
        } catch(e) {}
    }
})();
"""

class _2048Ultimate(BasePlugin):
    def __init__(self):
        super().__init__()
        self.classes = {}
        self.strings = {}
        self.menu_items = {}
        self.current_dialog = None

    def _load_resources(self):
        try:
            lang = LocaleController.getInstance().getCurrentLocaleInfo().getLangCode()
        except Exception:
            lang = "en"
        
        is_ru = bool(lang and lang.startswith("ru"))
        
        self.strings = {
            "ui_header": "Настройки игр" if is_ru else "Game Settings",
            "close_btn": "Кнопка закрытия «X»" if is_ru else "Close Button «X»",
            "safe_exit": "Подтверждение выхода" if is_ru else "Exit Confirmation",
            "menu_item": "Запуск через боковое меню" if is_ru else "Launch via Drawer",
            "wake_lock": "Не дать экрану погаснуть" if is_ru else "Prevent Screen Sleep",
            "reset_btn": "Сбросить кэш игр" if is_ru else "Reset Games Data",
            "reset_toast": "Кэш игр успешно сброшен!" if is_ru else "Games data successfully reset!",
            "exit_toast": "Нажмите Назад еще раз, чтобы выйти" if is_ru else "Press Back again to exit",
            "error": "Ошибка" if is_ru else "Error",
            "game_2048": "2048",
            "game_flappy": "Flappy Bird",
            "game_dino": "Chrome Dino"
        }

    def _get_classes(self):
        if not self.classes:
            self.classes = {
                "WebView": find_class("android.webkit.WebView"),
                "WebViewClient": find_class("android.webkit.WebViewClient"),
                "WebStorage": find_class("android.webkit.WebStorage"),
                "Dialog": find_class("android.app.Dialog"),
                "Toast": find_class("android.widget.Toast"),
                "OnDismiss": find_class("android.content.DialogInterface$OnDismissListener"),
                "OnKey": find_class("android.content.DialogInterface$OnKeyListener"),
                "Frame": find_class("android.widget.FrameLayout"),
                "Text": find_class("android.widget.TextView"),
                "System": find_class("java.lang.System"),
                "View": find_class("android.view.View"),
                "OnClick": find_class("android.view.View$OnClickListener"),
                "Runnable": find_class("java.lang.Runnable"),
                "CookieManager": find_class("android.webkit.CookieManager")
            }
        return self.classes

    def on_plugin_load(self):
        try:
            self.classes = {}
            self.strings = {}
            self.menu_items = {}
            self.current_dialog = None

            self._load_resources()
            self.add_on_send_message_hook()
            self.update_menu_items()
        except Exception as e:
            log(f"[Arcade] Init failed: {e}")

    def on_plugin_unload(self):
        try:
            log("[Arcade] Безопасная выгрузка плагина...")
            if self.current_dialog is not None:
                try:
                    self.current_dialog.dismiss()
                except Exception:
                    pass
                self.current_dialog = None

            for item_id in list(self.menu_items.values()):
                if item_id:
                    try:
                        self.remove_menu_item(item_id)
                    except Exception:
                        pass
            self.menu_items.clear()

            if self.classes:
                self.classes.clear()
            if self.strings:
                self.strings.clear()

            gc.collect()
        except Exception as e:
            log(f"[Arcade] Unload error: {e}")

    def create_settings(self):
        self._load_resources()
        plugin_ref = weakref.proxy(self)
        return [
            Header(text=self.strings["ui_header"]),
            Switch(key="show_close_btn", text=self.strings["close_btn"], default=True),
            Switch(key="confirm_exit", text=self.strings["safe_exit"], default=True),
            Switch(key="show_in_menu", text=self.strings["menu_item"], default=True, on_change=lambda *_: plugin_ref.update_menu_items()),
            Switch(key="keep_screen_on", text=self.strings["wake_lock"], default=True),
            Divider(),
            Text(text=self.strings["game_2048"], on_click=lambda *_: plugin_ref.launch_game("https://play2048.co/", "2048"), icon="msg_bot"),
            Text(text=self.strings["game_flappy"], on_click=lambda *_: plugin_ref.launch_game("https://flappybird.io/play/", "Flappy Bird"), icon="msg_bot"),
            Text(text=self.strings["game_dino"], on_click=lambda *_: plugin_ref.launch_game("https://chromedino.com/embed/", "Chrome Dino"), icon="msg_bot"),
            Divider(),
            Text(text=self.strings["reset_btn"], on_click=lambda *_: plugin_ref.reset_game_data(), icon="msg_delete")
        ]

    def update_menu_items(self):
        for item_id in list(self.menu_items.values()):
            if item_id:
                try:
                    self.remove_menu_item(item_id)
                except Exception:
                    pass
        self.menu_items.clear()

        if not self.strings:
            self._load_resources()

        plugin_ref = weakref.proxy(self)

        if self.get_setting("show_in_menu", True):
            try:
                self.menu_items["drawer_2048"] = self.add_menu_item(
                    MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text=self.strings["game_2048"], on_click=lambda *_: plugin_ref.launch_game("https://play2048.co/", "2048"), icon="msg_bot")
                )
                self.menu_items["drawer_flappy"] = self.add_menu_item(
                    MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text=self.strings["game_flappy"], on_click=lambda *_: plugin_ref.launch_game("https://flappybird.io/play/", "Flappy Bird"), icon="msg_bot")
                )
                self.menu_items["drawer_dino"] = self.add_menu_item(
                    MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text=self.strings["game_dino"], on_click=lambda *_: plugin_ref.launch_game("https://chromedino.com/embed/", "Chrome Dino"), icon="msg_bot")
                )
            except Exception as e:
                log(f"[Arcade] Drawer menu error: {e}")

        try:
            self.menu_items["chat_2048"] = self.add_menu_item(
                MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=self.strings["game_2048"], on_click=lambda *_: plugin_ref.launch_game("https://play2048.co/", "2048"), icon="msg_bot")
            )
            self.menu_items["chat_flappy"] = self.add_menu_item(
                MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=self.strings["game_flappy"], on_click=lambda *_: plugin_ref.launch_game("https://flappybird.io/play/", "Flappy Bird"), icon="msg_bot")
            )
            self.menu_items["chat_dino"] = self.add_menu_item(
                MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, text=self.strings["game_dino"], on_click=lambda *_: plugin_ref.launch_game("https://chromedino.com/embed/", "Chrome Dino"), icon="msg_bot")
            )
        except Exception as e:
            log(f"[Arcade] Chat menu error: {e}")

    def reset_game_data(self):
        try:
            fragment = get_last_fragment()
            if fragment and fragment.getParentActivity():
                act = fragment.getParentActivity()
                classes = self._get_classes()
                webview = classes["WebView"](act)
                webview.clearCache(True)
                webview.clearFormData()
                webview.clearHistory()
                webview.destroy()
                act.getApplicationContext().deleteDatabase("webview.db")
                act.getApplicationContext().deleteDatabase("webviewCache.db")
                BulletinHelper.show_success(self.strings["reset_toast"])
        except Exception as e:
            log(f"[Arcade] Reset failed: {e}")

    def on_send_message_hook(self, account, params):
        if hasattr(params, 'message') and params.message:
            msg = params.message.strip().lower()
            if msg == ".2048":
                self.launch_game("https://play2048.co/", "2048")
                return HookResult(strategy=HookStrategy.CANCEL)
            elif msg == ".flappy":
                self.launch_game("https://flappybird.io/play/", "Flappy Bird")
                return HookResult(strategy=HookStrategy.CANCEL)
            elif msg == ".dino":
                self.launch_game("https://chromedino.com/embed/", "Chrome Dino")
                return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()

    def launch_game(self, url="https://play2048.co/", title="2048"):
        w = weakref.ref(self)

        def run():
            inst = w()
            if inst is None:
                return

            try:
                if inst.current_dialog is not None:
                    try:
                        inst.current_dialog.dismiss()
                    except Exception:
                        pass
                    inst.current_dialog = None

                fragment = get_last_fragment()
                if not fragment or not fragment.getParentActivity():
                    return
                
                act = fragment.getParentActivity()
                if act.isFinishing() or (hasattr(act, "isDestroyed") and act.isDestroyed()):
                    return

                classes = inst._get_classes()
                orig_orient = act.getRequestedOrientation()
                act.setRequestedOrientation(1)

                layout = classes["Frame"](act)
                layout.setBackgroundColor(Color.parseColor("#eae8da"))

                webview = classes["WebView"](act)
                webview.setVerticalScrollBarEnabled(False)
                webview.setHorizontalScrollBarEnabled(False)

                try:
                    cookie_mgr = classes["CookieManager"].getInstance()
                    cookie_mgr.setAcceptThirdPartyCookies(webview, False)
                except Exception:
                    pass

                settings = webview.getSettings()
                settings.setJavaScriptEnabled(True)
                settings.setDomStorageEnabled(True)
                settings.setDatabaseEnabled(True)
                settings.setDatabasePath(act.getApplicationContext().getDir("database", 0).getPath())
                settings.setUseWideViewPort(True)
                settings.setLoadWithOverviewMode(True)
                settings.setMediaPlaybackRequiresUserGesture(True)

                webview.setWebViewClient(classes["WebViewClient"]())
                webview.setBackgroundColor(Color.parseColor("#eae8da"))
                webview.loadUrl(url)

                # Циклическая авто-инъекция: накатывает защиту снова при любых перезагрузках страницы
                w_wv = weakref.ref(webview)
                w_lay = weakref.ref(layout)

                class AutoAdBlockTask(dynamic_proxy(classes["Runnable"])):
                    def run(self):
                        try:
                            v = w_wv()
                            l = w_lay()
                            if v is not None and l is not None:
                                v.evaluateJavascript(ADBLOCK_JS, None)
                                # Повторяем каждые 600 мс (не создавая утечек памяти)
                                l.postDelayed(self, 600)
                        except Exception:
                            pass

                # Мгновенный первый запуск
                try:
                    webview.evaluateJavascript(ADBLOCK_JS, None)
                except Exception:
                    pass

                # Запуск постоянного цикла защиты
                layout.postDelayed(AutoAdBlockTask(), 30)

                layout.addView(webview, ViewGroup.LayoutParams(-1, -1))

                btn = None
                if inst.get_setting("show_close_btn", True):
                    btn = classes["Text"](act)
                    btn.setText("✕")
                    btn.setTextSize(22.0)
                    btn.setTextColor(Color.WHITE)
                    btn.setGravity(Gravity.CENTER)
                    btn.setBackgroundColor(Color.parseColor("#40000000")) 
                    btn.setPadding(35, 15, 35, 15)
                    
                    p = classes["Frame"].LayoutParams(-2, -2)
                    p.gravity = Gravity.TOP | Gravity.RIGHT
                    p.setMargins(0, 30, 30, 0)
                    layout.addView(btn, p)

                dialog = classes["Dialog"](act, 16974122)
                dialog.setContentView(layout)
                inst.current_dialog = dialog
                
                window = dialog.getWindow()
                if window:
                    window.setLayout(-1, -1)
                    if inst.get_setting("keep_screen_on", True):
                        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
                    window.getDecorView().setSystemUiVisibility(5894)

                if btn is not None:
                    class Click(dynamic_proxy(classes["OnClick"])):
                        def onClick(self, v):
                            try:
                                dialog.dismiss()
                            except Exception:
                                pass
                    btn.setOnClickListener(Click())

                if inst.get_setting("confirm_exit", True):
                    class KeyListener(dynamic_proxy(classes["OnKey"])):
                        def __init__(self, toast, ctx, msg, sys_obj):
                            super().__init__()
                            self.ts = 0
                            self.toast = toast
                            self.ctx = ctx
                            self.msg = msg
                            self.sys = sys_obj

                        def onKey(self, d, code, event):
                            try:
                                if event is not None and code == 4 and event.getAction() == 1:
                                    now = self.sys.currentTimeMillis()
                                    if (now - self.ts) < 2000:
                                        return False
                                    self.ts = now
                                    try:
                                        self.toast.makeText(self.ctx, self.msg, 0).show()
                                    except Exception:
                                        pass
                                    return True
                            except Exception:
                                pass
                            return False
                    
                    dialog.setOnKeyListener(KeyListener(classes["Toast"], act, inst.strings["exit_toast"], classes["System"]))

                class Dismiss(dynamic_proxy(classes["OnDismiss"])):
                    def onDismiss(self, d):
                        nonlocal webview, layout, act, dialog, btn
                        try:
                            curr = w()
                            if curr is not None:
                                curr.current_dialog = None

                            if dialog is not None:
                                try:
                                    dialog.setOnKeyListener(None)
                                    dialog.setOnDismissListener(None)
                                except Exception:
                                    pass

                            if btn is not None:
                                try:
                                    btn.setOnClickListener(None)
                                except Exception:
                                    pass
                                btn = None

                            if webview is not None:
                                try:
                                    if layout is not None:
                                        layout.removeView(webview)
                                except Exception:
                                    pass

                                try:
                                    webview.onPause()
                                except Exception:
                                    pass

                                try:
                                    webview.stopLoading()
                                except Exception:
                                    pass

                                try:
                                    webview.clearHistory()
                                    webview.clearCache(True)
                                except Exception:
                                    pass

                                try:
                                    webview.removeAllViews()
                                except Exception:
                                    pass

                                try:
                                    webview.destroy()
                                except Exception:
                                    pass
                                
                                webview = None

                            if layout is not None:
                                try:
                                    layout.removeAllViews()
                                except Exception:
                                    pass
                                layout = None

                            if act is not None:
                                try:
                                    if not act.isFinishing():
                                        act.setRequestedOrientation(orig_orient)
                                except Exception:
                                    pass
                                act = None

                            dialog = None
                            gc.collect()

                        except Exception as e:
                            log(f"[Arcade] Dismiss error: {e}")

                dialog.setOnDismissListener(Dismiss())
                dialog.show()

            except Exception as e:
                err = str(e)
                run_on_ui_thread(lambda: BulletinHelper.show_error(f"Error: {err}"))

        run_on_ui_thread(run)
        