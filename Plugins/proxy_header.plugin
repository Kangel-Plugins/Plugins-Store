from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from java import cast, jclass


__id__ = "proxy_header"
__name__ = "Proxy Header"
__description__ = "Открывает меню прокси тапом по шапке | Opens the proxy menu with tap on the header"
__author__ = "@vivanko"
__version__ = "1.0.0"
__app_version__ = ">=12.10.6"


CLS_DIALOGS = "org.telegram.ui.DialogsActivity"
CLS_BASE_FRAGMENT = "org.telegram.ui.ActionBar.BaseFragment"
CLS_RUNNABLE = "java.lang.Runnable"
CLS_PROXY_LIST = "org.telegram.ui.ProxyListActivity"
DIALOGS_PREFIX = "org.telegram.ui.DialogsActivity$"
FIELD_ONLY_SELECT = "onlySelect"
FIELD_FOLDER_ID = "folderId"
FOLDER_MAIN = "0"
FIELD_ACTION_BAR = "actionBar"
FRAMEWORK_PREFIX = "android."


_CLASSES = {}
_RUNNABLE_FIELDS = {}
_OWNER_FIELDS = {}


def _cls(name):
    if name not in _CLASSES:
        c = find_class(name)
        _CLASSES[name] = c if hasattr(c, "getDeclaredMethods") else c.getClass()
    return _CLASSES[name]


def _runnable_fields(bar):
    cls = bar.getClass()
    key = str(cls.getName())
    if key not in _RUNNABLE_FIELDS:
        rc = _cls(CLS_RUNNABLE)
        found = []
        c = cls
        while c is not None and not str(c.getName()).startswith(FRAMEWORK_PREFIX):
            for f in c.getDeclaredFields():
                if rc.isAssignableFrom(f.getType()):
                    f.setAccessible(True)
                    found.append(f)
            c = c.getSuperclass()
        _RUNNABLE_FIELDS[key] = found
    return _RUNNABLE_FIELDS[key]


def _owner(lam):
    cls = lam.getClass()
    key = str(cls.getName())
    if key not in _OWNER_FIELDS:
        dc = _cls(CLS_DIALOGS)
        found = None
        for f in cls.getDeclaredFields():
            if dc.isAssignableFrom(f.getType()):
                f.setAccessible(True)
                found = f
                break
        _OWNER_FIELDS[key] = found
    f = _OWNER_FIELDS[key]
    return None if f is None else f.get(lam)


def _declared(cls, name, params):
    return [m for m in cls.getDeclaredMethods()
            if str(m.getName()) == name and len(m.getParameterTypes()) == params]


def _is_main(frag):
    only = get_private_field(frag, FIELD_ONLY_SELECT)
    folder = get_private_field(frag, FIELD_FOLDER_ID)
    return str(only).lower() == "false" and str(folder) == FOLDER_MAIN


def _open_proxy_screen(frag):
    screen = jclass(CLS_PROXY_LIST)()
    frag.presentFragment(cast(jclass(CLS_BASE_FRAGMENT), screen))


def _make_hook(before=None, after=None):
    class H(MethodHook):
        def before_hooked_method(self, param):
            if before:
                before(param)

        def after_hooked_method(self, param):
            if after:
                after(param)
    return H()


class ProxyHeader(BasePlugin):
    def on_plugin_load(self):
        self._handles = []
        self._adopted = set()
        dialogs = _cls(CLS_DIALOGS)
        self._hook(_declared(dialogs, "createView", 1), after=self._after_screen)
        self._hook(_declared(dialogs, "onResume", 0), after=self._after_screen)

    def on_plugin_unload(self):
        for h in self._handles:
            self.unhook_method(h)
        self._handles = []
        self._adopted.clear()

    def _hook(self, methods, before=None, after=None):
        for m in methods:
            m.setAccessible(True)
            self._handles.append(self.hook_method(m, _make_hook(before, after)))

    def _after_screen(self, param):
        try:
            frag = param.thisObject
            if not _is_main(frag):
                return
            bar = get_private_field(frag, FIELD_ACTION_BAR)
            for f in _runnable_fields(bar):
                r = f.get(bar)
                if r is not None:
                    self._adopt(r)
        except Exception:
            pass

    def _adopt(self, r):
        rc = r.getClass()
        name = str(rc.getName())
        if not name.startswith(DIALOGS_PREFIX) or name in self._adopted:
            return
        self._adopted.add(name)
        self._hook(_declared(rc, "run", 0), before=self._before_run)

    def _before_run(self, param):
        try:
            owner = _owner(param.thisObject)
            if owner is None or not _is_main(owner):
                return
            _open_proxy_screen(owner)
            param.setResult(None)
        except Exception:
            pass
