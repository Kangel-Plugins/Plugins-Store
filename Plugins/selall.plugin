__id__ = "selall"
__name__ = "Select All"
__description__ = "Выделение всех медиа, гифок, ссылок и т.д. в профиле\nSelect all Media, GIFs, links, etc. in profile"
__author__ = "@ka1Plugins"
__version__ = "1.0"
__icon__ = "ka1Plugins/2"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.7"

from base_plugin import BasePlugin, MethodHook
from android_utils import run_on_ui_thread, OnClickListener
from hook_utils import find_class, get_private_field
from java.lang import Boolean
from android.view import View, ViewGroup
from android.widget import ImageView, LinearLayout
from org.telegram.messenger import AndroidUtilities, MessagesController, MessageObject, LocaleController
from org.telegram.ui.ActionBar import Theme
from org.telegram.tgnet import TLRPC, RequestDelegate
from java import dynamic_proxy
from client_utils import send_request, get_account_instance
from ui.settings import Switch, Divider

def get_icon(context):
    try: return context.getResources().getIdentifier("msg_select", "drawable", context.getPackageName())
    except Exception: return 0

def get_msgs(layout):
    try:
        data = get_private_field(layout, "sharedMediaData")
        tab = layout.getClosestTab()
        if tab == 15: return get_private_field(data[8], "messages")
        if 0 <= tab <= 5: return get_private_field(data[tab], "messages")
        
        adapter = get_private_field(layout, "archivedStoriesAdapter" if tab == 9 else "storiesAdapter")
        if adapter:
            if lst := get_private_field(adapter, "storiesList"):
                return get_private_field(lst, "messageObjects")
    except Exception: pass
    return None

def get_total_count(layout):
    try:
        data = get_private_field(layout, "sharedMediaData")
        tab = layout.getClosestTab()
        if tab == 15: return data[8].getTotalCount()
        if 0 <= tab <= 5: return data[tab].getTotalCount()
        
        adapter = get_private_field(layout, "archivedStoriesAdapter" if tab == 9 else "storiesAdapter")
        if adapter:
            if lst := get_private_field(adapter, "storiesList"):
                return lst.getCount()
    except Exception: pass
    return 0

def update_visibility(layout, remove_limit):
    try:
        if not (aml := get_private_field(layout, "actionModeLayout")): return
        if not (iv := aml.findViewWithTag(99999)): return
        if not (sel := get_private_field(layout, "selectedFiles")): return

        total_selected = sel[0].size() + sel[1].size()
        limit = 999999 if remove_limit else 100
        total_items = get_total_count(layout)
        
        max_selectable = min(total_items, limit) if total_items > 0 else limit
        hide = total_selected > 0 and total_selected >= max_selectable
        
        iv.setClickable(not hide)
        target_alpha = 0.0 if hide else 1.0
        target_scale = 0.1 if hide else 1.0

        if abs(iv.getAlpha() - target_alpha) > 0.1:
            iv.animate().alpha(target_alpha).scaleY(target_scale).setDuration(150).start()
    except Exception: pass

class ActionModeHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            layout = param.thisObject
            show = param.args[0]
            if not (delegate := get_private_field(layout, "delegate")) or "ProfileActivity" not in delegate.getClass().getName(): return

            remove_limit = self.plugin.get_setting("remove_limit", False)

            def update_ui():
                try:
                    if not (aml := get_private_field(layout, "actionModeLayout")): return
                    iv = aml.findViewWithTag(99999)

                    if show:
                        if not iv:
                            if not (res_id := get_icon(aml.getContext())): return
                            iv = ImageView(aml.getContext())
                            iv.setTag(99999)
                            iv.setImageResource(res_id)
                            iv.setScaleType(ImageView.ScaleType.CENTER)
                            iv.setContentDescription("Выбрать всё / Select All")
                            iv.setColorFilter(Theme.getColor(Theme.key_actionBarActionModeDefaultIcon))
                            iv.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_actionBarActionModeDefaultSelector), 1))
                            iv.setLayoutParams(LinearLayout.LayoutParams(AndroidUtilities.dp(54), ViewGroup.LayoutParams.MATCH_PARENT))
                            iv.setOnClickListener(OnClickListener(lambda v: self.select_all(layout, remove_limit)))
                            
                            if views := get_private_field(layout, "actionModeViews"):
                                views.add(iv)

                            goto = get_private_field(layout, "gotoItem")
                            idx = aml.indexOfChild(goto) if goto else -1
                            
                            if idx != -1: aml.addView(iv, idx)
                            else: aml.addView(iv)
                            iv.setAlpha(0.0)
                            iv.setScaleY(0.1)
                        
                        if iv: update_visibility(layout, remove_limit)
                    elif iv:
                        iv.animate().alpha(0.0).scaleY(0.1).setDuration(150).start()
                except Exception: pass
            run_on_ui_thread(update_ui)
        except Exception: pass

    def _update_ui(self, layout, sel, remove_limit):
        try:
            cant_del = 0
            for i in range(sel[0].size()):
                if not sel[0].valueAt(i).canDeleteMessage(False, None): cant_del += 1
            for i in range(sel[1].size()):
                if not sel[1].valueAt(i).canDeleteMessage(False, None): cant_del += 1

            if count := get_private_field(layout, "selectedMessagesCountTextView"):
                count.setNumber(sel[0].size() + sel[1].size(), True)
            if del_item := get_private_field(layout, "deleteItem"):
                del_item.setVisibility(View.VISIBLE if cant_del == 0 else View.GONE)
            
            tab = layout.getClosestTab()
            is_spec = tab in (8, 13, 14)
            
            if goto := get_private_field(layout, "gotoItem"):
                goto.setVisibility(View.VISIBLE if (not is_spec and sel[0].size() == 1) else View.GONE)
            
            if fwd := get_private_field(layout, "forwardItem"):
                fwd.setVisibility(View.GONE if is_spec else View.VISIBLE)

            try: layout.updateStoriesPinButton()
            except Exception: pass
            
            layout.onActionModeSelectedUpdate(sel[0])
            
            if lv := layout.getCurrentListView():
                if adapter := lv.getAdapter(): adapter.notifyDataSetChanged()
                
            update_visibility(layout, remove_limit)
        except Exception: pass

    def _select_local(self, layout, sel, did, limit, remove_limit):
        msgs = get_msgs(layout)
        sel[0].clear()
        sel[1].clear()
        if msgs:
            for i in range(min(msgs.size(), limit)):
                msg = msgs.get(i)
                idx = 0 if msg.getDialogId() == did else 1
                sel[idx].put(msg.getId(), msg)
        self._update_ui(layout, sel, remove_limit)

    def fetch_messages(self, layout, sel, offset_id, limit, remove_limit):
        did = get_private_field(layout, "dialog_id")
        tab = layout.getClosestTab()
        
        if tab not in (0, 1, 2, 3, 4, 5):
            self._select_local(layout, sel, did, limit, remove_limit)
            return
            
        account = get_account_instance().getCurrentAccount()
        req = TLRPC.TL_messages_search()
        req.peer = MessagesController.getInstance(account).getInputPeer(did)
        req.q = ""
        req.limit = limit
        req.offset_id = offset_id
        
        if tab == 0: req.filter = TLRPC.TL_inputMessagesFilterPhotoVideo()
        elif tab == 1: req.filter = TLRPC.TL_inputMessagesFilterDocument()
        elif tab == 2: req.filter = TLRPC.TL_inputMessagesFilterRoundVoice()
        elif tab == 3: req.filter = TLRPC.TL_inputMessagesFilterUrl()
        elif tab == 4: req.filter = TLRPC.TL_inputMessagesFilterMusic()
        elif tab == 5: req.filter = TLRPC.TL_inputMessagesFilterGif()
        
        def process_response(response):
            if not response: return
            try:
                added = 0
                for i in range(response.messages.size()):
                    if added >= limit: break
                    msg_obj = MessageObject(account, response.messages.get(i), False, False)
                    idx = 0 if msg_obj.getDialogId() == did else 1
                    if sel[idx].indexOfKey(msg_obj.getId()) < 0:
                        sel[idx].put(msg_obj.getId(), msg_obj)
                        added += 1
                self._update_ui(layout, sel, remove_limit)
            except Exception: pass
        
        class Callback(dynamic_proxy(RequestDelegate)):
            def run(self, response, error):
                if error is None:
                    run_on_ui_thread(lambda: process_response(response))
        
        send_request(req, Callback())

    def select_all(self, layout, remove_limit):
        try:
            if not (sel := get_private_field(layout, "selectedFiles")): return
            did = get_private_field(layout, "dialog_id")
            current_count = sel[0].size() + sel[1].size()
            
            if not remove_limit and current_count >= 100:
                return
                
            if current_count <= 1:
                sel[0].clear()
                sel[1].clear()
                limit = 100
                self.fetch_messages(layout, sel, 0, limit, remove_limit)
            else:
                min_id = 0
                for i in range(sel[0].size()):
                    id = sel[0].keyAt(i)
                    if min_id == 0 or id < min_id: min_id = id
                for i in range(sel[1].size()):
                    id = sel[1].keyAt(i)
                    if min_id == 0 or id < min_id: min_id = id
                    
                if min_id > 0:
                    limit = 100 if remove_limit else (100 - current_count)
                    if limit > 0:
                        self.fetch_messages(layout, sel, min_id, limit, remove_limit)
        except Exception: pass

class SelectionHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            layout = param.thisObject
            if not get_private_field(layout, "isActionModeShowed"): return
            if not (delegate := get_private_field(layout, "delegate")) or "ProfileActivity" not in delegate.getClass().getName(): return
            
            remove_limit = self.plugin.get_setting("remove_limit", False)
            run_on_ui_thread(lambda: update_visibility(layout, remove_limit))
        except Exception: pass

class ProfileSelectAllPlugin(BasePlugin):
    def _t(self, ru, en):
        try:
            if "ru" in LocaleController.getInstance().getCurrentLocaleInfo().pluralLangCode:
                return ru
        except Exception:
            pass
        return en

    def create_settings(self):
        return [
            Switch(
                "remove_limit",
                self._t("Снять лимит выделения", "Remove selection limit"),
                default=False
            ),
            Divider(text=self._t(
                "Убирает лимит, засчёт того, что выделяется каждый раз по 100, учтите это!",
                "Removes the limit by selecting 100 at a time, be aware!"
            ))
        ]

    def on_plugin_load(self):
        try:
            if clazz := find_class("org.telegram.ui.Components.SharedMediaLayout").getClass():
                m1 = clazz.getDeclaredMethod("showActionMode", Boolean.TYPE)
                m1.setAccessible(True)
                self.hook_method(m1, ActionModeHook(self))
                
                for m in clazz.getDeclaredMethods():
                    if m.getName() == "onActionModeSelectedUpdate":
                        m.setAccessible(True)
                        self.hook_method(m, SelectionHook(self))
                        break
        except Exception: pass

    def on_plugin_unload(self):
        pass