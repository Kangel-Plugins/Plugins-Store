def _find_field(obj, name):
    cls = obj.getClass()
    while cls is not None:
        try:
            f = cls.getDeclaredField(name)
            f.setAccessible(True)
            return f
        except Exception:
            cls = cls.getSuperclass()
    return None

def _find_method(obj, name, nparams):
    cls = obj.getClass()
    while cls is not None:
        for m in cls.getDeclaredMethods():
            if m.getName() == name and len(m.getParameterTypes()) == nparams:
                m.setAccessible(True)
                return m
        cls = cls.getSuperclass()
    return None

def _to_int(v, default=0):
    try:
        if hasattr(v, 'intValue'):
            return int(v.intValue())
        return int(v)
    except Exception:
        return default

def _to_bool(v, default=True):
    try:
        if hasattr(v, 'booleanValue'):
            return bool(v.booleanValue())
        return bool(v)
    except Exception:
        return default

def _find_class(name):
    try:
        from hook_utils import find_class
        c = find_class(name)
        if c is not None:
            return c
    except Exception:
        pass
    return jclass(name).getClass()

def _signed(v):
    v = int(v) & 4294967295
    return v - (1 << 32) if v >= 1 << 31 else v

def _argb(alpha, color):
    return _signed((alpha & 255) << 24 | int(color) & 16777215)

def _dp(x):
    return AndroidUtilities.dp(float(x))

def _ci(c):
    return jint(int(c))

def _wy(view):
    arr = jarray(jint)(2)
    view.getLocationInWindow(arr)
    return int(arr[1])

def _clicker(fn):

    class Click(dynamic_proxy(View.OnClickListener)):

        def onClick(self, v):
            try:
                fn()
            except Exception:
                pass
    return Click()

def _theme_color(name, res, default):
    try:
        key = getattr(Theme, name)
    except Exception:
        return default
    attempts = []
    if res is not None:
        attempts.append(lambda: Theme.getColor(key, res))
    attempts.append(lambda: Theme.getColor(key))
    for fn in attempts:
        try:
            return _signed(fn())
        except Exception:
            continue
    return default

def _arc(path, x1, y1, r, large, sweep, x2, y2):
    dx, dy = ((x1 - x2) / 2.0, (y1 - y2) / 2.0)
    d2 = dx * dx + dy * dy
    if d2 == 0:
        return
    r = max(r, math.sqrt(d2))
    factor = math.sqrt(max(0.0, (r * r - d2) / d2))
    if bool(large) == bool(sweep):
        factor = -factor
    cx = factor * dy + (x1 + x2) / 2.0
    cy = -factor * dx + (y1 + y2) / 2.0
    a1 = math.atan2(y1 - cy, x1 - cx)
    a2 = math.atan2(y2 - cy, x2 - cx)
    delta = a2 - a1
    if sweep and delta < 0:
        delta += 2 * math.pi
    elif not sweep and delta > 0:
        delta -= 2 * math.pi
    path.arcTo(float(cx - r), float(cy - r), float(cx + r), float(cy + r), float(math.degrees(a1)), float(math.degrees(delta)), False)

_TOKENS = re.compile('[MmLlHhVvAaZz]|[-+]?(?:\\d*\\.\\d+|\\d+\\.?)(?:[eE][-+]?\\d+)?')

def _svg_path(d, path=None):
    path = path if path is not None else Path()
    tokens = _TOKENS.findall(d)
    pos = [0]

    def num():
        v = float(tokens[pos[0]])
        pos[0] += 1
        return v
    x = y = sx = sy = 0.0
    cmd = None
    while pos[0] < len(tokens):
        t = tokens[pos[0]]
        if t.isalpha():
            cmd = t
            pos[0] += 1
            if cmd in 'Zz':
                path.close()
                x, y = (sx, sy)
                continue
        c = cmd
        if c in 'Mm':
            nx, ny = (num(), num())
            x, y = (nx, ny) if c == 'M' else (x + nx, y + ny)
            path.moveTo(float(x), float(y))
            sx, sy = (x, y)
            cmd = 'L' if c == 'M' else 'l'
        elif c in 'Ll':
            nx, ny = (num(), num())
            x, y = (nx, ny) if c == 'L' else (x + nx, y + ny)
            path.lineTo(float(x), float(y))
        elif c in 'Hh':
            nx = num()
            x = nx if c == 'H' else x + nx
            path.lineTo(float(x), float(y))
        elif c in 'Vv':
            ny = num()
            y = ny if c == 'V' else y + ny
            path.lineTo(float(x), float(y))
        elif c in 'Aa':
            rx, _ry, _rot, large, sweep, ex, ey = (num(), num(), num(), num(), num(), num(), num())
            if c == 'a':
                ex, ey = (x + ex, y + ey)
            _arc(path, x, y, rx, int(large), int(sweep), ex, ey)
            x, y = (ex, ey)
        else:
            break
    return path

def _round_rect(path, x, y, w, h, r):
    path.addRoundRect(RectF(float(x), float(y), float(x + w), float(y + h)), float(r), float(r), Path.Direction.CW)

def _make_icon(kind):
    p = Path()
    if kind == 'play':
        _svg_path(PATH_PLAY, p)
    elif kind == 'pause':
        _round_rect(p, 6.0, 5.0, 4.6, 14.0, 1.6)
        _round_rect(p, 13.4, 5.0, 4.6, 14.0, 1.6)
    elif kind == 'next':
        _round_rect(p, 16.4, 5.5, 2.6, 13.0, 1.2)
        _svg_path(PATH_NEXT_TRI, p)
    elif kind == 'prev':
        _round_rect(p, 16.4, 5.5, 2.6, 13.0, 1.2)
        _svg_path(PATH_NEXT_TRI, p)
        m = Matrix()
        m.setScale(-1.0, 1.0, 12.0, 12.0)
        p.transform(m)
    elif kind == 'close':
        _svg_path(PATH_CLOSE, p)
    elif kind == 'note':
        _svg_path(PATH_NOTE, p)
        p.addCircle(6.5, 17.0, 2.5, Path.Direction.CW)
        p.addCircle(17.5, 15.0, 2.5, Path.Direction.CW)
    return p

def _draw_icon(canvas, path, left, top, size, color, stroke):
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setColor(_ci(color))
    canvas.save()
    canvas.translate(float(left), float(top))
    s = size / 24.0
    canvas.scale(float(s), float(s))
    if stroke:
        paint.setStyle(Paint.Style.STROKE)
        paint.setStrokeWidth(2.0)
        paint.setStrokeCap(Paint.Cap.ROUND)
        paint.setStrokeJoin(Paint.Join.ROUND)
    else:
        paint.setStyle(Paint.Style.FILL)
    canvas.drawPath(path, paint)
    canvas.restore()

def _icon_bitmap(kind, box_dp, icon_dp, color, stroke):
    box, size = (_dp(box_dp), _dp(icon_dp))
    bmp = Bitmap.createBitmap(box, box, Bitmap.Config.ARGB_8888)
    c = Canvas(bmp)
    off = (box - size) / 2.0
    _draw_icon(c, _make_icon(kind), off, off, size, color, stroke)
    return bmp

def _full_location(mo):
    try:
        url = mo.getArtworkUrl(False)
        if url:
            return ImageLocation.getForPath(url)
    except Exception:
        pass
    return None

def _thumb_location(mo):
    try:
        doc = mo.getDocument()
        if doc is not None:
            size = FileLoader.getClosestPhotoSizeWithSize(doc.thumbs, 360)
            if size is not None and size.getClass().getSimpleName() in ('TL_photoSize', 'TL_photoSizeProgressive'):
                return ImageLocation.getForDocument(size, doc)
    except Exception:
        pass
    try:
        url = mo.getArtworkUrl(True)
        if url:
            return ImageLocation.getForPath(url)
    except Exception:
        pass
    return None

def _art_key(mo):
    try:
        doc = mo.getDocument()
        if doc is not None and doc.id != 0:
            return 'd%d' % doc.id
        return 'm%d_%d' % (mo.getDialogId(), mo.getId())
    except Exception:
        return 'm%s' % mo.getId()

