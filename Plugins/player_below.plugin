SPARSE_ITEMS = 9
NARROW_RATIO = 0.6
NARROW_DELAY = 0.3
FOREIGN_DELAY = 0.4
EXCLUDE_WORDS = [' vs. ', ' vs ', ' versus ', ' ft.', ' ft ', ' featuring ', ' feat.', ' feat ', ' presents ', ' pres. ', ' pres ', ' and ', ' & ', ' . ']
_HOST_DEAD = {}

def _http_stream(url, timeout=4000):
    host = url.split('/')[2] if '://' in url else url
    if time.monotonic() < _HOST_DEAD.get(host, 0.0):
        raise RuntimeError('%s skipped: it could not be reached a moment ago' % host)
    conn = jclass('java.net.URL')(url).openConnection()
    conn.setConnectTimeout(timeout)
    conn.setReadTimeout(timeout)
    conn.setRequestProperty('User-Agent', 'Mozilla/5.0')
    conn.setRequestProperty('Accept', 'application/json, image/*')
    try:
        return conn.getInputStream()
    except Exception as e:
        text = str(e)
        if 'resolve host' in text or 'Failed to connect' in text or 'timed out' in text.lower():
            _HOST_DEAD[host] = time.monotonic() + 180.0
        raise

def _http_text(url):
    stream = _http_stream(url)
    try:
        sc = jclass('java.util.Scanner')(stream, 'UTF-8').useDelimiter('\\A')
        return str(sc.next()) if sc.hasNext() else ''
    finally:
        stream.close()

def _http_bitmap(url):
    stream = _http_stream(url)
    try:
        return BitmapFactory.decodeStream(stream)
    finally:
        stream.close()

def _artwork_terms(mo):
    performer = title = ''
    try:
        for a in mo.getDocument().attributes:
            if a.getClass().getSimpleName() == 'TL_documentAttributeAudio':
                performer = str(a.performer or '')
                title = str(a.title or '')
                break
    except Exception:
        pass
    if not performer and (not title):
        try:
            performer = str(mo.getMusicAuthor() or '')
            title = str(mo.getMusicTitle() or '')
        except Exception:
            pass
    for w in EXCLUDE_WORDS:
        performer = performer.replace(w, ' ')
    return (performer.strip(), title.strip())

def _itunes_cover(term):
    q = jclass('java.net.URLEncoder').encode(term, 'UTF-8')
    data = json.loads(_http_text('https://itunes.apple.com/search?term=%s&entity=song&limit=4' % q))
    for r in data.get('results', []):
        url = r.get('artworkUrl100')
        if url:
            bmp = _http_bitmap(url.replace('100x100', '300x300'))
            if bmp is not None:
                return bmp
    return None

def _deezer_cover(performer, title):
    encoder = jclass('java.net.URLEncoder')
    queries = []
    if performer and title:
        queries.append('artist:"%s" track:"%s"' % (performer, title))
        queries.append('%s %s' % (performer, title))
    else:
        queries.append(title or performer)
    for q in queries:
        data = json.loads(_http_text('https://api.deezer.com/search?limit=4&q=%s' % encoder.encode(q, 'UTF-8')))
        for t in data.get('data') or []:
            album = t.get('album') or {}
            url = album.get('cover_big') or album.get('cover_medium')
            if url:
                bmp = _http_bitmap(url)
                if bmp is not None:
                    return bmp
    return None

def _fetch_artwork(performer, title):
    parts = [x for x in (performer, title) if x]
    if not parts:
        return None
    attempts = [lambda: _deezer_cover(performer, title), lambda: _itunes_cover(' - '.join(parts))]
    for fn in attempts:
        try:
            bmp = fn()
            if bmp is not None:
                return bmp
        except Exception:
            pass
    return None

class _Bar(object):

    def __init__(self, plugin, fcv, res):
        self.plugin = plugin
        self.fcv = fcv
        self.mid = None
        self.paused = None
        self.pq = -1
        self.cover_key = None
        self.fixed = False
        self._keep = []
        ctx = fcv.getContext()
        self.c_bg = _theme_color('key_inappPlayerBackground', res, _signed(4280229663))
        self.c_title, self.c_artist, self.c_close, self.c_play, self.c_container, self.c_on_container = self._guard('colors', lambda: self._pick_colors(res), self._default_colors())
        root = FrameLayout(ctx)
        root.setTag(BAR_TAG)
        root.setBackgroundColor(0)
        root.setClickable(True)
        self._add_click(root, lambda: fcv.performClick())
        self.root = root

        def new_cover():
            v = BackupImageView(ctx)
            v.setRoundRadius(_dp(10))
            return v
        self.placeholder = self._guard('placeholder', lambda: self._make_placeholder(ctx))
        if self.placeholder is not None:
            ph = ImageView(ctx)
            ph.setScaleType(ImageView.ScaleType.FIT_XY)
            ph.setImageDrawable(self.placeholder)
            lp = FrameLayout.LayoutParams(_dp(36), _dp(36), Gravity.LEFT | Gravity.CENTER_VERTICAL)
            lp.leftMargin = _dp(12)
            root.addView(ph, lp)
        self.cover = self._guard('cover view', new_cover) or ImageView(ctx)
        lp = FrameLayout.LayoutParams(_dp(36), _dp(36), Gravity.LEFT | Gravity.CENTER_VERTICAL)
        lp.leftMargin = _dp(12)
        root.addView(self.cover, lp)
        col = LinearLayout(ctx)
        col.setOrientation(1)
        self.title = TextView(ctx)
        self.title.setTextSize(1, 15.0)
        self.title.setSingleLine(True)
        self.title.setEllipsize(TextUtils.TruncateAt.END)
        self.title.setTextColor(self.c_title)
        try:
            self.title.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        col.addView(self.title, LinearLayout.LayoutParams(-1, -2))
        self.artist = TextView(ctx)
        self.artist.setTextSize(1, 13.0)
        self.artist.setSingleLine(True)
        self.artist.setEllipsize(TextUtils.TruncateAt.END)
        self.artist.setTextColor(_argb(191, self.c_artist))
        col.addView(self.artist, LinearLayout.LayoutParams(-1, -2))
        lp = FrameLayout.LayoutParams(-1, -2, Gravity.LEFT | Gravity.CENTER_VERTICAL)
        lp.leftMargin = _dp(60)
        lp.rightMargin = _dp(160)
        root.addView(col, lp)
        row = LinearLayout(ctx)
        row.setOrientation(0)
        self.prev = ImageView(ctx)
        self.prev.setScaleType(ImageView.ScaleType.CENTER)
        self.prev.setImageBitmap(self._guard('prev icon', lambda: _icon_bitmap('prev', 30, 22, self.c_close, False)) or self._fallback_icon('next', self.c_close))
        row.addView(self.prev, LinearLayout.LayoutParams(_dp(30), _dp(40)))
        self.play = ImageView(ctx)
        self.play.setScaleType(ImageView.ScaleType.CENTER)
        row.addView(self.play, LinearLayout.LayoutParams(_dp(40), _dp(40)))
        self.nxt = ImageView(ctx)
        self.nxt.setScaleType(ImageView.ScaleType.CENTER)
        self.nxt.setImageBitmap(self._guard('next icon', lambda: _icon_bitmap('next', 30, 22, self.c_close, False)) or self._fallback_icon('next', self.c_close))
        row.addView(self.nxt, LinearLayout.LayoutParams(_dp(30), _dp(40)))
        self.close = ImageView(ctx)
        self.close.setScaleType(ImageView.ScaleType.CENTER)
        self.close.setImageBitmap(self._guard('close icon', lambda: _icon_bitmap('close', 30, 20, self.c_close, True)) or self._fallback_icon('close', self.c_close))
        row.addView(self.close, LinearLayout.LayoutParams(_dp(30), _dp(40)))
        lp = FrameLayout.LayoutParams(-2, _dp(40), Gravity.RIGHT | Gravity.CENTER_VERTICAL)
        lp.rightMargin = _dp(6)
        root.addView(row, lp)
        for v in (self.prev, self.play, self.nxt, self.close):
            try:
                v.setBackground(Theme.createSelectorDrawable(436207615, 1))
            except Exception:
                pass
        self._add_click(self.prev, lambda: MediaController.getInstance().playPreviousMessage())
        self._add_click(self.play, self._toggle)
        self._add_click(self.nxt, lambda: MediaController.getInstance().playNextMessage())
        self._add_click(self.close, lambda: MediaController.getInstance().cleanupPlayer(True, True))

    @staticmethod
    def _lum(c):
        return (0.299 * (c >> 16 & 255) + 0.587 * (c >> 8 & 255) + 0.114 * (c & 255)) / 255.0

    def _bg_for_contrast(self):
        return self.c_bg if self.c_bg >> 24 & 255 > 150 else _signed(4280295456)

    def _default_colors(self):
        dark = self._lum(self._bg_for_contrast()) < 0.5
        white = _signed(4294967295) if dark else _signed(4280361249)
        gray = _signed(4289967027) if dark else _signed(4285887861)
        return (white, gray, gray, white, _argb(46, white), gray)

    def _pick_colors(self, res):
        bg = self._bg_for_contrast()
        white, gray = self._default_colors()[:2]

        def pick(folder_key, md3_key, default):
            col = _theme_color(folder_key, res, 0)
            if not col >> 24 & 255:
                col = _theme_color(md3_key, res, 0)
            if not col >> 24 & 255:
                return default
            r, g, b = (col >> 16 & 255, col >> 8 & 255, col & 255)
            mx, mn = (max(r, g, b), min(r, g, b))
            sat = (mx - mn) / float(mx) if mx else 0.0
            if sat > 0.3 or abs(self._lum(col) - self._lum(bg)) < 0.3:
                return default
            return col
        title = pick('key_actionBarTabActiveText', 'key_inappPlayerPerformer', white)
        artist = pick('key_actionBarTabUnactiveText', 'key_inappPlayerTitle', gray)
        close = pick('key_actionBarTabUnactiveText', 'key_inappPlayerClose', gray)
        play = pick('key_actionBarTabActiveText', 'key_inappPlayerPlayPause', white)
        return (title, artist, close, play, _argb(46, title), close)

    def _guard(self, what, fn, default=None):
        try:
            return fn()
        except Exception as e:
            return default

    def _fallback_icon(self, kind, color):
        size = _dp(30)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        c = Canvas(bmp)
        p = Paint(Paint.ANTI_ALIAS_FLAG)
        p.setColor(_ci(color))
        s = float(size)
        if kind == 'close':
            p.setStyle(Paint.Style.STROKE)
            p.setStrokeWidth(float(_dp(1.8)))
            c.drawLine(s * 0.34, s * 0.34, s * 0.66, s * 0.66, p)
            c.drawLine(s * 0.66, s * 0.34, s * 0.34, s * 0.66, p)
        else:
            p.setStyle(Paint.Style.FILL)
            c.drawRect(s * 0.34, s * 0.3, s * 0.4, s * 0.7, p)
            c.drawRect(s * 0.46, s * 0.3, s * 0.52, s * 0.7, p)
        return bmp

    def _add_click(self, view, fn):
        l = _clicker(fn)
        self._keep.append(l)
        view.setOnClickListener(l)

    def _toggle(self):
        mc = MediaController.getInstance()
        mo = mc.getPlayingMessageObject()
        if mo is None:
            return
        if mc.isMessagePaused():
            mc.playMessage(mo)
        else:
            mc.pauseMessage(mo)

    def _make_placeholder(self, ctx):
        size = _dp(36)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        c = Canvas(bmp)
        p = Paint(Paint.ANTI_ALIAS_FLAG)
        p.setColor(_ci(self.c_container))
        r = float(_dp(10))
        c.drawRoundRect(RectF(0.0, 0.0, float(size), float(size)), r, r, p)
        icon = size * 0.5
        off = (size - icon) / 2.0
        note = _make_icon('note')
        _draw_icon(c, note, off, off, icon, self.c_on_container, True)
        return BitmapDrawable(ctx.getResources(), bmp)

    def _draw_play(self, paused, prog):
        size = _dp(40)
        bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        c = Canvas(bmp)
        s = float(size)
        r = float(_dp(15))
        p = Paint(Paint.ANTI_ALIAS_FLAG)
        p.setStyle(Paint.Style.STROKE)
        p.setStrokeWidth(float(_dp(2.5)))
        p.setColor(_ci(_argb(51, self.c_play)))
        c.drawCircle(s / 2.0, s / 2.0, r, p)
        if prog > 0:
            p.setStrokeCap(Paint.Cap.ROUND)
            p.setStrokeJoin(Paint.Join.ROUND)
            p.setColor(_ci(self.c_play))
            c.drawArc(RectF(s / 2.0 - r, s / 2.0 - r, s / 2.0 + r, s / 2.0 + r), -90.0, 360.0 * prog, False, p)
        isz = _dp(16)
        off = (size - isz) / 2.0
        _draw_icon(c, _make_icon('play' if paused else 'pause'), off, off, isz, self.c_play, False)
        self.play.setImageBitmap(bmp)

    def _apply_cover(self, mo):
        mc = MediaController.getInstance()
        bmp = None
        try:
            ai = mc.getAudioInfo()
            if ai is not None:
                bmp = ai.getCover()
                if bmp is not None and bmp.isRecycled():
                    bmp = None
        except Exception as e:
            bmp = None
        key = (_art_key(mo), bmp is not None)
        if key == self.cover_key:
            return
        self.cover_key = key
        if bmp is not None:
            self.cover.setImageBitmap(bmp)
            return
        full = _full_location(mo)
        thumb = _thumb_location(mo)
        if hasattr(self.cover, 'setImage'):
            if full is None and thumb is None:
                self.cover.setImageDrawable(None)
            else:
                IL = jclass('org.telegram.messenger.ImageLocation')
                S = jclass('java.lang.String')
                O = jclass('java.lang.Object')
                try:
                    self.cover.setImage(cast(IL, full), cast(S, None), cast(IL, thumb), cast(S, None), cast(S, None), jlong(0), jint(1), cast(O, mo))
                except Exception as e:
                    try:
                        self.cover.setImage(cast(IL, thumb or full), cast(S, None), self.placeholder, cast(O, mo))
                    except Exception as e2:
                        pass
        self.plugin._request_remote_cover(self, mo, key[0])

    def set_remote_cover(self, key, bmp):
        if bmp is None or self.cover_key is None or self.cover_key[0] != key or self.cover_key[1]:
            return
        try:
            rec = self.cover.getImageReceiver()
            if rec.hasNotThumb():
                return
        except Exception:
            pass
        self.cover.setImageBitmap(bmp)

    def update(self):
        mc = MediaController.getInstance()
        mo = mc.getPlayingMessageObject()
        if mo is None:
            return
        try:
            if not mo.isMusic():
                return
        except Exception:
            pass
        mid = mo.getId()
        if mid != self.mid:
            self.mid = mid
            self.paused = None
            self.cover_key = None
            try:
                self.title.setText(str(mo.getMusicTitle() or ''))
                self.artist.setText(str(mo.getMusicAuthor() or ''))
            except Exception:
                pass
        self._guard('cover', lambda: self._apply_cover(mo))
        paused = bool(mc.isMessagePaused())
        prog = float(mo.audioProgress)
        q = int(prog * 120)
        if paused != self.paused or q != self.pq:
            self.paused, self.pq = (paused, q)
            self._guard('ring', lambda: self._draw_play(paused, prog))

class _TopicsState(object):

    def __init__(self):
        self.shift = {}
        self.margins = {}
        self.fab_orig = {}
        self.root = None

class _Ctx(object):

    def __init__(self, dialogs, panel, root):
        self.dialogs = dialogs
        self.panel = panel
        self.panel_hash = panel.hashCode()
        self.root = root
        self.parent = panel.getParent()
        self.lists = []
        self.c = None
        self.stock_ty = float(panel.getTranslationY())
        self.my_ty = None
        self.applied = False
        self.last_extra = 0.0
        self.aft_last = None
        self.listener = None
        self.fade_dirty = True
        self.blur_my_top = None
        self.blur_extra = 0.0
        self.fcv = None
        self.shift = {}
        self.margins = {}
        self.last_top_name = None
        self.foreign_since = None
        self.top_t = 0.0
        self.top_reason = None
        self.narrow_since = None
        self.all_lists = []
        self.all_lists_t = 0.0
        self.tv_t = 0.0
        self.c_t = 0.0
        self.last_want = 0.0
        self.sty_t = 0.0
        self.mchk_t = 0.0
        self.sty_v = True
        self.fcv_all = []
        self.sparse = {}
        self.sparse_t = 0.0
        self.fcv_all_t = 0.0
        self.bottom_ty = None
        self.shift_full = 0.0
        self.last_h = 0.0
        self.margin_key = None
        self.extra_lists = {}
        self.extra_margin = {}
        self.extra_fabs = {}
        self.fab_orig = {}
        self.blur_pending = False
        self.fade_hidden = False
        self.sh_call = 0.0
        self.tv_name = None

class Plugin(BasePlugin):

    def _retire_old_instances(self):
        for o in gc.get_objects():
            try:
                if o is self or type(o).__name__ != 'Plugin':
                    continue
                if not (hasattr(o, '_bars') and hasattr(o, '_ctxs') and hasattr(o, '_cfg')):
                    continue
                o._enabled = False
                for ctx in list(o._ctxs.values()):
                    try:
                        o._restore(ctx)
                        o._detach(ctx)
                    except Exception:
                        pass
                try:
                    o._teardown_bars()
                except Exception:
                    pass
                retired += 1
            except Exception:
                continue

    def on_plugin_load(self):
        self._safe(self._retire_old_instances)
        self._enabled = True
        self._busy = False
        self._last_play = -100.0
        self._fields = {}
        self._ffields = {}
        self._methods = {}
        self._ctxs = {}
        self._bars = {}
        self._fcvs = {}
        self._dialogs_fcv = {}
        self._stash = {}
        self._ticking = False
        self._cover_cache = {}
        self._cover_pending = set()
        self._cover_fail = {}
        self._lookup_lock = threading.Lock()
        self._resetting = set()
        self._forced = set()
        self._settle_pending = set()
        self._topics_seen = {}
        self._topics_event_t = 0.0
        self._tstate = _TopicsState()
        self._topic_owner = {}
        self._rv_cache = {}
        self._fab_cache = {}
        self._ta_t = 0.0
        self._ta_v = False
        self._fade_suppress = False
        self._fade_ids = set()
        self._fade_hooked_classes = set()
        self._fade_hooked = False
        self._topics_last = None
        self._topics_hooked = False
        self._topics_state = {}
        self._topics_frags = {}
        self._top_cands = {}
        self._cfg = {'style': _to_bool(self.get_setting('style', True), True), 'gap': _to_int(self.get_setting('bnb', 0), 0), 'position': 0 if self._placement() == 1 else 1, 'fab_trim': _to_int(self.get_setting('fab_lift2', 1), 1), 'topics_bottom': False}
        self._cfg['topics_bottom'] = self._cfg['position'] == 0
        plugin = self

        class UpdateHook(MethodHook):

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_update, param)

        class FabHook(MethodHook):

            def before_hooked_method(self, param):
                plugin._safe(plugin._on_fab_before, param)

        class BlurHook(MethodHook):

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_blur, param)

        class CheckHook(MethodHook):

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_check_player, param)

        class HeightHook(MethodHook):

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_style_height, param)

        class DrawHook(MethodHook):

            def before_hooked_method(self, param):
                plugin._safe(plugin._on_draw_before, param)

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_draw_after, param)

        class TopicsHook(MethodHook):

            def after_hooked_method(self, param):
                plugin._safe(plugin._on_topics_event, param)
        plan = [(DIALOGS_CLASS, 'updateContextViewPosition', UpdateHook), (DIALOGS_CLASS, 'updateFloatingButtonOffset', FabHook), (FCV_CLASS, 'checkPlayer', CheckHook), (FCV_CLASS, 'getStyleHeight', HeightHook), (FCV_CLASS, 'dispatchDraw', DrawHook), (DIALOGS_CLASS, 'blur3_InvalidateBlur', BlurHook)] + [(TOPICS_CLASS, m, TopicsHook) for m in TOPICS_EVENTS]
        for cls_name, method, hook_cls in plan:
            try:
                self._hook(_find_class(cls_name), method, hook_cls())
            except Exception:
                pass
        self._safe(self._restore_md3)

    def on_plugin_unload(self):
        self._enabled = False
        for ctx in list(self._ctxs.values()):
            self._safe(self._restore, ctx)
            self._safe(self._shadow_off, ctx)
            self._safe(self._detach, ctx)
        self._ctxs.clear()
        self._safe(self._teardown_bars, True)
        self._safe(self._restore_md3)

    def _hook(self, cls, name, hook):
        try:
            return self.hook_all_methods(cls, name, hook, priority=100)
        except TypeError:
            pass
        try:
            return self.hook_all_methods(cls, name, hook)
        except Exception:
            pass
        for m in cls.getDeclaredMethods():
            if m.getName() == name:
                self.hook_method(m, hook)

    def _safe(self, fn, *args):
        try:
            fn(*args)
        except Exception:
            pass

    def _md3_instance(self):
        for o in gc.get_objects():
            try:
                if type(o).__name__ == 'Md3PlayerPlugin':
                    return o
            except Exception:
                continue
        return None

    def _restore_md3(self):
        prev = self.get_setting('md3_prev', '')
        if not prev:
            return
        o = self._md3_instance()
        if o is None:
            return
        try:
            mini, ctxb = [x == '1' for x in str(prev).split(',')]
            o.set_setting('mini_player_dialogs', mini, reload_settings=True)
            o.set_setting('context_bar_enabled', ctxb, reload_settings=True)
            o.apply_settings()
            self.set_setting('md3_prev', '')
        except Exception:
            pass

    def _suppress_md3(self, fcv):
        try:
            if fcv.findViewWithTag('md3_player_bar') is not None:
                return True
        except Exception:
            pass
        return False

    def _field(self, obj, name):
        f = self._fields.get(name)
        if f is None:
            f = _find_field(obj, name) or False
            self._fields[name] = f
        return f

    def _get(self, obj, name):
        f = self._field(obj, name)
        try:
            return f.get(obj) if f else None
        except Exception:
            return None

    def _ffield(self, obj, name):
        f = self._ffields.get(name)
        if f is None:
            f = _find_field(obj, name) or False
            self._ffields[name] = f
        return f

    def _fget(self, obj, name):
        f = self._ffield(obj, name)
        try:
            return f.get(obj) if f else None
        except Exception:
            return None

    def _call(self, obj, name):
        m = self._methods.get(name)
        if m is None:
            m = _find_method(obj, name, 0) or False
            self._methods[name] = m
        return m.invoke(obj) if m else None

    def _playing_msg(self):
        try:
            return MediaController.getInstance().getPlayingMessageObject()
        except Exception:
            return None

    def _moving(self):
        if not self._enabled or self._cfg['position'] != 0:
            return False
        now = time.monotonic()
        if self._playing_msg() is not None:
            self._last_play = now
            return True
        return now - self._last_play < GRACE_SECONDS

    def _gap_px(self):
        idx = max(0, min(self._cfg['gap'], len(GAP_VALUES_DP) - 1))
        return _dp(GAP_VALUES_DP[idx])

    def _top_fix_px(self):
        return _dp(9)

    def _fab_px(self, extra):
        if extra <= 0:
            return 0.0
        idx = max(0, min(self._cfg['fab_trim'], len(FAB_TRIM_DP) - 1))
        return max(0.0, extra - _dp(FAB_TRIM_DP[idx]))

    def _panel_h(self, panel):
        try:
            return float(panel.getAnimatedHeightWithPadding(jfloat(0.0)))
        except Exception:
            return float(panel.getHeight())

    def _fcv_in_dialogs(self, fcv):
        key = fcv.hashCode()
        v = self._dialogs_fcv.get(key)
        if v is None:
            v = False
            try:
                fragment = self._fget(fcv, 'fragment')
                if fragment is not None:
                    name = fragment.getClass().getName()
                    v = 'DialogsActivity' in name or 'MainTabsActivity' in name
            except Exception:
                v = False
            self._dialogs_fcv[key] = v
        return v

    def _is_music_style(self, fcv):
        if not (self._enabled and self._cfg['style']):
            return False
        mo = self._playing_msg()
        if mo is None:
            return False
        try:
            if not mo.isMusic() or mo.getId() == 0:
                return False
            f = self._ffield(fcv, 'currentStyle')
            style = f.getInt(fcv) if f else 0
            if self._fcv_in_dialogs(fcv):
                return style <= 0
            return style == 0
        except Exception:
            return False

    def _on_check_player(self, param):
        fcv = param.thisObject
        if not self._is_music_style(fcv):
            self._drop_bar(fcv)
            return
        self._show_bar(fcv)

    def _drop_bar(self, fcv):
        hid = self._hide_bar(fcv)
        key = fcv.hashCode()
        if not hid and key in self._forced:
            run_on_ui_thread(lambda: self._reset_plate(fcv))
        elif key in self._settle_pending:
            self._settle_pending.discard(key)
            run_on_ui_thread(lambda: self._after_reset(fcv), 350)

    def _show_bar(self, fcv):
        key = fcv.hashCode()
        self._fcvs[key] = fcv
        bar = self._bars.get(key)
        if bar is None or bar.root.getParent() is None:
            bar = _Bar(self, fcv, self._fget(fcv, 'resourcesProvider'))
            self._bars[key] = bar
            fcv.addView(bar.root, FrameLayout.LayoutParams(-1, _dp(BAR_DP), Gravity.TOP))
        h = _dp(BAR_DP)
        self._forced.add(key)
        for target in (fcv, self._fget(fcv, 'frameLayout')):
            if target is None:
                continue
            lp = target.getLayoutParams()
            if lp is not None and lp.height != h:
                lp.height = h
                target.requestLayout()
        try:
            fcv.setTopPadding(jfloat(AndroidUtilities.dp2(float(BAR_DP))))
        except Exception:
            pass
        for n in STOCK_VIEWS:
            v = self._fget(fcv, n)
            if v is not None:
                v.setVisibility(8)
        self._suppress_md3(fcv)
        bar.root.setVisibility(0)
        try:
            bar.update()
        except Exception:
            pass
        if not bar.fixed:
            bar.fixed = True
            self._fix_panels(fcv)
        self._start_tick()

    def _fix_panels(self, fcv):
        p = fcv.getParent()
        for _ in range(2):
            if p is None or not isinstance(p, View):
                break
            lp = p.getLayoutParams()
            if lp is not None and lp.height != -2:
                lp.height = -2
                p.requestLayout()
            p = p.getParent()
        try:
            fragment = self._fget(fcv, 'fragment')
            if fragment is not None:
                m = _find_method(fragment, 'invalidateChatListViewTopPadding', 0)
                if m is not None:
                    m.invoke(fragment)
        except Exception:
            pass

    def _hide_bar(self, fcv):
        bar = self._bars.get(fcv.hashCode())
        if bar is None or bar.root.getVisibility() == 8:
            return False
        bar.root.setVisibility(8)
        for n in RESTORE_VIEWS:
            v = self._fget(fcv, n)
            if v is not None:
                v.setVisibility(0)
        run_on_ui_thread(lambda: self._reset_plate(fcv))
        return True

    def _on_style_height(self, param):
        fcv = param.thisObject
        if self._is_music_style(fcv):
            param.setResult(jclass('java.lang.Integer').valueOf(jint(_dp(BAR_DP))))

    def _on_draw_before(self, param):
        fcv = param.thisObject
        key = fcv.hashCode()
        if not self._is_music_style(fcv):
            bar = self._bars.get(key)
            if bar is not None and bar.root.getVisibility() == 0:
                run_on_ui_thread(lambda: self._drop_bar(fcv))
            return
        f = self._ffield(fcv, 'currentStyle')
        if f and f.getInt(fcv) == 0:
            f.setInt(fcv, -1)
            self._stash[key] = 0

    def _on_draw_after(self, param):
        fcv = param.thisObject
        key = fcv.hashCode()
        if key in self._stash:
            orig = self._stash.pop(key)
            self._ffield(fcv, 'currentStyle').setInt(fcv, orig)

    def _start_tick(self):
        if self._ticking:
            return
        self._ticking = True
        run_on_ui_thread(self._tick, 250)

    def _tick(self):
        alive = False
        for key, bar in list(self._bars.items()):
            try:
                r = bar.root
                if r.getParent() is None:
                    self._bars.pop(key, None)
                elif r.getVisibility() == 0:
                    fcv = self._fcvs.get(key)
                    if fcv is not None and (not self._is_music_style(fcv)):
                        self._drop_bar(fcv)
                        continue
                    alive = True
                    bar.update()
            except Exception:
                pass
        if alive and self._enabled:
            run_on_ui_thread(self._tick, 250)
        else:
            self._ticking = False

    def _request_remote_cover(self, bar, mo, key):
        cached = self._cover_cache.get(key)
        if cached is not None:
            bar.set_remote_cover(key, cached)
            return
        if key in self._cover_pending or time.monotonic() < self._cover_fail.get(key, 0.0):
            return
        try:
            if not mo.isMusic():
                return
        except Exception:
            pass
        performer, title = _artwork_terms(mo)
        if not performer and (not title):
            return
        self._cover_pending.add(key)

        def work():
            bmp = None
            try:
                with self._lookup_lock:
                    bmp = _fetch_artwork(performer, title)
            except Exception:
                pass

            def done():
                self._cover_pending.discard(key)
                if bmp is not None:
                    if len(self._cover_cache) > 30:
                        self._cover_cache.clear()
                    self._cover_cache[key] = bmp
                    for b in list(self._bars.values()):
                        try:
                            b.set_remote_cover(key, bmp)
                        except Exception:
                            pass
                else:
                    self._cover_fail[key] = time.monotonic() + 120.0
            run_on_ui_thread(done)
        threading.Thread(target=work, daemon=True).start()

    def _recheck_players(self):
        for key, fcv in list(self._fcvs.items()):
            try:
                if not fcv.isAttachedToWindow():
                    self._fcvs.pop(key, None)
                    continue
                m = _find_method(fcv, 'checkPlayer', 1)
                if m is not None:
                    m.invoke(fcv, jclass('java.lang.Boolean').TRUE)
            except Exception:
                pass

    def _restore_plate_size(self, fcv):
        try:
            m = _find_method(fcv, 'getStyleHeight', 0)
            raw = int(m.invoke(fcv)) if m is not None else 0
        except Exception:
            raw = 0
        self._forced.discard(fcv.hashCode())
        h = _dp(raw if raw > 0 else 36)
        before = []
        for target in (fcv, self._fget(fcv, 'frameLayout')):
            if target is None:
                continue
            lp = target.getLayoutParams()
            if lp is not None:
                before.append(lp.height)
                if lp.height != h:
                    lp.height = h
                    target.requestLayout()
        try:
            fcv.setTopPadding(jfloat(float(h)))
        except Exception:
            pass
        try:
            fragment = self._fget(fcv, 'fragment')
            if fragment is not None:
                m2 = _find_method(fragment, 'invalidateChatListViewTopPadding', 0)
                if m2 is not None:
                    m2.invoke(fragment)
        except Exception:
            pass

    def _settle_plate(self, fcv):
        try:
            if not fcv.isAttachedToWindow():
                return
            v = fcv
            for _ in range(6):
                par = v.getParent()
                if par is None or not isinstance(par, View):
                    break
                if 'TopPanelLayout' in str(par.getClass().getName()):
                    par.requestLayout()
                    try:
                        m = _find_method(par, 'onItemsChanged', 0)
                        if m is not None:
                            m.invoke(par)
                    except Exception:
                        pass
                    break
                lp = par.getLayoutParams()
                if lp is not None and lp.height != -2:
                    lp.height = -2
                par.requestLayout()
                v = par
        except Exception:
            pass

    def _after_reset(self, fcv):
        try:
            if not fcv.isAttachedToWindow() or self._is_music_style(fcv):
                return
            lp = fcv.getLayoutParams()
            want = _dp(36)
            try:
                m = _find_method(fcv, 'getStyleHeight', 0)
                want = _dp(int(m.invoke(fcv)))
            except Exception:
                pass
            if lp is not None and lp.height != want:
                self._restore_plate_size(fcv)
            self._settle_plate(fcv)
        except Exception:
            pass

    def _reset_plate(self, fcv):
        key = fcv.hashCode()
        if key in self._resetting:
            return
        self._resetting.add(key)
        try:
            self._restore_plate_size(fcv)
            f = self._ffield(fcv, 'currentStyle')
            if f and f.getInt(fcv) == 0:
                f.setInt(fcv, -1)
            if not fcv.isAttachedToWindow():
                self._settle_pending.add(key)
                return
            m = _find_method(fcv, 'checkPlayer', 1)
            if m is not None:
                m.invoke(fcv, jclass('java.lang.Boolean').TRUE)
            self._settle_plate(fcv)
            run_on_ui_thread(lambda: self._after_reset(fcv), 350)
        except Exception:
            pass
        finally:
            self._resetting.discard(key)

    def _teardown_bars(self, restore_size=False):
        for key, bar in list(self._bars.items()):
            try:
                fcv = bar.fcv
                fcv.removeView(bar.root)
                for n in RESTORE_VIEWS:
                    v = self._fget(fcv, n)
                    if v is not None:
                        v.setVisibility(0)
            except Exception:
                pass
        self._bars.clear()
        if restore_size:
            for key, fcv in list(self._fcvs.items()):
                self._reset_plate(fcv)
            for ctx in list(self._ctxs.values()):
                if not self._busy:
                    self._busy = True
                    try:
                        self._call(ctx.dialogs, 'updateContextViewPosition')
                    except Exception:
                        pass
                    finally:
                        self._busy = False
        if not restore_size:
            self._recheck_players()

    def _find_fcv(self, root):
        view_group = jclass('android.view.ViewGroup')

        def walk(v, depth):
            if depth > 6:
                return None
            if v.getClass().getName().endswith('FragmentContextView'):
                return v
            if isinstance(v, view_group):
                for i in range(v.getChildCount()):
                    r = walk(v.getChildAt(i), depth + 1)
                    if r is not None:
                        return r
            return None
        return walk(root, 0)

    def _last_fragment_name(self):
        try:
            from client_utils import get_last_fragment
            fr = get_last_fragment()
            return str(fr.getClass().getName()) if fr is not None else ''
        except Exception:
            return ''

    def _panel_of(self, fcv):
        v = fcv
        for _ in range(6):
            par = v.getParent()
            if par is None or not isinstance(par, View):
                return None
            if 'TopPanelLayout' in str(par.getClass().getName()):
                return par
            v = par
        return None

    def _topics_panel(self):
        for key, fcv in list(self._fcvs.items()):
            try:
                if not fcv.isAttachedToWindow():
                    continue
                frag = self._fget(fcv, 'fragment')
                if frag is not None and str(frag.getClass().getName()).endswith('TopicsFragment'):
                    pn = self._panel_of(fcv)
                    if pn is not None:
                        return pn
            except Exception:
                continue
        return None

    def _align_to_topics(self, ctx):
        r = ctx.top_reason
        if not r or 'Topics' not in r or self._playing_msg() is None:
            return
        tp = self._topics_panel()
        if tp is None:
            return
        try:
            panel = ctx.panel
            delta = float(_wy(tp) - _wy(panel))
            if abs(delta) >= 1.0:
                new = float(panel.getTranslationY()) + delta
                panel.setTranslationY(new)
                ctx.my_ty = new
        except Exception:
            pass

    def _topic_fields(self, dialogs):
        key = str(dialogs.getClass().getName())
        cached = self._top_cands.get(key)
        if cached is not None:
            return cached
        out, cls = ([], dialogs.getClass())
        while cls is not None and len(out) < 14:
            n = str(cls.getName())
            if n.startswith('android.') or n.startswith('java.'):
                break
            for f in cls.getDeclaredFields():
                try:
                    name, tname = (str(f.getName()), str(f.getType().getName()))
                    low = name.lower()
                    if tname == 'boolean':
                        ok = ('forum' in low or 'topic' in low) and any((w in low for w in ('open', 'show', 'visible', 'mode', 'active', 'inside', 'expand')))
                    else:
                        ok = ('Topics' in tname or 'Forum' in tname) and (not f.getType().isPrimitive())
                    if ok:
                        f.setAccessible(True)
                        out.append((f, name, tname))
                except Exception:
                    pass
            cls = cls.getSuperclass()
        self._top_cands[key] = out
        return out

    def _topics_active(self):
        now = time.monotonic()
        if now - self._ta_t < 0.008:
            return self._ta_v
        active = False
        for key, fr in list(self._topics_frags.items()):
            try:
                st = self._topics_state.setdefault(key, {'closing': False, 'base_x': None})
                gone = False
                for m in ('isFinishing', 'isFinished'):
                    try:
                        if bool(getattr(fr, m)()):
                            gone = True
                    except Exception:
                        pass
                v = fr.getFragmentView()
                age = now - self._topics_seen.get(key, 0.0)
                if gone or v is None or (v.getParent() is None and age > 1.0):
                    self._topics_frags.pop(key, None)
                    self._topics_state.pop(key, None)
                    continue
                if st['closing']:
                    continue
                if age > 0.8 or st.get('opened'):
                    loc = jarray(jint)(2)
                    v.getLocationOnScreen(loc)
                    x = int(loc[0])
                    if st['base_x'] is None:
                        cand = st.get('cand')
                        if cand is None or abs(x - cand[0]) > 2:
                            st['cand'] = (x, now)
                        elif now - cand[1] > 0.15:
                            st['base_x'] = x
                    elif abs(x - st['base_x']) > _dp(6):
                        st['closing'] = True
                        continue
                active = True
            except Exception:
                self._topics_frags.pop(key, None)
                self._topics_state.pop(key, None)
        self._ta_t, self._ta_v = (now, active)
        return active

    def _on_topics_event(self, param):
        fr = param.thisObject
        key = fr.hashCode()
        self._topics_event_t = time.monotonic()
        self._topics_hooked = True
        if key not in self._topics_frags:
            self._topics_seen[key] = time.monotonic()
        self._topics_frags[key] = fr
        st = self._topics_state.setdefault(key, {'closing': False, 'base_x': None})
        name, args = ('?', [])
        try:
            name = str(param.method.getName())
        except Exception:
            pass
        try:
            args = list(param.args)
        except Exception:
            pass
        if name in ('onTransitionAnimationStart', 'onTransitionAnimationEnd') and args:
            is_open = _to_bool(args[0], True)
            if name == 'onTransitionAnimationStart' and (not is_open):
                st['closing'] = True
            elif is_open:
                st['closing'] = False
                if name == 'onTransitionAnimationEnd':
                    st['opened'] = True
                    st['base_x'] = None
                    st['cand'] = None
        elif name in ('finishFragment', 'onFragmentDestroy'):
            st['closing'] = True
        elif name in ('onResume', 'createView') and st.get('closing') and self._topics_seen.get(key, 0) and (time.monotonic() - self._topics_seen[key] > 0.5):
            st['closing'] = False
            st['base_x'] = None
        self._ta_t = 0.0
        now_active = self._topics_active()
        if now_active != self._topics_last:
            self._topics_last = now_active
            self._topics_kick()
            run_on_ui_thread(self._topics_kick, 80)

    def _topics_kick(self):
        if not self._enabled:
            return
        for ctx in list(self._ctxs.values()):
            try:
                ctx.top_t = 0.0
                moving = self._moving_ctx(ctx)
                if moving:
                    self._refresh_c(ctx)
                    self._attach(ctx)
                self._step(ctx, moving, False)
            except Exception:
                pass

    def _walk_tree(self, root, depth_max, visit):
        view_group = jclass('android.view.ViewGroup')

        def walk(v, depth):
            try:
                visit(v, depth)
                if depth < depth_max and isinstance(v, view_group):
                    for i in range(v.getChildCount()):
                        walk(v.getChildAt(i), depth + 1)
            except Exception:
                pass
        walk(root, 0)

    def _topics_view(self, ctx):
        now = time.monotonic()
        if now - ctx.tv_t < 0.5:
            return ctx.tv_name
        ctx.tv_t = now
        found = []
        rw = float(ctx.root.getWidth())

        def visit(v, depth):
            n = str(v.getClass().getName())
            if ('Topic' in n or 'Forum' in n) and v.getWidth() > rw * 0.3 and v.isShown() and (v.getAlpha() > 0.3):
                found.append(n.rsplit('.', 1)[-1])
        self._walk_tree(ctx.root, 7, visit)
        ctx.tv_name = found[0] if found else None
        return ctx.tv_name

    def _narrow_list(self, ctx):
        now = time.monotonic()
        try:
            if now - ctx.all_lists_t > 1.0 or not ctx.all_lists:
                ctx.all_lists = [v for v, _ in self._find_lists(ctx.root)]
                ctx.all_lists_t = now
            rw = float(ctx.root.getWidth())
            if rw <= 0:
                return False
            info, narrow = ([], False)
            for v in ctx.all_lists:
                shown = bool(v.isShown())
                w = float(v.getWidth()) * abs(float(v.getScaleX()))
                info.append('%dx%d shown=%s' % (int(v.getWidth()), int(v.getHeight()), shown))
                if shown and 0 < w < rw * NARROW_RATIO:
                    narrow = True
            tv = self._topics_view(ctx)
            return narrow or tv is not None
        except Exception as e:
            return False

    def _top_reason(self, ctx):
        now = time.monotonic()
        if not self._cfg['topics_bottom'] and self._topics_active():
            if ctx.top_reason != 'topics fragment':
                ctx.top_reason = 'topics fragment'
            ctx.top_t = now
            return ctx.top_reason
        if ctx.top_reason == 'topics fragment':
            ctx.top_reason = None
            ctx.top_t = 0.0
        if now - ctx.top_t < 0.1:
            return ctx.top_reason
        ctx.top_t = now
        reason, d = (None, ctx.dialogs)
        try:
            for name in ('searching', 'searchIsShowed'):
                f = self._field(d, name)
                if f and str(f.getType().getName()) == 'boolean' and f.getBoolean(d):
                    reason = name
                    break
            if reason is None:
                ab = self._get(d, 'actionBar')
                if ab is not None and ab.isSearchFieldVisible():
                    reason = 'search field'
            top = self._last_fragment_name()
            if top != ctx.last_top_name:
                ctx.last_top_name = top
                normal = not top or any((n in top for n in NORMAL_SCREENS))
                ctx.foreign_since = None if normal else now
            if reason is None:
                short = top.rsplit('.', 1)[-1]
                if 'Topics' in top or 'Forum' in top:
                    reason = 'screen ' + short
                elif ctx.foreign_since is not None and now - ctx.foreign_since >= FOREIGN_DELAY:
                    reason = 'screen ' + short
            if reason is None and (not self._topics_hooked) and (not self._cfg['topics_bottom']):
                if self._narrow_list(ctx):
                    if ctx.narrow_since is None:
                        ctx.narrow_since = now
                    if now - ctx.narrow_since >= NARROW_DELAY:
                        reason = 'narrow chat list (topics beside it)'
                else:
                    ctx.narrow_since = None
            if reason is None and (not self._topics_hooked) and (not self._cfg['topics_bottom']):
                for f, name, tname in self._topic_fields(d):
                    v = f.get(d)
                    if tname == 'boolean':
                        if v:
                            reason = name
                            break
                    elif v is not None and isinstance(v, View):
                        if v.isShown() and v.getAlpha() > 0.3 and (v.getHeight() > 0):
                            reason = name
                            break
        except Exception:
            pass
        if reason != ctx.top_reason:
            pass
        ctx.top_reason = reason
        return reason

    def _all_fcvs(self, root):
        out = []
        view_group = jclass('android.view.ViewGroup')

        def walk(v, depth):
            if depth > 6:
                return
            try:
                if str(v.getClass().getName()).endswith('FragmentContextView'):
                    out.append(v)
                    return
                if isinstance(v, view_group):
                    for i in range(v.getChildCount()):
                        walk(v.getChildAt(i), depth + 1)
            except Exception:
                pass
        walk(root, 0)
        return out

    def _plate_music(self, ctx):
        now = time.monotonic()
        if now - ctx.sty_t < 0.1:
            return ctx.sty_v
        ctx.sty_t = now
        ok, why = (True, 'music')
        try:
            if ctx.fcv is None:
                ctx.fcv = self._find_fcv(ctx.panel)
            if now - ctx.fcv_all_t > 1.0 or not ctx.fcv_all:
                ctx.fcv_all = self._all_fcvs(ctx.panel)
                ctx.fcv_all_t = now
            for fcv in ctx.fcv_all:
                f = self._ffield(fcv, 'currentStyle')
                style = f.getInt(fcv) if f else 0
                shown = fcv.getVisibility() == 0 and fcv.getHeight() > 0 and (float(fcv.getAlpha()) > 0.05)
                if shown and style > 0:
                    ok, why = (False, 'style %d' % style)
                    break
        except Exception:
            ok = True
        if ok != ctx.sty_v:
            if not ok:
                for fcv in list(ctx.fcv_all):
                    run_on_ui_thread(lambda f=fcv: self._safe(self._drop_bar, f))
        ctx.sty_v = ok
        return ok

    def _moving_ctx(self, ctx):
        return self._moving() and self._plate_music(ctx) and (self._top_reason(ctx) is None)

    def _ensure_dialogs_bar(self, ctx):
        if not (self._enabled and self._cfg['style']):
            return
        if not self._plate_music(ctx):
            return
        mo = self._playing_msg()
        if mo is None:
            return
        try:
            if not mo.isMusic() or mo.getId() == 0:
                return
        except Exception:
            return
        if ctx.fcv is None:
            ctx.fcv = self._find_fcv(ctx.panel)
        fcv = ctx.fcv
        if fcv is None:
            return
        bar = self._bars.get(fcv.hashCode())
        if bar is None or bar.root.getParent() is None or bar.root.getVisibility() != 0:
            self._dialogs_fcv[fcv.hashCode()] = True
            self._show_bar(fcv)

    def _ctx_for(self, dialogs):
        panel = self._get(dialogs, 'topPanelLayout')
        root = self._get(dialogs, 'fragmentView')
        if panel is None or root is None:
            return None
        key = dialogs.hashCode()
        ctx = self._ctxs.get(key)
        if ctx is None or ctx.panel_hash != panel.hashCode():
            if ctx is not None:
                self._detach(ctx)
            ctx = _Ctx(dialogs, panel, root)
            self._ctxs[key] = ctx
        return ctx

    def _refresh_c(self, ctx):
        now = time.monotonic()
        if ctx.c is not None and now - ctx.c_t < 0.3:
            return
        ctx.c_t = now
        try:
            ctx.c = int(self._call(ctx.dialogs, 'calculateListViewPaddingBottom'))
        except Exception:
            ctx.c = 0

    def _on_update(self, param):
        if self._busy:
            return
        ctx = self._ctx_for(param.thisObject)
        if ctx is None:
            return
        cur = float(ctx.panel.getTranslationY())
        if ctx.my_ty is None or abs(cur - ctx.my_ty) > 0.5:
            ctx.stock_ty = cur
        moving = self._moving_ctx(ctx)
        ctx.fade_dirty = True
        if moving:
            self._ensure_dialogs_bar(ctx)
            self._refresh_c(ctx)
            self._attach(ctx)
        self._step(ctx, moving, False)
        self._align_to_topics(ctx)
        self._shadow_fix(ctx, ctx.dialogs)

    def _hook_fade(self, ctx, fade):
        self._fade_ids.add(fade.hashCode())
        key = str(fade.getClass().getName())
        if key in self._fade_hooked_classes:
            return
        self._fade_hooked_classes.add(key)
        plugin = self

        class FadeDraw(MethodHook):

            def before_hooked_method(self, param):
                try:
                    if plugin._fade_suppress and param.thisObject.hashCode() in plugin._fade_ids:
                        param.setResult(None)
                except Exception:
                    pass

        class ChildDraw(MethodHook):

            def before_hooked_method(self, param):
                try:
                    if plugin._fade_suppress and param.args[1].hashCode() in plugin._fade_ids:
                        param.setResult(jclass('java.lang.Boolean').FALSE)
                except Exception:
                    pass
        ok = []
        for name in ('onDraw', 'draw', 'dispatchDraw'):
            try:
                cls = fade.getClass()
                if any((m.getName() == name for m in cls.getDeclaredMethods())):
                    self._hook(cls, name, FadeDraw())
                    ok.append('fade.' + name)
            except Exception:
                pass
        self._fade_hooked = bool(ok)

    def _shadow_off(self, ctx):
        self._fade_suppress = False
        if ctx.fade_hidden:
            try:
                fade = self._get(ctx.dialogs, 'topBubblesFadeView')
                if fade is not None and (not self._fade_hooked):
                    fade.setAlpha(1.0)
            except Exception:
                pass
            ctx.fade_hidden = False

    def _shadow_fix(self, ctx, dialogs):
        mo = self._playing_msg()
        active = bool(self._enabled and self._cfg['style'] and (mo is not None))
        self._fade_suppress = active
        if not active:
            self._shadow_off(ctx)
            return
        now = time.monotonic()
        if now - ctx.sh_call < 0.05:
            return
        ctx.sh_call = now
        try:
            fade = self._get(dialogs, 'topBubblesFadeView')
            if fade is not None:
                self._hook_fade(ctx, fade)
                if not self._fade_hooked and float(fade.getAlpha()) > 0.0:
                    fade.setAlpha(0.0)
            ctx.fade_hidden = True
        except Exception:
            pass

    def _on_blur(self, param):
        dialogs = param.thisObject
        ctx = self._ctxs.get(dialogs.hashCode())
        if ctx is not None:
            self._shadow_fix(ctx, dialogs)
        if ctx is None or not ctx.applied or (not self._moving()) or (not ctx.sty_v):
            return
        if time.monotonic() - self._topics_event_t < 0.8:
            ctx.blur_pending = True
            return
        if self._top_reason(ctx) is not None:
            ctx.blur_pending = True
            return
        self._blur_apply(ctx, dialogs)

    def _blur_apply(self, ctx, dialogs):
        rect = self._get(dialogs, 'iBlur3PositionMainTabs')
        if rect is None:
            return
        h = self._panel_h(ctx.panel)
        extra = h + self._gap_px() if h >= 1 else 0.0
        top = float(rect.top)
        if ctx.blur_my_top is not None and abs(top - ctx.blur_my_top) < 0.5:
            top += ctx.blur_extra
        untouched = ctx.blur_my_top is not None and abs(float(rect.top) - ctx.blur_my_top) < 0.5
        if untouched and abs(extra - ctx.blur_extra) < 0.5:
            return
        rect.top = float(top - extra)
        ctx.blur_my_top = float(rect.top)
        ctx.blur_extra = extra
        noise = self._get(dialogs, 'scrollableViewNoiseSuppressor')
        positions = self._get(dialogs, 'iBlur3Positions')
        capture = self._get(dialogs, 'iBlur3Capture')
        if noise is not None and positions is not None and (capture is not None):
            try:
                noise.setupRenderNodes(positions, jint(2))
                noise.invalidateResultRenderNodes(capture, jint(int(ctx.root.getMeasuredWidth())), jint(int(ctx.root.getMeasuredHeight())))
            except Exception:
                pass

    def _on_fab_before(self, param):
        dialogs = param.thisObject
        ctx = self._ctxs.get(dialogs.hashCode())
        f = self._field(dialogs, 'additionalFloatingTranslation')
        if not f:
            return
        extra = 0.0
        if ctx is not None and self._moving_ctx(ctx) and (ctx.panel.getVisibility() == 0):
            h = self._panel_h(ctx.panel)
            if h >= 1:
                extra = self._fab_px(h + self._gap_px())
        cur = float(f.getFloat(dialogs))
        last = ctx.aft_last if ctx is not None else None
        base = 0.0 if last is not None and abs(cur - last) < 0.5 else cur
        want = max(base, extra)
        if abs(want - cur) >= 0.5:
            f.setFloat(dialogs, jfloat(want))
        if ctx is not None:
            ctx.aft_last = want if want > base + 0.5 else None

    def _find_lists(self, root):
        view_group = jclass('android.view.ViewGroup')
        out = []

        def walk(v, depth):
            if depth > 9:
                return
            try:
                c = v.getClass()
                is_list = False
                for _ in range(4):
                    if c is None:
                        break
                    if str(c.getName()).endswith('DialogsRecyclerView'):
                        is_list = True
                        break
                    c = c.getSuperclass()
                if is_list:
                    out.append((v, v.hashCode()))
                    return
            except Exception:
                return
            if isinstance(v, view_group):
                for i in range(v.getChildCount()):
                    walk(v.getChildAt(i), depth + 1)
        walk(root, 0)
        return out

    def _shift_view(self, ctx, v, key, dy):
        cur = float(v.getTranslationY())
        st = ctx.shift.get(key)
        base = cur - st[1] if st and abs(cur - st[0]) < 0.01 else cur
        new = base + dy
        if abs(new - cur) >= 0.01:
            v.setTranslationY(new)
        if abs(dy) < 0.01:
            ctx.shift.pop(key, None)
        else:
            ctx.shift[key] = (new, dy)

    def _set_bottom_margin(self, ctx, v, key, extra):
        lp = v.getLayoutParams()
        if lp is None or not hasattr(lp, 'height'):
            return
        if key not in ctx.margins:
            ctx.margins[key] = int(lp.height)
        orig = ctx.margins[key]
        want = orig
        if extra and extra > 0:
            parent = v.getParent()
            if parent is None or parent.getHeight() < int(ctx.root.getHeight() * 0.5):
                return
            if orig > 0:
                base = orig
            elif parent is not None:
                base = int(parent.getHeight() - parent.getPaddingTop() - parent.getPaddingBottom())
                try:
                    base -= int(lp.topMargin) + int(lp.bottomMargin)
                except Exception:
                    pass
            else:
                return
            if base <= 0:
                return
            want = base + int(round(extra))
            if parent is not None and want < int(parent.getHeight() * 0.7):
                want = orig
        if int(lp.height) != want:
            lp.height = want
            v.requestLayout()

    def _fix_fade(self, ctx):
        fade = self._get(ctx.dialogs, 'topBubblesFadeView')
        if fade is not None:
            d7 = float(_dp(7))
            fade.setPosition(jfloat(d7), jfloat(-d7))

    def _topic_lists(self, fr):
        key = fr.hashCode()
        now = time.monotonic()
        hit = self._rv_cache.get(key)
        if hit and now - hit[0] < (1.0 if hit[1] else 0.15):
            return hit[1]
        out = []
        try:
            root = fr.getFragmentView()
            rw = float(root.getWidth()) if root is not None else 0.0
            rv_cls = jclass('androidx.recyclerview.widget.RecyclerView')

            def visit(v, depth):
                if isinstance(v, rv_cls) and v.getHeight() > 0 and (float(v.getWidth()) > rw * 0.5):
                    out.append(v)
            if root is not None:
                self._walk_tree(root, 8, visit)
        except Exception:
            pass
        self._rv_cache[key] = (now, out)
        return out

    def _ts(self, ctx):
        ts = self._tstate
        ts.root = ctx.root
        return ts

    def _claim(self, ctx, key):
        now = time.monotonic()
        me = id(ctx)
        owner = self._topic_owner.get(key)
        if owner is None or owner[0] == me or now - owner[1] > 0.5:
            self._topic_owner[key] = (me, now)
            return True
        return False

    def _owns(self, ctx, key):
        owner = self._topic_owner.get(key)
        return owner is None or owner[0] == id(ctx)

    def _release(self, ctx, key):
        owner = self._topic_owner.get(key)
        if owner is not None and owner[0] == id(ctx):
            self._topic_owner.pop(key, None)

    def _topic_fab(self, fr):
        key = fr.hashCode()
        now = time.monotonic()
        hit = self._fab_cache.get(key)
        if hit is not None and (hit[1] is not None or now - hit[0] < 1.0):
            return hit[1]
        view, found = (None, {})
        try:
            view_cls = jclass('android.view.View')
            cls = fr.getClass()
            while cls is not None and str(cls.getName()) != 'java.lang.Object':
                for f in cls.getDeclaredFields():
                    name = str(f.getName())
                    low = name.lower()
                    if 'floating' not in low or any((w in low for w in ('hide', 'progress', 'translation', 'visible', 'anim', 'offset'))):
                        continue
                    try:
                        f.setAccessible(True)
                        v = f.get(fr)
                        if v is not None and isinstance(v, view_cls):
                            found[name] = v
                    except Exception:
                        pass
                cls = cls.getSuperclass()
            for pref in ('floatingButtonContainer', 'floatingButton'):
                if pref in found:
                    view = found[pref]
                    break
            if view is None and found:
                view = next(iter(found.values()))
        except Exception:
            pass
        self._fab_cache[key] = (now, view)
        return view

    def _set_fab_margin(self, ctx, v, key, extra):
        lp = v.getLayoutParams()
        if lp is None or getattr(lp, 'bottomMargin', None) is None:
            return False
        orig = ctx.fab_orig.get(key)
        if orig is None:
            orig = ctx.fab_orig[key] = int(lp.bottomMargin)
        want = orig + int(round(extra))
        if int(lp.bottomMargin) != want:
            lp.bottomMargin = want
            v.setLayoutParams(lp)
        if extra == 0:
            ctx.fab_orig.pop(key, None)
        return True

    def _shift_topics_fab(self, ctx):
        ts = self._ts(ctx)
        cur = {}
        if self._cfg['topics_bottom'] and ctx.last_h:
            for fr in list(self._topics_frags.values()):
                v = self._topic_fab(fr)
                if v is not None:
                    k = ('f', v.hashCode())
                    if self._claim(ctx, k):
                        cur[k] = v
        for key, v in list(ctx.extra_fabs.items()):
            if key not in cur:
                owns = self._owns(ctx, key)
                self._release(ctx, key)
                if owns:
                    try:
                        self._set_fab_margin(ts, v, key, 0)
                    except Exception:
                        pass
                ts.fab_orig.pop(key, None)
                ctx.extra_fabs.pop(key, None)
        if not cur:
            return
        extra = self._fab_px(float(ctx.last_h) + self._gap_px())
        for key, v in cur.items():
            try:
                ctx.extra_fabs[key] = v
                self._set_fab_margin(ts, v, key, extra)
            except Exception:
                pass

    def _shift_topics(self, ctx):
        ts = self._ts(ctx)
        cur = {}
        if self._cfg['topics_bottom'] and ctx.shift_full:
            self._topics_active()
            for fr in list(self._topics_frags.values()):
                for v in self._topic_lists(fr):
                    k = ('t', v.hashCode())
                    if self._claim(ctx, k):
                        cur[k] = v
        for key, v in list(ctx.extra_lists.items()):
            if key not in cur:
                owns = self._owns(ctx, key)
                self._release(ctx, key)
                if owns:
                    try:
                        self._shift_view(ts, v, key, 0.0)
                        self._set_bottom_margin(ts, v, key, 0)
                    except Exception:
                        pass
                else:
                    pass
                ctx.extra_lists.pop(key, None)
                ctx.extra_margin.pop(key, None)
        for key, v in cur.items():
            try:
                ctx.extra_lists[key] = v
                self._shift_view(ts, v, key, -self._sf(ctx))
                if ctx.extra_margin.get(key) != int(round(self._mf(ctx))):
                    ctx.extra_margin[key] = int(round(self._mf(ctx)))
                    self._set_bottom_margin(ts, v, key, self._mf(ctx))
            except Exception:
                pass

    def _sf(self, ctx):
        return ctx.shift_full

    def _mf(self, ctx, key=None):
        if key is not None and ctx.sparse.get(key):
            return 0.0
        return ctx.shift_full

    def _update_sparse(self, ctx):
        now = time.monotonic()
        if now - ctx.sparse_t < 0.25:
            return
        ctx.sparse_t = now
        for v, key in ctx.lists:
            try:
                ad = v.getAdapter()
                n = int(ad.getItemCount()) if ad is not None else 0
                sp = 0 < n <= SPARSE_ITEMS
                if ctx.sparse.get(key) != sp:
                    ctx.sparse[key] = sp
                    ctx.margin_key = None
                if sp and v.isShown() and (v.getWidth() > 0):
                    pass
            except Exception:
                pass

    def _step(self, ctx, moving, frame):
        panel = ctx.panel
        h = 0.0
        if moving and panel.getVisibility() == 0:
            h = self._panel_h(panel)
        want = bool(moving and h >= 1)
        now = time.monotonic()
        if not ctx.applied and (not want):
            ctx.last_want = 0.0
            return
        if want != bool(ctx.last_want):
            ctx.last_want = 1.0 if want else 0.0
            ctx.c_t = 0.0
        if want:
            if not ctx.applied:
                ctx.applied = True
                ctx.lists = self._find_lists(ctx.root)
                if ctx.c is None:
                    self._refresh_c(ctx)
                ctx.root.requestLayout()
            parent = ctx.parent
            if parent is None:
                parent = ctx.parent = panel.getParent()
            if parent is not None:
                limit = parent.getMeasuredHeight() - (ctx.c or 0)
                ctx.bottom_ty = float(limit - h - self._gap_px() - panel.getTop())
            ctx.shift_full = h + self._top_fix_px()
            ctx.last_h = h
        elif ctx.applied and self._moving() and ctx.sty_v:
            if abs(float(ctx.stock_ty) - float(panel.getTranslationY())) >= 0.5:
                panel.setTranslationY(float(ctx.stock_ty))
            ctx.my_ty = float(ctx.stock_ty)
            for v, key in ctx.lists:
                self._shift_view(ctx, v, key, 0.0)
            self._push_fab(ctx, 0.0)
            return
        else:
            ctx.margin_key = None
            self._restore(ctx)
            self._push_fab(ctx, 0.0)
            return
        if ctx.bottom_ty is not None:
            new = float(ctx.bottom_ty)
            if abs(new - float(panel.getTranslationY())) >= 0.5:
                panel.setTranslationY(new)
            ctx.my_ty = new
        self._update_sparse(ctx)
        mkey = (len(ctx.lists), tuple((int(round(self._mf(ctx, k))) for _, k in ctx.lists)))
        for v, key in ctx.lists:
            self._shift_view(ctx, v, key, -self._sf(ctx))
            if ctx.margin_key != mkey:
                self._set_bottom_margin(ctx, v, key, self._mf(ctx, key))
        if now - ctx.mchk_t > 0.25:
            ctx.mchk_t = now
            for v, key in ctx.lists:
                self._safe(self._set_bottom_margin, ctx, v, key, self._mf(ctx, key))
        self._shift_topics(ctx)
        self._shift_topics_fab(ctx)
        ctx.margin_key = mkey
        if ctx.fade_dirty:
            self._fix_fade(ctx)
            if frame:
                ctx.fade_dirty = False
        if ctx.blur_pending and now - self._topics_event_t >= 0.8:
            ctx.blur_pending = False
            self._blur_apply(ctx, ctx.dialogs)
        self._push_fab(ctx, self._fab_px(h + self._gap_px()))

    def _push_fab(self, ctx, extra):
        if abs(extra - ctx.last_extra) >= 1.0 and (not self._busy):
            ctx.last_extra = extra
            self._busy = True
            try:
                self._call(ctx.dialogs, 'updateFloatingButtonOffset')
            except Exception:
                pass
            finally:
                self._busy = False

    def _restore(self, ctx):
        if ctx.applied or ctx.my_ty is not None:
            try:
                ctx.panel.setTranslationY(float(ctx.stock_ty))
            except Exception:
                pass
        ctx.my_ty = None
        ctx.c = None
        for v, key in ctx.lists:
            try:
                self._shift_view(ctx, v, key, 0.0)
                self._set_bottom_margin(ctx, v, key, 0)
            except Exception:
                pass
        ts = self._ts(ctx)
        for key, v in list(ctx.extra_lists.items()):
            try:
                if self._owns(ctx, key):
                    self._shift_view(ts, v, key, 0.0)
                    self._set_bottom_margin(ts, v, key, 0)
                    self._release(ctx, key)
            except Exception:
                pass
        ctx.extra_lists.clear()
        ctx.extra_margin.clear()
        for key, v in list(ctx.extra_fabs.items()):
            try:
                if self._owns(ctx, key):
                    self._set_fab_margin(ts, v, key, 0)
                    self._release(ctx, key)
            except Exception:
                pass
        ctx.extra_fabs.clear()
        if ctx.aft_last is not None:
            f = self._field(ctx.dialogs, 'additionalFloatingTranslation')
            if f:
                f.setFloat(ctx.dialogs, jfloat(0.0))
            ctx.aft_last = None
        was = ctx.applied
        ctx.applied = False
        ctx.last_want = 0.0
        if was and (not self._busy):
            self._busy = True
            try:
                ctx.root.requestLayout()
                self._call(ctx.dialogs, 'updateContextViewPosition')
            except Exception:
                pass
            finally:
                self._busy = False

    def _attach(self, ctx):
        if ctx.listener is not None:
            return
        plugin = self

        class Pre(dynamic_proxy(ViewTreeObserver.OnPreDrawListener)):

            def onPreDraw(self):
                try:
                    if plugin._busy or not plugin._enabled:
                        return True
                    moving = plugin._moving_ctx(ctx)
                    plugin._step(ctx, moving, True)
                    plugin._align_to_topics(ctx)
                    if not moving and (not ctx.applied) and (not plugin._moving()):
                        plugin._detach(ctx)
                except Exception:
                    pass
                return True
        listener = Pre()
        try:
            ctx.root.getViewTreeObserver().addOnPreDrawListener(listener)
            ctx.listener = listener
        except Exception:
            ctx.listener = None

    def _detach(self, ctx):
        if ctx.listener is None:
            return
        try:
            ctx.root.getViewTreeObserver().removeOnPreDrawListener(ctx.listener)
        except Exception:
            pass
        ctx.listener = None

    def _refresh(self):
        for ctx in list(self._ctxs.values()):
            try:
                ctx.last_extra = -1.0
                moving = self._moving_ctx(ctx)
                if moving:
                    self._refresh_c(ctx)
                    self._attach(ctx)
                self._step(ctx, moving, False)
            except Exception:
                pass

    def _on_style(self, v):
        self._cfg['style'] = _to_bool(v, True)
        if not self._cfg['style']:
            self._safe(self._restore_md3)
            self._teardown_bars(True)
        else:
            self._recheck_players()
        self._refresh()

    def _on_gap(self, v):
        self._cfg['gap'] = _to_int(v, 0)
        self._refresh()

    def _on_fab(self, v):
        self._cfg['fab_trim'] = _to_int(v, 1)
        self._refresh()

    def _on_position(self, v):
        placement = _to_int(v, 1)
        self._cfg['position'] = 0 if placement == 1 else 1
        self._cfg['topics_bottom'] = self._cfg['position'] == 0
        for ctx in list(self._ctxs.values()):
            ctx.top_t = 0.0
        self._refresh()
        try:
            self.set_setting('placement', placement, reload_settings=True)
        except Exception:
            pass

    def _placement(self):
        v = self.get_setting('placement', None)
        if v is None:
            v = 1 if _to_int(self.get_setting('position', 0), 0) == 0 else 0
            try:
                self.set_setting('placement', v)
            except Exception:
                pass
        return _to_int(v, 1)

    def _location_settings(self):
        return [Selector(key='bnb', text='Отступ от BNB', default=0, items=['0 dp', '4 dp', '8 dp'], on_change=self._on_gap), Selector(key='fab_lift2', text='FAB ниже на', default=1, items=['0 dp', '6 dp'], on_change=self._on_fab)]

    def create_settings(self):
        items = [Switch(key='style', text='MD3', default=True, on_change=self._on_style)]
        if Divider is not None:
            items.append(Divider(text='(Работает только если в настройках мд3 отключен)'))
        items.append(Selector(key='placement', text='Расположение', default=1, items=['Сверху', 'Снизу'], on_change=self._on_position))
        if self._placement() == 1:
            try:
                items.append(Text(text='Отступы', create_sub_fragment=self._location_settings))
                if Divider is not None:
                    items.append(Divider(text='Можно выбрать отступ по желанию.\n(Работает только при расположении снизу)'))
            except TypeError:
                items.extend(self._location_settings())
        return items
