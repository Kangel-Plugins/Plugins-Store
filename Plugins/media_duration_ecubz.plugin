import base64
import hashlib
import json
import os
from typing import Any, List, Optional

from android.os import Build
from base_plugin import BasePlugin
from hook_utils import find_class
from java import jclass
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader
from org.telegram.messenger.browser import Browser
from ui.settings import Divider, Header, Selector, Switch, Text


__id__ = "media_duration_ecubz"
__name__ = "Media Duration Sort"
__name__en = "Media Duration Sort"
__author__ = "@eCubzPlugins - @eCubz"
__version__ = "1.0.1"
__min_version__ = "12.1.1"
__icon__ = "msg_photo_settings"
__description__ = "Сортировка медиафайлов по длительности таймлайна в меню общих медиа на нативном DEX-ядре."
__description__en = "Sort media files by duration in shared media menu powered by native DEX core."


DEX_CLASS_NAME = "ru.ecubz.mediaduration.MediaDurationCore"
DEX_FILE_NAME = "media_duration_ecubz.dex"
DEX_CACHE_DIR = "media_duration_ecubz_dex"
EXPECTED_BRIDGE_API = 1
EXPECTED_VERSION_CODE = 1
MAX_DEX_BYTES = 1024 * 1024

LABEL_LONG_FIRST = "Сначала длинные"
LABEL_SHORT_FIRST = "Сначала короткие"
AUTOLOAD_LIMITS = [1000, 3000, 5000, 10000]
AUTOLOAD_ITEMS = ["1 000 сообщений", "3 000 сообщений", "5 000 сообщений", "10 000 сообщений"]

dex_bridge = None
dex_loader = None


class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._dex_class = None
        self._dex_loader = None

    def on_plugin_load(self) -> None:
        global dex_bridge, dex_loader

        self._unload_global_bridge()
        try:
            dex_bytes = self._decode_and_validate_dex()
            self._dex_loader = self._create_loader(dex_bytes)
            self._dex_class = self._dex_loader.loadClass(DEX_CLASS_NAME)
            self._validate_bridge(self._dex_class)
            self._invoke("startBridge")
            self._push_settings()

            dex_bridge = self._dex_class
            dex_loader = self._dex_loader
            self.log(f"Media Duration DEX {self._static_string('VERSION_NAME')} успешно загружен")
        except Exception as error:
            self._unload_dex()
            self.log(f"Ошибка загрузки Media Duration DEX: {error}")

    def on_plugin_unload(self) -> None:
        self._unload_dex()
        self.log("Media Duration DEX выгружен")

    def _decode_and_validate_dex(self) -> bytes:
        dex_bytes = base64.b64decode(DEX_BASE64, validate=True)
        if not dex_bytes.startswith(b"dex\n"):
            raise RuntimeError("Неверный заголовок DEX")
        if not dex_bytes or len(dex_bytes) > MAX_DEX_BYTES:
            raise RuntimeError(f"Превышен лимит размера DEX: {len(dex_bytes)}")
        return dex_bytes

    def _create_loader(self, dex_bytes: bytes) -> Any:
        context = ApplicationLoader.applicationContext
        parent = context.getClassLoader()
        if int(Build.VERSION.SDK_INT) >= 26:
            loader_class = jclass("dalvik.system.InMemoryDexClassLoader")
            return loader_class(ByteBuffer.wrap(dex_bytes), parent)

        cache_root = str(context.getCodeCacheDir().getAbsolutePath())
        cache_dir = os.path.join(cache_root, DEX_CACHE_DIR)
        os.makedirs(cache_dir, exist_ok=True)
        dex_path = os.path.join(cache_dir, DEX_FILE_NAME)
        temp_path = dex_path + ".tmp"
        with open(temp_path, "wb") as output:
            output.write(dex_bytes)
        os.replace(temp_path, dex_path)

        loader_class = jclass("dalvik.system.DexClassLoader")
        return loader_class(dex_path, cache_dir, None, parent)

    def _validate_bridge(self, dex_class: Any) -> None:
        string_class = jclass("java.lang.String")
        dex_class.getMethod("startBridge")
        dex_class.getMethod("updateSettingsBridge", string_class)
        dex_class.getMethod("getStateBridge")
        dex_class.getMethod("onUnloadBridge")
        dex_class.getDeclaredField("VERSION_NAME")

        bridge_api = self._static_int(dex_class, "BRIDGE_API")
        version_code = self._static_int(dex_class, "VERSION_CODE")
        if bridge_api != EXPECTED_BRIDGE_API:
            raise RuntimeError(f"Bridge API {bridge_api}, ожидался {EXPECTED_BRIDGE_API}")
        if version_code != EXPECTED_VERSION_CODE:
            raise RuntimeError(f"DEX version {version_code}, ожидался {EXPECTED_VERSION_CODE}")

    def _push_settings(self) -> None:
        if self._dex_class is None:
            return
        idx = int(self.get_setting("max_autoload_idx", 2))
        max_autoload = AUTOLOAD_LIMITS[min(max(0, idx), len(AUTOLOAD_LIMITS) - 1)]
        payload = json.dumps(
            {
                "long_label": LABEL_LONG_FIRST,
                "short_label": LABEL_SHORT_FIRST,
                "max_autoload": max_autoload,
                "show_notifications": bool(self.get_setting("show_notifications", True)),
                "auto_video_filter": bool(self.get_setting("auto_video_filter", True)),
            },
            ensure_ascii=False,
        )
        string_class = jclass("java.lang.String")
        self._dex_class.getMethod("updateSettingsBridge", string_class).invoke(None, payload)

    @staticmethod
    def _static_int(dex_class: Any, name: str) -> int:
        field = dex_class.getDeclaredField(name)
        field.setAccessible(True)
        return int(field.get(None))

    def _static_string(self, name: str) -> str:
        if self._dex_class is None:
            raise RuntimeError("DEX-класс не загружен")
        field = self._dex_class.getDeclaredField(name)
        field.setAccessible(True)
        return str(field.get(None))

    def _invoke(self, method_name: str) -> Optional[Any]:
        if self._dex_class is None:
            raise RuntimeError("DEX-класс не загружен")
        return self._dex_class.getMethod(method_name).invoke(None)

    def _unload_dex(self) -> None:
        global dex_bridge, dex_loader

        if self._dex_class is not None:
            try:
                self._dex_class.getMethod("onUnloadBridge").invoke(None)
            except Exception:
                pass
        if dex_bridge is self._dex_class:
            dex_bridge = None
            dex_loader = None
        self._dex_class = None
        self._dex_loader = None

    @staticmethod
    def _unload_global_bridge() -> None:
        global dex_bridge, dex_loader

        if dex_bridge is not None:
            try:
                dex_bridge.getMethod("onUnloadBridge").invoke(None)
            except Exception:
                pass
        dex_bridge = None
        dex_loader = None

    def create_settings(self) -> List[Any]:
        idx = int(self.get_setting("max_autoload_idx", 2))
        return [
            Header(text="Сортировка медиа"),
            Switch(
                key="auto_video_filter",
                default=bool(self.get_setting("auto_video_filter", True)),
                text="Только видео",
                subtext="Скрывать фото при включении сортировки",
                icon="msg_photo_crop",
                on_change=lambda _: self._push_settings(),
            ),
            Switch(
                key="show_notifications",
                default=bool(self.get_setting("show_notifications", True)),
                text="Уведомления",
                subtext="Показывать статус сортировки и число найденных видео",
                icon="msg_photo_settings",
                on_change=lambda _: self._push_settings(),
            ),
            Divider(),
            Header(text="Лимит загрузки"),
            Selector(
                key="max_autoload_idx",
                default=idx,
                text="",
                items=AUTOLOAD_ITEMS,
                icon="msg_log",
                on_change=lambda _: self._push_settings(),
            ),
            Divider(text="Максимальное количество сообщений для фонового поиска"),
            Header(text="Поддержка и разработка"),
            Text(
                text="Канал eCubz Plugins",
                subtext="Обновления и новые плагины",
                icon="msg_channel",
                accent=True,
                on_click=self.open_channel,
            ),
            Text(
                text="Поддержать проект",
                subtext="Чаевые и реквизиты",
                icon="msg_link",
                accent=True,
                on_click=self.open_donate,
            ),
        ]

    def open_channel(self, view) -> None:
        Browser.openUrl(view.getContext(), "https://t.me/eCubzPlugins")

    def open_donate(self, view) -> None:
        Browser.openUrl(view.getContext(), "https://t.me/eCubzPlugins/29")


DEX_BASE64 = ""
