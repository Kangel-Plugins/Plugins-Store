import base64, hashlib, os, threading, time, zlib
from typing import List, Any
from base_plugin import BasePlugin
from java import jclass
from org.telegram.messenger import ApplicationLoader, LocaleController
from ui.settings import Header, Switch, Input

__id__ = "photo_picker_plus"
__name__ = "Photo Picker Plus"
__description__ = "Улучшает офф ТГ фотопикер, добавляет информативные пиллы, даты, тулбар с кастомными папками"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "1.2"
__icon__ = "pixelcamera/15"
__min_version__ = "13.1.1"

ENTRY_CLASS = "ni.dekma.photopicker.PhotoPickerBridge"
_DEX_BASE64 = ""

BuildVersion = jclass("android.os.Build$VERSION")
IntegerClass = jclass("java.lang.Integer")
LongClass = jclass("java.lang.Long")
BooleanClass = jclass("java.lang.Boolean")
FloatClass = jclass("java.lang.Float")

_last_lang_check = 0.0
_cached_is_eng = False

def is_english():
    global _last_lang_check, _cached_is_eng
    now = time.time()
    if now - _last_lang_check < 2.0:
        return _cached_is_eng
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
            _last_lang_check = now
            return _cached_is_eng
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        _cached_is_eng = not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
        _last_lang_check = now
        return _cached_is_eng
    except Exception:
        return False

def tr(ru, en):
    return en if is_english() else ru

try:
    from client_utils import run_on_queue, PLUGINS_QUEUE, get_queue_by_name
    def _run_bg(task):
        try:
            if get_queue_by_name(PLUGINS_QUEUE) is not None:
                run_on_queue(task, PLUGINS_QUEUE)
                return
        except Exception:
            pass
        threading.Thread(target=task, daemon=True).start()
except Exception:
    def _run_bg(task):
        threading.Thread(target=task, daemon=True).start()

class NativeBridge:
    def __init__(self, entry_class):
        self.entry_class = entry_class
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._method_cache = {}
        self._pending_cfg = None

    def load(self):
        if self.loaded:
            try:
                self.unload()
            except Exception:
                pass
        context = ApplicationLoader.applicationContext
        if context is None:
            raise RuntimeError("application context not ready")
        if int(BuildVersion.SDK_INT) < 26:
            raise RuntimeError("API 26+ required")
        if not _DEX_BASE64:
            raise RuntimeError("DEX payload empty")
        raw = base64.b64decode(_DEX_BASE64)
        try:
            payload = zlib.decompress(raw)
        except Exception:
            payload = raw
        buf = None
        try:
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            buf = ByteBuffer.wrap(payload)
            self.loader = InMemoryDexClassLoader(buf, context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        except Exception:
            cache_dir = context.getCacheDir().getAbsolutePath()
            dex_hash = hashlib.sha256(_DEX_BASE64.encode()).hexdigest()[:12]
            dex_path = os.path.join(cache_dir, f"plugin_{dex_hash}.dex")
            opt_dir = os.path.join(cache_dir, f"dex_opt_{dex_hash}")
            os.makedirs(opt_dir, exist_ok=True)
            if not os.path.exists(dex_path):
                with open(dex_path, "wb") as f:
                    f.write(payload)
            DexClassLoader = jclass("dalvik.system.DexClassLoader")
            self.loader = DexClassLoader(dex_path, opt_dir, None, context.getClassLoader())
            self.clazz = self.loader.loadClass(self.entry_class)
        finally:
            del buf
            del payload
            del raw
        self._method_cache.clear()
        self._invoke("load")
        self.loaded = True
        if self._pending_cfg is not None:
            cfg = self._pending_cfg
            self._pending_cfg = None
            self.sync_settings(*cfg)

    def unload(self):
        if self.clazz:
            try:
                self._invoke("unload")
            except Exception:
                pass
        self._method_cache.clear()
        self.clazz = None
        self.loader = None
        self.loaded = False
        self._pending_cfg = None

    def sync_settings(self, *args):
        if not self.loaded:
            self._pending_cfg = args
            return
        try:
            self._invoke("syncAllSettings", *args)
        except Exception:
            pass

    def get_detected_folders(self):
        if not self.loaded:
            return []
        try:
            folders = self._invoke("getDetectedFolders")
            if folders:
                return [str(f) for f in folders if str(f)]
        except Exception:
            pass
        return []

    def _invoke(self, name, *args):
        if not self.clazz:
            raise RuntimeError("DEX not loaded")
        key = (name, len(args))
        cached = self._method_cache.get(key)
        if not cached:
            for m in self.clazz.getDeclaredMethods():
                if str(m.getName()) == name and len(m.getParameterTypes()) == len(args):
                    m.setAccessible(True)
                    cached = (m, [str(pt.getName()) for pt in m.getParameterTypes()])
                    self._method_cache[key] = cached
                    break
            if not cached:
                raise RuntimeError(f"method not found: {name}/{len(args)}")
        method, types = cached
        converted = []
        for i, arg in enumerate(args):
            t = types[i]
            if t in ("int", "java.lang.Integer"):
                converted.append(IntegerClass.valueOf(int(arg)))
            elif t in ("long", "java.lang.Long"):
                converted.append(LongClass.valueOf(int(arg)))
            elif t in ("boolean", "java.lang.Boolean"):
                converted.append(BooleanClass.valueOf(bool(arg)))
            elif t in ("float", "java.lang.Float"):
                converted.append(FloatClass.valueOf(float(arg)))
            else:
                converted.append(arg)
        return method.invoke(None, *converted)

_ACTIVE_INSTANCE = None

class EnhancedPhotoPickerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)
        self._lock = threading.Lock()
        self.is_active = False
        self.is_loading = False

    def on_plugin_load(self):
        global _ACTIVE_INSTANCE
        if _ACTIVE_INSTANCE is not None and _ACTIVE_INSTANCE is not self:
            try:
                _ACTIVE_INSTANCE.on_plugin_unload()
            except Exception:
                pass
        _ACTIVE_INSTANCE = self
        def _bg_init():
            with self._lock:
                if self.is_active or self.is_loading:
                    return
                self.is_loading = True
            try:
                self.bridge.load()
                self._sync_settings()
                with self._lock:
                    self.is_active = True
                    self.is_loading = False
            except Exception:
                with self._lock:
                    self.is_active = False
                    self.is_loading = False
        _run_bg(_bg_init)

    def on_plugin_unload(self):
        global _ACTIVE_INSTANCE
        with self._lock:
            self.is_active = False
        try:
            self.bridge.unload()
        except Exception:
            pass
        if _ACTIVE_INSTANCE is self:
            _ACTIVE_INSTANCE = None

    def get_detected_folders(self) -> List[str]:
        return self.bridge.get_detected_folders()

    def create_settings(self) -> List[Any]:
        items = [
            Switch(key="show_chips", text=tr("Панель быстрых категорий", "Quick categories bar"), default=True, on_change=self._make_on_change("show_chips")),
            Switch(key="show_date_pill", text=tr("MD3-индикатор даты при скролле", "MD3 scroll date pill"), default=True, on_change=self._make_on_change("show_date_pill")),
            Header(text=tr("Базовые категории", "Basic categories")),
            Switch(key="cat_camera", text=tr("Камера", "Camera"), default=True, on_change=self._make_on_change("cat_camera")),
            Switch(key="cat_screenshots", text=tr("Скриншоты", "Screenshots"), default=True, on_change=self._make_on_change("cat_screenshots")),
            Switch(key="cat_video", text=tr("Видео", "Videos"), default=True, on_change=self._make_on_change("cat_video")),
            Switch(key="cat_downloads", text=tr("Загрузки", "Downloads"), default=True, on_change=self._make_on_change("cat_downloads")),
        ]
        folders = self.get_detected_folders()
        if folders:
            items.append(Header(text=tr("Найденные папки на устройстве", "Detected folders on device")))
            for f in folders:
                clean_name = f.strip()
                if not clean_name:
                    continue
                safe_key = "fld_" + clean_name
                items.append(Switch(key=safe_key, text=clean_name, default=False, on_change=self._make_on_change(safe_key)))
        items.append(Header(text=tr("Свои дополнительные папки", "Custom extra folders")))
        items.append(Input(key="custom_folders", text=tr("Произвольные папки (через запятую)", "Custom folders (comma separated)"), default="", on_change=self._make_on_change("custom_folders")))
        return items

    def on_settings_changed(self, *args):
        self._sync_settings()

    def set_setting(self, key, value, reload=False):
        super().set_setting(key, value, reload)
        self._sync_settings()

    def _make_on_change(self, key):
        def cb(*a):
            if a:
                try:
                    self.set_setting(key, a[0])
                except Exception:
                    pass
            self._sync_settings()
        return cb

    def _sync_settings(self):
        show_chips = bool(self.get_setting("show_chips", True))
        show_date = bool(self.get_setting("show_date_pill", True))
        cat_camera = bool(self.get_setting("cat_camera", True))
        cat_screenshots = bool(self.get_setting("cat_screenshots", True))
        cat_video = bool(self.get_setting("cat_video", True))
        cat_downloads = bool(self.get_setting("cat_downloads", True))
        cat_gif = False
        folders = self.get_detected_folders()
        active_folders = []
        disabled_folders = []
        for f in folders:
            clean_name = f.strip()
            if not clean_name:
                continue
            safe_key = "fld_" + clean_name
            if bool(self.get_setting(safe_key, False)):
                active_folders.append(clean_name)
            else:
                disabled_folders.append(clean_name)
        user_custom = str(self.get_setting("custom_folders", "")).strip()
        if user_custom:
            for part in user_custom.split(","):
                p = part.strip()
                if p and p not in active_folders and p not in disabled_folders:
                    active_folders.append(p)
        self.bridge.sync_settings(
            show_chips,
            show_date,
            cat_camera,
            cat_screenshots,
            cat_video,
            cat_downloads,
            cat_gif,
            ", ".join(active_folders),
            ", ".join(disabled_folders),
        )
