import base64
import zlib
from typing import List, Any
from java.lang import ClassLoader
from java.nio import ByteBuffer
from dalvik.system import InMemoryDexClassLoader
from org.telegram.messenger import ApplicationLoader, LocaleController
from java import jclass
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import (
    Header,
    Switch,
    Input,
    Selector,
)

def is_english():
    try:
        lang = str(LocaleController.getLocaleStringIso639() or "").lower()
        if lang:
            return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        pass
    try:
        Locale = jclass("java.util.Locale")
        lang = str(Locale.getDefault().getLanguage() or "").lower()
        return not (lang.startswith("ru") or lang.startswith("uk") or lang.startswith("be"))
    except Exception:
        return False

def tr(ru, en):
    return en if is_english() else ru

__id__ = "photo_picker_plus"
__name__ = "Photo Picker Plus"
__description__ = "Улучшает офф ТГ фотопикер, добавляет информативные пиллы, даты, тулбар с кастомными папками"
__author__ = "@dekma0091 && @DefinitelyNotDekma"
__version__ = "1.0"
__icon__ = "pixelcamera/15"
__min_version__ = "12.5.1"

_DEX_BASE64 = ""
ENTRY_CLASS = "ni.dekma.photopicker.PhotoPickerBridge"


class NativeBridge:
    def __init__(self, entry_class_name):
        self.entry_class_name = entry_class_name
        self.loader = None
        self.target_class = None
        self.is_active = False
        self._method_cache = dict()

    def start(self):
        if self.is_active:
            return
        try:
            dex_bytes = zlib.decompress(base64.b64decode(_DEX_BASE64))
            byte_buffer = ByteBuffer.wrap(dex_bytes)
            parent_loader = ApplicationLoader.applicationContext.getClassLoader()
            self.loader = InMemoryDexClassLoader(byte_buffer, parent_loader)
            self.target_class = self.loader.loadClass(self.entry_class_name)
            self.is_active = True
            self._method_cache.clear()
            self._invoke_static("load")
        except Exception as load_err:
            if self.is_active:
                try:
                    self.stop()
                except Exception as reset_err:
                    raise RuntimeError(
                        f"Bridge initialization failed: {load_err} (Reset error: {reset_err})"
                    ) from reset_err
            self.is_active = False
            raise

    def stop(self):
        if self.target_class is None or not self.is_active:
            return
        self._invoke_static("unload")
        self.is_active = False
        self._method_cache.clear()

    def _invoke_static(self, method_name, *args):
        if self.target_class is None:
            raise RuntimeError("Target class reference is null")
        key = (method_name, len(args))
        m = self._method_cache.get(key)
        if m is None:
            for method in self.target_class.getDeclaredMethods():
                if str(method.getName()) == method_name and len(method.getParameterTypes()) == len(args):
                    method.setAccessible(True)
                    m = method
                    self._method_cache[key] = m
                    break
        if m is None:
            raise RuntimeError("Static method not found: " + str(method_name))
        return m.invoke(None, *args)


def get_java_class(cls):
    if cls is None:
        return None
    try:
        if hasattr(cls, "getDeclaredMethod"):
            return cls
        elif hasattr(cls, "getClass"):
            return cls.getClass()
    except Exception:
        pass
    return cls


class TriggerHook(MethodHook):
    def __init__(self, plugin, bridge):
        super().__init__()
        self.plugin = plugin
        self.bridge = bridge

    def after_hooked_method(self, param):
        try:
            target = param.thisObject
            if target is not None:
                self.bridge._invoke_static("recordAlbums", target)
                self.bridge._invoke_static("ensureToolbar", target)
        except Exception:
            pass
        finally:
            del param


class SelectionHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def after_hooked_method(self, param):
        try:
            self.bridge._invoke_static("updateSelectionState")
        except Exception:
            pass
        finally:
            del param


class ChatAttachAlertUpdateLayoutHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            top = param.args[1]
            if isinstance(top, int) and top > 0:
                adj = self.bridge._invoke_static("getExpandedSheetTop", top)
                if adj is not None:
                    param.args[1] = adj
        except Exception:
            pass
        finally:
            del param


class ChatAttachAlertGetCurrentTopHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def after_hooked_method(self, param):
        try:
            res = param.getResult()
            if isinstance(res, int) and res > 0:
                adj = self.bridge._invoke_static("getExpandedSheetTop", res)
                if adj is not None:
                    param.setResult(adj)
        except Exception:
            pass
        finally:
            del param


class OnContainerViewTouchEventHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            ev = param.args[0]
            if ev is not None:
                rx = float(ev.getRawX())
                ry = float(ev.getRawY())
                if self.bridge._invoke_static("isTouchInsideToolbar", rx, ry):
                    param.setResult(True)
                elif self.bridge._invoke_static("hasActiveToolbar"):
                    action = ev.getAction()
                    if action == 0:
                        param.setResult(True)
        except Exception:
            pass
        finally:
            del param


class OnDismissWithTouchOutsideHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            if self.bridge._invoke_static("hasActiveToolbar"):
                param.setResult(None)
        except Exception:
            pass
        finally:
            del param


class DismissBlockerHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            if self.bridge._invoke_static("hasActiveToolbar"):
                param.setResult(None)
        except Exception:
            pass
        finally:
            del param


class CanDismissHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            if self.bridge._invoke_static("hasActiveToolbar"):
                param.setResult(False)
        except Exception:
            pass
        finally:
            del param


class IsTouchOutsideHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            if self.bridge._invoke_static("hasActiveToolbar"):
                param.setResult(False)
        except Exception:
            pass
        finally:
            del param


class ProcessTouchEventHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            ev = param.args[0]
            if ev is not None:
                rx = float(ev.getRawX())
                ry = float(ev.getRawY())
                if self.bridge._invoke_static("isTouchInsideToolbar", rx, ry):
                    param.setResult(False)
        except Exception:
            pass
        finally:
            del param


class ContainerTouchHook(MethodHook):
    def __init__(self, bridge):
        super().__init__()
        self.bridge = bridge

    def before_hooked_method(self, param):
        try:
            ev = param.args[0]
            if ev is None:
                return
            mname = param.method.getName()
            if mname == "onInterceptTouchEvent":
                rx = float(ev.getRawX())
                ry = float(ev.getRawY())
                if self.bridge._invoke_static("isTouchInsideToolbar", rx, ry) or self.bridge._invoke_static("hasActiveToolbar"):
                    param.setResult(False)
        except Exception:
            pass
        finally:
            del param


class SafeGetLetterHook(MethodHook):
    def after_hooked_method(self, param):
        try:
            if param.hasThrowable():
                param.setResult("")
        except Exception:
            pass
        finally:
            del param


class EnhancedPhotoPickerPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.bridge = NativeBridge(ENTRY_CLASS)

    def on_plugin_load(self):
        try:
            self.bridge.start()
        except Exception:
            pass
        try:
            self._sync_settings()
        except Exception:
            pass
        try:
            self._install_hooks()
        except Exception:
            pass

    def on_plugin_unload(self):
        try:
            self.bridge.stop()
        except Exception:
            pass

    def _install_hooks(self):

        alert_cls = find_class("org.telegram.ui.Components.ChatAttachAlert")
        if alert_cls is not None:
            alert_java_cls = get_java_class(alert_cls)
            top_hook = ChatAttachAlertGetCurrentTopHook(self.bridge)
            for mname in ["getCurrentTop", "getSheetTop"]:
                try:
                    self.hook_all_methods(alert_java_cls, mname, top_hook)
                except Exception:
                    pass
            try:
                self.hook_all_methods(alert_java_cls, "updateLayout", ChatAttachAlertUpdateLayoutHook(self.bridge))
            except Exception:
                pass

        dismiss_hook = OnDismissWithTouchOutsideHook(self.bridge)
        can_dismiss_hook = CanDismissHook(self.bridge)
        touch_outside_hook = IsTouchOutsideHook(self.bridge)
        process_touch_hook = ProcessTouchEventHook(self.bridge)

        for aname in [
            "org.telegram.ui.ActionBar.BottomSheet",
            "org.telegram.ui.Components.ChatAttachAlert",
            "org.telegram.ui.Components.ChatAttachAlertPhotoLayout",
            "org.telegram.ui.Components.ChatAttachAlert$AttachAlertLayout",
            "org.telegram.ui.Components.ChatAttachAlert$ChatAttachAlertLayout",
            "org.telegram.ui.Components.ChatAttachAlertLayout",
        ]:
            acls = find_class(aname)
            if acls is not None:
                ajcls = get_java_class(acls)
                try:
                    self.hook_all_methods(ajcls, "onDismissWithTouchOutside", dismiss_hook)
                except Exception:
                    pass
                try:
                    self.hook_all_methods(ajcls, "canDismissWithTouchOutside", can_dismiss_hook)
                except Exception:
                    pass
                try:
                    self.hook_all_methods(ajcls, "isTouchOutside", touch_outside_hook)
                except Exception:
                    pass

        touch_hook = ContainerTouchHook(self.bridge)
        for cname in [
            "org.telegram.ui.Components.ChatAttachAlertPhotoLayout",
            "org.telegram.ui.Components.ChatAttachAlert$ChatAttachAlertLayout",
            "org.telegram.ui.Components.ChatAttachAlertLayout",
            "org.telegram.ui.Components.SizeNotifierFrameLayout",
            "org.telegram.ui.Components.ChatAttachAlert$ContainerView",
            "org.telegram.ui.ActionBar.BottomSheet$ContainerView",
            "org.telegram.ui.Components.ChatAttachAlert",
        ] + ["org.telegram.ui.Components.ChatAttachAlert$" + str(i) for i in range(1, 20)]:
            ccls = find_class(cname)
            if ccls is not None:
                cjcls = get_java_class(ccls)
                for mname in ["onInterceptTouchEvent", "onTouchEvent"]:
                    try:
                        self.hook_all_methods(cjcls, mname, touch_hook)
                    except Exception:
                        pass
                try:
                    self.hook_all_methods(cjcls, "processTouchEvent", process_touch_hook)
                except Exception:
                    pass
                try:
                    self.hook_all_methods(cjcls, "onDismissWithTouchOutside", dismiss_hook)
                except Exception:
                    pass

        hook = TriggerHook(self, self.bridge)
        cls = find_class("org.telegram.ui.Components.ChatAttachAlertPhotoLayout")
        if cls is not None:
            java_cls = get_java_class(cls)
            try:
                self.hook_all_constructors(java_cls, hook)
            except Exception:
                pass
            for mname in ["onShow", "onShown", "onPreMeasure", "onAttachedToWindow", "checkScroll", "clearSelectedPhotos", "updatePhotos", "onCheckClick"]:
                try:
                    self.hook_all_methods(java_cls, mname, hook)
                except Exception:
                    pass

        adapter_cls = find_class("org.telegram.ui.Components.ChatAttachAlertPhotoLayout$PhotoAttachAdapter")
        if adapter_cls is not None:
            adapter_java_cls = get_java_class(adapter_cls)
            try:
                self.hook_all_methods(adapter_java_cls, "getLetter", SafeGetLetterHook())
            except Exception:
                pass

        cell_cls = find_class("org.telegram.ui.Cells.PhotoAttachPhotoCell")
        if cell_cls is not None:
            cell_java_cls = get_java_class(cell_cls)
            try:
                self.hook_all_methods(cell_java_cls, "setChecked", SelectionHook(self.bridge))
            except Exception:
                pass

    def get_detected_folders(self) -> List[str]:
        try:
            folders = self.bridge._invoke_static("getDetectedFolders")
            if folders:
                return [str(f) for f in folders if str(f)]
        except Exception:
            pass
        return []

    def create_settings(self) -> List[Any]:
        items = [
            Switch(
                key="show_chips",
                text=tr("Панель быстрых категорий", "Quick categories bar"),
                default=True,
                on_change=self._on_settings_changed,
            ),
            Switch(
                key="show_date_pill",
                text=tr("MD3-индикатор даты при скролле", "MD3 scroll date pill"),
                default=True,
                on_change=self._on_settings_changed,
            ),
            Header(text=tr("Базовые категории", "Basic categories")),
            Switch(
                key="cat_camera",
                text=tr("Камера", "Camera"),
                default=True,
                on_change=self._on_settings_changed,
            ),
            Switch(
                key="cat_screenshots",
                text=tr("Скриншоты", "Screenshots"),
                default=True,
                on_change=self._on_settings_changed,
            ),
            Switch(
                key="cat_video",
                text=tr("Видео", "Videos"),
                default=True,
                on_change=self._on_settings_changed,
            ),
            Switch(
                key="cat_downloads",
                text=tr("Загрузки", "Downloads"),
                default=True,
                on_change=self._on_settings_changed,
            ),
        ]
        folders = self.get_detected_folders()
        if folders:
            items.append(Header(text=tr("Найденные папки на устройстве", "Detected folders on device")))
            for f in folders:
                clean_name = f.strip()
                if not clean_name:
                    continue
                safe_key = "fld_" + clean_name
                items.append(
                    Switch(
                        key=safe_key,
                        text=clean_name,
                        default=False,
                        on_change=self._on_settings_changed,
                    )
                )
        items.append(Header(text=tr("Свои дополнительные папки", "Custom extra folders")))
        items.append(
            Input(
                key="custom_folders",
                text=tr("Произвольные папки (через запятую)", "Custom folders (comma separated)"),
                default="",
                on_change=self._on_settings_changed,
            )
        )
        return items

    def _sync_settings(self):
        show_chips = bool(self.get_setting("show_chips", True))
        show_date = bool(self.get_setting("show_date_pill", True))
        cat_camera = bool(self.get_setting("cat_camera", True))
        cat_screenshots = bool(self.get_setting("cat_screenshots", True))
        cat_video = bool(self.get_setting("cat_video", True))
        cat_downloads = bool(self.get_setting("cat_downloads", True))
        cat_gif = False
        folders = self.get_detected_folders()
        active_folders = []
        disabled_folders = []
        for f in folders:
            clean_name = f.strip()
            if not clean_name:
                continue
            safe_key = "fld_" + clean_name
            if bool(self.get_setting(safe_key, False)):
                active_folders.append(clean_name)
            else:
                disabled_folders.append(clean_name)
        user_custom = str(self.get_setting("custom_folders", "")).strip()
        if user_custom:
            for part in user_custom.split(","):
                p = part.strip()
                if p and p not in active_folders and p not in disabled_folders:
                    active_folders.append(p)
        custom_folders_str = ", ".join(active_folders)
        disabled_folders_str = ", ".join(disabled_folders)
        try:
            self.bridge._invoke_static(
                "syncAllSettings",
                show_chips,
                show_date,
                cat_camera,
                cat_screenshots,
                cat_video,
                cat_downloads,
                cat_gif,
                custom_folders_str,
                disabled_folders_str
            )
        except Exception:
            pass

    def _on_settings_changed(self, key: str, value: Any):
        self.set_setting(key, value)
        self._sync_settings()
